@@ -0,0 +1,20 @@
+// Plutonium: where a file manager with no folder of its own starts: the thread's
+// project, else the home folder.
+import { useEffect, useState } from "react";
+
+import { useFilesCore } from "./filesCore";
+
+export function useFilesHome(projectFolder: string | null): string | null {
+  const loaded = useFilesCore();
+  const client = loaded?.helper;
+  const [home, setHome] = useState<string | null>(null);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- follows the helper, the page's focus or the DOM, which are outside React
+  useEffect(() => {
+    if (projectFolder || !client) return;
+    void client.places().then(
+      (result) => setHome(result.places.find((place) => place.kind === "home")?.path ?? "/"),
+      () => setHome("/"),
+    );
+  }, [client, projectFolder]);
+  return projectFolder ?? home;
+}
diff --git a/apps/web/src/plutonium/importTab.ts b/apps/web/src/plutonium/importTab.ts
new file mode 100644
