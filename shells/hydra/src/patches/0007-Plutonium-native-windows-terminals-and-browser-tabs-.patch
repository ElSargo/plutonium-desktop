index 0000000000..c031a348e9
--- /dev/null
+++ b/apps/web/src/plutonium/windowStore.ts
@@ -0,0 +1,380 @@
+// Plutonium: native windows from the browser's window broker, grouped by the
+// thread whose agent or terminals started them (or that they were added to).
+//
+// Windows and tabs carry Plutonium tags. A T3 thread's tag is
+// "t3:thread/<thread id>" (threadTag()): its processes carry it, so the
+// windows they open start with it, and adding it to a window from elsewhere
+// (another shell, or no thread) brings the window into the thread. Other
+// shells' tags are shown by their labels (the browser's group table).
+//
+// Only active when this page is the Plutonium shell (Chromium exposes
+// `navigator.windowBroker` to the shell origin only). The window list, the
+// window → thread mapping and the agent bridge come from Plutonium's shell
+// library, loaded from its helper (helper/web/plutonium-shell.js in the
+// plutonium repo); this file mirrors its state into a store for React.
+import { create } from "zustand";
+
+import { useRightPanelStore } from "~/rightPanelStore";
+
+import { plutoniumHelperOrigin } from "./helperOrigin";
+import type { BrokerTab } from "./previewBridge";
+import { threadIdOfTag, threadTag } from "./threadTag";
+
+export { threadIdOfTag, threadTag };
+
+export interface NativeWindowEntry {
+  readonly id: number;
+  readonly appId: string;
+  readonly title: string;
+  readonly width: number;
+  readonly height: number;
+  readonly deviceScaleFactor: number;
+  readonly embedded: boolean;
+  readonly focused: boolean;
+  readonly pid: number;
+  /** The tag of the thread that started it; null if none did; undefined until known. */
+  readonly threadId: string | null | undefined;
+  /** The origin tag first, then the ones shells added (older browsers: missing). */
+  readonly tags?: readonly string[];
+}
+
+/**
+ * A window an agent works in (the shell library's agentWindows): the size it
+ * holds the window at, which a panel keeps, scaled to fit, until the user
+ * takes control; and whether it's working in it right now.
+ */
+export interface AgentWindow {
+  readonly id: number;
+  /** Absent once the user took control, or if the agent never held a size. */
+  readonly width?: number;
+  readonly height?: number;
+  readonly userControl: boolean;
+  readonly busy: boolean;
+}
+
+/** A tag a shell described: what to call it, and which shell owns it. */
+export interface PlutoniumGroup {
+  readonly tag: string;
+  readonly label: string;
+  readonly shellId: string;
+}
+
+/** A window's tags (before the browser had tags: just its thread's). */
+export function windowTags(entry: NativeWindowEntry): readonly string[] {
+  if (entry.tags && entry.tags.length > 0) return entry.tags;
+  return entry.threadId ? [entry.threadId] : [];
+}
+
+/** A display (several displays: each has its own shell pages, T3 among them). */
+export interface PlutoniumDisplay {
+  readonly id: string;
+  /** 1-based, left to right: "display 2". */
+  readonly index: number;
+  readonly label: string;
+  readonly focused: boolean;
+  /** This page is on it. */
+  readonly current: boolean;
+}
+
+/** A desktop app the helper can launch (a freedesktop.org desktop entry). */
+export interface DesktopApp {
+  readonly id: string;
+  readonly name: string;
+  readonly genericName: string;
+  readonly comment: string;
+  readonly keywords: readonly string[];
+  readonly categories: readonly string[];
+  readonly hasIcon: boolean;
+  readonly terminal: boolean;
+}
+
+/** The parts of the shell library's PlutoniumShell used here. */
+interface PlutoniumShell extends EventTarget {
+  readonly available: boolean;
+  readonly ready: Promise<void>;
+  readonly windows: ReadonlyMap<number, NativeWindowEntry>;
+  /** Browser tabs, by id (older libraries: missing). */
+  readonly tabs?: ReadonlyMap<number, BrokerTab>;
+  onFocus: ((window: NativeWindowEntry) => boolean | Promise<boolean>) | undefined;
+  grantFor(windowId: number): Promise<string>;
+  showOnDesktop(windowId: number): void;
+  apps(): Promise<DesktopApp[]>;
+  appIcon(appId: string): Promise<string | null>;
+  /** An object URL for a website's own icon, fetched by the helper (older libraries: missing). */
+  siteIcon?(pageUrl: string): Promise<string | null>;
+  launchApp(
+    threadId: string,
+    appId: string,
+    options?: { waitMs?: number },
+  ): Promise<{ pid: number; windows: { id: number; appId: string }[] }>;
+  setShellShortcuts?(shortcuts: readonly string[]): void;
+  /** Takes the keyboard from a tab or app in this page (older libraries: missing). */
+  focusPage?(): void;
+  /** A File for a host file, to drag or attach (older libraries: missing). */
+  fileForPath?(path: string): File | null;
+  /** The host path of a File, or "" (older libraries: missing). */
+  pathForFile?(file: File): string;
+  /** Rides host files on the pointer until they're dropped (older libraries: missing). */
+  startFileDrag?(paths: readonly string[], options?: { imagePng?: string }): Promise<string>;
+  readonly tagsAvailable?: boolean;
+  readonly groups?: ReadonlyMap<string, PlutoniumGroup>;
+  tagWindow?(windowId: number, add: readonly string[], remove?: readonly string[]): Promise<void>;
+  setGroups?(groups: readonly { tag: string; label: string }[]): void;
+  /**
+   * Lets the server drive browser tab `browserTabId`, shown here as its tab
+   * `serverTab`; resolves to the browser tab to show (another shell page's, if
+   * it shows the server's tab already). With `replace` (a tab brought from
+   * elsewhere), it wins over one the helper opened for the server itself.
+   */
+  showServerTab(
+    browserTabId: number,
+    serverTab: { readonly threadId: string; readonly tabId: string },
+    options?: { readonly replace?: boolean },
+  ): Promise<number>;
+  releaseServerTab(serverTab: { readonly threadId: string; readonly tabId: string }): Promise<void>;
+  /** Windows agents work in (older libraries: missing). */
+  readonly agentWindows?: ReadonlyMap<number, AgentWindow>;
+  releaseWindow?(windowId: number): Promise<void>;
+  /** The displays (older libraries: missing). */
+  readonly displays?: readonly PlutoniumDisplay[];
+  showOnDisplay?(windowId: number, display: number | string): Promise<boolean>;
+  /** Desktop services (DESKTOP_SERVICES.md; older libraries: missing). */
+  readonly system?: { get(name: string): SystemServiceHandle };
+}
+
+/** A desktop service in the shell library (`shell.system.<name>`): its state, kept current by "change" events. */
+export interface SystemServiceHandle extends EventTarget {
+  readonly state: unknown;
+  readonly error: string | null;
+  readonly ready: Promise<unknown>;
+  call(action: string, args?: Record<string, unknown>): Promise<unknown>;
+}
+
+interface PlutoniumWindowState {
+  readonly available: boolean;
+  /** The windows come from the server's stream (remoteWindows.ts), not this page's shell. */
+  readonly remote: boolean;
+  readonly windows: Readonly<Record<number, NativeWindowEntry>>;
+  /** Every shell's groups, by tag. */
+  readonly groups: Readonly<Record<string, PlutoniumGroup>>;
+  /** Windows agents work in, by id. */
+  readonly agentWindows: Readonly<Record<number, AgentWindow>>;
+  /** The displays, by index (empty with an older library). */
+  readonly displays: readonly PlutoniumDisplay[];
+}
+
+export const usePlutoniumWindowStore = create<PlutoniumWindowState>(() => ({
+  available: false,
+  remote: false,
+  windows: {},
+  groups: {},
+  agentWindows: {},
+  displays: [],
+}));
+
+let shell: PlutoniumShell | null = null;
+let focusHandler: ((window: NativeWindowEntry) => boolean) | null = null;
+
+/** How an agent's "show this window" (the bridge's focus) reaches the UI. */
+export function setPlutoniumFocusHandler(
+  handler: ((window: NativeWindowEntry) => boolean) | null,
+): void {
+  focusHandler = handler;
+}
+
+let tabHandlers: {
+  readonly onOpen: (tab: BrokerTab) => void;
+  readonly onFocus: (tab: BrokerTab) => boolean;
+} | null = null;
+
+/**
+ * Browser tabs that reach the UI: `onOpen` for a link this page opened in a
+ * new tab or window (window.open, target=_blank: what "open in the system
+ * browser" does here), which arrives untagged; `onFocus` for an agent's or
+ * the overlay's "show this tab".
+ */
+export function setPlutoniumTabHandlers(handlers: typeof tabHandlers): void {
+  tabHandlers = handlers;
+}
+
+/** A grant to embed `windowId` in this document (one per window, reused). */
+export function grantFor(windowId: number): Promise<string> {
+  return shell ? shell.grantFor(windowId) : Promise.reject(new Error("not the Plutonium shell"));
+}
+
+/** The user takes control of `windowId`'s size from the agent: the panel sizes it again. */
+export function releaseWindow(windowId: number): Promise<void> {
+  return shell?.releaseWindow
+    ? shell.releaseWindow(windowId)
+    : Promise.reject(new Error("this helper has no agent windows"));
+}
+
+/**
+ * Asks display `index`'s shell to show `windowId` (it takes the window from this page).
+ * Resolves to false if it didn't.
+ */
+export function showOnDisplay(windowId: number, index: number): Promise<boolean> {
+  return shell?.showOnDisplay ? shell.showOnDisplay(windowId, index) : Promise.resolve(false);
+}
+
+/** Raises `windowId` on the Ash desktop once no element shows it any more. */
+export function showOnDesktop(windowId: number): void {
+  shell?.showOnDesktop(windowId);
+}
+
+let shellReady: Promise<PlutoniumShell | null> | null = null;
+let resolveShell: ((shell: PlutoniumShell | null) => void) | null = null;
+
+/** The shell library once loaded; null outside the Plutonium shell. */
+let fileChooserHandler: ((request: unknown) => boolean) | null = null;
+
+/** Who draws file pickers: the file manager's, once mounted (a static import would be a cycle). */
+export function setFileChooserHandler(handler: ((request: unknown) => boolean) | null): void {
+  fileChooserHandler = handler;
+}
+
+export function plutoniumShell(): Promise<PlutoniumShell | null> {
+  shellReady ??= new Promise((resolve) => (resolveShell = resolve));
+  return shellReady;
+}
+
+/** Whether this page is the Plutonium shell (has the window broker). */
+export function isPlutoniumShell(): boolean {
+  return typeof navigator !== "undefined" && "windowBroker" in navigator;
+}
+
+function mirror(): void {
+  if (!shell) return;
+  const groups = shell.groups ? Object.fromEntries(shell.groups) : {};
+  const previous = usePlutoniumWindowStore.getState().groups;
+  usePlutoniumWindowStore.setState({
+    windows: Object.fromEntries(shell.windows),
+    // Unchanged groups keep their object, so selectors don't re-render.
+    groups: JSON.stringify(groups) === JSON.stringify(previous) ? previous : groups,
+  });
+}
+
+let describedGroups = "";
+let pendingGroups: { tag: string; label: string }[] | null = null;
+
+/** Tells the browser what T3's thread tags are called (other shells and the overlay show the labels). */
+export function describeThreads(threads: readonly { id: string; title: string }[]): void {
+  pendingGroups = threads.map((thread) => ({ tag: threadTag(thread.id), label: thread.title }));
+  flushGroups();
+}
+
+function flushGroups(): void {
+  if (!pendingGroups || !shell?.setGroups) return;
+  const key = JSON.stringify(pendingGroups);
+  if (key !== describedGroups) {
+    describedGroups = key;
+    shell.setGroups(pendingGroups);
+  }
+}
+
+/** Adds window `windowId` to `threadId` (it keeps the tags it had). */
+export function addWindowToThread(windowId: number, threadId: string): Promise<void> {
+  if (!shell?.tagWindow) return Promise.reject(new Error("this browser has no window tags"));
+  return shell.tagWindow(windowId, [threadTag(threadId)]);
+}
+
+/** Takes window `windowId` out of `threadId` (not the thread that started it). */
+export function removeWindowFromThread(windowId: number, threadId: string): Promise<void> {
+  if (!shell?.tagWindow) return Promise.reject(new Error("this browser has no window tags"));
+  return shell.tagWindow(windowId, [], [threadTag(threadId)]);
+}
+
+/** What to call `tag`: its group's label, else the tag. */
+export function labelOfTag(groups: Readonly<Record<string, PlutoniumGroup>>, tag: string): string {
+  return groups[tag]?.label || tag;
+}
+
+let started = false;
+
+/** Connect to the helper once per document. A no-op outside the shell. */
+export function startPlutoniumWindows(): void {
+  if (started) return;
+  started = true;
+  const dropAppTabs = () => useRightPanelStore.getState().reconcileAppSurfaces(() => false);
+  if (!("windowBroker" in navigator)) {
+    // Outside the shell the server streams the windows, if it can
+    // (startRemoteWindows); its list keeps or drops app tabs restored from storage.
+    void plutoniumShell();
+    resolveShell?.(null);
+    return;
+  }
+  const url = `${plutoniumHelperOrigin()}/v1/shell.js`;
+  import(/* @vite-ignore */ url).then(
+    (library: { connect(options: object): PlutoniumShell }) => {
+      shell = library.connect({
+        onFocus: (window: NativeWindowEntry) => focusHandler?.(window) ?? false,
+        // The handler tags the tab itself (importBrowserTab).
+        onOpenTab: (tab: BrokerTab) => {
+          tabHandlers?.onOpen(tab);
+          return undefined;
+        },
+        onFocusTab: (tab: BrokerTab) => tabHandlers?.onFocus(tab) ?? false,
+        fileChooser: (request: unknown) => fileChooserHandler?.(request) ?? false,
+      });
+      usePlutoniumWindowStore.setState({ available: shell.available });
+      void shell.ready.then(flushGroups);
+      void plutoniumShell();
+      resolveShell?.(shell);
+      shell.addEventListener("change", mirror);
+      shell.addEventListener("displayschange", () => {
+        if (shell?.displays) usePlutoniumWindowStore.setState({ displays: [...shell.displays] });
+      });
+      shell.addEventListener("agentwindowschange", () => {
+        if (shell?.agentWindows)
+          usePlutoniumWindowStore.setState({
+            agentWindows: Object.fromEntries(shell.agentWindows),
+          });
+      });
+      // Window ids only hold within one Ash session: once the list is in,
+      // drop restored tabs whose window is gone or is now some other app.
+      void shell.ready.then(() => {
+        if (!shell) return;
+        const { windows } = shell;
+        mirror();
+        useRightPanelStore
+          .getState()
+          .reconcileAppSurfaces((id, appId) => windows.get(id)?.appId === appId);
+        // From then on, a closed window closes its tab.
+        shell.addEventListener("change", () =>
+          useRightPanelStore.getState().reconcileAppSurfaces((id) => windows.has(id)),
+        );
+      });
+    },
+    (error: unknown) => {
+      console.warn(`Plutonium: could not load the shell library from ${url}`, error);
+      dropAppTabs();
+      void plutoniumShell();
+      resolveShell?.(null);
+    },
+  );
+}
+
+/** Windows of `threadId` (started by its agent or terminals, or added to it), oldest first. */
+export function useThreadWindows(threadId: string | null): readonly NativeWindowEntry[] {
+  const windows = usePlutoniumWindowStore((state) => state.windows);
+  if (threadId === null) return [];
+  const tag = threadTag(threadId);
+  return Object.values(windows)
+    .filter((entry) => windowTags(entry).includes(tag))
+    .toSorted((a, b) => a.id - b.id);
+}
+
+/**
+ * Windows that are in no T3 thread (once their thread is known): another
+ * shell's, a workspace's, or nobody's. Oldest first.
+ */
+export function useElsewhereWindows(): readonly NativeWindowEntry[] {
+  const windows = usePlutoniumWindowStore((state) => state.windows);
+  return Object.values(windows)
+    .filter(
+      (entry) =>
+        entry.threadId !== undefined &&
+        !windowTags(entry).some((tag) => threadIdOfTag(tag) !== null),
+    )
+    .toSorted((a, b) => a.id - b.id);
+}
