--- /dev/null
+++ b/apps/web/src/plutonium/importTab.ts
@@ -0,0 +1,67 @@
+// Plutonium: bringing a browser tab from elsewhere (another shell's, or
+// nobody's) into a thread, as a new browser panel tab that shows it.
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import type { AtomCommandResult } from "@t3tools/client-runtime/state/runtime";
+
+import type { BrowserSettingsReadError, OpenPreviewMutation } from "~/browser/openFileInPreview";
+import { openPreviewSession } from "~/components/preview/openPreviewSession";
+import { useRightPanelStore } from "~/rightPanelStore";
+
+import { isBlank, plutoniumPreview, type BrokerTab } from "./previewBridge";
+
+const isWebUrl = (url: string) => /^https?:\/\//i.test(url);
+
+/** How long a tab may stay blank before it is brought in as it is. */
+const FIRST_URL_WAIT_MS = 5000;
+
+/**
+ * `tab` once it has a URL. A link this page opens in a new tab arrives blank,
+ * and the session has to start at the link: the server attaches only once the
+ * page has loaded, and a page loaded by then sends it nothing.
+ */
+function withFirstUrl(
+  preview: NonNullable<ReturnType<typeof plutoniumPreview>>,
+  tab: BrokerTab,
+): Promise<BrokerTab> {
+  if (!isBlank(tab.url)) return Promise.resolve(tab);
+  return new Promise((resolve) => {
+    const current = () => preview.tabList().find((entry) => entry.id === tab.id);
+    const done = (entry: BrokerTab) => {
+      window.clearTimeout(timer);
+      unsubscribe();
+      resolve(entry);
+    };
+    // This page may hear of the tab after the shell library does.
+    let seen = false;
+    const unsubscribe = preview.onTabs(() => {
+      const entry = current();
+      seen ||= entry !== undefined;
+      if (entry ? !isBlank(entry.url) : seen) done(entry ?? tab);
+    });
+    const timer = window.setTimeout(() => done(current() ?? tab), FIRST_URL_WAIT_MS);
+  });
+}
+
+export async function importBrowserTab<E>(input: {
+  readonly threadRef: ScopedThreadRef;
+  readonly tab: BrokerTab;
+  readonly openPreview: OpenPreviewMutation<E>;
+}): Promise<AtomCommandResult<unknown, E | BrowserSettingsReadError> | null> {
+  const preview = plutoniumPreview();
+  if (!preview) return null;
+  const { threadRef } = input;
+  const tab = await withFirstUrl(preview, input.tab);
+  await preview.importTab(threadRef.threadId, tab.id);
+  const result = await openPreviewSession({
+    openPreview: input.openPreview,
+    threadRef,
+    // The session starts at the tab's page, so it isn't shown as empty.
+    ...(isWebUrl(tab.url) ? { url: tab.url } : {}),
+  });
+  if (result._tag === "Failure") {
+    preview.cancelImport(threadRef.threadId, tab.id);
+    return result;
+  }
+  useRightPanelStore.getState().openBrowser(threadRef, result.value.tabId);
+  return result;
+}
diff --git a/apps/web/src/plutonium/openedItems.test.ts b/apps/web/src/plutonium/openedItems.test.ts
