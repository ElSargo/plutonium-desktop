+// Plutonium: while the file manager has the keyboard its keys are its own, whatever
+// else they mean to the page.
+export function plutoniumFilesFocused(): boolean {
+  const active = typeof document === "undefined" ? null : document.activeElement;
+  return active?.hasAttribute?.("data-plutonium-files") === true;
+}
+
+const FUZZY_KEYS = new Set(["b", "j", "k", "n", "p"]);
+
+/** Ctrl+J, K, N, P and B move and pick up in the fuzzy finder's search, not the page's rules. */
+export function plutoniumFuzzyOwnsKey(event: {
+  readonly ctrlKey: boolean;
+  readonly key: string;
+}): boolean {
+  const active = typeof document === "undefined" ? null : document.activeElement;
+  return (
+    event.ctrlKey &&
+    FUZZY_KEYS.has(event.key) &&
+    active?.hasAttribute?.("data-plutonium-fuzzy") === true
+  );
+}
+
+/** The file manager's rules that work from anywhere: they open it. */
+export const FILE_MANAGER_OPENERS = [
+  "files.toggle",
+  "files.openBeside",
+  "files.toggleRight",
+  "files.carry",
+  "files.carryFuzzy",
+  "files.findProject",
+  "files.findHome",
+] as const;
+
+/** A rule for inside the file manager, not one that opens it from anywhere. */
+export function isFileManagerBinding(binding: { readonly command: string }): boolean {
+  return (
+    binding.command.startsWith("files.") &&
+    !(FILE_MANAGER_OPENERS as readonly string[]).includes(binding.command)
+  );
+}
