index 0000000000..c036a09361
--- /dev/null
+++ b/apps/web/src/plutonium/files/FilePicker.tsx
@@ -0,0 +1,313 @@
+// Plutonium: the floating picker: what a tab, an app (the FileChooser portal), this
+// page's own <input type=file> and the carry key ask (docs/features/FILE_MANAGER.md).
+import { useEffect, useRef, useState } from "react";
+
+import { Button } from "~/components/ui/button";
+import { toastManager } from "~/components/ui/toast";
+
+import { plutoniumHelperOrigin } from "../helperOrigin";
+import { setFileChooserHandler } from "../windowStore";
+import { FileManager } from "./FileManager";
+import { filesClient, loadFilesCore } from "./filesCore";
+import {
+  lastPickerFolder,
+  type PickerDetail,
+  type PickerRequest,
+  useFilesStore,
+} from "./filesStore";
+import { type FileManagerState, takeKeyboard } from "./useFileManager";
+
+const TITLES: Record<string, string> = {
+  open: "Open a file",
+  "open-multiple": "Open files",
+  folder: "Choose a folder",
+  save: "Save as",
+};
+
+const ACCEPT: Record<string, string> = {
+  open: "Open",
+  "open-multiple": "Open",
+  folder: "Choose",
+  save: "Save",
+};
+
+function filterName(filter: { name?: string; patterns: readonly string[] }) {
+  if (filter.name) return filter.name;
+  return filter.patterns.includes("*") ? "All files" : filter.patterns.join(", ");
+}
+
+function PickerDialog({ request }: { request: PickerRequest }) {
+  const { detail } = request;
+  const mode = detail.mode ?? "open";
+  const filters = detail.filters ?? [];
+  const [filter, setFilter] = useState(
+    filters.length ? Math.min(Math.max(detail.currentFilter ?? 0, 0), filters.length - 1) : -1,
+  );
+  const [name, setName] = useState(detail.currentName ?? "");
+  const [choices, setChoices] = useState<Record<string, string>>(() =>
+    Object.fromEntries((detail.choices ?? []).map((choice) => [choice.id, choice.value])),
+  );
+  const [confirm, setConfirm] = useState<{ text: string; paths: readonly string[] } | null>(null);
+  const [home, setHome] = useState<string | null>(null);
+  const stateRef = useRef<FileManagerState | null>(null);
+  const previousFocus = useRef(document.activeElement as HTMLElement | null);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- follows the helper, the page's focus or the DOM, which are outside React
+  useEffect(() => {
+    // Chrome's default for a page that never chose is its profile folder: not a place to start.
+    const asked = detail.currentFolder?.includes("/plutonium/profile") ? "" : detail.currentFolder;
+    const folder = asked || (detail.home ? "" : lastPickerFolder.current);
+    if (folder) {
+      // oxlint-disable-next-line react/set-state-in-effect -- what the helper or the page says, set once it has answered
+      setHome(folder);
+      return;
+    }
+    void loadFilesCore().then(async () => {
+      const places = await filesClient()?.places();
+      setHome(places?.places.find((place) => place.kind === "home")?.path ?? "/");
+    });
+  }, [detail.currentFolder, detail.home]);
+
+  const finish = (paths: readonly string[] | null) => {
+    if (paths) {
+      lastPickerFolder.current = stateRef.current?.dir ?? lastPickerFolder.current;
+      request.answer({
+        paths,
+        ...(filter >= 0 ? { filter } : {}),
+        ...(detail.choices?.length ? { choices } : {}),
+      });
+    } else {
+      request.answer(null);
+    }
+    useFilesStore.getState().setPicker(null);
+    previousFocus.current?.focus();
+  };
+
+  const accept = async (paths: readonly string[]) => {
+    const state = stateRef.current;
+    const core = state?.loaded?.core;
+    if (!state || !core) return;
+    if (mode === "save") {
+      // A name in this folder, or a whole path typed out.
+      const target =
+        paths[0] ?? (name.startsWith("/") ? name : name ? core.joinPath(state.dir, name) : "");
+      if (!target) return;
+      const folder = core.parentOf(target) ?? "/";
+      const existing = await filesClient()
+        ?.list(folder, { hidden: true })
+        .catch(() => null);
+      if (!existing) {
+        setConfirm(null);
+        toastManager.add({ type: "error", title: `${folder} isn't a folder that can be saved to` });
+        return;
+      }
+      if (existing.entries.some((entry) => entry.path === target)) {
+        setConfirm({ text: `Replace ${target.split("/").pop()}?`, paths: [target] });
+      } else finish([target]);
+      return;
+    }
+    if (detail.upload && paths[0]) {
+      // A folder upload the shell answers is the shell's to confirm.
+      const response = await fetch(
+        `${plutoniumHelperOrigin()}/v1/files/count?dir=${encodeURIComponent(paths[0])}`,
+      ).catch(() => null);
+      const count = (await response?.json().catch(() => null)) as {
+        files?: number;
+        more?: boolean;
+      } | null;
+      const site = detail.origin ?? "this site";
+      setConfirm({
+        text: `Upload ${count?.files ?? "the"}${count?.more ? "+" : ""} files to ${site}?`,
+        paths,
+      });
+      return;
+    }
+    finish(paths);
+  };
+
+  return (
+    <div
+      className="fixed inset-0 z-[200] flex items-center justify-center bg-black/40 p-4 backdrop-blur-xs"
+      onPointerDown={(event) => {
+        if (event.target === event.currentTarget) finish(null);
+      }}
+    >
+      <div
+        role="dialog"
+        aria-modal="true"
+        aria-label={detail.title || TITLES[mode]}
+        className="flex h-[min(680px,calc(100vh-32px))] w-[min(1080px,calc(100vw-32px))] flex-col overflow-hidden rounded-xl border border-border bg-background shadow-2xl"
+      >
+        <div className="flex shrink-0 items-baseline gap-2 border-b border-border/70 px-4 py-2.5">
+          <span className="text-sm font-medium">{detail.title || TITLES[mode]}</span>
+          {request.asker ? (
+            <span className="truncate text-xs text-muted-foreground">{request.asker}</span>
+          ) : null}
+        </div>
+        {home ? (
+          <FileManager
+            instance="picker"
+            className="flex-1"
+            initialDir={home}
+            // A save starts with the name, the finder with its search, the rest with the list.
+            autoFocus={mode !== "save" && !detail.fuzzy}
+            showPlaces
+            stateRef={stateRef}
+            pick={{
+              detail,
+              filter,
+              accept: (paths) => void accept(paths),
+              cancel: () => finish(null),
+            }}
+          />
+        ) : (
+          <div className="flex-1" />
+        )}
+        <div className="flex shrink-0 flex-wrap items-center gap-2 border-t border-border/70 px-4 py-2.5 text-sm">
+          {mode === "save" ? (
+            <input
+              ref={(input) => takeKeyboard(input)}
+              value={name}
+              aria-label="File name"
+              spellCheck={false}
+              className="min-w-40 flex-1 rounded-md border border-input bg-transparent px-2 py-1 outline-none focus:border-ring"
+              onChange={(event) => setName(event.target.value)}
+              onKeyDown={(event) => {
+                event.stopPropagation();
+                if (event.key === "Enter") void accept([]);
+                if (event.key === "Escape") finish(null);
+              }}
+            />
+          ) : null}
+          {filters.length > 0 && mode !== "folder" ? (
+            <select
+              value={filter}
+              aria-label="File types"
+              className="rounded-md border border-input bg-background px-1.5 py-1"
+              onChange={(event) => setFilter(Number(event.target.value))}
+            >
+              {filters.map((entry, index) => (
+                // oxlint-disable-next-line react/no-array-index-key -- a position is all these have: they never move
+                <option key={index} value={index}>
+                  {filterName(entry)}
+                </option>
+              ))}
+            </select>
+          ) : null}
+          {(detail.choices ?? []).map((choice) =>
+            choice.options.length > 0 ? (
+              <label key={choice.id} className="flex items-center gap-1">
+                {choice.label}
+                <select
+                  value={choices[choice.id]}
+                  className="rounded-md border border-input bg-background px-1.5 py-1"
+                  onChange={(event) =>
+                    setChoices((value) => ({ ...value, [choice.id]: event.target.value }))
+                  }
+                >
+                  {choice.options.map((option) => (
+                    <option key={option.id} value={option.id}>
+                      {option.label}
+                    </option>
+                  ))}
+                </select>
+              </label>
+            ) : (
+              <label key={choice.id} className="flex items-center gap-1">
+                <input
+                  type="checkbox"
+                  checked={choices[choice.id] === "true"}
+                  onChange={(event) =>
+                    setChoices((value) => ({ ...value, [choice.id]: String(event.target.checked) }))
+                  }
+                />
+                {choice.label}
+              </label>
+            ),
+          )}
+          <span className="min-w-0 flex-1 truncate text-right text-muted-foreground">
+            {confirm?.text}
+          </span>
+          {confirm ? (
+            <>
+              <Button size="sm" variant="ghost" onClick={() => setConfirm(null)}>
+                No
+              </Button>
+              <Button size="sm" onClick={() => finish(confirm.paths)}>
+                Yes
+              </Button>
+            </>
+          ) : (
+            <>
+              <Button size="sm" variant="ghost" onClick={() => finish(null)}>
+                Cancel
+              </Button>
+              <Button size="sm" onClick={() => stateRef.current?.accept()}>
+                {detail.acceptLabel || ACCEPT[mode]}
+              </Button>
+            </>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+/** Mount once: the picker when something waits on one, and the carry hint. */
+export function PlutoniumFilePicker() {
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- follows the helper, the page's focus or the DOM, which are outside React
+  useEffect(() => {
+    setFileChooserHandler((request) => takeFileChooser(request as FileChooserRequest));
+    return () => setFileChooserHandler(null);
+  }, []);
+  const picker = useFilesStore((state) => state.picker);
+  const carrying = useFilesStore((state) => state.carrying);
+  return (
+    <>
+      {picker ? <PickerDialog key={picker.id} request={picker} /> : null}
+      {carrying ? (
+        <div className="pointer-events-none fixed inset-x-0 bottom-6 z-[210] flex justify-center">
+          <div className="rounded-full border border-border bg-popover px-3 py-1 text-xs text-popover-foreground shadow-lg">
+            Carrying{" "}
+            {carrying.length === 1 ? carrying[0]?.split("/").pop() : `${carrying.length} items`}
+            <span className="ml-2 text-muted-foreground">
+              h j k l move · shift for bigger steps · enter or click drops · esc cancels
+            </span>
+          </div>
+        </div>
+      ) : null}
+    </>
+  );
+}
+
+let nextRequest = 1;
+
+interface FileChooserRequest {
+  readonly detail?: PickerDetail;
+  readonly tab?: { readonly url?: string } | undefined;
+  readonly source?: { readonly name?: string } | undefined;
+  readonly signal?: AbortSignal;
+  answer(answer: unknown): unknown;
+}
+
+/** The library's `fileChooser` option: every picker in the desktop comes here. */
+function takeFileChooser(request: FileChooserRequest): boolean {
+  const store = useFilesStore.getState();
+  // One at a time: a second asker waits for nothing, and is cancelled.
+  if (store.picker) {
+    void request.answer(null);
+    return true;
+  }
+  const id = nextRequest++;
+  request.signal?.addEventListener("abort", () => {
+    if (useFilesStore.getState().picker?.id === id) useFilesStore.getState().setPicker(null);
+  });
+  const detail = request.detail ?? {};
+  store.setPicker({
+    id,
+    detail,
+    asker: detail.origin ?? request.source?.name ?? request.tab?.url ?? "",
+    answer: (answer) => void request.answer(answer),
+  });
+  return true;
+}
