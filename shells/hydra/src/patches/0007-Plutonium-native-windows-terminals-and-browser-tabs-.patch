@@ -0,0 +1,555 @@
+// Plutonium: native windows in the right panel. The "Apps" surface lists the
+// windows of a thread (those it started, and those added to it), and each one
+// opens as its own tab, shown live as a <native-window> element. Below them,
+// "Elsewhere" lists windows and browser tabs in no T3 thread (another shell's,
+// or nobody's); opening one adds it to the thread.
+//
+// A window an agent works in keeps the size the agent gave it (launch_app,
+// resize_window): its tab shows it at that size, scaled down to fit and
+// locked, saying the agent is working in it, until the user takes control;
+// then the panel sizes it, as any other window.
+import { ThreadId, type ScopedThreadRef } from "@t3tools/contracts";
+import { useParams, useRouter } from "@tanstack/react-router";
+import { AppWindowIcon, BotIcon, GlobeIcon, SquareArrowOutUpRightIcon } from "lucide-react";
+import {
+  createElement,
+  type RefObject,
+  useEffect,
+  useRef,
+  useState,
+  useSyncExternalStore,
+} from "react";
+
+import { Button } from "~/components/ui/button";
+import { Tooltip, TooltipPopup, TooltipTrigger } from "~/components/ui/tooltip";
+import { useRightPanelStore } from "~/rightPanelStore";
+import { useThreadShells } from "~/state/entities";
+import { usePrimaryEnvironmentId } from "~/state/environments";
+import { previewEnvironment } from "~/state/preview";
+import { useAtomCommand } from "~/state/use-atom-command";
+import { buildThreadRouteParams, resolveThreadRouteTarget } from "~/threadRoutes";
+
+import { importBrowserTab } from "./importTab";
+import { setOpenedItemContext, startOpenedItems } from "./openedItems";
+import { openAndFocusApp } from "./panelKeys";
+import { RemoteWindowView } from "./RemoteWindowView";
+import { startRemoteWindows } from "./remoteWindows";
+
+import { plutoniumPreview, tabTags, type BrokerTab } from "./previewBridge";
+import {
+  addWindowToThread,
+  describeThreads,
+  grantFor,
+  isPlutoniumShell,
+  labelOfTag,
+  releaseWindow,
+  setPlutoniumFocusHandler,
+  setPlutoniumTabHandlers,
+  showOnDesktop,
+  showOnDisplay,
+  startPlutoniumWindows,
+  threadIdOfTag,
+  type NativeWindowEntry,
+  usePlutoniumWindowStore,
+  useElsewhereWindows,
+  useThreadWindows,
+  windowTags,
+} from "./windowStore";
+
+/**
+ * Connects to the Plutonium helper for the whole app, shows a window or tab in
+ * its thread when someone asks to, and handles new ones. Renders nothing.
+ */
+export function PlutoniumWindowsStarter() {
+  const router = useRouter();
+  const environmentId = usePrimaryEnvironmentId();
+  const threads = useThreadShells();
+  useEffect(startPlutoniumWindows, []);
+  // Away from the desktop, the server streams the windows.
+  useEffect(
+    () =>
+      environmentId === null || isPlutoniumShell() ? undefined : startRemoteWindows(environmentId),
+    [environmentId],
+  );
+  // Other shells and the browser's overlay label T3's thread tags with these.
+  useEffect(() => {
+    describeThreads(
+      threads
+        .filter((thread) => thread.environmentId === environmentId)
+        .map((thread) => ({ id: thread.id, title: thread.title })),
+    );
+  }, [threads, environmentId]);
+  // Browser tabs: a link this page opened goes into the open thread, as a
+  // browser panel tab; a thread's tab someone asks to show (an agent, the
+  // overlay, xdg-open in the thread's terminal) opens in its thread. So does
+  // a window an agent or the overlay asks to show. New windows and tabs go by
+  // openedItems.ts.
+  const routeTarget = useParams({
+    strict: false,
+    select: (params) => resolveThreadRouteTarget(params),
+  });
+  const activeThreadRef = routeTarget?.kind === "server" ? routeTarget.threadRef : null;
+  const openPreview = useAtomCommand(previewEnvironment.open, { reportFailure: false });
+  useEffect(startOpenedItems, []);
+  useEffect(() => {
+    if (environmentId === null) return;
+    // Plutonium threads run on this machine: the primary environment. An
+    // item's thread is the first T3 thread it is in (started by, or added to).
+    const threadRefOf = (tags: readonly string[]): ScopedThreadRef | null => {
+      const threadId = tags.map(threadIdOfTag).find((id) => id !== null);
+      return threadId ? { environmentId, threadId: ThreadId.make(threadId) } : null;
+    };
+    const goTo = (ref: ScopedThreadRef) =>
+      void router.navigate({
+        to: "/$environmentId/$threadId",
+        params: buildThreadRouteParams(ref),
+      });
+    const showWindow = (ref: ScopedThreadRef, window: NativeWindowEntry) => {
+      openAndFocusApp(ref, { windowId: window.id, appId: window.appId });
+      goTo(ref);
+    };
+    const showTab = (ref: ScopedThreadRef, tab: BrokerTab) => {
+      const shown = plutoniumPreview()?.runtimeTabIdOf(tab.id) ?? null;
+      if (shown) useRightPanelStore.getState().openBrowser(ref, shown);
+      else void importBrowserTab({ threadRef: ref, tab, openPreview });
+      goTo(ref);
+    };
+    setPlutoniumFocusHandler((window) => {
+      const ref = threadRefOf(windowTags(window));
+      if (ref) showWindow(ref, window);
+      return ref !== null;
+    });
+    setPlutoniumTabHandlers({
+      onOpen: (tab) => {
+        if (activeThreadRef)
+          void importBrowserTab({ threadRef: activeThreadRef, tab, openPreview });
+      },
+      onFocus: (tab) => {
+        const ref = threadRefOf(tabTags(tab));
+        if (ref) showTab(ref, tab);
+        return ref !== null;
+      },
+    });
+    setOpenedItemContext({ environmentId, activeThreadRef, showWindow, showTab });
+    return () => {
+      setPlutoniumFocusHandler(null);
+      setPlutoniumTabHandlers(null);
+      setOpenedItemContext(null);
+    };
+  }, [activeThreadRef, environmentId, openPreview, router]);
+  return null;
+}
+
+export function windowLabel(entry: Pick<NativeWindowEntry, "id" | "title" | "appId">): string {
+  return entry.title || entry.appId || `Window ${entry.id}`;
+}
+
+function AppRow({
+  entry,
+  onOpen,
+  detail,
+}: {
+  entry: NativeWindowEntry;
+  onOpen: () => void;
+  detail?: string;
+}) {
+  return (
+    <button
+      type="button"
+      onClick={onOpen}
+      className="flex h-8 w-full cursor-pointer items-center gap-2.5 rounded-(--control-radius) px-2.5 text-left text-sm transition-colors hover:bg-accent/60"
+      data-plutonium-window={entry.id}
+    >
+      <AppWindowIcon className="size-4 shrink-0" />
+      <span className="min-w-0 flex-1 truncate">{windowLabel(entry)}</span>
+      <span className="shrink-0 text-muted-foreground text-xs">
+        {detail ?? (entry.embedded ? "In panel" : entry.appId)}
+      </span>
+    </button>
+  );
+}
+
+const noTabs: readonly BrokerTab[] = [];
+
+/** Browser tabs in no T3 thread, kept current. */
+function useElsewhereTabs(): readonly BrokerTab[] {
+  const preview = plutoniumPreview();
+  return useSyncExternalStore(
+    (onChange) => preview?.onTabs(onChange) ?? (() => undefined),
+    () => preview?.elsewhere() ?? noTabs,
+  );
+}
+
+function TabRow({ tab, detail, onOpen }: { tab: BrokerTab; detail: string; onOpen: () => void }) {
+  return (
+    <button
+      type="button"
+      onClick={onOpen}
+      className="flex h-8 w-full cursor-pointer items-center gap-2.5 rounded-(--control-radius) px-2.5 text-left text-sm transition-colors hover:bg-accent/60"
+      data-plutonium-tab={tab.id}
+    >
+      <GlobeIcon className="size-4 shrink-0" />
+      <span className="min-w-0 flex-1 truncate">{tab.title || tab.url}</span>
+      <span className="shrink-0 text-muted-foreground text-xs">{detail}</span>
+    </button>
+  );
+}
+
+/** The thread's windows, then windows and browser tabs in no T3 thread. */
+export function PlutoniumAppsPanel({
+  threadId,
+  onOpen,
+  onOpenTab,
+}: {
+  threadId: string | null;
+  onOpen: (entry: NativeWindowEntry) => void;
+  /** Brings a browser tab from elsewhere into the thread. */
+  onOpenTab?: (tab: BrokerTab) => void;
+}) {
+  const threadWindows = useThreadWindows(threadId);
+  const elsewhereWindows = useElsewhereWindows();
+  const elsewhereTabs = useElsewhereTabs().filter(
+    (tab) => onOpenTab !== undefined && tab.tags !== undefined,
+  );
+  const groups = usePlutoniumWindowStore((state) => state.groups);
+  const tagsAvailable = usePlutoniumWindowStore((state) =>
+    Object.values(state.windows).some((entry) => entry.tags !== undefined),
+  );
+  const openElsewhere = (entry: NativeWindowEntry) => {
+    // Bring it into this thread, then show it (its tab is the thread's now).
+    if (threadId !== null && tagsAvailable)
+      void addWindowToThread(entry.id, threadId).catch(() => {});
+    onOpen(entry);
+  };
+  return (
+    <div className="scrollbar-gutter-both flex min-h-0 flex-1 justify-center overflow-y-auto px-6">
+      <div className="w-full max-w-sm py-6">
+        <h3 className="mb-3 text-center font-medium text-foreground text-sm">Apps</h3>
+        {threadWindows.length === 0 ? (
+          <p className="px-2.5 py-1.5 text-center text-muted-foreground text-xs">
+            Apps that this thread's agent or terminals start show up here.
+          </p>
+        ) : (
+          <div className="flex flex-col gap-0.5">
+            {threadWindows.map((entry) => (
+              <AppRow key={entry.id} entry={entry} onOpen={() => onOpen(entry)} />
+            ))}
+          </div>
+        )}
+        {elsewhereWindows.length > 0 || elsewhereTabs.length > 0 ? (
+          <>
+            <h4 className="mt-5 mb-1.5 px-2.5 text-muted-foreground text-xs">
+              Elsewhere{tagsAvailable && threadId !== null ? " · opening one adds it here" : ""}
+            </h4>
+            <div className="flex flex-col gap-0.5">
+              {elsewhereWindows.map((entry) => {
+                const tags = windowTags(entry);
+                return (
+                  <AppRow
+                    key={entry.id}
+                    entry={entry}
+                    detail={tags[0] ? labelOfTag(groups, tags[0]) : "No thread"}
+                    onOpen={() => openElsewhere(entry)}
+                  />
+                );
+              })}
+              {elsewhereTabs.map((tab) => {
+                const tag = tabTags(tab)[0];
+                return (
+                  <TabRow
+                    key={`tab:${tab.id}`}
+                    tab={tab}
+                    detail={tag ? labelOfTag(groups, tag) : "No thread"}
+                    onOpen={() => onOpenTab?.(tab)}
+                  />
+                );
+              })}
+            </div>
+          </>
+        ) : null}
+      </div>
+    </div>
+  );
+}
+
+/** Bubbles from a panel app whose own maximize button was pressed; detail: { maximized }. */
+export const PANEL_MAXIMIZE_REQUEST_EVENT = "plutonium:panel-maximize-request";
+
+/** The size an agent holds `windowId` at, until the user takes control; else null. */
+function useAgentSize(windowId: number): { width: number; height: number } | null {
+  const width = usePlutoniumWindowStore((state) => state.agentWindows[windowId]?.width);
+  const height = usePlutoniumWindowStore((state) => state.agentWindows[windowId]?.height);
+  const userControl = usePlutoniumWindowStore(
+    (state) => state.agentWindows[windowId]?.userControl === true,
+  );
+  return width && height && !userControl ? { width, height } : null;
+}
+
+/** Whether an agent gave `windowId` input in the last few seconds. */
+function useAgentBusy(windowId: number): boolean {
+  return usePlutoniumWindowStore((state) => state.agentWindows[windowId]?.busy === true);
+}
+
+/** An element's content box, kept current. */
+function useBoxSize(ref: RefObject<HTMLElement | null>) {
+  const [size, setSize] = useState<{ width: number; height: number } | null>(null);
+  useEffect(() => {
+    const element = ref.current;
+    if (!element) return;
+    const observer = new ResizeObserver(([entry]) => {
+      if (entry) setSize({ width: entry.contentRect.width, height: entry.contentRect.height });
+    });
+    observer.observe(element);
+    return () => observer.disconnect();
+  }, [ref]);
+  return size;
+}
+
+function AgentWorkingDot({ busy }: { busy: boolean }) {
+  return (
+    <span className="relative flex size-2 shrink-0">
+      {busy && (
+        <span className="absolute inline-flex size-full animate-ping rounded-full bg-primary opacity-75" />
+      )}
+      <span className="relative inline-flex size-2 rounded-full bg-primary" />
+    </span>
+  );
+}
+
+/**
+ * Over a window an agent holds: the window is the agent's to drive (the
+ * user's clicks would land on a scaled copy), until the user takes control.
+ */
+function AgentLock({ windowId }: { windowId: number }) {
+  const busy = useAgentBusy(windowId);
+  const [releasing, setReleasing] = useState(false);
+  return (
+    <div className="absolute inset-0 flex items-end justify-center p-3" data-plutonium-agent-lock>
+      <div className="flex items-center gap-2.5 rounded-full border bg-popover/95 py-1 pr-1 pl-3 text-popover-foreground text-xs shadow-lg backdrop-blur-sm">
+        <AgentWorkingDot busy={busy} />
+        <span>{busy ? "Agent is working in this app" : "Agent is using this app"}</span>
+        <Button
+          size="xs"
+          variant="secondary"
+          className="rounded-full"
+          disabled={releasing}
+          onClick={() => {
+            setReleasing(true);
+            void releaseWindow(windowId)
+              .catch(() => {})
+              .finally(() => setReleasing(false));
+          }}
+        >
+          Take control
+        </Button>
+      </div>
+    </div>
+  );
+}
+
+function NativeWindowView({ windowId }: { windowId: number }) {
+  const ref = useRef<HTMLElement | null>(null);
+  const boxRef = useRef<HTMLDivElement | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [taken, setTaken] = useState(false);
+  const agentSize = useAgentSize(windowId);
+  const box = useBoxSize(boxRef);
+
+  useEffect(() => {
+    let cancelled = false;
+    setError(null);
+    grantFor(windowId).then(
+      (grant) => {
+        if (cancelled || !ref.current) return;
+        ref.current.setAttribute("window", String(windowId));
+        ref.current.setAttribute("grant", grant);
+      },
+      () => !cancelled && setError("No grant for this window."),
+    );
+    const element = ref.current;
+    const onError = () => setError("The browser refused to embed this window.");
+    // The app's own maximize button maximizes the panel (ChatView listens).
+    const onRequest = (event: Event) => {
+      const request = (event as Event & { request?: string }).request;
+      if (request !== "maximize" && request !== "unmaximize") return;
+      element?.dispatchEvent(
+        new CustomEvent(PANEL_MAXIMIZE_REQUEST_EVENT, {
+          bubbles: true,
+          detail: { maximized: request === "maximize" },
+        }),
+      );
+    };
+    // Another page (another display's shell) shows it now: a placeholder.
+    const onTaken = () =>
+      setTaken(
+        (element as (HTMLElement & { windowState?: string }) | null)?.windowState === "taken",
+      );
+    element?.addEventListener("windowerror", onError);
+    element?.addEventListener("windowrequest", onRequest);
+    element?.addEventListener("windowtaken", onTaken);
+    element?.addEventListener("windowchange", onTaken);
+    return () => {
+      cancelled = true;
+      element?.removeEventListener("windowerror", onError);
+      element?.removeEventListener("windowrequest", onRequest);
+      element?.removeEventListener("windowtaken", onTaken);
+      element?.removeEventListener("windowchange", onTaken);
+    };
+  }, [windowId]);
+
+  // The agent's size, scaled down (never up) to fit, and centered.
+  const scale =
+    agentSize && box ? Math.min(1, box.width / agentSize.width, box.height / agentSize.height) : 1;
+  const style = agentSize
+    ? {
+        display: "block",
+        position: "absolute",
+        left: box ? Math.max(0, (box.width - agentSize.width * scale) / 2) : 0,
+        top: box ? Math.max(0, (box.height - agentSize.height * scale) / 2) : 0,
+        width: agentSize.width,
+        height: agentSize.height,
+        transform: scale === 1 ? undefined : `scale(${scale})`,
+        transformOrigin: "0 0",
+      }
+    : { display: "block", width: "100%", height: "100%" };
+
+  return (
+    <div ref={boxRef} className="relative min-h-0 flex-1 overflow-hidden">
+      {createElement("native-window", {
+        ref,
+        key: windowId,
+        // When the panel is maximized or restored, the app fills it at once
+        // and its old frame fades into its new one (drags stay live; a newly
+        // shown app doesn't fade).
+        crossfade: "200",
+        style,
+      })}
+      {agentSize && !error && !taken && <AgentLock windowId={windowId} />}
+      {taken && !error && (
+        <div className="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-background text-sm text-muted-foreground">
+          <p>Shown on another display.</p>
+          <Button
+            size="xs"
+            variant="secondary"
+            onClick={() => {
+              // Attaching again is a new claim: the window comes back here.
+              const element = ref.current;
+              const grant = element?.getAttribute("grant");
+              if (!element || !grant) return;
+              element.removeAttribute("grant");
+              element.setAttribute("grant", grant);
+            }}
+          >
+            Bring it back
+          </Button>
+        </div>
+      )}
+      {error && (
+        <p className="absolute inset-0 flex items-center justify-center text-sm text-muted-foreground">
+          {error}
+        </p>
+      )}
+    </div>
+  );
+}
+
+/** In a window tab's header: the agent's size while it holds one, or that it's working in it. */
+function AgentHeaderBadge({ windowId }: { windowId: number }) {
+  const agentSize = useAgentSize(windowId);
+  const busy = useAgentBusy(windowId);
+  if (agentSize) {
+    return (
+      <span className="flex shrink-0 items-center gap-1 text-muted-foreground">
+        <BotIcon className="size-3.5" />
+        {agentSize.width}×{agentSize.height}
+      </span>
+    );
+  }
+  if (!busy) return null;
+  return (
+    <span className="flex shrink-0 items-center gap-1.5 text-muted-foreground">
+      <AgentWorkingDot busy />
+      Agent working
+    </span>
+  );
+}
+
+/** Several displays: sends the window to another display's shell. */
+function ToDisplayButtons({ windowId }: { windowId: number }) {
+  const displays = usePlutoniumWindowStore((state) => state.displays);
+  if (displays.length < 2) return null;
+  return (
+    <span className="flex shrink-0 items-center gap-1">
+      {displays
+        .filter((display) => !display.current)
+        .map((display) => (
+          <Button
+            key={display.id}
+            size="xs"
+            variant="ghost-muted"
+            title={display.label ? `Show on ${display.label}` : undefined}
+            onClick={() => void showOnDisplay(windowId, display.index)}
+          >
+            To display {display.index}
+          </Button>
+        ))}
+    </span>
+  );
+}
+
+/** One window as a panel tab. Popping out closes the tab and raises the window on the desktop. */
+export function PlutoniumAppSurface({
+  windowId,
+  appId,
+  onPopOut,
+}: {
+  windowId: number;
+  appId: string;
+  onPopOut: () => void;
+}) {
+  const entry = usePlutoniumWindowStore((state) => state.windows[windowId]);
+  const remote = usePlutoniumWindowStore((state) => state.remote);
+  // A tab restored from storage may name a window id that a new Ash session
+  // gave to a different app.
+  if (!entry || entry.appId !== appId) {
+    return (
+      <p className="flex flex-1 items-center justify-center text-sm text-muted-foreground">
+        This app is no longer running.
+      </p>
+    );
+  }
+  return (
+    <div className="flex min-h-0 flex-1 flex-col" data-plutonium-app-surface={windowId}>
+      <div className="flex h-8 shrink-0 items-center gap-2 border-b px-3 text-xs">
+        <span className="truncate font-medium text-foreground">{windowLabel(entry)}</span>
+        <span className="truncate text-muted-foreground">{entry.appId}</span>
+        <AgentHeaderBadge windowId={windowId} />
+        {remote ? null : (
+          <>
+            <Tooltip>
+              <TooltipTrigger
+                render={
+                  <Button
+                    aria-label="Pop out to desktop"
+                    className="ml-auto"
+                    size="icon-xs"
+                    variant="ghost-muted"
+                    onClick={() => {
+                      showOnDesktop(windowId);
+                      onPopOut();
+                    }}
+                  />
+                }
+              >
+                <SquareArrowOutUpRightIcon className="size-3.5" />
+              </TooltipTrigger>
+              <TooltipPopup>Pop out to desktop</TooltipPopup>
+            </Tooltip>
+            <ToDisplayButtons windowId={windowId} />
+          </>
+        )}
+      </div>
+      {remote ? <RemoteWindowView entry={entry} /> : <NativeWindowView windowId={windowId} />}
+    </div>
+  );
+}
diff --git a/apps/web/src/plutonium/RemoteWindowView.tsx b/apps/web/src/plutonium/RemoteWindowView.tsx
new file mode 100644
index 0000000000..ce66d4b17f
--- /dev/null
+++ b/apps/web/src/plutonium/RemoteWindowView.tsx
@@ -0,0 +1,218 @@
+// Plutonium: a native window away from the desktop, drawn from the server's
+// stream of its frames (remoteWindows.ts). Pointer and keyboard input on the
+// canvas go back to the window. The window keeps its size: the frame is
+// scaled down to fit the panel.
+import { useEffect, useRef, useState } from "react";
+
+import { usePrimaryEnvironmentId } from "~/state/environments";
+
+import {
+  inputModifiers,
+  mouseButton,
+  readWindowStreamAccess,
+  WINDOW_GONE_CODE,
+  WINDOWS_UNAVAILABLE_CODE,
+  wheelNotches,
+  windowPoint,
+  windowStreamUrl,
+} from "./remoteWindows";
+import type { NativeWindowEntry } from "./windowStore";
+
+const RECONNECT_MS = 1000;
+
+export function RemoteWindowView({ entry }: { entry: NativeWindowEntry }) {
+  const environmentId = usePrimaryEnvironmentId();
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const socketRef = useRef<WebSocket | null>(null);
+  // The latest size, for mapping input (the list updates it).
+  const sizeRef = useRef({ width: entry.width, height: entry.height });
+  sizeRef.current = { width: entry.width, height: entry.height };
+  const [status, setStatus] = useState<string | null>("Connecting…");
+  const windowId = entry.id;
+
+  // Frames in, drawn as they decode (a frame that arrives while one decodes
+  // replaces the waiting one).
+  useEffect(() => {
+    if (environmentId === null) return;
+    let stopped = false;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let decoding = false;
+    let waiting: Blob | null = null;
+    const draw = (blob: Blob) => {
+      if (decoding) {
+        waiting = blob;
+        return;
+      }
+      decoding = true;
+      void createImageBitmap(blob)
+        .then((bitmap) => {
+          const canvas = canvasRef.current;
+          if (!canvas || stopped) return bitmap.close();
+          if (canvas.width !== bitmap.width) canvas.width = bitmap.width;
+          if (canvas.height !== bitmap.height) canvas.height = bitmap.height;
+          canvas.getContext("2d")?.drawImage(bitmap, 0, 0);
+          bitmap.close();
+          setStatus(null);
+        })
+        .catch(() => {})
+        .finally(() => {
+          decoding = false;
+          const next = waiting;
+          waiting = null;
+          if (next && !stopped) draw(next);
+        });
+    };
+    const connect = async (refresh: boolean) => {
+      const access = await readWindowStreamAccess(environmentId, refresh);
+      if (stopped) return;
+      if (!access) {
+        timer = setTimeout(() => void connect(true), RECONNECT_MS);
+        return;
+      }
+      const socket = new WebSocket(windowStreamUrl(access, { windowId: String(windowId) }));
+      socket.binaryType = "blob";
+      socketRef.current = socket;
+      socket.addEventListener("message", (event) => {
+        if (event.data instanceof Blob) draw(new Blob([event.data], { type: "image/jpeg" }));
+      });
+      socket.addEventListener("close", (event) => {
+        if (socketRef.current === socket) socketRef.current = null;
+        if (stopped) return;
+        if (event.code === WINDOW_GONE_CODE) return setStatus("This app is no longer running.");
+        if (event.code === WINDOWS_UNAVAILABLE_CODE)
+          return setStatus("The desktop can't stream this window.");
+        setStatus("Reconnecting…");
+        timer = setTimeout(() => void connect(true), RECONNECT_MS);
+      });
+    };
+    void connect(false);
+    return () => {
+      stopped = true;
+      clearTimeout(timer);
+      socketRef.current?.close();
+      socketRef.current = null;
+    };
+  }, [environmentId, windowId]);
+
+  // Input out.
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    const send = (message: object) => {
+      const socket = socketRef.current;
+      if (socket?.readyState === WebSocket.OPEN) socket.send(JSON.stringify(message));
+    };
+    const point = (event: MouseEvent) =>
+      windowPoint(event.clientX, event.clientY, canvas.getBoundingClientRect(), sizeRef.current);
+    // Moves go at most once a frame.
+    let move: MouseEvent | null = null;
+    let moveFrame = 0;
+    const sendMove = () => {
+      moveFrame = 0;
+      if (!move) return;
+      const event = move;
+      move = null;
+      send({
+        type: "mouse",
+        event: {
+          type: "mouseMoved",
+          ...point(event),
+          button: "none",
+          buttons: event.buttons,
+          modifiers: inputModifiers(event),
+        },
+      });
+    };
+    const onMove = (event: MouseEvent) => {
+      move = event;
+      moveFrame ||= requestAnimationFrame(sendMove);
+    };
+    const onButton = (event: MouseEvent) => {
+      event.preventDefault();
+      if (event.type === "mousedown") canvas.focus();
+      sendMove();
+      send({
+        type: "mouse",
+        event: {
+          type: event.type === "mousedown" ? "mousePressed" : "mouseReleased",
+          ...point(event),
+          button: mouseButton(event.button),
+          buttons: event.buttons,
+          clickCount: Math.max(1, event.detail),
+          modifiers: inputModifiers(event),
+        },
+      });
+    };
+    // Drags keep going outside the canvas.
+    const onPointerDown = (event: PointerEvent) => canvas.setPointerCapture(event.pointerId);
+    const onWheel = (event: WheelEvent) => {
+      event.preventDefault();
+      send({
+        type: "mouse",
+        event: {
+          type: "mouseWheel",
+          ...point(event),
+          deltaX: wheelNotches(event.deltaX, event.deltaMode),
+          deltaY: wheelNotches(event.deltaY, event.deltaMode),
+          modifiers: inputModifiers(event),
+        },
+      });
+    };
+    const onKey = (event: KeyboardEvent) => {
+      if (!event.code) return;
+      event.preventDefault();
+      event.stopPropagation();
+      send({
+        type: "keys",
+        events: [
+          {
+            type: event.type === "keydown" ? "keyDown" : "keyUp",
+            code: event.code,
+            modifiers: inputModifiers(event),
+          },
+        ],
+      });
+    };
+    const onContextMenu = (event: Event) => event.preventDefault();
+    canvas.addEventListener("pointerdown", onPointerDown);
+    canvas.addEventListener("mousedown", onButton);
+    canvas.addEventListener("mouseup", onButton);
+    canvas.addEventListener("mousemove", onMove);
+    canvas.addEventListener("wheel", onWheel, { passive: false });
+    canvas.addEventListener("keydown", onKey);
+    canvas.addEventListener("keyup", onKey);
+    canvas.addEventListener("contextmenu", onContextMenu);
+    return () => {
+      cancelAnimationFrame(moveFrame);
+      canvas.removeEventListener("pointerdown", onPointerDown);
+      canvas.removeEventListener("mousedown", onButton);
+      canvas.removeEventListener("mouseup", onButton);
+      canvas.removeEventListener("mousemove", onMove);
+      canvas.removeEventListener("wheel", onWheel);
+      canvas.removeEventListener("keydown", onKey);
+      canvas.removeEventListener("keyup", onKey);
+      canvas.removeEventListener("contextmenu", onContextMenu);
+    };
+  }, []);
+
+  return (
+    <div
+      className="relative flex min-h-0 flex-1 items-center justify-center overflow-hidden bg-muted/30"
+      data-plutonium-remote-window={windowId}
+    >
+      <canvas
+        ref={canvasRef}
+        tabIndex={0}
+        width={entry.width}
+        height={entry.height}
+        aria-label={entry.title || entry.appId}
+        className="max-h-full max-w-full outline-none"
+      />
+      {status && (
+        <p className="absolute inset-0 flex items-center justify-center text-sm text-muted-foreground">
+          {status}
+        </p>
+      )}
+    </div>
+  );
+}
diff --git a/apps/web/src/plutonium/importTab.ts b/apps/web/src/plutonium/importTab.ts
new file mode 100644
index 0000000000..9fcd605a92
--- /dev/null
+++ b/apps/web/src/plutonium/importTab.ts
@@ -0,0 +1,67 @@
+// Plutonium: bringing a browser tab from elsewhere (another shell's, or
+// nobody's) into a thread, as a new browser panel tab that shows it.
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import type { AtomCommandResult } from "@t3tools/client-runtime/state/runtime";
+
+import type { BrowserSettingsReadError, OpenPreviewMutation } from "~/browser/openFileInPreview";
+import { openPreviewSession } from "~/components/preview/openPreviewSession";
+import { useRightPanelStore } from "~/rightPanelStore";
+
+import { isBlank, plutoniumPreview, type BrokerTab } from "./previewBridge";
+
+const isWebUrl = (url: string) => /^https?:\/\//i.test(url);
+
+/** How long a tab may stay blank before it is brought in as it is. */
+const FIRST_URL_WAIT_MS = 5000;
+
+/**
+ * `tab` once it has a URL. A link this page opens in a new tab arrives blank,
+ * and the session has to start at the link: the server attaches only once the
+ * page has loaded, and a page loaded by then sends it nothing.
+ */
+function withFirstUrl(
+  preview: NonNullable<ReturnType<typeof plutoniumPreview>>,
+  tab: BrokerTab,
+): Promise<BrokerTab> {
+  if (!isBlank(tab.url)) return Promise.resolve(tab);
+  return new Promise((resolve) => {
+    const current = () => preview.tabList().find((entry) => entry.id === tab.id);
+    const done = (entry: BrokerTab) => {
+      window.clearTimeout(timer);
+      unsubscribe();
+      resolve(entry);
+    };
+    // This page may hear of the tab after the shell library does.
+    let seen = false;
+    const unsubscribe = preview.onTabs(() => {
+      const entry = current();
+      seen ||= entry !== undefined;
+      if (entry ? !isBlank(entry.url) : seen) done(entry ?? tab);
+    });
+    const timer = window.setTimeout(() => done(current() ?? tab), FIRST_URL_WAIT_MS);
+  });
+}
+
+export async function importBrowserTab<E>(input: {
+  readonly threadRef: ScopedThreadRef;
+  readonly tab: BrokerTab;
+  readonly openPreview: OpenPreviewMutation<E>;
+}): Promise<AtomCommandResult<unknown, E | BrowserSettingsReadError> | null> {
+  const preview = plutoniumPreview();
+  if (!preview) return null;
+  const { threadRef } = input;
+  const tab = await withFirstUrl(preview, input.tab);
+  await preview.importTab(threadRef.threadId, tab.id);
+  const result = await openPreviewSession({
+    openPreview: input.openPreview,
+    threadRef,
+    // The session starts at the tab's page, so it isn't shown as empty.
+    ...(isWebUrl(tab.url) ? { url: tab.url } : {}),
+  });
+  if (result._tag === "Failure") {
+    preview.cancelImport(threadRef.threadId, tab.id);
+    return result;
+  }
+  useRightPanelStore.getState().openBrowser(threadRef, result.value.tabId);
+  return result;
+}
diff --git a/apps/web/src/plutonium/openedItems.test.ts b/apps/web/src/plutonium/openedItems.test.ts
