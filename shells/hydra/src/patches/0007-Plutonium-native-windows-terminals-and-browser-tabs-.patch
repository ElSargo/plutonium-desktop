@@ -0,0 +1,866 @@
+// Plutonium: one file manager's state and commands: the folder, the cursor and
+// selection, the keys, the clipboard, dragging in and out, and picking. The three
+// views, the drawer, the Files panel and the picker all sit on this
+// (docs/features/FILE_MANAGER.md).
+import { useAtomValue } from "@effect/atom-react";
+import { useEffect, useRef, useState } from "react";
+import type { DragEvent, KeyboardEvent, MouseEvent } from "react";
+
+import {
+  COMPOSER_MENTION_DRAG_TYPE,
+  composerMentionFromTreePath,
+} from "~/components/chat/composerMentionDrag";
+import { toastManager } from "~/components/ui/toast";
+import { writeTextToClipboard } from "~/hooks/useCopyToClipboard";
+import { readLocalApi } from "~/localApi";
+import { primaryServerKeybindingsAtom } from "~/state/server";
+
+import { plutoniumShell } from "../windowStore";
+import { carryFiles } from "./carry";
+import { resolveFileKey } from "./fileKeys";
+import type { FileEntry, Place, SortKey } from "./filesCore";
+import { useFilesCore } from "./filesCore";
+import {
+  type FileView,
+  type FileViewSettings,
+  type PickerDetail,
+  useFilesStore,
+  useFileViewSettings,
+} from "./filesStore";
+
+/** What a drag between file managers carries: the paths, as JSON. */
+const PATHS_DRAG_TYPE = "application/x-plutonium-paths";
+
+export const ROW_HEIGHT = 28;
+
+export interface FileRow {
+  readonly entry: FileEntry;
+  readonly depth: number;
+}
+
+export type Prompt =
+  | { readonly kind: "filter" | "find" | "create" | "goto"; readonly value: string }
+  | { readonly kind: "rename"; readonly value: string; readonly path: string }
+  | { readonly kind: "delete"; readonly paths: readonly string[] };
+
+export interface FileManagerOptions {
+  /** Whose view, sort and such these are: each file manager has its own. */
+  readonly instance: string;
+  readonly initialDir: string;
+  /** The thread's project: the place `gp` goes, and what a thread's files open in. */
+  readonly project?: string | null;
+  readonly thread?: string;
+  /** Set while this is a picker. */
+  readonly pick?: {
+    readonly detail: PickerDetail;
+    /** Which of detail.filters applies; -1 for none. */
+    readonly filter: number;
+    readonly accept: (paths: readonly string[]) => void;
+    readonly cancel: () => void;
+  } | null;
+  /** A file is opened; else it opens with its app. */
+  readonly onOpenFile?: ((path: string) => void) | undefined;
+  /** Escape with nothing left to clear: puts it away; its place stays. */
+  readonly onHide?: (() => void) | undefined;
+  /** files.closePane: closes this one. */
+  readonly onClose?: (() => void) | undefined;
+  /** It moved to another folder. */
+  readonly onDirChange?: ((dir: string) => void) | undefined;
+  /** Opens another file manager beside this one, at `dir`. */
+  readonly onSplit?: ((dir: string) => void) | undefined;
+  /** Puts a mention of `path` in the composer, if this thread has one. */
+  readonly onAddToChat?: ((path: string) => void) | undefined;
+  /** No preview beside the list: the panel's own file view is there. */
+  readonly compact?: boolean;
+  /** One click opens a file, as the Files panel always has. */
+  readonly singleClickOpens?: boolean;
+}
+
+const fileUrl = (path: string) => `file://${path.split("/").map(encodeURIComponent).join("/")}`;
+
+const errorText = (error: unknown) => (error instanceof Error ? error.message : String(error));
+
+/** Gives `element` the keyboard, even from a tab or app that has it now. */
+export function takeKeyboard(element: HTMLElement | null): void {
+  void plutoniumShell().then((shell) => {
+    shell?.focusPage?.();
+    element?.focus();
+  });
+}
+
+export function useFileManager(options: FileManagerOptions) {
+  const { pick } = options;
+  const loaded = useFilesCore();
+  const core = loaded?.core;
+  const client = loaded?.helper;
+  const { instance } = options;
+  const settings = useFileViewSettings(instance);
+  const setView = useFilesStore((state) => state.setView);
+  const setSettings = (change: Partial<FileViewSettings>) => setView(instance, change);
+  const keybindings = useAtomValue(primaryServerKeybindingsAtom);
+  const clipboard = useFilesStore((state) => state.clipboard);
+  const setClipboard = useFilesStore((state) => state.setClipboard);
+  const runJob = useFilesStore((state) => state.run);
+  const undoLast = useFilesStore((state) => state.undoLast);
+  const pushUndo = useFilesStore((state) => state.pushUndo);
+  const { view, sort, reverse, hidden } = settings;
+
+  const [dir, setDir] = useState(options.initialDir);
+  const [entries, setEntries] = useState<readonly FileEntry[]>([]);
+  const [parentEntries, setParentEntries] = useState<readonly FileEntry[]>([]);
+  const [error, setError] = useState<string | null>(null);
+  const [cursor, setCursor] = useState<string | null>(null);
+  const [selected, setSelected] = useState<ReadonlySet<string>>(new Set());
+  const [visualAnchor, setVisualAnchor] = useState<string | null>(null);
+  const [filter, setFilter] = useState("");
+  const [findQuery, setFindQuery] = useState("");
+  const [prompt, setPrompt] = useState<Prompt | null>(null);
+  const [fuzzyOpen, setFuzzyOpen] = useState(Boolean(pick?.detail.fuzzy));
+  const [helpOpen, setHelpOpen] = useState(false);
+  const [pending, setPending] = useState("");
+  const [places, setPlaces] = useState<readonly Place[]>([]);
+  const [expanded, setExpanded] = useState<ReadonlySet<string>>(new Set());
+  const [children, setChildren] = useState<ReadonlyMap<string, readonly FileEntry[]>>(new Map());
+  const [gridColumns, setGridColumns] = useState(1);
+  const [dropTarget, setDropTarget] = useState<string | null>(null);
+  const [history, setHistory] = useState<{
+    readonly back: readonly string[];
+    readonly forward: readonly string[];
+  }>({ back: [], forward: [] });
+  const rootRef = useRef<HTMLDivElement | null>(null);
+  const setRoot = (element: HTMLDivElement | null) => {
+    rootRef.current = element;
+  };
+  const focusRoot = () => rootRef.current?.focus();
+  const takeRootKeyboard = () => takeKeyboard(rootRef.current);
+  const shell = useRef<Awaited<ReturnType<typeof plutoniumShell>>>(null);
+  const { onDirChange } = options;
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- tells what's outside this file manager, as the prop's job
+  useEffect(() => {
+    onDirChange?.(dir);
+    // oxlint-disable-next-line react/exhaustive-effect-dependencies -- a new callback isn't a new folder
+  }, [dir]);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- follows the helper, the page's focus or the DOM, which are outside React
+  useEffect(() => {
+    void plutoniumShell().then((value) => {
+      shell.current = value;
+    });
