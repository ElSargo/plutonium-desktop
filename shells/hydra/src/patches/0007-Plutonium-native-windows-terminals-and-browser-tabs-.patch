index 0000000000..0dc73b65d6
--- /dev/null
+++ b/apps/web/src/plutonium/remoteWindows.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  inputModifiers,
+  mouseButton,
+  remoteWindowEntries,
+  wheelNotches,
+  windowPoint,
+  windowStreamUrl,
+} from "./remoteWindows";
+
+const window = {
+  id: 7,
+  appId: "org.gnome.TextEditor",
+  title: "Untitled",
+  width: 800,
+  height: 600,
+  deviceScaleFactor: 1,
+  embedded: false,
+  focused: false,
+  pid: 42,
+};
+
+describe("remote windows", () => {
+  it("files a window under the first T3 thread among its tags", () => {
+    const entries = remoteWindowEntries([
+      { ...window, tags: ["niri:workspace/1", "t3:thread/abc", "t3:thread/def"] },
+      { ...window, id: 8, tags: [] },
+    ]);
+    expect(entries[7]?.threadId).toBe("abc");
+    expect(entries[8]?.threadId).toBeNull();
+  });
+
+  it("maps a point on the scaled frame to the window's DIPs", () => {
+    const rect = { left: 100, top: 50, width: 400, height: 300 };
+    expect(windowPoint(300, 200, rect, window)).toEqual({ x: 400, y: 300 });
+    // Drags outside the frame stay on the window's edge.
+    expect(windowPoint(0, 1000, rect, window)).toEqual({ x: 0, y: 600 });
+  });
+
+  it("speaks the helper's input", () => {
+    expect(inputModifiers({ altKey: true, ctrlKey: true, metaKey: false, shiftKey: true })).toBe(
+      11,
+    );
+    expect([0, 1, 2, 9].map(mouseButton)).toEqual(["left", "middle", "right", "none"]);
+    expect(wheelNotches(0, 0)).toBe(0);
+    expect(wheelNotches(4, 0)).toBe(1);
+    expect(wheelNotches(-250, 0)).toBe(-3);
+    expect(wheelNotches(3, 1)).toBe(1);
+  });
+
+  it("puts the ticket on the socket's URL", () => {
+    const access = {
+      httpBase: "https://desk.example/api/window-stream",
+      wsBase: "wss://desk.example/api/window-stream",
+      query: { wsTicket: "t" },
+      credentials: false,
+    };
+    expect(windowStreamUrl(access, { windowId: "7" })).toBe(
+      "wss://desk.example/api/window-stream/ws?windowId=7&wsTicket=t",
+    );
+    expect(windowStreamUrl(access)).toBe("wss://desk.example/api/window-stream/ws?wsTicket=t");
+  });
+});
diff --git a/apps/web/src/plutonium/remoteWindows.ts b/apps/web/src/plutonium/remoteWindows.ts
new file mode 100644
index 0000000000..ce62701cd9
--- /dev/null
+++ b/apps/web/src/plutonium/remoteWindows.ts
@@ -0,0 +1,187 @@
+// Plutonium: native windows for a client away from the desktop (another
+// machine's browser). The shell shows windows with <native-window>, which only
+// the session's own browser has; here the server streams them instead
+// (/api/window-stream on T3's server, through the helper): the window list
+// fills the same store, and a window's tab draws its frames on a canvas and
+// sends pointer and keyboard input back.
+import { resolveDeviceHubAccess } from "@t3tools/client-runtime/state/deviceHubAccess";
+import {
+  type DeviceHubAccess,
+  withDeviceHubQuery,
+} from "@t3tools/client-runtime/device/hub-access";
+import type { EnvironmentId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import { Atom, AtomRegistry } from "effect/reactivity";
+
+import { connectionAtomRuntime } from "~/connection/runtime";
+import { appAtomRegistry } from "~/rpc/atomRegistry";
+import { useRightPanelStore } from "~/rightPanelStore";
+import { environmentSession } from "~/state/session";
+
+import { threadIdOfTag } from "./threadTag";
+import { type NativeWindowEntry, usePlutoniumWindowStore } from "./windowStore";
+
+export const WINDOW_STREAM_BASE_PATH = "/api/window-stream";
+/** The server's close codes (apps/server/src/plutonium/windowStream.ts). */
+export const WINDOW_GONE_CODE = 4404;
+export const WINDOWS_UNAVAILABLE_CODE = 4503;
+const RECONNECT_MS = 2000;
+
+const windowStreamAccessAtom = Atom.family((environmentId: EnvironmentId) =>
+  connectionAtomRuntime
+    .atom((get) => {
+      const prepared = Option.getOrNull(
+        get(environmentSession.preparedConnectionValueAtom(environmentId)),
+      );
+      if (prepared === null) return Effect.never;
+      return resolveDeviceHubAccess({ prepared, hubBasePath: WINDOW_STREAM_BASE_PATH });
+    })
+    .pipe(Atom.setIdleTTL(60_000), Atom.withLabel(`window-stream-access:${environmentId}`)),
+);
+
+/** Access to the window stream (a fresh ticket with `refresh`); null if there is none. */
+export function readWindowStreamAccess(
+  environmentId: EnvironmentId,
+  refresh: boolean,
+): Promise<DeviceHubAccess | null> {
+  const atom = windowStreamAccessAtom(environmentId);
+  if (refresh) appAtomRegistry.refresh(atom);
+  return Effect.runPromise(
+    AtomRegistry.getResult(appAtomRegistry, atom, { suspendOnWaiting: true }).pipe(
+      Effect.timeout("10 seconds"),
+      Effect.orElseSucceed(() => null),
+    ),
+  );
+}
+
+/** A WebSocket URL on the window stream. */
+export function windowStreamUrl(
+  access: DeviceHubAccess,
+  query: Readonly<Record<string, string>> = {},
+): string {
+  const search = new URLSearchParams(query).toString();
+  return withDeviceHubQuery(`${access.wsBase}/ws${search ? `?${search}` : ""}`, access);
+}
+
+/** The helper's window list as store entries (the thread is the first T3 thread tag's). */
+export function remoteWindowEntries(
+  list: readonly Omit<NativeWindowEntry, "threadId">[],
+): Record<number, NativeWindowEntry> {
+  return Object.fromEntries(
+    list.map((window) => [
+      window.id,
+      {
+        ...window,
+        threadId: (window.tags ?? []).map(threadIdOfTag).find((id) => id !== null) ?? null,
+      },
+    ]),
+  );
+}
+
+/**
+ * Fills the window store from the server's list, kept current, unless this
+ * page is the shell. Returns a function that stops.
+ */
+export function startRemoteWindows(environmentId: EnvironmentId): () => void {
+  let socket: WebSocket | null = null;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let stopped = false;
+  let reconciled = false;
+  // Refused upgrades (a server without the route) close before opening.
+  let refusals = 0;
+  const connect = async (refresh: boolean) => {
+    const access = await readWindowStreamAccess(environmentId, refresh);
+    if (stopped) return;
+    if (!access) {
+      timer = setTimeout(() => void connect(true), RECONNECT_MS);
+      return;
+    }
+    socket = new WebSocket(windowStreamUrl(access));
+    let opened = false;
+    socket.addEventListener("open", () => {
+      opened = true;
+      refusals = 0;
+    });
+    socket.addEventListener("message", (event) => {
+      if (typeof event.data !== "string") return;
+      const message = JSON.parse(event.data) as {
+        type?: string;
+        windows?: Omit<NativeWindowEntry, "threadId">[];
+      };
+      if (message.type !== "windows" || !message.windows) return;
+      const windows = remoteWindowEntries(message.windows);
+      usePlutoniumWindowStore.setState({ available: true, remote: true, windows });
+      // As in the shell: a tab whose window is gone (or is another app now) closes.
+      useRightPanelStore
+        .getState()
+        .reconcileAppSurfaces((id, appId) =>
+          reconciled ? id in windows : windows[id]?.appId === appId,
+        );
+      reconciled = true;
+    });
+    socket.addEventListener("close", (event) => {
+      socket = null;
+      if (stopped) return;
+      if (!opened) refusals++;
+      if (event.code === WINDOWS_UNAVAILABLE_CODE || refusals >= 3) {
+        // No Plutonium session behind this server: no Apps panel.
+        usePlutoniumWindowStore.setState({ available: false, windows: {} });
+        useRightPanelStore.getState().reconcileAppSurfaces(() => false);
+        return;
+      }
+      timer = setTimeout(() => void connect(true), RECONNECT_MS);
+    });
+  };
+  void connect(false);
+  return () => {
+    stopped = true;
+    clearTimeout(timer);
+    socket?.close();
+  };
+}
+
+/** Alt=1, Ctrl=2, Meta=4, Shift=8, as the helper's input takes them. */
+export function inputModifiers(
+  event: Pick<KeyboardEvent, "altKey" | "ctrlKey" | "metaKey" | "shiftKey">,
+): number {
+  return (
+    (event.altKey ? 1 : 0) |
+    (event.ctrlKey ? 2 : 0) |
+    (event.metaKey ? 4 : 0) |
+    (event.shiftKey ? 8 : 0)
+  );
+}
+
+const BUTTONS = ["left", "middle", "right", "back", "forward"] as const;
+
+/** A DOM mouse button as the helper names it. */
+export function mouseButton(button: number): (typeof BUTTONS)[number] | "none" {
+  return BUTTONS[button] ?? "none";
+}
+
+/** Wheel pixels (or lines) as notches, at least one in the direction scrolled. */
+export function wheelNotches(delta: number, deltaMode: number): number {
+  if (delta === 0) return 0;
+  const notches = deltaMode === 0 ? delta / 100 : deltaMode === 1 ? delta / 3 : delta * 10;
+  return Math.sign(notches) * Math.max(1, Math.round(Math.abs(notches)));
+}
+
+/**
+ * A point on the drawn frame (`rect`, CSS px) in the window's DIPs; the
+ * frame shows the whole window, scaled.
+ */
+export function windowPoint(
+  clientX: number,
+  clientY: number,
+  rect: Pick<DOMRect, "left" | "top" | "width" | "height">,
+  window: Pick<NativeWindowEntry, "width" | "height">,
+): { x: number; y: number } {
+  const clamp = (value: number, max: number) => Math.min(Math.max(value, 0), max);
+  return {
+    x: Math.round(clamp(((clientX - rect.left) / (rect.width || 1)) * window.width, window.width)),
+    y: Math.round(
+      clamp(((clientY - rect.top) / (rect.height || 1)) * window.height, window.height),
+    ),
+  };
+}
diff --git a/apps/web/src/plutonium/threadTag.ts b/apps/web/src/plutonium/threadTag.ts
new file mode 100644
index 0000000000..10b488e399
--- /dev/null
+++ b/apps/web/src/plutonium/threadTag.ts
@@ -0,0 +1,41 @@
+// Plutonium tags for T3 threads. A thread's tag is what its processes carry
+// as PLUTONIUM_THREAD_ID (the server sets it, apps/server/src/plutonium.ts)
+// and what the windows and tabs it opens are tagged with. Namespaced, so
+// other shells' threads can't collide with it.
+
+const THREAD_TAG_PREFIX = "t3:thread/";
+
+/** A T3 thread's Plutonium tag. */
+export function threadTag(threadId: string): string {
+  return `${THREAD_TAG_PREFIX}${threadId}`;
+}
+
+/** The T3 thread a tag names, or null. */
+export function threadIdOfTag(tag: string | null | undefined): string | null {
+  return tag?.startsWith(THREAD_TAG_PREFIX) ? tag.slice(THREAD_TAG_PREFIX.length) : null;
+}
+
+/** The tag of what a dock slot keeps per project: `projectId`'s windows. */
+export function projectTag(projectId: string): string {
+  return `t3:project/${projectId}`;
+}
+
+/** The tag of what a dock slot keeps everywhere. */
+export const GLOBAL_TAG = "t3:global";
+
+/** Whether `tag` is a dock scope's (a project's or everywhere), not a thread's. */
+export function isDockScopeTag(tag: string): boolean {
+  return tag === GLOBAL_TAG || tag.startsWith("t3:project/");
+}
+
+const DOCK_SLOT_TAG_PREFIX = "t3:dock/";
+
+/** The tag of the one window or tab a dock slot holds (in each of its scopes). */
+export function dockSlotTag(slotId: string): string {
+  return `${DOCK_SLOT_TAG_PREFIX}${slotId}`;
+}
+
+/** Whether `tag` marks something a dock slot holds. */
+export function isDockSlotTag(tag: string): boolean {
+  return tag.startsWith(DOCK_SLOT_TAG_PREFIX);
+}
diff --git a/apps/web/src/plutonium/useThreadPlutonium.ts b/apps/web/src/plutonium/useThreadPlutonium.ts
new file mode 100644
index 0000000000..25676c6f32
--- /dev/null
+++ b/apps/web/src/plutonium/useThreadPlutonium.ts
@@ -0,0 +1,188 @@
+// Plutonium: what a thread's chat view adds in the Plutonium shell, kept out
+// of ChatView so a T3 Code upgrade only meets a few lines there: the Apps tab,
+// the dock's context (its sites, tabs and terminal), the panel's keys, an
+// app's own maximize button, and the floating preview following the tab the
+// agent drives.
+import {
+  isAtomCommandInterrupted,
+  squashAtomCommandFailure,
+} from "@t3tools/client-runtime/state/runtime";
+import type { ResolvedKeybindingsConfig, ScopedThreadRef } from "@t3tools/contracts";
+import { useEffect } from "react";
+
+import { useBrowserPointerStore } from "../browser/browserPointerStore";
+import { previewRuntimeTabId } from "../browser/previewRuntimeTabId";
+import { openPreviewSession } from "../components/preview/openPreviewSession";
+import { stackedThreadToast, toastManager } from "../components/ui/toast";
+import { useStableCallback } from "../hooks/useStableCallback";
+import { focusActiveDrawerTerminal } from "../lib/terminalFocus";
+import {
+  browserMiniPlayerSource,
+  selectThreadPreviewMiniPlayer,
+  usePreviewMiniPlayerStore,
+} from "../previewMiniPlayerStore";
+import { beginPreviewSessionClose, type ThreadPreviewState } from "../previewStateStore";
+import { type RightPanelSurface, useRightPanelStore } from "../rightPanelStore";
+import { previewEnvironment } from "../state/preview";
+import { useAtomCommand } from "../state/use-atom-command";
+import { type DockContext, publishDockContext, useTerminalFolded } from "./dock";
+import { importBrowserTab } from "./importTab";
+import { usePlutoniumPanelKeys } from "./panelKeys";
+import type { BrokerTab } from "./previewBridge";
+import { PANEL_MAXIMIZE_REQUEST_EVENT } from "./PlutoniumWindows";
+import { usePlutoniumWindowStore } from "./windowStore";
+
+export interface ThreadPlutoniumInput {
+  readonly threadRef: ScopedThreadRef | null;
+  readonly projectId: string | null;
+  readonly keybindings: ResolvedKeybindingsConfig;
+  readonly canOperatePreview: boolean;
+  readonly surfaces: readonly RightPanelSurface[];
+  readonly activeSurfaceId: string | null;
+  readonly panelOpen: boolean;
+  readonly maximized: boolean;
+  readonly canMaximize: boolean;
+  readonly terminalOpen: boolean;
+  readonly previewState: ThreadPreviewState;
+  readonly toggleTerminal: () => void;
+  readonly setTerminalOpen: (open: boolean) => void;
+  readonly focusComposer: () => void;
+  readonly activate: (surface: RightPanelSurface) => void;
+  readonly newBrowserTab: () => void;
+}
+
+export function useThreadPlutonium(input: ThreadPlutoniumInput) {
+  const { threadRef, canOperatePreview } = input;
+  const openPreview = useAtomCommand(previewEnvironment.open, { reportFailure: false });
+  const closePreview = useAtomCommand(previewEnvironment.close, "preview close");
+
+  // Native windows, only when this page is the shell.
+  const appsAvailable = usePlutoniumWindowStore((state) => state.available);
+  const addApps = useStableCallback(() => {
+    if (threadRef) useRightPanelStore.getState().open(threadRef, "apps");
+  });
+
+  // The dock folded the conversation away for the terminal drawer.
+  const terminalFolded = useTerminalFolded(threadRef);
+  const terminalFoldedAway = terminalFolded && input.terminalOpen;
+
+  const reportOpenFailure = (error: unknown) =>
+    toastManager.add(
+      stackedThreadToast({
+        type: "error",
+        title: "Unable to open browser",
+        description: error instanceof Error ? error.message : String(error),
+      }),
+    );
+  // A dock slot's site, opened as a new browser tab.
+  const openSite = useStableCallback(async (url: string) => {
+    if (!threadRef || !canOperatePreview) return;
+    const result = await openPreviewSession({ openPreview, threadRef, url });
+    if (result._tag === "Failure") {
+      if (!isAtomCommandInterrupted(result)) reportOpenFailure(squashAtomCommandFailure(result));
+      return;
+    }
+    useRightPanelStore.getState().openBrowser(threadRef, result.value.tabId);
+    useRightPanelStore.getState().show(threadRef);
+  });
+  // A dock slot's tab kept per project or everywhere, moving here.
+  const showTab = useStableCallback(async (tab: BrokerTab): Promise<string | null> => {
+    if (!threadRef || !canOperatePreview) return null;
+    const result = await importBrowserTab({ threadRef, tab, openPreview });
+    if (!result || result._tag === "Failure") {
+      if (result && isAtomCommandInterrupted(result)) return null;
+      reportOpenFailure(result ? squashAtomCommandFailure(result) : "No Plutonium browser");
+      return null;
+    }
+    useRightPanelStore.getState().show(threadRef);
+    return (result.value as { tabId: string }).tabId;
+  });
+  const closeDockPreview = useStableCallback(async (ref: ScopedThreadRef, tabId: string) => {
+    beginPreviewSessionClose(ref, tabId);
+    await closePreview({
+      environmentId: ref.environmentId,
+      input: { threadId: ref.threadId, tabId },
+    });
+  });
+  // The Apps tab's "Elsewhere" list brings another shell's tab here.
+  const importTab = useStableCallback((tab: BrokerTab) => {
+    if (threadRef) void importBrowserTab({ threadRef, tab, openPreview });
+  });
+  const closeTerminal = useStableCallback(() => input.setTerminalOpen(false));
+  const focusTerminal = useStableCallback(() => {
+    if (threadRef) focusActiveDrawerTerminal(threadRef);
+  });
+
+  const dock: DockContext | null = threadRef
+    ? {
+        threadRef,
+        projectId: input.projectId,
+        surfaces: input.surfaces,
+        activeSurfaceId: input.activeSurfaceId,
+        panelOpen: input.panelOpen,
+        maximized: input.maximized,
+        terminalOpen: input.terminalOpen,
+        openTerminal: input.toggleTerminal,
+        closeTerminal,
+        focusTerminal,
+        focusComposer: input.focusComposer,
+        activate: input.activate,
+        openSite,
+        showTab,
+        closePreview: closeDockPreview,
+      }
+    : null;
+  // The sidebar's dock runs slots in this thread and shows their state.
+  useEffect(() => publishDockContext(dock));
+  useEffect(() => () => publishDockContext(null), []);
+  // Alt+1…9, Ctrl+Tab and Ctrl+T for the panel's tabs, and the dock.
+  usePlutoniumPanelKeys({
+    threadRef,
+    keybindings: input.keybindings,
+    surfaces: input.surfaces,
+    activeSurfaceId: input.activeSurfaceId,
+    activate: input.activate,
+    newBrowserTab: input.newBrowserTab,
+    dock,
+  });
+
+  // An app in the panel pressed its own maximize (or restore) button.
+  const { canMaximize } = input;
+  useEffect(() => {
+    const onRequest = (event: Event) => {
+      if (!canMaximize || !threadRef) return;
+      const { maximized } = (event as CustomEvent<{ maximized: boolean }>).detail;
+      useRightPanelStore.getState().setMaximized(threadRef, maximized);
+    };
+    document.addEventListener(PANEL_MAXIMIZE_REQUEST_EVENT, onRequest);
+    return () => document.removeEventListener(PANEL_MAXIMIZE_REQUEST_EVENT, onRequest);
+  }, [canMaximize, threadRef]);
+
+  // The floating preview follows the tab the agent drives: the agent's cursor
+  // in another of the thread's tabs brings that one up in it.
+  const { sessions, serverEpoch } = input.previewState;
+  useEffect(() => {
+    if (!threadRef) return;
+    return useBrowserPointerStore.subscribe((state, previous) => {
+      const source = selectThreadPreviewMiniPlayer(
+        usePreviewMiniPlayerStore.getState().byThreadKey,
+        threadRef,
+      )?.source;
+      if (source?.kind !== "browser") return;
+      for (const [runtimeTabId, event] of Object.entries(state.byTabId)) {
+        if (previous.byTabId[runtimeTabId] === event) continue;
+        const session = Object.values(sessions).find(
+          (candidate) =>
+            previewRuntimeTabId(threadRef, serverEpoch, candidate.tabId) === runtimeTabId,
+        );
+        if (!session || session.tabId === source.tabId) continue;
+        usePreviewMiniPlayerStore
+          .getState()
+          .open(threadRef, browserMiniPlayerSource(session.tabId));
+        return;
+      }
+    });
+  }, [serverEpoch, sessions, threadRef]);
+
+  return { dock, appsAvailable, addApps, importTab, terminalFoldedAway };
+}
diff --git a/apps/web/src/plutonium/windowStore.ts b/apps/web/src/plutonium/windowStore.ts
new file mode 100644
index 0000000000..9a79ef095b
--- /dev/null
+++ b/apps/web/src/plutonium/windowStore.ts
@@ -0,0 +1,364 @@
+// Plutonium: native windows from the browser's window broker, grouped by the
+// thread whose agent or terminals started them (or that they were added to).
+//
+// Windows and tabs carry Plutonium tags. A T3 thread's tag is
+// "t3:thread/<thread id>" (threadTag()): its processes carry it, so the
+// windows they open start with it, and adding it to a window from elsewhere
+// (another shell, or no thread) brings the window into the thread. Other
+// shells' tags are shown by their labels (the browser's group table).
+//
+// Only active when this page is the Plutonium shell (Chromium exposes
+// `navigator.windowBroker` to the shell origin only). The window list, the
+// window → thread mapping and the agent bridge come from Plutonium's shell
+// library, loaded from its helper (helper/web/plutonium-shell.js in the
+// plutonium repo); this file mirrors its state into a store for React.
+import { create } from "zustand";
+
+import { useRightPanelStore } from "~/rightPanelStore";
+
+import { plutoniumHelperOrigin } from "./helperOrigin";
+import type { BrokerTab } from "./previewBridge";
+import { threadIdOfTag, threadTag } from "./threadTag";
+
+export { threadIdOfTag, threadTag };
+
+export interface NativeWindowEntry {
+  readonly id: number;
+  readonly appId: string;
+  readonly title: string;
+  readonly width: number;
+  readonly height: number;
+  readonly deviceScaleFactor: number;
+  readonly embedded: boolean;
+  readonly focused: boolean;
+  readonly pid: number;
+  /** The tag of the thread that started it; null if none did; undefined until known. */
+  readonly threadId: string | null | undefined;
+  /** The origin tag first, then the ones shells added (older browsers: missing). */
+  readonly tags?: readonly string[];
+}
+
+/**
+ * A window an agent works in (the shell library's agentWindows): the size it
+ * holds the window at, which a panel keeps, scaled to fit, until the user
+ * takes control; and whether it's working in it right now.
+ */
+export interface AgentWindow {
+  readonly id: number;
+  /** Absent once the user took control, or if the agent never held a size. */
+  readonly width?: number;
+  readonly height?: number;
+  readonly userControl: boolean;
+  readonly busy: boolean;
+}
+
+/** A tag a shell described: what to call it, and which shell owns it. */
+export interface PlutoniumGroup {
+  readonly tag: string;
+  readonly label: string;
+  readonly shellId: string;
+}
+
+/** A window's tags (before the browser had tags: just its thread's). */
+export function windowTags(entry: NativeWindowEntry): readonly string[] {
+  if (entry.tags && entry.tags.length > 0) return entry.tags;
+  return entry.threadId ? [entry.threadId] : [];
+}
+
+/** A display (several displays: each has its own shell pages, T3 among them). */
+export interface PlutoniumDisplay {
+  readonly id: string;
+  /** 1-based, left to right: "display 2". */
+  readonly index: number;
+  readonly label: string;
+  readonly focused: boolean;
+  /** This page is on it. */
+  readonly current: boolean;
+}
+
+/** A desktop app the helper can launch (a freedesktop.org desktop entry). */
+export interface DesktopApp {
+  readonly id: string;
+  readonly name: string;
+  readonly genericName: string;
+  readonly comment: string;
+  readonly keywords: readonly string[];
+  readonly categories: readonly string[];
+  readonly hasIcon: boolean;
+  readonly terminal: boolean;
+}
+
+/** The parts of the shell library's PlutoniumShell used here. */
+interface PlutoniumShell extends EventTarget {
+  readonly available: boolean;
+  readonly ready: Promise<void>;
+  readonly windows: ReadonlyMap<number, NativeWindowEntry>;
+  /** Browser tabs, by id (older libraries: missing). */
+  readonly tabs?: ReadonlyMap<number, BrokerTab>;
+  onFocus: ((window: NativeWindowEntry) => boolean | Promise<boolean>) | undefined;
+  grantFor(windowId: number): Promise<string>;
+  showOnDesktop(windowId: number): void;
+  apps(): Promise<DesktopApp[]>;
+  appIcon(appId: string): Promise<string | null>;
+  /** An object URL for a website's own icon, fetched by the helper (older libraries: missing). */
+  siteIcon?(pageUrl: string): Promise<string | null>;
+  launchApp(
+    threadId: string,
+    appId: string,
+    options?: { waitMs?: number },
+  ): Promise<{ pid: number; windows: { id: number; appId: string }[] }>;
+  setShellShortcuts?(shortcuts: readonly string[]): void;
+  readonly tagsAvailable?: boolean;
+  readonly groups?: ReadonlyMap<string, PlutoniumGroup>;
+  tagWindow?(windowId: number, add: readonly string[], remove?: readonly string[]): Promise<void>;
+  setGroups?(groups: readonly { tag: string; label: string }[]): void;
+  /**
+   * Lets the server drive browser tab `browserTabId`, shown here as its tab
+   * `serverTab`; resolves to the browser tab to show (another shell page's, if
+   * it shows the server's tab already). With `replace` (a tab brought from
+   * elsewhere), it wins over one the helper opened for the server itself.
+   */
+  showServerTab(
+    browserTabId: number,
+    serverTab: { readonly threadId: string; readonly tabId: string },
+    options?: { readonly replace?: boolean },
+  ): Promise<number>;
+  releaseServerTab(serverTab: { readonly threadId: string; readonly tabId: string }): Promise<void>;
+  /** Windows agents work in (older libraries: missing). */
+  readonly agentWindows?: ReadonlyMap<number, AgentWindow>;
+  releaseWindow?(windowId: number): Promise<void>;
+  /** The displays (older libraries: missing). */
+  readonly displays?: readonly PlutoniumDisplay[];
+  showOnDisplay?(windowId: number, display: number | string): Promise<boolean>;
+  /** Desktop services (DESKTOP_SERVICES.md; older libraries: missing). */
+  readonly system?: { get(name: string): SystemServiceHandle };
+}
+
+/** A desktop service in the shell library (`shell.system.<name>`): its state, kept current by "change" events. */
+export interface SystemServiceHandle extends EventTarget {
+  readonly state: unknown;
+  readonly error: string | null;
+  readonly ready: Promise<unknown>;
+  call(action: string, args?: Record<string, unknown>): Promise<unknown>;
+}
+
+interface PlutoniumWindowState {
+  readonly available: boolean;
+  /** The windows come from the server's stream (remoteWindows.ts), not this page's shell. */
+  readonly remote: boolean;
+  readonly windows: Readonly<Record<number, NativeWindowEntry>>;
+  /** Every shell's groups, by tag. */
+  readonly groups: Readonly<Record<string, PlutoniumGroup>>;
+  /** Windows agents work in, by id. */
+  readonly agentWindows: Readonly<Record<number, AgentWindow>>;
+  /** The displays, by index (empty with an older library). */
+  readonly displays: readonly PlutoniumDisplay[];
+}
+
+export const usePlutoniumWindowStore = create<PlutoniumWindowState>(() => ({
+  available: false,
+  remote: false,
+  windows: {},
+  groups: {},
+  agentWindows: {},
+  displays: [],
+}));
+
+let shell: PlutoniumShell | null = null;
+let focusHandler: ((window: NativeWindowEntry) => boolean) | null = null;
+
+/** How an agent's "show this window" (the bridge's focus) reaches the UI. */
+export function setPlutoniumFocusHandler(
+  handler: ((window: NativeWindowEntry) => boolean) | null,
+): void {
+  focusHandler = handler;
+}
+
+let tabHandlers: {
+  readonly onOpen: (tab: BrokerTab) => void;
+  readonly onFocus: (tab: BrokerTab) => boolean;
+} | null = null;
+
+/**
+ * Browser tabs that reach the UI: `onOpen` for a link this page opened in a
+ * new tab or window (window.open, target=_blank: what "open in the system
+ * browser" does here), which arrives untagged; `onFocus` for an agent's or
+ * the overlay's "show this tab".
+ */
+export function setPlutoniumTabHandlers(handlers: typeof tabHandlers): void {
+  tabHandlers = handlers;
+}
+
+/** A grant to embed `windowId` in this document (one per window, reused). */
+export function grantFor(windowId: number): Promise<string> {
+  return shell ? shell.grantFor(windowId) : Promise.reject(new Error("not the Plutonium shell"));
+}
+
+/** The user takes control of `windowId`'s size from the agent: the panel sizes it again. */
+export function releaseWindow(windowId: number): Promise<void> {
+  return shell?.releaseWindow
+    ? shell.releaseWindow(windowId)
+    : Promise.reject(new Error("this helper has no agent windows"));
+}
+
+/**
+ * Asks display `index`'s shell to show `windowId` (it takes the window from this page).
+ * Resolves to false if it didn't.
+ */
+export function showOnDisplay(windowId: number, index: number): Promise<boolean> {
+  return shell?.showOnDisplay ? shell.showOnDisplay(windowId, index) : Promise.resolve(false);
+}
+
+/** Raises `windowId` on the Ash desktop once no element shows it any more. */
+export function showOnDesktop(windowId: number): void {
+  shell?.showOnDesktop(windowId);
+}
+
+let shellReady: Promise<PlutoniumShell | null> | null = null;
+let resolveShell: ((shell: PlutoniumShell | null) => void) | null = null;
+
+/** The shell library once loaded; null outside the Plutonium shell. */
+export function plutoniumShell(): Promise<PlutoniumShell | null> {
+  shellReady ??= new Promise((resolve) => (resolveShell = resolve));
+  return shellReady;
+}
+
+/** Whether this page is the Plutonium shell (has the window broker). */
+export function isPlutoniumShell(): boolean {
+  return typeof navigator !== "undefined" && "windowBroker" in navigator;
+}
+
+function mirror(): void {
+  if (!shell) return;
+  const groups = shell.groups ? Object.fromEntries(shell.groups) : {};
+  const previous = usePlutoniumWindowStore.getState().groups;
+  usePlutoniumWindowStore.setState({
+    windows: Object.fromEntries(shell.windows),
+    // Unchanged groups keep their object, so selectors don't re-render.
+    groups: JSON.stringify(groups) === JSON.stringify(previous) ? previous : groups,
+  });
+}
+
+let describedGroups = "";
+let pendingGroups: { tag: string; label: string }[] | null = null;
+
+/** Tells the browser what T3's thread tags are called (other shells and the overlay show the labels). */
+export function describeThreads(threads: readonly { id: string; title: string }[]): void {
+  pendingGroups = threads.map((thread) => ({ tag: threadTag(thread.id), label: thread.title }));
+  flushGroups();
+}
+
+function flushGroups(): void {
+  if (!pendingGroups || !shell?.setGroups) return;
+  const key = JSON.stringify(pendingGroups);
+  if (key !== describedGroups) {
+    describedGroups = key;
+    shell.setGroups(pendingGroups);
+  }
+}
+
+/** Adds window `windowId` to `threadId` (it keeps the tags it had). */
+export function addWindowToThread(windowId: number, threadId: string): Promise<void> {
+  if (!shell?.tagWindow) return Promise.reject(new Error("this browser has no window tags"));
+  return shell.tagWindow(windowId, [threadTag(threadId)]);
+}
+
+/** Takes window `windowId` out of `threadId` (not the thread that started it). */
+export function removeWindowFromThread(windowId: number, threadId: string): Promise<void> {
+  if (!shell?.tagWindow) return Promise.reject(new Error("this browser has no window tags"));
+  return shell.tagWindow(windowId, [], [threadTag(threadId)]);
+}
+
+/** What to call `tag`: its group's label, else the tag. */
+export function labelOfTag(groups: Readonly<Record<string, PlutoniumGroup>>, tag: string): string {
+  return groups[tag]?.label || tag;
+}
+
+let started = false;
+
+/** Connect to the helper once per document. A no-op outside the shell. */
+export function startPlutoniumWindows(): void {
+  if (started) return;
+  started = true;
+  const dropAppTabs = () => useRightPanelStore.getState().reconcileAppSurfaces(() => false);
+  if (!("windowBroker" in navigator)) {
+    // Outside the shell the server streams the windows, if it can
+    // (startRemoteWindows); its list keeps or drops app tabs restored from storage.
+    void plutoniumShell();
+    resolveShell?.(null);
+    return;
+  }
+  const url = `${plutoniumHelperOrigin()}/v1/shell.js`;
+  import(/* @vite-ignore */ url).then(
+    (library: { connect(options: object): PlutoniumShell }) => {
+      shell = library.connect({
+        onFocus: (window: NativeWindowEntry) => focusHandler?.(window) ?? false,
+        // The handler tags the tab itself (importBrowserTab).
+        onOpenTab: (tab: BrokerTab) => {
+          tabHandlers?.onOpen(tab);
+          return undefined;
+        },
+        onFocusTab: (tab: BrokerTab) => tabHandlers?.onFocus(tab) ?? false,
+      });
+      usePlutoniumWindowStore.setState({ available: shell.available });
+      void shell.ready.then(flushGroups);
+      void plutoniumShell();
+      resolveShell?.(shell);
+      shell.addEventListener("change", mirror);
+      shell.addEventListener("displayschange", () => {
+        if (shell?.displays) usePlutoniumWindowStore.setState({ displays: [...shell.displays] });
+      });
+      shell.addEventListener("agentwindowschange", () => {
+        if (shell?.agentWindows)
+          usePlutoniumWindowStore.setState({
+            agentWindows: Object.fromEntries(shell.agentWindows),
+          });
+      });
+      // Window ids only hold within one Ash session: once the list is in,
+      // drop restored tabs whose window is gone or is now some other app.
+      void shell.ready.then(() => {
+        if (!shell) return;
+        const { windows } = shell;
+        mirror();
+        useRightPanelStore
+          .getState()
+          .reconcileAppSurfaces((id, appId) => windows.get(id)?.appId === appId);
+        // From then on, a closed window closes its tab.
+        shell.addEventListener("change", () =>
+          useRightPanelStore.getState().reconcileAppSurfaces((id) => windows.has(id)),
+        );
+      });
+    },
+    (error: unknown) => {
+      console.warn(`Plutonium: could not load the shell library from ${url}`, error);
+      dropAppTabs();
+      void plutoniumShell();
+      resolveShell?.(null);
+    },
+  );
+}
+
+/** Windows of `threadId` (started by its agent or terminals, or added to it), oldest first. */
+export function useThreadWindows(threadId: string | null): readonly NativeWindowEntry[] {
+  const windows = usePlutoniumWindowStore((state) => state.windows);
+  if (threadId === null) return [];
+  const tag = threadTag(threadId);
+  return Object.values(windows)
+    .filter((entry) => windowTags(entry).includes(tag))
+    .toSorted((a, b) => a.id - b.id);
+}
+
+/**
+ * Windows that are in no T3 thread (once their thread is known): another
+ * shell's, a workspace's, or nobody's. Oldest first.
+ */
+export function useElsewhereWindows(): readonly NativeWindowEntry[] {
+  const windows = usePlutoniumWindowStore((state) => state.windows);
+  return Object.values(windows)
+    .filter(
+      (entry) =>
+        entry.threadId !== undefined &&
+        !windowTags(entry).some((tag) => threadIdOfTag(tag) !== null),
+    )
+    .toSorted((a, b) => a.id - b.id);
+}
