+// Plutonium: what every file manager in the page shares: the settings, what's
+// copied or cut, running jobs and undo, where the panes are, and the picker a page,
+// tab or app is waiting on (docs/features/FILE_MANAGER.md).
+import { create } from "zustand";
+
+import { toastManager } from "~/components/ui/toast";
+
+import {
+  type FileJob,
+  type FileJobRequest,
+  filesClient,
+  loadFilesCore,
+  type SortKey,
+} from "./filesCore";
+
+export type FileView = "tree" | "columns" | "grid";
+
+/** What each file manager keeps for itself: two side by side can show different views. */
+export interface FileViewSettings {
+  readonly view: FileView;
+  readonly sort: SortKey;
+  readonly reverse: boolean;
+  readonly hidden: boolean;
+  readonly preview: boolean;
+  /** Sizes: Yazi's three columns, a list and its preview, Places and the rest. */
+  readonly columns: readonly number[];
+  readonly split: readonly number[];
+  readonly places: readonly number[];
+}
+
+const DEFAULT_VIEW: FileViewSettings = {
+  view: "tree",
+  sort: "name",
+  reverse: false,
+  hidden: false,
+  preview: true,
+  columns: [1, 1.4, 2],
+  split: [3, 2],
+  places: [1, 5],
+};
+
+const SETTINGS_KEY = "plutonium:file-manager-views";
+
+type StoredViews = Readonly<Record<string, Partial<FileViewSettings>>>;
+
+function loadViews(): StoredViews {
+  try {
+    return JSON.parse(localStorage.getItem(SETTINGS_KEY) ?? "{}") as StoredViews;
+  } catch {
+    return {};
+  }
+}
+
+const PANE_DIRS_KEY = "plutonium:file-pane-dirs";
+
+/** Where each file pane in a terminal drawer is: by thread key, then pane. */
+type PaneDirs = Readonly<Record<string, Readonly<Record<string, string>>>>;
+
+function loadPaneDirs(): PaneDirs {
+  try {
+    return JSON.parse(localStorage.getItem(PANE_DIRS_KEY) ?? "{}") as PaneDirs;
+  } catch {
+    return {};
+  }
+}
+
+/** A filter as a picker's request gives it. */
+export interface PickerFilter {
+  readonly name?: string;
+  readonly patterns: readonly string[];
+}
+
+export interface PickerChoice {
+  readonly id: string;
+  readonly label: string;
+  readonly options: readonly { id: string; label: string }[];
+  readonly value: string;
+}
+
+export interface PickerDetail {
+  readonly mode?: "open" | "open-multiple" | "folder" | "save";
+  readonly upload?: boolean;
+  readonly title?: string;
+  readonly origin?: string;
+  readonly filters?: readonly PickerFilter[];
+  readonly currentFilter?: number;
+  readonly currentName?: string;
+  readonly currentFolder?: string;
+  readonly acceptLabel?: string;
+  readonly choices?: readonly PickerChoice[];
+  /** Opens on the fuzzy finder, and leaving it leaves the picker. */
+  readonly fuzzy?: boolean;
+  /** Starts in the home folder, not where the last picker was. */
+  readonly home?: boolean;
+  /** The floating finder, not a request: what it finds can be picked up as well. */
+  readonly find?: boolean;
+}
+
+export interface PickerAnswer {
+  readonly paths: readonly string[];
+  readonly filter?: number;
+  readonly choices?: Record<string, string>;
+}
+
+export interface PickerRequest {
+  readonly id: number;
+  readonly detail: PickerDetail;
+  /** Who asked, for the header: an app's name, a site. */
+  readonly asker: string;
+  readonly answer: (answer: PickerAnswer | null) => void;
+}
+
+export interface FileClipboard {
+  readonly paths: readonly string[];
+  readonly cut: boolean;
+}
+
+interface FilesState {
+  readonly views: StoredViews;
+  readonly clipboard: FileClipboard | null;
+  readonly jobs: readonly FileJob[];
+  readonly undo: readonly (FileJobRequest | FileJobRequest[] | RenameUndo)[];
+  readonly paneDirs: PaneDirs;
+  readonly picker: PickerRequest | null;
+  /** What's riding on the pointer, for the hint. */
+  readonly carrying: readonly string[] | null;
+  setView(instance: string, change: Partial<FileViewSettings>): void;
+  setClipboard(clipboard: FileClipboard | null): void;
+  /** `dir` null forgets the pane. */
+  setPaneDir(threadKey: string, pane: string, dir: string | null): void;
+  setPicker(picker: PickerRequest | null): void;
+  setCarrying(paths: readonly string[] | null): void;
+  pushUndo(entry: RenameUndo): void;
+  run(request: FileJobRequest): Promise<FileJob | null>;
+  undoLast(): Promise<void>;
+}
+
+export interface RenameUndo {
+  readonly rename: { readonly path: string; readonly name: string };
+}
+
+const LABELS: Record<string, string> = {
+  copy: "Copying",
+  move: "Moving",
+  link: "Linking",
+  trash: "Moving to the trash",
+  delete: "Deleting",
+  restore: "Restoring",
+};
+
+export const jobLabel = (job: FileJob) => LABELS[job.op] ?? job.op;
+
+export const useFilesStore = create<FilesState>((set, get) => ({
+  views: loadViews(),
+  clipboard: null,
+  jobs: [],
+  undo: [],
+  paneDirs: loadPaneDirs(),
+  picker: null,
+  carrying: null,
+  setView: (instance, change) => {
+    const views = { ...get().views, [instance]: { ...get().views[instance], ...change } };
+    try {
+      localStorage.setItem(SETTINGS_KEY, JSON.stringify(views));
+    } catch {
+      // A private window: they last this session.
+    }
+    set({ views });
+  },
+  setClipboard: (clipboard) => set({ clipboard }),
+  setPaneDir: (threadKey, pane, dir) => {
+    const { [pane]: _was, ...others } = get().paneDirs[threadKey] ?? {};
+    const paneDirs = {
+      ...get().paneDirs,
+      [threadKey]: dir === null ? others : { ...others, [pane]: dir },
+    };
+    try {
+      localStorage.setItem(PANE_DIRS_KEY, JSON.stringify(paneDirs));
+    } catch {
+      // A private window: they last this session.
+    }
+    set({ paneDirs });
+  },
+  setPicker: (picker) => set({ picker }),
+  setCarrying: (carrying) => set({ carrying }),
+  pushUndo: (entry) => set((state) => ({ undo: [...state.undo, entry].slice(-50) })),
+  run: async (request) => {
+    const core = await loadFilesCore();
+    const client = filesClient();
+    if (!client) return null;
+    let id = 0;
+    const job = await client
+      .runJob(request, (update) => {
+        id = update.id;
+        set((state) => ({
+          jobs: [...state.jobs.filter((entry) => entry.id !== update.id), update],
+        }));
+      })
+      .catch((error: unknown) => {
+        toastManager.add({
+          type: "error",
+          title: "That didn't work",
+          description: error instanceof Error ? error.message : String(error),
+        });
+        return null;
+      });
+    set((state) => ({ jobs: state.jobs.filter((entry) => entry.id !== id) }));
+    if (!job) return null;
+    if (job.state === "failed") {
+      toastManager.add({ type: "error", title: `${jobLabel(job)} failed`, description: job.error });
+    }
+    const undo = core.undoOf(job);
+    if (undo) set((state) => ({ undo: [...state.undo, undo].slice(-50) }));
+    return job;
+  },
+  undoLast: async () => {
+    const entry = get().undo.at(-1);
+    if (!entry) {
+      toastManager.add({ type: "info", title: "Nothing to undo" });
+      return;
+    }
+    set((state) => ({ undo: state.undo.slice(0, -1) }));
+    if ("rename" in entry) {
+      await filesClient()?.rename(entry.rename.path, entry.rename.name);
+      return;
+    }
+    const before = get().undo;
+    for (const request of Array.isArray(entry) ? entry : [entry]) await get().run(request);
+    // Undoing isn't itself something to undo.
+    set({ undo: before });
+  },
+}));
+
+/** One file manager's settings. A second pane starts as Yazi's columns, beside the tree. */
+export function useFileViewSettings(instance: string): FileViewSettings {
+  const stored = useFilesStore((state) => state.views[instance]);
+  const start = /^drawer:[1-9]/.test(instance) ? { view: "columns" as const } : {};
+  return { ...DEFAULT_VIEW, ...start, ...stored };
+}
+
+/** The folder picker opens in when nothing says otherwise, per asker: where it last chose. */
+export const lastPickerFolder = { current: "" };
