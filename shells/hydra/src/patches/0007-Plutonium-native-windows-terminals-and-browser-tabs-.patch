+import { describe, expect, it } from "vite-plus/test";
+
+import { isFileManagerBinding, plutoniumFilesFocused, plutoniumFuzzyOwnsKey } from "./ownsKey";
+
+describe("the file manager's keys", () => {
+  it("are its own only while it has the keyboard", () => {
+    expect(plutoniumFilesFocused()).toBe(false);
+  });
+
+  it("leaves the fuzzy finder's keys to the page outside its search", () => {
+    expect(plutoniumFuzzyOwnsKey({ ctrlKey: true, key: "b" })).toBe(false);
+  });
+
+  it("leaves out the rules that open it from anywhere", () => {
+    expect(isFileManagerBinding({ command: "files.down" })).toBe(true);
+    expect(isFileManagerBinding({ command: "files.toggle" })).toBe(false);
+    expect(isFileManagerBinding({ command: "files.toggleRight" })).toBe(false);
+    expect(isFileManagerBinding({ command: "files.carry" })).toBe(false);
+    expect(isFileManagerBinding({ command: "files.carryFuzzy" })).toBe(false);
+    expect(isFileManagerBinding({ command: "files.findHome" })).toBe(false);
+    expect(isFileManagerBinding({ command: "files.openBeside" })).toBe(false);
+    expect(isFileManagerBinding({ command: "filePicker.toggle" })).toBe(false);
+  });
+});
