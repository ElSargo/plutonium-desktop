index 0000000000..c1fcfad0a2
--- /dev/null
+++ b/apps/web/src/plutonium/files/FileManager.tsx
@@ -0,0 +1,1305 @@
+// Plutonium: the file manager (docs/features/FILE_MANAGER.md): a tree, Yazi's three
+// columns or a grid, with a fuzzy finder, driven by the mouse or by keys from Hydra's
+// keybindings. The drawer, the Files panel and the picker are this in different
+// surroundings, and each keeps its own view.
+import {
+  ArrowLeftIcon,
+  ArrowRightIcon,
+  ArrowUpIcon,
+  ChevronRightIcon,
+  ColumnsIcon,
+  DownloadIcon,
+  EyeIcon,
+  EyeOffIcon,
+  FileTextIcon,
+  FilmIcon,
+  HardDriveIcon,
+  HouseIcon,
+  ImageIcon,
+  LayoutGridIcon,
+  ListTreeIcon,
+  type LucideIcon,
+  MonitorIcon,
+  MusicIcon,
+  PanelRightIcon,
+  SearchIcon,
+  SplitIcon,
+  XIcon,
+} from "lucide-react";
+import {
+  lazy,
+  memo,
+  Suspense,
+  useEffect,
+  useImperativeHandle,
+  useLayoutEffect,
+  useRef,
+  useState,
+} from "react";
+import { maskMarkdownFrontmatter } from "@t3tools/shared/markdownFrontmatter";
+
+import { PierreEntryIcon } from "~/components/chat/PierreEntryIcon";
+import { DelimitedTablePreview } from "~/components/files/DelimitedTablePreview";
+import { Button } from "~/components/ui/button";
+import { ToggleGroup, ToggleGroupItem } from "~/components/ui/toggle-group";
+import { useRenderedAppearance } from "~/hooks/useTheme";
+import { formatShortcutLabel } from "~/keybindings";
+import { observeResize } from "~/lib/observeResize";
+import { cn } from "~/lib/utils";
+
+import { isFileManagerBinding } from "./ownsKey";
+import type { FileEntry, FilesClient, FilesCore } from "./filesCore";
+import { type FileView, jobLabel, useFilesStore } from "./filesStore";
+import { SplitRow } from "./SplitRow";
+import { carryFiles } from "./carry";
+import {
+  type FileManagerOptions,
+  type FileManagerState,
+  type FileRow,
+  ROW_HEIGHT,
+  useFileManager,
+  takeKeyboard,
+} from "./useFileManager";
+
+const ChatMarkdown = lazy(() => import("~/components/ChatMarkdown"));
+const ReadOnlySourcePreview = lazy(() => import("~/components/files/ReadOnlySourcePreview"));
+
+/** A folder, in two tones, for lists and the grid. */
+function FolderGlyph({ className }: { className?: string }) {
+  return (
+    <svg
+      viewBox="0 0 24 24"
+      aria-hidden="true"
+      className={cn("size-4 shrink-0 text-primary", className)}
+    >
+      <path
+        fill="currentColor"
+        opacity="0.55"
+        d="M2.5 6.75A2.75 2.75 0 0 1 5.25 4h3.4c.73 0 1.43.29 1.94.8L12 6.2h6.75a2.75 2.75 0 0 1 2.75 2.75V10h-19z"
+      />
+      <path
+        fill="currentColor"
+        d="M2.5 10.25C2.5 9.01 3.51 8 4.75 8h14.5c1.24 0 2.25 1.01 2.25 2.25v7A2.75 2.75 0 0 1 18.75 20H5.25A2.75 2.75 0 0 1 2.5 17.25z"
+      />
+    </svg>
+  );
+}
+
+function EntryIcon({ entry, className }: { entry: FileEntry; className?: string }) {
+  const theme = useRenderedAppearance();
+  if (entry.kind === "dir") return <FolderGlyph {...(className ? { className } : {})} />;
+  return (
+    <PierreEntryIcon
+      pathValue={entry.name}
+      kind="file"
+      theme={theme}
+      {...(className ? { className } : {})}
+    />
+  );
+}
+
+function rowHandlers(state: FileManagerState, entry: FileEntry) {
+  return {
+    draggable: true,
+    onClick: (event: React.MouseEvent) => state.onRowClick(event, entry),
+    onDoubleClick: () => state.activate(entry),
+    onContextMenu: (event: React.MouseEvent) => {
+      event.stopPropagation();
+      state.onRowContextMenu(event, entry);
+    },
+    onPointerDown: () => state.armDrag(entry),
+    onDragStart: (event: React.DragEvent) => state.onRowDragStart(event, entry),
+    ...(entry.kind === "dir"
+      ? {
+          onDragOver: (event: React.DragEvent) => state.onDragOver(event, entry.path),
+          onDragLeave: () => state.setDropTarget(null),
+          onDrop: (event: React.DragEvent) => void state.onDrop(event, entry.path),
+        }
+      : {}),
+  };
+}
+
+function rowClass(state: FileManagerState, entry: FileEntry, isCursor: boolean) {
+  const cut = state.clipboard?.cut && state.clipboard.paths.includes(entry.path);
+  const selected = state.selected.has(entry.path);
+  return cn(
+    "cursor-default rounded-md transition-colors select-none",
+    selected
+      ? "bg-primary/15 text-foreground"
+      : isCursor
+        ? "bg-accent text-accent-foreground"
+        : "hover:bg-accent/50",
+    isCursor && selected && "ring-1 ring-inset ring-primary/50",
+    state.dropTarget === entry.path && "bg-primary/20 ring-1 ring-inset ring-primary",
+    entry.hidden && "text-muted-foreground",
+    cut && "opacity-50",
+  );
+}
+
+/** Keeps the cursor's row in view. */
+function useCursorInView(index: number, list: React.RefObject<HTMLElement | null>) {
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- scrolling is the DOM's, outside React
+  useLayoutEffect(() => {
+    list.current
+      ?.querySelector('[data-cursor="true"]')
+      ?.scrollIntoView({ block: "nearest", inline: "nearest" });
+    // oxlint-disable-next-line react/exhaustive-effect-dependencies -- it runs again when these change, though it doesn't read them
+  }, [index, list]);
+}
+
+const TreeRow = memo(function TreeRow({
+  state,
+  row,
+  isCursor,
+  core,
+}: {
+  state: FileManagerState;
+  row: FileRow;
+  isCursor: boolean;
+  core: FilesCore;
+}) {
+  const { entry, depth } = row;
+  const open = state.expanded.has(entry.path);
+  return (
+    <div
+      role="treeitem"
+      aria-selected={state.selected.has(entry.path)}
+      aria-expanded={entry.kind === "dir" ? open : undefined}
+      data-cursor={isCursor}
+      data-path={entry.path}
+      className={cn(
+        "mx-1 flex items-center gap-1.5 pr-2 text-sm",
+        rowClass(state, entry, isCursor),
+      )}
+      style={{
+        height: ROW_HEIGHT,
+        paddingLeft: 4 + depth * 16,
+        contentVisibility: "auto",
+        containIntrinsicHeight: ROW_HEIGHT,
+      }}
+      {...rowHandlers(state, entry)}
+    >
+      {entry.kind === "dir" ? (
+        <button
+          type="button"
+          tabIndex={-1}
+          aria-label={open ? "Fold" : "Unfold"}
+          className="flex size-4 shrink-0 items-center justify-center rounded-sm text-muted-foreground hover:text-foreground"
+          onClick={(event) => {
+            event.stopPropagation();
+            state.fold(entry.path, !open);
+          }}
+          onDoubleClick={(event) => event.stopPropagation()}
+        >
+          <ChevronRightIcon className={cn("size-3.5 transition-transform", open && "rotate-90")} />
+        </button>
+      ) : (
+        <span className="size-4 shrink-0" />
+      )}
+      <EntryIcon entry={entry} />
+      <span className={cn("min-w-0 flex-1 truncate", entry.link && "italic")}>{entry.name}</span>
+      {entry.kind === "file" ? (
+        <span className="shrink-0 text-xs tabular-nums text-muted-foreground">
+          {core.formatSize(entry.size)}
+        </span>
+      ) : null}
+    </div>
+  );
+});
+
+function EmptyNote({ state }: { state: FileManagerState }) {
+  if (state.rows.length > 0) return null;
+  return (
+    <div className="flex flex-col items-center gap-2 px-3 py-10 text-center text-sm text-muted-foreground">
+      <FolderGlyph className="size-9 opacity-40" />
+      {state.error ?? (state.filter ? "Nothing matches that filter" : "This folder is empty")}
+    </div>
+  );
+}
+
+function TreeView({ state, core }: { state: FileManagerState; core: FilesCore }) {
+  const list = useRef<HTMLDivElement>(null);
+  useCursorInView(state.cursorIndex, list);
+  return (
+    <div ref={list} role="tree" className="min-h-0 flex-1 overflow-auto py-1">
+      {state.rows.map((row, index) => (
+        <TreeRow
+          key={row.entry.path}
+          state={state}
+          row={row}
+          isCursor={index === state.cursorIndex}
+          core={core}
+        />
+      ))}
+      <EmptyNote state={state} />
+    </div>
+  );
+}
+
+function PlainList({
+  entries,
+  highlight,
+  onPick,
+}: {
+  entries: readonly FileEntry[];
+  highlight?: string;
+  onPick: (entry: FileEntry) => void;
+}) {
+  const list = useRef<HTMLDivElement>(null);
+  useCursorInView(
+    entries.findIndex((entry) => entry.path === highlight),
+    list,
+  );
+  return (
+    <div ref={list} className="min-h-0 flex-1 overflow-auto py-1">
+      {entries.map((entry) => (
+        <div
+          key={entry.path}
+          data-cursor={entry.path === highlight}
+          className={cn(
+            "mx-1 flex items-center gap-2 rounded-md px-2 text-sm select-none",
+            entry.path === highlight ? "bg-accent/70" : "text-muted-foreground hover:bg-accent/40",
+          )}
+          style={{ height: ROW_HEIGHT }}
+          onClick={() => onPick(entry)}
+        >
+          <EntryIcon entry={entry} />
+          <span className="min-w-0 flex-1 truncate">{entry.name}</span>
+        </div>
+      ))}
+    </div>
+  );
+}
+
+function CurrentColumn({ state, core }: { state: FileManagerState; core: FilesCore }) {
+  const list = useRef<HTMLDivElement>(null);
+  useCursorInView(state.cursorIndex, list);
+  return (
+    <div ref={list} role="listbox" className="min-h-0 flex-1 overflow-auto py-1">
+      {state.rows.map(({ entry }, index) => (
+        <div
+          key={entry.path}
+          role="option"
+          aria-selected={state.selected.has(entry.path)}
+          data-cursor={index === state.cursorIndex}
+          data-path={entry.path}
+          className={cn(
+            "mx-1 flex items-center gap-2 px-2 text-sm",
+            rowClass(state, entry, index === state.cursorIndex),
+          )}
+          style={{
+            height: ROW_HEIGHT,
+            contentVisibility: "auto",
+            containIntrinsicHeight: ROW_HEIGHT,
+          }}
+          {...rowHandlers(state, entry)}
+        >
+          <EntryIcon entry={entry} />
+          <span className="min-w-0 flex-1 truncate">{entry.name}</span>
+          {entry.kind === "file" ? (
+            <span className="shrink-0 text-xs tabular-nums text-muted-foreground">
+              {core.formatSize(entry.size)}
+            </span>
+          ) : (
+            <ChevronRightIcon className="size-3.5 shrink-0 text-muted-foreground/60" />
+          )}
+        </div>
+      ))}
+      <EmptyNote state={state} />
+    </div>
+  );
+}
+
+function ColumnsView({
+  state,
+  core,
+  client,
+}: {
+  state: FileManagerState;
+  core: FilesCore;
+  client: FilesClient;
+}) {
+  return (
+    <SplitRow
+      className="min-h-0 flex-1"
+      ratios={state.settings.columns}
+      defaults={[1, 1.4, 2]}
+      onCommit={(columns) => state.setSettings({ columns })}
+    >
+      <div className="flex h-full min-h-0 min-w-0 flex-col bg-muted/20">
+        <PlainList
+          entries={state.parentRows}
+          highlight={state.dir}
+          onPick={(entry) =>
+            entry.kind === "dir" ? state.goTo(entry.path) : state.reveal(entry.path)
+          }
+        />
+      </div>
+      <div className="flex h-full min-h-0 min-w-0 flex-col">
+        <CurrentColumn state={state} core={core} />
+      </div>
+      <div className="flex h-full min-h-0 min-w-0 flex-col">
+        <Preview entry={state.current} core={core} client={client} state={state} />
+      </div>
+    </SplitRow>
+  );
+}
+
+function GridView({
+  state,
+  core,
+  client,
+}: {
+  state: FileManagerState;
+  core: FilesCore;
+  client: FilesClient;
+}) {
+  const list = useRef<HTMLDivElement>(null);
+  useCursorInView(state.cursorIndex, list);
+  const { setGridColumns } = state;
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- the grid's columns are the DOM's
+  useLayoutEffect(() => {
+    const element = list.current;
+    if (!element) return;
+    const measure = () => {
+      const columns = getComputedStyle(element).gridTemplateColumns.split(" ").length;
+      setGridColumns(Math.max(1, columns));
+    };
+    measure();
+    return observeResize(element, measure);
+  }, [setGridColumns]);
+  return (
+    <div className="flex min-h-0 flex-1 flex-col overflow-auto">
+      <div
+        ref={list}
+        role="grid"
+        className="grid auto-rows-min grid-cols-[repeat(auto-fill,minmax(116px,1fr))] gap-1.5 p-2.5"
+      >
+        {state.rows.map(({ entry }, index) => {
+          const isCursor = index === state.cursorIndex;
+          const thumbnail =
+            entry.kind === "file" &&
+            core.fileKind(entry.name) === "image" &&
+            core.hasRawPreview(entry.name);
+          return (
+            <div
+              key={entry.path}
+              role="gridcell"
+              aria-selected={state.selected.has(entry.path)}
+              data-cursor={isCursor}
+              data-path={entry.path}
+              aria-label={entry.name}
+              className={cn(
+                "flex flex-col items-center gap-1.5 p-2",
+                rowClass(state, entry, isCursor),
+              )}
+              style={{ contentVisibility: "auto", containIntrinsicHeight: 120 }}
+              {...rowHandlers(state, entry)}
+            >
+              <div className="flex size-18 items-center justify-center">
+                {thumbnail ? (
+                  <img
+                    src={client.rawUrl(entry.path)}
+                    crossOrigin="anonymous"
+                    loading="lazy"
+                    decoding="async"
+                    draggable={false}
+                    alt=""
+                    className="max-h-full max-w-full rounded-md object-contain shadow-sm ring-1 ring-border/60"
+                  />
+                ) : (
+                  <EntryIcon entry={entry} className="size-14" />
+                )}
+              </div>
+              <span className="line-clamp-2 w-full text-center text-xs leading-snug break-words">
+                {entry.name}
+              </span>
+            </div>
+          );
+        })}
+      </div>
+      <EmptyNote state={state} />
+    </div>
+  );
+}
+
+function PreviewHeader({
+  entry,
+  core,
+  note,
+}: {
+  entry: FileEntry;
+  core: FilesCore;
+  note?: string;
+}) {
+  return (
+    <div className="flex shrink-0 items-center gap-2.5 border-b border-border/60 px-3 py-2">
+      <EntryIcon entry={entry} className="size-5" />
+      <div className="min-w-0 flex-1">
+        <div className="truncate text-sm font-medium">{entry.name}</div>
+        {entry.modified ? (
+          <div className="truncate text-xs text-muted-foreground">
+            {entry.kind === "file" ? `${core.formatSize(entry.size)} · ` : ""}
+            {new Date(entry.modified).toLocaleString()}
+            {note ? ` · ${note}` : ""}
+          </div>
+        ) : null}
+      </div>
+    </div>
+  );
+}
+
+function PreviewNote({ children }: { children: React.ReactNode }) {
+  return (
+    <div className="flex min-h-0 flex-1 items-center justify-center px-4 text-center text-sm text-muted-foreground">
+      {children}
+    </div>
+  );
+}
+
+function TextPreview({ entry, text, dir }: { entry: FileEntry; text: string; dir: string }) {
+  const extension = entry.name.split(".").pop()?.toLowerCase();
+  if (extension === "md" || extension === "markdown") {
+    return (
+      <div className="min-h-0 flex-1 overflow-auto">
+        <Suspense fallback={null}>
+          <ChatMarkdown
+            text={maskMarkdownFrontmatter(text)}
+            cwd={dir}
+            imageBaseDir={dir}
+            className="px-4 py-3"
+          />
+        </Suspense>
+      </div>
+    );
+  }
+  if (extension === "csv" || extension === "tsv") {
+    return (
+      <DelimitedTablePreview
+        name={entry.name}
+        text={text}
+        delimiter={extension === "csv" ? "," : "\t"}
+      />
+    );
+  }
+  return (
+    <Suspense fallback={null}>
+      <ReadOnlySourcePreview key={entry.path} name={entry.name} text={text} wordWrap={false} />
+    </Suspense>
+  );
+}
+
+function Preview({
+  entry,
+  core,
+  client,
+  state,
+}: {
+  entry: FileEntry | null;
+  core: FilesCore;
+  client: FilesClient;
+  state?: FileManagerState;
+}) {
+  const [text, setText] = useState<{ path: string; body: string; note: string } | null>(null);
+  const [folder, setFolder] = useState<{ path: string; entries: readonly FileEntry[] } | null>(
+    null,
+  );
+  const path = entry?.path;
+  const kind = entry?.kind;
+  const raw = entry ? entry.kind === "file" && core.hasRawPreview(entry.name) : false;
+
+  // After a moment, so holding j doesn't read every file it passes.
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- reads the file from the helper, outside React
+  useEffect(() => {
+    if (!path) return;
+    let live = true;
+    const timer = setTimeout(() => {
+      if (kind === "dir") {
+        void client.list(path).then(
+          (listing) => live && setFolder({ path, entries: core.sortEntries(listing.entries) }),
+          () => live && setFolder({ path, entries: [] }),
+        );
+      } else if (!raw) {
+        void client.preview(path).then(
+          (result) =>
+            live &&
+            setText({
+              path,
+              body: result.text,
+              note: result.binary
+                ? "No preview for this file"
+                : result.truncated
+                  ? "First part only"
+                  : "",
+            }),
+          () => live && setText({ path, body: "", note: "This file can't be read" }),
+        );
+      }
+    }, 70);
+    return () => {
+      live = false;
+      clearTimeout(timer);
+    };
+  }, [client, core, kind, path, raw]);
+
+  if (!entry) return <PreviewNote>Nothing selected</PreviewNote>;
+  if (entry.kind === "dir") {
+    return folder?.path === entry.path ? (
+      folder.entries.length > 0 ? (
+        <PlainList
+          entries={folder.entries}
+          onPick={(picked) =>
+            picked.kind === "dir" ? state?.goTo(picked.path) : state?.reveal(picked.path)
+          }
+        />
+      ) : (
+        <PreviewNote>This folder is empty</PreviewNote>
+      )
+    ) : null;
+  }
+  if (raw) {
+    const kindOf = core.fileKind(entry.name);
+    const url = client.rawUrl(entry.path);
+    return (
+      <>
+        <PreviewHeader entry={entry} core={core} />
+        <div className="flex min-h-0 flex-1 items-center justify-center overflow-hidden bg-muted/20 p-3">
+          {kindOf === "image" ? (
+            <img
+              key={url}
+              src={url}
+              crossOrigin="anonymous"
+              alt=""
+              draggable={false}
+              className="max-h-full max-w-full rounded-md object-contain shadow-sm"
+            />
+          ) : kindOf === "video" ? (
+            <video
+              key={url}
+              src={url}
+              crossOrigin="anonymous"
+              controls
+              className="max-h-full max-w-full rounded-md"
+            />
+          ) : kindOf === "audio" ? (
+            <audio key={url} src={url} crossOrigin="anonymous" controls className="w-full" />
+          ) : (
+            <EntryIcon entry={entry} className="size-16" />
+          )}
+        </div>
+      </>
+    );
+  }
+  const loaded = text?.path === entry.path ? text : null;
+  return (
+    <>
+      <PreviewHeader
+        entry={entry}
+        core={core}
+        {...(loaded?.body && loaded.note ? { note: loaded.note } : {})}
+      />
+      {loaded?.body ? (
+        <TextPreview entry={entry} text={loaded.body} dir={core.parentOf(entry.path) ?? "/"} />
+      ) : loaded ? (
+        <PreviewNote>{loaded.note || "This file is empty"}</PreviewNote>
+      ) : null}
+    </>
+  );
+}
+
+function Highlighted({
+  text,
+  offset,
+  positions,
+}: {
+  text: string;
+  offset: number;
+  positions: ReadonlySet<number>;
+}) {
+  return (
+    <>
+      {[...text].map((character, index) =>
+        positions.has(index + offset) ? (
+          // oxlint-disable-next-line react/no-array-index-key -- a position is all these have: they never move
+          <mark key={index} className="bg-transparent font-semibold text-primary">
+            {character}
+          </mark>
+        ) : (
+          character
+        ),
+      )}
+    </>
+  );
+}
+
+function KeyHint({ keys, children }: { keys: string; children: React.ReactNode }) {
+  return (
+    <span className="flex items-center gap-1">
+      <kbd className="rounded border border-border/70 bg-muted/60 px-1 font-sans text-2xs">
+        {keys}
+      </kbd>
+      {children}
+    </span>
+  );
+}
+
+/** Telescope's layout: search and results on the left, a preview on the right. */
+function FuzzyFinder({
+  state,
+  core,
+  client,
+}: {
+  state: FileManagerState;
+  core: FilesCore;
+  client: FilesClient;
+}) {
+  const [query, setQuery] = useState("");
+  const [found, setFound] = useState<{
+    paths: readonly string[];
+    matched: number;
+    total: number;
+    scanning: boolean;
+    indexed?: number;
+  } | null>(null);
+  const [index, setIndex] = useState(0);
+  const [marked, setMarked] = useState<ReadonlySet<string>>(new Set());
+  const hidden = state.settings.hidden;
+  const { dir } = state;
+
+  // The search is the helper's: this page only ever holds a page of results, and a query
+  // the helper dropped for a newer one comes back superseded. While it's still indexing,
+  // the same query finds more.
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- the helper's search, outside React
+  useEffect(() => {
+    let live = true;
+    let timer: ReturnType<typeof setTimeout>;
+    const ask = () => {
+      void client.find(dir, query, { hidden }).then(
+        (result) => {
+          if (!live || result.superseded) return;
+          setFound(result);
+          if (result.scanning) timer = setTimeout(ask, 400);
+        },
+        () => {
+          if (live) setFound({ paths: [], matched: 0, total: 0, scanning: false });
+        },
+      );
+    };
+    timer = setTimeout(ask, 30);
+    return () => {
+      live = false;
+      clearTimeout(timer);
+    };
+  }, [client, dir, hidden, query]);
+
+  const results = found?.paths ?? [];
+  const chosen = results[Math.min(index, results.length - 1)];
+  const absolute = (relative: string) => core.joinPath(dir, relative.replace(/\/$/, ""));
+  const entryOf = (relative: string): FileEntry => {
+    const folder = relative.endsWith("/");
+    const name = relative.replace(/\/$/, "").split("/").pop() ?? relative;
+    return {
+      name,
+      path: absolute(relative),
+      kind: folder ? "dir" : "file",
+      size: 0,
+      modified: 0,
+      hidden: false,
+    };
+  };
+  /** A result, or everything marked if it's one of those. */
+  const pathsFor = (relative: string) =>
+    marked.has(relative) ? [...marked].map(absolute) : [absolute(relative)];
+  const list = useRef<HTMLDivElement>(null);
+  useCursorInView(index, list);
+
+  const close = () => {
+    state.setFuzzyOpen(false);
+    state.focusRoot();
+  };
+  const leave = () => (state.fuzzyOnly && state.cancelPick ? state.cancelPick() : close());
+
+  const input = useRef<HTMLInputElement>(null);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- the keyboard is the browser's, outside React
+  useEffect(() => {
+    takeKeyboard(input.current);
+    // Opened by a key from a tab or an app, whatever had it may hand it on a frame later.
+    const again = setTimeout(() => takeKeyboard(input.current), 120);
+    return () => clearTimeout(again);
+  }, []);
+
+  const onKeyDown = (event: React.KeyboardEvent) => {
+    const down =
+      event.key === "ArrowDown" || (event.ctrlKey && (event.key === "j" || event.key === "n"));
+    const up =
+      event.key === "ArrowUp" || (event.ctrlKey && (event.key === "k" || event.key === "p"));
+    if (down || up) {
+      setIndex((value) => Math.max(0, Math.min(results.length - 1, value + (down ? 1 : -1))));
+    } else if (event.key === "Tab" && chosen) {
+      setMarked((set) => {
+        const next = new Set(set);
+        if (!next.delete(chosen)) next.add(chosen);
+        return next;
+      });
+      setIndex((value) => Math.min(results.length - 1, value + 1));
+    } else if (event.key === "Enter" && chosen) {
+      close();
+      void client.findOpened(dir, query, chosen).catch(() => {});
+      const entry = entryOf(chosen);
+      if (marked.size > 0 && state.pickAll) state.pickAll([...marked].map(absolute));
+      else if (event.ctrlKey || entry.kind === "dir") state.reveal(entry.path);
+      else state.activate(entry);
+    } else if (event.ctrlKey && event.key === "b" && chosen && state.canCarry) {
+      const paths = pathsFor(chosen);
+      close();
+      state.cancelPick?.();
+      // After a floating finder has gone, so the pointer is over what's under it.
+      requestAnimationFrame(() => void carryFiles(paths));
+    } else if (event.key === "Escape") {
+      leave();
+    } else {
+      event.stopPropagation();
+      return;
+    }
+    event.preventDefault();
+    event.stopPropagation();
+  };
+
+  return (
+    <div className="absolute inset-0 z-20 flex flex-col bg-background">
+      <div className="flex shrink-0 items-center gap-2.5 border-b border-border/70 px-3.5 py-2.5">
+        <SearchIcon className="size-4 shrink-0 text-muted-foreground" />
+        <input
+          ref={input}
+          data-plutonium-fuzzy=""
+          value={query}
+          aria-label="Fuzzy find"
+          placeholder={`Search in ${dir.split("/").pop() || "/"}…`}
+          spellCheck={false}
+          className="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground"
+          onChange={(event) => {
+            setQuery(event.target.value);
+            setIndex(0);
+          }}
+          onKeyDown={onKeyDown}
+        />
+        <span className="shrink-0 text-xs tabular-nums text-muted-foreground">
+          {found?.scanning && found.total === 0
+            ? `Indexing${found.indexed ? ` ${found.indexed.toLocaleString()} files` : ""}… `
+            : ""}
+          {(found?.matched ?? 0).toLocaleString()} of {(found?.total ?? 0).toLocaleString()}
+        </span>
+      </div>
+      <div className="grid min-h-0 flex-1 grid-cols-2 divide-x divide-border/60">
+        <div ref={list} className="min-h-0 min-w-0 overflow-auto py-1">
+          {results.map((result, position) => {
+            const entry = entryOf(result);
+            const bare = result.replace(/\/$/, "");
+            const nameAt = bare.lastIndexOf("/") + 1;
+            const hits = core.fuzzyPositions(query, result);
+            return (
+              <div
+                key={result}
+                data-cursor={position === index}
+                draggable
+                className={cn(
+                  "mx-1 flex items-center gap-2 rounded-md px-2 text-sm select-none",
+                  position === index ? "bg-accent text-accent-foreground" : "hover:bg-accent/50",
+                  marked.has(result) && "bg-primary/15",
+                )}
+                style={{ height: ROW_HEIGHT + 4 }}
+                onClick={() => setIndex(position)}
+                onDoubleClick={() => {
+                  close();
+                  state.activate(entry);
+                }}
+                onPointerDown={() => state.armPaths(pathsFor(result))}
+                onDragStart={(event) => state.startFilesDrag(event, pathsFor(result))}
+              >
+                <EntryIcon entry={entry} />
+                <span className="shrink-0 truncate">
+                  <Highlighted text={bare.slice(nameAt)} offset={nameAt} positions={hits} />
+                </span>
+                <span className="min-w-0 flex-1 truncate text-xs text-muted-foreground">
+                  <Highlighted
+                    text={bare.slice(0, Math.max(0, nameAt - 1))}
+                    offset={0}
+                    positions={hits}
+                  />
+                </span>
+              </div>
+            );
+          })}
+          {found && !found.scanning && results.length === 0 ? (
+            <div className="px-3 py-10 text-center text-sm text-muted-foreground">
+              Nothing matches
+            </div>
+          ) : null}
+        </div>
+        <div className="flex min-h-0 min-w-0 flex-col">
+          {chosen ? <Preview entry={entryOf(chosen)} core={core} client={client} /> : null}
+        </div>
+      </div>
+      <div className="flex shrink-0 items-center gap-4 border-t border-border/70 px-3.5 py-1.5 text-xs text-muted-foreground">
+        <KeyHint keys="Enter">open</KeyHint>
+        <KeyHint keys="Tab">mark</KeyHint>
+        <KeyHint keys="Ctrl+Enter">go to</KeyHint>
+        {state.canCarry ? <KeyHint keys="Ctrl+B">pick up</KeyHint> : null}
+        <span className="ml-auto">Drag a result to use it anywhere</span>
+      </div>
+    </div>
+  );
+}
+
+function KeyHelp({ state }: { state: FileManagerState }) {
+  const byCommand = new Map<string, string[]>();
+  for (const rule of state.keybindings) {
+    if (!isFileManagerBinding(rule)) continue;
+    const command = String(rule.command).slice("files.".length);
+    byCommand.set(command, [...(byCommand.get(command) ?? []), formatShortcutLabel(rule.shortcut)]);
+  }
+  const label = (command: string) =>
+    command.replace(/([a-z])([A-Z])/g, "$1 $2").replace(/^./, (first) => first.toUpperCase());
+  return (
+    <div className="absolute inset-0 z-30 overflow-auto bg-background/97 p-4">
+      <div className="mb-3 flex items-start justify-between gap-4">
+        <div>
+          <div className="text-sm font-medium">Keys</div>
+          <div className="text-xs text-muted-foreground">
+            Change them in Settings, Keybindings, under File manager.
+          </div>
+        </div>
+        <Button
+          size="icon-xs"
+          variant="ghost"
+          aria-label="Close"
+          onClick={() => state.setHelpOpen(false)}
+        >
+          <XIcon />
+        </Button>
+      </div>
+      <div className="grid grid-cols-[repeat(auto-fill,minmax(230px,1fr))] gap-x-8 gap-y-1 text-sm">
+        {[...byCommand].map(([command, keys]) => (
+          <div key={command} className="flex items-baseline justify-between gap-3">
+            <span className="truncate text-muted-foreground">{label(command)}</span>
+            <span className="flex shrink-0 gap-1">
+              {keys.slice(0, 2).map((keyLabel) => (
+                <kbd
+                  key={keyLabel}
+                  className="rounded border border-border/70 bg-muted/60 px-1.5 font-sans text-xs"
+                >
+                  {keyLabel}
+                </kbd>
+              ))}
+            </span>
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+const VIEWS: readonly { view: FileView; command: string; icon: LucideIcon; label: string }[] = [
+  { view: "tree", command: "viewTree", icon: ListTreeIcon, label: "Tree" },
+  { view: "columns", command: "viewColumns", icon: ColumnsIcon, label: "Columns" },
+  { view: "grid", command: "viewGrid", icon: LayoutGridIcon, label: "Grid" },
+];
+
+function Breadcrumbs({ state }: { state: FileManagerState }) {
+  const parts = state.dir.split("/").filter(Boolean);
+  const list = useRef<HTMLDivElement>(null);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- scrolling is the DOM's, outside React
+  useLayoutEffect(() => {
+    if (list.current) list.current.scrollLeft = list.current.scrollWidth;
+    // oxlint-disable-next-line react/exhaustive-effect-dependencies -- it runs again when these change, though it doesn't read them
+  }, [state.dir]);
+  return (
+    <div
+      ref={list}
+      className="flex min-w-0 flex-1 items-center overflow-x-auto text-sm whitespace-nowrap [scrollbar-width:none]"
+      onDoubleClick={() => state.run("goPath")}
+    >
+      <button
+        type="button"
+        tabIndex={-1}
+        aria-label="Root"
+        className="rounded px-1 py-0.5 text-muted-foreground hover:bg-accent hover:text-foreground"
+        onClick={() => state.goTo("/")}
+      >
+        <HardDriveIcon className="size-3.5" />
+      </button>
+      {parts.map((part, index) => {
+        const path = `/${parts.slice(0, index + 1).join("/")}`;
+        const last = index === parts.length - 1;
+        return (
+          <span key={path} className="flex items-center">
+            <ChevronRightIcon className="size-3 shrink-0 text-muted-foreground/60" />
+            <button
+              type="button"
+              tabIndex={-1}
+              className={cn(
+                "rounded px-1 py-0.5 hover:bg-accent",
+                last
+                  ? "font-medium text-foreground"
+                  : "text-muted-foreground hover:text-foreground",
+              )}
+              onClick={() => state.goTo(path)}
+            >
+              {part}
+            </button>
+          </span>
+        );
+      })}
+    </div>
+  );
+}
+
+function Toolbar({ state }: { state: FileManagerState }) {
+  const { settings } = state;
+  const tool = (
+    label: string,
+    Icon: LucideIcon,
+    command: string,
+    active = false,
+    disabled = false,
+  ) => (
+    <Button
+      size="icon-xs"
+      variant={active ? "secondary" : "ghost"}
+      tabIndex={-1}
+      aria-label={label}
+      disabled={disabled}
+      onClick={() => {
+        state.run(command);
+        state.focusRoot();
+      }}
+    >
+      <Icon />
+    </Button>
+  );
+  return (
+    <div className="@container/toolbar flex h-10 shrink-0 items-center gap-1 border-b border-border/70 px-1.5">
+      {tool("Back", ArrowLeftIcon, "back", false, !state.canGoBack)}
+      {tool("Forward", ArrowRightIcon, "forward", false, !state.canGoForward)}
+      {tool("Parent folder", ArrowUpIcon, "parent", false, state.dir === "/")}
+      <Breadcrumbs state={state} />
+      <button
+        type="button"
+        tabIndex={-1}
+        className="flex h-7 shrink-0 items-center gap-1.5 rounded-md border border-border/70 bg-muted/30 px-2 text-xs text-muted-foreground hover:bg-accent hover:text-foreground"
+        onClick={() => state.run("fuzzy")}
+      >
+        <SearchIcon className="size-3.5" />
+        Search
+      </button>
+      <ToggleGroup
+        aria-label="View"
+        className="mx-1 shrink-0"
+        value={[settings.view]}
+        onValueChange={(next: string[]) => {
+          // One of the three is always on: pressing it again changes nothing.
+          const chosen = VIEWS.find(({ view }) => view === next[0]);
+          if (chosen) state.run(chosen.command);
+          state.focusRoot();
+        }}
+      >
+        {VIEWS.map(({ view, icon: Icon, label }) => (
+          <ToggleGroupItem
+            key={view}
+            value={view}
+            aria-label={label}
+            title={label}
+          >
+            <Icon className="size-3.5" />
+            <span className="hidden @2xl/toolbar:inline">{label}</span>
+          </ToggleGroupItem>
+        ))}
+      </ToggleGroup>
+      {tool(
+        settings.hidden ? "Hide dot files" : "Show dot files",
+        settings.hidden ? EyeIcon : EyeOffIcon,
+        "toggleHidden",
+        settings.hidden,
+      )}
+      {settings.view === "columns" || state.compact
+        ? null
+        : tool("Preview", PanelRightIcon, "togglePreview", settings.preview)}
+      {state.canSplit ? tool("Open another beside this", SplitIcon, "split") : null}
+    </div>
+  );
+}
+
+const PLACE_ICONS: Record<string, LucideIcon> = {
+  home: HouseIcon,
+  desktop: MonitorIcon,
+  documents: FileTextIcon,
+  downloads: DownloadIcon,
+  music: MusicIcon,
+  pictures: ImageIcon,
+  videos: FilmIcon,
+  root: HardDriveIcon,
+};
+
+function Places({ state }: { state: FileManagerState }) {
+  return (
+    <nav
+      aria-label="Places"
+      className="flex h-full min-w-0 flex-col gap-0.5 overflow-auto bg-muted/20 p-2"
+    >
+      <div className="px-2 pb-1 text-xs font-medium text-muted-foreground">Places</div>
+      {state.places.map((place) => {
+        const Icon = PLACE_ICONS[place.kind] ?? HardDriveIcon;
+        return (
+          <button
+            key={place.path}
+            type="button"
+            tabIndex={-1}
+            className={cn(
+              "flex h-7 w-full items-center gap-2 rounded-md px-2 text-left text-sm transition-colors",
+              place.path === state.dir ? "bg-accent text-accent-foreground" : "hover:bg-accent/50",
+              state.dropTarget === place.path && "ring-1 ring-inset ring-primary",
+            )}
+            onClick={() => state.goTo(place.path)}
+            onDragOver={(event) => state.onDragOver(event, place.path)}
+            onDragLeave={() => state.setDropTarget(null)}
+            onDrop={(event) => void state.onDrop(event, place.path)}
+          >
+            <Icon className="size-4 shrink-0 text-muted-foreground" />
+            <span className="truncate">{place.name}</span>
+          </button>
+        );
+      })}
+    </nav>
+  );
+}
+
+const PROMPT_LABELS: Record<string, string> = {
+  filter: "Filter",
+  find: "Find",
+  create: "New file (end with / for a folder)",
+  rename: "Rename",
+  goto: "Go to",
+};
+
+function PromptBar({ state }: { state: FileManagerState }) {
+  const { prompt } = state;
+  if (!prompt) return null;
+  if (prompt.kind === "delete") {
+    return (
+      <div
+        tabIndex={0}
+        ref={(element) => element?.focus()}
+        className="flex shrink-0 items-center gap-2 border-t border-destructive/40 bg-destructive/10 px-3 py-1.5 text-sm outline-none"
+        onKeyDown={(event) => {
+          event.preventDefault();
+          event.stopPropagation();
+          if (event.key === "y" || event.key === "Enter") void state.submitPrompt("");
+          else state.cancelPrompt();
+        }}
+      >
+        <span className="min-w-0 flex-1 truncate">
+          Delete{" "}
+          {prompt.paths.length === 1
+            ? prompt.paths[0]?.split("/").pop()
+            : `${prompt.paths.length} items`}{" "}
+          for good?
+        </span>
+        <KeyHint keys="Y">delete</KeyHint>
+        <KeyHint keys="Esc">keep</KeyHint>
+      </div>
+    );
+  }
+  return (
+    <div className="flex shrink-0 items-center gap-2 border-t border-border/70 px-3 py-1.5 text-sm">
+      <span className="shrink-0 text-muted-foreground">{PROMPT_LABELS[prompt.kind]}</span>
+      <input
+        autoFocus
+        value={prompt.value}
+        spellCheck={false}
+        aria-label={PROMPT_LABELS[prompt.kind]}
+        className="min-w-0 flex-1 rounded-md border border-input bg-transparent px-2 py-0.5 outline-none focus:border-ring"
+        onFocus={(event) => {
+          // A rename selects the name, not its extension.
+          if (prompt.kind !== "rename") return;
+          const dot = event.target.value.lastIndexOf(".");
+          event.target.setSelectionRange(0, dot > 0 ? dot : event.target.value.length);
+        }}
+        onChange={(event) => state.onPromptChange(event.target.value)}
+        onKeyDown={(event) => {
+          event.stopPropagation();
+          if (event.key === "Enter") void state.submitPrompt(prompt.value);
+          if (event.key === "Escape") state.cancelPrompt();
+        }}
+      />
+    </div>
+  );
+}
+
+function StatusBar({ state, core }: { state: FileManagerState; core: FilesCore }) {
+  const jobs = useFilesStore((store) => store.jobs);
+  const { clipboard } = state;
+  const items = state.rows.length;
+  return (
+    <div className="flex h-6 shrink-0 items-center gap-3 border-t border-border/70 px-3 text-xs text-muted-foreground">
+      <span className="tabular-nums">
+        {state.selected.size > 0
+          ? `${state.selected.size} of ${items} selected`
+          : `${items} ${items === 1 ? "item" : "items"}`}
+      </span>
+      {clipboard ? (
+        <span className="text-foreground">
+          {clipboard.paths.length} {clipboard.cut ? "to move" : "to copy"}
+        </span>
+      ) : null}
+      {state.filter ? <span>Filter: {state.filter}</span> : null}
+      {state.pending ? <kbd className="font-sans text-foreground">{state.pending}</kbd> : null}
+      <span className="min-w-0 flex-1 truncate text-right">
+        {state.current?.kind === "file" ? core.formatSize(state.current.size) : ""}
+      </span>
+      {jobs.map((job) => (
+        <span key={job.id} className="flex items-center gap-1.5 text-foreground">
+          {jobLabel(job)}
+          {job.total > 0 ? (
+            <span className="h-1 w-16 overflow-hidden rounded-full bg-muted">
+              <span
+                className="block h-full rounded-full bg-primary transition-[width]"
+                style={{ width: `${Math.round((job.done / job.total) * 100)}%` }}
+              />
+            </span>
+          ) : null}
+          <button
+            type="button"
+            tabIndex={-1}
+            aria-label="Cancel"
+            onClick={() => void state.loaded?.helper.cancelJob(job.id)}
+          >
+            <XIcon className="size-3" />
+          </button>
+        </span>
+      ))}
+    </div>
+  );
+}
+
+function ListView({
+  state,
+  core,
+  client,
+}: {
+  state: FileManagerState;
+  core: FilesCore;
+  client: FilesClient;
+}) {
+  return state.settings.view === "tree" ? (
+    <TreeView state={state} core={core} />
+  ) : (
+    <GridView state={state} core={core} client={client} />
+  );
+}
+
+function PlacesSplit({
+  state,
+  show,
+  children,
+}: {
+  state: FileManagerState;
+  show: boolean;
+  children: React.ReactNode;
+}) {
+  if (!show) return <div className="flex min-h-0 min-w-0 flex-1">{children}</div>;
+  return (
+    <SplitRow
+      className="min-h-0 flex-1"
+      ratios={state.settings.places}
+      defaults={[1, 5]}
+      onCommit={(places) => state.setSettings({ places })}
+    >
+      <Places state={state} />
+      <div className="flex h-full min-h-0 min-w-0">{children}</div>
+    </SplitRow>
+  );
+}
+
+export interface FileManagerProps extends FileManagerOptions {
+  readonly className?: string;
+  /** Places down the side: where there's the width for it. */
+  readonly showPlaces?: boolean;
+  /** Truthy takes the keyboard once it's ready; a new value takes it again. */
+  readonly autoFocus?: boolean | number;
+  /** Reports the state, for a picker's footer. */
+  readonly stateRef?: React.RefObject<FileManagerState | null>;
+}
+
+export function FileManager(props: FileManagerProps) {
+  const state = useFileManager(props);
+  const { loaded, settings } = state;
+  useImperativeHandle(props.stateRef, () => state);
+  const { setRoot, takeRootKeyboard } = state;
+  const { autoFocus } = props;
+  const ready = Boolean(loaded);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- the keyboard is the browser's, outside React
+  useEffect(() => {
+    if (!autoFocus || !ready) return;
+    takeRootKeyboard();
+    // The terminal this replaces hands the keyboard to the composer as it closes, a frame on.
+    const again = setTimeout(takeRootKeyboard, 120);
+    return () => clearTimeout(again);
+  }, [autoFocus, ready, takeRootKeyboard]);
+  if (!loaded) return null;
+  const { core, helper: client } = loaded;
+  return (
+    <div
+      ref={setRoot}
+      tabIndex={0}
+      // Its keys are its own: this also keeps the composer's type-to-focus away.
+      role="application"
+      aria-label="Files"
+      data-plutonium-files=""
+      className={cn(
+        "group/files relative flex min-h-0 min-w-0 flex-col bg-background text-foreground outline-none",
+        props.className,
+      )}
+      onKeyDown={state.onKeyDown}
+      onDragOver={(event) => state.onDragOver(event, state.dir)}
+      onDragLeave={() => state.setDropTarget(null)}
+      onDrop={(event) => void state.onDrop(event, state.dir)}
+      onContextMenu={(event) => state.onRowContextMenu(event, null)}
+    >
+      <Toolbar state={state} />
+      <div
+        className={cn(
+          "flex min-h-0 flex-1",
+          state.dropTarget === state.dir && "outline-1 -outline-offset-1 outline-primary outline",
+        )}
+      >
+        <PlacesSplit state={state} show={Boolean(props.showPlaces)}>
+          {settings.view === "columns" ? (
+            <ColumnsView state={state} core={core} client={client} />
+          ) : settings.preview && !props.compact ? (
+            <SplitRow
+              className="min-h-0 flex-1"
+              ratios={settings.split}
+              defaults={[3, 2]}
+              onCommit={(split) => state.setSettings({ split })}
+            >
+              <div className="flex h-full min-h-0 min-w-0 flex-col">
+                <ListView state={state} core={core} client={client} />
+              </div>
+              <div className="flex h-full min-h-0 min-w-0 flex-col">
+                <Preview entry={state.current} core={core} client={client} state={state} />
+              </div>
+            </SplitRow>
+          ) : (
+            <div className="flex min-h-0 min-w-0 flex-1 flex-col">
+              <ListView state={state} core={core} client={client} />
+            </div>
+          )}
+        </PlacesSplit>
+      </div>
+      <PromptBar state={state} />
+      <StatusBar state={state} core={core} />
+      {state.fuzzyOpen ? <FuzzyFinder state={state} core={core} client={client} /> : null}
+      {state.helpOpen ? <KeyHelp state={state} /> : null}
+    </div>
+  );
+}
diff --git a/apps/web/src/plutonium/files/FilePicker.tsx b/apps/web/src/plutonium/files/FilePicker.tsx
