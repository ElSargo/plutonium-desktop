+import { describe, expect, it } from "vite-plus/test";
+
+import { filePaneToShow, filesCoverTerminals, isFilePane, nextFilePaneId } from "./filePanes";
+
+const drawer = (
+  groups: readonly (readonly string[])[],
+  activeTerminalId: string,
+  terminalOpen = true,
+) => ({
+  terminalOpen,
+  terminalIds: groups.flat(),
+  activeTerminalId,
+  terminalGroups: groups.map((terminalIds, index) => ({
+    id: `group-${index}`,
+    terminalIds: [...terminalIds],
+  })),
+  activeTerminalGroupId: `group-${groups.findIndex((ids) => ids.includes(activeTerminalId))}`,
+});
+
+describe("file panes", () => {
+  it("takes the lowest free slot", () => {
+    expect(nextFilePaneId(["default"])).toBe("files:0");
+    expect(nextFilePaneId(["files:0", "default", "files:2"])).toBe("files:1");
+    expect(isFilePane("files:1")).toBe(true);
+    expect(isFilePane("default")).toBe(false);
+  });
+
+  it("has the terminal key bring up a terminal only over files alone", () => {
+    expect(filesCoverTerminals(drawer([["default"], ["files:0"]], "files:0"))).toBe(true);
+    expect(filesCoverTerminals(drawer([["default", "files:0"]], "files:0"))).toBe(false);
+    expect(filesCoverTerminals(drawer([["default"], ["files:0"]], "default"))).toBe(false);
+  });
+
+  it("goes to the pane on show, else the newest", () => {
+    expect(filePaneToShow(drawer([["default"]], "default"))).toBeNull();
+    expect(filePaneToShow(drawer([["files:0"], ["default", "files:1"]], "default"))).toBe(
+      "files:1",
+    );
+    expect(filePaneToShow(drawer([["files:0"], ["files:2"], ["default"]], "default"))).toBe(
+      "files:2",
+    );
+  });
+});
diff --git a/apps/web/src/plutonium/files/filePanes.ts b/apps/web/src/plutonium/files/filePanes.ts
new file mode 100644
index 0000000000..6d1aeb3d41
--- /dev/null
+++ b/apps/web/src/plutonium/files/filePanes.ts
@@ -0,0 +1,100 @@
+// Plutonium: a file manager as an entry in a thread's terminal drawer. It's in the same
+// groups as the terminals, under a reserved id, so it gets their sidebar, splits, height
+// and place in the dock; it has no session on the server.
+import { scopedThreadKey } from "@t3tools/client-runtime/environment";
+import type { ScopedThreadRef } from "@t3tools/contracts";
+
+import { focusActiveDrawerTerminal, focusTerminal } from "~/lib/terminalFocus";
+import { selectThreadTerminalUiState, useTerminalUiStateStore } from "~/terminalUiStateStore";
+import { MAX_TERMINALS_PER_GROUP, type ThreadTerminalGroup } from "~/types";
+
+import { usePlutoniumWindowStore } from "../windowStore";
+import { useFilesStore } from "./filesStore";
+
+const PANE_PREFIX = "files:";
+
+export const isFilePane = (terminalId: string) => terminalId.startsWith(PANE_PREFIX);
+
+/** Which of the file managers' saved views this one uses. */
+export const filePaneSlot = (terminalId: string) => terminalId.slice(PANE_PREFIX.length);
+
+/** The lowest free one, so a thread's first pane always has the first view. */
+export function nextFilePaneId(terminalIds: readonly string[]): string {
+  let slot = 0;
+  while (terminalIds.includes(`${PANE_PREFIX}${slot}`)) slot += 1;
+  return `${PANE_PREFIX}${slot}`;
+}
+
+interface DrawerState {
+  readonly terminalOpen: boolean;
+  readonly terminalIds: readonly string[];
+  readonly activeTerminalId: string;
+  readonly terminalGroups: readonly ThreadTerminalGroup[];
+  readonly activeTerminalGroupId: string;
+}
+
+function activeGroupIds(state: DrawerState): readonly string[] {
+  const group =
+    state.terminalGroups.find((entry) => entry.id === state.activeTerminalGroupId) ??
+    state.terminalGroups.find((entry) => entry.terminalIds.includes(state.activeTerminalId));
+  return group?.terminalIds ?? [];
+}
+
+/** The drawer's active entry shows files and no terminal: the terminal key has one to bring up. */
+export function filesCoverTerminals(state: DrawerState): boolean {
+  return isFilePane(state.activeTerminalId) && activeGroupIds(state).every(isFilePane);
+}
+
+/** The pane the files key goes to: one on show, else the newest. */
+export function filePaneToShow(state: DrawerState): string | null {
+  return activeGroupIds(state).find(isFilePane) ?? state.terminalIds.findLast(isFilePane) ?? null;
+}
+
+const drawerState = (threadRef: ScopedThreadRef) =>
+  selectThreadTerminalUiState(
+    useTerminalUiStateStore.getState().terminalUiStateByThreadKey,
+    threadRef,
+  );
+
+export function openFilePane(
+  threadRef: ScopedThreadRef,
+  { split = false, dir }: { readonly split?: boolean; readonly dir?: string } = {},
+): void {
+  if (!usePlutoniumWindowStore.getState().available) return;
+  const state = drawerState(threadRef);
+  const id = nextFilePaneId(state.terminalIds);
+  if (dir) useFilesStore.getState().setPaneDir(scopedThreadKey(threadRef), id, dir);
+  const store = useTerminalUiStateStore.getState();
+  // A full group would ignore it: then it has an entry of its own.
+  if (split && activeGroupIds(state).length < MAX_TERMINALS_PER_GROUP) {
+    store.splitTerminal(threadRef, id);
+  } else store.newTerminal(threadRef, id);
+  focusTerminal(threadRef, id);
+}
+
+export function hideDrawer(threadRef: ScopedThreadRef): void {
+  useTerminalUiStateStore.getState().setTerminalOpen(threadRef, false);
+  // A closed drawer is clipped, not gone, and what's in it would keep the keys.
+  if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
+}
+
+/** files.toggle: goes to the files, or, already there, puts the drawer away. */
+export function toggleFilePane(threadRef: ScopedThreadRef): void {
+  const state = drawerState(threadRef);
+  const pane = filePaneToShow(state);
+  if (!pane) return openFilePane(threadRef);
+  const hasKeyboard = document.activeElement?.closest(
+    "[data-thread-terminal-drawer] [data-plutonium-files]",
+  );
+  if (state.terminalOpen && hasKeyboard) return hideDrawer(threadRef);
+  const store = useTerminalUiStateStore.getState();
+  store.setActiveTerminal(threadRef, pane);
+  store.setTerminalOpen(threadRef, true);
+  focusTerminal(threadRef, pane);
+}
+
+export function closeFilePane(threadRef: ScopedThreadRef, id: string): void {
+  useFilesStore.getState().setPaneDir(scopedThreadKey(threadRef), id, null);
+  useTerminalUiStateStore.getState().closeTerminal(threadRef, id);
+  if (drawerState(threadRef).terminalOpen) focusActiveDrawerTerminal(threadRef);
+}
diff --git a/apps/web/src/plutonium/files/filesCore.ts b/apps/web/src/plutonium/files/filesCore.ts
new file mode 100644
index 0000000000..e48a349331
--- /dev/null
+++ b/apps/web/src/plutonium/files/filesCore.ts
@@ -0,0 +1,145 @@
+// Plutonium: the file manager's core, which the helper serves to every shell
+// (/v1/ui/files.js, docs/features/FILE_MANAGER.md), with its types here.
+import { useEffect, useState } from "react";
+
+import { plutoniumHelperOrigin } from "../helperOrigin";
+
+export interface FileEntry {
+  readonly name: string;
+  readonly path: string;
+  readonly kind: "dir" | "file";
+  readonly size: number;
+  readonly modified: number;
+  readonly hidden: boolean;
+  readonly link?: boolean;
+}
+
+export interface DirectoryListing {
+  readonly dir: string;
+  readonly parent: string | null;
+  readonly entries: readonly FileEntry[];
+}
+
+export interface Place {
+  readonly name: string;
+  readonly path: string;
+  readonly kind: string;
+}
+
+export type FileOp = "copy" | "move" | "link" | "trash" | "delete" | "restore";
+export type FileConflict = "rename" | "overwrite" | "skip" | "fail";
+
+export interface FileJobRequest {
+  readonly op: FileOp;
+  readonly paths: readonly string[];
+  readonly target?: string;
+  readonly conflict?: FileConflict;
+}
+
+export interface FileJob {
+  readonly id: number;
+  readonly op: FileOp;
+  readonly state: "running" | "done" | "failed" | "cancelled";
+  readonly total: number;
+  readonly done: number;
+  readonly current: string;
+  readonly results: readonly { from: string; to: string }[];
+  readonly error?: string;
+}
+
+export type SortKey = "name" | "modified" | "size" | "extension";
+
+export interface KeyPress {
+  readonly key: string;
+  readonly ctrl?: boolean;
+  readonly alt?: boolean;
+  readonly shift?: boolean;
+  readonly meta?: boolean;
+}
+
+export interface Keymap {
+  feed(press: KeyPress): { command: string | null; pending: string; handled: boolean };
+  reset(): void;
+  help(): [keys: string, command: string, description: string][];
+}
+
+export interface FilesClient {
+  list(dir: string, options?: { hidden?: boolean }): Promise<DirectoryListing>;
+  places(): Promise<{ places: Place[]; recent: FileEntry[] }>;
+  find(
+    dir: string,
+    query: string,
+    options?: { hidden?: boolean },
+  ): Promise<
+    | { superseded: true }
+    | {
+        paths: string[];
+        matched: number;
+        total: number;
+        scanning: boolean;
+        engine: "fff" | "walk";
+        superseded?: undefined;
+      }
+  >;
+  findOpened(dir: string, query: string, path: string): Promise<unknown>;
+  preview(
+    path: string,
+  ): Promise<{ size: number; binary: boolean; text: string; truncated: boolean }>;
+  rawUrl(path: string): string;
+  makeFolder(path: string): Promise<{ path: string }>;
+  makeFile(path: string): Promise<{ path: string }>;
+  rename(path: string, name: string): Promise<{ path: string }>;
+  open(path: string, options?: { thread?: string; show?: boolean }): Promise<unknown>;
+  upload(dir: string, file: File): Promise<{ path: string }>;
+  runJob(request: FileJobRequest, progress?: (job: FileJob) => void): Promise<FileJob>;
+  cancelJob(id: number): Promise<unknown>;
+  watch(dir: string, changed: () => void): () => void;
+}
+
+export interface FilesCore {
+  Keymap: new (overrides?: readonly [string, string | null][]) => Keymap;
+  FilesClient: new (origin: string) => FilesClient;
+  fuzzyPositions(query: string, path: string): ReadonlySet<number>;
+  sortEntries(entries: readonly FileEntry[], sort?: SortKey, reverse?: boolean): FileEntry[];
+  globMatch(pattern: string, name: string): boolean;
+  fileKind(name: string): "image" | "video" | "audio" | "archive" | "document" | "file";
+  hasRawPreview(name: string): boolean;
+  formatSize(size: number): string;
+  parentOf(path: string): string | null;
+  joinPath(dir: string, name: string): string;
+  undoOf(job: FileJob): FileJobRequest | FileJobRequest[] | null;
+}
+
+let core: Promise<FilesCore> | null = null;
+let loaded: { core: FilesCore; helper: FilesClient } | null = null;
+
+export function loadFilesCore(): Promise<FilesCore> {
+  core ??= import(/* @vite-ignore */ `${plutoniumHelperOrigin()}/v1/ui/files.js`).then(
+    (module: FilesCore) => {
+      loaded = { core: module, helper: new module.FilesClient(plutoniumHelperOrigin()) };
+      return module;
+    },
+  );
+  return core;
+}
+
+/** The core and the helper's client, once loaded. */
+export function useFilesCore(): { core: FilesCore; helper: FilesClient } | null {
+  const [value, setValue] = useState(loaded);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- follows the helper, the page's focus or the DOM, which are outside React
+  useEffect(() => {
+    let live = true;
+    void loadFilesCore().then(() => {
+      if (live) setValue(loaded);
+    });
+    return () => {
+      live = false;
+    };
+  }, []);
+  return value;
+}
+
+/** The client, for code outside React; null until the core has loaded. */
+export function filesClient(): FilesClient | null {
+  return loaded?.helper ?? null;
+}
