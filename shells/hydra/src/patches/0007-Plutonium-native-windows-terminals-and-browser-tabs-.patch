diff --git a/apps/web/src/plutonium/AppLauncher.tsx b/apps/web/src/plutonium/AppLauncher.tsx
new file mode 100644
index 0000000000..4de12eccd3
--- /dev/null
+++ b/apps/web/src/plutonium/AppLauncher.tsx
@@ -0,0 +1,237 @@
+// Plutonium: the app launcher, a command palette mode (Super+Space). Lists
+// the desktop apps the Plutonium helper knows (freedesktop.org desktop
+// entries), most recently launched first, and launches the chosen one into
+// the current thread. Its window opens as a tab in the right panel, with the
+// keyboard.
+import { useAtomValue } from "@effect/atom-react";
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import { useParams } from "@tanstack/react-router";
+import { AppWindowIcon } from "lucide-react";
+import { useEffect, useMemo, useState } from "react";
+
+import { CommandPaletteContent } from "~/components/CommandPaletteContent";
+import { type CommandPaletteActionItem } from "~/components/CommandPalette.logic";
+import { CommandPaletteResults } from "~/components/CommandPaletteResults";
+import { toastManager } from "~/components/ui/toast";
+import { normalizeSearchText } from "~/lib/utils";
+import { primaryServerKeybindingsAtom } from "~/state/server";
+import { resolveThreadRouteTarget } from "~/threadRoutes";
+
+import { openAndFocusApp } from "./panelKeys";
+import {
+  type DesktopApp,
+  isPlutoniumShell,
+  plutoniumShell,
+  usePlutoniumWindowStore,
+} from "./windowStore";
+import { threadTag } from "./threadTag";
+
+const RECENT_KEY = "plutonium:recent-apps";
+const RECENT_LIMIT = 8;
+// How long a launched app has to show its window before the launcher stops
+// waiting to open it.
+const WINDOW_WAIT_MS = 60_000;
+
+function readRecent(): string[] {
+  try {
+    const value = JSON.parse(localStorage.getItem(RECENT_KEY) ?? "[]");
+    return Array.isArray(value) ? value.filter((id) => typeof id === "string") : [];
+  } catch {
+    return [];
+  }
+}
+
+function rememberLaunch(appId: string): void {
+  try {
+    const recent = [appId, ...readRecent().filter((id) => id !== appId)].slice(0, RECENT_LIMIT);
+    localStorage.setItem(RECENT_KEY, JSON.stringify(recent));
+  } catch {
+    // No storage: no recents.
+  }
+}
+
+let appsRequest: Promise<DesktopApp[]> | null = null;
+
+/** The helper's apps, fetched once per page (and again after a failure). */
+function loadApps(): Promise<DesktopApp[]> {
+  appsRequest ??= plutoniumShell().then((shell) => {
+    if (!shell) return [];
+    return shell.apps();
+  });
+  appsRequest.catch(() => (appsRequest = null));
+  return appsRequest;
+}
+
+/** Higher is better; 0 is no match. */
+function matchScore(app: DesktopApp, query: string): number {
+  const name = normalizeSearchText(app.name);
+  if (name === query) return 100;
+  if (name.startsWith(query)) return 80;
+  if (name.split(/[\s\-_.]+/).some((word) => word.startsWith(query))) return 60;
+  if (name.includes(query)) return 40;
+  const rest = [app.genericName, ...app.keywords, app.id].map(normalizeSearchText);
+  if (rest.some((text) => text.split(/[\s\-_.;]+/).some((word) => word.startsWith(query))))
+    return 20;
+  if (normalizeSearchText(app.comment).includes(query)) return 10;
+  return 0;
+}
+
+function AppIcon({ app }: { app: DesktopApp }) {
+  const [url, setUrl] = useState<string | null>(null);
+  useEffect(() => {
+    if (!app.hasIcon) return;
+    let live = true;
+    void plutoniumShell()
+      .then((shell) => shell?.appIcon(app.id) ?? null)
+      .then((icon) => live && setUrl(icon));
+    return () => {
+      live = false;
+    };
+  }, [app]);
+  return url ? (
+    <img alt="" className="size-5 shrink-0 object-contain" src={url} />
+  ) : (
+    <AppWindowIcon className="size-5 shrink-0 text-icon-muted" />
+  );
+}
+
+/**
+ * Launches `app` into `threadRef`'s thread and opens its first new window there.
+ * Its windows are announced as shown (openedItems.ts opens them), except an
+ * X11 app's, which Plutonium sees as the thread's X server's: hence the wait.
+ */
+async function launchApp(app: DesktopApp, threadRef: ScopedThreadRef): Promise<void> {
+  const shell = await plutoniumShell();
+  if (!shell) return;
+  rememberLaunch(app.id);
+  const threadId = threadRef.threadId as string;
+  const known = new Set(Object.keys(usePlutoniumWindowStore.getState().windows).map(Number));
+  let opened = false;
+  const open = () => {
+    const window = Object.values(usePlutoniumWindowStore.getState().windows)
+      .filter((entry) => entry.threadId === threadTag(threadId) && !known.has(entry.id))
+      .toSorted((a, b) => a.id - b.id)[0];
+    if (!window || opened) return;
+    opened = true;
+    stop();
+    openAndFocusApp(threadRef, { windowId: window.id, appId: window.appId });
+  };
+  const unsubscribe = usePlutoniumWindowStore.subscribe(open);
+  const timer = setTimeout(() => stop(), WINDOW_WAIT_MS);
+  function stop() {
+    unsubscribe();
+    clearTimeout(timer);
+  }
+  toastManager.add({ type: "info", title: `Starting ${app.name}…`, timeout: 2500 });
+  try {
+    await shell.launchApp(threadTag(threadId), app.id);
+  } catch (error) {
+    stop();
+    toastManager.add({
+      type: "error",
+      title: `Could not start ${app.name}`,
+      description: error instanceof Error ? error.message : String(error),
+    });
+  }
+}
+
+export function PlutoniumAppLauncher({ setOpen }: { setOpen: (open: boolean) => void }) {
+  const keybindings = useAtomValue(primaryServerKeybindingsAtom);
+  const routeTarget = useParams({
+    strict: false,
+    select: (params) => resolveThreadRouteTarget(params),
+  });
+  const threadRef = routeTarget?.kind === "server" ? routeTarget.threadRef : null;
+  const [apps, setApps] = useState<DesktopApp[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [query, setQuery] = useState("");
+  const [highlightedItemValue, setHighlightedItemValue] = useState<string | null>(null);
+
+  useEffect(() => {
+    let live = true;
+    loadApps().then(
+      (list) => live && setApps(list),
+      (reason: unknown) =>
+        live && setError(reason instanceof Error ? reason.message : String(reason)),
+    );
+    return () => {
+      live = false;
+    };
+  }, []);
+
+  const groups = useMemo(() => {
+    if (!apps || !threadRef) return [];
+    const toItem = (app: DesktopApp): CommandPaletteActionItem => ({
+      kind: "action",
+      value: `app:${app.id}`,
+      searchTerms: [app.name, app.genericName, ...app.keywords],
+      title: app.name,
+      ...(app.genericName || app.comment ? { description: app.genericName || app.comment } : {}),
+      icon: <AppIcon app={app} />,
+      run: () => launchApp(app, threadRef),
+    });
+    const needle = normalizeSearchText(query.trim());
+    if (needle) {
+      const matches = apps
+        .map((app) => ({ app, score: matchScore(app, needle) }))
+        .filter((entry) => entry.score > 0)
+        .toSorted((a, b) => b.score - a.score || a.app.name.localeCompare(b.app.name));
+      return matches.length > 0
+        ? [{ value: "apps", label: "Apps", items: matches.map((entry) => toItem(entry.app)) }]
+        : [];
+    }
+    const byId = new Map(apps.map((app) => [app.id, app]));
+    const recent = readRecent().flatMap((id) => byId.get(id) ?? []);
+    const recentIds = new Set(recent.map((app) => app.id));
+    return [
+      ...(recent.length > 0
+        ? [{ value: "recent", label: "Recent", items: recent.map(toItem) }]
+        : []),
+      {
+        value: "apps",
+        label: "All apps",
+        items: apps.filter((app) => !recentIds.has(app.id)).map(toItem),
+      },
+    ];
+  }, [apps, query, threadRef]);
+
+  const emptyStateMessage = !isPlutoniumShell()
+    ? "Apps launch only in the Plutonium shell."
+    : !threadRef
+      ? "Open a thread to launch apps into it."
+      : (error ?? (apps === null ? "Loading apps…" : "No matching apps."));
+
+  return (
+    <CommandPaletteContent
+      aria-label="App launcher"
+      autoHighlight="always"
+      escapeLabel="Close"
+      footerActionLabel="Launch"
+      inputProps={{ placeholder: "Launch an app…" }}
+      mode="none"
+      onItemHighlighted={(value) => {
+        setHighlightedItemValue(typeof value === "string" ? value : null);
+      }}
+      onValueChange={(value) => {
+        setHighlightedItemValue(null);
+        setQuery(value);
+      }}
+      panelSize="tall-list"
+      testId="plutonium-app-launcher"
+      value={query}
+    >
+      <CommandPaletteResults
+        groups={groups}
+        highlightedItemValue={highlightedItemValue}
+        isActionsOnly={false}
+        keybindings={keybindings}
+        onExecuteItem={(item) => {
+          if (item.kind !== "action") return;
+          setOpen(false);
+          void item.run();
+        }}
+        emptyStateMessage={emptyStateMessage}
+      />
+    </CommandPaletteContent>
+  );
+}
