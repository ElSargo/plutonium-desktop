@@ -0,0 +1,74 @@
+import { parseKeybindingShortcut } from "@t3tools/shared/keybindings";
+import type { ResolvedKeybindingsConfig } from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import { resolveFileKey } from "./fileKeys";
+
+const rule = (key: string, command: string) => ({
+  command,
+  shortcut: parseKeybindingShortcut(key)!,
+});
+const rules = [
+  rule("j", "files.down"),
+  rule("g g", "files.top"),
+  rule("g h", "files.goHome"),
+  rule("shift+g", "files.bottom"),
+  rule("ctrl+d", "files.halfPageDown"),
+  rule("mod+j", "terminal.toggle"),
+  rule("meta+e", "files.toggle"),
+] as unknown as ResolvedKeybindingsConfig;
+
+const press = (
+  key: string,
+  modifiers: Partial<Record<"ctrlKey" | "shiftKey" | "altKey" | "metaKey", boolean>> = {},
+) => ({
+  key,
+  ctrlKey: false,
+  shiftKey: false,
+  altKey: false,
+  metaKey: false,
+  ...modifiers,
+});
+const linux = "Linux x86_64";
+
+describe("resolveFileKey", () => {
+  it("parses a sequence", () => {
+    expect(parseKeybindingShortcut("g g")).toMatchObject({ key: "g", prefix: "g" });
+    expect(parseKeybindingShortcut(", m")).toMatchObject({ key: "m", prefix: "," });
+    expect(parseKeybindingShortcut("space")?.prefix).toBeUndefined();
+  });
+
+  it("single keys, with their modifiers", () => {
+    expect(resolveFileKey(press("j"), rules, "", linux).command).toBe("down");
+    expect(resolveFileKey(press("G", { shiftKey: true }), rules, "", linux).command).toBe("bottom");
+    expect(resolveFileKey(press("d", { ctrlKey: true }), rules, "", linux).command).toBe(
+      "halfPageDown",
+    );
+  });
+
+  it("a sequence waits for its second key; a wrong one is used up", () => {
+    expect(resolveFileKey(press("g"), rules, "", linux)).toEqual({
+      command: null,
+      pending: "g",
+      handled: true,
+    });
+    expect(resolveFileKey(press("g"), rules, "g", linux).command).toBe("top");
+    expect(resolveFileKey(press("h"), rules, "g", linux).command).toBe("goHome");
+    expect(resolveFileKey(press("q"), rules, "g", linux)).toEqual({
+      command: null,
+      pending: "",
+      handled: true,
+    });
+  });
+
+  it("leaves what isn't its own to the page, and a held modifier alone", () => {
+    expect(resolveFileKey(press("q"), rules, "", linux).handled).toBe(false);
+    expect(resolveFileKey(press("j", { ctrlKey: true }), rules, "", linux).handled).toBe(false);
+    expect(resolveFileKey(press("e", { metaKey: true }), rules, "", linux).handled).toBe(false);
+    expect(resolveFileKey(press("Shift", { shiftKey: true }), rules, "g", linux)).toEqual({
+      command: null,
+      pending: "g",
+      handled: false,
+    });
+  });
+});
diff --git a/apps/web/src/plutonium/files/fileKeys.ts b/apps/web/src/plutonium/files/fileKeys.ts
new file mode 100644
index 0000000000..5a5d478cf8
--- /dev/null
+++ b/apps/web/src/plutonium/files/fileKeys.ts
@@ -0,0 +1,47 @@
+// Plutonium: the file manager's keys, from Hydra's own keybindings (Settings,
+// Keybindings): the rules for `files.*` with "when": "filesFocus". "g g" is a sequence
+// (the shortcut's `prefix`), which only this reads.
+import type { ResolvedKeybindingsConfig } from "@t3tools/contracts";
+import { matchesKeybindingShortcut } from "@t3tools/shared/keybindings";
+
+import { isFileManagerBinding } from "./ownsKey";
+
+export interface FileKeyEvent {
+  readonly key: string;
+  readonly code?: string;
+  readonly metaKey: boolean;
+  readonly ctrlKey: boolean;
+  readonly shiftKey: boolean;
+  readonly altKey: boolean;
+  getModifierState?(key: string): boolean;
+}
+
+const MODIFIERS = new Set(["Shift", "Control", "Alt", "Meta", "AltGraph", "CapsLock", "Dead"]);
+
+/**
+ * What a key press means after `pending` (a sequence's first key, or ""). `command` is the
+ * file manager's own name ("down"); `handled` is false for a key that means nothing here.
+ */
+export function resolveFileKey(
+  event: FileKeyEvent,
+  keybindings: ResolvedKeybindingsConfig,
+  pending: string,
+  platform = navigator.platform,
+): { command: string | null; pending: string; handled: boolean } {
+  if (MODIFIERS.has(event.key)) return { command: null, pending, handled: false };
+  const rules = keybindings.filter(isFileManagerBinding);
+  for (let index = rules.length - 1; index >= 0; index -= 1) {
+    const rule = rules[index];
+    if (!rule || (rule.shortcut.prefix ?? "") !== pending) continue;
+    if (matchesKeybindingShortcut(event as never, rule.shortcut, platform)) {
+      return { command: String(rule.command).slice("files.".length), pending: "", handled: true };
+    }
+  }
+  const plain = !event.ctrlKey && !event.altKey && !event.metaKey;
+  const key = event.key.toLowerCase();
+  if (!pending && plain && rules.some((rule) => rule.shortcut.prefix === key)) {
+    return { command: null, pending: key, handled: true };
+  }
+  // A wrong second key ends the sequence, and is used up by it.
+  return { command: null, pending: "", handled: pending !== "" };
+}
