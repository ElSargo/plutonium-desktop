+// Plutonium: the right panel's Files tab. The file manager when the project is on this
+// computer (the helper can list it); T3's own tree for a remote environment's, whose
+// files only its server can reach.
+import { serializeComposerFileLink } from "@t3tools/shared/composerTrigger";
+import type { ComponentProps } from "react";
+import { useEffect, useState } from "react";
+
+import FileBrowserPanel from "~/components/files/FileBrowserPanel";
+import { useComposerHandleContext } from "~/composerHandleContext";
+
+import { usePlutoniumWindowStore } from "../windowStore";
+import { useFilesCore } from "./filesCore";
+import { FileManager } from "./FileManager";
+
+export default function HydraFilesPanel(props: ComponentProps<typeof FileBrowserPanel>) {
+  const { cwd, hostFolder, onOpenFile } = props;
+  const inShell = usePlutoniumWindowStore((state) => state.available);
+  const client = useFilesCore()?.helper;
+  const composer = useComposerHandleContext();
+  const [local, setLocal] = useState<boolean | null>(null);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- follows the helper, the page's focus or the DOM, which are outside React
+  useEffect(() => {
+    if (!inShell || !client) return;
+    let live = true;
+    void client.list(cwd).then(
+      () => live && setLocal(true),
+      () => live && setLocal(false),
+    );
+    return () => {
+      live = false;
+    };
+  }, [client, cwd, inShell]);
+
+  if (!inShell || local === false) return <FileBrowserPanel {...props} />;
+  if (local === null) return null;
+  return (
+    <FileManager
+      instance="panel"
+      className="h-full"
+      initialDir={cwd}
+      project={cwd}
+      compact
+      singleClickOpens
+      onOpenFile={(path) =>
+        // The panel opens a project's files by their path in it.
+        onOpenFile(!hostFolder && path.startsWith(`${cwd}/`) ? path.slice(cwd.length + 1) : path)
+      }
+      onAddToChat={(path) =>
+        composer?.current?.insertTextAtEnd(`${serializeComposerFileLink(path)} `, {
+          ensureLeadingBoundary: true,
+        })
+      }
+    />
+  );
+}
diff --git a/apps/web/src/plutonium/files/PlutoniumFilePane.tsx b/apps/web/src/plutonium/files/PlutoniumFilePane.tsx
new file mode 100644
index 0000000000..36235a079e
--- /dev/null
+++ b/apps/web/src/plutonium/files/PlutoniumFilePane.tsx
@@ -0,0 +1,80 @@
+// Plutonium: the file manager as an entry in the terminal drawer (filePanes.ts). It stays
+// mounted while another entry is on show, and comes back where it was after a reload.
+import { scopedThreadKey } from "@t3tools/client-runtime/environment";
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import { serializeComposerFileLink } from "@t3tools/shared/composerTrigger";
+import { useEffect, useRef, useState } from "react";
+
+import { useComposerHandleContext } from "~/composerHandleContext";
+import { consumePendingTerminalFocus, registerTerminalFocusTarget } from "~/lib/terminalFocus";
+import { useRightPanelStore } from "~/rightPanelStore";
+
+import { closeFilePane, filePaneSlot, hideDrawer, openFilePane } from "./filePanes";
+import { FileManager } from "./FileManager";
+import { useFilesStore } from "./filesStore";
+import { useFilesHome } from "./useFilesHome";
+
+export function PlutoniumFilePane(props: {
+  readonly threadRef: ScopedThreadRef;
+  readonly paneId: string;
+  readonly projectFolder: string;
+  /** In the open drawer, in the group on show. */
+  readonly shown: boolean;
+}) {
+  const { threadRef, paneId, projectFolder, shown } = props;
+  const threadKey = scopedThreadKey(threadRef);
+  const dir = useFilesStore((state) => state.paneDirs[threadKey]?.[paneId]);
+  const setPaneDir = useFilesStore((state) => state.setPaneDir);
+  const home = useFilesHome(projectFolder);
+  const composer = useComposerHandleContext();
+  // Each request for the keyboard, for the file manager to take it once it's ready.
+  const [focusRequest, setFocusRequest] = useState(0);
+  const shownNow = useRef(shown);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- the terminal drawer's focus requests, outside React
+  useEffect(() => {
+    shownNow.current = shown;
+    if (shown) consumePendingTerminalFocus(threadRef, paneId);
+  }, [paneId, shown, threadRef]);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- the terminal drawer's focus requests, outside React
+  useEffect(
+    () =>
+      registerTerminalFocusTarget({
+        threadRef,
+        terminalId: paneId,
+        focus: () => {
+          if (!shownNow.current) return false;
+          setFocusRequest((count) => count + 1);
+          return true;
+        },
+      }),
+    [paneId, threadRef],
+  );
+
+  if (!home) return null;
+  return (
+    <FileManager
+      instance={`drawer:${filePaneSlot(paneId)}`}
+      className="h-full"
+      initialDir={dir ?? home}
+      project={projectFolder}
+      thread={threadRef.threadId}
+      autoFocus={focusRequest}
+      onDirChange={(next) => setPaneDir(threadKey, paneId, next)}
+      onOpenFile={(path) => {
+        const panel = useRightPanelStore.getState();
+        panel.openFile(threadRef, path);
+        panel.show(threadRef);
+      }}
+      onAddToChat={(path) =>
+        composer?.current?.insertTextAtEnd(`${serializeComposerFileLink(path)} `, {
+          ensureLeadingBoundary: true,
+        })
+      }
+      onSplit={(from) => openFilePane(threadRef, { split: true, dir: from })}
+      onHide={() => hideDrawer(threadRef)}
+      onClose={() => closeFilePane(threadRef, paneId)}
+    />
+  );
+}
diff --git a/apps/web/src/plutonium/files/SplitRow.tsx b/apps/web/src/plutonium/files/SplitRow.tsx
new file mode 100644
index 0000000000..8d85bb72a3
--- /dev/null
+++ b/apps/web/src/plutonium/files/SplitRow.tsx
@@ -0,0 +1,95 @@
+// Plutonium: children side by side, with handles between them to resize them. A size is a
+// ratio of the row's width; a double click on a handle puts both sides back.
+import { Children, useRef, useState } from "react";
+
+import { cn } from "~/lib/utils";
+
+const MIN_SHARE = 0.1;
+
+export function SplitRow({
+  ratios,
+  defaults,
+  onCommit,
+  className,
+  children,
+}: {
+  ratios: readonly number[];
+  defaults: readonly number[];
+  onCommit: (ratios: readonly number[]) => void;
+  className?: string;
+  children: React.ReactNode;
+}) {
+  const row = useRef<HTMLDivElement>(null);
+  const drag = useRef<{ index: number; startX: number; start: readonly number[] } | null>(null);
+  const [live, setLive] = useState<readonly number[] | null>(null);
+  const panes = Children.toArray(children);
+  const sizes = panes.map((_, index) => live?.[index] ?? ratios[index] ?? 1);
+
+  const onPointerMove = (event: React.PointerEvent) => {
+    const active = drag.current;
+    const width = row.current?.clientWidth;
+    if (!active || !width) return;
+    const total = active.start.reduce((sum, size) => sum + size, 0);
+    const left = active.start[active.index] ?? 0;
+    const right = active.start[active.index + 1] ?? 0;
+    const least = total * MIN_SHARE;
+    const moved = ((event.clientX - active.startX) / width) * total;
+    const delta = Math.max(least - left, Math.min(right - least, moved));
+    setLive(
+      active.start.map((size, index) =>
+        index === active.index ? left + delta : index === active.index + 1 ? right - delta : size,
+      ),
+    );
+  };
+
+  return (
+    <div ref={row} className={cn("flex min-w-0", className)}>
+      {panes.flatMap((pane, index) => {
+        const box = (
+          <div
+            // oxlint-disable-next-line react/no-array-index-key -- a position is all these have: they never move
+            key={`pane-${index}`}
+            className="min-h-0 min-w-0"
+            style={{ flex: `${sizes[index]} 1 0` }}
+          >
+            {pane}
+          </div>
+        );
+        if (index === panes.length - 1) return [box];
+        return [
+          box,
+          <div
+            // oxlint-disable-next-line react/no-array-index-key -- a position is all these have: they never move
+            key={`handle-${index}`}
+            role="separator"
+            aria-orientation="vertical"
+            className="group/handle relative z-10 w-px shrink-0 cursor-col-resize bg-border/70"
+            onPointerDown={(event) => {
+              event.preventDefault();
+              event.stopPropagation();
+              drag.current = { index, startX: event.clientX, start: sizes };
+              event.currentTarget.setPointerCapture(event.pointerId);
+            }}
+            onPointerMove={onPointerMove}
+            onPointerUp={() => {
+              if (live) onCommit(live);
+              drag.current = null;
+              setLive(null);
+            }}
+            onDoubleClick={() => {
+              onCommit(
+                sizes.map((size, position) =>
+                  position === index || position === index + 1
+                    ? (defaults[position] ?? size)
+                    : size,
+                ),
+              );
+            }}
+          >
+            <span className="absolute inset-y-0 -left-1 w-2 transition-colors group-hover/handle:bg-primary/25" />
+          </div>,
+        ];
+      })}
+    </div>
+  );
+}
diff --git a/apps/web/src/plutonium/files/carry.ts b/apps/web/src/plutonium/files/carry.ts
new file mode 100644
index 0000000000..172ce6cae2
--- /dev/null
+++ b/apps/web/src/plutonium/files/carry.ts
@@ -0,0 +1,81 @@
+// Plutonium: carrying files with no mouse: they ride on the pointer until they're
+// dropped (docs/features/FILE_MANAGER.md, "With no mouse"), and the key that picks them.
+import { plutoniumShell } from "../windowStore";
+import { useFilesStore } from "./filesStore";
+
+function pixels(paths: readonly string[]): string {
+  // A small label for what rides on the pointer, as a PNG in base64.
+  const canvas = document.createElement("canvas");
+  const context = canvas.getContext("2d");
+  if (!context) return "";
+  const label = paths.length === 1 ? (paths[0]?.split("/").pop() ?? "") : `${paths.length} items`;
+  context.font = "13px system-ui, sans-serif";
+  const width = Math.min(280, Math.ceil(context.measureText(label).width) + 24);
+  canvas.width = width;
+  canvas.height = 28;
+  context.fillStyle = "rgba(30, 30, 34, 0.92)";
+  context.beginPath();
+  context.roundRect(0, 0, width, 28, 7);
+  context.fill();
+  context.font = "13px system-ui, sans-serif";
+  context.fillStyle = "#fff";
+  context.textBaseline = "middle";
+  context.fillText(label, 12, 14, width - 24);
+  return canvas.toDataURL("image/png").split(",")[1] ?? "";
+}
+
+/** Rides `paths` on the pointer (a keyboard drag), with the hint up until it's over. */
+export async function carryFiles(paths: readonly string[]): Promise<void> {
+  const shell = await plutoniumShell();
+  if (!shell?.startFileDrag || paths.length === 0) return;
+  const store = useFilesStore.getState();
+  store.setCarrying(paths);
+  try {
+    await shell.startFileDrag(paths, { imagePng: pixels(paths) });
+  } finally {
+    store.setCarrying(null);
+  }
+}
+
+let nextCarry = 1_000_000;
+
+/** The carry key: pick something, and it rides on the pointer. `fuzzy` opens on the finder. */
+export function pickAndCarry({ fuzzy = false } = {}) {
+  const store = useFilesStore.getState();
+  if (store.picker) return;
+  store.setPicker({
+    id: nextCarry++,
+    detail: {
+      mode: "open-multiple",
+      title: "Pick up",
+      acceptLabel: "Pick up",
+      ...(fuzzy ? { fuzzy, home: true } : {}),
+    },
+    asker: "",
+    answer: (answer) => {
+      // After the dialog has gone, so the pointer is over what's under it.
+      if (answer?.paths.length) requestAnimationFrame(() => void carryFiles(answer.paths));
+    },
+  });
+}
+
+/** The floating fuzzy finder, over `dir` or the home folder. What's chosen goes to `open`. */
+export function findFloating(dir: string | null, open: (paths: readonly string[]) => void) {
+  const store = useFilesStore.getState();
+  if (store.picker) return;
+  store.setPicker({
+    id: nextCarry++,
+    detail: {
+      mode: "open-multiple",
+      title: "Find",
+      acceptLabel: "Open",
+      fuzzy: true,
+      find: true,
+      ...(dir ? { currentFolder: dir } : { home: true }),
+    },
+    asker: dir ?? "",
+    answer: (answer) => {
+      if (answer?.paths.length) open(answer.paths);
+    },
+  });
+}
