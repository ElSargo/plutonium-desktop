@@ -0,0 +1,191 @@
+// Plutonium: what a thread's chat view adds in the Plutonium shell, kept out
+// of ChatView so a T3 Code upgrade only meets a few lines there: the Apps tab,
+// the dock's context (its sites, tabs and terminal), the panel's keys, an
+// app's own maximize button, and the floating preview following the tab the
+// agent drives.
+import {
+  isAtomCommandInterrupted,
+  squashAtomCommandFailure,
+} from "@t3tools/client-runtime/state/runtime";
+import type { ResolvedKeybindingsConfig, ScopedThreadRef } from "@t3tools/contracts";
+import { useEffect } from "react";
+
+import { useBrowserPointerStore } from "../browser/browserPointerStore";
+import { previewRuntimeTabId } from "../browser/previewRuntimeTabId";
+import { openPreviewSession } from "../components/preview/openPreviewSession";
+import { stackedThreadToast, toastManager } from "../components/ui/toast";
+import { useStableCallback } from "../hooks/useStableCallback";
+import { focusActiveDrawerTerminal } from "../lib/terminalFocus";
+import {
+  browserMiniPlayerSource,
+  selectThreadPreviewMiniPlayer,
+  usePreviewMiniPlayerStore,
+} from "../previewMiniPlayerStore";
+import { beginPreviewSessionClose, type ThreadPreviewState } from "../previewStateStore";
+import { type RightPanelSurface, useRightPanelStore } from "../rightPanelStore";
+import { previewEnvironment } from "../state/preview";
+import { useAtomCommand } from "../state/use-atom-command";
+import { type DockContext, publishDockContext, useTerminalFolded } from "./dock";
+import { importBrowserTab } from "./importTab";
+import { usePlutoniumPanelKeys } from "./panelKeys";
+import type { BrokerTab } from "./previewBridge";
+import { PANEL_MAXIMIZE_REQUEST_EVENT } from "./PlutoniumWindows";
+import { usePlutoniumWindowStore } from "./windowStore";
+
+export interface ThreadPlutoniumInput {
+  readonly threadRef: ScopedThreadRef | null;
+  readonly projectId: string | null;
+  /** Where the floating finder looks first. */
+  readonly projectFolder: string | null;
+  readonly keybindings: ResolvedKeybindingsConfig;
+  readonly canOperatePreview: boolean;
+  readonly surfaces: readonly RightPanelSurface[];
+  readonly activeSurfaceId: string | null;
+  readonly panelOpen: boolean;
+  readonly maximized: boolean;
+  readonly canMaximize: boolean;
+  readonly terminalOpen: boolean;
+  readonly previewState: ThreadPreviewState;
+  readonly toggleTerminal: () => void;
+  readonly setTerminalOpen: (open: boolean) => void;
+  readonly focusComposer: () => void;
+  readonly activate: (surface: RightPanelSurface) => void;
+  readonly newBrowserTab: () => void;
+}
+
+export function useThreadPlutonium(input: ThreadPlutoniumInput) {
+  const { threadRef, canOperatePreview } = input;
+  const openPreview = useAtomCommand(previewEnvironment.open, { reportFailure: false });
+  const closePreview = useAtomCommand(previewEnvironment.close, "preview close");
+
+  // Native windows, only when this page is the shell.
+  const appsAvailable = usePlutoniumWindowStore((state) => state.available);
+  const addApps = useStableCallback(() => {
+    if (threadRef) useRightPanelStore.getState().open(threadRef, "apps");
+  });
+
+  // The dock folded the conversation away for the terminal drawer.
+  const terminalFolded = useTerminalFolded(threadRef);
+  const terminalFoldedAway = terminalFolded && input.terminalOpen;
+
+  const reportOpenFailure = (error: unknown) =>
+    toastManager.add(
+      stackedThreadToast({
+        type: "error",
+        title: "Unable to open browser",
+        description: error instanceof Error ? error.message : String(error),
+      }),
+    );
+  // A dock slot's site, opened as a new browser tab.
+  const openSite = useStableCallback(async (url: string) => {
+    if (!threadRef || !canOperatePreview) return;
+    const result = await openPreviewSession({ openPreview, threadRef, url });
+    if (result._tag === "Failure") {
+      if (!isAtomCommandInterrupted(result)) reportOpenFailure(squashAtomCommandFailure(result));
+      return;
+    }
+    useRightPanelStore.getState().openBrowser(threadRef, result.value.tabId);
+    useRightPanelStore.getState().show(threadRef);
+  });
+  // A dock slot's tab kept per project or everywhere, moving here.
+  const showTab = useStableCallback(async (tab: BrokerTab): Promise<string | null> => {
+    if (!threadRef || !canOperatePreview) return null;
+    const result = await importBrowserTab({ threadRef, tab, openPreview });
+    if (!result || result._tag === "Failure") {
+      if (result && isAtomCommandInterrupted(result)) return null;
+      reportOpenFailure(result ? squashAtomCommandFailure(result) : "No Plutonium browser");
+      return null;
+    }
+    useRightPanelStore.getState().show(threadRef);
+    return (result.value as { tabId: string }).tabId;
+  });
+  const closeDockPreview = useStableCallback(async (ref: ScopedThreadRef, tabId: string) => {
+    beginPreviewSessionClose(ref, tabId);
+    await closePreview({
+      environmentId: ref.environmentId,
+      input: { threadId: ref.threadId, tabId },
+    });
+  });
+  // The Apps tab's "Elsewhere" list brings another shell's tab here.
+  const importTab = useStableCallback((tab: BrokerTab) => {
+    if (threadRef) void importBrowserTab({ threadRef, tab, openPreview });
+  });
+  const closeTerminal = useStableCallback(() => input.setTerminalOpen(false));
+  const focusTerminal = useStableCallback(() => {
+    if (threadRef) focusActiveDrawerTerminal(threadRef);
+  });
+
+  const dock: DockContext | null = threadRef
+    ? {
+        threadRef,
+        projectId: input.projectId,
+        surfaces: input.surfaces,
+        activeSurfaceId: input.activeSurfaceId,
+        panelOpen: input.panelOpen,
+        maximized: input.maximized,
+        terminalOpen: input.terminalOpen,
+        openTerminal: input.toggleTerminal,
+        closeTerminal,
+        focusTerminal,
+        focusComposer: input.focusComposer,
+        activate: input.activate,
+        openSite,
+        showTab,
+        closePreview: closeDockPreview,
+      }
+    : null;
+  // The sidebar's dock runs slots in this thread and shows their state.
+  useEffect(() => publishDockContext(dock));
+  useEffect(() => () => publishDockContext(null), []);
+  // Alt+1…9, Ctrl+Tab and Ctrl+T for the panel's tabs, and the dock.
+  usePlutoniumPanelKeys({
+    threadRef,
+    keybindings: input.keybindings,
+    surfaces: input.surfaces,
+    activeSurfaceId: input.activeSurfaceId,
+    activate: input.activate,
+    newBrowserTab: input.newBrowserTab,
+    dock,
+    projectFolder: input.projectFolder,
+  });
+
+  // An app in the panel pressed its own maximize (or restore) button.
+  const { canMaximize } = input;
+  useEffect(() => {
+    const onRequest = (event: Event) => {
+      if (!canMaximize || !threadRef) return;
+      const { maximized } = (event as CustomEvent<{ maximized: boolean }>).detail;
+      useRightPanelStore.getState().setMaximized(threadRef, maximized);
+    };
+    document.addEventListener(PANEL_MAXIMIZE_REQUEST_EVENT, onRequest);
+    return () => document.removeEventListener(PANEL_MAXIMIZE_REQUEST_EVENT, onRequest);
+  }, [canMaximize, threadRef]);
+
+  // The floating preview follows the tab the agent drives: the agent's cursor
+  // in another of the thread's tabs brings that one up in it.
+  const { sessions, serverEpoch } = input.previewState;
+  useEffect(() => {
+    if (!threadRef) return;
+    return useBrowserPointerStore.subscribe((state, previous) => {
+      const source = selectThreadPreviewMiniPlayer(
+        usePreviewMiniPlayerStore.getState().byThreadKey,
+        threadRef,
+      )?.source;
+      if (source?.kind !== "browser") return;
+      for (const [runtimeTabId, event] of Object.entries(state.byTabId)) {
+        if (previous.byTabId[runtimeTabId] === event) continue;
+        const session = Object.values(sessions).find(
+          (candidate) =>
+            previewRuntimeTabId(threadRef, serverEpoch, candidate.tabId) === runtimeTabId,
+        );
+        if (!session || session.tabId === source.tabId) continue;
+        usePreviewMiniPlayerStore
+          .getState()
+          .open(threadRef, browserMiniPlayerSource(session.tabId));
+        return;
+      }
+    });
+  }, [serverEpoch, sessions, threadRef]);
+
+  return { dock, appsAvailable, addApps, importTab, terminalFoldedAway };
+}
diff --git a/apps/web/src/plutonium/windowStore.ts b/apps/web/src/plutonium/windowStore.ts
