+    submitPrompt,
+    onPromptChange,
+    startFilesDrag,
+    armPaths,
+    canSplit: Boolean(options.onSplit),
+    picking: Boolean(pick),
+    /** Opened on the fuzzy finder: leaving it leaves the picker. */
+    fuzzyOnly: Boolean(pick?.detail.fuzzy),
+    canCarry: !pick || Boolean(pick.detail.find),
+    cancelPick: pick?.cancel,
+    compact: Boolean(options.compact),
+    keybindings,
+    cancelPrompt,
+    onRowClick,
+    onRowContextMenu,
+    armDrag,
+    onRowDragStart,
+    onDragOver,
+    onDrop,
+    targets,
+    /** The fuzzy finder's marked files, as a picker's answer; undefined outside a picker. */
+    pickAll:
+      pick && pick.detail.mode !== "save" && pick.detail.mode !== "folder"
+        ? (paths: readonly string[]) =>
+            pick.accept(pick.detail.mode === "open" ? paths.slice(0, 1) : paths)
+        : undefined,
+    canGoBack: history.back.length > 0,
+    canGoForward: history.forward.length > 0,
+  };
+}
+
+export type FileManagerState = ReturnType<typeof useFileManager>;
