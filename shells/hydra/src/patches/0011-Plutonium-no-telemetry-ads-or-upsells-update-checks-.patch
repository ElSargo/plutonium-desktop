-    Effect.flatMap(Clock.currentTimeMillis, (now) => {
-      firstSend ??= now;
-      const at = now - firstSend;
-      const status = at < minutes * 60_000 ? 503 : 204;
-      answers.push({ at, status });
-      return respondWithStatus(status)(request);
-    });
-  return { respond, answers };
-};
