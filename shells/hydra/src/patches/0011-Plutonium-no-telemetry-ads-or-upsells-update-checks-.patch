@@ -0,0 +1,60 @@
+import * as Schema from "effect/Schema";
+import { RefreshCwIcon } from "lucide-react";
+
+import { Button } from "../components/ui/button";
+import {
+  Dialog,
+  DialogDescription,
+  DialogFooter,
+  DialogHeader,
+  DialogPopup,
+  DialogTitle,
+} from "../components/ui/dialog";
+import { useLocalStorage } from "../hooks/useLocalStorage";
+import { useUpdatePrimarySettings } from "../hooks/useSettings";
+
+const ASKED_KEY = "hydra:update-checks-asked";
+
+/**
+ * Update checks are off until the user turns them on (`enableProviderUpdateChecks`
+ * defaults to false). On the first launch this asks once; either answer is saved on the
+ * server, and Settings, Maintenance, Updates changes it later.
+ */
+export function UpdateChecksPrompt() {
+  const [asked, setAsked] = useLocalStorage(ASKED_KEY, false, Schema.Boolean);
+  const updateSettings = useUpdatePrimarySettings();
+
+  const answer = (enabled: boolean) => {
+    updateSettings({ enableProviderUpdateChecks: enabled });
+    setAsked(true);
+  };
+
+  return (
+    <Dialog
+      open={!asked}
+      onOpenChange={(open) => {
+        if (!open) answer(false);
+      }}
+    >
+      <DialogPopup className="max-w-md">
+        <DialogHeader>
+          <div className="flex size-9 items-center justify-center rounded-lg border border-border/70 bg-muted/60">
+            <RefreshCwIcon aria-hidden className="size-4.5 text-muted-foreground" />
+          </div>
+          <DialogTitle>Check for updates?</DialogTitle>
+          <DialogDescription>
+            Hydra can check npm for newer versions of your agent CLIs (Claude, Codex and the others
+            you use) and fetch updates to the model list. Nothing is checked unless you turn this
+            on. You can change it later in Settings, Maintenance.
+          </DialogDescription>
+        </DialogHeader>
+        <DialogFooter>
+          <Button variant="outline" onClick={() => answer(false)}>
+            Don&apos;t check
+          </Button>
+          <Button onClick={() => answer(true)}>Check for updates</Button>
+        </DialogFooter>
+      </DialogPopup>
+    </Dialog>
+  );
+}
