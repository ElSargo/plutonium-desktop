+// @effect-diagnostics nodeBuiltinImport:off - a fake Plutonium helper on a Unix socket
+import { expect, it } from "@effect/vitest";
+import { EnvironmentId, ProviderInstanceId, ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import { McpSchema, McpServer } from "effect/ai";
+import * as NodeFS from "node:fs";
+import * as NodeHttp from "node:http";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+import * as McpHttpServer from "../mcp/McpHttpServer.ts";
+import * as McpInvocationContext from "../mcp/McpInvocationContext.ts";
+import * as McpToolAccessTestkit from "../mcp/McpToolAccess.testkit.ts";
+import * as ServerBrowser from "../preview/ServerBrowser.ts";
+
+const threadId = ThreadId.make("thread-windows-test");
+const invocation = (thread: boolean) => ({
+  environmentId: EnvironmentId.make("environment-windows-test"),
+  requestNamespace: "provider-session-windows-test",
+  thread: thread
+    ? {
+        threadId,
+        providerSessionId: "provider-session-windows-test",
+        providerInstanceId: ProviderInstanceId.make("codex"),
+      }
+    : undefined,
+  client: thread
+    ? undefined
+    : { sessionId: "client", label: "client", access: "read-only" as const },
+  capabilities: new Set<McpInvocationContext.McpCapability>(),
+  issuedAt: 1,
+});
+const client = McpSchema.McpServerClient.of({
+  clientId: 1,
+  clientCapabilities: {},
+  clientInfo: { name: "mcp-test", version: "1.0.0" },
+  protocolVersion: "2025-06-18",
+  initializePayload: {
+    protocolVersion: "2025-06-18",
+    capabilities: {},
+    clientInfo: { name: "mcp-test", version: "1.0.0" },
+  },
+  getClient: Effect.die("unused"),
+});
+
+/** A 2x3 PNG's first bytes: enough for its size. */
+const PNG = Buffer.concat([
+  Buffer.from("89504e470d0a1a0a0000000d49484452", "hex"),
+  Buffer.from([0, 0, 0, 2, 0, 0, 0, 3]),
+]).toString("base64");
+
+/** A helper that answers each call with what a real one would, and records it. */
+const fakeHelper = Effect.acquireRelease(
+  Effect.promise(async () => {
+    const dir = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "t3-plutonium-windows-"));
+    const socketPath = NodePath.join(dir, "helper.sock");
+    const calls: Array<{ readonly path: string; readonly body: unknown }> = [];
+    const server = NodeHttp.createServer((request, response) => {
+      let body = "";
+      request.on("data", (chunk: Buffer) => (body += chunk.toString("utf8")));
+      request.on("end", () => {
+        calls.push({ path: request.url ?? "", body: JSON.parse(body) });
+        const { name } = JSON.parse(body) as { name: string };
+        response.setHeader("Content-Type", "application/json");
+        response.end(
+          JSON.stringify(
+            name === "snapshot_window"
+              ? { content: [{ type: "image", data: PNG, mimeType: "image/png" }] }
+              : name === "type_window"
+                ? { content: [{ type: "text", text: "Can't type 'é'." }], isError: true }
+                : name === "list_tabs"
+                  ? {
+                      content: [
+                        {
+                          type: "text",
+                          text: JSON.stringify([
+                            { id: 41, url: "https://b.test/" },
+                            {
+                              id: 42,
+                              url: "https://a.test/",
+                              pending: { permission: { origin: "https://a.test" } },
+                              state: { inUse: { camera: true } },
+                            },
+                          ]),
+                        },
+                      ],
+                    }
+                  : { content: [{ type: "text", text: '[{"id":3}]' }] },
+          ),
+        );
+      });
+    });
+    await new Promise<void>((resolve) => server.listen(socketPath, resolve));
+    return { dir, server, socketPath, calls };
+  }),
+  ({ dir, server }) =>
+    Effect.promise(
+      () =>
+        new Promise<void>((resolve) =>
+          server.close(() => {
+            NodeFS.rmSync(dir, { recursive: true, force: true });
+            resolve();
+          }),
+        ),
+    ),
+);
+
+const withEnv = (name: string, value: string | undefined) =>
+  Effect.acquireRelease(
+    Effect.sync(() => {
+      const previous = process.env[name];
+      if (value === undefined) delete process.env[name];
+      else process.env[name] = value;
+      return previous;
+    }),
+    (previous) =>
+      Effect.sync(() => {
+        if (previous === undefined) delete process.env[name];
+        else process.env[name] = previous;
+      }),
+  );
+
+const buildServer = Effect.provide(
+  McpServer.McpServer,
+  McpHttpServer.layerPlutoniumWindowToolkit.pipe(
+    Layer.provideMerge(McpHttpServer.layerInProcessMcpServer),
+    Layer.provide(McpToolAccessTestkit.liveThreadsLayer),
+  ),
+);
+
+it.effect("offers the window tools and runs them on the helper for the calling thread", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const helper = yield* fakeHelper;
+      yield* withEnv("PLUTONIUM_HELPER", helper.socketPath);
+      const server = yield* buildServer;
+      const names = server.tools.map(({ tool }) => tool.name);
+      expect(names).toContain("list_windows");
+      expect(names).toContain("snapshot_window");
+      expect(names).toContain("click_window");
+      expect(names).toContain("find_apps");
+      const launch = server.tools.find(({ tool }) => tool.name === "launch_app")!.tool;
+      expect(JSON.stringify(launch.inputSchema)).toContain("use find_apps to get an app's argv");
+      for (const { tool } of server.tools) {
+        expect(tool.inputSchema.type, `inputSchema.type of ${tool.name}`).toBe("object");
+      }
+
+      const call = (name: string, args: Record<string, unknown>, thread = true) =>
+        server
+          .callTool({ name, arguments: args })
+          .pipe(
+            Effect.provideService(McpInvocationContext.McpInvocationContext, invocation(thread)),
+            Effect.provideService(McpSchema.McpServerClient, client),
+          );
+
+      const listed = yield* call("list_windows", {});
+      expect(listed.isError).toBe(false);
+      expect(listed.structuredContent).toEqual({ result: [{ id: 3 }] });
+
+      const shot = yield* call("snapshot_window", { window_id: 3 });
+      expect(shot.isError).toBe(false);
+      expect(shot.content.map((entry) => entry.type)).toEqual(["text", "image"]);
+      expect(shot.structuredContent).toMatchObject({ screenshot: { width: 2, height: 3 } });
+
+      const typed = yield* call("type_window", { window_id: 3, text: "é" });
+      expect(typed.isError).toBe(true);
+      expect(JSON.stringify(typed.content)).toContain("Can't type");
+
+      expect(helper.calls.map((entry) => entry.path)).toEqual(
+        Array(3).fill(`/v1/threads/${encodeURIComponent(`t3:thread/${threadId}`)}/mcp/call`),
+      );
+      expect(helper.calls[1]!.body).toEqual({
+        name: "snapshot_window",
+        arguments: { window_id: 3 },
+      });
+
+      const refused = yield* call("list_windows", {}, false);
+      expect(refused.isError).toBe(true);
+      expect(helper.calls).toHaveLength(3);
+
+      const found = yield* call("find_apps", { filter: "spreadsheet" });
+      expect(found.isError).toBe(false);
+      expect(helper.calls[3]!.body).toEqual({
+        name: "find_apps",
+        arguments: { filter: "spreadsheet" },
+      });
+    }),
+  ),
+);
+
+it.effect("runs the helper's tab tools on the browser's id for T3's tab", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const helper = yield* fakeHelper;
+      yield* withEnv("PLUTONIUM_HELPER", helper.socketPath);
+      const asked: Array<{ readonly tabId?: string | undefined }> = [];
+      const browser = {
+        plutoniumTabId: (input: { readonly tabId?: string | undefined }) =>
+          Effect.sync(() => {
+            asked.push(input);
+            return input.tabId === undefined || input.tabId === "tab-1" ? 42 : null;
+          }),
+      } as unknown as ServerBrowser.ServerBrowser["Service"];
+      const server = yield* buildServer.pipe(
+        Effect.provideService(ServerBrowser.ServerBrowser, browser),
+      );
+      const names = server.tools.map(({ tool }) => tool.name);
+      for (const name of [
+        "tab_requests",
+        "find_in_tab",
+        "answer_permission",
+        "request_permission",
+        "choose_files",
+        "print_tab",
+        "cancel_print",
+        "list_printers",
+        "list_downloads",
+        "download_action",
+      ]) {
+        expect(names).toContain(name);
+      }
+      const call = (name: string, args: Record<string, unknown>) =>
+        server
+          .callTool({ name, arguments: args })
+          .pipe(
+            Effect.provideService(McpInvocationContext.McpInvocationContext, invocation(true)),
+            Effect.provideService(McpSchema.McpServerClient, client),
+          );
+
+      const found = yield* call("find_in_tab", { tabId: "tab-1", text: "hello" });
+      expect(found.isError).toBe(false);
+      expect(helper.calls.at(-1)!.body).toEqual({
+        name: "find_in_tab",
+        arguments: { text: "hello", tab_id: 42 },
+      });
+      expect(asked.at(-1)).toMatchObject({ threadId, tabId: "tab-1" });
+
+      const printed = yield* call("print_tab", { save_to: "~/a.pdf" });
+      expect(printed.isError).toBe(false);
+      expect(helper.calls.at(-1)!.body).toEqual({
+        name: "print_tab",
+        arguments: { save_to: "~/a.pdf", tab_id: 42 },
+      });
+
+      const requests = yield* call("tab_requests", {});
+      expect(requests.structuredContent).toEqual({
+        result: {
+          pending: { permission: { origin: "https://a.test" } },
+          state: { inUse: { camera: true } },
+        },
+      });
+
+      const before = helper.calls.length;
+      const missing = yield* call("answer_permission", { tabId: "tab-9" });
+      expect(missing.isError).toBe(true);
+      expect(JSON.stringify(missing.content)).toContain("No preview tab tab-9");
+      expect(helper.calls).toHaveLength(before);
+
+      yield* call("list_downloads", {});
+      expect(helper.calls.at(-1)!.body).toEqual({ name: "list_downloads", arguments: {} });
+    }),
+  ),
+);
+
+it.effect("offers nothing outside a Plutonium session", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      yield* withEnv("PLUTONIUM_HELPER", undefined);
+      yield* withEnv("PLUTONIUM_WAYLAND_DISPLAY", undefined);
+      const server = yield* buildServer;
+      expect(server.tools).toEqual([]);
+    }),
+  ),
+);
