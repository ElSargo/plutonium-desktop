+// @effect-diagnostics nodeBuiltinImport:off - requests go to the Plutonium helper's Unix socket
+/**
+ * Plutonium: the native window tools (find_apps, launch_app, snapshot_window,
+ * click_window, type_window, ...) on T3 Code's own MCP server, so every
+ * provider's agents can use the apps of their thread. Tabs are T3's preview
+ * tools' already; of the helper's tab tools, those preview tools have no
+ * counterpart for (find, permissions, file pickers, printing, downloads) are
+ * here too, on T3's tab ids: the server finds the browser's id for the tab
+ * (ServerBrowser.plutoniumTabId) and the helper runs the tool on it.
+ *
+ * T3 declares the tools and who may call them, as for its other toolkits:
+ * each acts as the calling thread (`McpToolAccess`). The helper runs them for
+ * that thread (POST /v1/threads/:tag/mcp/call), as its own MCP server does.
+ * McpHttpServer registers them only in a Plutonium session.
+ */
+import { OrchestratorMcpFailure } from "@t3tools/contracts";
+import { plutoniumHelperSocket, plutoniumThreadTag } from "@t3tools/shared/plutonium";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import { Tool, Toolkit } from "effect/ai";
+import * as NodeHttp from "node:http";
+
+import * as McpInvocationContext from "../mcp/McpInvocationContext.ts";
+import * as ServerBrowser from "../preview/ServerBrowser.ts";
+import * as McpToolAccess from "../mcp/McpToolAccess.ts";
+import * as ThreadManagementService from "../orchestration-v2/ThreadManagementService.ts";
+
+/** Whether this server runs in a Plutonium session, with a helper to run the tools. */
+export const available = () => plutoniumHelperSocket() !== undefined;
+
+export class PlutoniumWindowToolError extends Schema.TaggedError<PlutoniumWindowToolError>()(
+  "PlutoniumWindowToolError",
+  { message: Schema.String },
+) {}
+
+const dependencies = [
+  McpInvocationContext.McpInvocationContext,
+  ThreadManagementService.ThreadManagementService,
+];
+
+const WindowToolFailure = Schema.Union([PlutoniumWindowToolError, OrchestratorMcpFailure]);
+
+const WindowToolResult = Schema.Struct({
+  result: Schema.Unknown.annotate({ description: "What the Plutonium helper answered." }),
+});
+
+const windowId = Schema.Int.annotate({
+  description: "A window id from list_windows or launch_app.",
+});
+const coordinate = (axis: string) =>
+  Schema.Number.annotate({
+    description: `${axis} in the window's snapshot_window image, in pixels.`,
+  });
+const point = Schema.Tuple([Schema.Number, Schema.Number]).annotate({ description: "[x, y]" });
+const button = Schema.optional(
+  Schema.Literals(["left", "right", "middle"]).annotate({ description: "Default left." }),
+);
+
+const windowTool = <const Name extends string, P extends Schema.Struct.Fields>(
+  name: Name,
+  description: string,
+  parameters: P,
+  hints: { readonly title: string; readonly destructive?: boolean },
+) =>
+  Tool.make(name, {
+    description,
+    parameters: Schema.Struct(parameters),
+    success: WindowToolResult,
+    failure: WindowToolFailure,
+    dependencies,
+  })
+    .annotate(Tool.Title, hints.title)
+    .annotate(Tool.Readonly, false)
+    .annotate(Tool.Destructive, hints.destructive === true)
+    .annotate(Tool.Idempotent, false)
+    .annotate(Tool.OpenWorld, true);
+
+const ListWindowsTool = Tool.make("list_windows", {
+  description:
+    "List the native desktop app windows that belong to this thread (apps you launched with launch_app or started from this thread's terminals). Each has an id, title, app id, size, whether the user is looking at it, and whether it has keyboard focus; agentSize when it's held at the size you gave it, userControl when the user took control of its size.",
+  // No `parameters`: an empty Schema.Struct serializes to `anyOf: [object, array]`,
+  // which clients reject (see the worktree toolkit).
+  success: WindowToolResult,
+  failure: WindowToolFailure,
+  dependencies,
+})
+  .annotate(Tool.Title, "List app windows")
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false)
+  .annotate(Tool.Idempotent, true)
+  .annotate(Tool.OpenWorld, true);
+
+const FindAppsTool = Tool.make("find_apps", {
+  description:
+    "Find the installed desktop apps (what the user's app launcher shows, Flatpaks included) and how to start them with launch_app. Each has its name, generic name (e.g. \"Spreadsheet\"), desktop id, the argv to pass to launch_app, and where it's installed from (flatpak, nix profile, system or user) with its desktop file, so two installs of one app can be told apart. Every install is listed: one the launcher doesn't show, since another file has its desktop id, names that file (launcherShows). With a filter, also the matching programs on PATH (onPath, mostly command-line ones).",
+  parameters: Schema.Struct({
+    filter: Schema.optional(
+      Schema.String.annotate({
+        description:
+          'A case-insensitive regular expression matched against each app\'s name, generic name, keywords, desktop id and command, e.g. "spreadsheet" or "office" (default: all apps).',
+      }),
+    ),
+  }),
+  success: WindowToolResult,
+  failure: WindowToolFailure,
+  dependencies,
+})
+  .annotate(Tool.Title, "Find apps")
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false)
+  .annotate(Tool.Idempotent, true)
+  .annotate(Tool.OpenWorld, true);
+
+const LaunchAppTool = windowTool(
+  "launch_app",
+  "Start a native desktop (GUI) app, such as LibreOffice, GIMP, Inkscape, a terminal or a file manager, as part of this thread, and wait for its window. find_apps gives an installed app's argv. Drive it with snapshot_window, click_window, type_window and press_window, even while the user is doing something else. The app runs detached from your shell. Its windows wait in the thread for the user unless focus is true. They keep the size you give (width and height) or the one the app picks: the user sees them scaled to fit, and that you're working in them, until they take control. Returns the new windows open once they've stopped changing (a splash screen or a dialog that closes doesn't end the wait; empty if none was open when the wait ran out).",
+  {
+    argv: Schema.Array(Schema.String).annotate({
+      description:
+        "Program and arguments: use find_apps to get an app's argv. argv[0] is looked up on PATH, and installed apps' programs often aren't there under their app names (Flatpaks, for one). No shell is involved.",
+    }),
+    cwd: Schema.optional(
+      Schema.String.annotate({ description: "Working directory (default: your home directory)." }),
+    ),
+    wait_seconds: Schema.optional(
+      Schema.Number.annotate({
+        description:
+          "How long to wait at most for the app's windows to appear and settle (default 10, 0 to not wait).",
+      }),
+    ),
+    width: Schema.optional(
+      Schema.Int.annotate({
+        description: "Window width (with height; default: the app's own), in list_windows' sizes.",
+      }),
+    ),
+    height: Schema.optional(Schema.Int.annotate({ description: "Window height (with width)." })),
+    focus: Schema.optional(
+      Schema.Boolean.annotate({
+        description:
+          "Bring the app's windows to the front (default false). Only when the user asked to see the app, since it takes them away from what they're doing.",
+      }),
+    ),
+  },
+  { title: "Launch app" },
+);
+
+export const SnapshotWindowTool = Tool.make("snapshot_window", {
+  description:
+    "Take a screenshot of one of this thread's app windows, even if the user isn't looking at it: a PNG of the window's contents only. Points for click_window and the other window tools are in this image's pixels. Open menus and other popups are drawn in it where they are (the image grows right and down to hold one that goes past the window) and listed in popups; the window tools reach them.",
+  parameters: Schema.Struct({ window_id: windowId }),
+  success: Schema.Struct({
+    window_id: Schema.Int,
+    screenshot: Schema.Struct({
+      mimeType: Schema.Literal("image/png"),
+      data: Schema.String,
+      width: Schema.Int,
+      height: Schema.Int,
+    }),
+    popups: Schema.optional(
+      Schema.Array(
+        Schema.Struct({ x: Schema.Int, y: Schema.Int, width: Schema.Int, height: Schema.Int }),
+      ).annotate({
+        description: "The window's open menus and other popups, in the image's pixels.",
+      }),
+    ),
+  }),
+  failure: WindowToolFailure,
+  dependencies,
+})
+  .annotate(Tool.Title, "Screenshot app window")
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false)
+  .annotate(Tool.Idempotent, true)
+  .annotate(Tool.OpenWorld, true);
+
+const ClickWindowTool = windowTool(
+  "click_window",
+  "Click in one of this thread's app windows at a point of its snapshot_window image. The app gets the click even if the user isn't looking at it, and the user's own pointer and keyboard stay where they are. A click on an open menu goes to the menu; one outside it closes the menu, as for a user, and goes no further. Returns the windows that opened (newWindows: a dialog, or one that came after your last action) or closed, and the window's open popups. Take a new snapshot to see what happened.",
+  {
+    window_id: windowId,
+    x: coordinate("x"),
+    y: coordinate("y"),
+    button,
+    count: Schema.optional(
+      Schema.Literals([1, 2, 3]).annotate({ description: "2 for a double click (default 1)." }),
+    ),
+  },
+  { title: "Click in app window" },
+);
+
+const HoverWindowTool = windowTool(
+  "hover_window",
+  "Move the pointer to a point in one of this thread's app windows (for tooltips and hover menus).",
+  { window_id: windowId, x: coordinate("x"), y: coordinate("y") },
+  { title: "Hover in app window" },
+);
+
+const DragWindowTool = windowTool(
+  "drag_window",
+  "Press at one point of one of this thread's app windows, move to another and release there: to draw, select, or move things.",
+  { window_id: windowId, from: point, to: point, button },
+  { title: "Drag in app window" },
+);
+
+const ScrollWindowTool = windowTool(
+  "scroll_window",
+  "Turn the mouse wheel over a point in one of this thread's app windows.",
+  {
+    window_id: windowId,
+    x: coordinate("x"),
+    y: coordinate("y"),
+    dy: Schema.optional(
+      Schema.Number.annotate({ description: "Wheel notches down (negative: up)." }),
+    ),
+    dx: Schema.optional(
+      Schema.Number.annotate({ description: "Wheel notches right (negative: left)." }),
+    ),
+  },
+  { title: "Scroll in app window" },
+);
+
+const TypeWindowTool = windowTool(
+  "type_window",
+  "Type text into one of this thread's app windows, as from a keyboard, into whatever in the window has the keyboard (click a field first). The window gets the keys even if the user is typing elsewhere. Keys are a US keyboard's: other characters are refused. A newline presses Enter; after an Enter that should move the focus (a toolbar box, a dialog field), click where the next text goes.",
+  { window_id: windowId, text: Schema.String },
+  { title: "Type in app window" },
+);
+
+const PressWindowTool = windowTool(
+  "press_window",
+  'Press keys in one of this thread\'s app windows: "Enter", "Escape", "ctrl+s", "ctrl+shift+t", "alt+F4", "Down", "ctrl+]", or a list of them pressed in turn. Returns the windows that opened (newWindows: a dialog, or one that came after your last action) or closed, and the window\'s open popups (menus).',
+  {
+    window_id: windowId,
+    keys: Schema.Union([Schema.String, Schema.Array(Schema.String)]).annotate({
+      description: "A key combination, or a list of them.",
+    }),
+  },
+  { title: "Press keys in app window" },
+);
+
+const ResizeWindowTool = windowTool(
+  "resize_window",
+  "Ask the app to resize one of this thread's windows (in the sizes list_windows gives). It keeps that size while the user looks at it (scaled to fit), unless they took control of its size. Returns the size the app took.",
+  { window_id: windowId, width: Schema.Int, height: Schema.Int },
+  { title: "Resize app window" },
+);
+
+const ReadWindowTool = Tool.make("read_window", {
+  description:
+    "Read one of this thread's app windows as an accessibility tree, when the app has one (GTK, Qt, LibreOffice and most desktop apps; not terminals or games): each element's role, name, states, text, its center in snapshot_window's pixels (@x,y) and a ref for act_window. Better than a snapshot for reading text and finding controls. Hidden elements are left out unless all is true; ref reads one element and what's in it. A big table (a spreadsheet's sheet) gives its size and its visible cells that have text or focus: scroll the window to read others. When the app doesn't answer, it says so and whether the app is still running.",
+  parameters: Schema.Struct({
+    window_id: windowId,
+    ref: Schema.optional(
+      Schema.String.annotate({
+        description: 'An element\'s ref from read_window (e.g. "a12"), to read only that part.',
+      }),
+    ),
+    all: Schema.optional(
+      Schema.Boolean.annotate({ description: "Include hidden elements (default false)." }),
+    ),
+  }),
+  success: WindowToolResult,
+  failure: WindowToolFailure,
+  dependencies,
+})
+  .annotate(Tool.Title, "Read app window")
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false)
+  .annotate(Tool.Idempotent, true)
+  .annotate(Tool.OpenWorld, true);
+
