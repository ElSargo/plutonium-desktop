@@ -0,0 +1,575 @@
+// @effect-diagnostics nodeBuiltinImport:off globalTimers:off - the Plutonium helper is a Unix socket, read from Node callbacks
+/**
+ * Plutonium: native windows as server tabs, for every T3 client.
+ *
+ * Each window the helper lists under a thread (its first `t3:thread/` tag)
+ * is one of that thread's preview tabs, `runtime: "server"`, so any client
+ * that lists and streams server tabs (the mobile app, the desktop app, a
+ * browser elsewhere) gets it as it gets a page:
+ *
+ * - The list: `PreviewManager.syncPlutoniumWindows`, from the helper's
+ *   `GET /v1/windows` each second. The tab's address is `app://<app id>`, its
+ *   title the window's. Agents' preview tools and the server's browser don't
+ *   see these tabs (`PreviewManager.list` leaves them out).
+ * - The stream: `/api/preview-stream/ws` with the window's tab id comes here
+ *   (`attachWindowViewer`): the helper's frames (`GET /v1/windows/:id/stream`)
+ *   as the viewer's frames, the window's size in DIPs as its viewport, and the
+ *   viewer's input as the helper's (`POST /v1/windows/:id/{mouse,keys,text}`).
+ *   One viewer at a time has control, as with a page.
+ * - Closing the tab asks the app to close the window (`closeWindow`).
+ */
+import { plutoniumHelperSocket } from "@t3tools/shared/plutonium";
+import { plutoniumWindowTabId } from "@t3tools/shared/plutoniumWindowTabs";
+import { ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Queue from "effect/Queue";
+import * as Schedule from "effect/Schedule";
+import * as Schema from "effect/Schema";
+import * as NodeCrypto from "node:crypto";
+import * as NodeHttp from "node:http";
+
+import * as PreviewManager from "../preview/Manager.ts";
+import type { ServerBrowserViewer, ServerBrowserViewerOutput } from "../preview/ServerBrowser.ts";
+import { forkParked } from "../serverActivation.ts";
+
+const LIST_INTERVAL = "1 second";
+const REQUEST_TIMEOUT_MS = 10_000;
+const FRAME_HEADER_BYTES = 8;
+/** Frames sent and not yet acknowledged; a newer frame replaces one waiting behind them. */
+const MAX_FRAMES_IN_FLIGHT = 2;
+const VIEWER_OUTPUT_LIMIT = 64;
+/** Pixels of a viewer's wheel or touch pan that make one wheel notch. */
+const WHEEL_PX_PER_NOTCH = 100;
+const THREAD_TAG_PREFIX = "t3:thread/";
+
+/** A window as the helper lists it (helper/src/relay.ts, NativeWindowEntry). */
+export interface HelperWindow {
+  readonly id: number;
+  readonly appId: string;
+  readonly title: string;
+  /** DIPs. */
+  readonly width: number;
+  readonly height: number;
+  readonly pid: number;
+  readonly tags?: ReadonlyArray<string>;
+}
+
+export class PlutoniumWindowGoneError extends Schema.TaggedError<PlutoniumWindowGoneError>()(
+  "PlutoniumWindowGoneError",
+  { windowId: Schema.Number },
+) {}
+
+/** The thread a window belongs to: its first T3 thread tag's. */
+export const windowThread = (window: HelperWindow): string | null => {
+  const tag = (window.tags ?? []).find((each) => each.startsWith(THREAD_TAG_PREFIX));
+  return tag ? tag.slice(THREAD_TAG_PREFIX.length) || null : null;
+};
+
+/** The helper's window list as the threads' window tabs. */
+export const windowTabs = (
+  windows: ReadonlyArray<HelperWindow>,
+): Array<PreviewManager.PlutoniumWindowTabInput> =>
+  windows.flatMap((window) => {
+    const threadId = windowThread(window);
+    if (threadId === null) return [];
+    const app = window.appId.trim() || "window";
+    return [
+      {
+        threadId: ThreadId.make(threadId),
+        tabId: plutoniumWindowTabId(window.id, window.pid),
+        url: `app://${app}`.slice(0, 2048),
+        title: (window.title.trim() || app).slice(0, 512),
+      },
+    ];
+  });
+
+/** Splits the helper's frame stream (helper/src/windowStream.ts) into JPEGs and their size. */
+export class FrameReader {
+  private pending: Buffer = Buffer.alloc(0);
+
+  push(chunk: Buffer): Array<{ data: Buffer; width: number; height: number }> {
+    this.pending = this.pending.length > 0 ? Buffer.concat([this.pending, chunk]) : chunk;
+    const frames = [];
+    while (this.pending.length >= FRAME_HEADER_BYTES) {
+      const length = this.pending.readUInt32BE(0);
+      if (this.pending.length < FRAME_HEADER_BYTES + length) break;
+      frames.push({
+        width: this.pending.readUInt16BE(4),
+        height: this.pending.readUInt16BE(6),
+        data: this.pending.subarray(FRAME_HEADER_BYTES, FRAME_HEADER_BYTES + length),
+      });
+      this.pending = this.pending.subarray(FRAME_HEADER_BYTES + length);
+    }
+    return frames;
+  }
+}
+
+/** A request to the helper: its status and body. */
+const helperRequest = (
+  socketPath: string,
+  method: "GET" | "POST",
+  path: string,
+  body?: unknown,
+): Promise<{ readonly status: number; readonly text: string }> =>
+  new Promise((resolve, reject) => {
+    const request = NodeHttp.request(
+      {
+        socketPath,
+        method,
+        path,
+        timeout: REQUEST_TIMEOUT_MS,
+        headers: body === undefined ? {} : { "Content-Type": "application/json" },
+      },
+      (response) => {
+        let text = "";
+        response.setEncoding("utf8");
+        response.on("data", (chunk: string) => (text += chunk));
+        response.on("end", () => resolve({ status: response.statusCode ?? 500, text }));
+      },
+    );
+    request.on("timeout", () => request.destroy(new Error("timed out")));
+    request.on("error", reject);
+    request.end(body === undefined ? undefined : JSON.stringify(body));
+  });
+
+const listWindows = async (socketPath: string): Promise<Array<HelperWindow>> => {
+  const { status, text } = await helperRequest(socketPath, "GET", "/v1/windows");
+  if (status !== 200) throw new Error(`The helper said ${status}.`);
+  const windows: unknown = JSON.parse(text);
+  return Array.isArray(windows) ? (windows as Array<HelperWindow>) : [];
+};
+
+// --- Input ------------------------------------------------------------------
+
+/** The helper's input for one viewer message. */
+export type WindowInput =
+  | { readonly path: "mouse"; readonly body: Record<string, unknown> }
+  | { readonly path: "keys"; readonly body: { readonly events: ReadonlyArray<unknown> } }
+  | { readonly path: "text"; readonly body: { readonly text: string } };
+
+const MOUSE_TYPES = { move: "mouseMoved", down: "mousePressed", up: "mouseReleased" } as const;
+const MOUSE_BUTTONS = new Set(["none", "left", "middle", "right", "back", "forward"]);
+/** Keys a soft keyboard sends without a `code`, whose `key` names the physical key. */
+const NAMED_KEYS = new Set([
+  "Backspace",
+  "Delete",
+  "Enter",
+  "Tab",
+  "Escape",
+  "ArrowLeft",
+  "ArrowRight",
+  "ArrowUp",
+  "ArrowDown",
+  "Home",
+  "End",
+  "PageUp",
+  "PageDown",
+  "Insert",
+]);
+
+const finite = (value: unknown): value is number =>
+  typeof value === "number" && Number.isFinite(value);
+const int = (value: unknown) => (finite(value) ? Math.round(value) : 0);
+
+/**
+ * Turns a viewer's input into the helper's, keeping what it needs between
+ * messages (wheel remainders, keys and buttons held). Messages for pages
+ * only (navigation, resizing, dialogs) are none.
+ */
+export class WindowInputTranslator {
+  private wheelX = 0;
+  private wheelY = 0;
+  /** Codes held down, so losing control releases them. */
+  readonly heldKeys = new Set<string>();
+  /** Buttons held, and where, so losing control releases them. */
+  readonly heldButtons = new Map<string, { x: number; y: number }>();
+
+  translate(message: Record<string, unknown>): Array<WindowInput> {
+    switch (message.type) {
+      case "mouse": {
+        const type = MOUSE_TYPES[message.action as keyof typeof MOUSE_TYPES];
+        if (!type || !finite(message.x) || !finite(message.y)) return [];
+        const button =
+          typeof message.button === "string" && MOUSE_BUTTONS.has(message.button)
+            ? message.button
+            : "none";
+        if (type === "mousePressed" && button !== "none")
+          this.heldButtons.set(button, { x: message.x, y: message.y });
+        if (type === "mouseReleased") this.heldButtons.delete(button);
+        return [
+          {
+            path: "mouse",
+            body: {
+              type,
+              x: message.x,
+              y: message.y,
+              button,
+              buttons: int(message.buttons),
+              clickCount: int(message.clickCount),
+              modifiers: int(message.modifiers),
+            },
+          },
+        ];
+      }
+      case "wheel": {
+        if (!finite(message.x) || !finite(message.y)) return [];
+        // Touch pans come as many small deltas; the helper takes whole notches.
+        this.wheelX += finite(message.deltaX) ? message.deltaX : 0;
+        this.wheelY += finite(message.deltaY) ? message.deltaY : 0;
+        const deltaX = Math.trunc(this.wheelX / WHEEL_PX_PER_NOTCH);
+        const deltaY = Math.trunc(this.wheelY / WHEEL_PX_PER_NOTCH);
+        if (deltaX === 0 && deltaY === 0) return [];
+        this.wheelX -= deltaX * WHEEL_PX_PER_NOTCH;
+        this.wheelY -= deltaY * WHEEL_PX_PER_NOTCH;
+        return [
+          {
+            path: "mouse",
+            body: {
+              type: "mouseWheel",
+              x: message.x,
+              y: message.y,
+              deltaX,
+              deltaY,
+              modifiers: int(message.modifiers),
+            },
+          },
+        ];
+      }
+      case "key": {
+        const down = message.action === "down";
+        if (!down && message.action !== "up") return [];
+        const key = typeof message.key === "string" ? message.key : "";
+        const code =
+          typeof message.code === "string" && message.code.length > 0
+            ? message.code
+            : NAMED_KEYS.has(key)
+              ? key
+              : key === " "
+                ? "Space"
+                : "";
+        if (code === "") {
+          // A soft keyboard's key with no physical key: its text, typed.
+          const text = typeof message.text === "string" ? message.text : "";
+          return down && text.length > 0 ? [{ path: "text", body: { text } }] : [];
+        }
+        if (down) this.heldKeys.add(code);
+        else this.heldKeys.delete(code);
+        return [
+          {
+            path: "keys",
+            body: {
+              events: [
+                { type: down ? "keyDown" : "keyUp", code, modifiers: int(message.modifiers) },
+              ],
+            },
+          },
+        ];
+      }
+      case "text":
+        return typeof message.text === "string" && message.text.length > 0
+          ? [{ path: "text", body: { text: message.text } }]
+          : [];
+      default:
+        return [];
+    }
+  }
+
+  /** Releases what is held: the viewer lost control, or left. */
+  release(): Array<WindowInput> {
+    const inputs: Array<WindowInput> = [];
+    for (const [button, at] of this.heldButtons) {
+      inputs.push({
+        path: "mouse",
+        body: { type: "mouseReleased", ...at, button, buttons: 0, clickCount: 1 },
+      });
+    }
+    if (this.heldKeys.size > 0) {
+      inputs.push({
+        path: "keys",
+        body: { events: [...this.heldKeys].map((code) => ({ type: "keyUp", code })) },
+      });
+    }
+    this.heldButtons.clear();
+    this.heldKeys.clear();
+    this.wheelX = this.wheelY = 0;
+    return inputs;
+  }
+}
+
+// --- Control ----------------------------------------------------------------
+
+interface WindowViewerState {
+  readonly id: string;
+  readonly canOperate: boolean;
+  readonly push: (output: ServerBrowserViewerOutput) => void;
+  /** Releases what the viewer holds, when it loses control. */
+  readonly release: () => void;
+}
+
+interface WindowControl {
+  controller: string | null;
+  generation: number;
+  readonly viewers: Map<string, WindowViewerState>;
+}
+
+/** Who controls each window's tab, by tab id. */
+const controls = new Map<string, WindowControl>();
+
+const broadcastControl = (control: WindowControl) => {
+  for (const viewer of control.viewers.values()) {
+    viewer.push({
+      _tag: "control",
+      canOperate: viewer.canOperate,
+      controller:
+        control.controller === viewer.id
+          ? "you"
+          : control.controller !== null
+            ? "another-viewer"
+            : "unclaimed",
+      generation: control.generation,
+      dialog: null,
+    });
+  }
+};
+
+const setController = (control: WindowControl, controller: string | null) => {
+  if (control.controller === controller) return;
+  const previous =
+    control.controller === null ? undefined : control.viewers.get(control.controller);
+  previous?.release();
+  control.controller = controller;
+  control.generation += 1;
+  broadcastControl(control);
+};
+
+// --- Viewing ----------------------------------------------------------------
+
+/**
+ * A viewer of native window `windowId` (drawn by `pid`) in thread
+ * `threadId`'s tab, in the protocol of `ServerBrowser.attachViewer`.
+ */
+export const attachWindowViewer = Effect.fn("PlutoniumWindowTabs.attachWindowViewer")(
+  function* (input: {
+    readonly threadId: string;
+    readonly tabId: string;
+    readonly windowId: number;
+    readonly pid: number;
+    readonly maxWidth: number;
+    readonly maxHeight: number;
+    readonly quality: number;
+    readonly canOperate: boolean;
+  }) {
+    const runSync = Effect.runSyncWith(yield* Effect.context<never>());
+    const gone = new PlutoniumWindowGoneError({ windowId: input.windowId });
+    const socketPath = plutoniumHelperSocket();
+    if (socketPath === undefined) return yield* gone;
+    const findWindow = () =>
+      listWindows(socketPath).then((windows) =>
+        windows.find(
+          (window) =>
+            window.id === input.windowId &&
+            window.pid === input.pid &&
+            windowThread(window) === input.threadId,
+        ),
+      );
+    const found = yield* Effect.promise(() => findWindow().catch(() => undefined));
+    if (found === undefined) return yield* gone;
+
+    const output = yield* Queue.make<ServerBrowserViewerOutput>({
+      capacity: VIEWER_OUTPUT_LIMIT,
+      strategy: "dropping",
+    });
+    const push = (next: ServerBrowserViewerOutput) => {
+      if (Queue.offerUnsafe(output, next)) return true;
+      // A stalled viewer must not miss who controls it, or that the window went.
+      if (next._tag === "control" || next._tag === "gone") {
+        // Dropped frames count as seen, or pacing would wait for them.
+        for (const item of runSync(Queue.clear(output)))
+          if (item._tag === "frame") runSync(item.ack);
+        return Queue.offerUnsafe(output, next);
+      }
+      return false;
+    };
+
+    // Input goes to the helper in order, one request at a time.
+    let inputs: Promise<unknown> = Promise.resolve();
+    const send = (each: WindowInput) => {
+      inputs = inputs
+        .then(() =>
+          helperRequest(
+            socketPath,
+            "POST",
+            `/v1/windows/${input.windowId}/${each.path}`,
+            each.body,
+          ),
+        )
+        .catch(() => {});
+      return inputs;
+    };
+    const translator = new WindowInputTranslator();
+
+    let control = controls.get(input.tabId);
+    if (!control) {
+      control = { controller: null, generation: 0, viewers: new Map() };
+      controls.set(input.tabId, control);
+    }
+    const windowControl = control;
+    const viewer: WindowViewerState = {
+      id: NodeCrypto.randomUUID(),
+      canOperate: input.canOperate,
+      push: (next) => void push(next),
+      release: () => {
+        for (const each of translator.release()) void send(each);
+      },
+    };
+    yield* Effect.acquireRelease(
+      Effect.sync(() => windowControl.viewers.set(viewer.id, viewer)),
+      () =>
+        Effect.sync(() => {
+          if (windowControl.controller === viewer.id) setController(windowControl, null);
+          windowControl.viewers.delete(viewer.id);
+          if (windowControl.viewers.size === 0) controls.delete(input.tabId);
+        }),
+    );
+
+    // The window's size in DIPs maps the viewer's points to the window's.
+    let viewport = { width: found.width, height: found.height };
+    push({ _tag: "viewport", ...viewport });
+    const remeasure = () =>
+      void findWindow()
+        .then((window) => {
+          if (!window || (window.width === viewport.width && window.height === viewport.height))
+            return;
+          viewport = { width: window.width, height: window.height };
+          push({ _tag: "viewport", ...viewport });
+        })
+        .catch(() => {});
+
+    if (input.canOperate && windowControl.controller === null)
+      setController(windowControl, viewer.id);
+    else broadcastControl(windowControl);
+
+    // Frames, paced by the viewer's acks: a newer frame replaces one still waiting.
+    let inFlight = 0;
+    let waiting: Buffer | null = null;
+    let shape = "";
+    const deliver = (data: Buffer) => {
+      inFlight += 1;
+      if (!push({ _tag: "frame", data, ack: Effect.sync(acknowledged) })) inFlight -= 1;
+    };
+    const acknowledged = () => {
+      inFlight = Math.max(0, inFlight - 1);
+      if (waiting !== null && inFlight < MAX_FRAMES_IN_FLIGHT) {
+        const next = waiting;
+        waiting = null;
+        deliver(next);
+      }
+    };
+    const reader = new FrameReader();
+    const query = new URLSearchParams({
+      maxWidth: String(input.maxWidth),
+      maxHeight: String(input.maxHeight),
+      quality: String(input.quality),
+    });
+    yield* Effect.acquireRelease(
+      Effect.sync(() => {
+        const request = NodeHttp.request(
+          {
+            socketPath,
+            method: "GET",
+            path: `/v1/windows/${input.windowId}/stream?${query.toString()}`,
+          },
+          (response) => {
+            if (response.statusCode !== 200) {
+              response.resume();
+              push({ _tag: "gone" });
+              return;
+            }
+            response.on("data", (chunk: Buffer) => {
+              for (const frame of reader.push(chunk)) {
+                // A resized window: its new size, for mapping input.
+                const next = `${frame.width}x${frame.height}`;
+                if (next !== shape) {
+                  if (shape !== "") remeasure();
+                  shape = next;
+                }
+                if (inFlight < MAX_FRAMES_IN_FLIGHT) deliver(frame.data);
+                else waiting = frame.data;
+              }
+            });
+            response.on("end", () => push({ _tag: "gone" }));
+          },
+        );
+        request.on("error", () => push({ _tag: "gone" }));
+        request.end();
+        return request;
+      }),
+      (request) => Effect.sync(() => request.destroy()),
+    );
+
+    return {
+      output,
+      input: (raw: unknown) =>
+        Effect.promise(async () => {
+          if (!viewer.canOperate || typeof raw !== "object" || raw === null) return;
+          const message = raw as Record<string, unknown>;
+          if (message.type === "takeControl") return setController(windowControl, viewer.id);
+          if (message.type === "releaseControl") {
+            if (windowControl.controller === viewer.id) setController(windowControl, null);
+            return;
+          }
+          if (windowControl.controller !== viewer.id) return;
+          if (message.type === "probe") {
+            // Whether a point takes text isn't known for a native window: any
+            // may, so a touch viewer raises its keyboard.
+            if (finite(message.x) && finite(message.y))
+              push({ _tag: "probe", x: message.x, y: message.y, editable: true });
+            return;
+          }
+          for (const each of translator.translate(message)) await send(each);
+        }),
+    } satisfies ServerBrowserViewer;
+  },
+);
+
+/** Asks the app to close the window, as its close button does, if it's still that process's. */
+export const closeWindow = (window: { readonly windowId: number; readonly pid: number }) =>
+  Effect.promise(async () => {
+    const socketPath = plutoniumHelperSocket();
+    if (socketPath === undefined) return;
+    try {
+      const windows = await listWindows(socketPath);
+      if (!windows.some((each) => each.id === window.windowId && each.pid === window.pid)) return;
+      await helperRequest(socketPath, "POST", `/v1/windows/${window.windowId}/close`);
+    } catch {
+      // No helper: nothing to close.
+    }
+  });
+
+// --- The list ---------------------------------------------------------------
+
+/** Keeps the threads' window tabs in step with the helper's windows, while Plutonium runs. */
+export const layer = process.env.PLUTONIUM_T3
+  ? Layer.effectDiscard(
+      Effect.gen(function* () {
+        const socketPath = plutoniumHelperSocket();
+        if (socketPath === undefined) return;
+        const manager = yield* PreviewManager.PreviewManager;
+        let last = "";
+        const sync = Effect.promise(() =>
+          listWindows(socketPath).then(windowTabs, () => null),
+        ).pipe(
+          Effect.flatMap((tabs) => {
+            // No helper: the tabs stay as they were until it answers again.
+            if (tabs === null) return Effect.void;
+            const key = JSON.stringify(tabs);
+            if (key === last) return Effect.void;
+            last = key;
+            return manager.syncPlutoniumWindows(tabs);
+          }),
+        );
+        yield* forkParked(sync.pipe(Effect.repeat(Schedule.spaced(LIST_INTERVAL))));
+      }),
+    )
+  : Layer.empty;
