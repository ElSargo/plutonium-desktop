+
+  it("keeps a tab in the last dock scope tag it has", () => {
+    expect(scopeOfTags(["t3:thread/a"])).toBe("thread");
+    expect(scopeOfTags(["t3:thread/a", "t3:global"])).toBe("global");
+    expect(scopeOfTags(["t3:global", "t3:thread/b", "t3:project/p"])).toBe("project");
+    expect(isDockScopeTag("t3:global")).toBe(true);
