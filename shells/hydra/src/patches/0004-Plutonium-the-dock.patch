+
+  it("doesn't hold the tabs its tab opens", () => {
+    const docked = tab(1, "https://github.com/a/b", ["t3:thread/a", TAG]);
+    // A page's new tab starts with its opener's tags.
+    const popup = tab(2, "https://github.com/login", ["t3:thread/a", TAG], 1);
+    const world = worldOf([], [docked, popup], { 1: ["a", "s-1"], 2: ["a", "s-2"] });
