@@ -0,0 +1,1114 @@
+// Plutonium: the dock. Nine slots on Super+1…9, each T3's terminal drawer, an
+// app or a site, kept per thread, per project or everywhere. A slot's key
+// starts what it names, shows it, gives it the keyboard, and goes back to
+// where you were when pressed again (plutonium-desktop
+// docs/features/HYDRA_DOCK.md).
+//
+// A slot holds one window or tab, not every one that looks like it: the one
+// put in it carries the slot's tag (t3:dock/<slot id>). A scope is a tag too:
+// the slot's thing in a thread is the one with the slot's tag and the scope's
+// (the thread's, the project's or t3:global), so a slot kept per thread has
+// one in each thread. With none, the key starts the app or opens the site,
+// and tags what that made. An app started for a slot runs with its scope's
+// tag as PLUTONIUM_THREAD_ID, so its windows carry it. A site's tab kept per
+// project or everywhere moves to the thread whose key asks for it
+// (previewBridge.ts).
+import type { EnvironmentId, ScopedThreadRef, ThreadId } from "@t3tools/contracts";
+import { scopedThreadKey } from "@t3tools/client-runtime/environment";
+import { useSyncExternalStore } from "react";
+import { create } from "zustand";
+import { createJSONStorage, persist } from "zustand/middleware";
+
+import { previewRuntimeTabId } from "~/browser/previewRuntimeTabId";
+import { toastManager } from "~/components/ui/toast";
+import { randomUUID } from "~/lib/utils";
+import { resolveStorage } from "~/lib/storage";
+import { readThreadPreviewState } from "~/previewStateStore";
+import { type RightPanelSurface, useRightPanelStore } from "~/rightPanelStore";
+
+import { focusRightPanelSurface } from "./panelKeys";
+import { type BrokerTab, plutoniumPreview, tabTags } from "./previewBridge";
+import { dockSlotTag, GLOBAL_TAG, isDockScopeTag, isDockSlotTag, projectTag } from "./threadTag";
+import {
+  type NativeWindowEntry,
+  plutoniumShell,
+  threadTag,
+  usePlutoniumWindowStore,
+  windowTags,
+} from "./windowStore";
+
+export const DOCK_SLOT_NUMBERS = [1, 2, 3, 4, 5, 6, 7, 8, 9] as const;
+export type DockSlotNumber = (typeof DOCK_SLOT_NUMBERS)[number];
+
+export type DockScope = "thread" | "project" | "global";
+export type DockLayout = "split" | "fold";
+
+export type DockTarget =
+  /** T3's terminal drawer, below the chat. */
+  | { readonly kind: "terminal" }
+  | {
+      readonly kind: "app";
+      /** The desktop entry that starts it; null if none was found (it can't be started). */
+      readonly desktopId: string | null;
+      /** Its windows' app id, once seen. */
+      readonly windowAppId: string | null;
+      readonly name: string;
+    }
+  | {
+      readonly kind: "site";
+      /** Where a new tab for it opens. */
+      readonly url: string;
+      readonly name: string;
+      /** The site's icon (a data URL) as a tab showed it, for when none is open. */
+      readonly icon?: string;
+    };
+
+export interface DockSlot {
+  /** What the slot's things are tagged with (dockSlotTag); new when it names something else. */
+  readonly id: string;
+  readonly target: DockTarget;
+  readonly scope: DockScope;
+  readonly layout: DockLayout;
+}
+
+export type DockSlots = Partial<Record<DockSlotNumber, DockSlot>>;
+
+/** A new slot id. */
+export function newDockSlotId(): string {
+  return randomUUID().replaceAll("-", "").slice(0, 12);
+}
+
+const DEFAULT_SLOTS: DockSlots = {
+  1: { id: newDockSlotId(), target: { kind: "terminal" }, scope: "thread", layout: "split" },
+};
+
+/**
+ * Slots as stored before slots held one thing each (version 1): they get an
+ * id, and a site loses the prefix its tabs started with. Nothing carries the
+ * new id yet: the slot's thing is the next one put in it, or the next one its
+ * key opens.
+ */
+export function migrateDockSlots(slots: unknown): DockSlots {
+  if (!slots || typeof slots !== "object") return DEFAULT_SLOTS;
+  const migrated: DockSlots = {};
+  for (const [key, value] of Object.entries(slots as Record<string, unknown>)) {
+    const number = Number(key);
+    if (!DOCK_SLOT_NUMBERS.includes(number as DockSlotNumber)) continue;
+    if (!value || typeof value !== "object") continue;
+    const slot = value as DockSlot & { target: DockTarget & { match?: string } };
+    if (!slot.target || typeof slot.target !== "object") continue;
+    const { match: _match, ...target } = slot.target;
+    migrated[number as DockSlotNumber] = {
+      ...slot,
+      id: typeof slot.id === "string" && slot.id ? slot.id : newDockSlotId(),
+      target: target as DockTarget,
+    };
+  }
+  return migrated;
+}
+
+/** Where a slot's key came from, to go back to on the next press. */
+interface ReturnPoint {
+  readonly slot: DockSlotNumber;
+  readonly panelOpen: boolean;
+  readonly activeSurfaceId: string | null;
+  readonly maximized: boolean;
+  readonly terminalOpen: boolean;
+  readonly terminalFolded: boolean;
+}
+
+interface DockState {
+  readonly slots: DockSlots;
+  /** A thread's own layout for a slot (Super+Up), by thread key, then slot. */
+  readonly layouts: Readonly<Record<string, Partial<Record<DockSlotNumber, DockLayout>>>>;
+  /** Threads whose terminal drawer has the chat column to itself, by thread key. */
+  readonly terminalFolded: Readonly<Record<string, true>>;
+  /** The slot last raised in each thread and what was showing before, by thread key. */
+  readonly returnTo: Readonly<Record<string, ReturnPoint>>;
+  setSlot(slot: DockSlotNumber, value: DockSlot | null): void;
+  setThreadLayout(threadKey: string, slot: DockSlotNumber, layout: DockLayout): void;
+  /** The thread goes back to the slot's own layout. */
+  clearThreadLayout(threadKey: string, slot: DockSlotNumber): void;
+  setTerminalFolded(threadKey: string, folded: boolean): void;
+  setReturnTo(threadKey: string, point: ReturnPoint | null): void;
+}
+
+export const useDockStore = create<DockState>()(
+  persist(
+    (set) => ({
+      slots: DEFAULT_SLOTS,
+      layouts: {},
+      terminalFolded: {},
+      returnTo: {},
+      setSlot: (slot, value) =>
+        set((state) => {
+          const slots = { ...state.slots };
+          if (value) slots[slot] = value;
+          else delete slots[slot];
+          return { slots };
+        }),
+      setThreadLayout: (threadKey, slot, layout) =>
+        set((state) => ({
+          layouts: {
+            ...state.layouts,
+            [threadKey]: { ...state.layouts[threadKey], [slot]: layout },
+          },
+        })),
+      clearThreadLayout: (threadKey, slot) =>
+        set((state) => {
+          const own = state.layouts[threadKey];
+          if (!own || own[slot] === undefined) return state;
+          const next = { ...own };
+          delete next[slot];
+          return { layouts: { ...state.layouts, [threadKey]: next } };
+        }),
+      setTerminalFolded: (threadKey, folded) =>
+        set((state) => {
+          if (Boolean(state.terminalFolded[threadKey]) === folded) return state;
+          const terminalFolded = { ...state.terminalFolded };
+          if (folded) terminalFolded[threadKey] = true;
+          else delete terminalFolded[threadKey];
+          return { terminalFolded };
+        }),
+      setReturnTo: (threadKey, point) =>
+        set((state) => {
+          const returnTo = { ...state.returnTo };
+          if (point) returnTo[threadKey] = point;
+          else delete returnTo[threadKey];
+          return { returnTo };
+        }),
+    }),
+    {
+      name: "t3code:plutonium-dock:v1",
+      version: 2,
+      migrate: (persisted, version) => {
+        const state = (persisted ?? {}) as Record<string, unknown>;
+        return version < 2 ? { ...state, slots: migrateDockSlots(state.slots) } : state;
+      },
+      storage: createJSONStorage(() =>
+        resolveStorage(typeof window !== "undefined" ? window.localStorage : undefined),
+      ),
+      // Where to go back to only holds while the page lives.
+      partialize: (state) => ({
+        slots: state.slots,
+        layouts: state.layouts,
+        terminalFolded: state.terminalFolded,
+      }),
+    },
+  ),
+);
+
+/** Whether `threadRef`'s terminal drawer has the chat column to itself. */
+export function useTerminalFolded(threadRef: ScopedThreadRef | null): boolean {
+  const key = threadRef ? scopedThreadKey(threadRef) : null;
+  return useDockStore((state) => (key ? state.terminalFolded[key] === true : false));
+}
+
+/** What ChatView lends the dock: the active thread and its panel and terminal. */
+export interface DockContext {
+  readonly threadRef: ScopedThreadRef;
+  readonly projectId: string | null;
+  readonly surfaces: readonly RightPanelSurface[];
+  readonly activeSurfaceId: string | null;
+  readonly panelOpen: boolean;
+  readonly maximized: boolean;
+  readonly terminalOpen: boolean;
+  /** Opens the terminal drawer (starting a terminal if there is none) and focuses it. */
+  readonly openTerminal: () => void;
+  readonly closeTerminal: () => void;
+  readonly focusTerminal: () => void;
+  readonly focusComposer: () => void;
+  readonly activate: (surface: RightPanelSurface) => void;
+  /** Opens a browser tab at `url` in the thread's panel. */
+  readonly openSite: (url: string) => Promise<void>;
+  /** Shows browser tab `tab` as a new tab of the thread's panel; its server tab id, or null. */
+  readonly showTab: (tab: BrokerTab) => Promise<string | null>;
+  /** Closes another thread's preview tab `tabId` (its browser tab has moved here). */
+  readonly closePreview: (threadRef: ScopedThreadRef, tabId: string) => Promise<void>;
+}
+
+/** The tag a slot's things carry in `context`'s thread, or null (a project slot with no project). */
+export function scopeTagOf(
+  scope: DockScope,
+  context: Pick<DockContext, "threadRef" | "projectId">,
+): string | null {
+  if (scope === "global") return GLOBAL_TAG;
+  if (scope === "project") return context.projectId ? projectTag(context.projectId) : null;
+  return threadTag(context.threadRef.threadId);
+}
+
+/** The scope a window was put in: the last scope tag T3 added, else its origin's. */
+export function scopeOfWindow(entry: NativeWindowEntry): DockScope {
+  return scopeOfTags(windowTags(entry));
+}
+
+/** The scope of what carries `tags`: the last scope tag among them. */
+export function scopeOfTags(tags: readonly string[]): DockScope {
+  for (let index = tags.length - 1; index >= 0; index -= 1) {
+    const tag = tags[index]!;
+    if (tag === GLOBAL_TAG) return "global";
+    if (tag.startsWith("t3:project/")) return "project";
+    if (tag.startsWith("t3:thread/")) return "thread";
+  }
+  return "thread";
+}
+
+const normalizeAppId = (id: string) => id.toLowerCase().replace(/\.desktop$/, "");
+
+/** Whether window app id `windowAppId` is desktop entry `desktopId`'s (org.gnome.Nautilus ~ nautilus). */
+export function sameApp(desktopId: string, windowAppId: string): boolean {
+  const a = normalizeAppId(desktopId);
+  const b = normalizeAppId(windowAppId);
+  return a === b || a.split(".").at(-1) === b.split(".").at(-1);
+}
+
+/** Whether `entry` is a window of the slot's app (to find the one its start opened). */
+function isAppWindow(target: Extract<DockTarget, { kind: "app" }>, entry: NativeWindowEntry) {
+  if (target.windowAppId) return entry.appId === target.windowAppId;
+  return target.desktopId !== null && sameApp(target.desktopId, entry.appId);
+}
+
+/** Where a preview tab shows a browser tab: its thread and server tab id. */
+export interface PreviewPlace {
+  readonly environmentId: string;
+  readonly threadId: string;
+  readonly tabId: string;
+}
+
+/** What the dock finds slots' things in. */
+export interface DockWorld {
+  readonly windows: Readonly<Record<number, NativeWindowEntry>>;
+  /** The browser's tabs, oldest first. */
+  readonly tabs: readonly BrokerTab[];
+  /** The preview tab showing browser tab `tabId`, if one does. */
+  readonly previewOf: (tabId: number) => PreviewPlace | null;
+}
+
+const noPreview = () => null;
+
+/** The world as it is now. */
+function currentWorld(): DockWorld {
+  const preview = plutoniumPreview();
+  return {
+    windows: usePlutoniumWindowStore.getState().windows,
+    tabs: preview?.tabList() ?? [],
+    previewOf: preview ? (tabId) => preview.previewOf(tabId) : noPreview,
+  };
+}
+
+const NO_TABS: readonly BrokerTab[] = [];
+const subscribeTabs = (listener: () => void) => plutoniumPreview()?.onTabs(listener) ?? (() => {});
+const readTabs = () => plutoniumPreview()?.tabList() ?? NO_TABS;
+
+/** The world, re-rendering when a window or a tab changes. */
+export function useDockWorld(): DockWorld {
+  const windows = usePlutoniumWindowStore((state) => state.windows);
+  const tabs = useSyncExternalStore(subscribeTabs, readTabs);
+  const preview = plutoniumPreview();
+  return {
+    windows,
+    tabs,
+    previewOf: preview ? (tabId) => preview.previewOf(tabId) : noPreview,
+  };
+}
+
+/**
+ * Whether `tab` carries slot tag `tag` as its own: a page's new tab starts
+ * with its opener's tags, and isn't the slot's for that (previewBridge.ts
+ * takes the tag off it).
+ */
+function tabHolds(tab: BrokerTab, tag: string, tabs: readonly BrokerTab[]): boolean {
+  if (!tabTags(tab).includes(tag)) return false;
+  if (tab.openedBy !== "page") return true;
+  const opener = tabs.find((other) => other.id === tab.openerId);
+  return !opener || !tabTags(opener).includes(tag);
+}
+
+/** A slot's thing in a scope: its window, or its tab and where that shows. */
+export type DockThing =
+  | { readonly kind: "window"; readonly entry: NativeWindowEntry }
+  | { readonly kind: "tab"; readonly tab: BrokerTab; readonly place: PreviewPlace | null };
+
+const isHere = (place: PreviewPlace | null, threadRef: ScopedThreadRef) =>
+  place !== null &&
+  place.environmentId === threadRef.environmentId &&
+  place.threadId === threadRef.threadId;
+
+/**
+ * Slot `slot`'s thing in `context`'s thread: what carries the slot's tag and
+ * its scope's. A tab that shows in this thread first, else the newest.
+ */
+export function findDockThing(
+  slot: DockSlot,
+  context: Pick<DockContext, "threadRef" | "projectId">,
+  world: DockWorld,
+): DockThing | null {
+  if (slot.target.kind === "terminal") return null;
+  const scopeTag = scopeTagOf(slot.scope, context);
+  if (!scopeTag) return null;
+  const tag = dockSlotTag(slot.id);
+  if (slot.target.kind === "app") {
+    const entry = Object.values(world.windows)
+      .filter((window) => {
+        const tags = windowTags(window);
+        return tags.includes(tag) && tags.includes(scopeTag);
+      })
+      .toSorted((a, b) => a.id - b.id)
+      .at(-1);
+    return entry ? { kind: "window", entry } : null;
+  }
+  let found: DockThing | null = null;
+  for (const tab of world.tabs) {
+    if (!tabTags(tab).includes(scopeTag) || !tabHolds(tab, tag, world.tabs)) continue;
+    const place = world.previewOf(tab.id);
+    found = { kind: "tab", tab, place };
+    if (isHere(place, context.threadRef)) break;
+  }
+  return found;
+}
+
+/** The panel surface of `thing` in `threadRef`'s panel, if it shows there (a window always can). */
+function surfaceOfThing(thing: DockThing, threadRef: ScopedThreadRef): RightPanelSurface | null {
+  if (thing.kind === "window") return appSurface(thing.entry);
+  return thing.place && isHere(thing.place, threadRef) ? browserSurface(thing.place.tabId) : null;
+}
+
+/** The broker tab behind `surface` in `threadRef`'s panel, if it has one yet. */
+function tabOfSurface(surface: RightPanelSurface, threadRef: ScopedThreadRef): BrokerTab | null {
+  if (surface.kind !== "preview" || !surface.resourceId) return null;
+  const { serverEpoch } = readThreadPreviewState(threadRef);
+  return (
+    plutoniumPreview()?.tab(previewRuntimeTabId(threadRef, serverEpoch, surface.resourceId)) ?? null
+  );
+}
+
+/** A window or tab, to tag. */
+interface Taggable {
+  readonly kind: "window" | "tab";
+  readonly id: number;
+}
+
+const taggableOf = (thing: DockThing): Taggable =>
+  thing.kind === "window"
+    ? { kind: "window", id: thing.entry.id }
+    : { kind: "tab", id: thing.tab.id };
+
+const sameItem = (a: Taggable, b: Taggable | null) =>
+  b !== null && a.kind === b.kind && a.id === b.id;
+
+function tagsOfItem(item: Taggable, world: DockWorld): readonly string[] {
+  if (item.kind === "window") {
+    const entry = world.windows[item.id];
+    return entry ? windowTags(entry) : [];
+  }
+  const tab = world.tabs.find((other) => other.id === item.id);
+  return tab ? tabTags(tab) : [];
+}
+
+/** Adds `add` to and takes `remove` off `item`'s tags (not its origin tag). */
+async function retag(
+  item: Taggable,
+  add: readonly string[],
+  remove: readonly string[] = [],
+): Promise<void> {
+  if (item.kind === "window") {
+    const shell = await plutoniumShell();
+    await shell?.tagWindow?.(item.id, add, remove);
+  } else {
+    await plutoniumPreview()?.broker.updateTabTags?.(item.id, add, remove);
+  }
+}
+
+/** Takes slot `slot`'s tag off everything that carries it, in every scope. */
+function releaseDockSlot(slot: DockSlot): void {
+  if (slot.target.kind === "terminal") return;
+  const tag = dockSlotTag(slot.id);
+  const world = currentWorld();
+  for (const window of Object.values(world.windows)) {
+    if (windowTags(window).includes(tag)) {
+      void retag({ kind: "window", id: window.id }, [], [tag]).catch(() => undefined);
+    }
+  }
+  for (const tab of world.tabs) {
+    if (tabTags(tab).includes(tag)) {
+      void retag({ kind: "tab", id: tab.id }, [], [tag]).catch(() => undefined);
+    }
+  }
+}
+
+function hostOf(url: string): string {
+  try {
+    return new URL(url).host;
+  } catch {
+    return url;
+  }
+}
+
+/**
+ * Whether `next` names the same app or site as `previous`, so the slot keeps
+ * its id: what it holds elsewhere (another thread's, kept per thread) stays.
+ */
+function namesSameThing(previous: DockTarget, next: DockTarget): boolean {
+  if (previous.kind === "terminal" || next.kind === "terminal") return previous.kind === next.kind;
+  if (previous.kind === "app" && next.kind === "app") {
+    return (
+      (previous.desktopId !== null && previous.desktopId === next.desktopId) ||
+      (previous.windowAppId !== null && previous.windowAppId === next.windowAppId)
+    );
+  }
+  if (previous.kind === "site" && next.kind === "site") {
+    return hostOf(previous.url) === hostOf(next.url);
+  }
+  return false;
+}
+
+/**
+ * Slot `number` set to `next` (from the editor): it keeps its id while it
+ * names the same app or site; naming another, what it held leaves it.
+ */
+export function saveDockSlot(number: DockSlotNumber, next: Omit<DockSlot, "id">): void {
+  const state = useDockStore.getState();
+  const previous = state.slots[number];
+  const keep = previous && namesSameThing(previous.target, next.target);
+  if (previous && !keep) releaseDockSlot(previous);
+  state.setSlot(number, { ...next, id: keep ? previous.id : newDockSlotId() });
+}
+
+/** Empties slot `number`; what it held leaves it. */
+export function clearDockSlot(number: DockSlotNumber): void {
+  const state = useDockStore.getState();
+  const previous = state.slots[number];
+  if (previous) releaseDockSlot(previous);
+  state.setSlot(number, null);
+}
+
+const appSurface = (entry: NativeWindowEntry): RightPanelSurface => ({
+  id: `app:${entry.id}`,
+  kind: "app",
+  windowId: entry.id,
+  appId: entry.appId,
+});
+
+const browserSurface = (tabId: string): RightPanelSurface => ({
+  id: `browser:${tabId}`,
+  kind: "preview",
+  resourceId: tabId,
+});
+
+function terminalHasKeyboard(): boolean {
+  return (
+    document.activeElement?.closest(
+      '[data-thread-terminal-drawer][data-terminal-owner="drawer"]',
+    ) != null
+  );
+}
+
+function surfaceHasKeyboard(surface: RightPanelSurface): boolean {
+  if (surface.kind === "app") {
+    return usePlutoniumWindowStore.getState().windows[surface.windowId]?.focused === true;
+  }
+  if (surface.kind === "preview" && surface.resourceId) {
+    const active = document.activeElement;
+    return active instanceof HTMLElement && active.dataset.previewServerTab === surface.resourceId;
+  }
+  return false;
+}
+
+/** Slot `slot`'s layout in `threadKey`: the thread's own choice, else the slot's. */
+function layoutOf(state: DockState, threadKey: string, slot: DockSlotNumber): DockLayout {
+  return state.layouts[threadKey]?.[slot] ?? state.slots[slot]?.layout ?? "split";
+}
+
+const otherLayout = (layout: DockLayout): DockLayout => (layout === "fold" ? "split" : "fold");
+
+/**
+ * Goes back to what showed before `point.slot`'s key was pressed. `own` are
+ * the slot's surfaces: going back never shows one of them again (it was
+ * showing already when the key was pressed), it puts the slot away.
+ */
+function goBack(context: DockContext, point: ReturnPoint, own: readonly string[] = []): void {
+  const key = scopedThreadKey(context.threadRef);
+  const dock = useDockStore.getState();
+  const panel = useRightPanelStore.getState();
+  dock.setReturnTo(key, null);
+  dock.setTerminalFolded(key, point.terminalFolded);
+  if (!point.terminalOpen && context.terminalOpen) context.closeTerminal();
+  panel.setMaximized(context.threadRef, point.maximized);
+  const before =
+    point.activeSurfaceId && !own.includes(point.activeSurfaceId)
+      ? context.surfaces.find((surface) => surface.id === point.activeSurfaceId)
+      : undefined;
+  if (before) context.activate(before);
+  // Nothing of the panel's to go back to: the slot's thing was all it showed.
+  if (!point.panelOpen || !before) panel.close(context.threadRef);
+  context.focusComposer();
+}
+
+/** Remembers what shows now, unless this slot already did (it was pressed before going back). */
+function rememberReturn(context: DockContext, slot: DockSlotNumber): void {
+  const key = scopedThreadKey(context.threadRef);
+  const dock = useDockStore.getState();
+  if (dock.returnTo[key]?.slot === slot) return;
+  dock.setReturnTo(key, {
+    slot,
+    panelOpen: context.panelOpen,
+    activeSurfaceId: context.activeSurfaceId,
+    maximized: context.maximized,
+    terminalOpen: context.terminalOpen,
+    terminalFolded: dock.terminalFolded[key] === true,
+  });
+}
+
+/** Shows `surface` in the panel, laid out as `layout`, with the keyboard. */
+function raiseSurface(context: DockContext, surface: RightPanelSurface, layout: DockLayout): void {
+  const panel = useRightPanelStore.getState();
+  if (context.surfaces.some((entry) => entry.id === surface.id)) {
+    context.activate(surface);
+  } else if (surface.kind === "app") {
+    panel.openApp(context.threadRef, { windowId: surface.windowId, appId: surface.appId });
+  } else if (surface.kind === "preview" && surface.resourceId) {
+    panel.openBrowser(context.threadRef, surface.resourceId);
+  }
+  panel.show(context.threadRef);
+  panel.setMaximized(context.threadRef, layout === "fold");
+  void focusRightPanelSurface(surface);
+}
+
+/**
+ * Brings site slot `slot`'s `tab` (its tab in scope `scopeTag`, shown in
+ * another thread or none) to this thread, or opens a new one there.
+ */
+async function bringSiteTab(
+  context: DockContext,
+  slot: DockSlot,
+  scopeTag: string,
+  tab: BrokerTab | null,
+  layout: DockLayout,
+): Promise<void> {
+  const target = slot.target as Extract<DockTarget, { kind: "site" }>;
+  const preview = plutoniumPreview();
+  if (!preview?.broker.updateTabTags) {
+    // No tags to hold it by: a tab of the site, which the slot won't find again.
+    await context.openSite(target.url);
+    useRightPanelStore.getState().setMaximized(context.threadRef, layout === "fold");
+    return;
+  }
+  try {
+    if (!tab) {
+      tab = await preview.createDockTab(target.url, scopeTag, dockSlotTag(slot.id));
+    } else {
+      const from = preview.previewOf(tab.id);
+      if (from) {
+        const fromRef = {
+          environmentId: from.environmentId as EnvironmentId,
+          threadId: from.threadId as ThreadId,
+        };
+        if (scopedThreadKey(fromRef) === scopedThreadKey(context.threadRef)) {
+          raiseSurface(context, browserSurface(from.tabId), layout);
+          return;
+        }
+        preview.releaseTab(from.runtimeTabId);
+        useRightPanelStore.getState().closeSurface(fromRef, `browser:${from.tabId}`);
+        await context.closePreview(fromRef, from.tabId);
+      }
+    }
+  } catch (error) {
+    toastManager.add({
+      type: "error",
+      title: `Could not open ${target.name}`,
+      description: error instanceof Error ? error.message : String(error),
+    });
+    return;
+  }
+  const tabId = await context.showTab(tab);
+  if (tabId) raiseSurface(context, browserSurface(tabId), layout);
+}
+
+const WINDOW_WAIT_MS = 60_000;
+
+/**
+ * Starts slot `slot`'s app in scope `scopeTag`, and puts the window it opens
+ * in the slot and shows it: a new window of the process started, or of the
+ * app in the scope (a launcher that hands over to another process).
+ */
+async function launchSlotApp(
+  context: DockContext,
+  slotNumber: DockSlotNumber,
+  slot: DockSlot,
+  scopeTag: string,
+  layout: DockLayout,
+): Promise<void> {
+  const target = slot.target as Extract<DockTarget, { kind: "app" }>;
+  const shell = await plutoniumShell();
+  if (!shell) return;
+  if (!target.desktopId) {
+    toastManager.add({
+      type: "error",
+      title: `${target.name} isn't running`,
+      description:
+        "No installed app was found to start it. Start it yourself, then Super+Shift+" +
+        `${slotNumber} puts it in the slot again.`,
+    });
+    return;
+  }
+  const known = new Set(Object.keys(usePlutoniumWindowStore.getState().windows).map(Number));
+  let pid: number | null = null;
+  let opened = false;
+  const open = () => {
+    if (opened) return;
+    const entry = Object.values(usePlutoniumWindowStore.getState().windows)
+      .filter(
+        (window) =>
+          !known.has(window.id) &&
+          ((pid !== null && window.pid === pid) ||
+            (windowTags(window).includes(scopeTag) && isAppWindow(target, window))),
+      )
+      .toSorted((a, b) => a.id - b.id)[0];
+    if (!entry) return;
+    opened = true;
+    stop();
+    void retag({ kind: "window", id: entry.id }, [scopeTag, dockSlotTag(slot.id)]).catch(
+      () => undefined,
+    );
+    // Remember its app id: the next start finds its window by it too.
+    const current = useDockStore.getState().slots[slotNumber];
+    if (current?.id === slot.id && current.target.kind === "app" && !current.target.windowAppId) {
+      useDockStore.getState().setSlot(slotNumber, {
+        ...current,
+        target: { ...current.target, windowAppId: entry.appId },
+      });
+    }
+    raiseSurface(context, appSurface(entry), layout);
+  };
+  const unsubscribe = usePlutoniumWindowStore.subscribe(open);
+  const timer = setTimeout(() => stop(), WINDOW_WAIT_MS);
+  function stop() {
+    unsubscribe();
+    clearTimeout(timer);
+  }
+  toastManager.add({ type: "info", title: `Starting ${target.name}…`, timeout: 2500 });
+  try {
+    pid = (await shell.launchApp(scopeTag, target.desktopId)).pid || null;
+    open();
+  } catch (error) {
+    stop();
+    toastManager.add({
+      type: "error",
+      title: `Could not start ${target.name}`,
+      description: error instanceof Error ? error.message : String(error),
+    });
+  }
+}
+
+/**
+ * Super+N: starts, shows, focuses or puts away slot `slotNumber`'s thing.
+ * `other` lays it out the other way this time (Super+Ctrl+N).
+ */
+export function runDockSlot(
+  context: DockContext,
+  slotNumber: DockSlotNumber,
+  options: {
+    readonly other?: boolean;
+    /** From the dock's button: what shows counts as focused (the click took the keyboard). */
+    readonly click?: boolean;
+  } = {},
+): void {
+  const state = useDockStore.getState();
+  const slot = state.slots[slotNumber];
+  if (!slot) {
+    toastManager.add({
+      type: "info",
+      title: `Super+${slotNumber} is empty`,
+      description: `Super+Shift+${slotNumber} puts what has the keyboard there.`,
+      timeout: 3000,
+    });
+    return;
+  }
+  const key = scopedThreadKey(context.threadRef);
+  const own = layoutOf(state, key, slotNumber);
+  const layout = options.other ? otherLayout(own) : own;
+  const back = state.returnTo[key];
+  const target = slot.target;
+  // Just arrived in this thread: what the slot shows here counts as focused,
+  // so the key hides it (the switch gave the composer the keyboard).
+  const arrived = arrival?.threadKey === key && !arrival.acted;
+  if (arrival) arrival.acted = true;
+
+  if (target.kind === "terminal") {
+    if (
+      context.terminalOpen &&
+      (options.click || arrived || terminalHasKeyboard()) &&
+      !options.other
+    ) {
+      if (back?.slot === slotNumber) goBack(context, back);
+      else {
+        // Nowhere remembered to go back to: put it away.
+        state.setTerminalFolded(key, false);
+        context.closeTerminal();
+        context.focusComposer();
+      }
+      return;
+    }
+    rememberReturn(context, slotNumber);
+    state.setTerminalFolded(key, layout === "fold");
+    if (context.terminalOpen) context.focusTerminal();
+    else context.openTerminal();
+    return;
+  }
+
+  const scopeTag = scopeTagOf(slot.scope, context);
+  if (!scopeTag) {
+    toastManager.add({ type: "info", title: "This thread has no project", timeout: 3000 });
+    return;
+  }
+  const thing = findDockThing(slot, context, currentWorld());
+  const surface = thing ? surfaceOfThing(thing, context.threadRef) : null;
+  if (!surface) {
+    // Nothing of it in its scope: start it. A site's tab elsewhere: bring it here.
+    rememberReturn(context, slotNumber);
+    if (target.kind === "app") void launchSlotApp(context, slotNumber, slot, scopeTag, layout);
+    else {
+      const tab = thing?.kind === "tab" ? thing.tab : null;
+      void bringSiteTab(context, slot, scopeTag, tab, layout);
+    }
+    return;
+  }
+
+  const showing = context.panelOpen && context.activeSurfaceId === surface.id;
+  if (showing && (options.click || arrived || surfaceHasKeyboard(surface)) && !options.other) {
+    // Shown and focused: back to where you were.
+    if (back?.slot === slotNumber) goBack(context, back, [surface.id]);
+    else {
+      // Nowhere remembered to go back to: put it away.
+      const panel = useRightPanelStore.getState();
+      panel.setMaximized(context.threadRef, false);
+      panel.close(context.threadRef);
+      context.focusComposer();
+    }
+    return;
+  }
+  rememberReturn(context, slotNumber);
+  // Shown or not: show it and give it the keyboard.
+  raiseSurface(context, surface, layout);
+}
+
+/**
+ * Super+Up: the slot showing in this thread goes split ↔ fold, and the
+ * thread keeps that for it. With no slot showing, the panel's maximize.
+ */
+export function toggleDockLayout(context: DockContext): void {
+  const key = scopedThreadKey(context.threadRef);
+  const state = useDockStore.getState();
+  const slotNumber = state.returnTo[key]?.slot;
+  const slot = slotNumber ? state.slots[slotNumber] : undefined;
+  if (slotNumber && slot?.target.kind === "terminal" && context.terminalOpen) {
+    const folded = state.terminalFolded[key] === true;
+    state.setTerminalFolded(key, !folded);
+    state.setThreadLayout(key, slotNumber, folded ? "split" : "fold");
+    context.focusTerminal();
+    return;
+  }
+  const panel = useRightPanelStore.getState();
+  if (!context.panelOpen) return;
+  panel.setMaximized(context.threadRef, !context.maximized);
+  if (slotNumber && slot && slot.target.kind !== "terminal") {
+    state.setThreadLayout(key, slotNumber, context.maximized ? "split" : "fold");
+  }
+}
+
+/** What `surface` would be as a slot's target, the scope it's in now, and the thing to tag. */
+async function targetOf(
+  surface: RightPanelSurface,
+  threadRef: ScopedThreadRef,
+): Promise<{ target: DockTarget; scope: DockScope; item: Taggable | null } | null> {
+  if (surface.kind === "app") {
+    const entry = usePlutoniumWindowStore.getState().windows[surface.windowId];
+    if (!entry) return null;
+    const shell = await plutoniumShell();
+    const apps = shell ? await shell.apps().catch(() => []) : [];
+    const app = apps.find((candidate) => sameApp(candidate.id, entry.appId));
+    return {
+      target: {
+        kind: "app",
+        desktopId: app?.id ?? null,
+        windowAppId: entry.appId,
+        name: app?.name ?? (entry.title || entry.appId),
+      },
+      scope: scopeOfWindow(entry),
+      item: { kind: "window", id: entry.id },
+    };
+  }
+  if (surface.kind === "preview" && surface.resourceId) {
+    const state = readThreadPreviewState(threadRef);
+    const session = state.sessions[surface.resourceId];
+    const status = session?.navStatus as { url?: string; title?: string } | undefined;
+    if (!status?.url) return null;
+    let name = status.title || status.url;
+    try {
+      name = status.title || new URL(status.url).host;
+    } catch {
+      // Keep the address.
+    }
+    const favicon = state.desktopByTabId[session?.tabId ?? surface.resourceId]?.favicon;
+    // A dock slot's tab from elsewhere stays in its scope.
+    const tab = tabOfSurface(surface, threadRef);
+    return {
+      target: {
+        kind: "site",
+        url: status.url,
+        name,
+        ...(favicon?.dataUrl ? { icon: favicon.dataUrl } : {}),
+      },
+      scope: tab ? scopeOfTags(tabTags(tab)) : "thread",
+      item: tab ? { kind: "tab", id: tab.id } : null,
+    };
+  }
+  return null;
+}
+
+/** A short name for slot `slot`'s target. */
+export function dockSlotLabel(slot: DockSlot | undefined): string {
+  if (!slot) return "empty";
+  return slot.target.kind === "terminal" ? "Terminal" : slot.target.name;
+}
+
+const SCOPE_LABEL: Record<DockScope, string> = {
+  thread: "this thread",
+  project: "this project",
+  global: "everywhere",
+};
+
+/**
+ * Puts `surface` (null: the terminal drawer) in slot `slotNumber`: that
+ * window or tab is the slot's in its scope, instead of what was (and it
+ * leaves any other slot it was in).
+ */
+export async function assignDockSlot(
+  context: Pick<DockContext, "threadRef" | "projectId">,
+  slotNumber: DockSlotNumber,
+  surface: RightPanelSurface | null,
+): Promise<void> {
+  const state = useDockStore.getState();
+  const previous = state.slots[slotNumber];
+  let next: DockSlot;
+  if (surface === null) {
+    if (previous && previous.target.kind !== "terminal") releaseDockSlot(previous);
+    next = {
+      id: previous?.target.kind === "terminal" ? previous.id : newDockSlotId(),
+      target: { kind: "terminal" },
+      scope: "thread",
+      layout: previous?.layout ?? "split",
+    };
+  } else {
+    const found = await targetOf(surface, context.threadRef);
+    if (!found) {
+      toastManager.add({
+        type: "info",
+        title: "Only apps, browser tabs and the terminal go in the dock",
+        timeout: 3000,
+      });
+      return;
+    }
+    const keep = previous !== undefined && namesSameThing(previous.target, found.target);
+    next = {
+      id: keep ? previous.id : newDockSlotId(),
+      target: found.target,
+      scope: found.scope,
+      layout: previous?.layout ?? "split",
+    };
+    const tag = dockSlotTag(next.id);
+    const world = currentWorld();
+    if (previous && !keep) releaseDockSlot(previous);
+    else if (previous) {
+      // What the slot held here (in this thread, project or everywhere) leaves it.
+      const old = findDockThing(previous, context, world);
+      if (old && !sameItem(taggableOf(old), found.item)) {
+        await retag(taggableOf(old), [], [tag]).catch(() => undefined);
+      }
+    }
+    if (found.item) {
+      // It leaves the other slots it was in.
+      const others = tagsOfItem(found.item, world).filter(
+        (other) => isDockSlotTag(other) && other !== tag,
+      );
+      await retag(found.item, [tag], others).catch(() => undefined);
+    }
+  }
+  state.setSlot(slotNumber, next);
+  toastManager.add({
+    type: "success",
+    title: `Super+${slotNumber}: ${dockSlotLabel(next)}`,
+    description: `Kept ${SCOPE_LABEL[next.scope]}.`,
+    timeout: 3000,
+  });
+}
+
+/**
+ * Keeps slot `slotNumber` in `scope`. What it holds in this thread's old
+ * scope gets the new scope's tag (and loses a project's or t3:global); what
+ * it holds elsewhere stays as it is.
+ */
+export async function setDockSlotScope(
+  context: Pick<DockContext, "threadRef" | "projectId">,
+  slotNumber: DockSlotNumber,
+  scope: DockScope,
+): Promise<void> {
+  const state = useDockStore.getState();
+  const slot = state.slots[slotNumber];
+  if (!slot || slot.target.kind === "terminal") return;
+  const to = scopeTagOf(scope, context);
+  if (!to) {
+    toastManager.add({ type: "info", title: "This thread has no project", timeout: 3000 });
+    return;
+  }
+  const from = scopeTagOf(slot.scope, context);
+  const thing = findDockThing(slot, context, currentWorld());
+  state.setSlot(slotNumber, { ...slot, scope });
+  if (!thing) return;
+  // A thread's tag stays: the thread shows it, and its agent reaches it.
+  const remove = from && from !== to && isDockScopeTag(from) ? [from] : [];
+  await retag(taggableOf(thing), [to], remove).catch(() => undefined);
+}
+
+/** The slot `surface` holds in `context`'s thread, if any. */
+export function dockSlotOfSurface(
+  slots: DockSlots,
+  surface: RightPanelSurface,
+  context: Pick<DockContext, "threadRef" | "projectId">,
+  world: DockWorld = currentWorld(),
+): DockSlotNumber | null {
+  for (const number of DOCK_SLOT_NUMBERS) {
+    const slot = slots[number];
+    if (!slot || slot.target.kind === "terminal") continue;
+    const thing = findDockThing(slot, context, world);
+    if (thing && surfaceOfThing(thing, context.threadRef)?.id === surface.id) return number;
+  }
+  return null;
+}
+
+let activeContext: DockContext | null = null;
+
+/**
+ * The thread last switched to, and whether the user has typed or clicked in
+ * the page (or run a slot) since: until then, a slot's key hides what it
+ * shows there.
+ */
+let arrival: { readonly threadKey: string; acted: boolean } | null = null;
+
+if (typeof window !== "undefined") {
+  const acted = (event: Event) => {
+    // Super+… are the dock's own keys (and the shell's).
+    if (event instanceof KeyboardEvent && (event.metaKey || event.key === "Meta")) return;
+    if (arrival) arrival.acted = true;
+  };
+  window.addEventListener("keydown", acted, true);
+  window.addEventListener("pointerdown", acted, true);
+}
+
+/** The active thread's context, as ChatView last published it (for the sidebar's dock). */
+export function publishDockContext(context: DockContext | null): void {
+  activeContext = context;
+  const threadKey = context ? scopedThreadKey(context.threadRef) : null;
+  if (threadKey && arrival?.threadKey !== threadKey) arrival = { threadKey, acted: false };
+  const next: ActiveDock | null = context
+    ? {
+        threadKey: scopedThreadKey(context.threadRef),
+        threadRef: context.threadRef,
+        projectId: context.projectId,
+        activeSurfaceId: context.activeSurfaceId,
+        panelOpen: context.panelOpen,
+        terminalOpen: context.terminalOpen,
+      }
+    : null;
+  const previous = useActiveDockStore.getState().active;
+  const same =
+    previous === next ||
+    (previous !== null &&
+      next !== null &&
+      previous.threadKey === next.threadKey &&
+      previous.projectId === next.projectId &&
+      previous.activeSurfaceId === next.activeSurfaceId &&
+      previous.panelOpen === next.panelOpen &&
+      previous.terminalOpen === next.terminalOpen);
+  if (!same) useActiveDockStore.setState({ active: next });
+}
+
+/** The dock's button for slot `slotNumber` was clicked. */
+export function clickDockSlot(slotNumber: DockSlotNumber): void {
+  if (!activeContext) {
+    toastManager.add({ type: "info", title: "Open a thread first", timeout: 2500 });
+    return;
+  }
+  runDockSlot(activeContext, slotNumber, { click: true });
+}
+
+/** What the sidebar's dock shows about the active thread. */
+export interface ActiveDock {
+  readonly threadKey: string;
+  readonly threadRef: ScopedThreadRef;
+  readonly projectId: string | null;
+  readonly activeSurfaceId: string | null;
+  readonly panelOpen: boolean;
+  readonly terminalOpen: boolean;
+}
+
+export const useActiveDockStore = create<{ readonly active: ActiveDock | null }>(() => ({
+  active: null,
+}));
+
+export type DockSlotState = "empty" | "idle" | "running" | "showing";
+
+/**
+ * Slot `slot`'s state in the active thread: nothing set, set but nothing of it
+ * in its scope, running (somewhere in its scope), or showing here now.
+ */
+export function dockSlotState(
+  slot: DockSlot | undefined,
+  active: ActiveDock | null,
+  world: DockWorld,
+): DockSlotState {
+  if (!slot) return "empty";
+  if (!active) return "idle";
+  if (slot.target.kind === "terminal") return active.terminalOpen ? "showing" : "idle";
+  const thing = findDockThing(slot, active, world);
+  if (!thing) return "idle";
+  const surface = surfaceOfThing(thing, active.threadRef);
+  return active.panelOpen && surface && active.activeSurfaceId === surface.id
+    ? "showing"
+    : "running";
+}
+
+/** Slot `slot`'s tab's server tab id in the active thread, if it shows there. */
+export function dockSlotTabHere(
+  slot: DockSlot | undefined,
+  active: ActiveDock | null,
+  world: DockWorld,
+): string | null {
+  if (!slot || !active || slot.target.kind !== "site") return null;
+  const thing = findDockThing(slot, active, world);
+  return thing?.kind === "tab" && isHere(thing.place, active.threadRef) ? thing.place!.tabId : null;
+}
+
+/** The active thread's tab showing in the panel, if it can go in the dock. */
+export function activeDockableSurface(): RightPanelSurface | null {
+  const context = activeContext;
+  if (!context?.panelOpen) return null;
+  const surface = context.surfaces.find((entry) => entry.id === context.activeSurfaceId);
+  if (!surface) return null;
+  return surface.kind === "app" || (surface.kind === "preview" && surface.resourceId)
+    ? surface
+    : null;
+}
+
+/** Puts the panel's tab (or, with `terminal`, the terminal drawer) in slot `slotNumber`. */
+export function assignActiveDockSlot(slotNumber: DockSlotNumber, terminal: boolean): void {
+  if (!activeContext) return;
+  const surface = terminal ? null : activeDockableSurface();
+  if (!terminal && !surface) return;
+  void assignDockSlot(activeContext, slotNumber, surface);
+}
+
+/** Keeps slot `slotNumber` in `scope`, from the active thread. */
+export function setActiveDockSlotScope(slotNumber: DockSlotNumber, scope: DockScope): void {
+  if (activeContext) void setDockSlotScope(activeContext, slotNumber, scope);
+}
