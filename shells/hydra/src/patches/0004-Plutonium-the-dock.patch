+    expect(dockSlotOfSurface({ 4: slot }, surface("browser:s-1"), activeIn(), world)).toBe(4);
+    expect(dockSlotOfSurface({ 4: slot }, surface("browser:s-2"), activeIn(), world)).toBeNull();
+    // Nothing of it in this thread (another thread's own): the key opens one.
