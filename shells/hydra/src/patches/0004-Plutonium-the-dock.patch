@@ -0,0 +1,740 @@
+// Plutonium: the dock in the sidebar, above the settings row. One button per
+// slot (Super+1…9), wrapping to the sidebar's width. A click runs the slot as
+// its key does; a right click (or a click on an empty slot) opens its editor:
+// what it is, where it's kept, how it's laid out (dock.ts).
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import { AppWindowIcon, GlobeIcon, SquareTerminalIcon } from "lucide-react";
+import { memo, useEffect, useId, useMemo, useState } from "react";
+
+import { useFaviconForThreadUrl } from "~/browserFaviconStore";
+import { FaviconImage } from "~/components/preview/PreviewFaviconIcon";
+import { Button } from "~/components/ui/button";
+import { Input } from "~/components/ui/input";
+import { Label } from "~/components/ui/label";
+import { Popover, PopoverPopup, PopoverTitle } from "~/components/ui/popover";
+import { Toggle, ToggleGroup } from "~/components/ui/toggle-group";
+import { Tooltip, TooltipPopup, TooltipTrigger } from "~/components/ui/tooltip";
+import { toolActivityFaviconUrl } from "@t3tools/shared/favicon";
+import { cn } from "~/lib/utils";
+import { useTheme } from "~/hooks/useTheme";
+import { useThreadPreviewState } from "~/previewStateStore";
+
+import {
+  type ActiveDock,
+  activeDockableSurface,
+  assignActiveDockSlot,
+  clearDockSlot,
+  clickDockSlot,
+  DOCK_SLOT_NUMBERS,
+  type DockLayout,
+  type DockScope,
+  type DockSlot,
+  type DockSlotNumber,
+  type DockSlotState,
+  type DockTarget,
+  dockSlotLabel,
+  dockSlotState,
+  dockSlotTabHere,
+  saveDockSlot,
+  setActiveDockSlotScope,
+  useActiveDockStore,
+  useDockStore,
+  useDockWorld,
+} from "./dock";
+import { type DesktopApp, isPlutoniumShell, plutoniumShell } from "./windowStore";
+
+type SiteTarget = Extract<DockTarget, { kind: "site" }>;
+type Kind = DockTarget["kind"];
+
+const SCOPES: readonly { value: DockScope; label: string }[] = [
+  { value: "thread", label: "This thread" },
+  { value: "project", label: "This project" },
+  { value: "global", label: "Everywhere" },
+];
+
+const SCOPE_TEXT: Record<DockScope, string> = {
+  thread: "this thread's",
+  project: "this project's",
+  global: "everywhere",
+};
+
+const STATE_TEXT: Record<DockSlotState, string> = {
+  empty: "Click to set it up",
+  idle: "Click to start",
+  running: "Click to show",
+  showing: "Click to go back",
+};
+
+// --- Icons -------------------------------------------------------------------
+
+const appIcons = new Map<string, Promise<string | null>>();
+
+/** An app's icon from the helper, fetched once per app. */
+function useAppIcon(desktopId: string | null): string | null {
+  const [url, setUrl] = useState<string | null>(null);
+  useEffect(() => {
+    if (!desktopId) return;
+    let live = true;
+    let icon = appIcons.get(desktopId);
+    if (!icon) {
+      icon = plutoniumShell()
+        .then((shell) => shell?.appIcon(desktopId) ?? null)
+        .catch(() => null);
+      appIcons.set(desktopId, icon);
+    }
+    void icon.then((value) => live && setUrl(value));
+    return () => {
+      live = false;
+    };
+  }, [desktopId]);
+  return desktopId ? url : null;
+}
+
+function AppIcon({ desktopId, className }: { desktopId: string | null; className: string }) {
+  const url = useAppIcon(desktopId);
+  return url ? (
+    <img alt="" className={cn(className, "object-contain")} src={url} />
+  ) : (
+    <AppWindowIcon className={className} />
+  );
+}
+
+const siteIcons = new Map<string, Promise<string | null>>();
+
+/**
+ * A site's own icon, fetched by the helper (undefined until it answers, null
+ * if it has none or the shell library is older). The page can't always load
+ * it itself: some sites forbid other origins their /favicon.ico (claude.ai),
+ * many name theirs elsewhere.
+ */
+function useHelperSiteIcon(pageUrl: string): string | null | undefined {
+  const origin = siteOrigin(pageUrl);
+  const [icon, setIcon] = useState<{ origin: string; url: string | null } | null>(null);
+  useEffect(() => {
+    if (!origin) return;
+    let live = true;
+    let found = siteIcons.get(origin);
+    if (!found) {
+      found = plutoniumShell()
+        .then((shell) => shell?.siteIcon?.(origin) ?? null)
+        .catch(() => null);
+      siteIcons.set(origin, found);
+    }
+    void found.then((url) => live && setIcon({ origin, url }));
+    return () => {
+      live = false;
+    };
+  }, [origin]);
+  if (!origin) return null;
+  return icon?.origin === origin ? icon.url : undefined;
+}
+
+function siteOrigin(pageUrl: string): string | null {
+  try {
+    const url = new URL(pageUrl);
+    return url.protocol === "http:" || url.protocol === "https:" ? url.origin : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * A site's icon: an open tab's, else the one T3 remembers for it, else the
+ * site's own (fetched by the helper; the page's own request to /favicon.ico
+ * when there's no helper to ask).
+ */
+function SiteIcon(props: {
+  target: SiteTarget;
+  threadRef: ScopedThreadRef | null;
+  live: string | null;
+  className: string;
+}) {
+  return props.threadRef ? (
+    <SiteIconInThread {...props} threadRef={props.threadRef} />
+  ) : (
+    <SiteIconImage {...props} remembered={null} />
+  );
+}
+
+function SiteIconInThread(props: {
+  target: SiteTarget;
+  threadRef: ScopedThreadRef;
+  live: string | null;
+  className: string;
+}) {
+  const remembered = useFaviconForThreadUrl(props.threadRef, props.target.url);
+  return <SiteIconImage {...props} remembered={remembered} />;
+}
+
+function SiteIconImage(props: {
+  target: SiteTarget;
+  live: string | null;
+  remembered: string | null;
+  className: string;
+}) {
+  // The site's own icon, or one drawn for the theme where its own is
+  // illegible (GitHub's black mark on a dark sidebar): that one comes first.
+  const { resolvedTheme } = useTheme();
+  const own = toolActivityFaviconUrl({ pageUrl: props.target.url }, resolvedTheme);
+  const themed = own && !own.endsWith("/favicon.ico") ? own : null;
+  const fetched = useHelperSiteIcon(props.target.url);
+  return (
+    <FaviconImage
+      sources={[
+        themed,
+        props.live,
+        props.remembered,
+        props.target.icon,
+        fetched,
+        fetched === null ? own : null,
+      ]}
+      fallback={<GlobeIcon className={props.className} />}
+      className={cn(props.className, "rounded-sm object-contain")}
+    />
+  );
+}
+
+function SlotIcon(props: {
+  slot: DockSlot;
+  active: ActiveDock | null;
+  live?: string | null;
+  className?: string;
+}) {
+  const className = props.className ?? "size-4";
+  const target = props.slot.target;
+  if (target.kind === "terminal") return <SquareTerminalIcon className={className} />;
+  if (target.kind === "app") return <AppIcon desktopId={target.desktopId} className={className} />;
+  return (
+    <SiteIcon
+      target={target}
+      threadRef={props.active?.threadRef ?? null}
+      live={props.live ?? null}
+      className={className}
+    />
+  );
+}
+
+// --- The editor --------------------------------------------------------------
+
+let appsList: Promise<DesktopApp[]> | null = null;
+
+/** The desktop apps the helper can start, sorted by name (fetched once). */
+function useDesktopApps(): DesktopApp[] | null {
+  const [apps, setApps] = useState<DesktopApp[] | null>(null);
+  useEffect(() => {
+    let live = true;
+    appsList ??= plutoniumShell()
+      .then((shell) => (shell ? shell.apps() : []))
+      .then((list) => list.toSorted((a, b) => a.name.localeCompare(b.name)))
+      .catch(() => {
+        appsList = null;
+        return [];
+      });
+    void appsList.then((list) => live && setApps(list));
+    return () => {
+      live = false;
+    };
+  }, []);
+  return apps;
+}
+
+function AppPicker(props: { onPick: (app: DesktopApp) => void }) {
+  const apps = useDesktopApps();
+  const [query, setQuery] = useState("");
+  const shown = useMemo(() => {
+    if (!apps) return [];
+    const words = query.toLowerCase().split(/\s+/).filter(Boolean);
+    return apps.filter((app) => {
+      const text = [app.name, app.genericName, app.id, ...app.keywords].join(" ").toLowerCase();
+      return words.every((word) => text.includes(word));
+    });
+  }, [apps, query]);
+  return (
+    <div className="flex flex-col gap-1.5">
+      <Input
+        size="sm"
+        type="search"
+        autoFocus
+        placeholder="Find an app"
+        value={query}
+        onChange={(event) => setQuery(event.target.value)}
+        onKeyDown={(event) => {
+          if (event.key === "Enter" && shown[0]) {
+            event.preventDefault();
+            props.onPick(shown[0]);
+          }
+        }}
+      />
+      <div className="max-h-48 overflow-y-auto rounded-md border border-border">
+        {apps === null ? (
+          <div className="px-2 py-3 text-center text-muted-foreground text-xs">Loading apps…</div>
+        ) : shown.length === 0 ? (
+          <div className="px-2 py-3 text-center text-muted-foreground text-xs">No app matches</div>
+        ) : (
+          shown.map((app) => (
+            <button
+              key={app.id}
+              type="button"
+              data-dock-app={app.id}
+              onClick={() => props.onPick(app)}
+              className="flex w-full items-center gap-2 px-2 py-1 text-left text-sm hover:bg-accent"
+            >
+              <AppIcon desktopId={app.id} className="size-4 shrink-0" />
+              <span className="min-w-0 truncate">{app.name}</span>
+              {app.genericName ? (
+                <span className="ml-auto min-w-0 shrink truncate text-muted-foreground text-xs">
+                  {app.genericName}
+                </span>
+              ) : null}
+            </button>
+          ))
+        )}
+      </div>
+    </div>
+  );
+}
+
+/** "github.com/x" → "https://github.com/x"; null if it isn't a web address. */
+export function normalizeSiteUrl(input: string): string | null {
+  const text = input.trim();
+  if (!text) return null;
+  const withScheme = /^[a-z][a-z0-9+.-]*:\/\//i.test(text) ? text : `https://${text}`;
+  try {
+    const url = new URL(withScheme);
+    return url.protocol === "http:" || url.protocol === "https:" ? url.href : null;
+  } catch {
+    return null;
+  }
+}
+
+function hostOf(url: string): string {
+  try {
+    return new URL(url).host;
+  } catch {
+    return url;
+  }
+}
+
+function SiteFields(props: { target: SiteTarget | null; onChange: (target: SiteTarget) => void }) {
+  const id = useId();
+  const { target } = props;
+  const [address, setAddress] = useState(target?.url ?? "");
+  const [error, setError] = useState<string | null>(null);
+  const commitAddress = () => {
+    const url = normalizeSiteUrl(address);
+    if (!url) {
+      setError(address.trim() ? "Not a web address" : null);
+      return;
+    }
+    setError(null);
+    setAddress(url);
+    if (url === target?.url) return;
+    const sameSite = target ? hostOf(target.url) === hostOf(url) : false;
+    props.onChange({
+      kind: "site",
+      url,
+      // Another site gets its host as its name, and not the old one's icon.
+      name: sameSite && target ? target.name : hostOf(url),
+      ...(target?.icon && sameSite ? { icon: target.icon } : {}),
+    });
+  };
+  return (
+    <div className="flex flex-col gap-1.5">
+      <Label htmlFor={`${id}-url`}>Address</Label>
+      <Input
+        id={`${id}-url`}
+        size="sm"
+        autoFocus={!target}
+        placeholder="github.com/org/repo"
+        value={address}
+        onChange={(event) => setAddress(event.target.value)}
+        onBlur={commitAddress}
+        onKeyDown={(event) => event.key === "Enter" && commitAddress()}
+      />
+      {error ? <span className="text-destructive-foreground text-xs">{error}</span> : null}
+      <span className="text-muted-foreground text-xs">
+        Where a new tab for it opens. The slot keeps that tab, wherever you browse in it.
+      </span>
+    </div>
+  );
+}
+
+function NameField(props: { name: string; onRename: (name: string) => void }) {
+  const id = useId();
+  const [name, setName] = useState(props.name);
+  const commit = () => {
+    const value = name.trim();
+    if (value && value !== props.name) props.onRename(value);
+    else setName(props.name);
+  };
+  return (
+    <div className="flex flex-col gap-1.5">
+      <Label htmlFor={`${id}-name`}>Name</Label>
+      <Input
+        id={`${id}-name`}
+        size="sm"
+        value={name}
+        onChange={(event) => setName(event.target.value)}
+        onBlur={commit}
+        onKeyDown={(event) => event.key === "Enter" && commit()}
+      />
+    </div>
+  );
+}
+
+function Section(props: { title: string; children: React.ReactNode; hint?: string | null }) {
+  return (
+    <div className="flex flex-col gap-1.5">
+      <Label render={<span />}>{props.title}</Label>
+      {props.children}
+      {props.hint ? <span className="text-muted-foreground text-xs">{props.hint}</span> : null}
+    </div>
+  );
+}
+
+function scopeHintOf(kind: Kind | null, scope: DockScope): string {
+  if (kind === "terminal") return "The terminal is always the thread's own.";
+  if (kind === "site") {
+    if (scope === "global") return "One tab, which moves to whichever thread you press it in.";
+    if (scope === "project") return "One tab per project, which moves between its threads.";
+    return "Each thread opens its own tab.";
+  }
+  if (scope === "global") return "One copy, shown in whichever thread you press it in.";
+  if (scope === "project") return "One copy per project, shared by its threads.";
+  return "Each thread starts its own.";
+}
+
+function DockSlotEditor({ number }: { number: DockSlotNumber }) {
+  const slot = useDockStore((state) => state.slots[number]);
+  const active = useActiveDockStore((state) => state.active);
+  const threadLayout = useDockStore((state) =>
+    active ? state.layouts[active.threadKey]?.[number] : undefined,
+  );
+  const [kind, setKind] = useState<Kind | null>(slot?.target.kind ?? null);
+  const [picking, setPicking] = useState(slot === undefined);
+  const layout = slot?.layout ?? "split";
+  const scope = slot?.scope ?? "thread";
+  const dockable = activeDockableSurface();
+
+  const save = (target: DockTarget, next: Partial<Pick<DockSlot, "scope" | "layout">> = {}) =>
+    saveDockSlot(number, {
+      target,
+      scope: target.kind === "terminal" ? "thread" : (next.scope ?? scope),
+      layout: next.layout ?? layout,
+    });
+
+  const chooseKind = (next: Kind) => {
+    setKind(next);
+    if (next === "terminal") save({ kind: "terminal" });
+    setPicking(next !== "terminal" && slot?.target.kind !== next);
+  };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className="flex items-center gap-2.5">
+        <span className="flex size-9 shrink-0 items-center justify-center rounded-md bg-accent">
+          {slot ? <SlotIcon slot={slot} active={active} className="size-5" /> : null}
+        </span>
+        <div className="flex min-w-0 flex-col">
+          <PopoverTitle>
+            <span className="block truncate">{slot ? dockSlotLabel(slot) : "Empty slot"}</span>
+          </PopoverTitle>
+          <span className="text-muted-foreground text-xs">
+            Super+{number} · other layout Super+Ctrl+{number}
+          </span>
+        </div>
+      </div>
+
+      <Section title="Opens">
+        <ToggleGroup
+          aria-label="Opens"
+          className="w-full *:flex-1"
+          value={kind ? [kind] : []}
+          onValueChange={(next) => {
+            const value = next[0];
+            if (value === "terminal" || value === "app" || value === "site") chooseKind(value);
+          }}
+        >
+          <Toggle value="terminal">Terminal</Toggle>
+          <Toggle value="app">App</Toggle>
+          <Toggle value="site">Site</Toggle>
+        </ToggleGroup>
+        <Button
+          size="xs"
+          variant="outline"
+          disabled={dockable === null}
+          onClick={() => {
+            assignActiveDockSlot(number, false);
+            setKind(dockable?.kind === "app" ? "app" : "site");
+            setPicking(false);
+          }}
+        >
+          Use the panel's tab
+        </Button>
+      </Section>
+
+      {kind === "app" ? (
+        <Section title="App">
+          {slot?.target.kind === "app" && !picking ? (
+            <div className="flex items-center gap-2 rounded-md border border-border px-2 py-1.5">
+              <AppIcon desktopId={slot.target.desktopId} className="size-4 shrink-0" />
+              <span className="min-w-0 flex-1 truncate text-sm">
+                {slot.target.desktopId ?? slot.target.windowAppId ?? slot.target.name}
+              </span>
+              <Button size="xs" variant="ghost" onClick={() => setPicking(true)}>
+                Change
+              </Button>
+            </div>
+          ) : (
+            <AppPicker
+              onPick={(app) => {
+                save({ kind: "app", desktopId: app.id, windowAppId: null, name: app.name });
+                setPicking(false);
+              }}
+            />
+          )}
+        </Section>
+      ) : null}
+
+      {kind === "site" ? (
+        <SiteFields
+          key={slot?.target.kind === "site" ? slot.target.url : "new"}
+          target={slot?.target.kind === "site" ? slot.target : null}
+          onChange={(target) => save(target)}
+        />
+      ) : null}
+
+      {slot && slot.target.kind !== "terminal" && slot.target.kind === kind ? (
+        <NameField
+          key={slot.target.name}
+          name={slot.target.name}
+          onRename={(name) =>
+            slot.target.kind !== "terminal" && save({ ...slot.target, name } as DockTarget)
+          }
+        />
+      ) : null}
+
+      <Section title="Kept" hint={scopeHintOf(kind, scope)}>
+        <ToggleGroup
+          aria-label="Kept"
+          className="w-full *:flex-1"
+          disabled={!slot || slot.target.kind === "terminal"}
+          value={[slot && slot.target.kind !== "terminal" ? scope : "thread"]}
+          onValueChange={(next) => {
+            const value = next[0] as DockScope | undefined;
+            if (!value || !slot || value === scope) return;
+            if (active) setActiveDockSlotScope(number, value);
+            else save(slot.target, { scope: value });
+          }}
+        >
+          {SCOPES.map((option) => (
+            <Toggle
+              key={option.value}
+              value={option.value}
+              disabled={option.value === "project" && active !== null && !active.projectId}
+            >
+              {option.label}
+            </Toggle>
+          ))}
+        </ToggleGroup>
+      </Section>
+
+      <Section
+        title="Layout"
+        hint={
+          threadLayout && threadLayout !== layout
+            ? `This thread uses ${threadLayout === "fold" ? "the chat folded" : "beside the chat"} (Super+Up).`
+            : null
+        }
+      >
+        <ToggleGroup
+          aria-label="Layout"
+          className="w-full *:flex-1"
+          disabled={!slot}
+          value={[layout]}
+          onValueChange={(next) => {
+            const value = next[0] as DockLayout | undefined;
+            if (value && slot) save(slot.target, { layout: value });
+          }}
+        >
+          <Toggle value="split">Beside the chat</Toggle>
+          <Toggle value="fold">Chat folded</Toggle>
+        </ToggleGroup>
+        {threadLayout && threadLayout !== layout && active ? (
+          <Button
+            size="xs"
+            variant="ghost"
+            className="self-start"
+            onClick={() => useDockStore.getState().clearThreadLayout(active.threadKey, number)}
+          >
+            Use the slot's layout in this thread too
+          </Button>
+        ) : null}
+      </Section>
+
+      <div className="flex items-center justify-between gap-2 border-border border-t pt-3">
+        <span className="text-muted-foreground text-xs">
+          Super+Shift+{number} puts what has the keyboard here
+        </span>
+        <Button
+          size="xs"
+          variant="ghost-destructive"
+          disabled={!slot}
+          onClick={() => {
+            clearDockSlot(number);
+            setKind(null);
+            setPicking(true);
+          }}
+        >
+          Clear
+        </Button>
+      </div>
+    </div>
+  );
+}
+
+// --- The dock ----------------------------------------------------------------
+
+const DockButton = memo(function DockButton(props: {
+  number: DockSlotNumber;
+  slot: DockSlot | undefined;
+  state: DockSlotState;
+  active: ActiveDock | null;
+  liveIcon: string | null;
+  onEdit: (number: DockSlotNumber, anchor: HTMLElement) => void;
+}) {
+  const { number, slot, state } = props;
+  const name = dockSlotLabel(slot);
+  const detail = slot
+    ? slot.target.kind === "terminal"
+      ? "the thread's terminal"
+      : `${SCOPE_TEXT[slot.scope]} ${name}`
+    : null;
+  return (
+    <Tooltip>
+      <TooltipTrigger
+        render={
+          <button
+            type="button"
+            aria-label={`Super+${number}: ${name}`}
+            data-dock-slot={number}
+            data-dock-state={state}
+            // The click mustn't take the keyboard from what has it.
+            onMouseDown={(event) => event.preventDefault()}
+            onClick={(event) =>
+              slot ? clickDockSlot(number) : props.onEdit(number, event.currentTarget)
+            }
+            onContextMenu={(event) => {
+              event.preventDefault();
+              props.onEdit(number, event.currentTarget);
+            }}
+            className={cn(
+              "relative flex aspect-square w-full items-center justify-center rounded-md text-sidebar-muted-foreground transition-colors",
+              "hover:bg-sidebar-row-hover hover:text-sidebar-foreground",
+              state === "empty" && "opacity-35",
+              state === "idle" && "opacity-60",
+              state === "running" && "text-sidebar-foreground",
+              state === "showing" &&
+                "bg-sidebar-row-hover text-sidebar-foreground ring-1 ring-sidebar-border",
+            )}
+          >
+            {slot ? (
+              <SlotIcon slot={slot} active={props.active} live={props.liveIcon} />
+            ) : (
+              <span className="size-1 rounded-full bg-current" />
+            )}
+            <span className="pointer-events-none absolute top-0 right-0.5 text-4xs leading-none tabular-nums opacity-70">
+              {number}
+            </span>
+            {state === "running" || state === "showing" ? (
+              <span className="pointer-events-none absolute bottom-0.5 left-1/2 size-0.5 -translate-x-1/2 rounded-full bg-current" />
+            ) : null}
+          </button>
+        }
+      />
+      <TooltipPopup side="top">
+        <div className="font-medium">
+          Super+{number}
+          {slot ? `: ${name}` : ""}
+        </div>
+        {detail ? <div className="text-muted-foreground">{detail}</div> : null}
+        <div className="text-muted-foreground">
+          {STATE_TEXT[state]}
+          {slot ? "; right-click to change it" : ""}
+        </div>
+      </TooltipPopup>
+    </Tooltip>
+  );
+});
+
+/** The dock, above the sidebar's settings row. Nothing outside the Plutonium shell. */
+export const PlutoniumDock = memo(function PlutoniumDock() {
+  if (!isPlutoniumShell()) return null;
+  return <Dock />;
+});
+
+function Dock() {
+  const slots = useDockStore((state) => state.slots);
+  // The windows and the browser's tabs, which hold the slots' tags.
+  const world = useDockWorld();
+  const active = useActiveDockStore((state) => state.active);
+  const preview = useThreadPreviewState(active?.threadRef ?? null);
+  const [editing, setEditing] = useState<{
+    number: DockSlotNumber;
+    anchor: HTMLElement;
+  } | null>(null);
+  // A site slot's icon, from its tab when that shows here.
+  const liveIcons: Partial<Record<DockSlotNumber, string>> = {};
+  for (const number of DOCK_SLOT_NUMBERS) {
+    const tabId = dockSlotTabHere(slots[number], active, world);
+    const favicon = tabId ? preview.desktopByTabId[tabId]?.favicon : undefined;
+    if (favicon?.dataUrl) liveIcons[number] = favicon.dataUrl;
+  }
+  return (
+    <>
+      {/* Square slots, packed: three rows of three, then one row of nine once
+          each slot has 1.375rem (9 × 1.375rem + 8 gaps of 0.125rem = 13.375rem).
+          A slot grows to fill the width up to 1.75rem; past that the grid
+          centers, the room left over going to its outer edges. */}
+      <div className="@container/dock px-1">
+        <div
+          role="toolbar"
+          aria-label="Dock"
+          data-plutonium-dock
+          className={cn(
+            "grid justify-center gap-0.5",
+            "grid-cols-[repeat(3,min(1.75rem,calc((100cqw_-_0.25rem)/3)))]",
+            "@[13.375rem]/dock:grid-cols-[repeat(9,min(1.75rem,calc((100cqw_-_1rem)/9)))]",
+          )}
+        >
+          {DOCK_SLOT_NUMBERS.map((number) => (
+            <DockButton
+              key={number}
+              number={number}
+              slot={slots[number]}
+              state={dockSlotState(slots[number], active, world)}
+              active={active}
+              liveIcon={liveIcons[number] ?? null}
+              onEdit={(slot, anchor) => setEditing({ number: slot, anchor })}
+            />
+          ))}
+        </div>
+      </div>
+      <Popover open={editing !== null} onOpenChange={(open) => !open && setEditing(null)}>
+        <PopoverPopup
+          anchor={editing?.anchor ?? null}
+          side="top"
+          align="start"
+          sideOffset={6}
+          // A field the editor focuses itself (finding an app, a new address);
+          // otherwise nothing, so no option looks chosen.
+          initialFocus={false}
+          width="md"
+          data-dock-editor
+        >
+          {editing ? <DockSlotEditor key={editing.number} number={editing.number} /> : null}
+        </PopoverPopup>
+      </Popover>
+    </>
+  );
+}
