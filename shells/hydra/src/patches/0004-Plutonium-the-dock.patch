+  },
+});
+
+const SLOT = "s1";
+const TAG = dockSlotTag(SLOT);
+const site = (scope: DockSlot["scope"]): DockSlot => ({
+  id: SLOT,
+  target: { kind: "site", url: "https://github.com/a/b", name: "b" },
+  scope,
+  layout: "split",
+});
+const app = (scope: DockSlot["scope"]): DockSlot => ({
+  id: SLOT,
+  target: { kind: "app", desktopId: "foot", windowAppId: "foot", name: "Foot" },
