+    expect(findDockThing(site("global"), activeIn(), global)).toMatchObject({
+      place: { threadId: "b", tabId: "s-1" },
+    });
+    expect(
+      dockSlotState(
+        site("project"),
+        activeIn(),
+        worldOf([], [tab(1, "https://github.com/x", ["t3:project/q", TAG])]),
+      ),
+    ).toBe("idle");
+    const here = worldOf(
+      [],
+      [tab(1, "https://github.com/x", ["t3:project/p", TAG, "t3:thread/a"])],
+      {
+        1: ["a", "s-1"],
+      },
+    );
+    expect(dockSlotState(site("project"), activeIn("browser:s-1"), here)).toBe("showing");
+  });
+
+  it("holds the one window put in it, in its scope", () => {
+    const docked = window(["t3:global", TAG], 7);
+    const other = window(["t3:global"], 8);
+    const world = worldOf([docked, other], []);
+    expect(findDockThing(app("global"), activeIn(), world)).toMatchObject({ entry: docked });
+    expect(dockSlotState(app("global"), activeIn("app:7"), world)).toBe("showing");
+    expect(dockSlotState(app("global"), activeIn("app:8"), world)).toBe("running");
+    // Per thread: the one in this thread.
+    const threads = worldOf([window(["t3:thread/b", TAG], 9), window(["t3:thread/a"], 10)], []);
+    expect(findDockThing(app("thread"), activeIn(), threads)).toBeNull();
+    expect(
+      findDockThing(app("thread"), activeIn(), worldOf([window(["t3:thread/a", TAG], 11)], [])),
