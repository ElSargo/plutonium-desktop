+import { describe, expect, it, vi } from "vite-plus/test";
+
+vi.mock("~/components/ui/toast", () => ({ toastManager: { add: vi.fn() } }));
+
+import {
+  type ActiveDock,
+  type DockSlot,
+  type DockWorld,
+  dockSlotOfSurface,
+  dockSlotState,
+  findDockThing,
+  migrateDockSlots,
+  type PreviewPlace,
