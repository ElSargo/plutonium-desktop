+
+  it("puts a window in the last scope T3 added", () => {
+    expect(scopeOfWindow(window(["t3:thread/a"]))).toBe("thread");
+    expect(scopeOfWindow(window(["t3:thread/a", "t3:project/p"]))).toBe("project");
+    expect(scopeOfWindow(window(["t3:thread/a", "t3:project/p", "t3:global"]))).toBe("global");
+    expect(scopeOfWindow(window(["niri:desktop"]))).toBe("thread");
+    expect(scopeOfWindow(window(["t3:thread/a", "t3:global", TAG]))).toBe("global");
