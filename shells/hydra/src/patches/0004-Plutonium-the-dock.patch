+import type { BrokerTab } from "./previewBridge";
+import { dockSlotTag, isDockScopeTag, isDockSlotTag } from "./threadTag";
+import type { NativeWindowEntry } from "./windowStore";
+
+const window = (tags: string[], id = 1, appId = "foot"): NativeWindowEntry => ({
+  id,
+  appId,
+  title: appId,
+  width: 800,
+  height: 600,
+  deviceScaleFactor: 1,
+  embedded: false,
+  focused: false,
+  pid: 1,
+  threadId: tags[0] ?? null,
+  tags,
+});
+
+const tab = (id: number, url: string, tags: string[], opener?: number): BrokerTab =>
+  ({
+    id,
+    url,
+    tag: tags[0] ?? "",
+    tags,
+    openerId: opener ?? 0,
+    openedBy: opener ? "page" : "shell",
+  }) as unknown as BrokerTab;
+
+/** Thread `a` of project `p`, with `surface` showing in its panel. */
+const activeIn = (surface: string | null = null): ActiveDock =>
+  ({
+    threadKey: "e:a",
+    threadRef: { environmentId: "e", threadId: "a" },
+    projectId: "p",
+    activeSurfaceId: surface,
+    panelOpen: surface !== null,
+    terminalOpen: false,
+  }) as unknown as ActiveDock;
+
+/** Windows, tabs, and which thread's preview tab shows a tab (by broker tab id). */
+const worldOf = (
+  windows: NativeWindowEntry[],
+  tabs: BrokerTab[],
