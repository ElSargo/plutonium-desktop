From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Fri, 30 Oct 2026 18:59:53 +1300
Subject: [PATCH 45/48] Plutonium: a link opened in a new tab shows in the
 browser panel

The shell hands Hydra a link's new tab while it is still blank, so its
session started with no URL, and the page loaded before the server
attached, which then never heard of it: the panel stayed on "No preview
yet". The import waits for the tab's first URL, and the server reports a
desktop page that loaded before it attached.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/server/src/preview/ServerBrowser.ts |  5 ++++
 apps/web/src/plutonium/importTab.ts      | 36 ++++++++++++++++++++++--
 2 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/apps/server/src/preview/ServerBrowser.ts b/apps/server/src/preview/ServerBrowser.ts
index e937e7d127..f8f52310b0 100644
--- a/apps/server/src/preview/ServerBrowser.ts
+++ b/apps/server/src/preview/ServerBrowser.ts
@@ -1016,6 +1016,11 @@ const make = Effect.gen(function* () {
         .then(constVoid);
       // Background creation keeps the failed tab; automation awaits the original error.
       void tab.initialNavigation.catch(constVoid);
+    } else if (desktop && !adopted) {
+      // Plutonium: a desktop page whose page loaded before the server attached
+      // (a link the shell opened in a new tab, brought into the thread) fires
+      // no events for it, so its URL and title would never reach the clients.
+      void reportLoaded(tab);
     }
     return tab;
   };
diff --git a/apps/web/src/plutonium/importTab.ts b/apps/web/src/plutonium/importTab.ts
index 0a78dc56b3..9fcd605a92 100644
--- a/apps/web/src/plutonium/importTab.ts
+++ b/apps/web/src/plutonium/importTab.ts
@@ -7,10 +7,41 @@ import type { BrowserSettingsReadError, OpenPreviewMutation } from "~/browser/op
 import { openPreviewSession } from "~/components/preview/openPreviewSession";
 import { useRightPanelStore } from "~/rightPanelStore";
 
-import { plutoniumPreview, type BrokerTab } from "./previewBridge";
+import { isBlank, plutoniumPreview, type BrokerTab } from "./previewBridge";
 
 const isWebUrl = (url: string) => /^https?:\/\//i.test(url);
 
+/** How long a tab may stay blank before it is brought in as it is. */
+const FIRST_URL_WAIT_MS = 5000;
+
+/**
+ * `tab` once it has a URL. A link this page opens in a new tab arrives blank,
+ * and the session has to start at the link: the server attaches only once the
+ * page has loaded, and a page loaded by then sends it nothing.
+ */
+function withFirstUrl(
+  preview: NonNullable<ReturnType<typeof plutoniumPreview>>,
+  tab: BrokerTab,
+): Promise<BrokerTab> {
+  if (!isBlank(tab.url)) return Promise.resolve(tab);
+  return new Promise((resolve) => {
+    const current = () => preview.tabList().find((entry) => entry.id === tab.id);
+    const done = (entry: BrokerTab) => {
+      window.clearTimeout(timer);
+      unsubscribe();
+      resolve(entry);
+    };
+    // This page may hear of the tab after the shell library does.
+    let seen = false;
+    const unsubscribe = preview.onTabs(() => {
+      const entry = current();
+      seen ||= entry !== undefined;
+      if (entry ? !isBlank(entry.url) : seen) done(entry ?? tab);
+    });
+    const timer = window.setTimeout(() => done(current() ?? tab), FIRST_URL_WAIT_MS);
+  });
+}
+
 export async function importBrowserTab<E>(input: {
   readonly threadRef: ScopedThreadRef;
   readonly tab: BrokerTab;
@@ -18,7 +49,8 @@ export async function importBrowserTab<E>(input: {
 }): Promise<AtomCommandResult<unknown, E | BrowserSettingsReadError> | null> {
   const preview = plutoniumPreview();
   if (!preview) return null;
-  const { threadRef, tab } = input;
+  const { threadRef } = input;
+  const tab = await withFirstUrl(preview, input.tab);
   await preview.importTab(threadRef.threadId, tab.id);
   const result = await openPreviewSession({
     openPreview: input.openPreview,
