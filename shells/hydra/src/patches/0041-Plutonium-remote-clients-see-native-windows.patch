@@ -0,0 +1,64 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  inputModifiers,
+  mouseButton,
+  remoteWindowEntries,
+  wheelNotches,
+  windowPoint,
+  windowStreamUrl,
+} from "./remoteWindows";
+
+const window = {
+  id: 7,
+  appId: "org.gnome.TextEditor",
+  title: "Untitled",
+  width: 800,
+  height: 600,
+  deviceScaleFactor: 1,
+  embedded: false,
+  focused: false,
+  pid: 42,
+};
+
+describe("remote windows", () => {
+  it("files a window under the first T3 thread among its tags", () => {
+    const entries = remoteWindowEntries([
+      { ...window, tags: ["niri:workspace/1", "t3:thread/abc", "t3:thread/def"] },
+      { ...window, id: 8, tags: [] },
+    ]);
+    expect(entries[7]?.threadId).toBe("abc");
+    expect(entries[8]?.threadId).toBeNull();
+  });
+
+  it("maps a point on the scaled frame to the window's DIPs", () => {
+    const rect = { left: 100, top: 50, width: 400, height: 300 };
+    expect(windowPoint(300, 200, rect, window)).toEqual({ x: 400, y: 300 });
+    // Drags outside the frame stay on the window's edge.
+    expect(windowPoint(0, 1000, rect, window)).toEqual({ x: 0, y: 600 });
+  });
+
+  it("speaks the helper's input", () => {
+    expect(inputModifiers({ altKey: true, ctrlKey: true, metaKey: false, shiftKey: true })).toBe(
+      11,
+    );
+    expect([0, 1, 2, 9].map(mouseButton)).toEqual(["left", "middle", "right", "none"]);
+    expect(wheelNotches(0, 0)).toBe(0);
+    expect(wheelNotches(4, 0)).toBe(1);
+    expect(wheelNotches(-250, 0)).toBe(-3);
+    expect(wheelNotches(3, 1)).toBe(1);
+  });
+
+  it("puts the ticket on the socket's URL", () => {
+    const access = {
+      httpBase: "https://desk.example/api/window-stream",
+      wsBase: "wss://desk.example/api/window-stream",
+      query: { wsTicket: "t" },
+      credentials: false,
+    };
+    expect(windowStreamUrl(access, { windowId: "7" })).toBe(
+      "wss://desk.example/api/window-stream/ws?windowId=7&wsTicket=t",
+    );
+    expect(windowStreamUrl(access)).toBe("wss://desk.example/api/window-stream/ws?wsTicket=t");
+  });
+});
diff --git a/apps/web/src/plutonium/remoteWindows.ts b/apps/web/src/plutonium/remoteWindows.ts
new file mode 100644
index 0000000000..ce62701cd9
--- /dev/null
+++ b/apps/web/src/plutonium/remoteWindows.ts
@@ -0,0 +1,187 @@
+// Plutonium: native windows for a client away from the desktop (another
+// machine's browser). The shell shows windows with <native-window>, which only
+// the session's own browser has; here the server streams them instead
+// (/api/window-stream on T3's server, through the helper): the window list
+// fills the same store, and a window's tab draws its frames on a canvas and
+// sends pointer and keyboard input back.
+import { resolveDeviceHubAccess } from "@t3tools/client-runtime/state/deviceHubAccess";
+import {
+  type DeviceHubAccess,
+  withDeviceHubQuery,
+} from "@t3tools/client-runtime/device/hub-access";
+import type { EnvironmentId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import { Atom, AtomRegistry } from "effect/reactivity";
+
+import { connectionAtomRuntime } from "~/connection/runtime";
+import { appAtomRegistry } from "~/rpc/atomRegistry";
+import { useRightPanelStore } from "~/rightPanelStore";
+import { environmentSession } from "~/state/session";
+
+import { threadIdOfTag } from "./threadTag";
+import { type NativeWindowEntry, usePlutoniumWindowStore } from "./windowStore";
+
+export const WINDOW_STREAM_BASE_PATH = "/api/window-stream";
+/** The server's close codes (apps/server/src/plutonium/windowStream.ts). */
+export const WINDOW_GONE_CODE = 4404;
+export const WINDOWS_UNAVAILABLE_CODE = 4503;
+const RECONNECT_MS = 2000;
+
+const windowStreamAccessAtom = Atom.family((environmentId: EnvironmentId) =>
+  connectionAtomRuntime
+    .atom((get) => {
+      const prepared = Option.getOrNull(
+        get(environmentSession.preparedConnectionValueAtom(environmentId)),
+      );
+      if (prepared === null) return Effect.never;
+      return resolveDeviceHubAccess({ prepared, hubBasePath: WINDOW_STREAM_BASE_PATH });
+    })
+    .pipe(Atom.setIdleTTL(60_000), Atom.withLabel(`window-stream-access:${environmentId}`)),
+);
+
+/** Access to the window stream (a fresh ticket with `refresh`); null if there is none. */
+export function readWindowStreamAccess(
+  environmentId: EnvironmentId,
+  refresh: boolean,
+): Promise<DeviceHubAccess | null> {
+  const atom = windowStreamAccessAtom(environmentId);
+  if (refresh) appAtomRegistry.refresh(atom);
+  return Effect.runPromise(
+    AtomRegistry.getResult(appAtomRegistry, atom, { suspendOnWaiting: true }).pipe(
+      Effect.timeout("10 seconds"),
+      Effect.orElseSucceed(() => null),
+    ),
+  );
+}
+
+/** A WebSocket URL on the window stream. */
+export function windowStreamUrl(
+  access: DeviceHubAccess,
+  query: Readonly<Record<string, string>> = {},
+): string {
+  const search = new URLSearchParams(query).toString();
+  return withDeviceHubQuery(`${access.wsBase}/ws${search ? `?${search}` : ""}`, access);
+}
+
+/** The helper's window list as store entries (the thread is the first T3 thread tag's). */
+export function remoteWindowEntries(
+  list: readonly Omit<NativeWindowEntry, "threadId">[],
+): Record<number, NativeWindowEntry> {
+  return Object.fromEntries(
+    list.map((window) => [
+      window.id,
+      {
+        ...window,
+        threadId: (window.tags ?? []).map(threadIdOfTag).find((id) => id !== null) ?? null,
+      },
+    ]),
+  );
+}
+
+/**
+ * Fills the window store from the server's list, kept current, unless this
+ * page is the shell. Returns a function that stops.
+ */
+export function startRemoteWindows(environmentId: EnvironmentId): () => void {
+  let socket: WebSocket | null = null;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let stopped = false;
+  let reconciled = false;
+  // Refused upgrades (a server without the route) close before opening.
+  let refusals = 0;
+  const connect = async (refresh: boolean) => {
+    const access = await readWindowStreamAccess(environmentId, refresh);
+    if (stopped) return;
+    if (!access) {
+      timer = setTimeout(() => void connect(true), RECONNECT_MS);
+      return;
+    }
+    socket = new WebSocket(windowStreamUrl(access));
+    let opened = false;
+    socket.addEventListener("open", () => {
+      opened = true;
+      refusals = 0;
+    });
+    socket.addEventListener("message", (event) => {
+      if (typeof event.data !== "string") return;
+      const message = JSON.parse(event.data) as {
+        type?: string;
+        windows?: Omit<NativeWindowEntry, "threadId">[];
+      };
+      if (message.type !== "windows" || !message.windows) return;
+      const windows = remoteWindowEntries(message.windows);
+      usePlutoniumWindowStore.setState({ available: true, remote: true, windows });
+      // As in the shell: a tab whose window is gone (or is another app now) closes.
+      useRightPanelStore
+        .getState()
+        .reconcileAppSurfaces((id, appId) =>
+          reconciled ? id in windows : windows[id]?.appId === appId,
+        );
+      reconciled = true;
+    });
+    socket.addEventListener("close", (event) => {
+      socket = null;
+      if (stopped) return;
+      if (!opened) refusals++;
+      if (event.code === WINDOWS_UNAVAILABLE_CODE || refusals >= 3) {
+        // No Plutonium session behind this server: no Apps panel.
+        usePlutoniumWindowStore.setState({ available: false, windows: {} });
+        useRightPanelStore.getState().reconcileAppSurfaces(() => false);
+        return;
+      }
+      timer = setTimeout(() => void connect(true), RECONNECT_MS);
+    });
+  };
+  void connect(false);
+  return () => {
+    stopped = true;
+    clearTimeout(timer);
+    socket?.close();
+  };
+}
+
+/** Alt=1, Ctrl=2, Meta=4, Shift=8, as the helper's input takes them. */
+export function inputModifiers(
+  event: Pick<KeyboardEvent, "altKey" | "ctrlKey" | "metaKey" | "shiftKey">,
+): number {
+  return (
+    (event.altKey ? 1 : 0) |
+    (event.ctrlKey ? 2 : 0) |
+    (event.metaKey ? 4 : 0) |
+    (event.shiftKey ? 8 : 0)
+  );
+}
+
+const BUTTONS = ["left", "middle", "right", "back", "forward"] as const;
+
+/** A DOM mouse button as the helper names it. */
+export function mouseButton(button: number): (typeof BUTTONS)[number] | "none" {
+  return BUTTONS[button] ?? "none";
+}
+
+/** Wheel pixels (or lines) as notches, at least one in the direction scrolled. */
+export function wheelNotches(delta: number, deltaMode: number): number {
+  if (delta === 0) return 0;
+  const notches = deltaMode === 0 ? delta / 100 : deltaMode === 1 ? delta / 3 : delta * 10;
+  return Math.sign(notches) * Math.max(1, Math.round(Math.abs(notches)));
+}
+
+/**
+ * A point on the drawn frame (`rect`, CSS px) in the window's DIPs; the
+ * frame shows the whole window, scaled.
+ */
+export function windowPoint(
+  clientX: number,
+  clientY: number,
+  rect: Pick<DOMRect, "left" | "top" | "width" | "height">,
+  window: Pick<NativeWindowEntry, "width" | "height">,
+): { x: number; y: number } {
+  const clamp = (value: number, max: number) => Math.min(Math.max(value, 0), max);
+  return {
+    x: Math.round(clamp(((clientX - rect.left) / (rect.width || 1)) * window.width, window.width)),
+    y: Math.round(
+      clamp(((clientY - rect.top) / (rect.height || 1)) * window.height, window.height),
+    ),
+  };
+}
