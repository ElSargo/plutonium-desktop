@@ -0,0 +1,32 @@
+import { describe, expect, it } from "vitest";
+
+import { FrameReader, inputRequest } from "./windowStream.ts";
+
+const frame = (jpeg: string, width: number, height: number) => {
+  const header = Buffer.alloc(8);
+  header.writeUInt32BE(jpeg.length, 0);
+  header.writeUInt16BE(width, 4);
+  header.writeUInt16BE(height, 6);
+  return Buffer.concat([header, Buffer.from(jpeg)]);
+};
+
+describe("window stream", () => {
+  it("splits the helper's frames however they arrive", () => {
+    const bytes = Buffer.concat([frame("first", 640, 480), frame("2", 1, 1)]);
+    for (let cut = 0; cut <= bytes.length; cut++) {
+      const reader = new FrameReader();
+      const got = [...reader.push(bytes.subarray(0, cut)), ...reader.push(bytes.subarray(cut))];
+      expect(got.map(String)).toEqual(["first", "2"]);
+    }
+  });
+
+  it("forwards only mouse and key input", () => {
+    const event = { type: "mousePressed", x: 1, y: 2, button: "left", clickCount: 1 };
+    expect(inputRequest({ type: "mouse", event })).toEqual({ path: "mouse", body: event });
+    const events = [{ type: "keyDown", code: "KeyA" }];
+    expect(inputRequest({ type: "keys", events })).toEqual({ path: "keys", body: { events } });
+    expect(inputRequest({ type: "keys", events: "KeyA" })).toBeNull();
+    expect(inputRequest({ type: "close" })).toBeNull();
+    expect(inputRequest(null)).toBeNull();
+  });
+});
diff --git a/apps/server/src/plutonium/windowStream.ts b/apps/server/src/plutonium/windowStream.ts
new file mode 100644
index 0000000000..db155515dc
--- /dev/null
+++ b/apps/server/src/plutonium/windowStream.ts
@@ -0,0 +1,304 @@
+// @effect-diagnostics nodeBuiltinImport:off globalTimers:off - the Plutonium helper is a Unix socket, polled from Node callbacks
+/**
+ * Plutonium: native windows for clients away from the desktop.
+ *
+ * The Plutonium shell shows a thread's windows with <native-window> elements,
+ * which only exist in the session's own browser. Another machine's browser
+ * gets them from here, through the helper (its Unix socket):
+ *
+ *   /api/window-stream/ws               {type:"windows", windows} whenever
+ *                                       the window list changes.
+ *   /api/window-stream/ws?windowId=N    the window's frames, as binary JPEG
+ *                                       messages; `maxWidth`, `maxHeight`,
+ *                                       `quality`. The client sends
+ *                                       {type:"mouse", event} and
+ *                                       {type:"keys", events} (the helper's
+ *                                       WindowMouseEvent, WindowKeyEvent).
+ *
+ * Watching needs orchestration:read; input needs preview:operate, as driving
+ * a preview does. A closed window closes the socket with WINDOW_GONE_CODE;
+ * no helper (or one without these routes), with WINDOWS_UNAVAILABLE_CODE.
+ */
+import * as NodeHttpServerRequest from "@effect/platform-node/NodeHttpServerRequest";
+import { AuthOrchestrationReadScope, AuthPreviewOperateScope } from "@t3tools/contracts";
+import { plutoniumHelperSocket } from "@t3tools/shared/plutonium";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Queue from "effect/Queue";
+import { HttpRouter, HttpServerRequest, HttpServerResponse } from "effect/http";
+import * as Socket from "effect/socket/Socket";
+import * as NodeHttp from "node:http";
+
+import { authenticateMediaRequest } from "../auth/http.ts";
+
+export const WINDOW_STREAM_ROUTE_PREFIX = "/api/window-stream";
+/** Matches the client's. */
+export const WINDOW_GONE_CODE = 4404;
+export const WINDOWS_UNAVAILABLE_CODE = 4503;
+
+const LIST_INTERVAL_MS = 1000;
+const REQUEST_TIMEOUT_MS = 10_000;
+const MAX_SOCKET_BUFFER_BYTES = 4 * 1024 * 1024;
+const FRAME_HEADER_BYTES = 8;
+const textDecoder = new TextDecoder();
+
+/** Splits the helper's frame stream (helper/src/windowStream.ts) into JPEGs. */
+export class FrameReader {
+  private pending: Buffer = Buffer.alloc(0);
+
+  push(chunk: Buffer): Buffer[] {
+    this.pending = this.pending.length > 0 ? Buffer.concat([this.pending, chunk]) : chunk;
+    const frames: Buffer[] = [];
+    while (this.pending.length >= FRAME_HEADER_BYTES) {
+      const length = this.pending.readUInt32BE(0);
+      if (this.pending.length < FRAME_HEADER_BYTES + length) break;
+      frames.push(this.pending.subarray(FRAME_HEADER_BYTES, FRAME_HEADER_BYTES + length));
+      this.pending = this.pending.subarray(FRAME_HEADER_BYTES + length);
+    }
+    return frames;
+  }
+}
+
+/** A client message as the helper's input request, or null if it isn't one. */
+export const inputRequest = (
+  message: unknown,
+): { readonly path: "mouse" | "keys"; readonly body: unknown } | null => {
+  if (typeof message !== "object" || message === null || !("type" in message)) return null;
+  if (message.type === "mouse" && "event" in message && typeof message.event === "object") {
+    return { path: "mouse", body: message.event };
+  }
+  if (message.type === "keys" && "events" in message && Array.isArray(message.events)) {
+    return { path: "keys", body: { events: message.events } };
+  }
+  return null;
+};
+
+const intParam = (params: URLSearchParams, name: string, fallback: number, max: number) => {
+  const value = Number(params.get(name));
+  return Number.isFinite(value) && value > 0 ? Math.min(Math.round(value), max) : fallback;
+};
+
+const parseMessage = (chunk: Uint8Array | string): unknown => {
+  try {
+    return JSON.parse(typeof chunk === "string" ? chunk : textDecoder.decode(chunk));
+  } catch {
+    return null;
+  }
+};
+
+/** A request to the helper: its status and body. */
+const helperRequest = (
+  socketPath: string,
+  method: "GET" | "POST",
+  path: string,
+  body?: unknown,
+): Promise<{ readonly status: number; readonly text: string }> =>
+  new Promise((resolve, reject) => {
+    const request = NodeHttp.request(
+      {
+        socketPath,
+        method,
+        path,
+        timeout: REQUEST_TIMEOUT_MS,
+        headers: body === undefined ? {} : { "Content-Type": "application/json" },
+      },
+      (response) => {
+        let text = "";
+        response.setEncoding("utf8");
+        response.on("data", (chunk: string) => (text += chunk));
+        response.on("end", () => resolve({ status: response.statusCode ?? 500, text }));
+      },
+    );
+    request.on("timeout", () => request.destroy());
+    request.on("error", reject);
+    request.end(body === undefined ? undefined : JSON.stringify(body));
+  });
+
+type Output =
+  | { readonly _tag: "frame"; readonly data: Uint8Array }
+  | { readonly _tag: "text"; readonly text: string }
+  | { readonly _tag: "close"; readonly code: number; readonly reason: string };
+
+/** Sends the window list on `output` whenever it changes; returns a stop function. */
+const watchWindows = (socketPath: string, output: Queue.Queue<Output>): (() => void) => {
+  let last = "";
+  let stopped = false;
+  const poll = () => {
+    helperRequest(socketPath, "GET", "/v1/windows").then(
+      ({ status, text }) => {
+        if (stopped) return;
+        if (status !== 200) {
+          Queue.offerUnsafe(output, {
+            _tag: "close",
+            code: WINDOWS_UNAVAILABLE_CODE,
+            reason: `helper said ${status}`,
+          });
+          return;
+        }
+        if (text !== last) {
+          last = text;
+          Queue.offerUnsafe(output, { _tag: "text", text: `{"type":"windows","windows":${text}}` });
+        }
+        timer = setTimeout(poll, LIST_INTERVAL_MS);
+      },
+      () => {
+        if (!stopped)
+          Queue.offerUnsafe(output, {
+            _tag: "close",
+            code: WINDOWS_UNAVAILABLE_CODE,
+            reason: "no helper",
+          });
+      },
+    );
+  };
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  poll();
+  return () => {
+    stopped = true;
+    clearTimeout(timer);
+  };
+};
+
+/** Sends window `windowId`'s frames on `output`; returns a stop function. */
+const watchFrames = (
+  socketPath: string,
+  windowId: number,
+  query: URLSearchParams,
+  output: Queue.Queue<Output>,
+  congested: () => boolean,
+): (() => void) => {
+  const reader = new FrameReader();
+  const request = NodeHttp.request(
+    { socketPath, method: "GET", path: `/v1/windows/${windowId}/stream?${query.toString()}` },
+    (response) => {
+      if (response.statusCode !== 200) {
+        response.resume();
+        Queue.offerUnsafe(
+          output,
+          response.statusCode === 404
+            ? { _tag: "close", code: WINDOW_GONE_CODE, reason: "no such window" }
+            : {
+                _tag: "close",
+                code: WINDOWS_UNAVAILABLE_CODE,
+                reason: `helper said ${response.statusCode}`,
+              },
+        );
+        return;
+      }
+      response.on("data", (chunk: Buffer) => {
+        for (const frame of reader.push(chunk)) {
+          // A slow viewer loses frames rather than falling behind.
+          if (!congested()) Queue.offerUnsafe(output, { _tag: "frame", data: frame });
+        }
+      });
+      response.on("end", () =>
+        Queue.offerUnsafe(output, {
+          _tag: "close",
+          code: WINDOW_GONE_CODE,
+          reason: "window closed",
+        }),
+      );
+    },
+  );
+  request.on("error", () =>
+    Queue.offerUnsafe(output, {
+      _tag: "close",
+      code: WINDOWS_UNAVAILABLE_CODE,
+      reason: "no helper",
+    }),
+  );
+  request.end();
+  return () => request.destroy();
+};
+
+const handler = Effect.gen(function* () {
+  const request = yield* HttpServerRequest.HttpServerRequest;
+  const url = HttpServerRequest.toURL(request);
+  if (Option.isNone(url)) return HttpServerResponse.text("Bad Request", { status: 400 });
+  if (
+    url.value.pathname !== `${WINDOW_STREAM_ROUTE_PREFIX}/ws` ||
+    request.headers.upgrade?.toLowerCase() !== "websocket"
+  ) {
+    return HttpServerResponse.text("Not Found", { status: 404 });
+  }
+  const session = yield* authenticateMediaRequest(AuthOrchestrationReadScope);
+  const canOperate = session.scopes.includes(AuthPreviewOperateScope);
+  const params = url.value.searchParams;
+  const windowId = Number(params.get("windowId") ?? NaN);
+  const socketPath = plutoniumHelperSocket();
+  return yield* Effect.scoped(
+    Effect.gen(function* () {
+      const incoming = NodeHttpServerRequest.toIncomingMessage(request);
+      // JPEGs are already compressed.
+      delete incoming.headers["sec-websocket-extensions"];
+      const transport = incoming.socket;
+      const socket = yield* request.upgrade;
+      const reader = yield* socket.reader;
+      const writer = yield* socket.writer;
+      if (socketPath === undefined) {
+        yield* writer.write(new Socket.CloseEvent(WINDOWS_UNAVAILABLE_CODE, "no helper"));
+        return HttpServerResponse.empty();
+      }
+      const output = yield* Queue.unbounded<Output>();
+      const stop = Number.isInteger(windowId)
+        ? watchFrames(
+            socketPath,
+            windowId,
+            new URLSearchParams({
+              maxWidth: String(intParam(params, "maxWidth", 1920, 7680)),
+              maxHeight: String(intParam(params, "maxHeight", 1200, 4320)),
+              quality: String(intParam(params, "quality", 70, 100)),
+            }),
+            output,
+            () => transport.writableLength > MAX_SOCKET_BUFFER_BYTES,
+          )
+        : watchWindows(socketPath, output);
+      yield* Effect.addFinalizer(() => Effect.sync(stop));
+
+      const send = Queue.take(output).pipe(
+        Effect.flatMap((item) => {
+          switch (item._tag) {
+            case "frame":
+              return writer.write(item.data);
+            case "text":
+              return writer.write(item.text);
+            case "close":
+              return writer
+                .write(new Socket.CloseEvent(item.code, item.reason))
+                .pipe(Effect.andThen(Effect.interrupt));
+          }
+        }),
+      );
+      // Input goes to the helper in order, one request at a time.
+      let inputs: Promise<unknown> = Promise.resolve();
+      const receive = (chunk: Uint8Array | string) =>
+        Effect.sync(() => {
+          const input =
+            canOperate && Number.isInteger(windowId) ? inputRequest(parseMessage(chunk)) : null;
+          if (!input) return;
+          inputs = inputs
+            .then(() =>
+              helperRequest(
+                socketPath,
+                "POST",
+                `/v1/windows/${windowId}/${input.path}`,
+                input.body,
+              ),
+            )
+            .catch(() => {});
+        });
+      const receiveInput = reader.pull.pipe(
+        Effect.flatMap((chunks) => Effect.forEach(chunks, receive, { discard: true })),
+      );
+      return yield* Effect.raceFirst(Effect.forever(send), Effect.forever(receiveInput));
+    }),
+  ).pipe(
+    // A dropped socket is a normal end of viewing.
+    Effect.catch(() => Effect.succeed(HttpServerResponse.empty())),
+  );
+});
+
+export const routeLayer = process.env.PLUTONIUM_T3
+  ? HttpRouter.add("GET", `${WINDOW_STREAM_ROUTE_PREFIX}/*`, handler)
+  : Layer.empty;
