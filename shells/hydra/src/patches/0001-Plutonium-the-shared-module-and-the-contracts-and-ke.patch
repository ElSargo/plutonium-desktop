+++ b/packages/shared/src/plutonium.ts
@@ -0,0 +1,124 @@
+// @effect-diagnostics nodeBuiltinImport:off globalDate:off globalConsole:off - agent and terminal environments are built synchronously at spawn, outside Effect
+// Plutonium: run T3 Code as the web shell of a Chromium/Exo desktop, where
+// native Wayland apps that agents start show up as page elements.
+//
+// The frontend-neutral parts live in Plutonium's helper (plutoniumd, in the
+// plutonium repo under helper/): the thread environment (Exo display, thread
+// tag, a per-thread X display), pid → thread resolution, and the agent bridge
+// (an MCP server). This server only asks the helper what to add to a thread's
+// agents and terminals. The web app talks to the helper directly.
+//
+// Only active when the server is started with PLUTONIUM_HELPER (the helper's
+// Unix socket) or PLUTONIUM_WAYLAND_DISPLAY (Exo's socket name, from which the
+// helper's default socket path follows).
+import * as NodeChildProcess from "node:child_process";
+import * as NodePath from "node:path";
+
+export interface PlutoniumThreadSetup {
+  /** Variables for the thread's agents' processes. */
+  readonly env: Readonly<Record<string, string>>;
+  /** Variables for its terminals: what the user starts there is shown (older helpers: missing). */
+  readonly terminalEnv?: Readonly<Record<string, string>>;
+  /** The agent bridge as a stdio MCP server. */
+  readonly mcpServer: { readonly command: string; readonly args: readonly string[] };
+}
+
+/** The helper's Unix socket, when this server runs in a Plutonium session. */
+export function plutoniumHelperSocket(): string | undefined {
+  if (process.env.PLUTONIUM_HELPER) return process.env.PLUTONIUM_HELPER;
+  const display = process.env.PLUTONIUM_WAYLAND_DISPLAY;
+  if (!display) return undefined;
+  const runtime = process.env.XDG_RUNTIME_DIR || `/run/user/${process.getuid?.() ?? 0}`;
+  return NodePath.join(runtime, "plutonium", `${display}.sock`);
+}
+
+// Environments are built synchronously at spawn, so the request runs in a
+// short-lived child (about 50 ms).
+const REQUEST_SCRIPT = `
+const [socketPath, path] = process.argv.slice(1);
+require("node:http").get({ socketPath, path }, (res) => {
+  let body = "";
+  res.setEncoding("utf8");
+  res.on("data", (chunk) => (body += chunk));
+  res.on("end", () => {
+    process.stdout.write(body);
+    process.exit(res.statusCode === 200 ? 0 : 1);
+  });
+}).on("error", (error) => {
+  process.stderr.write(error.message);
+  process.exit(1);
+});
+`;
+
+let warned = false;
+// A session start asks for the environment and the MCP server separately.
+const CACHE_MS = 10_000;
+const cache = new Map<string, { readonly at: number; readonly setup: PlutoniumThreadSetup }>();
+
+/**
+ * A T3 thread's Plutonium tag: what its processes carry as
+ * PLUTONIUM_THREAD_ID, and what the windows and tabs it opens are tagged
+ * with. Namespaced, so other shells' threads can't collide with it.
+ */
+export function plutoniumThreadTag(threadId: string): string {
+  return `t3:thread/${threadId}`;
+}
+
+/** What the helper adds to `threadId`'s processes; undefined if Plutonium is off or unreachable. */
+export function plutoniumThreadSetup(
+  threadId: string | undefined,
+): PlutoniumThreadSetup | undefined {
+  const socket = plutoniumHelperSocket();
+  if (!socket || !threadId) return undefined;
+  const tag = plutoniumThreadTag(threadId);
+  const cached = cache.get(threadId);
+  if (cached && Date.now() - cached.at < CACHE_MS) return cached.setup;
+  const result = NodeChildProcess.spawnSync(
+    process.execPath,
+    ["-e", REQUEST_SCRIPT, socket, `/v1/thread-setup?thread=${encodeURIComponent(tag)}`],
+    { encoding: "utf8", timeout: 5_000 },
+  );
+  if (result.status !== 0) {
+    if (!warned) {
+      warned = true;
+      console.warn(
+        `Plutonium: the helper at ${socket} did not answer (${(result.stderr || result.stdout || "").trim()}); ` +
+          "thread processes won't be tagged until it does.",
+      );
+    }
+    return undefined;
+  }
+  warned = false;
+  const setup = JSON.parse(result.stdout) as PlutoniumThreadSetup;
+  cache.set(threadId, { at: Date.now(), setup });
+  return setup;
+}
+
+/** Variables that send a thread's GUI apps to Exo and tag them with the thread. */
+export function plutoniumAgentEnvironment(
+  threadId: string | undefined,
+): Readonly<Record<string, string>> {
+  return plutoniumThreadSetup(threadId)?.env ?? {};
+}
+
+/**
+ * As plutoniumAgentEnvironment(), for a terminal. With `userStarted`, the user
+ * types in it, so the windows and links its commands open are shown.
+ */
+export function plutoniumTerminalEnvironment(
+  threadId: string | undefined,
+  { userStarted }: { readonly userStarted: boolean },
+): Readonly<Record<string, string>> {
+  const setup = plutoniumThreadSetup(threadId);
+  return (userStarted ? setup?.terminalEnv : undefined) ?? setup?.env ?? {};
+}
+
+/** `env` with the Plutonium variables for `threadId` (`env` itself when off). */
+export function withPlutoniumAgentEnvironment(
+  env: NodeJS.ProcessEnv | undefined,
+  threadId: string | undefined,
+): NodeJS.ProcessEnv | undefined {
+  const plutonium = plutoniumAgentEnvironment(threadId);
+  if (Object.keys(plutonium).length === 0) return env;
+  return { ...(env ?? process.env), ...plutonium };
+}
