+   * Plutonium: no page shows this tab yet, so the helper opens one itself,
+   * tagged `tag` (the thread's Plutonium tag), rather than the server waiting
+   * for a shell page.
+   */
+  Schema.Struct({
+    type: Schema.Literal("open"),
+    ...TabKey,
