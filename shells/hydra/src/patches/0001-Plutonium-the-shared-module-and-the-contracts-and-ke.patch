+  Schema.Struct({ type: Schema.Literal("close"), ...TabKey }),
+  /**
+   * Plutonium: the helper opens a hidden page, in no window, for the server's
+   * own work (a recording's encoder) and attaches it under this key. `close`
+   * closes it.
+   */
+  Schema.Struct({ type: Schema.Literal("scratch"), ...TabKey }),
+  /**
+   * Plutonium: the server records this tab ("start") or stopped ("stop"); the
+   * helper registers it as a capture, which every shell sees and can stop.
+   */
+  Schema.Struct({
+    type: Schema.Literal("recording"),
+    ...TabKey,
+    phase: Schema.Literals(["start", "stop"]),
