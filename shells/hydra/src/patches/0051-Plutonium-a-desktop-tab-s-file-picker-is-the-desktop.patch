From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Mon, 2 Nov 2026 13:13:29 +1300
Subject: [PATCH 51/56] Plutonium: a desktop tab's file picker is the desktop's

The server listened for "filechooser" on every tab, and Playwright
intercepts every picker while that listener is attached. Only the streamed
surface (ServerBrowserSurface) shows the intercepted one, and Hydra's
panel shows Plutonium's own tab, so an <input type=file> in any thread's
tab waited unseen. Desktop tabs no longer listen: the browser asks the
shell, which draws its picker over the tab, and agents answer it with
choose_files. preview_upload without a locator says so on a desktop tab.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/server/src/preview/ServerBrowser.ts | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/apps/server/src/preview/ServerBrowser.ts b/apps/server/src/preview/ServerBrowser.ts
index f8f52310b0..2b2b2ae82b 100644
--- a/apps/server/src/preview/ServerBrowser.ts
+++ b/apps/server/src/preview/ServerBrowser.ts
@@ -987,7 +987,12 @@ const make = Effect.gen(function* () {
       broadcastControl(tab);
     });
     page.on("download", (download) => void saveDownload(tab, download));
-    page.on("filechooser", (chooser) => void offerFileChooser(tab, chooser));
+    // Plutonium: a desktop tab's picker is the desktop's own (Plutonium's shell
+    // draws it over the tab; agents answer it with choose_files). Playwright
+    // intercepts every picker while a "filechooser" listener is attached, and
+    // only the streamed surface shows the intercepted one, so a desktop tab's
+    // would wait unseen.
+    if (!desktop) page.on("filechooser", (chooser) => void offerFileChooser(tab, chooser));
     // Popups become tabs and keep `window.opener`, so sign-in popups can report back.
     page.on("popup", (popup) => void adoptPopup(tab, popup));
     // Playwright cannot reload a crashed page, so it must leave the tab list.
@@ -1202,7 +1207,9 @@ const make = Effect.gen(function* () {
     if (!open)
       throw new ServerBrowserPage.ServerBrowserOperationError(
         "PreviewAutomationExecutionError",
-        "No file picker is open. Click the page's upload control first, or pass the file input's locator.",
+        tab.desktop
+          ? "Pass the file input's locator. A picker this tab opened is the desktop's: answer it with choose_files."
+          : "No file picker is open. Click the page's upload control first, or pass the file input's locator.",
       );
     if (input.paths.length > 1 && !open.chooser.isMultiple())
       throw new ServerBrowserPage.ServerBrowserOperationError(
