From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Wed, 4 Nov 2026 17:56:34 +1300
Subject: [PATCH 55/55] Plutonium: the dock's rows are always full: three rows
 of three, or one row of nine

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/web/src/plutonium/PlutoniumDock.tsx | 38 +++++++++++++-----------
 1 file changed, 21 insertions(+), 17 deletions(-)

diff --git a/apps/web/src/plutonium/PlutoniumDock.tsx b/apps/web/src/plutonium/PlutoniumDock.tsx
index 114ea0a8b9..d7e471ca5f 100644
--- a/apps/web/src/plutonium/PlutoniumDock.tsx
+++ b/apps/web/src/plutonium/PlutoniumDock.tsx
@@ -692,23 +692,27 @@ function Dock() {
   }
   return (
     <>
-      <div
-        role="toolbar"
-        aria-label="Dock"
-        data-plutonium-dock
-        className="grid grid-cols-[repeat(auto-fill,minmax(1.375rem,1fr))] gap-0.5 px-1"
-      >
-        {DOCK_SLOT_NUMBERS.map((number) => (
-          <DockButton
-            key={number}
-            number={number}
-            slot={slots[number]}
-            state={dockSlotState(slots[number], active, world)}
-            active={active}
-            liveIcon={liveIcons[number] ?? null}
-            onEdit={(slot, anchor) => setEditing({ number: slot, anchor })}
-          />
-        ))}
+      {/* Every row full: three rows of three, then one row of nine once each
+          slot has 1.375rem (9 × 1.375rem + 8 gaps of 0.125rem = 13.375rem). */}
+      <div className="@container/dock px-1">
+        <div
+          role="toolbar"
+          aria-label="Dock"
+          data-plutonium-dock
+          className="grid grid-cols-3 gap-0.5 @[13.375rem]/dock:grid-cols-9"
+        >
+          {DOCK_SLOT_NUMBERS.map((number) => (
+            <DockButton
+              key={number}
+              number={number}
+              slot={slots[number]}
+              state={dockSlotState(slots[number], active, world)}
+              active={active}
+              liveIcon={liveIcons[number] ?? null}
+              onEdit={(slot, anchor) => setEditing({ number: slot, anchor })}
+            />
+          ))}
+        </div>
       </div>
       <Popover open={editing !== null} onOpenChange={(open) => !open && setEditing(null)}>
         <PopoverPopup
