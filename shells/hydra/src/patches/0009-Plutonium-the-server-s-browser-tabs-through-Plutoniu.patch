+describe("Plutonium: path drags", () => {
+  let browser: Browser;
+  let context: BrowserContext;
+  let page: Page;
+
+  beforeAll(async () => {
+    browser = await chromium.launch({ headless: true });
+  });
+  afterAll(async () => {
+    await browser?.close();
+  });
+  beforeEach(async () => {
+    context = await browser.newContext();
+    page = await context.newPage();
+  });
+  afterEach(async () => {
+    await context.close();
+  });
+
+  it("draws a stroke along a path with the button and modifiers held", async () => {
+    await page.setViewportSize({ width: 400, height: 300 });
+    await page.setContent(`
+      <div id="pad" style="position:absolute;inset:0"></div>
+      <script>
+        window.strokes = [];
+        let stroke = null;
+        pad.onpointerdown = (e) => (stroke = { shift: e.shiftKey, trusted: e.isTrusted, points: [[e.clientX, e.clientY]] });
+        pad.onpointermove = (e) => stroke?.points.push([e.clientX, e.clientY]);
+        pad.onpointerup = (e) => { stroke.points.push([e.clientX, e.clientY]); strokes.push(stroke); stroke = null; };
+      </script>`);
+    const shown: Array<string> = [];
+    const pointer: ServerBrowserPage.PointerReporter = async ({ x, y }, phase) => {
+      shown.push(`${phase}@${x},${y}`);
+    };
+    await ServerBrowserPage.drag(
+      page,
+      {
+        path: [
+          { x: 20, y: 20 },
+          { x: 100, y: 20 },
+          { x: 100, y: 100 },
+        ],
+        modifiers: ["Shift"],
+      },
+      pointer,
+    );
+    const [stroke] = (await page.evaluate("window.strokes")) as Array<{
+      shift: boolean;
+      trusted: boolean;
+      points: Array<[number, number]>;
+    }>;
+    expect(stroke).toMatchObject({ shift: true, trusted: true });
+    expect(stroke!.points[0]).toEqual([20, 20]);
+    expect(stroke!.points.at(-1)).toEqual([100, 100]);
+    expect(stroke!.points).toContainEqual([100, 20]);
+    // Moves come in short steps, so a canvas sees a continuous line.
+    expect(stroke!.points.length).toBeGreaterThan(15);
+    expect(shown).toEqual(["move@20,20", "track@100,20", "track@100,100"]);
+    // Nothing stays held afterwards.
+    await page.mouse.move(150, 150);
+    expect(await page.evaluate("window.strokes.length")).toBe(1);
+    expect(await page.evaluate("new MouseEvent('x').shiftKey")).toBe(false);
+  });
+});
+
