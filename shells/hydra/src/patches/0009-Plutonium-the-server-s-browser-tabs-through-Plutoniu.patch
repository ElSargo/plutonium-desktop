+
+it.layer(layer)("PreviewManager: Plutonium's native windows", (it) => {
+  it.effect("opens, retitles and closes window tabs, which only clients list", () =>
+    Effect.gen(function* () {
+      const threadId = freshThreadId();
+      const manager = yield* PreviewManager.PreviewManager;
+      const collector = yield* collectEvents;
+      const page = yield* manager.open({ threadId, url: "localhost:5173" });
+      const window = {
+        threadId,
+        tabId: "plutonium-window-7-100",
+        url: "app://org.kde.kwrite",
+        title: "Untitled",
+      };
+
+      yield* manager.syncPlutoniumWindows([window]);
+      // Unchanged: nothing to say.
+      yield* manager.syncPlutoniumWindows([window]);
+      const forClients = yield* manager.listForClients({ threadId });
+      expect(forClients.sessions.map((session) => session.tabId)).toEqual([
+        page.tabId,
+        window.tabId,
+      ]);
+      expect(forClients.sessions[1]).toMatchObject({
+        runtime: "server",
+        navStatus: { _tag: "Success", url: "app://org.kde.kwrite", title: "Untitled" },
+      });
+      // Agents and the server's browser see pages only.
+      expect((yield* manager.list({ threadId })).sessions.map((session) => session.tabId)).toEqual([
+        page.tabId,
+      ]);
+
+      yield* manager.syncPlutoniumWindows([{ ...window, title: "notes.txt" }]);
+      yield* manager.syncPlutoniumWindows([]);
+      const events = yield* collector.drain;
+      expect(events.map((event) => [event.type, event.tabId])).toEqual([
+        ["opened", page.tabId],
+        ["opened", window.tabId],
+        ["navigated", window.tabId],
+        ["closed", window.tabId],
+      ]);
+      // One ordering for pages and windows, as clients apply events by revision.
+      const revisions = events.map((event) => event.revision);
+      expect(revisions).toEqual([...revisions].toSorted((a, b) => a - b));
+      expect(new Set(revisions).size).toBe(revisions.length);
+      // The page is untouched.
+      expect((yield* manager.listForClients({ threadId })).sessions.map((s) => s.tabId)).toEqual([
+        page.tabId,
+      ]);
+    }),
+  );
+
+  it.effect("moves a window's tab to the thread it was moved to", () =>
+    Effect.gen(function* () {
+      const from = freshThreadId();
+      const to = freshThreadId();
+      const manager = yield* PreviewManager.PreviewManager;
+      const window = { tabId: "plutonium-window-8-100", url: "app://gimp", title: "GIMP" };
+      yield* manager.syncPlutoniumWindows([{ ...window, threadId: from }]);
+      yield* manager.syncPlutoniumWindows([{ ...window, threadId: to }]);
+      expect((yield* manager.listForClients({ threadId: from })).sessions).toEqual([]);
+      expect(
+        (yield* manager.listForClients({ threadId: to })).sessions.map((s) => s.tabId),
+      ).toEqual([window.tabId]);
+      yield* manager.syncPlutoniumWindows([]);
+    }),
+  );
+});
