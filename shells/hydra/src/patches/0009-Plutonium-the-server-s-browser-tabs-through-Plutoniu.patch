+          return ++moves > 3 ? new Promise<void>(() => {}) : Promise.resolve();
+        },
+        down: async ({ button }: { button: string }) => void sent.push(`down ${button}`),
+        up: async ({ button }: { button: string }) => void sent.push(`up ${button}`),
+      },
+      keyboard: {
+        down: async (key: string) => void sent.push(`keydown ${key}`),
+        up: async (key: string) => void sent.push(`keyup ${key}`),
