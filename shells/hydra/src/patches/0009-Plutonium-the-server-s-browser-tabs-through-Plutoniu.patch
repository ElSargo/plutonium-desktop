+    void ServerBrowserPage.drag(page, {
+      path: [
+        { x: 0, y: 0 },
+        { x: 40, y: 0 },
+      ],
+      button: "left",
+      modifiers: ["Shift"],
+    });
+    await new Promise((resolve) => setImmediate(resolve));
+    expect(sent.at(-1)).toBe("move 24,0");
+    ServerBrowserPage.abandonInput(page);
+    await new Promise((resolve) => setImmediate(resolve));
+    expect(sent.slice(-2)).toEqual(["up left", "keyup Shift"]);
+    // Nothing more is sent once it was abandoned, even if the stuck move ever returns.
+    const count = sent.length;
+    for (let turn = 0; turn < 5; turn++) await new Promise((resolve) => setImmediate(resolve));
+    expect(sent.length).toBe(count);
