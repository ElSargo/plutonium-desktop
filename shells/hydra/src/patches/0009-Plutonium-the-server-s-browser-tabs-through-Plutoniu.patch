+/** Plutonium: the helper's desktop browser connection, after its upgrade handshake. */
+const connectPlutoniumHelper = (socketPath: string) =>
+  Effect.callback<NodeNet.Socket, PlutoniumHelperConnectError>((resume) => {
+    const socket = NodeNet.connect(socketPath);
+    let head = Buffer.alloc(0);
+    const fail = (error: { readonly message: string }) => {
+      socket.destroy();
+      resume(Effect.fail(new PlutoniumHelperConnectError({ message: error.message })));
+    };
+    const onData = (chunk: Buffer) => {
+      head = Buffer.concat([head, chunk]);
+      const end = head.indexOf("\r\n\r\n");
+      if (end < 0) return;
+      socket.off("data", onData);
+      socket.off("error", fail);
+      if (!head.subarray(0, end).toString("latin1").startsWith("HTTP/1.1 101")) {
+        fail({ message: "The Plutonium helper has no server-driven tabs." });
+        return;
+      }
+      // Nothing reads until the channel's stream does.
+      socket.pause();
+      const rest = head.subarray(end + 4);
+      if (rest.length > 0) socket.unshift(rest);
+      resume(Effect.succeed(socket));
+    };
+    socket.once("error", fail);
+    socket.on("data", onData);
+    socket.once("connect", () =>
+      socket.write(
+        "GET /v1/desktop-browser HTTP/1.1\r\nHost: plutonium\r\n" +
+          "Connection: Upgrade\r\nUpgrade: plutonium-desktop-browser\r\n\r\n",
+      ),
+    );
+    return Effect.sync(() => socket.destroy());
+  });
