+import { describe, expect, it } from "vite-plus/test";
+
+import { withRecordingDuration } from "./recordingDuration.ts";
+
+const element = (id: number[], body: Buffer, unknownSize = false) =>
+  Buffer.concat([
+    Buffer.from(id),
+    unknownSize
+      ? Buffer.from([0x01, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff])
+      : Buffer.from([0x80 | body.length]),
+    body,
+  ]);
+
+/** What MediaRecorder writes: a live Segment, an Info without a Duration, then clusters. */
+const webm = () =>
+  Buffer.concat([
+    element([0x1a, 0x45, 0xdf, 0xa3], element([0x42, 0x82], Buffer.from("webm"))),
+    element(
+      [0x18, 0x53, 0x80, 0x67],
+      Buffer.concat([
+        element(
+          [0x15, 0x49, 0xa9, 0x66],
+          Buffer.concat([
+            element([0x2a, 0xd7, 0xb1], Buffer.from([0x0f, 0x42, 0x40])),
+            element([0x4d, 0x80], Buffer.from("Chrome")),
+          ]),
+        ),
+        element([0x1f, 0x43, 0xb6, 0x75], Buffer.from([0xe7, 0x81, 0x00])),
+      ]),
+      true,
+    ),
+  ]);
+
+const box = (type: string, body: Buffer) => {
+  const header = Buffer.alloc(8);
+  header.writeUInt32BE(8 + body.length, 0);
+  header.write(type, 4, "latin1");
+  return Buffer.concat([header, body]);
+};
+
+/** A fragmented MP4's moov: every duration 0. */
+const mp4 = () => {
+  const mvhd = Buffer.alloc(100);
+  mvhd.writeUInt32BE(1000, 12);
+  const tkhd = Buffer.alloc(84);
+  const mdhd = Buffer.alloc(24);
+  mdhd.writeUInt32BE(90000, 12);
+  return Buffer.concat([
+    box("ftyp", Buffer.from("isom")),
+    box(
+      "moov",
+      Buffer.concat([
+        box("mvhd", mvhd),
+        box("trak", Buffer.concat([box("tkhd", tkhd), box("mdia", box("mdhd", mdhd))])),
+        box("mvex", box("mehd", Buffer.alloc(8))),
+      ]),
+    ),
+    box("moof", Buffer.alloc(8)),
+  ]);
+};
+
+describe("withRecordingDuration", () => {
+  it("adds a Duration to a WebM's Info", () => {
+    const original = webm();
+    const result = withRecordingDuration(original, "video/webm;codecs=vp9", 2500);
+    expect(result.length).toBe(original.length + 11);
+    const at = result.indexOf(Buffer.from([0x44, 0x89, 0x88]));
+    expect(at).toBeGreaterThan(0);
+    // In ticks of the timecode scale (1 ms here).
+    expect(result.readDoubleBE(at + 3)).toBe(2500);
+    // The Info's size grew by the element; the cluster follows it.
+    const info = result.indexOf(Buffer.from([0x15, 0x49, 0xa9, 0x66]));
+    expect(result[info + 4]! & 0x7f).toBe(original[info + 4]! - 0x80 + 11);
+    expect(result.indexOf(Buffer.from([0x1f, 0x43, 0xb6, 0x75]))).toBe(
+      info + 5 + (result[info + 4]! & 0x7f),
+    );
+  });
+
+  it("leaves a WebM that has a Duration, or isn't one, as it is", () => {
+    const once = withRecordingDuration(webm(), "video/webm", 2500);
+    expect(withRecordingDuration(once, "video/webm", 4000)).toEqual(once);
+    const junk = Buffer.from("not a video");
+    expect(withRecordingDuration(junk, "video/webm", 1000)).toEqual(junk);
+  });
+
+  it("sets an MP4's movie, track, media and fragment durations", () => {
+    const original = mp4();
+    const result = withRecordingDuration(original, "video/mp4;codecs=avc1.640033", 2500);
+    expect(result.length).toBe(original.length);
+    const mvhd = result.indexOf("mvhd", 0, "latin1") + 4;
+    expect(result.readUInt32BE(mvhd + 16)).toBe(2500);
+    const tkhd = result.indexOf("tkhd", 0, "latin1") + 4;
+    expect(result.readUInt32BE(tkhd + 20)).toBe(2500);
+    const mdhd = result.indexOf("mdhd", 0, "latin1") + 4;
+    expect(result.readUInt32BE(mdhd + 16)).toBe(225000);
+    const mehd = result.indexOf("mehd", 0, "latin1") + 4;
+    expect(result.readUInt32BE(mehd + 4)).toBe(2500);
+    expect(original.readUInt32BE(mvhd + 16)).toBe(0);
+  });
+});
