diff --git a/apps/web/src/components/HydraMark.tsx b/apps/web/src/components/HydraMark.tsx
new file mode 100644
index 0000000000..b947c3effd
--- /dev/null
+++ b/apps/web/src/components/HydraMark.tsx
@@ -0,0 +1,18 @@
+import type { SVGProps } from "react";
+
+// Plutonium's mark for Hydra, its shell built on T3 Code: three heads on one body.
+export function HydraMark(props: SVGProps<SVGSVGElement>) {
+  return (
+    <svg {...props} viewBox="2.3 2.3 19.4 19.9" fill="none" xmlns="http://www.w3.org/2000/svg">
+      <path
+        d="M12 21V8M12 19C12 14.5 5.5 15 5.5 10M12 19C12 14.5 18.5 15 18.5 10"
+        stroke="currentColor"
+        strokeWidth="2.4"
+        strokeLinecap="round"
+      />
+      <circle cx="12" cy="5.5" r="2.4" fill="currentColor" />
+      <circle cx="5.5" cy="7.5" r="2.4" fill="currentColor" />
+      <circle cx="18.5" cy="7.5" r="2.4" fill="currentColor" />
+    </svg>
+  );
+}
