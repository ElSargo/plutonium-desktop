+
+let activeContext: DockContext | null = null;
+
+/** The active thread's context, as ChatView last published it (for the sidebar's dock). */
+export function publishDockContext(context: DockContext | null): void {
+  activeContext = context;
+  const next: ActiveDock | null = context
+    ? {
+        threadKey: scopedThreadKey(context.threadRef),
+        threadRef: context.threadRef,
+        projectId: context.projectId,
+        activeSurfaceId: context.activeSurfaceId,
+        panelOpen: context.panelOpen,
+        terminalOpen: context.terminalOpen,
+      }
+    : null;
+  const previous = useActiveDockStore.getState().active;
+  const same =
+    previous === next ||
+    (previous !== null &&
+      next !== null &&
+      previous.threadKey === next.threadKey &&
+      previous.projectId === next.projectId &&
+      previous.activeSurfaceId === next.activeSurfaceId &&
+      previous.panelOpen === next.panelOpen &&
+      previous.terminalOpen === next.terminalOpen);
+  if (!same) useActiveDockStore.setState({ active: next });
+}
+
+/** The dock's button for slot `slotNumber` was clicked. */
+export function clickDockSlot(slotNumber: DockSlotNumber): void {
+  if (!activeContext) {
+    toastManager.add({ type: "info", title: "Open a thread first", timeout: 2500 });
+    return;
+  }
+  runDockSlot(activeContext, slotNumber, { click: true });
+}
+
+/** What the sidebar's dock shows about the active thread. */
+export interface ActiveDock {
+  readonly threadKey: string;
+  readonly threadRef: ScopedThreadRef;
+  readonly projectId: string | null;
+  readonly activeSurfaceId: string | null;
+  readonly panelOpen: boolean;
+  readonly terminalOpen: boolean;
+}
+
+export const useActiveDockStore = create<{ readonly active: ActiveDock | null }>(() => ({
+  active: null,
+}));
+
+export type DockSlotState = "empty" | "idle" | "running" | "showing";
+
+/**
+ * Slot `slot`'s state in the active thread: nothing set, set but nothing of it
+ * in its scope, running, or showing now.
+ */
+export function dockSlotState(
+  slot: DockSlot | undefined,
+  active: ActiveDock | null,
+  windows: Readonly<Record<number, NativeWindowEntry>>,
+  tabUrls: Readonly<Record<string, string>>,
+): DockSlotState {
+  if (!slot) return "empty";
+  if (!active) return "idle";
+  const target = slot.target;
+  if (target.kind === "terminal") return active.terminalOpen ? "showing" : "idle";
+  let ids: string[];
+  if (target.kind === "app") {
+    const tag = scopeTagOf(slot.scope, active);
+    if (!tag) return "idle";
+    ids = Object.values(windows)
+      .filter((entry) => windowTags(entry).includes(tag) && windowMatches(target, entry))
+      .map((entry) => `app:${entry.id}`);
+  } else {
+    const prefix = siteMatchOf(target);
+    ids = Object.entries(tabUrls)
+      .filter(([, url]) => url.startsWith(prefix))
+      .map(([tabId]) => `browser:${tabId}`);
+  }
+  if (ids.length === 0) return "idle";
+  return active.panelOpen && active.activeSurfaceId && ids.includes(active.activeSurfaceId)
+    ? "showing"
+    : "running";
+}
+
+/** The active thread's tab showing in the panel, if it can go in the dock. */
+export function activeDockableSurface(): RightPanelSurface | null {
+  const context = activeContext;
+  if (!context?.panelOpen) return null;
+  const surface = context.surfaces.find((entry) => entry.id === context.activeSurfaceId);
+  if (!surface) return null;
+  return surface.kind === "app" || (surface.kind === "preview" && surface.resourceId)
+    ? surface
+    : null;
+}
+
+/** Puts the panel's tab (or, with `terminal`, the terminal drawer) in slot `slotNumber`. */
+export function assignActiveDockSlot(slotNumber: DockSlotNumber, terminal: boolean): void {
+  if (!activeContext) return;
+  const surface = terminal ? null : activeDockableSurface();
+  if (!terminal && !surface) return;
+  void assignDockSlot(activeContext, slotNumber, surface);
+}
+
+/** Keeps slot `slotNumber` in `scope`, from the active thread. */
+export function setActiveDockSlotScope(slotNumber: DockSlotNumber, scope: DockScope): void {
+  if (activeContext) void setDockSlotScope(activeContext, slotNumber, scope);
+}
