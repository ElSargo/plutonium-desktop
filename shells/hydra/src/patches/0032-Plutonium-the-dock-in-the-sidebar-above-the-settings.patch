+// Plutonium: the dock in the sidebar, above the settings row. One button per
+// slot (Super+1…9), wrapping to the sidebar's width. A click runs the slot as
+// its key does; a right click changes it (dock.ts).
+import type { ContextMenuItem } from "@t3tools/contracts";
+import { AppWindowIcon, GlobeIcon, SquareTerminalIcon } from "lucide-react";
+import { memo, useEffect, useMemo, useState } from "react";
+
+import { Tooltip, TooltipPopup, TooltipTrigger } from "~/components/ui/tooltip";
+import { cn } from "~/lib/utils";
+import { readLocalApi } from "~/localApi";
+import { useThreadPreviewState } from "~/previewStateStore";
+
+import {
+  activeDockableSurface,
+  assignActiveDockSlot,
+  clickDockSlot,
+  DOCK_SLOT_NUMBERS,
+  type DockLayout,
+  type DockScope,
+  type DockSlot,
+  type DockSlotNumber,
+  type DockSlotState,
+  dockSlotLabel,
+  dockSlotState,
+  setActiveDockSlotScope,
+  useActiveDockStore,
+  useDockStore,
+} from "./dock";
+import { isPlutoniumShell, plutoniumShell, usePlutoniumWindowStore } from "./windowStore";
+
+const SCOPE_TEXT: Record<DockScope, string> = {
+  thread: "this thread's",
+  project: "this project's",
+  global: "everywhere",
+};
+
+const STATE_TEXT: Record<DockSlotState, string> = {
+  empty: "Empty: Super+Shift+{n} puts what has the keyboard here",
+  idle: "Click to start",
+  running: "Click to show",
+  showing: "Click to go back",
+};
+
+function SlotIcon({ slot }: { slot: DockSlot }) {
+  const target = slot.target;
+  const desktopId = target.kind === "app" ? target.desktopId : null;
+  const [url, setUrl] = useState<string | null>(null);
+  useEffect(() => {
+    if (!desktopId) return;
+    let live = true;
+    void plutoniumShell()
+      .then((shell) => shell?.appIcon(desktopId) ?? null)
+      .then((icon) => live && setUrl(icon))
+      .catch(() => undefined);
+    return () => {
+      live = false;
+    };
+  }, [desktopId]);
+  if (target.kind === "terminal") return <SquareTerminalIcon className="size-4" />;
+  if (target.kind === "site") return <GlobeIcon className="size-4" />;
+  return url ? (
+    <img alt="" className="size-4 object-contain" src={url} />
+  ) : (
+    <AppWindowIcon className="size-4" />
+  );
+}
+
+function slotMenu(
+  number: DockSlotNumber,
+  slot: DockSlot | undefined,
+  layout: DockLayout,
+): ContextMenuItem[] {
+  const items: ContextMenuItem[] = [];
+  const dockable = activeDockableSurface();
+  items.push({
+    id: "put-tab",
+    label: slot ? "Replace with the panel's tab" : "Put the panel's tab here",
+    disabled: dockable === null,
+  });
+  items.push({
+    id: "put-terminal",
+    label: slot ? "Replace with the terminal" : "Put the terminal here",
+  });
+  if (!slot) return items;
+  if (slot.target.kind === "app") {
+    items.push({
+      id: "scope",
+      label: "Keep it",
+      separatorBefore: true,
+      children: (
+        [
+          ["thread", "In each thread"],
+          ["project", "In each project"],
+          ["global", "Everywhere"],
+        ] as const
+      ).map(([value, label]) => ({
+        id: `scope-${value}`,
+        label,
+        checked: value === slot.scope,
+      })),
+    });
+  }
+  items.push({
+    id: "layout",
+    label: "Layout",
+    separatorBefore: slot.target.kind !== "app",
+    children: [
+      { id: "layout-split", label: "Beside the chat", checked: layout === "split" },
+      { id: "layout-fold", label: "Fold the chat away", checked: layout === "fold" },
+    ],
+  });
+  items.push({ id: "clear", label: `Clear Super+${number}`, separatorBefore: true });
+  return items;
+}
+
+async function showSlotMenu(event: React.MouseEvent, number: DockSlotNumber): Promise<void> {
+  event.preventDefault();
+  const api = readLocalApi();
+  if (!api) return;
+  const dock = useDockStore.getState();
+  const slot = dock.slots[number];
+  const layout = slot?.layout ?? "split";
+  const action = await api.contextMenu.show(slotMenu(number, slot, layout), {
+    x: event.clientX,
+    y: event.clientY,
+  });
+  if (action === "put-tab") assignActiveDockSlot(number, false);
+  else if (action === "put-terminal") assignActiveDockSlot(number, true);
+  else if (action === "clear") dock.setSlot(number, null);
+  else if (action?.startsWith("scope-") && slot) {
+    setActiveDockSlotScope(number, action.slice("scope-".length) as DockScope);
+  } else if (action?.startsWith("layout-") && slot) {
+    dock.setSlot(number, { ...slot, layout: action.slice("layout-".length) as DockLayout });
+  }
+}
+
+const DockButton = memo(function DockButton(props: {
+  number: DockSlotNumber;
+  slot: DockSlot | undefined;
+  state: DockSlotState;
+}) {
+  const { number, slot, state } = props;
+  const name = dockSlotLabel(slot);
+  const detail = slot
+    ? `${slot.target.kind === "terminal" ? "the thread's terminal" : `${SCOPE_TEXT[slot.scope]} ${name}`}`
+    : null;
+  return (
+    <Tooltip>
+      <TooltipTrigger
+        render={
+          <button
+            type="button"
+            aria-label={`Super+${number}: ${name}`}
+            data-dock-slot={number}
+            data-dock-state={state}
+            // The click mustn't take the keyboard from what has it.
+            onMouseDown={(event) => event.preventDefault()}
+            onClick={() => (slot ? clickDockSlot(number) : undefined)}
+            onContextMenu={(event) => void showSlotMenu(event, number)}
+            className={cn(
+              "relative flex h-7 min-w-0 items-center justify-center rounded-md text-sidebar-muted-foreground transition-colors",
+              "hover:bg-sidebar-row-hover hover:text-sidebar-foreground",
+              state === "empty" && "opacity-35",
+              state === "idle" && "opacity-60",
+              state === "running" && "text-sidebar-foreground",
+              state === "showing" &&
+                "bg-sidebar-row-hover text-sidebar-foreground ring-1 ring-sidebar-border",
+            )}
+          >
+            {slot ? <SlotIcon slot={slot} /> : <span className="size-1 rounded-full bg-current" />}
+            <span className="pointer-events-none absolute top-0 right-0.5 text-4xs leading-none tabular-nums opacity-70">
+              {number}
+            </span>
+            {state === "running" || state === "showing" ? (
+              <span className="pointer-events-none absolute bottom-0.5 left-1/2 size-0.5 -translate-x-1/2 rounded-full bg-current" />
+            ) : null}
+          </button>
+        }
+      />
+      <TooltipPopup side="top">
+        <div className="font-medium">
+          Super+{number}
+          {slot ? `: ${name}` : ""}
+        </div>
+        {detail ? <div className="text-muted-foreground">{detail}</div> : null}
+        <div className="text-muted-foreground">
+          {STATE_TEXT[state].replace("{n}", String(number))}
+        </div>
+      </TooltipPopup>
+    </Tooltip>
+  );
+});
+
+/** The dock, above the sidebar's settings row. Nothing outside the Plutonium shell. */
+export const PlutoniumDock = memo(function PlutoniumDock() {
+  if (!isPlutoniumShell()) return null;
+  return <Dock />;
+});
+
+function Dock() {
+  const slots = useDockStore((state) => state.slots);
+  const active = useActiveDockStore((state) => state.active);
+  const windows = usePlutoniumWindowStore((state) => state.windows);
+  const preview = useThreadPreviewState(active?.threadRef ?? null);
+  const tabUrls = useMemo(() => {
+    const urls: Record<string, string> = {};
+    for (const session of Object.values(preview.sessions)) {
+      const status = session.navStatus as { url?: string };
+      if (typeof status.url === "string") urls[session.tabId] = status.url;
+    }
+    return urls;
+  }, [preview.sessions]);
+  return (
+    <div
+      role="toolbar"
+      aria-label="Dock"
+      data-plutonium-dock
+      className="grid grid-cols-[repeat(auto-fill,minmax(1.375rem,1fr))] gap-0.5 px-1"
+    >
+      {DOCK_SLOT_NUMBERS.map((number) => (
+        <DockButton
+          key={number}
+          number={number}
+          slot={slots[number]}
+          state={dockSlotState(slots[number], active, windows, tabUrls)}
+        />
+      ))}
+    </div>
+  );
+}
