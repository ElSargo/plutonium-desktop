From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Mon, 2 Nov 2026 09:12:33 +1300
Subject: [PATCH 50/56] Plutonium: dock sites' icons from the helper

A site's /favicon.ico can't always be shown from the page: some sites
forbid other origins it (claude.ai's Cross-Origin-Resource-Policy:
same-origin), many name their icon with <link rel="icon">. After an open
tab's and the remembered one, the dock now asks the shell library's
siteIcon (the helper fetches it); with an older library, the page's own
/favicon.ico as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/web/src/plutonium/PlutoniumDock.tsx | 55 +++++++++++++++++++++++-
 apps/web/src/plutonium/windowStore.ts    |  2 +
 2 files changed, 55 insertions(+), 2 deletions(-)

diff --git a/apps/web/src/plutonium/PlutoniumDock.tsx b/apps/web/src/plutonium/PlutoniumDock.tsx
index a5c1d164e2..114ea0a8b9 100644
--- a/apps/web/src/plutonium/PlutoniumDock.tsx
+++ b/apps/web/src/plutonium/PlutoniumDock.tsx
@@ -99,7 +99,50 @@ function AppIcon({ desktopId, className }: { desktopId: string | null; className
   );
 }
 
-/** A site's icon: an open tab's, else the one T3 remembers for it, else the site's own. */
+const siteIcons = new Map<string, Promise<string | null>>();
+
+/**
+ * A site's own icon, fetched by the helper (undefined until it answers, null
+ * if it has none or the shell library is older). The page can't always load
+ * it itself: some sites forbid other origins their /favicon.ico (claude.ai),
+ * many name theirs elsewhere.
+ */
+function useHelperSiteIcon(pageUrl: string): string | null | undefined {
+  const origin = siteOrigin(pageUrl);
+  const [icon, setIcon] = useState<{ origin: string; url: string | null } | null>(null);
+  useEffect(() => {
+    if (!origin) return;
+    let live = true;
+    let found = siteIcons.get(origin);
+    if (!found) {
+      found = plutoniumShell()
+        .then((shell) => shell?.siteIcon?.(origin) ?? null)
+        .catch(() => null);
+      siteIcons.set(origin, found);
+    }
+    void found.then((url) => live && setIcon({ origin, url }));
+    return () => {
+      live = false;
+    };
+  }, [origin]);
+  if (!origin) return null;
+  return icon?.origin === origin ? icon.url : undefined;
+}
+
+function siteOrigin(pageUrl: string): string | null {
+  try {
+    const url = new URL(pageUrl);
+    return url.protocol === "http:" || url.protocol === "https:" ? url.origin : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * A site's icon: an open tab's, else the one T3 remembers for it, else the
+ * site's own (fetched by the helper; the page's own request to /favicon.ico
+ * when there's no helper to ask).
+ */
 function SiteIcon(props: {
   target: SiteTarget;
   threadRef: ScopedThreadRef | null;
@@ -134,9 +177,17 @@ function SiteIconImage(props: {
   const { resolvedTheme } = useTheme();
   const own = toolActivityFaviconUrl({ pageUrl: props.target.url }, resolvedTheme);
   const themed = own && !own.endsWith("/favicon.ico") ? own : null;
+  const fetched = useHelperSiteIcon(props.target.url);
   return (
     <FaviconImage
-      sources={[themed, props.live, props.remembered, props.target.icon, own]}
+      sources={[
+        themed,
+        props.live,
+        props.remembered,
+        props.target.icon,
+        fetched,
+        fetched === null ? own : null,
+      ]}
       fallback={<GlobeIcon className={props.className} />}
       className={cn(props.className, "rounded-sm object-contain")}
     />
diff --git a/apps/web/src/plutonium/windowStore.ts b/apps/web/src/plutonium/windowStore.ts
index 21fcebd84e..9a79ef095b 100644
--- a/apps/web/src/plutonium/windowStore.ts
+++ b/apps/web/src/plutonium/windowStore.ts
@@ -100,6 +100,8 @@ interface PlutoniumShell extends EventTarget {
   showOnDesktop(windowId: number): void;
   apps(): Promise<DesktopApp[]>;
   appIcon(appId: string): Promise<string | null>;
+  /** An object URL for a website's own icon, fetched by the helper (older libraries: missing). */
+  siteIcon?(pageUrl: string): Promise<string | null>;
   launchApp(
     threadId: string,
     appId: string,
