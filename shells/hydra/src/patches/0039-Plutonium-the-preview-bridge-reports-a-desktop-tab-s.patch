From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Tue, 27 Oct 2026 23:01:35 +1300
Subject: [PATCH 39/56] Plutonium: the preview bridge reports a desktop tab's
 page zoom

toState() read zoomFactor as 1; it now comes from the tab's "zoom" state
(percent, in the broker entry's stateJson), so the agent's cursor in the
panel lines up on a zoomed tab.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/web/src/plutonium/previewBridge.test.ts | 19 +++++++++++++++++++
 apps/web/src/plutonium/previewBridge.ts      | 15 ++++++++++++++-
 2 files changed, 33 insertions(+), 1 deletion(-)
 create mode 100644 apps/web/src/plutonium/previewBridge.test.ts

diff --git a/apps/web/src/plutonium/previewBridge.test.ts b/apps/web/src/plutonium/previewBridge.test.ts
new file mode 100644
index 0000000000..9d17aeedc2
--- /dev/null
+++ b/apps/web/src/plutonium/previewBridge.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { type BrokerTab, zoomFactorOf } from "./previewBridge";
+
+const tab = (stateJson?: string) => ({ stateJson }) as unknown as BrokerTab;
+
+describe("zoomFactorOf", () => {
+  it("reads the tab's zoom state, in percent", () => {
+    expect(zoomFactorOf(tab('{"zoom":150,"zoomDefault":false}'))).toBe(1.5);
+    expect(zoomFactorOf(tab('{"zoom":90}'))).toBe(0.9);
+  });
+
+  it("is 1 without a zoom", () => {
+    expect(zoomFactorOf(null)).toBe(1);
+    expect(zoomFactorOf(tab())).toBe(1);
+    expect(zoomFactorOf(tab("{}"))).toBe(1);
+    expect(zoomFactorOf(tab("not json"))).toBe(1);
+  });
+});
diff --git a/apps/web/src/plutonium/previewBridge.ts b/apps/web/src/plutonium/previewBridge.ts
index e1363c3f2d..4bc8677c67 100644
--- a/apps/web/src/plutonium/previewBridge.ts
+++ b/apps/web/src/plutonium/previewBridge.ts
@@ -57,6 +57,8 @@ export interface BrokerTab {
   readonly dialogDefaultPrompt: string;
   /** In throwaway storage of its own (browsers with incognito tabs; older: missing). */
   readonly incognito?: boolean;
+  /** Feature state as a JSON object, e.g. "zoom" in percent (browsers with tab features; older: missing). */
+  readonly stateJson?: string;
 }
 
 interface BrowserTabEvent extends Event {
@@ -632,7 +634,7 @@ function toState(runtimeTabId: string, entry: BrokerTab | null): DesktopPreviewT
     navStatus,
     canGoBack: entry?.canGoBack ?? false,
     canGoForward: entry?.canGoForward ?? false,
-    zoomFactor: 1,
+    zoomFactor: zoomFactorOf(entry),
     pictureInPicture: false,
     colorScheme: "system",
     audioMuted: false,
@@ -642,6 +644,17 @@ function toState(runtimeTabId: string, entry: BrokerTab | null): DesktopPreviewT
   };
 }
 
+/** The tab's page zoom (its "zoom" state, in percent), 1 when it has none. */
+export function zoomFactorOf(entry: BrokerTab | null): number {
+  if (!entry?.stateJson) return 1;
+  try {
+    const zoom = (JSON.parse(entry.stateJson) as { zoom?: unknown }).zoom;
+    return typeof zoom === "number" && zoom > 0 ? zoom / 100 : 1;
+  } catch {
+    return 1;
+  }
+}
+
 const unsupported = (what: string) => () =>
   Promise.reject(new Error(`${what} is not available in the Plutonium browser yet`));
 const ignored = () => Promise.resolve();
