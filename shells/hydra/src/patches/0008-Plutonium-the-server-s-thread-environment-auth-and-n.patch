diff --git a/apps/server/src/plutonium/networkAccess.ts b/apps/server/src/plutonium/networkAccess.ts
new file mode 100644
index 0000000000..c3a2bfd040
--- /dev/null
+++ b/apps/server/src/plutonium/networkAccess.ts
@@ -0,0 +1,108 @@
+/**
+ * Plutonium: network access from Settings, Connections in the shell.
+ *
+ * T3's desktop app switches "Network access" by restarting its backend on
+ * another host. In a Plutonium session the shell is a browser page, and the
+ * server is started by Plutonium's launcher, which runs it under a supervisor
+ * (PLUTONIUM_T3_SUPERVISED): the supervisor binds it to 0.0.0.0 or 127.0.0.1
+ * from the file this route writes, and starts it again when the file changes
+ * while it runs. So switching saves the choice and stops the server, and the
+ * supervisor starts it on the new host. T3_HOST in Plutonium's settings pins
+ * the host (PLUTONIUM_T3_HOST_PINNED): then this only reports it.
+ *
+ *   GET  /api/plutonium/network-access  {mode, switchable}
+ *   POST /api/plutonium/network-access  {mode}: environment:maintain, as the
+ *        desktop app's switch.
+ */
+import { AuthEnvironmentMaintainScope, type DesktopServerExposureMode } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import { HttpRouter, HttpServerRequest, HttpServerResponse } from "effect/http";
+
+import * as EnvironmentAuth from "../auth/EnvironmentAuth.ts";
+import { isRemoteReachableHost } from "../auth/utils.ts";
+import * as ServerConfig from "../config.ts";
+
+export const PLUTONIUM_NETWORK_ACCESS_ROUTE = "/api/plutonium/network-access";
+/** In T3's home; the launcher's supervisor reads it. */
+export const PLUTONIUM_NETWORK_ACCESS_FILE = "plutonium-network-access";
+
+/** Long enough for the response to reach the page before the server stops. */
+const RESTART_DELAY_MS = 300;
+const NO_STORE = { "cache-control": "no-store" };
+
+const isSupervised = () => process.env.PLUTONIUM_T3_SUPERVISED === "1";
+const isHostPinned = () => process.env.PLUTONIUM_T3_HOST_PINNED === "1";
+
+const currentMode = (host: string | undefined): DesktopServerExposureMode =>
+  isRemoteReachableHost(host) ? "network-accessible" : "local-only";
+
+const handler = Effect.gen(function* () {
+  const request = yield* HttpServerRequest.HttpServerRequest;
+  const config = yield* ServerConfig.ServerConfig;
+  const switchable = isSupervised() && !isHostPinned();
+  const state = { mode: currentMode(config.host), switchable, pinned: isHostPinned() };
+  if (request.method === "GET") return HttpServerResponse.jsonUnsafe(state, { headers: NO_STORE });
+  if (request.method !== "POST")
+    return HttpServerResponse.text("Method Not Allowed", { status: 405 });
+
+  // A form can't send JSON across origins without a preflight, which this
+  // route doesn't answer; the session cookie is SameSite=Lax besides.
+  if (!request.headers["content-type"]?.startsWith("application/json")) {
+    return HttpServerResponse.text("Expected application/json.", { status: 415 });
+  }
+  const serverAuth = yield* EnvironmentAuth.EnvironmentAuth;
+  const session = yield* serverAuth
+    .authenticateHttpRequest(request)
+    .pipe(Effect.orElseSucceed(() => null));
+  if (session === null) return HttpServerResponse.text("Unauthorized", { status: 401 });
+  if (!session.scopes.includes(AuthEnvironmentMaintainScope)) {
+    return HttpServerResponse.text(`Requires ${AuthEnvironmentMaintainScope}.`, { status: 403 });
+  }
+  if (!switchable) {
+    return HttpServerResponse.text(
+      isHostPinned()
+        ? "T3_HOST in Plutonium's settings sets the server's host."
+        : "This server wasn't started by Plutonium's launcher.",
+      { status: 409 },
+    );
+  }
+  const body = yield* request.json.pipe(Effect.orElseSucceed(() => null));
+  const mode = (body as { mode?: unknown } | null)?.mode;
+  if (mode !== "network-accessible" && mode !== "local-only") {
+    return HttpServerResponse.text('mode is "network-accessible" or "local-only".', {
+      status: 400,
+    });
+  }
+  if (mode === state.mode)
+    return HttpServerResponse.jsonUnsafe({ ...state, restarting: false }, { headers: NO_STORE });
+
+  const fileSystem = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const failed = yield* fileSystem
+    .writeFileString(path.join(config.baseDir, PLUTONIUM_NETWORK_ACCESS_FILE), `${mode}\n`)
+    .pipe(
+      Effect.as(false),
+      Effect.catch((error) =>
+        Effect.logError("plutonium: couldn't save network access", { cause: error }).pipe(
+          Effect.as(true),
+        ),
+      ),
+    );
+  if (failed) {
+    return HttpServerResponse.text("Couldn't save the setting.", { status: 500 });
+  }
+  yield* Effect.logInfo(`plutonium: network access ${mode}; restarting`);
+  // The supervisor starts it again on the new host.
+  yield* Effect.sleep(RESTART_DELAY_MS).pipe(
+    Effect.andThen(Effect.sync(() => process.kill(process.pid, "SIGTERM"))),
+    Effect.forkDetach,
+  );
+  return HttpServerResponse.jsonUnsafe({ ...state, mode, restarting: true }, { headers: NO_STORE });
+});
+
+export const layer = process.env.PLUTONIUM_T3
+  ? HttpRouter.add("*", PLUTONIUM_NETWORK_ACCESS_ROUTE, handler)
+  : Layer.empty;
diff --git a/apps/server/src/plutonium/threadPermissions.test.ts b/apps/server/src/plutonium/threadPermissions.test.ts
new file mode 100644
index 0000000000..e0599d2e6f
--- /dev/null
+++ b/apps/server/src/plutonium/threadPermissions.test.ts
@@ -0,0 +1,78 @@
+// @effect-diagnostics nodeBuiltinImport:off - a fake Plutonium helper on a Unix socket
+import { expect, it } from "@effect/vitest";
+import type { OrchestrationV2DomainEvent } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Stream from "effect/Stream";
+import * as NodeFS from "node:fs";
+import * as NodeHttp from "node:http";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+import * as Orchestrator from "../orchestration-v2/Orchestrator.ts";
+import * as ThreadPermissions from "./threadPermissions.ts";
+
+/** A helper that records the paths it was asked for. */
+const fakeHelper = Effect.acquireRelease(
+  Effect.promise(async () => {
+    const dir = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "t3-plutonium-permissions-"));
+    const socketPath = NodePath.join(dir, "helper.sock");
+    const calls: string[] = [];
+    const server = NodeHttp.createServer((request, response) => {
+      calls.push(`${request.method} ${request.url}`);
+      response.setHeader("Content-Type", "application/json");
+      response.end('{"revoked":1}');
+    });
+    await new Promise<void>((resolve) => server.listen(socketPath, resolve));
+    return { dir, server, socketPath, calls };
+  }),
+  ({ dir, server }) =>
+    Effect.promise(
+      () =>
+        new Promise<void>((resolve) =>
+          server.close(() => {
+            NodeFS.rmSync(dir, { recursive: true, force: true });
+            resolve();
+          }),
+        ),
+    ),
+);
+
+const withHelper = (socketPath: string) =>
+  Effect.acquireRelease(
+    Effect.sync(() => {
+      const previous = process.env.PLUTONIUM_HELPER;
+      process.env.PLUTONIUM_HELPER = socketPath;
+      return previous;
+    }),
+    (previous) =>
+      Effect.sync(() => {
+        if (previous === undefined) delete process.env.PLUTONIUM_HELPER;
+        else process.env.PLUTONIUM_HELPER = previous;
+      }),
+  );
+
+const event = (type: string, threadId: string) =>
+  ({ type, threadId }) as unknown as OrchestrationV2DomainEvent;
+
+it.live("forgets an archived or deleted thread's grants, not a settled one's", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const helper = yield* fakeHelper;
+      yield* withHelper(helper.socketPath);
+      const orchestrator = Layer.succeed(Orchestrator.OrchestratorV2, {
+        streamDomainEvents: Stream.make(
+          event("thread.archived", "a"),
+          event("thread.settled", "b"),
+          event("thread.deleted", "c"),
+        ),
+      } as unknown as Orchestrator.OrchestratorV2["Service"]);
+      yield* Layer.build(ThreadPermissions.layer.pipe(Layer.provide(orchestrator)));
+      for (let i = 0; i < 100 && helper.calls.length < 2; i++) yield* Effect.sleep("10 millis");
+      expect(helper.calls).toEqual([
+        "POST /v1/threads/t3%3Athread%2Fa/permissions/forget",
+        "POST /v1/threads/t3%3Athread%2Fc/permissions/forget",
+      ]);
+    }),
+  ),
+);
diff --git a/apps/server/src/plutonium/threadPermissions.ts b/apps/server/src/plutonium/threadPermissions.ts
new file mode 100644
index 0000000000..1e4c790112
--- /dev/null
+++ b/apps/server/src/plutonium/threadPermissions.ts
@@ -0,0 +1,90 @@
+// @effect-diagnostics nodeBuiltinImport:off - requests go to the Plutonium helper's Unix socket
+/**
+ * Plutonium: an archived or deleted thread loses its permission grants.
+ *
+ * Plutonium's browser keeps a thread's permission decisions (camera,
+ * notifications, ...) per thread tag until a shell revokes them; it doesn't
+ * know about threads' lifecycles. So whenever a thread is archived or deleted,
+ * by the user or an agent, this server tells the helper
+ * (POST /v1/threads/:tag/permissions/forget), which has a shell page do it
+ * (`shell.forgetThreadPermissions`), or the next page to connect.
+ */
+import { plutoniumHelperSocket, plutoniumThreadTag } from "@t3tools/shared/plutonium";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import * as Stream from "effect/Stream";
+import * as NodeHttp from "node:http";
+
+import * as Orchestrator from "../orchestration-v2/Orchestrator.ts";
+import { forkParked } from "../serverActivation.ts";
+
+const REQUEST_TIMEOUT_MS = 10_000;
+
+export class PlutoniumForgetPermissionsError extends Schema.TaggedError<PlutoniumForgetPermissionsError>()(
+  "PlutoniumForgetPermissionsError",
+  { message: Schema.String },
+) {}
+
+/** Asks the helper on `socketPath` to forget `threadId`'s grants. */
+export const forgetThreadPermissions = (socketPath: string, threadId: string) =>
+  Effect.tryPromise({
+    try: () =>
+      new Promise<number>((resolve, reject) => {
+        const tag = encodeURIComponent(plutoniumThreadTag(threadId));
+        const request = NodeHttp.request(
+          {
+            socketPath,
+            method: "POST",
+            path: `/v1/threads/${tag}/permissions/forget`,
+            timeout: REQUEST_TIMEOUT_MS,
+          },
+          (response) => {
+            response.resume();
+            response.on("end", () => resolve(response.statusCode ?? 500));
+          },
+        );
+        request.on("timeout", () => request.destroy(new Error("timed out")));
+        request.on("error", reject);
+        request.end();
+      }),
+    catch: (cause) =>
+      new PlutoniumForgetPermissionsError({
+        message: cause instanceof Error ? cause.message : String(cause),
+      }),
+  }).pipe(
+    Effect.flatMap((status) =>
+      status < 400
+        ? Effect.void
+        : Effect.fail(
+            new PlutoniumForgetPermissionsError({ message: `The helper said ${status}.` }),
+          ),
+    ),
+  );
+
+export const layer = Layer.effectDiscard(
+  Effect.gen(function* () {
+    const socketPath = plutoniumHelperSocket();
+    if (socketPath === undefined) return;
+    const engine = yield* Orchestrator.OrchestratorV2;
+    yield* forkParked(
+      Stream.runForEach(engine.streamDomainEvents, (event) =>
+        event.type === "thread.archived" || event.type === "thread.deleted"
+          ? forgetThreadPermissions(socketPath, event.threadId).pipe(
+              // An older helper has no such route (404); the grants stay.
+              Effect.catch((error) =>
+                Effect.logWarning("Plutonium: couldn't forget a thread's permissions", {
+                  threadId: event.threadId,
+                  message: error.message,
+                }),
+              ),
+            )
+          : Effect.void,
+      ).pipe(
+        Effect.catchCause((cause) =>
+          Effect.logWarning("Plutonium: the thread permission reactor stopped", { cause }),
+        ),
+      ),
+    );
+  }),
+);
