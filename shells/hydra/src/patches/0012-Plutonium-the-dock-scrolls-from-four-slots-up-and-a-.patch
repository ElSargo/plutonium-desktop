+  // 1.375rem slots with 0.125rem gaps: (width + 2) / 24 fit to a row.
+  const at = (fit: number) => fit * 24 - 2;
+
+  it("shows four to a row at least", () => {
+    expect(dockGrid(at(11), 4, rem)).toMatchObject({ columns: 4, rows: 1 });
+    expect(dockGrid(at(2), 4, rem)).toMatchObject({ columns: 4, rows: 1 });
+    expect(dockGrid(at(2), 6, rem)).toMatchObject({ columns: 4, rows: 2 });
+  });
+
+  it("puts every slot in one row while they fit", () => {
+    expect(dockGrid(at(11), 9, rem)).toMatchObject({ columns: 9, rows: 1 });
+  });
+
+  it("splits the rows evenly", () => {
+    expect(dockGrid(at(8), 10, rem)).toMatchObject({ columns: 5, rows: 2 });
+    expect(dockGrid(at(8), 12, rem)).toMatchObject({ columns: 6, rows: 2 });
+    expect(dockGrid(at(8), 24, rem)).toMatchObject({ columns: 8, rows: 3 });
+    // No even split: as even as it gets.
+    expect(dockGrid(at(6), 7, rem)).toMatchObject({ columns: 4, rows: 2 });
+  });
+
+  it("grows a slot up to 1.75rem, and shrinks it to fit four", () => {
+    expect(dockGrid(400, 4, rem).size).toBe(28);
+    expect(dockGrid(66, 4, rem).size).toBe(15);
+  });
+});
