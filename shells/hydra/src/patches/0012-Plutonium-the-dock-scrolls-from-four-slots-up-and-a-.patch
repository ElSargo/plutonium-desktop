@@ -0,0 +1,81 @@
+import "../index.css";
+
+import { describe, expect, it, vi } from "vite-plus/test";
+import { page, userEvent } from "vite-plus/test/browser";
+
+import { render } from "../../test/render";
+
+// The Plutonium shell's page has the window broker (isPlutoniumShell), from
+// before the keybindings module reads it.
+vi.hoisted(() => {
+  Object.defineProperty(navigator, "windowBroker", { value: {}, configurable: true });
+});
+
+import { type DockSlot, useDockStore } from "./dock";
+import { PlutoniumDock } from "./PlutoniumDock";
+
+const terminal: DockSlot = {
+  id: "t",
+  target: { kind: "terminal" },
+  scope: "thread",
+  layout: "split",
+};
+
+/** The dock in a sidebar `width` pixels wide, holding `count` slots. */
+async function dockOf(width: number, count: number) {
+  useDockStore.setState({ slots: { 1: terminal }, count, layouts: {} });
+  const container = document.createElement("div");
+  container.style.width = `${width}px`;
+  container.style.padding = "8px 0";
+  container.style.background = "var(--sidebar, #111)";
+  return render(<PlutoniumDock />, { container, router: false });
+}
+
+/** The dock's buttons' rows: how many buttons share each top edge. */
+function rows(): number[] {
+  const tops = new Map<number, number>();
+  for (const button of document.querySelectorAll<HTMLElement>("[data-dock-slot]")) {
+    const top = Math.round(button.getBoundingClientRect().top);
+    tops.set(top, (tops.get(top) ?? 0) + 1);
+  }
+  return [...tops.values()];
+}
+
+describe("the dock", () => {
+  it("shows four slots in a row by default", async () => {
+    await using _screen = await dockOf(256, 4);
+    await expect.poll(rows).toEqual([4]);
+  });
+
+  it("splits ten slots into two full rows where eight fit", async () => {
+    // (190 + 2) / 24 = 8 to a row.
+    await using _screen = await dockOf(198, 10);
+    await expect.poll(rows).toEqual([5, 5]);
+  });
+
+  it("scrolls past two rows", async () => {
+    await using _screen = await dockOf(198, 24);
+    await expect.poll(rows).toEqual([8, 8, 8]);
+    const list = document.querySelector<HTMLElement>("[data-plutonium-dock]")!;
+    expect(list.scrollHeight).toBeGreaterThan(list.clientHeight);
+  });
+
+  it("adds and removes slots from a slot's editor, and shows its keys", async () => {
+    await using _screen = await dockOf(256, 4);
+    const slot = document.querySelector<HTMLElement>('[data-dock-slot="2"]')!;
+    await userEvent.click(slot);
+    await expect.element(page.getByText("Super+Shift+2")).toBeVisible();
+
+    // A click on a key records another; Escape leaves it as it was.
+    await userEvent.click(page.getByText("Super+Ctrl+2"));
+    const field = page.getByPlaceholder("Press keys · Esc cancels");
+    await expect.element(field).toHaveFocus();
+    await userEvent.keyboard("{Escape}");
+    await expect.element(page.getByText("Super+Ctrl+2")).toBeVisible();
+
+    await userEvent.click(page.getByText("Add a slot", { exact: true }));
+    expect(useDockStore.getState().count).toBe(5);
+    await userEvent.click(page.getByText("Remove slot"));
+    expect(useDockStore.getState().count).toBe(4);
+  });
+});
