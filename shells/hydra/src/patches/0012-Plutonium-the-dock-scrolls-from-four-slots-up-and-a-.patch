+/** How many rows of slots show before the dock scrolls. */
+const DOCK_VISIBLE_ROWS = 2;
+
+/**
+ * The dock's grid for `count` slots in `width` pixels (`rem` pixels to the
+ * rem): as many to a row as fit at 1.375rem each, but never fewer than four,
+ * and the rows split evenly, so every row is full when the count allows
+ * (ten slots where eight fit: two rows of five). A slot grows up to 1.75rem;
+ * past that the grid centers.
+ */
+export function dockGrid(
+  width: number,
+  count: number,
+  rem: number,
+): { columns: number; rows: number; size: number; gap: number } {
+  const gap = 0.125 * rem;
+  const fit = Math.max(DOCK_MIN_SLOTS, Math.floor((width + gap) / (1.375 * rem + gap)));
+  const rows = Math.max(1, Math.ceil(count / fit));
+  const columns = Math.max(DOCK_MIN_SLOTS, Math.ceil(count / rows));
+  const size = Math.max(0, Math.min(1.75 * rem, (width - gap * (columns - 1)) / columns));
+  return { columns, rows, size, gap };
+}
+
+/** The width of `ref`'s content box, kept up to date. */
+function useContentWidth(ref: React.RefObject<HTMLElement | null>): number {
+  const [width, setWidth] = useState(0);
+  useLayoutEffect(() => {
+    const element = ref.current;
+    if (!element) return;
+    setWidth(element.clientWidth);
+    const observer = new ResizeObserver(([entry]) => {
+      if (entry) setWidth(entry.contentRect.width);
+    });
+    observer.observe(element);
+    return () => observer.disconnect();
+  }, [ref]);
+  return width;
+}
+
+const rootRem = () =>
+  typeof document === "undefined"
+    ? 16
+    : Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
