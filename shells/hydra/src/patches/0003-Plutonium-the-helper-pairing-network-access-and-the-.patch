@@ -0,0 +1,23 @@
+// Plutonium: where the helper serves the shell library. The launcher passes a
+// non-default helper as ?plutoniumHelper=<origin>; it is read at boot, before
+// any redirect (e.g. pairing) drops the query, and remembered.
+const STORAGE_KEY = "t3code:plutonium-helper";
+const DEFAULT_HELPER = "http://127.0.0.1:3780";
+
+export function rememberPlutoniumHelper(): void {
+  const fromUrl = new URLSearchParams(window.location.search).get("plutoniumHelper");
+  if (!fromUrl) return;
+  try {
+    localStorage.setItem(STORAGE_KEY, fromUrl);
+  } catch {
+    // Not persisted; the default applies after the next navigation.
+  }
+}
+
+export function plutoniumHelperOrigin(): string {
+  try {
+    return localStorage.getItem(STORAGE_KEY) ?? DEFAULT_HELPER;
+  } catch {
+    return DEFAULT_HELPER;
+  }
+}
