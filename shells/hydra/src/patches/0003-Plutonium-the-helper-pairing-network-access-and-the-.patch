+
+// Plutonium: the shell can open the page while T3's server is still starting
+// or restarting, and a chunk it asks for then fails, which left the page on
+// this error until reloaded by hand. Reload by itself once the server answers
+// again, a few times per failure streak (a successful boot clears it), so a
+// real startup bug still stops here.
+const BOOT_RETRY_KEY = "t3code:boot-retries";
+const BOOT_RETRY_LIMIT = 5;
+
+export function retryBootWhenServerAnswers() {
+  let retries: number;
+  try {
+    retries = Number(window.sessionStorage.getItem(BOOT_RETRY_KEY) ?? 0);
+    if (retries >= BOOT_RETRY_LIMIT) return;
+    window.sessionStorage.setItem(BOOT_RETRY_KEY, String(retries + 1));
+  } catch {
+    // Without storage a persistent failure would reload forever.
+    return;
+  }
+  const poll = async () => {
+    try {
+      const response = await fetch("/", { cache: "no-store" });
+      if (response.ok) {
+        window.location.reload();
+        return;
+      }
+    } catch {
+      // Not listening yet.
+    }
+    window.setTimeout(poll, 1000);
+  };
+  window.setTimeout(poll, 1000 * (retries + 1));
+}
+
+/** After a boot that rendered: the next failure gets its own retries. */
+export function clearBootRetries() {
+  try {
+    window.sessionStorage.removeItem(BOOT_RETRY_KEY);
+  } catch {
+    // Blocked storage never held the count.
+  }
 }
