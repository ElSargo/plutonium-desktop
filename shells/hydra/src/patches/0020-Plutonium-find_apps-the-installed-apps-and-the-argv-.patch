From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sarol263@student.otago.ac.nz>
Date: Sat, 24 Oct 2026 12:19:41 +1300
Subject: [PATCH 20/49] Plutonium: find_apps, the installed apps and the argv
 launch_app takes

launch_app's argv example was ["libreoffice", ...], which isn't on PATH
when LibreOffice is a Flatpak. find_apps lists the desktop apps the
launcher shows (through the helper), with a ready argv, where each is
installed from, and with a filter the matching programs on PATH.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/server/src/plutonium/windowTools.test.ts | 10 +++++++
 apps/server/src/plutonium/windowTools.ts      | 30 +++++++++++++++++--
 2 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/apps/server/src/plutonium/windowTools.test.ts b/apps/server/src/plutonium/windowTools.test.ts
index e02574b109..576961fa66 100644
--- a/apps/server/src/plutonium/windowTools.test.ts
+++ b/apps/server/src/plutonium/windowTools.test.ts
@@ -121,6 +121,9 @@ it.effect("offers the window tools and runs them on the helper for the calling t
       expect(names).toContain("list_windows");
       expect(names).toContain("snapshot_window");
       expect(names).toContain("click_window");
+      expect(names).toContain("find_apps");
+      const launch = server.tools.find(({ tool }) => tool.name === "launch_app")!.tool;
+      expect(JSON.stringify(launch.inputSchema)).toContain("use find_apps to get an app's argv");
       for (const { tool } of server.tools) {
         expect(tool.inputSchema.type, `inputSchema.type of ${tool.name}`).toBe("object");
       }
@@ -157,6 +160,13 @@ it.effect("offers the window tools and runs them on the helper for the calling t
       const refused = yield* call("list_windows", {}, false);
       expect(refused.isError).toBe(true);
       expect(helper.calls).toHaveLength(3);
+
+      const found = yield* call("find_apps", { filter: "spreadsheet" });
+      expect(found.isError).toBe(false);
+      expect(helper.calls[3]!.body).toEqual({
+        name: "find_apps",
+        arguments: { filter: "spreadsheet" },
+      });
     }),
   ),
 );
diff --git a/apps/server/src/plutonium/windowTools.ts b/apps/server/src/plutonium/windowTools.ts
index c442b92571..47022c24c1 100644
--- a/apps/server/src/plutonium/windowTools.ts
+++ b/apps/server/src/plutonium/windowTools.ts
@@ -1,6 +1,6 @@
 // @effect-diagnostics nodeBuiltinImport:off - requests go to the Plutonium helper's Unix socket
 /**
- * Plutonium: the native window tools (launch_app, snapshot_window,
+ * Plutonium: the native window tools (find_apps, launch_app, snapshot_window,
  * click_window, type_window, ...) on T3 Code's own MCP server, so every
  * provider's agents can use the apps of their thread. Tabs are T3's preview
  * tools' already.
@@ -87,12 +87,34 @@ const ListWindowsTool = Tool.make("list_windows", {
   .annotate(Tool.Idempotent, true)
   .annotate(Tool.OpenWorld, true);
 
+const FindAppsTool = Tool.make("find_apps", {
+  description:
+    "Find the installed desktop apps (what the user's app launcher shows, Flatpaks included) and how to start them with launch_app. Each has its name, generic name (e.g. \"Spreadsheet\"), desktop id, the argv to pass to launch_app, and where it's installed from (flatpak, nix profile, system or user) with its desktop file, so two installs of one app can be told apart. With a filter, also the matching programs on PATH (onPath, mostly command-line ones).",
+  parameters: Schema.Struct({
+    filter: Schema.optional(
+      Schema.String.annotate({
+        description:
+          'A case-insensitive regular expression matched against each app\'s name, generic name, keywords, desktop id and command, e.g. "spreadsheet" or "office" (default: all apps).',
+      }),
+    ),
+  }),
+  success: WindowToolResult,
+  failure: WindowToolFailure,
+  dependencies,
+})
+  .annotate(Tool.Title, "Find apps")
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false)
+  .annotate(Tool.Idempotent, true)
+  .annotate(Tool.OpenWorld, true);
+
 const LaunchAppTool = windowTool(
   "launch_app",
-  "Start a native desktop (GUI) app, such as LibreOffice, GIMP, Inkscape, a terminal or a file manager, as part of this thread, and wait for its window. Drive it with snapshot_window, click_window, type_window and press_window, even while the user is doing something else. The app runs detached from your shell. Its windows wait in the thread for the user unless focus is true. They keep the size you give (width and height) or the one the app picks: the user sees them scaled to fit, and that you're working in them, until they take control. Returns the new windows (empty if none appeared in time).",
+  "Start a native desktop (GUI) app, such as LibreOffice, GIMP, Inkscape, a terminal or a file manager, as part of this thread, and wait for its window. find_apps gives an installed app's argv. Drive it with snapshot_window, click_window, type_window and press_window, even while the user is doing something else. The app runs detached from your shell. Its windows wait in the thread for the user unless focus is true. They keep the size you give (width and height) or the one the app picks: the user sees them scaled to fit, and that you're working in them, until they take control. Returns the new windows (empty if none appeared in time).",
   {
     argv: Schema.Array(Schema.String).annotate({
-      description: 'Program and arguments, e.g. ["libreoffice", "--writer"]. No shell is involved.',
+      description:
+        "Program and arguments: use find_apps to get an app's argv. argv[0] is looked up on PATH, and installed apps' programs often aren't there under their app names (Flatpaks, for one). No shell is involved.",
     }),
     cwd: Schema.optional(
       Schema.String.annotate({ description: "Working directory (default: your home directory)." }),
@@ -270,6 +292,7 @@ const CloseWindowTool = windowTool(
 
 export const WindowStandardToolkit = Toolkit.make(
   ListWindowsTool,
+  FindAppsTool,
   LaunchAppTool,
   ClickWindowTool,
   HoverWindowTool,
@@ -379,6 +402,7 @@ const pngSize = (data: string) => {
 
 export const layerStandard = McpToolAccess.toLayer(WindowStandardToolkit, {
   list_windows: McpToolAccess.readsAsCaller(forward("list_windows")),
+  find_apps: McpToolAccess.readsAsCaller(forward("find_apps")),
   launch_app: McpToolAccess.actsAsCaller(forward("launch_app")),
   click_window: McpToolAccess.actsAsCaller(forward("click_window")),
   hover_window: McpToolAccess.actsAsCaller(forward("hover_window")),
