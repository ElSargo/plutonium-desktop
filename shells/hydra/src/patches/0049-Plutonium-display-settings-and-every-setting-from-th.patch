From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Sun, 1 Nov 2026 22:51:52 +1300
Subject: [PATCH 49/54] Plutonium: display settings and every setting from the
 status cluster

Quick settings gets two rows under Wi-Fi and Bluetooth, when the helper has
the display service: Displays opens the switcher's Displays page (the
display configuration tool: arrangement, resolution, refresh rate, size,
rotation, primary, mirroring), and All settings the switcher's quick
settings, through the service's open-settings. A row's detail truncates
instead of widening the popover.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/web/src/plutonium/PlutoniumStatus.tsx | 48 +++++++++++++++++++---
 apps/web/src/plutonium/systemServices.ts   | 16 +++++++-
 2 files changed, 57 insertions(+), 7 deletions(-)

diff --git a/apps/web/src/plutonium/PlutoniumStatus.tsx b/apps/web/src/plutonium/PlutoniumStatus.tsx
index 206e0366e5..605f76ca45 100644
--- a/apps/web/src/plutonium/PlutoniumStatus.tsx
+++ b/apps/web/src/plutonium/PlutoniumStatus.tsx
@@ -2,9 +2,10 @@
 // whatever else is open (sidebar hidden, panel maximized, chat folded): the
 // time, the battery when it isn't on AC, and an icon only for something
 // wrong (offline, muted). A click opens quick settings: the date and a
-// calendar, volume and brightness, Wi-Fi and Bluetooth, what's playing, the
-// battery, and lock, suspend, log out, restart and power off. Over the
-// helper's desktop services (systemServices.ts); only in the Plutonium shell.
+// calendar, volume and brightness, Wi-Fi and Bluetooth, Displays and All
+// settings (the switcher's pages), what's playing, the battery, and lock,
+// suspend, log out, restart and power off. Over the helper's desktop services
+// (systemServices.ts); only in the Plutonium shell.
 //
 // Its width is --plutonium-status-width on the document: the title bar's
 // other right-hand controls (--workspace-controls-right) and the headers they
@@ -23,6 +24,7 @@ import {
   LockIcon,
   LockKeyholeIcon,
   LogOutIcon,
+  MonitorIcon,
   MoonIcon,
   PauseIcon,
   PlayIcon,
@@ -30,6 +32,7 @@ import {
   RotateCcwIcon,
   SkipBackIcon,
   SkipForwardIcon,
+  SlidersHorizontalIcon,
   SunIcon,
   Volume1Icon,
   Volume2Icon,
@@ -281,8 +284,9 @@ function ToggleRow({
   onExpandedChange: (expanded: boolean) => void;
 }) {
   const Chevron = expanded ? ChevronDownIcon : ChevronRightIcon;
+  // min-w-0: a long detail truncates instead of widening the popover.
   return (
-    <div className="flex items-center gap-2">
+    <div className="flex min-w-0 items-center gap-2">
       <button
         type="button"
         onClick={() => onExpandedChange(!expanded)}
@@ -529,6 +533,8 @@ function QuickSettings({ now, close }: { now: Date; close: () => void }) {
   const bluetooth = useSystemService("bluetooth");
   const media = useSystemService("media");
   const session = useSystemService("session");
+  const display = useSystemService("display");
+  const displayState = display.state?.available ? display.state : null;
   const [expanded, setExpanded] = useState<"calendar" | "wifi" | "bluetooth" | null>(null);
   const [error, setError] = useState("");
   const setVolume = useLatestSender((volume) => audio.call("set-volume", { volume }));
@@ -541,6 +547,15 @@ function QuickSettings({ now, close }: { now: Date; close: () => void }) {
     promise.catch((cause: unknown) =>
       setError(`${label}: ${String((cause as Error)?.message ?? cause)}`),
     );
+  // The switcher's Displays page (the display configuration tool), or its
+  // quick settings; it opens over this, so the popover closes.
+  const openSettings = (page: "displays" | "settings") => {
+    close();
+    void run(
+      page === "displays" ? "Displays" : "Settings",
+      display.call("open-settings", { page }),
+    );
+  };
 
   const audioState = audio.state?.available ? audio.state : null;
   const VolumeGlyph = !audioState
@@ -619,7 +634,7 @@ function QuickSettings({ now, close }: { now: Date; close: () => void }) {
         </div>
       ) : null}
 
-      {networkState || bluetoothState ? (
+      {networkState || bluetoothState || displayState ? (
         <div className="grid gap-1">
           {networkState ? (
             <>
@@ -694,6 +709,29 @@ function QuickSettings({ now, close }: { now: Date; close: () => void }) {
               ) : null}
             </>
           ) : null}
+          {displayState ? (
+            <>
+              {/* The switcher's pages: they go there, so no switch and nothing to expand. */}
+              <ToggleRow
+                icon={<MonitorIcon />}
+                title="Displays"
+                detail={
+                  displayState.displays.length === 1
+                    ? displayState.displays[0]!.name
+                    : `${displayState.displays.length} displays`
+                }
+                expanded={false}
+                onExpandedChange={() => openSettings("displays")}
+              />
+              <ToggleRow
+                icon={<SlidersHorizontalIcon />}
+                title="All settings"
+                detail="Sound, network, Bluetooth, power, notifications"
+                expanded={false}
+                onExpandedChange={() => openSettings("settings")}
+              />
+            </>
+          ) : null}
         </div>
       ) : null}
 
diff --git a/apps/web/src/plutonium/systemServices.ts b/apps/web/src/plutonium/systemServices.ts
index 6b9d49e1f0..6166f1d21e 100644
--- a/apps/web/src/plutonium/systemServices.ts
+++ b/apps/web/src/plutonium/systemServices.ts
@@ -1,6 +1,6 @@
 // Plutonium: the desktop services Hydra draws in its status cluster
-// (PlutoniumStatus.tsx): the helper's audio, power, network, Bluetooth, media
-// and session services, through the shell library (`shell.system.<name>`,
+// (PlutoniumStatus.tsx): the helper's audio, power, network, Bluetooth, media,
+// session and display services, through the shell library (`shell.system.<name>`,
 // docs/features/DESKTOP_SERVICES.md in the plutonium repo). Each one's state
 // is the helper's JSON, typed here as far as the status cluster reads it.
 import { useCallback, useEffect, useState } from "react";
@@ -119,6 +119,17 @@ export interface SessionState {
   readonly problem: string | null;
 }
 
+/** The display service: the monitors, and the switcher's Displays page (open-settings). */
+export interface DisplayState {
+  readonly available: boolean;
+  readonly displays: readonly {
+    readonly id: string;
+    readonly index: number;
+    readonly name: string;
+    readonly primary: boolean;
+  }[];
+}
+
 interface ServiceStates {
   audio: AudioState;
   power: PowerState;
@@ -126,6 +137,7 @@ interface ServiceStates {
   bluetooth: BluetoothState;
   media: MediaState;
   session: SessionState;
+  display: DisplayState;
 }
 
 export type SystemServiceName = keyof ServiceStates;
