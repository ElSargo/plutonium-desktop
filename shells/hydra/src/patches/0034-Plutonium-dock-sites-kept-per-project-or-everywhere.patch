+/**
+ * Brings a site slot's tab in scope `tag` to this thread: from the thread
+ * showing it, if one does, else a new one.
+ */
+async function bringSiteTab(
+  context: DockContext,
+  target: Extract<DockTarget, { kind: "site" }>,
+  tag: string,
+  layout: DockLayout,
+): Promise<void> {
+  const preview = plutoniumPreview();
+  if (!preview) {
+    await context.openSite(target.url);
+    return;
+  }
+  let tab = scopeSiteTabs(target, tag, preview.tabList()).at(-1);
+  try {
+    if (!tab) {
+      tab = await preview.createDockTab(target.url, tag);
+    } else {
+      const from = preview.previewOf(tab.id);
+      if (from) {
+        const fromRef = {
+          environmentId: from.environmentId as EnvironmentId,
+          threadId: from.threadId as ThreadId,
+        };
+        if (scopedThreadKey(fromRef) === scopedThreadKey(context.threadRef)) {
+          raiseSurface(context, browserSurface(from.tabId), layout);
+          return;
+        }
+        preview.releaseTab(from.runtimeTabId);
+        useRightPanelStore.getState().closeSurface(fromRef, `browser:${from.tabId}`);
+        await context.closePreview(fromRef, from.tabId);
+      }
+    }
+  } catch (error) {
+    toastManager.add({
+      type: "error",
+      title: `Could not open ${target.name}`,
+      description: error instanceof Error ? error.message : String(error),
+    });
+    return;
+  }
+  const tabId = await context.showTab(tab);
+  if (tabId) raiseSurface(context, browserSurface(tabId), layout);
+}
