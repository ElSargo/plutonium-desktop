From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Wed, 28 Oct 2026 22:31:35 +1300
Subject: [PATCH 40/54] Plutonium: start_recording and stop_recording for an
 agent's windows

T3's MCP server now offers the helper's recording tools for this thread's
app windows: a PipeWire capture of the window with the agent as its
consumer (every shell sees it and can stop it, the recording switch
refuses it), written to a WebM file. Preview tabs keep
preview_recording_start/stop, T3's own recorder, which draws the agent's
pointer in.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/server/src/plutonium/windowTools.ts | 29 ++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/apps/server/src/plutonium/windowTools.ts b/apps/server/src/plutonium/windowTools.ts
index c229c785bb..f98f50d432 100644
--- a/apps/server/src/plutonium/windowTools.ts
+++ b/apps/server/src/plutonium/windowTools.ts
@@ -302,6 +302,31 @@ const CloseWindowTool = windowTool(
   { title: "Close app window", destructive: true },
 );
 
+const StartRecordingTool = windowTool(
+  "start_recording",
+  "Record one of this thread's app windows to a video file (WebM), even if the user isn't looking at it, until stop_recording. The user sees the recording in their shell and can stop it; it fails if they switched recording off. For preview tabs, use preview_recording_start. Returns its recording_id and the file's path.",
+  {
+    window_id: windowId,
+    path: Schema.optional(
+      Schema.String.annotate({
+        description: "An absolute path for the .webm file (default: one in the temp folder).",
+      }),
+    ),
+  },
+  { title: "Start window recording" },
+);
+
+const StopRecordingTool = windowTool(
+  "stop_recording",
+  "Stop a recording start_recording began (default: this thread's newest) and finish its file. Returns the path, its length in seconds and size, and `ended` if it had already stopped (the user stopped it, or the window closed).",
+  {
+    recording_id: Schema.optional(
+      Schema.Int.annotate({ description: "A recording_id from start_recording." }),
+    ),
+  },
+  { title: "Stop window recording" },
+);
+
 export const WindowStandardToolkit = Toolkit.make(
   ListWindowsTool,
   FindAppsTool,
@@ -317,6 +342,8 @@ export const WindowStandardToolkit = Toolkit.make(
   ActWindowTool,
   FocusWindowTool,
   CloseWindowTool,
+  StartRecordingTool,
+  StopRecordingTool,
 );
 
 export const WindowSnapshotToolkit = Toolkit.make(SnapshotWindowTool);
@@ -622,6 +649,8 @@ export const layerStandard = McpToolAccess.toLayer(WindowStandardToolkit, {
   act_window: McpToolAccess.actsAsCaller(forward("act_window")),
   focus_window: McpToolAccess.actsAsCaller(forward("focus_window")),
   close_window: McpToolAccess.actsAsCaller(forward("close_window")),
+  start_recording: McpToolAccess.actsAsCaller(forward("start_recording")),
+  stop_recording: McpToolAccess.actsAsCaller(forward("stop_recording")),
 });
 
 /**
