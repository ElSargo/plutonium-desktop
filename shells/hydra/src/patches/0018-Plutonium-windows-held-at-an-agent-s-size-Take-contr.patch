+/** The size an agent holds `windowId` at, until the user takes control; else null. */
+function useAgentSize(windowId: number): { width: number; height: number } | null {
+  const width = usePlutoniumWindowStore((state) => state.agentWindows[windowId]?.width);
+  const height = usePlutoniumWindowStore((state) => state.agentWindows[windowId]?.height);
+  const userControl = usePlutoniumWindowStore(
+    (state) => state.agentWindows[windowId]?.userControl === true,
+  );
+  return width && height && !userControl ? { width, height } : null;
+}
+
+/** Whether an agent gave `windowId` input in the last few seconds. */
+function useAgentBusy(windowId: number): boolean {
+  return usePlutoniumWindowStore((state) => state.agentWindows[windowId]?.busy === true);
+}
+
+/** An element's content box, kept current. */
+function useBoxSize(ref: RefObject<HTMLElement | null>) {
+  const [size, setSize] = useState<{ width: number; height: number } | null>(null);
+  useEffect(() => {
+    const element = ref.current;
+    if (!element) return;
+    const observer = new ResizeObserver(([entry]) => {
+      if (entry) setSize({ width: entry.contentRect.width, height: entry.contentRect.height });
+    });
+    observer.observe(element);
+    return () => observer.disconnect();
+  }, [ref]);
+  return size;
+}
+
+function AgentWorkingDot({ busy }: { busy: boolean }) {
+  return (
+    <span className="relative flex size-2 shrink-0">
+      {busy && (
+        <span className="absolute inline-flex size-full animate-ping rounded-full bg-primary opacity-75" />
+      )}
+      <span className="relative inline-flex size-2 rounded-full bg-primary" />
+    </span>
+  );
+}
+
+/**
+ * Over a window an agent holds: the window is the agent's to drive (the
+ * user's clicks would land on a scaled copy), until the user takes control.
+ */
+function AgentLock({ windowId }: { windowId: number }) {
+  const busy = useAgentBusy(windowId);
+  const [releasing, setReleasing] = useState(false);
+  return (
+    <div className="absolute inset-0 flex items-end justify-center p-3" data-plutonium-agent-lock>
+      <div className="flex items-center gap-2.5 rounded-full border bg-popover/95 py-1 pr-1 pl-3 text-popover-foreground text-xs shadow-lg backdrop-blur-sm">
+        <AgentWorkingDot busy={busy} />
+        <span>{busy ? "Agent is working in this app" : "Agent is using this app"}</span>
+        <Button
+          size="xs"
+          variant="secondary"
+          className="rounded-full"
+          disabled={releasing}
+          onClick={() => {
+            setReleasing(true);
+            void releaseWindow(windowId)
+              .catch(() => {})
+              .finally(() => setReleasing(false));
+          }}
+        >
+          Take control
+        </Button>
+      </div>
+    </div>
+  );
+}
