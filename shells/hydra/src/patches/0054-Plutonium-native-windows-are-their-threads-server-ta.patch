+// @effect-diagnostics nodeBuiltinImport:off globalTimers:off - a stand-in for the helper on a Unix socket
+import * as Effect from "effect/Effect";
+import * as Queue from "effect/Queue";
+import * as NodeFs from "node:fs";
+import * as NodeHttp from "node:http";
+import * as NodeOs from "node:os";
+import * as NodePath from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vite-plus/test";
+
+import type { ServerBrowserViewerOutput } from "../preview/ServerBrowser.ts";
+import {
+  attachWindowViewer,
+  closeWindow,
+  FrameReader,
+  type HelperWindow,
+  WindowInputTranslator,
+  windowTabs,
+} from "./windowTabs.ts";
+
+const frame = (jpeg: string, width: number, height: number) => {
+  const header = Buffer.alloc(8);
+  header.writeUInt32BE(jpeg.length, 0);
+  header.writeUInt16BE(width, 4);
+  header.writeUInt16BE(height, 6);
+  return Buffer.concat([header, Buffer.from(jpeg)]);
+};
+
+const kwrite: HelperWindow = {
+  id: 5,
+  appId: "org.kde.kwrite",
+  title: "Untitled",
+  width: 800,
+  height: 600,
+  pid: 4242,
+  tags: ["t3:dock/1", "t3:thread/thread-a"],
+};
+
+describe("window tabs", () => {
+  it("lists a thread's windows as its tabs", () => {
+    expect(
+      windowTabs([
+        kwrite,
+        { ...kwrite, id: 6, title: " ", appId: "", tags: ["t3:thread/thread-b"] },
+        // No thread: no tab.
+        { ...kwrite, id: 7, tags: ["t3:global"] },
+        { id: 8, appId: "x", title: "x", width: 1, height: 1, pid: 1 },
+      ]),
+    ).toEqual([
+      {
+        threadId: "thread-a",
+        tabId: "plutonium-window-5-4242",
+        url: "app://org.kde.kwrite",
+        title: "Untitled",
+      },
+      {
+        threadId: "thread-b",
+        tabId: "plutonium-window-6-4242",
+        url: "app://window",
+        title: "window",
+      },
+    ]);
+  });
+
+  it("splits the helper's frames, with their size, however they arrive", () => {
+    const bytes = Buffer.concat([frame("first", 640, 480), frame("2", 1, 1)]);
+    for (let cut = 0; cut <= bytes.length; cut++) {
+      const reader = new FrameReader();
+      const got = [...reader.push(bytes.subarray(0, cut)), ...reader.push(bytes.subarray(cut))];
+      expect(got.map(({ data, width, height }) => [String(data), width, height])).toEqual([
+        ["first", 640, 480],
+        ["2", 1, 1],
+      ]);
+    }
+  });
+
+  it("turns a viewer's mouse, keys and text into the helper's input", () => {
+    const translator = new WindowInputTranslator();
+    const at = { x: 10, y: 20, modifiers: 2 };
+    expect(
+      translator.translate({
+        type: "mouse",
+        action: "down",
+        ...at,
+        button: "left",
+        buttons: 1,
+        clickCount: 2,
+      }),
+    ).toEqual([
+      {
+        path: "mouse",
+        body: { type: "mousePressed", ...at, button: "left", buttons: 1, clickCount: 2 },
+      },
+    ]);
+    expect(
+      translator.translate({ type: "key", action: "down", key: "a", code: "KeyA", modifiers: 8 }),
+    ).toEqual([
+      { path: "keys", body: { events: [{ type: "keyDown", code: "KeyA", modifiers: 8 }] } },
+    ]);
+    // A soft keyboard's keys: named keys by name, others as their text.
+    expect(
+      translator.translate({ type: "key", action: "down", key: "Backspace", code: "" }),
+    ).toEqual([
+      { path: "keys", body: { events: [{ type: "keyDown", code: "Backspace", modifiers: 0 }] } },
+    ]);
+    expect(
+      translator.translate({ type: "key", action: "down", key: "é", code: "", text: "é" }),
+    ).toEqual([{ path: "text", body: { text: "é" } }]);
+    expect(translator.translate({ type: "key", action: "up", key: "é", code: "" })).toEqual([]);
+    expect(translator.translate({ type: "text", text: "hello" })).toEqual([
+      { path: "text", body: { text: "hello" } },
+    ]);
+    // Only for pages.
+    expect(translator.translate({ type: "navigate", url: "https://example.com" })).toEqual([]);
+    expect(translator.translate({ type: "mouse", action: "down", x: "1", y: 2 })).toEqual([]);
+    // Losing control lets go of what is held.
+    expect(translator.release()).toEqual([
+      {
+        path: "mouse",
+        body: { type: "mouseReleased", x: 10, y: 20, button: "left", buttons: 0, clickCount: 1 },
+      },
+      {
+        path: "keys",
+        body: {
+          events: [
+            { type: "keyUp", code: "KeyA" },
+            { type: "keyUp", code: "Backspace" },
+          ],
+        },
+      },
+    ]);
+    expect(translator.release()).toEqual([]);
+  });
+
+  it("scrolls by whole notches, keeping what a pan has not yet made one", () => {
+    const translator = new WindowInputTranslator();
+    const wheel = (deltaY: number) =>
+      translator.translate({ type: "wheel", x: 1, y: 2, deltaX: 0, deltaY, modifiers: 0 });
+    expect(wheel(60)).toEqual([]);
+    expect(wheel(60)).toEqual([
+      {
+        path: "mouse",
+        body: { type: "mouseWheel", x: 1, y: 2, deltaX: 0, deltaY: 1, modifiers: 0 },
+      },
+    ]);
+    expect(wheel(-250)).toEqual([
+      {
+        path: "mouse",
+        body: { type: "mouseWheel", x: 1, y: 2, deltaX: 0, deltaY: -2, modifiers: 0 },
+      },
+    ]);
+  });
+});
+
+describe("a window's viewer", () => {
+  let directory: string;
+  let helper: NodeHttp.Server;
+  let windows: HelperWindow[];
+  let posts: Array<{ path: string; body: unknown }>;
+  let stream: NodeHttp.ServerResponse | null;
+  const previousSocket = process.env.PLUTONIUM_HELPER;
+
+  beforeEach(async () => {
+    directory = NodeFs.mkdtempSync(NodePath.join(NodeOs.tmpdir(), "t3-window-tabs-"));
+    windows = [kwrite];
+    posts = [];
+    stream = null;
+    helper = NodeHttp.createServer((request, response) => {
+      let body = "";
+      request.on("data", (chunk) => (body += chunk));
+      request.on("end", () => {
+        const path = request.url ?? "";
+        if (path === "/v1/windows") {
+          response.writeHead(200, { "Content-Type": "application/json" });
+          return response.end(JSON.stringify(windows));
+        }
+        if (path.startsWith("/v1/windows/5/stream?")) {
+          response.writeHead(200);
+          response.flushHeaders();
+          stream = response;
+          return;
+        }
+        posts.push({ path, body: body ? JSON.parse(body) : undefined });
+        response.writeHead(204).end();
+      });
+    });
+    const socketPath = NodePath.join(directory, "helper.sock");
+    await new Promise<void>((resolve) => helper.listen(socketPath, resolve));
+    process.env.PLUTONIUM_HELPER = socketPath;
+  });
+
+  afterEach(async () => {
+    stream?.destroy();
+    await new Promise((resolve) => helper.close(resolve));
+    NodeFs.rmSync(directory, { recursive: true, force: true });
+    if (previousSocket === undefined) delete process.env.PLUTONIUM_HELPER;
+    else process.env.PLUTONIUM_HELPER = previousSocket;
+  });
+
+  const attach = (threadId = "thread-a", canOperate = true) =>
+    attachWindowViewer({
+      threadId,
+      tabId: "plutonium-window-5-4242",
+      windowId: 5,
+      pid: 4242,
+      maxWidth: 1280,
+      maxHeight: 800,
+      quality: 70,
+      canOperate,
+    });
+  const next = (output: Queue.Dequeue<ServerBrowserViewerOutput>) => Queue.take(output);
+  const waitFor = async (check: () => boolean) => {
+    for (let i = 0; i < 200 && !check(); i++) await new Promise((r) => setTimeout(r, 5));
+    expect(check()).toBe(true);
+  };
+
+  it("streams the window's frames, paced by acks, and sends its input", () =>
+    Effect.runPromise(
+      Effect.scoped(
+        Effect.gen(function* () {
+          const viewer = yield* attach();
+          expect(yield* next(viewer.output)).toEqual({ _tag: "viewport", width: 800, height: 600 });
+          expect(yield* next(viewer.output)).toMatchObject({
+            _tag: "control",
+            canOperate: true,
+            controller: "you",
+          });
+
+          yield* Effect.promise(() => waitFor(() => stream !== null));
+          for (const name of ["1", "2", "3", "4"]) stream!.write(frame(name, 1600, 1200));
+          const first = yield* next(viewer.output);
+          const second = yield* next(viewer.output);
+          expect([first, second].map((each) => each._tag === "frame" && String(each.data))).toEqual(
+            ["1", "2"],
+          );
+          // Two wait for their acks; of those behind them, only the newest is kept.
+          yield* Effect.promise(() => new Promise((r) => setTimeout(r, 30)));
+          expect(yield* Queue.size(viewer.output)).toBe(0);
+          if (first._tag === "frame") yield* first.ack;
+          const third = yield* next(viewer.output);
+          expect(third._tag === "frame" && String(third.data)).toBe("4");
+
+          yield* viewer.input({
+            type: "mouse",
+            action: "move",
+            x: 3,
+            y: 4,
+            button: "none",
+            buttons: 0,
+            clickCount: 0,
+            modifiers: 0,
+          });
+          yield* viewer.input({ type: "text", text: "hi" });
+          expect(posts).toEqual([
+            {
+              path: "/v1/windows/5/mouse",
+              body: {
+                type: "mouseMoved",
+                x: 3,
+                y: 4,
+                button: "none",
+                buttons: 0,
+                clickCount: 0,
+                modifiers: 0,
+              },
+            },
+            { path: "/v1/windows/5/text", body: { text: "hi" } },
+          ]);
+          // A touch viewer may raise its keyboard anywhere.
+          yield* viewer.input({ type: "probe", x: 3, y: 4 });
+          expect(yield* next(viewer.output)).toEqual({ _tag: "probe", x: 3, y: 4, editable: true });
+
+          // Resized: its new size, once its frames change shape.
+          windows = [{ ...kwrite, width: 1000, height: 700 }];
+          stream!.write(frame("5", 1280, 896));
+          yield* Effect.promise(() => new Promise((r) => setTimeout(r, 30)));
+          const outputs = yield* Queue.takeAll(viewer.output);
+          expect(outputs.filter((each) => each._tag === "viewport")).toEqual([
+            { _tag: "viewport", width: 1000, height: 700 },
+          ]);
+
+          stream!.end();
+          let output = yield* next(viewer.output);
+          while (output._tag === "frame") output = yield* next(viewer.output);
+          expect(output).toEqual({ _tag: "gone" });
+        }),
+      ),
+    ));
+
+  it("gives control to one viewer at a time, which lets go of what it held", () =>
+    Effect.runPromise(
+      Effect.scoped(
+        Effect.gen(function* () {
+          const first = yield* attach();
+          const second = yield* attach();
+          const control = async (output: Queue.Dequeue<ServerBrowserViewerOutput>) => {
+            const all = await Effect.runPromise(Queue.takeAll(output));
+            return all.filter((each) => each._tag === "control").at(-1);
+          };
+          expect(yield* Effect.promise(() => control(first.output))).toMatchObject({
+            controller: "you",
+          });
+          expect(yield* Effect.promise(() => control(second.output))).toMatchObject({
+            controller: "another-viewer",
+          });
+          // Without control, input goes nowhere.
+          yield* second.input({ type: "text", text: "no" });
+          yield* first.input({ type: "key", action: "down", key: "a", code: "KeyA", modifiers: 0 });
+          yield* second.input({ type: "takeControl" });
+          yield* Effect.promise(() => waitFor(() => posts.length === 2));
+          expect(posts).toEqual([
+            {
+              path: "/v1/windows/5/keys",
+              body: { events: [{ type: "keyDown", code: "KeyA", modifiers: 0 }] },
+            },
+            { path: "/v1/windows/5/keys", body: { events: [{ type: "keyUp", code: "KeyA" }] } },
+          ]);
+          expect(yield* Effect.promise(() => control(first.output))).toMatchObject({
+            controller: "another-viewer",
+          });
+          expect(yield* Effect.promise(() => control(second.output))).toMatchObject({
+            controller: "you",
+          });
+        }),
+      ),
+    ));
+
+  it("closes the tab's window, and not another that reused its number", async () => {
+    await Effect.runPromise(closeWindow({ windowId: 5, pid: 1 }));
+    expect(posts).toEqual([]);
+    await Effect.runPromise(closeWindow({ windowId: 5, pid: 4242 }));
+    expect(posts.map((post) => post.path)).toEqual(["/v1/windows/5/close"]);
+  });
+
+  it("finds no window that isn't the thread's, or has gone", async () => {
+    await expect(Effect.runPromise(Effect.scoped(attach("thread-b")))).rejects.toMatchObject({
+      _tag: "PlutoniumWindowGoneError",
+    });
+    windows = [{ ...kwrite, pid: 1 }];
+    await expect(Effect.runPromise(Effect.scoped(attach()))).rejects.toMatchObject({
+      _tag: "PlutoniumWindowGoneError",
+    });
+  });
+});
