+    return {
+      output,
+      input: (raw: unknown) =>
+        Effect.promise(async () => {
+          if (!viewer.canOperate || typeof raw !== "object" || raw === null) return;
+          const message = raw as Record<string, unknown>;
+          if (message.type === "takeControl") return setController(windowControl, viewer.id);
+          if (message.type === "releaseControl") {
+            if (windowControl.controller === viewer.id) setController(windowControl, null);
+            return;
+          }
+          if (windowControl.controller !== viewer.id) return;
+          if (message.type === "probe") {
