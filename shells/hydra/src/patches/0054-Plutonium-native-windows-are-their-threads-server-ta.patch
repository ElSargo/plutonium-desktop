diff --git a/packages/shared/src/plutoniumWindowTabs.ts b/packages/shared/src/plutoniumWindowTabs.ts
new file mode 100644
index 0000000000..ab076bbbf5
--- /dev/null
+++ b/packages/shared/src/plutoniumWindowTabs.ts
@@ -0,0 +1,25 @@
+// Plutonium: native windows as preview tabs. The server lists each window of
+// a thread as one of its server tabs, so every T3 client (the mobile app, a
+// browser elsewhere) lists and streams it as it does a page. Its tab id names
+// the window, and the process that drew it, so a client holding the id of a
+// window that has gone can't land on another that reused its number.
+
+const WINDOW_TAB_PATTERN = /^plutonium-window-(\d+)-(\d+)$/;
+
+/** The preview tab id of native window `windowId`, of process `pid`. */
+export function plutoniumWindowTabId(windowId: number, pid: number): string {
+  return `plutonium-window-${windowId}-${pid}`;
+}
+
+/** The native window a preview tab id names, or null for any other tab. */
+export function plutoniumWindowOfTab(
+  tabId: string,
+): { readonly windowId: number; readonly pid: number } | null {
+  const match = WINDOW_TAB_PATTERN.exec(tabId);
+  return match ? { windowId: Number(match[1]), pid: Number(match[2]) } : null;
+}
+
+/** Whether a preview tab is a native window (the Plutonium shell shows those itself). */
+export function isPlutoniumWindowTab(tabId: string): boolean {
+  return WINDOW_TAB_PATTERN.test(tabId);
+}
