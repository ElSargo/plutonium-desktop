+            });
+            response.on("end", () => push({ _tag: "gone" }));
+          },
+        );
+        request.on("error", () => push({ _tag: "gone" }));
+        request.end();
+        return request;
+      }),
+      (request) => Effect.sync(() => request.destroy()),
+    );
