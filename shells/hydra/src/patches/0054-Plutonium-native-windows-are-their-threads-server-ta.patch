+      void findWindow()
+        .then((window) => {
+          if (!window || (window.width === viewport.width && window.height === viewport.height))
+            return;
+          viewport = { width: window.width, height: window.height };
+          push({ _tag: "viewport", ...viewport });
+        })
+        .catch(() => {});
