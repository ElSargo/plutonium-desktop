+      Effect.sync(() => windowControl.viewers.set(viewer.id, viewer)),
+      () =>
+        Effect.sync(() => {
+          if (windowControl.controller === viewer.id) setController(windowControl, null);
+          windowControl.viewers.delete(viewer.id);
+          if (windowControl.viewers.size === 0) controls.delete(input.tabId);
+        }),
+    );
