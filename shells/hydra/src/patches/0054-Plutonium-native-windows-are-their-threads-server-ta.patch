+++ b/apps/server/src/plutonium/windowTabs.ts
@@ -0,0 +1,573 @@
+// @effect-diagnostics nodeBuiltinImport:off globalTimers:off - the Plutonium helper is a Unix socket, read from Node callbacks
+/**
+ * Plutonium: native windows as server tabs, for every T3 client.
+ *
+ * Each window the helper lists under a thread (its first `t3:thread/` tag)
+ * is one of that thread's preview tabs, `runtime: "server"`, so any client
+ * that lists and streams server tabs (the mobile app, the desktop app, a
+ * browser elsewhere) gets it as it gets a page:
+ *
+ * - The list: `PreviewManager.syncPlutoniumWindows`, from the helper's
+ *   `GET /v1/windows` each second. The tab's address is `app://<app id>`, its
+ *   title the window's. Agents' preview tools and the server's browser don't
+ *   see these tabs (`PreviewManager.list` leaves them out).
+ * - The stream: `/api/preview-stream/ws` with the window's tab id comes here
+ *   (`attachWindowViewer`): the helper's frames (`GET /v1/windows/:id/stream`)
+ *   as the viewer's frames, the window's size in DIPs as its viewport, and the
+ *   viewer's input as the helper's (`POST /v1/windows/:id/{mouse,keys,text}`).
+ *   One viewer at a time has control, as with a page.
+ * - Closing the tab asks the app to close the window (`closeWindow`).
+ */
+import { plutoniumHelperSocket } from "@t3tools/shared/plutonium";
+import { plutoniumWindowTabId } from "@t3tools/shared/plutoniumWindowTabs";
+import { ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Queue from "effect/Queue";
+import * as Schedule from "effect/Schedule";
+import * as Schema from "effect/Schema";
+import * as NodeCrypto from "node:crypto";
+import * as NodeHttp from "node:http";
+
+import * as PreviewManager from "../preview/Manager.ts";
+import type { ServerBrowserViewer, ServerBrowserViewerOutput } from "../preview/ServerBrowser.ts";
+import { forkParked } from "../serverActivation.ts";
+
+const LIST_INTERVAL = "1 second";
+const REQUEST_TIMEOUT_MS = 10_000;
+const FRAME_HEADER_BYTES = 8;
+/** Frames sent and not yet acknowledged; a newer frame replaces one waiting behind them. */
+const MAX_FRAMES_IN_FLIGHT = 2;
+const VIEWER_OUTPUT_LIMIT = 64;
+/** Pixels of a viewer's wheel or touch pan that make one wheel notch. */
+const WHEEL_PX_PER_NOTCH = 100;
+const THREAD_TAG_PREFIX = "t3:thread/";
+
+/** A window as the helper lists it (helper/src/relay.ts, NativeWindowEntry). */
+export interface HelperWindow {
+  readonly id: number;
+  readonly appId: string;
+  readonly title: string;
+  /** DIPs. */
+  readonly width: number;
+  readonly height: number;
+  readonly pid: number;
+  readonly tags?: ReadonlyArray<string>;
+}
+
+export class PlutoniumWindowGoneError extends Schema.TaggedError<PlutoniumWindowGoneError>()(
+  "PlutoniumWindowGoneError",
+  { windowId: Schema.Number },
+) {}
+
+/** The thread a window belongs to: its first T3 thread tag's. */
+export const windowThread = (window: HelperWindow): string | null => {
+  const tag = (window.tags ?? []).find((each) => each.startsWith(THREAD_TAG_PREFIX));
+  return tag ? tag.slice(THREAD_TAG_PREFIX.length) || null : null;
+};
+
+/** The helper's window list as the threads' window tabs. */
+export const windowTabs = (
+  windows: ReadonlyArray<HelperWindow>,
+): Array<PreviewManager.PlutoniumWindowTabInput> =>
+  windows.flatMap((window) => {
+    const threadId = windowThread(window);
+    if (threadId === null) return [];
+    const app = window.appId.trim() || "window";
+    return [
+      {
+        threadId: ThreadId.make(threadId),
+        tabId: plutoniumWindowTabId(window.id, window.pid),
+        url: `app://${app}`.slice(0, 2048),
+        title: (window.title.trim() || app).slice(0, 512),
+      },
+    ];
+  });
+
+/** Splits the helper's frame stream (helper/src/windowStream.ts) into JPEGs and their size. */
+export class FrameReader {
+  private pending: Buffer = Buffer.alloc(0);
+
+  push(chunk: Buffer): Array<{ data: Buffer; width: number; height: number }> {
+    this.pending = this.pending.length > 0 ? Buffer.concat([this.pending, chunk]) : chunk;
+    const frames = [];
+    while (this.pending.length >= FRAME_HEADER_BYTES) {
+      const length = this.pending.readUInt32BE(0);
+      if (this.pending.length < FRAME_HEADER_BYTES + length) break;
+      frames.push({
+        width: this.pending.readUInt16BE(4),
+        height: this.pending.readUInt16BE(6),
+        data: this.pending.subarray(FRAME_HEADER_BYTES, FRAME_HEADER_BYTES + length),
+      });
+      this.pending = this.pending.subarray(FRAME_HEADER_BYTES + length);
+    }
+    return frames;
+  }
+}
+
+/** A request to the helper: its status and body. */
+const helperRequest = (
+  socketPath: string,
+  method: "GET" | "POST",
+  path: string,
+  body?: unknown,
+): Promise<{ readonly status: number; readonly text: string }> =>
+  new Promise((resolve, reject) => {
+    const request = NodeHttp.request(
+      {
+        socketPath,
+        method,
+        path,
+        timeout: REQUEST_TIMEOUT_MS,
+        headers: body === undefined ? {} : { "Content-Type": "application/json" },
+      },
+      (response) => {
+        let text = "";
+        response.setEncoding("utf8");
+        response.on("data", (chunk: string) => (text += chunk));
+        response.on("end", () => resolve({ status: response.statusCode ?? 500, text }));
+      },
+    );
+    request.on("timeout", () => request.destroy(new Error("timed out")));
+    request.on("error", reject);
+    request.end(body === undefined ? undefined : JSON.stringify(body));
+  });
+
+const listWindows = async (socketPath: string): Promise<Array<HelperWindow>> => {
+  const { status, text } = await helperRequest(socketPath, "GET", "/v1/windows");
+  if (status !== 200) throw new Error(`The helper said ${status}.`);
+  const windows: unknown = JSON.parse(text);
+  return Array.isArray(windows) ? (windows as Array<HelperWindow>) : [];
+};
+
+// --- Input ------------------------------------------------------------------
+
+/** The helper's input for one viewer message. */
+export type WindowInput =
+  | { readonly path: "mouse"; readonly body: Record<string, unknown> }
+  | { readonly path: "keys"; readonly body: { readonly events: ReadonlyArray<unknown> } }
+  | { readonly path: "text"; readonly body: { readonly text: string } };
+
+const MOUSE_TYPES = { move: "mouseMoved", down: "mousePressed", up: "mouseReleased" } as const;
+const MOUSE_BUTTONS = new Set(["none", "left", "middle", "right", "back", "forward"]);
+/** Keys a soft keyboard sends without a `code`, whose `key` names the physical key. */
+const NAMED_KEYS = new Set([
+  "Backspace",
+  "Delete",
+  "Enter",
+  "Tab",
+  "Escape",
+  "ArrowLeft",
+  "ArrowRight",
+  "ArrowUp",
+  "ArrowDown",
+  "Home",
+  "End",
+  "PageUp",
+  "PageDown",
+  "Insert",
+]);
+
+const finite = (value: unknown): value is number =>
+  typeof value === "number" && Number.isFinite(value);
+const int = (value: unknown) => (finite(value) ? Math.round(value) : 0);
+
+/**
+ * Turns a viewer's input into the helper's, keeping what it needs between
+ * messages (wheel remainders, keys and buttons held). Messages for pages
+ * only (navigation, resizing, dialogs) are none.
+ */
+export class WindowInputTranslator {
+  private wheelX = 0;
+  private wheelY = 0;
+  /** Codes held down, so losing control releases them. */
+  readonly heldKeys = new Set<string>();
+  /** Buttons held, and where, so losing control releases them. */
+  readonly heldButtons = new Map<string, { x: number; y: number }>();
+
+  translate(message: Record<string, unknown>): Array<WindowInput> {
+    switch (message.type) {
+      case "mouse": {
+        const type = MOUSE_TYPES[message.action as keyof typeof MOUSE_TYPES];
+        if (!type || !finite(message.x) || !finite(message.y)) return [];
+        const button =
+          typeof message.button === "string" && MOUSE_BUTTONS.has(message.button)
+            ? message.button
+            : "none";
+        if (type === "mousePressed" && button !== "none")
+          this.heldButtons.set(button, { x: message.x, y: message.y });
+        if (type === "mouseReleased") this.heldButtons.delete(button);
+        return [
+          {
+            path: "mouse",
+            body: {
