diff --git a/apps/web/src/plutonium/AppLauncher.tsx b/apps/web/src/plutonium/AppLauncher.tsx
new file mode 100644
index 0000000000..5c1b8bb491
--- /dev/null
+++ b/apps/web/src/plutonium/AppLauncher.tsx
@@ -0,0 +1,232 @@
+// Plutonium: the app launcher, a command palette mode (Super+Space). Lists
+// the desktop apps the Plutonium helper knows (freedesktop.org desktop
+// entries), most recently launched first, and launches the chosen one into
+// the current thread. Its window opens as a tab in the right panel, with the
+// keyboard.
+import { useAtomValue } from "@effect/atom-react";
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import { useParams } from "@tanstack/react-router";
+import { AppWindowIcon } from "lucide-react";
+import { useEffect, useMemo, useState } from "react";
+
+import { CommandPaletteContent } from "~/components/CommandPaletteContent";
+import { type CommandPaletteActionItem } from "~/components/CommandPalette.logic";
+import { CommandPaletteResults } from "~/components/CommandPaletteResults";
+import { toastManager } from "~/components/ui/toast";
+import { normalizeSearchText } from "~/lib/utils";
+import { primaryServerKeybindingsAtom } from "~/state/server";
+import { resolveThreadRouteTarget } from "~/threadRoutes";
+
+import { openAndFocusApp } from "./panelKeys";
+import {
+  type DesktopApp,
+  isPlutoniumShell,
+  plutoniumShell,
+  usePlutoniumWindowStore,
+} from "./windowStore";
+
+const RECENT_KEY = "plutonium:recent-apps";
+const RECENT_LIMIT = 8;
+// How long a launched app has to show its window before the launcher stops
+// waiting to open it.
+const WINDOW_WAIT_MS = 60_000;
+
+function readRecent(): string[] {
+  try {
+    const value = JSON.parse(localStorage.getItem(RECENT_KEY) ?? "[]");
+    return Array.isArray(value) ? value.filter((id) => typeof id === "string") : [];
+  } catch {
+    return [];
+  }
+}
+
+function rememberLaunch(appId: string): void {
+  try {
+    const recent = [appId, ...readRecent().filter((id) => id !== appId)].slice(0, RECENT_LIMIT);
+    localStorage.setItem(RECENT_KEY, JSON.stringify(recent));
+  } catch {
+    // No storage: no recents.
+  }
+}
+
+let appsRequest: Promise<DesktopApp[]> | null = null;
+
+/** The helper's apps, fetched once per page (and again after a failure). */
+function loadApps(): Promise<DesktopApp[]> {
+  appsRequest ??= plutoniumShell().then((shell) => {
+    if (!shell) return [];
+    return shell.apps();
+  });
+  appsRequest.catch(() => (appsRequest = null));
+  return appsRequest;
+}
+
+/** Higher is better; 0 is no match. */
+function matchScore(app: DesktopApp, query: string): number {
+  const name = normalizeSearchText(app.name);
+  if (name === query) return 100;
+  if (name.startsWith(query)) return 80;
+  if (name.split(/[\s\-_.]+/).some((word) => word.startsWith(query))) return 60;
+  if (name.includes(query)) return 40;
+  const rest = [app.genericName, ...app.keywords, app.id].map(normalizeSearchText);
+  if (rest.some((text) => text.split(/[\s\-_.;]+/).some((word) => word.startsWith(query))))
+    return 20;
+  if (normalizeSearchText(app.comment).includes(query)) return 10;
+  return 0;
+}
+
+function AppIcon({ app }: { app: DesktopApp }) {
+  const [url, setUrl] = useState<string | null>(null);
+  useEffect(() => {
+    if (!app.hasIcon) return;
+    let live = true;
+    void plutoniumShell()
+      .then((shell) => shell?.appIcon(app.id) ?? null)
+      .then((icon) => live && setUrl(icon));
+    return () => {
+      live = false;
+    };
+  }, [app]);
+  return url ? (
+    <img alt="" className="size-5 shrink-0 object-contain" src={url} />
+  ) : (
+    <AppWindowIcon className="size-5 shrink-0 text-icon-muted" />
+  );
+}
+
+/** Launches `app` into `threadRef`'s thread and opens its first new window there. */
+async function launchApp(app: DesktopApp, threadRef: ScopedThreadRef): Promise<void> {
+  const shell = await plutoniumShell();
+  if (!shell) return;
+  rememberLaunch(app.id);
+  const threadId = threadRef.threadId as string;
+  const known = new Set(Object.keys(usePlutoniumWindowStore.getState().windows).map(Number));
+  let opened = false;
+  const open = () => {
+    const window = Object.values(usePlutoniumWindowStore.getState().windows)
+      .filter((entry) => entry.threadId === threadId && !known.has(entry.id))
+      .toSorted((a, b) => a.id - b.id)[0];
+    if (!window || opened) return;
+    opened = true;
+    stop();
+    openAndFocusApp(threadRef, { windowId: window.id, appId: window.appId });
+  };
+  const unsubscribe = usePlutoniumWindowStore.subscribe(open);
+  const timer = setTimeout(() => stop(), WINDOW_WAIT_MS);
+  function stop() {
+    unsubscribe();
+    clearTimeout(timer);
+  }
+  toastManager.add({ type: "info", title: `Starting ${app.name}…`, timeout: 2500 });
+  try {
+    await shell.launchApp(threadId, app.id);
+  } catch (error) {
+    stop();
+    toastManager.add({
+      type: "error",
+      title: `Could not start ${app.name}`,
+      description: error instanceof Error ? error.message : String(error),
+    });
+  }
+}
+
+export function PlutoniumAppLauncher({ setOpen }: { setOpen: (open: boolean) => void }) {
+  const keybindings = useAtomValue(primaryServerKeybindingsAtom);
+  const routeTarget = useParams({
+    strict: false,
+    select: (params) => resolveThreadRouteTarget(params),
+  });
+  const threadRef = routeTarget?.kind === "server" ? routeTarget.threadRef : null;
+  const [apps, setApps] = useState<DesktopApp[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [query, setQuery] = useState("");
+  const [highlightedItemValue, setHighlightedItemValue] = useState<string | null>(null);
+
+  useEffect(() => {
+    let live = true;
+    loadApps().then(
+      (list) => live && setApps(list),
+      (reason: unknown) =>
+        live && setError(reason instanceof Error ? reason.message : String(reason)),
+    );
+    return () => {
+      live = false;
+    };
+  }, []);
+
+  const groups = useMemo(() => {
+    if (!apps || !threadRef) return [];
+    const toItem = (app: DesktopApp): CommandPaletteActionItem => ({
+      kind: "action",
+      value: `app:${app.id}`,
+      searchTerms: [app.name, app.genericName, ...app.keywords],
+      title: app.name,
+      ...(app.genericName || app.comment ? { description: app.genericName || app.comment } : {}),
+      icon: <AppIcon app={app} />,
+      run: () => launchApp(app, threadRef),
+    });
+    const needle = normalizeSearchText(query.trim());
+    if (needle) {
+      const matches = apps
+        .map((app) => ({ app, score: matchScore(app, needle) }))
+        .filter((entry) => entry.score > 0)
+        .toSorted((a, b) => b.score - a.score || a.app.name.localeCompare(b.app.name));
+      return matches.length > 0
+        ? [{ value: "apps", label: "Apps", items: matches.map((entry) => toItem(entry.app)) }]
+        : [];
+    }
+    const byId = new Map(apps.map((app) => [app.id, app]));
+    const recent = readRecent().flatMap((id) => byId.get(id) ?? []);
+    const recentIds = new Set(recent.map((app) => app.id));
+    return [
+      ...(recent.length > 0
+        ? [{ value: "recent", label: "Recent", items: recent.map(toItem) }]
+        : []),
+      {
+        value: "apps",
+        label: "All apps",
+        items: apps.filter((app) => !recentIds.has(app.id)).map(toItem),
+      },
+    ];
+  }, [apps, query, threadRef]);
+
+  const emptyStateMessage = !isPlutoniumShell()
+    ? "Apps launch only in the Plutonium shell."
+    : !threadRef
+      ? "Open a thread to launch apps into it."
+      : (error ?? (apps === null ? "Loading apps…" : "No matching apps."));
+
+  return (
+    <CommandPaletteContent
+      aria-label="App launcher"
+      autoHighlight="always"
+      escapeLabel="Close"
+      footerActionLabel="Launch"
+      inputProps={{ placeholder: "Launch an app…" }}
+      mode="none"
+      onItemHighlighted={(value) => {
+        setHighlightedItemValue(typeof value === "string" ? value : null);
+      }}
+      onValueChange={(value) => {
+        setHighlightedItemValue(null);
+        setQuery(value);
+      }}
+      panelSize="tall-list"
+      testId="plutonium-app-launcher"
+      value={query}
+    >
+      <CommandPaletteResults
+        groups={groups}
+        highlightedItemValue={highlightedItemValue}
+        isActionsOnly={false}
+        keybindings={keybindings}
+        onExecuteItem={(item) => {
+          if (item.kind !== "action") return;
+          setOpen(false);
+          void item.run();
+        }}
+        emptyStateMessage={emptyStateMessage}
+      />
+    </CommandPaletteContent>
+  );
+}
diff --git a/apps/web/src/plutonium/panelKeys.ts b/apps/web/src/plutonium/panelKeys.ts
new file mode 100644
index 0000000000..1b60255590
--- /dev/null
+++ b/apps/web/src/plutonium/panelKeys.ts
@@ -0,0 +1,233 @@
+// Plutonium: keyboard control of the right panel's tabs (Alt+1…9, Ctrl+Tab,
+// Ctrl+Shift+Tab, Ctrl+T for a new browser tab), and moving keyboard focus
+// into a tab's content (an app's window, a browser tab's page).
+//
+// In the Plutonium shell these shortcuts (and the app launcher's) are also
+// registered with the browser as shell shortcuts, so they reach this page
+// while an app or browser tab in the panel has the keyboard.
+import {
+  type KeybindingCommand,
+  type KeybindingShortcut,
+  RIGHT_PANEL_TAB_JUMP_KEYBINDING_COMMANDS,
+  type ResolvedKeybindingsConfig,
+  type ScopedThreadRef,
+} from "@t3tools/contracts";
+import { scopedThreadKey } from "@t3tools/client-runtime/environment";
+import { useEffect, useRef } from "react";
+
+import { isCommandPaletteOpen } from "~/commandPaletteBus";
+import { dispatchPreviewAction } from "~/components/preview/previewActionBus";
+import { resolveShortcutCommand } from "~/keybindings";
+import { isMacPlatform } from "~/lib/utils";
+import { type RightPanelSurface, useRightPanelStore } from "~/rightPanelStore";
+
+import { plutoniumShell } from "./windowStore";
+
+const TAB_JUMP: readonly KeybindingCommand[] = RIGHT_PANEL_TAB_JUMP_KEYBINDING_COMMANDS;
+
+/** Commands that must reach the page even while an app or tab has the keyboard. */
+const SHELL_COMMANDS = new Set<KeybindingCommand>([
+  ...TAB_JUMP,
+  "rightPanel.nextTab",
+  "rightPanel.previousTab",
+  "preview.newTab",
+  "appLauncher.toggle",
+]);
+
+const CODE_BY_KEY: Readonly<Record<string, string>> = {
+  " ": "Space",
+  tab: "Tab",
+  enter: "Enter",
+  escape: "Escape",
+  backspace: "Backspace",
+  delete: "Delete",
+  arrowup: "ArrowUp",
+  arrowdown: "ArrowDown",
+  arrowleft: "ArrowLeft",
+  arrowright: "ArrowRight",
+  home: "Home",
+  end: "End",
+  pageup: "PageUp",
+  pagedown: "PageDown",
+  "`": "Backquote",
+  "\\": "Backslash",
+  "[": "BracketLeft",
+  "]": "BracketRight",
+  ",": "Comma",
+  "=": "Equal",
+  "-": "Minus",
+  ".": "Period",
+  "'": "Quote",
+  ";": "Semicolon",
+  "/": "Slash",
+};
+
+/** A T3 shortcut as the browser's shell-shortcut syntax ("Ctrl+Shift+Tab"), or null. */
+export function toShellShortcut(
+  shortcut: KeybindingShortcut,
+  platform = navigator.platform,
+): string | null {
+  const key = shortcut.key;
+  const code = /^[a-z]$/.test(key)
+    ? `Key${key.toUpperCase()}`
+    : /^[0-9]$/.test(key)
+      ? `Digit${key}`
+      : /^f([1-9]|1[0-9]|2[0-4])$/.test(key)
+        ? key.toUpperCase()
+        : CODE_BY_KEY[key];
+  if (!code) return null;
+  const mac = isMacPlatform(platform);
+  const parts = [];
+  if (shortcut.ctrlKey || (shortcut.modKey && !mac)) parts.push("Ctrl");
+  if (shortcut.altKey) parts.push("Alt");
+  if (shortcut.shiftKey) parts.push("Shift");
+  if (shortcut.metaKey || (shortcut.modKey && mac)) parts.push("Super");
+  return [...parts, code].join("+");
+}
+
+/** Tells the browser which of `keybindings` the page handles itself. */
+function registerShellShortcuts(keybindings: ResolvedKeybindingsConfig): void {
+  const shortcuts = [
+    ...new Set(
+      keybindings
+        .filter((rule) => SHELL_COMMANDS.has(rule.command))
+        .flatMap((rule) => toShellShortcut(rule.shortcut) ?? []),
+    ),
+  ];
+  void plutoniumShell().then((shell) => shell?.setShellShortcuts?.(shortcuts));
+}
+
+const nextFrame = () => new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
+
+let focusAttempt = 0;
+
+/**
+ * Moves keyboard focus into `surface`'s content once it is on screen: an
+ * app's window, a browser tab's page (or its address bar while it's blank).
+ * Other surfaces focus themselves when activated.
+ */
+export async function focusRightPanelSurface(surface: RightPanelSurface): Promise<void> {
+  const attempt = ++focusAttempt;
+  const deadline = performance.now() + 3000;
+  while (performance.now() < deadline) {
+    await nextFrame();
+    // A later request (another tab) takes over.
+    if (attempt !== focusAttempt) return;
+    if (surface.kind === "app") {
+      const element = document.querySelector<
+        HTMLElement & { windowState?: string; focusWindow?: () => void }
+      >(`[data-plutonium-app-surface="${surface.windowId}"] native-window`);
+      if (element?.windowState === "attached") {
+        element.focusWindow?.();
+        return;
+      }
+    } else if (surface.kind === "preview") {
+      if (!surface.resourceId) {
+        dispatchPreviewAction("focus-url");
+        return;
+      }
+      const embed = document.querySelector<HTMLElement>(
+        `embed[data-preview-server-tab="${CSS.escape(surface.resourceId)}"]`,
+      );
+      if (embed) {
+        embed.focus();
+        return;
+      }
+    } else {
+      return;
+    }
+  }
+}
+
+/** Once `threadRef`'s new browser tab is active, puts the keyboard in its address bar. */
+async function focusNewBrowserTab(
+  threadRef: ScopedThreadRef,
+  previous: string | null,
+): Promise<void> {
+  const key = scopedThreadKey(threadRef);
+  const deadline = performance.now() + 5000;
+  while (performance.now() < deadline) {
+    await nextFrame();
+    const active = useRightPanelStore.getState().byThreadKey[key]?.activeSurfaceId ?? null;
+    if (active !== previous && active?.startsWith("browser:")) {
+      // Its view subscribes to preview actions some time after it mounts:
+      // ask until the address bar has the keyboard.
+      dispatchPreviewAction("focus-url");
+      if (document.activeElement instanceof HTMLInputElement) return;
+    }
+  }
+}
+
+/** Opens app window `window` as a tab in `threadRef`'s panel and gives it the keyboard. */
+export function openAndFocusApp(
+  threadRef: ScopedThreadRef,
+  window: { windowId: number; appId: string },
+): void {
+  const store = useRightPanelStore.getState();
+  store.openApp(threadRef, window);
+  store.show(threadRef);
+  void focusRightPanelSurface({
+    id: `app:${window.windowId}`,
+    kind: "app",
+    windowId: window.windowId,
+    appId: window.appId,
+  });
+}
+
+/**
+ * Alt+1…9, Ctrl+Tab, Ctrl+Shift+Tab and Ctrl+T for the active thread's right
+ * panel. `activate` is the panel's own tab activation.
+ */
+export function usePlutoniumPanelKeys(input: {
+  readonly threadRef: ScopedThreadRef | null;
+  readonly keybindings: ResolvedKeybindingsConfig;
+  readonly surfaces: readonly RightPanelSurface[];
+  readonly activeSurfaceId: string | null;
+  readonly activate: (surface: RightPanelSurface) => void;
+  readonly newBrowserTab: () => void;
+}): void {
+  const latest = useRef(input);
+  useEffect(() => {
+    latest.current = input;
+  });
+
+  useEffect(() => registerShellShortcuts(input.keybindings), [input.keybindings]);
+
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      const { threadRef, keybindings, surfaces, activeSurfaceId, activate, newBrowserTab } =
+        latest.current;
+      if (!threadRef || event.defaultPrevented || isCommandPaletteOpen()) return;
+      const command = resolveShortcutCommand(event, keybindings);
+      if (!command) return;
+      const show = (surface: RightPanelSurface | undefined) => {
+        event.preventDefault();
+        event.stopPropagation();
+        if (!surface || event.repeat) return;
+        activate(surface);
+        void focusRightPanelSurface(surface);
+      };
+      const jump = TAB_JUMP.indexOf(command);
+      if (jump >= 0) {
+        show(surfaces[jump]);
+        return;
+      }
+      if (command === "rightPanel.nextTab" || command === "rightPanel.previousTab") {
+        if (surfaces.length === 0) return show(undefined);
+        const current = surfaces.findIndex((surface) => surface.id === activeSurfaceId);
+        const step = command === "rightPanel.nextTab" ? 1 : -1;
+        show(surfaces[(current + step + surfaces.length) % surfaces.length]);
+        return;
+      }
+      if (command === "preview.newTab") {
+        event.preventDefault();
+        event.stopPropagation();
