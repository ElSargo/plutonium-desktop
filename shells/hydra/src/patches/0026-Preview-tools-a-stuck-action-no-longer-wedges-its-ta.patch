+
+/**
+ * How long one input event may wait for the page to take it. The page takes
+ * mouse moves with its next frame, so on a tab that isn't drawing (the display
+ * is off, or nothing keeps it painting) a move would otherwise wait forever.
+ */
+const INPUT_DELIVERY_MS = 5_000;
+
+const delivered = <A>(event: Promise<A>): Promise<A> => {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const stalled = new Promise<never>((_, reject) => {
+    timer = setTimeout(
+      () =>
+        reject(
+          new ServerBrowserOperationError(
+            "PreviewAutomationInputStalledError",
+            `The tab didn't take a mouse event within ${INPUT_DELIVERY_MS / 1000} s, so the action stopped and any held button was released. The tab isn't drawing frames: this happens while the display is off or switched to another session. Try again once it is back on screen.`,
+          ),
+        ),
+      INPUT_DELIVERY_MS,
+    );
+  });
+  return Promise.race([event, stalled]).finally(() => clearTimeout(timer));
+};
+
+/** Buttons and keys an action holds down in a page, so a stuck one can let go. */
+const heldInput = new WeakMap<
+  Page,
+  {
+    generation: number;
+    readonly buttons: Set<"left" | "right" | "middle">;
+    readonly keys: Set<string>;
   }
+>();
+const inputFor = (page: Page) => {
+  let held = heldInput.get(page);
+  if (!held) {
+    held = { generation: 0, buttons: new Set(), keys: new Set() };
+    heldInput.set(page, held);
+  }
+  return held;
+};
+
+/** Lets go of what the page's actions hold, without waiting for the page to take it. */
+const releaseHeldInput = (page: Page) => {
+  const held = inputFor(page);
+  for (const button of held.buttons) void page.mouse.up({ button }).catch(constVoid);
+  for (const key of [...held.keys].toReversed()) void page.keyboard.up(key).catch(constVoid);
+  held.buttons.clear();
+  held.keys.clear();
+};
+
+/** Stops a stuck action's input: it sends nothing more, and what it held is let go. */
+export const abandonInput = (page: Page) => {
+  inputFor(page).generation++;
+  releaseHeldInput(page);
 };
 
