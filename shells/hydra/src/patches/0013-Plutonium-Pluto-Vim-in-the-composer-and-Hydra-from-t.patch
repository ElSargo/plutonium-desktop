index 0000000000..58173d01af
--- /dev/null
+++ b/apps/web/src/plutonium/hints.ts
@@ -0,0 +1,402 @@
+// Plutonium: labels for HYDRA_KEYBOARD.md's jumps (S: what can be clicked or typed into, gw: every
+// word), here and in the panel's browser tabs (their targets come from Pluto Vim there, through the
+// helper). Typing a label goes there; while they show, every key is theirs.
+import { plutoniumShell } from "./windowStore";
+
+const ALPHABET = "asdfjklghqweruioptyzxcvbnm";
+
+export const TIMELINE = ".messages-timeline-scroll";
+
+/**
+ * The timeline as a read-only Pluto Vim field (data-pvim-readonly): it can
+ * take the keyboard, and then motions, visual mode and y work in it. Its
+ * actions are declared by plutoVim.ts when it takes focus.
+ */
+export function prepareTimeline(): HTMLElement | null {
+  const timeline = document.querySelector<HTMLElement>(TIMELINE);
+  if (!timeline) return null;
+  if (!timeline.hasAttribute("data-pvim-readonly")) {
+    timeline.setAttribute("data-pvim-readonly", "timeline");
+    timeline.tabIndex = -1;
+    timeline.style.outline = "none";
+  }
+  return timeline;
+}
+
+/** Fixed places: their label is their `g` key's letter (gc, gt, gb, gf, gd, gs), so the ones used most get learned. */
+const PLACES: ReadonlyArray<readonly [string, string]> = [
+  ["c", '[data-testid="composer-editor"]'],
+  ["t", "[data-thread-terminal-drawer]"],
+  ["b", "embed[data-preview-server-tab]"],
+  ["f", "[data-plutonium-files]"],
+];
+
+const SIGNIFICANT = [
+  "a[href]",
+  "button:not([disabled])",
+  '[role="button"]',
+  '[role="tab"]',
+  '[role="link"]',
+  '[role="menuitem"]',
+  '[role="option"]',
+  '[role="treeitem"]',
+  "input:not([type=hidden]):not([disabled])",
+  "textarea:not([disabled])",
+  "select",
+  '[contenteditable="true"]',
+  "summary",
+  '[tabindex]:not([tabindex="-1"])',
+  "native-window",
+].join(",");
+
+interface Target {
+  readonly rect: DOMRect;
+  readonly element?: Element;
+  /** In a browser tab: Pluto Vim's id for it there, and the element showing the tab. */
+  readonly remote?: { readonly targetId: string; readonly id: number; readonly embed: HTMLElement };
+  /** For gw: the word's range in its text node. */
+  readonly range?: Range;
+  /** One of PLACES, labelled with its g letter. */
+  readonly place?: boolean;
+  label: string;
+}
+
+let active: { readonly cancel: () => void } | null = null;
+
+export function hintsShowing(): boolean {
+  return active !== null;
+}
+
+function onScreen(rect: DOMRect): boolean {
+  return (
+    rect.width >= 2 &&
+    rect.height >= 2 &&
+    rect.bottom > 0 &&
+    rect.right > 0 &&
+    rect.top < window.innerHeight &&
+    rect.left < window.innerWidth
+  );
+}
+
+/** Whether `element` is what's drawn at its own centre: not hidden behind a dialog or another panel. */
+function onTop(element: Element, rect: DOMRect): boolean {
+  const x = Math.min(window.innerWidth - 1, Math.max(0, rect.left + Math.min(rect.width / 2, 12)));
+  const y = Math.min(window.innerHeight - 1, Math.max(0, rect.top + rect.height / 2));
+  const hit = document.elementFromPoint(x, y);
+  return hit !== null && (element === hit || element.contains(hit) || hit.contains(element));
+}
+
+function significantTargets(): Target[] {
+  const out: Target[] = [];
+  const taken = new Set<Element>();
+  for (const [label, selector] of PLACES) {
+    const element = document.querySelector(selector);
+    const rect = element?.getBoundingClientRect();
+    if (element && rect && onScreen(rect)) {
+      out.push({ element, rect, label, place: true });
+      taken.add(element);
+    }
+  }
+  for (const element of document.querySelectorAll(SIGNIFICANT)) {
+    if (taken.has(element) || element.closest('[aria-hidden="true"], [inert]')) continue;
+    // Inside a place already labelled (the composer's own buttons stay labelled; its editor's children don't).
+    if (
+      [...taken].some(
+        (place) =>
+          place !== element &&
+          place.contains(element) &&
+          place.matches('[contenteditable="true"], embed, native-window'),
+      )
+    )
+      continue;
+    const rect = element.getBoundingClientRect();
+    if (!onScreen(rect) || !onTop(element, rect)) continue;
+    // Nested interactive elements (a button in a row): one label, the outer one's, unless they're far apart.
+    const outer = out.find(
+      (t) =>
+        t.element?.contains(element) === true &&
+        Math.abs(t.rect.left - rect.left) < 8 &&
+        Math.abs(t.rect.top - rect.top) < 8,
+    );
+    if (outer) continue;
+    out.push({ element, rect, label: "" });
+    taken.add(element);
+  }
+  return out;
+}
+
+const WORD = /[\p{L}\p{N}_][\p{L}\p{N}_'’-]{2,}/gu;
+
+function wordTargets(): Target[] {
+  const out: Target[] = [];
+  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
+    acceptNode: (node) => {
+      const parent = node.parentElement;
+      if (!parent || parent.closest("script, style, noscript, [aria-hidden='true']"))
+        return NodeFilter.FILTER_REJECT;
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+  for (let node = walker.nextNode(); node && out.length < 600; node = walker.nextNode()) {
+    const text = node.textContent ?? "";
+    const parent = node.parentElement!;
+    const box = parent.getBoundingClientRect();
+    if (!onScreen(box)) continue;
+    for (const match of text.matchAll(WORD)) {
+      const range = document.createRange();
+      range.setStart(node, match.index);
+      range.setEnd(node, match.index + match[0].length);
+      const rect = range.getClientRects()[0];
+      if (!rect || !onScreen(rect as DOMRect) || !onTop(parent, rect as DOMRect)) continue;
+      out.push({ element: parent, rect: rect as DOMRect, range, label: "" });
+    }
+  }
+  // Nearest the composer (where the keyboard usually is) first, so they get the short labels.
+  const editor = document.querySelector('[data-testid="composer-editor"]')?.getBoundingClientRect();
+  if (editor) {
+    const dist = (r: DOMRect) => Math.hypot(r.left - editor.left, r.top - editor.top);
+    out.sort((a, b) => dist(a.rect) - dist(b.rect));
+  }
+  return out;
+}
+
+interface TabHints {
+  readonly targetId: string;
+  readonly tabId: number | null;
+  readonly items: readonly { id: number; x: number; y: number; w: number; h: number }[];
+  readonly viewport?: { width: number; height: number };
+}
+
+/**
+ * The targets in the browser tabs this page shows, placed over the element
+ * showing each (its scale included). Pluto Vim in this page asks the helper;
+ * no answer within a moment (it isn't on) is none.
+ */
+async function tabTargets(kind: "significant" | "word"): Promise<Target[]> {
+  if (!document.querySelector('[data-testid="composer-editor"][data-pvim-mode]')) return [];
+  const id = Math.random().toString(36).slice(2);
+  const tabs = await new Promise<readonly TabHints[]>((resolve) => {
+    const onReply = (event: Event) => {
+      const detail = (event as CustomEvent<{ id?: string; tabs?: TabHints[] } | null>).detail;
+      if (detail?.id !== id) return;
+      done(detail.tabs ?? []);
+    };
+    const timer = setTimeout(() => done([]), 300);
+    const done = (value: readonly TabHints[]) => {
+      clearTimeout(timer);
+      document.removeEventListener("pvim:hint-targets", onReply);
+      resolve(value);
+    };
+    document.addEventListener("pvim:hint-targets", onReply);
+    document.dispatchEvent(new CustomEvent("pvim:hint-request", { detail: { id, kind } }));
+  });
+  if (!tabs.length) return [];
+  const shell = await plutoniumShell();
+  const out: Target[] = [];
+  for (const tab of tabs) {
+    const contentId = tab.tabId == null ? undefined : shell?.tabs?.get(tab.tabId)?.contentId;
+    if (!contentId) continue;
+    const embed = document.querySelector<HTMLElement>(
+      `embed[data-content-id="${CSS.escape(contentId)}"]`,
+    );
+    if (!embed || embed.closest('[aria-hidden="true"]')) continue;
+    const box = embed.getBoundingClientRect();
+    if (!onScreen(box)) continue;
+    const cssWidth = Number(embed.dataset.previewCssWidth) || tab.viewport?.width || box.width;
+    const scale = box.width / cssWidth;
+    for (const item of tab.items) {
+      const rect = new DOMRect(
+        box.left + item.x * scale,
+        box.top + item.y * scale,
+        item.w * scale,
+        item.h * scale,
+      );
+      if (rect.top < box.top || rect.top >= box.bottom || rect.left >= box.right) continue;
+      out.push({ rect, remote: { targetId: tab.targetId, id: item.id, embed }, label: "" });
+    }
+  }
+  return out;
+}
+
+/** Labels for `count` targets, none a prefix of another, without the reserved letters as first letters. */
+function makeLabels(count: number, reserved: ReadonlySet<string>): string[] {
+  const letters = [...ALPHABET].filter((ch) => !reserved.has(ch));
+  if (count <= letters.length) return letters.slice(0, count);
+  // Some letters alone, the rest start two-letter labels.
+  let singles = letters.length;
+  while (singles > 0 && singles + (letters.length - singles) * ALPHABET.length < count) singles--;
+  const out = letters.slice(0, singles);
+  for (const first of letters.slice(singles)) {
+    for (const second of ALPHABET) {
+      if (out.length >= count) return out;
+      out.push(first + second);
+    }
+  }
+  return out;
+}
+
+function draw(targets: readonly Target[]): {
+  readonly host: HTMLElement;
+  readonly items: Map<Target, HTMLElement>;
+} {
+  const host = document.createElement("plutonium-hints");
+  host.style.cssText = "position:fixed;inset:0;z-index:2147483647;pointer-events:none";
+  const root = host.attachShadow({ mode: "closed" });
+  const style = document.createElement("style");
+  // Hydra's own look, from its theme's tokens (they reach into the shadow root), light and dark.
+  style.textContent =
+    "b{position:fixed;font:600 11px/1 var(--font-mono, ui-monospace, monospace);padding:2px 4px;" +
+    "border-radius:calc(var(--radius, 8px) - 3px);color:var(--popover-foreground);background:var(--popover);" +
+    "border:1px solid var(--border);box-shadow:0 1px 4px rgb(0 0 0 / 0.18);text-transform:uppercase;letter-spacing:.02em}" +
+    "b.place{color:var(--primary-foreground);background:var(--primary);border-color:transparent}" +
+    "b i{font-style:normal;color:var(--muted-foreground)}b.place i{color:inherit;opacity:.6}";
+  root.append(style);
+  const items = new Map<Target, HTMLElement>();
+  for (const target of targets) {
+    const b = document.createElement("b");
+    b.textContent = target.label;
+    if (target.place) b.className = "place";
+    b.style.left = `${Math.max(0, Math.round(target.rect.left))}px`;
+    b.style.top = `${Math.max(0, Math.round(target.rect.top))}px`;
+    root.append(b);
+    items.set(target, b);
+  }
+  document.documentElement.append(host);
+  return { host, items };
+}
+
+/** Goes to a target: a field gets the keyboard (a word in it, the cursor), anything else is clicked. */
+function go(target: Target): void {
+  const { element, remote } = target;
+  if (remote) {
+    // The tab takes the keyboard, then goes to its target (Pluto Vim there clicks, focuses or places the cursor).
+    remote.embed.focus();
+    document.dispatchEvent(
+      new CustomEvent("pvim:hint-go", { detail: { targetId: remote.targetId, id: remote.id } }),
+    );
+    return;
+  }
+  if (!element) return;
+  const editable = element.closest<HTMLElement>('[contenteditable="true"], textarea, input');
+  if (target.range) {
+    // A word in the timeline: the keyboard goes there, with the cursor on the word, to read and yank.
+    const timeline = element.closest<HTMLElement>(TIMELINE) ? prepareTimeline() : null;
+    if (timeline && !editable) {
+      window.getSelection()?.collapse(target.range.startContainer, target.range.startOffset);
+      timeline.focus({ preventScroll: true });
+      return;
+    }
+    if (editable) {
+      editable.focus();
+      const selection = window.getSelection();
+      selection?.collapse(target.range.startContainer, target.range.startOffset);
+      return;
+    }
+    const clickable = element.closest<HTMLElement>(
+      "a[href], button, [role='button'], [role='tab'], [role='treeitem']",
+    );
+    if (clickable) {
+      clickable.focus({ preventScroll: true });
+      clickable.click();
+      return;
+    }
+    // Plain text: the word, selected, ready to copy.
+    const selection = window.getSelection();
+    selection?.removeAllRanges();
+    selection?.addRange(target.range);
+    return;
+  }
+  const html = element as HTMLElement & { focusWindow?: () => void };
+  if (typeof html.focusWindow === "function") return html.focusWindow();
+  if (element.matches("embed, [data-thread-terminal-drawer], [data-plutonium-files]")) {
+    const inner = element.matches("embed")
+      ? html
+      : element.querySelector<HTMLElement>("textarea, [tabindex]");
+    (inner ?? html).focus();
+    return;
+  }
+  if (editable && editable === element) {
+    editable.focus();
+    return;
+  }
+  html.focus({ preventScroll: true });
+  html.click();
+}
+
+/**
+ * Shows labels for `kind`, and takes every key until one is typed (go there),
+ * Escape, or a key no label starts with. `onEnd` runs when they're gone.
+ */
+export async function showHints(kind: "significant" | "word", onEnd?: () => void): Promise<void> {
+  active?.cancel();
+  // While the tabs answer, keys typed already are the labels' (they're drawn a moment later).
+  const early: KeyboardEvent[] = [];
+  const hold = (event: KeyboardEvent) => {
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    early.push(event);
+  };
+  window.addEventListener("keydown", hold, true);
+  active = { cancel: () => window.removeEventListener("keydown", hold, true) };
+  const own = kind === "significant" ? significantTargets() : wordTargets();
+  const targets = [...own, ...(await tabTargets(kind))];
+  window.removeEventListener("keydown", hold, true);
+  if (targets.length === 0) {
+    active = null;
+    onEnd?.();
+    return;
+  }
+  const reserved = new Set(targets.filter((t) => t.label).map((t) => t.label));
+  const unlabelled = targets.filter((t) => !t.label);
+  makeLabels(unlabelled.length, reserved).forEach((label, k) => {
+    unlabelled[k]!.label = label;
+  });
+  const shown = targets.filter((t) => t.label);
+  const { host, items } = draw(shown);
+  let typed = "";
+
+  const end = () => {
+    window.removeEventListener("keydown", onKey, true);
+    window.removeEventListener("pointerdown", end, true);
+    window.removeEventListener("blur", end);
+    window.removeEventListener("scroll", end, true);
+    host.remove();
+    active = null;
+    onEnd?.();
+  };
+  const onKey = (event: KeyboardEvent) => {
+    if (event.key === "Shift" || event.key === "Control" || event.key === "Alt") return;
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    if (event.key === "Escape" || event.ctrlKey || event.altKey || event.metaKey) return end();
+    if (event.key === "Backspace") {
+      typed = typed.slice(0, -1);
+    } else if (event.key.length === 1) {
+      typed += event.key.toLowerCase();
+    } else return end();
+    const matching = shown.filter((t) => t.label.startsWith(typed));
+    if (matching.length === 0) return end();
+    const exact = matching.find((t) => t.label === typed);
+    if (exact && matching.length === 1) {
+      end();
+      go(exact);
+      return;
+    }
+    for (const [target, el] of items) {
+      const on = target.label.startsWith(typed);
+      el.style.display = on ? "" : "none";
+      if (on)
+        el.innerHTML = `<i>${target.label.slice(0, typed.length)}</i>${target.label.slice(typed.length)}`;
+    }
+  };
+  // Registered after the page's own, at the window's capture phase: every key while they show is theirs.
+  window.addEventListener("keydown", onKey, true);
+  window.addEventListener("pointerdown", end, true);
+  window.addEventListener("blur", end);
+  window.addEventListener("scroll", end, true);
+  active = { cancel: end };
+  for (const event of early) {
+    if (!active) break;
+    onKey(event);
+  }
+}
