@@ -0,0 +1,502 @@
+// Plutonium: Hydra's side of HYDRA_KEYBOARD.md: the slots (Space, Backspace, Tab, H, L),
+// the g places and z shows, run as Pluto Vim page actions from the composer
+// (plutoVim.ts), and the same keys when the keyboard isn't in a field.
+import type {
+  KeybindingCommand,
+  ResolvedKeybindingsConfig,
+  ScopedThreadRef,
+} from "@t3tools/contracts";
+import { scopedThreadKey } from "@t3tools/client-runtime/environment";
+import type { AnyRouter } from "@tanstack/react-router";
+
+import { dispatchPreviewAction } from "~/components/preview/previewActionBus";
+import { focusActiveDrawerTerminal } from "~/lib/terminalFocus";
+import { isMacPlatform } from "~/lib/utils";
+import { type RightPanelSurface, useRightPanelStore } from "~/rightPanelStore";
+import { selectThreadTerminalUiState, useTerminalUiStateStore } from "~/terminalUiStateStore";
+
+import { toggleFilePane } from "./files/filePanes";
+import { hintsShowing, prepareTimeline, showHints, TIMELINE } from "./hints";
+import { focusRightPanelSurface } from "./panelKeys";
+import { plutoniumShell } from "./windowStore";
+
+const EDITOR = '[data-testid="composer-editor"]';
+
+export interface HydraKeysContext {
+  readonly threadRef: ScopedThreadRef;
+  readonly keybindings: ResolvedKeybindingsConfig;
+  readonly router: AnyRouter;
+  readonly openLink: (url: string) => void;
+}
+
+/** The composer that mounted last: the one the keys act for. */
+let current: HydraKeysContext | null = null;
+
+export function setHydraKeysContext(context: HydraKeysContext | null): void {
+  current = context;
+}
+
+// ── T3's own commands ────────────────────────────────────────────────────
+
+/**
+ * Runs one of T3's keybinding commands: through the chat's shortcut handlers
+ * (useChatShortcuts listens for plutonium:command), else as its key, which
+ * the sidebar's and the layout's window listeners act on.
+ */
+export function runCommand(command: KeybindingCommand): boolean {
+  const detail = { command, handled: false };
+  window.dispatchEvent(new CustomEvent("plutonium:command", { detail }));
+  if (detail.handled) return true;
+  const binding = current?.keybindings.find((entry) => entry.command === command);
+  if (!binding) return false;
+  const { shortcut } = binding;
+  const mac = isMacPlatform(navigator.platform);
+  document.body.dispatchEvent(
+    new KeyboardEvent("keydown", {
+      key: shortcut.key,
+      metaKey: shortcut.metaKey || (shortcut.modKey && mac),
+      ctrlKey: shortcut.ctrlKey || (shortcut.modKey && !mac),
+      shiftKey: shortcut.shiftKey,
+      altKey: shortcut.altKey,
+      bubbles: true,
+      cancelable: true,
+    }),
+  );
+  return true;
+}
+
+// ── Threads ──────────────────────────────────────────────────────────────
+
+/** Threads by recent use, the newest first: route paths. */
+const recent: string[] = [];
+/** A run of Tab presses: where it started, and how far back it is. */
+let cycle: { readonly order: readonly string[]; index: number; at: number } | null = null;
+const CYCLE_MS = 1200;
+
+/** The composer's thread is in use now: its address (a thread's, or a draft's) goes to the front. */
+export function noteThreadUsed(path: string): void {
+  // A thread a Tab run lands on doesn't reorder the run.
+  if (cycle && performance.now() - cycle.at < CYCLE_MS) return;
+  const at = recent.indexOf(path);
+  if (at >= 0) recent.splice(at, 1);
+  recent.unshift(path);
+  if (recent.length > 50) recent.pop();
+}
+
+function recentThread(count: number): void {
+  const context = current;
+  if (!context) return;
+  const now = performance.now();
+  if (!cycle || now - cycle.at > CYCLE_MS) cycle = { order: [...recent], index: 0, at: now };
+  cycle.index = Math.min(cycle.index + count, cycle.order.length - 1);
+  cycle.at = now;
+  const path = cycle.order[cycle.index];
+  if (!path || path === context.router.state.location.pathname) return;
+  void context.router.history.push(path);
+  // When the run ends, the thread it stopped on is the newest.
+  const order = cycle.order;
+  const index = cycle.index;
+  setTimeout(() => {
+    if (
+      cycle &&
+      cycle.order === order &&
+      cycle.index === index &&
+      performance.now() - cycle.at >= CYCLE_MS - 20
+    ) {
+      cycle = null;
+      const moved = recent.indexOf(path);
+      if (moved >= 0) recent.splice(moved, 1);
+      recent.unshift(path);
+    }
+  }, CYCLE_MS);
+}
+
+// ── Regions ──────────────────────────────────────────────────────────────
+
+function panel(threadRef: ScopedThreadRef) {
+  return useRightPanelStore.getState().byThreadKey[scopedThreadKey(threadRef)] ?? null;
+}
+
+/** Puts a panel surface in front and gives it the keyboard. */
+function showSurface(threadRef: ScopedThreadRef, surface: RightPanelSurface): void {
+  const store = useRightPanelStore.getState();
+  store.activateSurface(threadRef, surface.id);
+  store.show(threadRef);
+  void focusRightPanelSurface(surface);
+}
+
+/** The count'th surface of a kind (1 by default), else the active one if it's of that kind. */
+function surfaceOf(
+  threadRef: ScopedThreadRef,
+  kind: RightPanelSurface["kind"],
+  count: number | null,
+) {
+  const state = panel(threadRef);
+  const surfaces = (state?.surfaces ?? []).filter((surface) => surface.kind === kind);
+  if (count != null) return surfaces[count - 1] ?? null;
+  return (
+    surfaces.find((surface) => surface.id === state?.activeSurfaceId) ?? surfaces.at(-1) ?? null
+  );
+}
+
+/** Runs `show`, then gives the keyboard back to the composer if it had it: z… keys don't move focus. */
+function keepFocus(show: () => void): void {
+  const had = document.activeElement;
+  show();
+  if (!(had instanceof HTMLElement) || !had.isConnected) return;
+  requestAnimationFrame(() =>
+    requestAnimationFrame(() => {
+      if (document.activeElement !== had && had.isConnected) had.focus({ preventScroll: true });
+    }),
+  );
+}
+
+/** Sets Pluto Vim's mode in a field (dom.js listens for pvim:set-mode). */
+export function setVimMode(el: Element, mode: "normal" | "insert"): void {
+  el.dispatchEvent(new CustomEvent("pvim:set-mode", { detail: { mode }, bubbles: true }));
+}
+
+/** The composer gets the keyboard (from a tab or an app too); `insert` puts it in insert mode, else its mode stays. */
+function focusEditor(where: "keep" | "end", insert = false): void {
+  const editor = document.querySelector<HTMLElement>(EDITOR);
+  if (!editor) return;
+  void plutoniumShell().then((shell) => shell?.focusPage?.());
+  editor.focus();
+  if (where === "end") {
+    const selection = window.getSelection();
+    selection?.selectAllChildren(editor);
+    selection?.collapseToEnd();
+  }
+  if (insert) setVimMode(editor, "insert");
+}
+
+async function waitFor<T>(find: () => T | null | undefined, ms = 1500): Promise<T | null> {
+  const deadline = performance.now() + ms;
+  while (performance.now() < deadline) {
+    const found = find();
+    if (found) return found;
+    await new Promise((resolve) => requestAnimationFrame(resolve));
+  }
+  return null;
+}
+
+function pageTimeline(dir: 1 | -1, count: number | null): void {
+  const timeline = document.querySelector<HTMLElement>(TIMELINE);
+  if (!timeline) return;
+  timeline.scrollBy({
+    top: dir * timeline.clientHeight * 0.5 * (count ?? 1),
+    behavior: "instant" as ScrollBehavior,
+  });
+}
+
+/** gp: this thread's waiting approval gets the keyboard, where y and n answer it. */
+function focusPending(): boolean {
+  const accept = document.querySelector<HTMLElement>(
+    '[data-pvim-approval="accept"]:not([disabled])',
+  );
+  if (!accept) return false;
+  accept.focus();
+  return true;
+}
+
+function answerPending(decision: "accept" | "decline"): boolean {
+  const button = document.querySelector<HTMLElement>(
+    `[data-pvim-approval="${decision}"]:not([disabled])`,
+  );
+  if (!button) return false;
+  button.click();
+  return true;
+}
+
+/**
+ * While S or gw labels show, every key is theirs: the composer stops yielding
+ * keys to vim, and the timeline (a read-only field, which claims every key
+ * first) is no field until they're gone.
+ */
+function withoutYields(show: (done: () => void) => void): void {
+  const editors = [...document.querySelectorAll(EDITOR)];
+  const saved = editors.map((el) => el.getAttribute("data-pvim-yield") ?? "");
+  for (const el of editors) el.setAttribute("data-pvim-yield", "");
+  const timeline = document.querySelector<HTMLElement>(`${TIMELINE}[data-pvim-readonly]`);
+  timeline?.setAttribute("data-pvim", "off");
+  show(() => {
+    editors.forEach(
+      (el, k) => el.isConnected && el.setAttribute("data-pvim-yield", saved[k] ?? ""),
+    );
+    timeline?.removeAttribute("data-pvim");
+  });
+}
+
+/**
+ * Pluto Vim draws its own cursor (in read-only text) and its s labels: in
+ * Hydra's theme, through the custom properties it reads (dom.js).
+ */
+function themePlutoVim(): void {
+  if (typeof document === "undefined") return;
+  const root = document.documentElement.style;
+  root.setProperty("--pvim-caret", "var(--primary)");
+  root.setProperty("--pvim-label-bg", "var(--popover)");
+  root.setProperty("--pvim-label-fg", "var(--popover-foreground)");
+  root.setProperty("--pvim-label-border", "var(--border)");
+  root.setProperty("--pvim-label-font", "var(--font-mono)");
+  root.setProperty("--pvim-label-radius", "calc(var(--radius) - 3px)");
+}
+themePlutoVim();
+
+// ── The actions ──────────────────────────────────────────────────────────
+
+export interface ActionDetail {
+  readonly count?: number | null;
+  readonly text?: string;
+}
+
+type Action = (detail: ActionDetail, context: HydraKeysContext) => void;
+
+const ACTIONS: Record<string, Action> = {
+  "context.pageDown": ({ count }) => pageTimeline(1, count ?? null),
+  "context.pageUp": ({ count }) => pageTimeline(-1, count ?? null),
+  "item.recent": ({ count }) => recentThread(count ?? 1),
+  "item.previous": () => runCommand("thread.previous"),
+  "item.next": () => runCommand("thread.next"),
+  "jump.significant": () => withoutYields((done) => showHints("significant", done)),
+  "jump.word": () => withoutYields((done) => showHints("word", done)),
+  open: ({ text }, { openLink, threadRef }) => {
+    const target = text?.replace(/[.,;:!?)]+$/, "") ?? "";
+    if (!target) return;
+    if (/^(https?:\/\/|www\.)/.test(target))
+      openLink(target.startsWith("www.") ? `https://${target}` : target);
+    else if (/[/.]/.test(target)) {
+      const store = useRightPanelStore.getState();
+      store.openFile(threadRef, target.replace(/^@/, ""));
+      store.show(threadRef);
+    }
+  },
+  "place.composer": () => focusEditor("keep"),
+  "place.composerInsert": () => focusEditor("keep", true),
+  "place.composerEnd": () => focusEditor("end", true),
+  // In the timeline (read-only): i, a, c… go back to the composer, typing.
+  insert: () => focusEditor("keep", true),
+  // The timeline, at its end, with the keyboard in it: a cursor to read and yank with.
+  "place.latest": () => {
+    const timeline = prepareTimeline();
+    if (!timeline) return;
+    timeline.scrollTo({ top: timeline.scrollHeight, behavior: "instant" as ScrollBehavior });
+    requestAnimationFrame(() => {
+      const walker = document.createTreeWalker(timeline, NodeFilter.SHOW_TEXT);
+      let last: Node | null = null;
+      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+        if (node.textContent?.trim()) last = node;
+      }
+      if (last) window.getSelection()?.collapse(last, 0);
+      timeline.focus({ preventScroll: true });
+    });
+  },
+  "place.pending": () => {
+    focusPending();
+  },
+  "place.terminal": (_, { threadRef }) => {
+    const { terminalOpen } = selectThreadTerminalUiState(
+      useTerminalUiStateStore.getState().terminalUiStateByThreadKey,
+      threadRef,
+    );
+    if (!terminalOpen) runCommand("terminal.toggle");
+    void waitFor(
+      () =>
+        selectThreadTerminalUiState(
+          useTerminalUiStateStore.getState().terminalUiStateByThreadKey,
+          threadRef,
+        ).terminalOpen,
+    ).then(() => focusActiveDrawerTerminal(threadRef));
+  },
+  "place.browser": ({ count }, { threadRef }) => {
+    const surface = surfaceOf(threadRef, "preview", count ?? null);
+    if (surface) showSurface(threadRef, surface);
+    else runCommand("preview.newTab");
+  },
+  "place.address": ({ count }, { threadRef }) => {
+    const surface = surfaceOf(threadRef, "preview", count ?? null);
+    if (!surface) return void runCommand("preview.newTab");
+    const store = useRightPanelStore.getState();
+    store.activateSurface(threadRef, surface.id);
+    store.show(threadRef);
+    // The browser view subscribes to preview actions once it's mounted.
+    void waitFor(() =>
+      document.activeElement instanceof HTMLInputElement
+        ? true
+        : (dispatchPreviewAction("focus-url"), null),
+    );
+  },
+  "place.app": ({ count }, { threadRef }) => {
+    const surface = surfaceOf(threadRef, "app", count ?? null);
+    if (surface) showSurface(threadRef, surface);
+  },
+  "place.files": (_, { threadRef }) => {
+    const pane = () => document.querySelector<HTMLElement>("[data-plutonium-files]");
+    if (!pane()) toggleFilePane(threadRef);
+    void waitFor(pane).then((el) => (el?.querySelector<HTMLElement>("[tabindex]") ?? el)?.focus());
+  },
+  "place.diff": (_, { threadRef }) => {
+    const surface = surfaceOf(threadRef, "diff", null);
+    if (surface) showSurface(threadRef, surface);
+    else runCommand("diff.toggle");
+  },
+  "place.sidebar": () => {
+    const row =
+      document.querySelector<HTMLElement>(
+        '[data-sidebar] [aria-current="page"], [aria-current="page"][data-thread-key]',
+      ) ?? document.querySelector<HTMLElement>('[aria-current="page"]');
+    row?.focus();
+  },
+  "show.terminal": () => keepFocus(() => runCommand("terminal.toggle")),
+  "show.panel": () => keepFocus(() => runCommand("rightPanel.toggle")),
+  "show.sidebar": () => keepFocus(() => runCommand("sidebar.toggle")),
+  "show.files": (_, { threadRef }) => keepFocus(() => toggleFilePane(threadRef)),
+  "show.diff": () => keepFocus(() => runCommand("diff.toggle")),
+  "show.maximize": () => keepFocus(() => runCommand("rightPanel.toggleMaximized")),
+};
+
+export const HYDRA_ACTIONS: readonly string[] = Object.keys(ACTIONS);
+
+export function runHydraAction(name: string, detail: ActionDetail): boolean {
+  const action = ACTIONS[name];
+  if (!action || !current) return false;
+  action(detail, current);
+  return true;
+}
+
+// ── Off a field ──────────────────────────────────────────────────────────
+
+/**
+ * The same keys when the keyboard isn't in a text field (a button S went to,
+ * a row, the page): Pluto Vim only acts in fields. Keys that are a page's
+ * own there (a terminal, the file manager, a menu, a dialog) stay theirs.
+ */
+const OFF_FIELD: Record<string, string> = {
+  S: "jump.significant",
+  H: "item.previous",
+  L: "item.next",
+  gw: "jump.word",
+  gi: "place.composerInsert",
+  gA: "place.composerEnd",
+  i: "place.composerInsert",
+  a: "place.composerInsert",
+  A: "place.composerEnd",
+  gc: "place.composer",
+  gm: "place.latest",
+  gp: "place.pending",
+  gt: "place.terminal",
+  gb: "place.browser",
+  gB: "place.address",
+  ga: "place.app",
+  gf: "place.files",
+  gd: "place.diff",
+  gs: "place.sidebar",
+  zt: "show.terminal",
+  zb: "show.panel",
+  zs: "show.sidebar",
+  zf: "show.files",
+  zd: "show.diff",
+  zm: "show.maximize",
+};
+
+const OWN_KEYS =
+  'input, textarea, select, [contenteditable="true"], [data-pvim-readonly], [data-terminal-owner], [data-plutonium-files], [role="menu"], [role="listbox"], [role="dialog"], [role="combobox"], [cmdk-root], embed, native-window';
+
+let pending = "";
+let pendingTimer: ReturnType<typeof setTimeout> | undefined;
+
+/** Super+Enter (shellKeys.ts): the composer, at its end, in insert mode, from anywhere. */
+function onSuperKey(event: KeyboardEvent): void {
+  if (!event.metaKey || event.ctrlKey || event.altKey || event.shiftKey || event.key !== "Enter")
+    return;
+  event.preventDefault();
+  event.stopImmediatePropagation();
+  if (!event.repeat) focusEditor("end", true);
+}
+
+function onOffFieldKey(event: KeyboardEvent): void {
+  if (
+    event.defaultPrevented ||
+    event.ctrlKey ||
+    event.altKey ||
+    event.metaKey ||
+    hintsShowing() ||
+    !current
+  )
+    return;
+  const target = event.target instanceof Element ? event.target : null;
+  if (target?.closest(OWN_KEYS)) return;
+  if (event.key === "y" || event.key === "n") {
+    // A waiting approval with the keyboard on it (gp): y approves, n declines.
+    if (
+      target?.closest("[data-pvim-approval]") &&
+      answerPending(event.key === "y" ? "accept" : "decline")
+    ) {
+      event.preventDefault();
+      return;
+    }
+  }
+  if (event.key.length !== 1) return;
+  const keys = pending + event.key;
+  const exact = OFF_FIELD[keys];
+  const more = Object.keys(OFF_FIELD).some(
+    (lhs) => lhs.length > keys.length && lhs.startsWith(keys),
+  );
+  clearTimeout(pendingTimer);
+  if (exact) {
+    pending = "";
+    event.preventDefault();
+    runHydraAction(exact, {});
+    return;
+  }
+  if (more) {
+    pending = keys;
+    event.preventDefault();
+    pendingTimer = setTimeout(() => (pending = ""), 1000);
+    return;
+  }
+  pending = "";
+  // With Pluto Vim on, typing off a field doesn't type into the composer (T3's type-to-focus): i does.
+  if (event.key !== " " && document.querySelector(`${EDITOR}[data-pvim-mode]`))
+    event.preventDefault();
+}
+
+/**
+ * A page key from a tab or an app (the helper relays a place, a show or a
+ * jump the page there doesn't have: plutonium:page-key).
+ */
+function onRelayedKey(event: Event): void {
+  const detail = (
+    event as CustomEvent<{ name?: unknown; count?: number | null; text?: string } | null>
+  ).detail;
+  if (!detail || typeof detail.name !== "string" || !current) return;
+  const name = detail.name;
+  const run = () =>
+    runHydraAction(name, {
+      count: detail.count ?? null,
+      ...(detail.text ? { text: detail.text } : {}),
+    });
+  // Labels and places are this page's: it takes the keyboard first.
+  if (name.startsWith("jump.") || name.startsWith("place.")) {
+    void plutoniumShell().then((shell) => {
+      shell?.focusPage?.();
+      requestAnimationFrame(run);
+    });
+  } else run();
+}
+
+let installed = false;
+
+/**
+ * At the window's capture phase, before T3's own (its type-to-focus would
+ * take letters first): called when this module loads, before T3 attaches.
+ */
+export function installOffFieldKeys(): void {
+  if (installed || typeof window === "undefined") return;
+  installed = true;
+  window.addEventListener("keydown", onSuperKey, true);
+  window.addEventListener("keydown", onOffFieldKey, true);
+  window.addEventListener("plutonium:page-key", onRelayedKey);
+}
+
+installOffFieldKeys();
