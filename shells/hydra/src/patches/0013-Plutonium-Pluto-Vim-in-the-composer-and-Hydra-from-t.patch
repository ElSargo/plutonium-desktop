+// The composer integrates with Plutonium's vim mode (PLUTO_VIM.md, "Pages that integrate"):
+// it declares its actions in data-pvim-* attributes and runs each pvim:action with its own key
+// handling, and fills HYDRA_KEYBOARD.md's keys (hydraKeys.ts). Outside insert mode it yields
+// Space, Backspace and Tab, which the editor would take first; Ctrl+N/P/Y/E while a menu is open.
+import type { ResolvedKeybindingsConfig, ScopedThreadRef } from "@t3tools/contracts";
+import { useRouter, useRouterState } from "@tanstack/react-router";
+import { useEffect, useState } from "react";
+
+import { useOpenLink } from "../browser/useOpenLink";
+import { useStableCallback } from "../hooks/useStableCallback";
+import {
+  HYDRA_ACTIONS,
+  installOffFieldKeys,
+  noteThreadUsed,
+  runHydraAction,
+  setHydraKeysContext,
+  setVimMode as setFieldMode,
+} from "./hydraKeys";
+import { TIMELINE } from "./hints";
+
+const EDITOR = '[data-testid="composer-editor"]';
+
+const ACTION_KEYS: Record<string, string> = {
+  submit: "Enter",
+  "history.prev": "ArrowUp",
+  "history.next": "ArrowDown",
+  "menu.select": "Enter",
+  "menu.next": "ArrowDown",
+  "menu.prev": "ArrowUp",
+  "menu.close": "Escape",
+};
+
+export interface PlutoVimComposer {
+  readonly onCommandKey: (key: string, event: KeyboardEvent) => boolean;
+  readonly menuOpen: boolean;
+  /** Actions that aren't keys, which are also `:` commands. */
+  readonly commands: Record<string, () => void>;
+  /** The thread the composer is for, and what HYDRA_KEYBOARD.md's keys need from the page. */
+  readonly threadRef: ScopedThreadRef;
+  readonly keybindings: ResolvedKeybindingsConfig;
+  /** A side chat's composer: the keys act for the main one. */
+  readonly embedded?: boolean;
+}
+
+export function usePlutoVimComposer(composer: PlutoVimComposer): void {
+  const { menuOpen, threadRef, keybindings, embedded = false } = composer;
+  const open = useOpenLink(threadRef);
+  const openLink = useStableCallback(
+    (url: string) => void open(url).catch((cause: unknown) => console.error(cause)),
+  );
+  const commandNames = Object.keys(composer.commands).join(" ");
+  const router = useRouter();
+  const pathname = useRouterState({ select: (state) => state.location.pathname });
+  /** Pluto Vim's mode in the editor (pvim:mode): insert mode keeps Space, Backspace and Tab the editor's. */
+  const [vimMode, setVimMode] = useState<string>("insert");
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- tells the page-wide keys (hydraKeys.ts) which thread and keybindings they act for, and installs their listener once
+  useEffect(() => {
+    if (embedded) return;
+    setHydraKeysContext({ threadRef, keybindings, router, openLink });
+    installOffFieldKeys();
+  }, [embedded, threadRef, keybindings, router, openLink]);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- records the thread as used for Tab's recent order when it's shown
+  useEffect(() => {
+    if (!embedded) noteThreadUsed(pathname);
+  }, [embedded, pathname]);
+
+  const onAction = useStableCallback((event: Event) => {
+    const target = event.target instanceof Element ? event.target : null;
+    const el = target?.closest(EDITOR) ?? null;
+    // The timeline, as a read-only field (hints.ts, prepareTimeline): Hydra's actions only.
+    const timeline = el ? null : (target?.closest(TIMELINE) ?? null);
+    const detail = (
+      event as CustomEvent<{
+        name?: unknown;
+        count?: number | null;
+        text?: string;
+        handled?: boolean;
+      } | null>
+    ).detail;
+    const name = detail?.name;
+    if ((!el && !timeline) || !detail || typeof name !== "string" || detail.handled) return;
+    detail.handled = true;
+    if (timeline) {
+      runHydraAction(name, {
+        count: detail.count ?? null,
+        ...(detail.text ? { text: detail.text } : {}),
+      });
+      return;
+    }
+    const command = composer.commands[name];
+    if (command) return command();
+    if (
+      runHydraAction(name, {
+        count: detail.count ?? null,
+        ...(detail.text ? { text: detail.text } : {}),
+      })
+    )
+      return;
+    const key = ACTION_KEYS[name];
+    if (!key) return;
+    const handled = composer.onCommandKey(key, new KeyboardEvent("keydown", { key }));
+    // With Ctrl+Enter to send (Settings, the send shortcut), a plain Enter isn't a send.
+    if (!handled && name === "submit") {
+      composer.onCommandKey(key, new KeyboardEvent("keydown", { key, ctrlKey: true }));
+    }
+  });
+
+  const normal = vimMode !== "insert";
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- keeps the editor DOM's data-pvim-* attributes (read by the vim engine in another world) in step with the open menu and vim's mode
+  useEffect(() => {
+    const actions = [
+      "submit",
+      "history.prev",
+      "history.next",
+      ...(menuOpen ? ["menu.select", "menu.next", "menu.prev", "menu.close"] : []),
+      ...(embedded ? [] : HYDRA_ACTIONS),
+      ...commandNames.split(" ").filter(Boolean),
+    ].join(" ");
+    const yields = [
+      ...(menuOpen ? ["<C-n>", "<C-p>", "<C-y>", "<C-e>"] : []),
+      // ProseMirror deletes on Backspace and the composer moves focus on Tab before vim sees them.
+      ...(normal && !embedded ? ["<Space>", "<BS>", "<Tab>"] : []),
+    ].join(" ");
+    const declare = (el: Element) => {
+      el.setAttribute("data-pvim-actions", actions);
+      el.setAttribute("data-pvim-yield", yields);
+      el.setAttribute("data-pvim-commands", commandNames);
+    };
+    document.querySelectorAll(EDITOR).forEach(declare);
+    // A thread switch remounts the editor: declare it again when it takes focus.
+    const onFocus = (event: FocusEvent) => {
+      const target = event.target instanceof Element ? event.target : null;
+      // The timeline as a read-only field: Hydra's actions (places, shows, insert back in the composer).
+      if (!embedded && target?.matches(`${TIMELINE}[data-pvim-readonly]`)) {
+        target.setAttribute("data-pvim-actions", HYDRA_ACTIONS.join(" "));
+        return;
+      }
+      const el = target?.closest<HTMLElement>(EDITOR) ?? null;
+      if (!el) return;
+      declare(el);
+      // A field starts in the mode its rules say (pvim:mode fires only on changes).
+      if (el.dataset.pvimMode) setVimMode(el.dataset.pvimMode);
+    };
+    const onMode = (event: Event) => {
+      const el = event.target instanceof Element ? event.target.closest(EDITOR) : null;
+      const mode = (event as CustomEvent<{ mode?: unknown } | null>).detail?.mode;
+      if (el && typeof mode === "string") setVimMode(mode);
+    };
+    document.addEventListener("focusin", onFocus, true);
+    document.addEventListener("pvim:mode", onMode);
+    return () => {
+      document.removeEventListener("focusin", onFocus, true);
+      document.removeEventListener("pvim:mode", onMode);
+    };
+  }, [menuOpen, commandNames, normal, embedded]);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- a document listener that puts the composer back in normal mode once Enter has sent its message
+  useEffect(() => {
+    if (embedded) return;
+    const onKeyDown = (event: KeyboardEvent) => {
+      if (event.key !== "Enter" || event.shiftKey || event.altKey) return;
+      const el = event.target instanceof Element ? event.target.closest<HTMLElement>(EDITOR) : null;
+      if (!el || el.dataset.pvimMode !== "insert") return;
+      // Sent: the editor is empty once the composer has taken the message.
+      setTimeout(() => {
+        if (el.isConnected && el.dataset.pvimMode === "insert" && !el.innerText.trim())
+          setFieldMode(el, "normal");
+      }, 150);
+    };
+    document.addEventListener("keydown", onKeyDown, true);
+    return () => document.removeEventListener("keydown", onKeyDown, true);
+  }, [embedded]);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- a document listener for the vim engine's pvim:action events, held while mounted
+  useEffect(() => {
+    document.addEventListener("pvim:action", onAction);
+    return () => document.removeEventListener("pvim:action", onAction);
+  }, [onAction]);
+}
