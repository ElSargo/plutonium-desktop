diff --git a/apps/web/src/plutonium/ModePill.tsx b/apps/web/src/plutonium/ModePill.tsx
new file mode 100644
index 0000000000..cf092a0328
--- /dev/null
+++ b/apps/web/src/plutonium/ModePill.tsx
@@ -0,0 +1,195 @@
+// Plutonium: the keyboard's state in the status cluster (HYDRA_KEYBOARD.md, "One input model"):
+// the desktop's mode, where the keyboard is, the keys typed so far, a macro recording, and what a
+// waiting prefix can go on to. From pvim:state (this page's Pluto Vim) and plutonium:pvim-state
+// (a tab's or an app's, through the helper), whichever has the keyboard.
+import { memo, useEffect, useState } from "react";
+
+import { cn } from "~/lib/utils";
+
+interface KeyboardState {
+  readonly mode: string;
+  readonly sub: string;
+  readonly place: string;
+  readonly label: string;
+  readonly site: string;
+  readonly pending: string;
+  readonly continuations: readonly { readonly keys: string; readonly name: string }[];
+  readonly recording: string | null;
+  readonly cmdline: boolean;
+  readonly focused: boolean;
+  readonly tabId?: number | null;
+  readonly windowId?: number;
+}
+
+/** How long a prefix waits before what can follow it shows. */
+const WHICH_KEY_MS = 400;
+
+/** What the keys do, by their action's name (commands.js, hydraKeys.ts), for the which-key list. */
+const NAMES: Record<string, string> = {
+  "place.composer": "composer",
+  "place.composerInsert": "composer, typing",
+  "place.composerEnd": "composer end, typing",
+  "place.latest": "latest reply",
+  "place.pending": "waiting approval",
+  "place.terminal": "terminal",
+  "place.browser": "browser tab",
+  "place.address": "address bar",
+  "place.app": "app",
+  "place.files": "files",
+  "place.diff": "diff",
+  "place.sidebar": "sidebar",
+  "show.terminal": "toggle terminal",
+  "show.panel": "toggle panel",
+  "show.sidebar": "toggle sidebar",
+  "show.files": "toggle files",
+  "show.diff": "toggle diff",
+  "show.maximize": "maximize panel",
+  "fold.toggle": "fold",
+  "fold.open": "unfold",
+  "fold.close": "fold",
+  "fold.openAll": "unfold all",
+  "fold.closeAll": "fold all",
+  "mode.resize": "resize",
+  "jump.word": "any word on screen",
+  "scroll.top": "top",
+  open: "open link or file",
+  insertLast: "where you typed last",
+  appendEnd: "end, typing",
+};
+
+function modeName(state: KeyboardState): string {
+  if (state.cmdline) return "COMMAND";
+  switch (state.sub) {
+    case "visual":
+      return "VISUAL";
+    case "vline":
+      return "V-LINE";
+    case "replace":
+      return "REPLACE";
+    case "jump":
+      return "JUMP";
+    default:
+      return state.mode === "insert" ? "INSERT" : "NORMAL";
+  }
+}
+
+function placeName(state: KeyboardState): string {
+  if (state.label) return state.label;
+  switch (state.place) {
+    case "terminal":
+      return "Terminal";
+    case "editor":
+      return "Editor";
+    case "password":
+      return "Password";
+    case "input":
+    case "field":
+      return state.site && state.tabId != null ? state.site : "Field";
+    case "app":
+      return "App";
+    case "text":
+      return "Text";
+    default:
+      return state.site && state.tabId != null ? state.site : "";
+  }
+}
+
+/** Keys as typed, readable: a space is ␣, <C-d> is ^D. */
+function readable(keys: string): string {
+  return keys
+    .replaceAll(" ", "␣")
+    .replace(/<C-(.)>/g, (_, k: string) => `^${k.toUpperCase()}`)
+    .replace(/<(BS|Tab|CR)>/g, (_, k: string) => ({ BS: "⌫", Tab: "⇥", CR: "⏎" })[k] ?? k);
+}
+
+function useKeyboardState(): KeyboardState | null {
+  const [state, setState] = useState<KeyboardState | null>(null);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- listens for Pluto Vim's state from this page and, through the helper, from tabs and apps
+  useEffect(() => {
+    let own: KeyboardState | null = null;
+    let remote: KeyboardState | null = null;
+    const pick = () => {
+      // This page has the keyboard: its own state; else the tab's or app's that said it has it.
+      const mine = own && document.hasFocus() && own.focused;
+      setState(mine ? own : (remote ?? own));
+    };
+    const onOwn = (event: Event) => {
+      own = (event as CustomEvent<KeyboardState>).detail;
+      pick();
+    };
+    const onRemote = (event: Event) => {
+      remote = (event as CustomEvent<KeyboardState>).detail;
+      // The mode is one: this page's copy of it follows too.
+      if (own) own = { ...own, mode: remote.mode };
+      pick();
+    };
+    document.addEventListener("pvim:state", onOwn);
+    window.addEventListener("plutonium:pvim-state", onRemote);
+    window.addEventListener("focus", pick);
+    window.addEventListener("blur", pick);
+    return () => {
+      document.removeEventListener("pvim:state", onOwn);
+      window.removeEventListener("plutonium:pvim-state", onRemote);
+      window.removeEventListener("focus", pick);
+      window.removeEventListener("blur", pick);
+    };
+  }, []);
+  return state;
+}
+
+export const ModePill = memo(function ModePill() {
+  const state = useKeyboardState();
+  /** The keys typed so far once they've waited a moment: then what can follow them shows. */
+  const [ripe, setRipe] = useState("");
+  const pending = state?.pending ?? "";
+  const hasNext = (state?.continuations.length ?? 0) > 0;
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- a timer: a prefix that waits shows what can follow it
+  useEffect(() => {
+    if (!pending || !hasNext) return;
+    const timer = setTimeout(() => setRipe(pending), WHICH_KEY_MS);
+    return () => clearTimeout(timer);
+  }, [pending, hasNext]);
+  const whichKey = Boolean(pending) && hasNext && ripe === pending;
+  if (!state) return null;
+  const mode = modeName(state);
+  const place = placeName(state);
+  const typing = mode === "INSERT";
+  return (
+    <div className="relative mr-1 flex items-center" data-plutonium-mode-pill="">
+      <span
+        className={cn(
+          "flex h-6 items-center gap-1.5 rounded-md px-1.5 font-mono text-2xs leading-none",
+          typing ? "text-muted-foreground" : "bg-accent text-foreground",
+        )}
+      >
+        <span
+          className={cn(
+            "rounded-sm px-1 py-0.5 font-semibold tracking-wide",
+            typing
+              ? "border border-border"
+              : mode === "VISUAL" || mode === "V-LINE" || mode === "JUMP"
+                ? "bg-warning text-warning-foreground"
+                : "bg-primary text-primary-foreground",
+          )}
+        >
+          {mode}
+        </span>
+        {place ? <span className="max-w-40 truncate">{place}</span> : null}
+        {pending ? <span className="text-foreground">{readable(pending)}</span> : null}
+        {state.recording ? <span className="text-destructive">● @{state.recording}</span> : null}
+      </span>
+      {whichKey && state.continuations.length ? (
+        <div className="absolute top-full right-0 z-50 mt-1 grid min-w-48 grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 rounded-md border border-border bg-popover p-2 font-mono text-xs text-popover-foreground shadow-md">
+          {state.continuations.slice(0, 24).map((next) => (
+            <span key={next.keys} className="contents">
+              <span className="text-primary">{readable(next.keys)}</span>
+              <span className="truncate text-muted-foreground">
+                {NAMES[next.name] ?? next.name.replace(/^alias /, "= ")}
+              </span>
+            </span>
+          ))}
+        </div>
+      ) : null}
+    </div>
+  );
+});
