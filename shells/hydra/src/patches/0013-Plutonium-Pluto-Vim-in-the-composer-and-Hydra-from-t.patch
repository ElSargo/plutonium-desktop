+// Plutonium: Super keys Hydra handles itself, not through a T3 command (KEYS.md, Hydra's actions):
+// registered as shell shortcuts with the commands' (panelKeys.ts), run by hydraKeys.ts.
+export const HYDRA_SHELL_SHORTCUTS: readonly string[] = [
+  // The composer, at its end, in insert mode: "write a message", from anywhere.
+  "Super+Enter",
+];
