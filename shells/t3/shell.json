{
  "title": "Hydra",
  "version": "4",
  "description": "Coding agents' chat threads, each with its apps, terminals and browser tabs. Built on T3 Code.",
  "helperParam": "plutoniumHelper",
  "uses": ["notifications", "audio", "power", "media", "network", "bluetooth", "session"],
  "server": {
    "run": "plutonium",
    "argv": ["{plutonium}/bin/plutonium", "t3", "serve", "--port", "{port}", "--wayland-display", "{waylandDisplay}"],
    "port": 3773,
    "health": "http://127.0.0.1:{port}/",
    "restart": "on-failure",
    "entryCommand": ["{plutonium}/bin/plutonium", "t3", "pair-url", "--port", "{port}"]
  }
}
