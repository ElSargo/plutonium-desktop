# Build and run environment for Plutonium's Chromium: Ubuntu 24.04 with
# Chromium's build dependencies, plus what the sessions and test tools use.
# Chromium's prebuilt toolchain and its runtime libraries expect a Debian-like
# system, so builds and Ash itself run in here on any host distribution.
#
# Built by `plutonium container build`, which passes CHROMIUM_BASE.
FROM docker.io/library/ubuntu:24.04

ARG CHROMIUM_BASE
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git lsb-release python3 sudo file locales tzdata

# Chromium's own dependency list, at the revision the patches apply to.
RUN curl -fsSL "https://chromium.googlesource.com/chromium/src/+/${CHROMIUM_BASE}/build/install-build-deps.py?format=TEXT" \
      | base64 -d > /tmp/install-build-deps.py \
 && python3 /tmp/install-build-deps.py --no-prompt --no-arm --no-chromeos-fonts --no-syms \
 && rm /tmp/install-build-deps.py

# - libinput, mtdev, libwacom: use_libinput=true (touchpads on DRM).
# - Mesa Vulkan/VA drivers: Skia and ANGLE on Vulkan, dmabuf import, kmsshot.
# - Xvfb, xdotool, ImageMagick, x11-utils: private X11 sessions and their tests.
# - python3-websockets: tools/cdp.py (DevTools).
RUN apt-get install -y --no-install-recommends \
      libinput-dev libevdev-dev libmtdev-dev libwacom-dev libudev-dev libgudev-1.0-dev \
      mesa-vulkan-drivers mesa-va-drivers va-driver-all libgl1-mesa-dri \
      xvfb xauth xdotool x11-utils x11-xserver-utils imagemagick \
      python3-websockets strace procps psmisc less \
 && rm -rf /var/lib/apt/lists/*

CMD ["sleep", "infinity"]
