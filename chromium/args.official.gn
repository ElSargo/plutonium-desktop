# Official build: args.release.gn, optimized the way Google ships Chrome.
# ThinLTO across the whole binary (off by default for a non-device ChromeOS
# build, over a 2019 clang bug, crbug.com/1033839), and AFDO from ChromeOS's
# sample profile for big x86 cores (the Linux PGO profile doesn't apply to
# target_os "chromeos"). No CFI: a bad cast in a patch would crash the session.
# Much slower to build than args.release.gn.
target_os = "chromeos"
is_official_build = true
use_thin_lto = true
is_debug = false
is_component_build = false
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
clang_use_default_sample_profile = true
chromeos_afdo_platform = "bigcore"
use_system_minigbm = true
use_libinput = true
proprietary_codecs = true
ffmpeg_branding = "Chrome"
