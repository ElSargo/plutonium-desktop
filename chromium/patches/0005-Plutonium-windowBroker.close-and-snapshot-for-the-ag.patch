+  void Snapshot(int32_t window_id, SnapshotCallback callback) override {
+    ExoWindowBroker* broker = ExoWindowBroker::Get();
+    if (!StillShell() || !broker || !broker->GetWindow(window_id)) {
+      std::move(callback).Run(std::nullopt);
+      return;
+    }
+    exo::EmbeddedWindows::Get()->Snapshot(
+        window_id,
+        base::BindOnce(
+            [](SnapshotCallback callback, const SkBitmap& bitmap) {
+              if (bitmap.drawsNothing()) {
+                std::move(callback).Run(std::nullopt);
+                return;
+              }
+              // Encoding a large window takes a while; not on the UI thread.
+              base::ThreadPool::PostTaskAndReplyWithResult(
+                  FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+                  base::BindOnce(
+                      [](const SkBitmap& bitmap) {
+                        return gfx::PNGCodec::EncodeBGRASkBitmap(
+                            bitmap, /*discard_transparency=*/false);
+                      },
+                      bitmap),
+                  base::BindOnce(
+                      [](SnapshotCallback callback,
+                         std::optional<std::vector<uint8_t>> png) {
+                        if (!png) {
+                          std::move(callback).Run(std::nullopt);
+                          return;
+                        }
+                        std::move(callback).Run(mojo_base::BigBuffer(*png));
+                      },
+                      std::move(callback)));
+            },
+            std::move(callback)));
+  }
