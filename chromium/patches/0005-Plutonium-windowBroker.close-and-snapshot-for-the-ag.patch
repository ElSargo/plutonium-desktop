+void EmbeddedWindows::Close(int32_t window_id) {
+  if (ShellSurfaceBase* shell_surface = FindShellSurface(window_id)) {
+    shell_surface->OnCloseRequested(views::Widget::ClosedReason::kUnspecified);
+  }
+}
