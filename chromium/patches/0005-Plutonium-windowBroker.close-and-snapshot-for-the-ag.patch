+void EmbeddedWindows::Snapshot(int32_t window_id, SnapshotCallback callback) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  aura::Window* host_window =
+      shell_surface ? shell_surface->host_window() : nullptr;
+  if (!host_window) {
+    std::move(callback).Run(SkBitmap());
+    return;
+  }
+  // The host window's layer shows the client's whole surface tree. A copy
+  // request makes the compositor draw it even under the parked window's zero
+  // opacity, and the copy is taken before that opacity applies.
+  const gfx::Rect geometry = gfx::ScaleToEnclosingRect(
+      shell_surface->GetEmbedGeometry(),
+      host_window->layer()->device_scale_factor());
+  auto request = std::make_unique<viz::CopyOutputRequest>(
+      viz::CopyOutputRequest::ResultFormat::RGBA,
+      viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+      base::BindOnce(
+          [](const gfx::Rect& geometry, SnapshotCallback callback,
+             std::unique_ptr<viz::CopyOutputResult> result) {
+            if (result->IsEmpty()) {
+              std::move(callback).Run(SkBitmap());
+              return;
+            }
+            auto scoped = result->ScopedAccessSkBitmap();
+            SkBitmap bitmap = scoped.GetOutScopedBitmap();
+            // Without client-side shadows.
+            gfx::Rect crop = geometry;
+            crop.Intersect(gfx::Rect(bitmap.width(), bitmap.height()));
+            SkBitmap cropped;
+            if (!crop.IsEmpty() &&
+                bitmap.extractSubset(&cropped,
+                                     SkIRect::MakeXYWH(crop.x(), crop.y(),
+                                                       crop.width(),
+                                                       crop.height()))) {
+              bitmap = cropped;
+            }
+            std::move(callback).Run(bitmap);
+          },
+          geometry, std::move(callback)));
+  request->set_result_task_runner(
+      base::SequencedTaskRunner::GetCurrentDefault());
+  host_window->layer()->RequestCopyOfOutput(std::move(request));
+}
