+  command startWindowScreencast
+    parameters
+      integer id
+      optional enum format
+        png
+        jpeg
+      optional integer quality
+      optional integer maxWidth
+      optional integer maxHeight
+
+  command stopWindowScreencast
+    parameters
+      integer id
+
+  command windowScreencastFrameAck
+    parameters
+      integer id
+      integer sessionId
+
+  event windowScreencastFrame
+    parameters
+      integer id
+      binary data
+      integer width
+      integer height
+      integer sessionId
+
+  # The window's screencast stopped (the window closed).
+  event windowScreencastStopped
+    parameters
+      integer id
+
+  event tabAdded
+    parameters
+      Tab tab
+
+  event tabChanged
+    parameters
+      Tab tab
+
+  event tabRemoved
+    parameters
+      integer id
+
+  event windowAdded
+    parameters
+      Window window
+
+  event windowChanged
+    parameters
+      Window window
+
+  event windowRemoved
+    parameters
+      integer id
