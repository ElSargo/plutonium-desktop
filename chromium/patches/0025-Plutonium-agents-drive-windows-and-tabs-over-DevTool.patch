+base::ScopedClosureRunner EmbeddedWindows::KeepDrawing(int32_t window_id) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  if (!shell_surface) {
+    return base::ScopedClosureRunner();
+  }
+  if (keep_drawing_[window_id]++ == 0) {
+    shell_surface->set_may_throttle_if_undrawn_frames(false);
+  }
+  return base::ScopedClosureRunner(base::BindOnce(
+      // The instance lives as long as the process.
+      [](EmbeddedWindows* self, int32_t window_id) {
+        auto it = self->keep_drawing_.find(window_id);
+        if (it == self->keep_drawing_.end() || --it->second > 0) {
+          return;
+        }
+        self->keep_drawing_.erase(it);
+        if (ShellSurfaceBase* shell_surface =
+                self->FindShellSurface(window_id)) {
+          shell_surface->set_may_throttle_if_undrawn_frames(true);
+        }
+      },
+      base::Unretained(this), window_id));
+}
