+
+// Input.dispatch*Event's modifier bits.
+int EventFlagsForModifiers(int modifiers) {
+  int flags = 0;
+  if (modifiers & 1) {
+    flags |= ui::EF_ALT_DOWN;
+  }
+  if (modifiers & 2) {
+    flags |= ui::EF_CONTROL_DOWN;
+  }
+  if (modifiers & 4) {
+    flags |= ui::EF_COMMAND_DOWN;
+  }
+  if (modifiers & 8) {
+    flags |= ui::EF_SHIFT_DOWN;
+  }
+  return flags;
+}
+
+// Input.dispatchMouseEvent's |buttons| bits.
+int EventFlagsForButtons(int buttons) {
+  int flags = 0;
+  if (buttons & 1) {
+    flags |= ui::EF_LEFT_MOUSE_BUTTON;
+  }
+  if (buttons & 2) {
+    flags |= ui::EF_RIGHT_MOUSE_BUTTON;
+  }
+  if (buttons & 4) {
+    flags |= ui::EF_MIDDLE_MOUSE_BUTTON;
+  }
+  if (buttons & 8) {
+    flags |= ui::EF_BACK_MOUSE_BUTTON;
+  }
+  if (buttons & 16) {
+    flags |= ui::EF_FORWARD_MOUSE_BUTTON;
+  }
+  return flags;
+}
+
+std::optional<int> EventFlagForButton(const std::string& button) {
+  if (button == "none") {
+    return 0;
+  }
+  if (button == "left") {
+    return ui::EF_LEFT_MOUSE_BUTTON;
+  }
+  if (button == "middle") {
+    return ui::EF_MIDDLE_MOUSE_BUTTON;
+  }
+  if (button == "right") {
+    return ui::EF_RIGHT_MOUSE_BUTTON;
+  }
+  if (button == "back") {
+    return ui::EF_BACK_MOUSE_BUTTON;
+  }
+  if (button == "forward") {
+    return ui::EF_FORWARD_MOUSE_BUTTON;
+  }
+  return std::nullopt;
+}
+
+std::optional<std::vector<uint8_t>> Encode(const SkBitmap& bitmap,
+                                           bool jpeg,
+                                           int quality) {
+  return jpeg ? gfx::JPEGCodec::Encode(bitmap, quality)
+              : gfx::PNGCodec::EncodeBGRASkBitmap(bitmap,
+                                                  /*discard_transparency=*/
+                                                  false);
+}
+
+std::unique_ptr<Plutonium::Tab> ToProtocol(const PlutoniumTabs::TabInfo& tab) {
+  std::string target_id;
+  if (content::WebContents* contents =
+          PlutoniumTabs::Get()->GetContents(tab.id)) {
+    target_id = content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId();
+  }
+  auto tags = std::make_unique<protocol::Array<std::string>>(tab.tags);
+  std::unique_ptr<Plutonium::Tab> result =
+      Plutonium::Tab::Create()
+          .SetId(tab.id)
+          .SetTargetId(target_id)
+          .SetUrl(tab.url.possibly_invalid_spec())
+          .SetTitle(base::UTF16ToUTF8(tab.title))
+          .SetLoading(tab.loading)
+          .SetCanGoBack(tab.can_go_back)
+          .SetCanGoForward(tab.can_go_forward)
+          .SetEmbedded(tab.embedded)
+          .SetFocused(tab.focused)
+          .SetTags(std::move(tags))
+          .SetOpenerId(tab.opener_id)
+          .SetOpenedBy(tab.opened_by)
+          .Build();
+  if (!tab.dialog_type.empty()) {
+    result->SetDialogType(tab.dialog_type);
+    result->SetDialogMessage(base::UTF16ToUTF8(tab.dialog_message));
+    result->SetDialogDefaultPrompt(
+        base::UTF16ToUTF8(tab.dialog_default_prompt));
+  }
+  return result;
+}
+
+std::unique_ptr<Plutonium::Window> ToProtocol(
+    const ExoWindowBroker::WindowInfo& window) {
+  std::optional<exo::EmbeddedWindows::Info> info =
+      exo::EmbeddedWindows::Get()->GetInfo(window.id);
+  return Plutonium::Window::Create()
+      .SetId(window.id)
+      .SetAppId(window.app_id)
+      .SetTitle(base::UTF16ToUTF8(window.title))
+      .SetWidth(window.size.width())
+      .SetHeight(window.size.height())
+      .SetDeviceScaleFactor(window.device_scale_factor)
+      .SetEmbedded(window.embedded)
+      .SetFocused(window.focused)
+      .SetOnDesktop(info && info->on_desktop)
+      .SetPid(window.pid)
+      .SetTags(std::make_unique<protocol::Array<std::string>>(window.tags))
+      .Build();
+}
+
+Response NoWindow() {
+  return Response::InvalidParams("No such window");
+}
+
+Response NoTab() {
+  return Response::InvalidParams("No such tab");
+}
+
+}  // namespace
+
+PlutoniumHandler::Screencast::Screencast() = default;
+PlutoniumHandler::Screencast::~Screencast() = default;
+
+PlutoniumHandler::PlutoniumHandler(protocol::UberDispatcher* dispatcher)
+    : frontend_(std::make_unique<Plutonium::Frontend>(dispatcher->channel())) {
+  Plutonium::Dispatcher::wire(dispatcher, this);
+}
+
+PlutoniumHandler::~PlutoniumHandler() = default;
+
+Response PlutoniumHandler::Enable() {
+  if (enabled_) {
+    return Response::Success();
+  }
+  enabled_ = true;
+  // The current ones first, as the shell API's subscriptions do.
+  if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+    for (const ExoWindowBroker::WindowInfo& window : broker->GetWindows()) {
+      frontend_->WindowAdded(ToProtocol(window));
+    }
+    broker_observation_.Observe(broker);
+  }
+  for (const PlutoniumTabs::TabInfo& tab : PlutoniumTabs::Get()->GetTabs()) {
+    frontend_->TabAdded(ToProtocol(tab));
+  }
+  tabs_observation_.Observe(PlutoniumTabs::Get());
+  return Response::Success();
+}
+
+Response PlutoniumHandler::Disable() {
+  enabled_ = false;
+  broker_observation_.Reset();
+  tabs_observation_.Reset();
+  screencasts_.clear();
+  awake_tabs_.clear();
+  awake_windows_.clear();
+  return Response::Success();
+}
+
+Response PlutoniumHandler::GetTabs(
+    std::unique_ptr<protocol::Array<Plutonium::Tab>>* tabs) {
+  *tabs = std::make_unique<protocol::Array<Plutonium::Tab>>();
+  for (const PlutoniumTabs::TabInfo& tab : PlutoniumTabs::Get()->GetTabs()) {
+    (*tabs)->push_back(ToProtocol(tab));
+  }
+  return Response::Success();
+}
+
+Response PlutoniumHandler::CreateTab(
+    const std::string& url,
+    std::unique_ptr<protocol::Array<std::string>> tags,
+    std::unique_ptr<Plutonium::Tab>* tab) {
+  std::optional<PlutoniumTabs::TabInfo> created =
+      PlutoniumTabs::Get()->CreateAgentTab(
+          url, tags ? *tags : std::vector<std::string>());
+  if (!created) {
+    return Response::ServerError(
+        "Can't open that URL (or no shell page has started)");
+  }
+  *tab = ToProtocol(*created);
+  return Response::Success();
+}
+
+Response PlutoniumHandler::NavigateTab(int id, const std::string& url) {
+  if (!PlutoniumTabs::Get()->GetTab(id)) {
+    return NoTab();
+  }
+  return PlutoniumTabs::Get()->Navigate(id, url)
+             ? Response::Success()
+             : Response::InvalidParams("Can't open that URL");
+}
+
+Response PlutoniumHandler::TabCommand(int id, const std::string& command) {
+  std::optional<PlutoniumTabs::TabInfo> tab = PlutoniumTabs::Get()->GetTab(id);
+  if (!tab) {
+    return NoTab();
+  }
+  PlutoniumTabs::Command value;
+  if (command == Plutonium::TabCommand::CommandEnum::Back) {
+    value = PlutoniumTabs::Command::kBack;
+  } else if (command == Plutonium::TabCommand::CommandEnum::Forward) {
+    value = PlutoniumTabs::Command::kForward;
+  } else if (command == Plutonium::TabCommand::CommandEnum::Reload) {
+    value = PlutoniumTabs::Command::kReload;
+  } else if (command == Plutonium::TabCommand::CommandEnum::Stop) {
+    value = PlutoniumTabs::Command::kStop;
+  } else if (command == Plutonium::TabCommand::CommandEnum::Close) {
+    value = PlutoniumTabs::Command::kClose;
+  } else {
+    return Response::InvalidParams("Unknown command");
+  }
+  PlutoniumTabs::Get()->RunCommand(id, value);
+  return Response::Success();
+}
+
+Response PlutoniumHandler::AnswerTabDialog(
+    int id,
+    bool accept,
+    std::optional<std::string> prompt_text) {
+  std::optional<PlutoniumTabs::TabInfo> tab = PlutoniumTabs::Get()->GetTab(id);
+  if (!tab) {
+    return NoTab();
+  }
+  if (tab->dialog_type.empty()) {
+    return Response::InvalidParams("The tab has no dialog");
+  }
+  PlutoniumTabs::Get()->AnswerDialog(
+      id, accept, base::UTF8ToUTF16(prompt_text.value_or(std::string())));
+  return Response::Success();
+}
+
+Response PlutoniumHandler::GetWindows(
+    std::unique_ptr<protocol::Array<Plutonium::Window>>* windows) {
+  *windows = std::make_unique<protocol::Array<Plutonium::Window>>();
+  if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+    for (const ExoWindowBroker::WindowInfo& window : broker->GetWindows()) {
+      (*windows)->push_back(ToProtocol(window));
+    }
+  }
+  return Response::Success();
+}
+
+Response PlutoniumHandler::SetTabAwake(int id, bool awake) {
+  content::WebContents* contents = PlutoniumTabs::Get()->GetContents(id);
+  if (!contents) {
+    return NoTab();
+  }
+  if (!awake) {
+    awake_tabs_.erase(id);
+  } else if (!awake_tabs_.contains(id)) {
+    // As tab capture does for a background tab: frames without showing it.
+    awake_tabs_.emplace(id, contents->IncrementCapturerCount(
+                                gfx::Size(), /*stay_hidden=*/true,
+                                /*stay_awake=*/true, /*is_activity=*/false));
+  }
+  return Response::Success();
+}
+
+void PlutoniumHandler::CaptureTab(int id,
+                                  std::optional<std::string> format,
+                                  std::optional<int> quality,
+                                  std::unique_ptr<CaptureTabCallback> callback) {
+  if (!PlutoniumTabs::Get()->GetTab(id)) {
+    callback->sendFailure(NoTab());
+    return;
+  }
+  const bool jpeg =
+      format.value_or("png") == Plutonium::CaptureTab::FormatEnum::Jpeg;
+  PlutoniumTabs::Get()->Snapshot(
+      id, base::BindOnce(
+              [](std::unique_ptr<CaptureTabCallback> callback, bool jpeg,
+                 int quality, const SkBitmap& bitmap) {
+                std::optional<std::vector<uint8_t>> data;
+                if (!bitmap.drawsNothing()) {
+                  data = Encode(bitmap, jpeg, quality);
+                }
+                if (!data) {
+                  callback->sendFailure(
+                      Response::ServerError("The tab has nothing to show"));
+                  return;
+                }
+                callback->sendSuccess(
+                    protocol::Binary::fromVector(std::move(*data)),
+                    bitmap.width(), bitmap.height());
+              },
+              std::move(callback), jpeg, quality.value_or(80)));
+}
+
+void PlutoniumHandler::CaptureWindow(
+    int id,
+    std::optional<std::string> format,
+    std::optional<int> quality,
+    std::unique_ptr<CaptureWindowCallback> callback) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    callback->sendFailure(NoWindow());
+    return;
+  }
+  const bool jpeg =
+      format.value_or("png") == Plutonium::CaptureWindow::FormatEnum::Jpeg;
+  exo::EmbeddedWindows::Get()->Snapshot(
+      id, base::BindOnce(
+              [](std::unique_ptr<CaptureWindowCallback> callback, bool jpeg,
+                 int quality, const SkBitmap& bitmap) {
+                if (bitmap.drawsNothing()) {
+                  callback->sendFailure(
+                      Response::ServerError("The window has nothing to show"));
+                  return;
+                }
+                std::optional<std::vector<uint8_t>> data =
+                    Encode(bitmap, jpeg, quality);
+                if (!data) {
+                  callback->sendFailure(
+                      Response::ServerError("Couldn't encode the image"));
+                  return;
+                }
+                callback->sendSuccess(
+                    protocol::Binary::fromVector(std::move(*data)),
+                    bitmap.width(), bitmap.height());
+              },
+              std::move(callback), jpeg, quality.value_or(80)));
+}
+
+Response PlutoniumHandler::SetWindowAwake(int id, bool awake) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    return NoWindow();
+  }
+  if (!awake) {
+    awake_windows_.erase(id);
+  } else if (!awake_windows_.contains(id)) {
+    awake_windows_.emplace(id, exo::EmbeddedWindows::Get()->KeepDrawing(id));
+  }
+  return Response::Success();
+}
+
+Response PlutoniumHandler::CloseWindow(int id) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    return NoWindow();
+  }
+  exo::EmbeddedWindows::Get()->Close(id);
+  return Response::Success();
+}
+
+Response PlutoniumHandler::ResizeWindow(int id, int width, int height) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  std::optional<ExoWindowBroker::WindowInfo> window =
+      broker ? broker->GetWindow(id) : std::nullopt;
+  if (!window) {
+    return NoWindow();
+  }
+  if (window->embedded) {
+    return Response::InvalidParams(
+        "A page shows the window: its size is the page's");
+  }
+  if (width < 1 || height < 1) {
+    return Response::InvalidParams("Empty size");
+  }
+  exo::EmbeddedWindows::Get()->SetSize(id, gfx::Size(width, height));
+  return Response::Success();
+}
+
+Response PlutoniumHandler::DispatchWindowMouseEvent(
+    int id,
+    const std::string& type,
+    double x,
+    double y,
+    std::optional<std::string> button,
+    std::optional<int> buttons,
+    std::optional<int> click_count,
+    std::optional<double> delta_x,
+    std::optional<double> delta_y,
+    std::optional<int> modifiers) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    return NoWindow();
+  }
+  std::optional<int> changed = EventFlagForButton(button.value_or("none"));
+  if (!changed) {
+    return Response::InvalidParams("Unknown button");
+  }
+  int flags = EventFlagsForModifiers(modifiers.value_or(0)) |
+              EventFlagsForButtons(buttons.value_or(0));
+  const gfx::PointF location(x, y);
+  std::unique_ptr<ui::MouseEvent> event;
+  if (type == Plutonium::DispatchWindowMouseEvent::TypeEnum::MouseWheel) {
+    // Down and right positive, as wheel notches; aura's offsets are the
+    // content's direction, 120 to a notch.
+    const gfx::Vector2d offset(
+        static_cast<int>(-delta_x.value_or(0) * ui::MouseWheelEvent::kWheelDelta),
+        static_cast<int>(-delta_y.value_or(0) *
+                         ui::MouseWheelEvent::kWheelDelta));
+    event = std::make_unique<ui::MouseWheelEvent>(
+        offset, location, location, ui::EventTimeForNow(), flags, 0);
+  } else {
+    ui::EventType event_type;
+    if (type == Plutonium::DispatchWindowMouseEvent::TypeEnum::MousePressed) {
+      event_type = ui::EventType::kMousePressed;
+      flags |= *changed;
+    } else if (type ==
+               Plutonium::DispatchWindowMouseEvent::TypeEnum::MouseReleased) {
+      event_type = ui::EventType::kMouseReleased;
+      flags |= *changed;
+    } else if (type ==
+               Plutonium::DispatchWindowMouseEvent::TypeEnum::MouseMoved) {
+      event_type = flags & (ui::EF_LEFT_MOUSE_BUTTON |
+                            ui::EF_MIDDLE_MOUSE_BUTTON |
+                            ui::EF_RIGHT_MOUSE_BUTTON)
+                       ? ui::EventType::kMouseDragged
+                       : ui::EventType::kMouseMoved;
+    } else {
+      return Response::InvalidParams("Unknown type");
+    }
+    if (event_type != ui::EventType::kMousePressed &&
+        event_type != ui::EventType::kMouseReleased && *changed) {
+      return Response::InvalidParams("Only presses and releases change a button");
+    }
+    if ((event_type == ui::EventType::kMousePressed ||
+         event_type == ui::EventType::kMouseReleased) &&
+        !*changed) {
+      return Response::InvalidParams("Which button?");
+    }
+    event = std::make_unique<ui::MouseEvent>(event_type, location, location,
+                                             ui::EventTimeForNow(), flags,
+                                             *changed);
+    if (click_count && *click_count > 0 &&
+        (event_type == ui::EventType::kMousePressed ||
+         event_type == ui::EventType::kMouseReleased)) {
+      event->SetClickCount(*click_count);
+    }
+  }
+  if (!exo::EmbeddedWindows::Get()->InjectMouseEvent(id, location,
+                                                     std::move(event))) {
+    return Response::ServerError("The window takes no input yet");
+  }
+  return Response::Success();
+}
+
+Response PlutoniumHandler::DispatchWindowKeyEvents(
+    int id,
+    std::unique_ptr<protocol::Array<Plutonium::KeyEvent>> events) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    return NoWindow();
+  }
+  std::vector<std::unique_ptr<ui::KeyEvent>> keys;
+  for (const std::unique_ptr<Plutonium::KeyEvent>& key : *events) {
+    const ui::DomCode code =
+        ui::KeycodeConverter::CodeStringToDomCode(key->GetCode());
+    if (code == ui::DomCode::NONE) {
+      return Response::InvalidParams("Unknown key code \"" + key->GetCode() +
+                                     "\"");
+    }
+    const ui::EventType type =
+        key->GetType() == Plutonium::KeyEvent::TypeEnum::KeyDown
+            ? ui::EventType::kKeyPressed
+            : ui::EventType::kKeyReleased;
+    keys.push_back(std::make_unique<ui::KeyEvent>(
+        type, ui::DomCodeToUsLayoutKeyboardCode(code), code,
+        EventFlagsForModifiers(key->GetModifiers(0)), ui::EventTimeForNow()));
+  }
+  if (!exo::EmbeddedWindows::Get()->InjectKeyEvents(id, std::move(keys))) {
+    return Response::ServerError(
+        "The window takes no keys yet (or nothing has focus to lend it)");
+  }
+  return Response::Success();
+}
+
+Response PlutoniumHandler::StartWindowScreencast(
+    int id,
+    std::optional<std::string> format,
+    std::optional<int> quality,
+    std::optional<int> max_width,
+    std::optional<int> max_height) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    return NoWindow();
+  }
+  screencasts_.erase(id);
+  gfx::Size max_size(max_width.value_or(0), max_height.value_or(0));
+  if (max_size.width() <= 0 || max_size.height() <= 0) {
+    max_size = gfx::Size();
+  }
+  Screencast& screencast = screencasts_[id];
+  screencast.jpeg =
+      format.value_or("jpeg") == Plutonium::StartWindowScreencast::FormatEnum::Jpeg;
+  screencast.quality = quality.value_or(80);
+  screencast.capture = plutonium_agent::WindowScreencast::Start(
+      id, max_size,
+      base::BindRepeating(&PlutoniumHandler::OnScreencastFrame,
+                          weak_factory_.GetWeakPtr(), id));
+  if (!screencast.capture) {
+    screencasts_.erase(id);
+    return Response::ServerError("The window has nothing to show yet");
+  }
+  screencast.keep_drawing = exo::EmbeddedWindows::Get()->KeepDrawing(id);
+  return Response::Success();
+}
+
+Response PlutoniumHandler::StopWindowScreencast(int id) {
+  screencasts_.erase(id);
+  return Response::Success();
+}
+
+Response PlutoniumHandler::WindowScreencastFrameAck(int id, int session_id) {
+  auto it = screencasts_.find(id);
+  if (it == screencasts_.end()) {
+    return Response::Success();
+  }
+  Screencast& screencast = it->second;
+  if (screencast.pending_session_id != session_id) {
+    return Response::Success();
+  }
+  screencast.pending_session_id = 0;
+  if (std::unique_ptr<SkBitmap> next = std::move(screencast.next)) {
+    SendScreencastFrame(id, *next);
+  }
+  return Response::Success();
+}
+
+void PlutoniumHandler::OnScreencastFrame(int32_t window_id,
+                                         const SkBitmap& frame) {
+  auto it = screencasts_.find(window_id);
+  if (it == screencasts_.end()) {
+    return;
+  }
+  if (it->second.pending_session_id) {
+    // Keep only the newest until the client catches up.
+    it->second.next = std::make_unique<SkBitmap>(frame);
+    return;
+  }
+  SendScreencastFrame(window_id, frame);
+}
+
+void PlutoniumHandler::SendScreencastFrame(int32_t window_id,
+                                           const SkBitmap& frame) {
+  Screencast& screencast = screencasts_[window_id];
+  std::optional<std::vector<uint8_t>> data =
+      Encode(frame, screencast.jpeg, screencast.quality);
+  if (!data) {
+    return;
+  }
+  screencast.pending_session_id = next_session_id_++;
+  frontend_->WindowScreencastFrame(
+      window_id, protocol::Binary::fromVector(std::move(*data)), frame.width(),
+      frame.height(), screencast.pending_session_id);
+}
+
+void PlutoniumHandler::OnWindowAdded(const ExoWindowBroker::WindowInfo& window) {
+  frontend_->WindowAdded(ToProtocol(window));
+}
+
+void PlutoniumHandler::OnWindowChanged(
+    const ExoWindowBroker::WindowInfo& window) {
+  frontend_->WindowChanged(ToProtocol(window));
+}
+
+void PlutoniumHandler::OnWindowRemoved(int32_t window_id) {
+  awake_windows_.erase(window_id);
+  if (screencasts_.erase(window_id)) {
+    frontend_->WindowScreencastStopped(window_id);
+  }
+  frontend_->WindowRemoved(window_id);
+}
+
+void PlutoniumHandler::OnTabAdded(const PlutoniumTabs::TabInfo& tab) {
+  frontend_->TabAdded(ToProtocol(tab));
+}
+
+void PlutoniumHandler::OnTabChanged(const PlutoniumTabs::TabInfo& tab) {
+  frontend_->TabChanged(ToProtocol(tab));
+}
+
+void PlutoniumHandler::OnTabRemoved(int32_t tab_id) {
+  awake_tabs_.erase(tab_id);
+  frontend_->TabRemoved(tab_id);
+}
