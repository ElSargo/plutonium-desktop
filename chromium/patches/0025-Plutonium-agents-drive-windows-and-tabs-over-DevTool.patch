+  command dispatchWindowMouseEvent
+    parameters
+      integer id
+      enum type
+        mousePressed
+        mouseReleased
+        mouseMoved
+        mouseWheel
+      number x
+      number y
+      optional enum button
+        none
+        left
+        middle
+        right
+        back
+        forward
+      # Buttons held: left=1, right=2, middle=4, back=8, forward=16.
+      optional integer buttons
+      optional integer clickCount
+      # mouseWheel: wheel notches to scroll, down and right positive.
+      optional number deltaX
+      optional number deltaY
+      optional integer modifiers
+
+  # Keys, in order. The window has the keyboard for them, and whatever had
