@@ -12,3 +12,261 @@ domain WindowManager
 
   # Exit the overview mode.
   command exitOverviewMode
+
+# PLUTONIUM (EXO-AGENT): the native windows and browser tabs shell pages show,
+# for the helper (plutoniumd) to drive without a shell page. Browser target,
+# trusted clients (--remote-debugging-port) only.
+experimental domain Plutonium
+  # One of the shells' browser tabs (a target of type "page").
+  type Tab extends object
+    properties
+      # The registry's id (the shell API's), stable for the tab's lifetime.
+      integer id
+      # Its DevTools target id.
+      string targetId
+      string url
+      string title
+      boolean loading
+      boolean canGoBack
+      boolean canGoForward
+      # Whether a shell page shows it.
+      boolean embedded
+      boolean focused
+      # Its origin tag (the thread it was opened for) first, then the rest.
+      array of string tags
+      # The tab whose page opened it, or 0.
+      integer openerId
+      # "shell", "shell:<id>", "page", "devtools" or "agent".
+      string openedBy
+      # The dialog the page waits on: alert, confirm, prompt or beforeunload.
+      optional string dialogType
+      optional string dialogMessage
+      optional string dialogDefaultPrompt
+
+  # A native (Wayland or X11) toplevel window.
+  type Window extends object
+    properties
+      integer id
+      string appId
+      string title
+      # The window geometry's size, in DIPs.
+      integer width
+      integer height
+      number deviceScaleFactor
+      # Whether a shell page shows it.
+      boolean embedded
+      # Whether it has the keyboard through the page showing it.
+      boolean focused
+      # Whether it is on the Ash desktop (popped out or fullscreen), not
+      # parked.
+      boolean onDesktop
+      # The Wayland client's pid, or 0.
+      integer pid
+      # Its origin tag (the thread that started it) first, then the rest.
+      array of string tags
+
+  type KeyEvent extends object
+    properties
+      enum type
+        keyDown
+        keyUp
+      # A DOM key code ("KeyA", "Enter", "ShiftLeft"), as KeyboardEvent.code.
+      string code
+      # Alt=1, Ctrl=2, Meta=4, Shift=8 (as Input.dispatchKeyEvent), held while
+      # this key goes.
+      optional integer modifiers
+
+  # Reports tabs and windows as they come, change and go; the current ones
+  # first.
+  command enable
+
+  command disable
+
+  command getTabs
+    returns
+      array of Tab tabs
+
+  # Opens a tab in the shells' profile. Like a tab a shell opens, it waits
+  # for a shell to show it.
+  command createTab
+    parameters
+      string url
+      # The first is its origin tag (its thread).
+      optional array of string tags
+    returns
+      Tab tab
+
+  command navigateTab
+    parameters
+      integer id
+      string url
+
+  command tabCommand
+    parameters
+      integer id
+      enum command
+        back
+        forward
+        reload
+        stop
+        close
+
+  command answerTabDialog
+    parameters
+      integer id
+      boolean accept
+      optional string promptText
+
+  # Keeps a tab rendering at full rate (animation frames, timers) while no
+  # page shows it, for as long as this client wants: an agent driving it
+  # waits on frames. The tab stays hidden from the user.
+  command setTabAwake
+    parameters
+      integer id
+      boolean awake
+
+  # What the tab shows (its viewport), also while no page shows it.
+  command captureTab
+    parameters
+      integer id
+      optional enum format
+        png
+        jpeg
+      optional integer quality
+    returns
+      binary data
+      integer width
+      integer height
+
+  command getWindows
+    returns
+      array of Window windows
+
+  # What the window shows, cropped to its window geometry, at the window's
+  # scale (deviceScaleFactor pixels per DIP). Works while no page shows it.
+  command captureWindow
+    parameters
+      integer id
+      optional enum format
+        png
+        jpeg
+      # 0 to 100, for jpeg.
+      optional integer quality
+    returns
+      binary data
+      integer width
+      integer height
+
+  # Keeps a window drawing at full rate while no page shows it, for as long
+  # as this client wants: the app draws (and answers input visibly) at a
+  # frame a second otherwise. Window screencasts do this themselves.
+  command setWindowAwake
+    parameters
+      integer id
+      boolean awake
+
+  # Asks the app to close the window, as its close button would.
+  command closeWindow
+    parameters
+      integer id
+
+  # Asks the app for this window geometry size (DIPs). Only while no page
+  # shows it: then the page decides.
+  command resizeWindow
+    parameters
+      integer id
+      integer width
+      integer height
+
+  # A mouse event at (x, y), in DIPs from the window geometry's top left (a
