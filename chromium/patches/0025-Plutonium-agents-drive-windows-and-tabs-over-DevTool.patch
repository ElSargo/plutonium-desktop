+#ifndef CHROME_BROWSER_DEVTOOLS_PROTOCOL_PLUTONIUM_HANDLER_H_
+#define CHROME_BROWSER_DEVTOOLS_PROTOCOL_PLUTONIUM_HANDLER_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback_helpers.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/devtools/protocol/plutonium.h"
+#include "chrome/browser/exo_window_broker.h"
+#include "chrome/browser/plutonium_tabs.h"
+
+class SkBitmap;
+
+namespace plutonium_agent {
+class WindowScreencast;
+}
+
+// PLUTONIUM (EXO-AGENT): the Plutonium domain (cros_protocol.pdl). The
+// helper drives the shells' windows and tabs through it, on the browser
+// target, without a shell page. Only for trusted clients on the browser
+// target (see ChromeDevToolsSession).
+class PlutoniumHandler : public protocol::Plutonium::Backend,
+                         public ExoWindowBroker::Observer,
+                         public PlutoniumTabs::Observer {
+ public:
+  explicit PlutoniumHandler(protocol::UberDispatcher* dispatcher);
+  PlutoniumHandler(const PlutoniumHandler&) = delete;
+  PlutoniumHandler& operator=(const PlutoniumHandler&) = delete;
+  ~PlutoniumHandler() override;
+
+  // protocol::Plutonium::Backend:
+  protocol::Response Enable() override;
+  protocol::Response Disable() override;
+  protocol::Response GetTabs(
+      std::unique_ptr<protocol::Array<protocol::Plutonium::Tab>>* tabs)
+      override;
+  protocol::Response CreateTab(
+      const std::string& url,
+      std::unique_ptr<protocol::Array<std::string>> tags,
+      std::unique_ptr<protocol::Plutonium::Tab>* tab) override;
+  protocol::Response NavigateTab(int id, const std::string& url) override;
+  protocol::Response TabCommand(int id, const std::string& command) override;
+  protocol::Response AnswerTabDialog(
+      int id,
+      bool accept,
+      std::optional<std::string> prompt_text) override;
+  protocol::Response SetTabAwake(int id, bool awake) override;
+  void CaptureTab(int id,
+                  std::optional<std::string> format,
+                  std::optional<int> quality,
+                  std::unique_ptr<CaptureTabCallback> callback) override;
+  protocol::Response GetWindows(
+      std::unique_ptr<protocol::Array<protocol::Plutonium::Window>>* windows)
+      override;
+  void CaptureWindow(int id,
+                     std::optional<std::string> format,
+                     std::optional<int> quality,
+                     std::unique_ptr<CaptureWindowCallback> callback) override;
+  protocol::Response SetWindowAwake(int id, bool awake) override;
+  protocol::Response CloseWindow(int id) override;
+  protocol::Response ResizeWindow(int id, int width, int height) override;
+  protocol::Response DispatchWindowMouseEvent(
+      int id,
+      const std::string& type,
+      double x,
+      double y,
+      std::optional<std::string> button,
+      std::optional<int> buttons,
+      std::optional<int> click_count,
+      std::optional<double> delta_x,
+      std::optional<double> delta_y,
+      std::optional<int> modifiers) override;
+  protocol::Response DispatchWindowKeyEvents(
+      int id,
+      std::unique_ptr<protocol::Array<protocol::Plutonium::KeyEvent>> events)
+      override;
+  protocol::Response StartWindowScreencast(
+      int id,
+      std::optional<std::string> format,
+      std::optional<int> quality,
+      std::optional<int> max_width,
+      std::optional<int> max_height) override;
+  protocol::Response StopWindowScreencast(int id) override;
+  protocol::Response WindowScreencastFrameAck(int id, int session_id) override;
+
+  // ExoWindowBroker::Observer:
+  void OnWindowAdded(const ExoWindowBroker::WindowInfo& window) override;
+  void OnWindowChanged(const ExoWindowBroker::WindowInfo& window) override;
+  void OnWindowRemoved(int32_t window_id) override;
+
+  // PlutoniumTabs::Observer:
+  void OnTabAdded(const PlutoniumTabs::TabInfo& tab) override;
+  void OnTabChanged(const PlutoniumTabs::TabInfo& tab) override;
+  void OnTabRemoved(int32_t tab_id) override;
+
+ private:
+  struct Screencast {
+    Screencast();
+    ~Screencast();
+    std::unique_ptr<plutonium_agent::WindowScreencast> capture;
+    // At full rate while watched.
+    base::ScopedClosureRunner keep_drawing;
+    bool jpeg = true;
+    int quality = 80;
+    // The frame the client hasn't acknowledged yet, or 0.
+    int pending_session_id = 0;
+    // A frame that came while waiting for the ack; sent on the ack.
+    std::unique_ptr<SkBitmap> next;
+  };
+
+  void OnScreencastFrame(int32_t window_id, const SkBitmap& frame);
+  void SendScreencastFrame(int32_t window_id, const SkBitmap& frame);
+
+  std::unique_ptr<protocol::Plutonium::Frontend> frontend_;
+  bool enabled_ = false;
+  base::ScopedObservation<ExoWindowBroker, ExoWindowBroker::Observer>
+      broker_observation_{this};
+  base::ScopedObservation<PlutoniumTabs, PlutoniumTabs::Observer>
+      tabs_observation_{this};
+  std::map<int32_t, Screencast> screencasts_;
+  // Tabs kept awake (SetTabAwake): their capture handles.
+  std::map<int32_t, base::ScopedClosureRunner> awake_tabs_;
+  // Windows kept awake (SetWindowAwake).
+  std::map<int32_t, base::ScopedClosureRunner> awake_windows_;
+  int next_session_id_ = 1;
+  base::WeakPtrFactory<PlutoniumHandler> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_PLUTONIUM_HANDLER_H_
diff --git a/chrome/browser/plutonium_agent.cc b/chrome/browser/plutonium_agent.cc
new file mode 100644
index 0000000000..068b7a3aea
--- /dev/null
+++ b/chrome/browser/plutonium_agent.cc
@@ -0,0 +1,95 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/plutonium_agent.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/ptr_util.h"
+#include "skia/ext/image_operations.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/gfx/geometry/size_conversions.h"
+
+namespace plutonium_agent {
+
+// static
+std::unique_ptr<WindowScreencast> WindowScreencast::Start(
+    int32_t window_id,
+    const gfx::Size& max_size,
+    FrameCallback on_frame) {
+  exo::EmbeddedWindows* windows = exo::EmbeddedWindows::Get();
+  if (!windows->GetInfo(window_id)) {
+    return nullptr;
+  }
+  auto screencast = base::WrapUnique(
+      new WindowScreencast(window_id, max_size, std::move(on_frame)));
+  screencast->windows_observation_.Observe(windows);
+  // What it shows now, before it draws anything new.
+  screencast->Capture();
+  return screencast;
+}
+
+WindowScreencast::WindowScreencast(int32_t window_id,
+                                   const gfx::Size& max_size,
+                                   FrameCallback on_frame)
+    : window_id_(window_id),
+      max_size_(max_size),
+      on_frame_(std::move(on_frame)) {}
+
+WindowScreencast::~WindowScreencast() = default;
+
+void WindowScreencast::OnEmbeddedWindowCommitted(int32_t window_id) {
+  if (window_id == window_id_) {
+    Capture();
+  }
+}
+
+void WindowScreencast::Capture() {
+  dirty_ = true;
+  if (copying_ || timer_.IsRunning()) {
+    return;
+  }
+  const base::TimeDelta wait =
+      last_copy_ + base::Seconds(1) / kMaxRate - base::TimeTicks::Now();
+  if (wait.is_positive()) {
+    timer_.Start(FROM_HERE, wait,
+                 base::BindOnce(&WindowScreencast::Capture,
+                                base::Unretained(this)));
+    return;
+  }
+  dirty_ = false;
+  copying_ = true;
+  last_copy_ = base::TimeTicks::Now();
+  exo::EmbeddedWindows::Get()->Snapshot(
+      window_id_, base::BindOnce(&WindowScreencast::OnCopied,
+                                 weak_factory_.GetWeakPtr()));
+}
+
+void WindowScreencast::OnCopied(const SkBitmap& bitmap) {
+  copying_ = false;
+  if (!bitmap.drawsNothing()) {
+    gfx::Size size(bitmap.width(), bitmap.height());
+    if (!max_size_.IsEmpty() && (size.width() > max_size_.width() ||
+                                 size.height() > max_size_.height())) {
+      const float scale = std::min(
+          static_cast<float>(max_size_.width()) / size.width(),
+          static_cast<float>(max_size_.height()) / size.height());
+      size = gfx::ToFlooredSize(gfx::ScaleSize(gfx::SizeF(size), scale));
+      size.SetToMax(gfx::Size(1, 1));
+      on_frame_.Run(skia::ImageOperations::Resize(
+          bitmap, skia::ImageOperations::RESIZE_GOOD, size.width(),
+          size.height()));
+    } else {
+      on_frame_.Run(bitmap);
+    }
+  }
+  // It drew again while this copy was on its way.
+  if (dirty_) {
+    Capture();
+  }
+}
+
+}  // namespace plutonium_agent
