+DevToolsKey GetDevToolsKey(const input::NativeWebKeyboardEvent& event) {
+  constexpr int kAll =
+      blink::WebInputEvent::kControlKey | blink::WebInputEvent::kAltKey |
+      blink::WebInputEvent::kShiftKey | blink::WebInputEvent::kMetaKey;
+  const int modifiers = event.GetModifiers() & kAll;
+  if (event.windows_key_code == ui::VKEY_F12 && modifiers == 0) {
+    return DevToolsKey::kToggle;
+  }
+  if (modifiers !=
+      (blink::WebInputEvent::kControlKey | blink::WebInputEvent::kShiftKey)) {
+    return DevToolsKey::kNone;
+  }
+  switch (event.windows_key_code) {
+    case ui::VKEY_I:
+      return DevToolsKey::kToggle;
+    case ui::VKEY_J:
+      return DevToolsKey::kConsole;
+    case ui::VKEY_C:
+      return DevToolsKey::kInspect;
+    default:
+      return DevToolsKey::kNone;
+  }
+}
