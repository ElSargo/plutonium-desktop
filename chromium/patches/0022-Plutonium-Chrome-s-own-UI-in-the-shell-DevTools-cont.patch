+// EXO-CHROME: Chrome's context menu in shell mode (plutonium_shell.h).
+//
+// A shell page's own context menu and a browser tab's (plutonium_tabs.h) are
+// Chrome's RenderViewContextMenu without the items that belong to a browser
+// window: Cast, Print, Save as, Inspect, Exit full screen, translation,
+// QR codes and the like. What stays is what a page's menu needs on a
+// desktop: editing, links, images, media and spelling, and for a tab Back,
+// Forward and Reload.
+//
+// The shell shows it, in its own style: the visible shell page gets a
+// "contextmenurequest" event (navigator.windowBroker) with the items, and
+// answers with closeContextMenu(menuId, itemId). A shell that doesn't take
+// the event (preventDefault()) gets Chrome's own menu, with the same items.
+namespace plutonium_context_menu {
+
+// If |source| is a shell page or a tab, filters |menu| (built and Init()ed
+// for |source|) and shows it the shell's way, taking it; true. Otherwise
+// false, and |menu| is left alone.
+bool MaybeShow(content::WebContents* source,
+               std::unique_ptr<RenderViewContextMenuBase>& menu);
+
+// Shell page |shell| closed menu |menu_id|, choosing item |item_id| (0 for
+// nothing). Ignored unless it is the menu |shell| was asked to show.
+void OnClosedByShell(content::WebContents* shell,
+                     int32_t menu_id,
+                     int32_t item_id);
+
+}  // namespace plutonium_context_menu
+
+#endif  // CHROME_BROWSER_PLUTONIUM_CONTEXT_MENU_H_
