+bool DevToolsWindow::ShowInShellTab(bool activate) {
+  if (in_shell_tab_) {
+    if (activate) {
+      PlutoniumTabs::Get()->RequestShow(main_web_contents_);
+    }
+    return true;
+  }
+  content::WebContents* inspected_web_contents = GetInspectedWebContents();
+  if (!plutonium_shell::IsShellMode() || browser_ ||
+      !owned_main_web_contents_ || !inspected_web_contents ||
+      !PlutoniumTabs::Get()->IsTab(inspected_web_contents)) {
+    return false;
+  }
+  in_shell_tab_ = true;
+  main_web_contents_->SetDelegate(this);
+  OverrideAndSyncDevToolsRendererPrefs();
+  PlutoniumTabs::Get()->AddDevToolsTab(main_web_contents_,
