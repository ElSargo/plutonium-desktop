 namespace {
 
+// PLUTONIUM (EXO-CHROME): Chrome's shell mode (--plutonium-shell-url, see
+// chrome/browser/plutonium_shell.h), where a web page is the desktop.
+bool IsPlutoniumShellMode() {
+  static const bool shell_mode =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("plutonium-shell-url");
+  return shell_mode;
+}
+
+// In shell mode the shell is the desktop, as a Wayland compositor's is: of
+// Ash's own keys only the hardware ones stay (brightness, volume, media,
+// power, the Caps Lock key), and the debug ones when they're turned on. The
+// rest (screen scaling and rotation, switching input methods, accessibility
+// toggles, clipboard history, Shift ending Caps Lock) reach the app or page.
+bool IsAllowedInPlutoniumShell(AcceleratorAction action,
+                               const ui::Accelerator& accelerator) {
+  switch (action) {
+    case AcceleratorAction::kBrightnessDown:
+    case AcceleratorAction::kBrightnessUp:
+    case AcceleratorAction::kKeyboardBacklightToggle:
+    case AcceleratorAction::kKeyboardBrightnessDown:
+    case AcceleratorAction::kKeyboardBrightnessUp:
+    case AcceleratorAction::kMediaFastForward:
+    case AcceleratorAction::kMediaNextTrack:
+    case AcceleratorAction::kMediaPause:
+    case AcceleratorAction::kMediaPlay:
+    case AcceleratorAction::kMediaPlayPause:
+    case AcceleratorAction::kMediaPrevTrack:
+    case AcceleratorAction::kMediaRewind:
+    case AcceleratorAction::kMediaStop:
+    case AcceleratorAction::kMicrophoneMuteToggle:
+    case AcceleratorAction::kPowerPressed:
+    case AcceleratorAction::kPowerReleased:
+    case AcceleratorAction::kPrivacyScreenToggle:
+    case AcceleratorAction::kVolumeDown:
+    case AcceleratorAction::kVolumeMute:
+    case AcceleratorAction::kVolumeUp:
+      return true;
+    case AcceleratorAction::kToggleCapsLock:
+      // Not Alt+Search.
+      return accelerator.key_code() == ui::VKEY_CAPITAL;
+    default:
+      break;
+  }
+  if (debug::DebugAcceleratorsEnabled()) {
+    for (const AcceleratorData& data : kDebugAcceleratorData) {
+      if (data.action == action) {
+        return true;
+      }
+    }
+  }
+  if (debug::DeveloperAcceleratorsEnabled()) {
+    for (const AcceleratorData& data : kDeveloperAcceleratorData) {
+      if (data.action == action) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
 using ::base::UserMetricsAction;
 using ::chromeos::WindowStateType;
 using input_method::InputMethodManager;
