+
+// Whether a shell page's (|tab| false) or a tab's menu keeps command |id|.
+bool Keeps(int id, bool tab) {
+  // The page's own items (<menu>, plugins).
+  if (RenderViewContextMenuBase::IsContentCustomCommandId(id)) {
+    return true;
+  }
+  // Spelling suggestions, then the spell-check languages (their last ids
+  // are RenderViewContextMenu's own).
+  if (id >= IDC_SPELLCHECK_SUGGESTION_0 &&
+      id < IDC_CHECK_SPELLING_WHILE_TYPING) {
+    return true;
+  }
+  switch (id) {
+    // A shell page isn't somewhere to go back from or reload: it's the
+    // desktop.
+    case IDC_BACK:
+    case IDC_FORWARD:
+    case IDC_RELOAD:
+    case IDC_CONTENT_CONTEXT_RELOADFRAME:
+      return tab;
