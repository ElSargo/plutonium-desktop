+    case IDC_CHECK_SPELLING_WHILE_TYPING:
+    case IDC_SPELLCHECK_MULTI_LINGUAL:
+      return true;
+    default:
+      return false;
+  }
+}
+
+ContextMenuItemType TypeOf(ui::MenuModel::ItemType type) {
+  switch (type) {
+    case ui::MenuModel::TYPE_CHECK:
+      return ContextMenuItemType::kCheckbox;
+    case ui::MenuModel::TYPE_RADIO:
+      return ContextMenuItemType::kRadio;
+    case ui::MenuModel::TYPE_SEPARATOR:
+      return ContextMenuItemType::kSeparator;
+    case ui::MenuModel::TYPE_SUBMENU:
+    case ui::MenuModel::TYPE_ACTIONABLE_SUBMENU:
+      return ContextMenuItemType::kSubmenu;
+    case ui::MenuModel::TYPE_TITLE:
+      return ContextMenuItemType::kTitle;
+    default:
+      return ContextMenuItemType::kCommand;
+  }
+}
+
+std::string MediaTypeOf(blink::mojom::ContextMenuDataMediaType type) {
+  switch (type) {
+    case blink::mojom::ContextMenuDataMediaType::kImage:
+      return "image";
+    case blink::mojom::ContextMenuDataMediaType::kVideo:
+      return "video";
+    case blink::mojom::ContextMenuDataMediaType::kAudio:
+      return "audio";
+    case blink::mojom::ContextMenuDataMediaType::kCanvas:
+      return "canvas";
+    case blink::mojom::ContextMenuDataMediaType::kFile:
+      return "file";
+    case blink::mojom::ContextMenuDataMediaType::kPlugin:
+      return "plugin";
+    default:
+      return std::string();
+  }
+}
+
+// An item the shell can choose: where it is in the menu's models.
+struct Target {
+  raw_ptr<ui::MenuModel> model;
+  size_t index;
+};
+
+struct Node {
+  blink::mojom::ContextMenuItemPtr item;
+  std::vector<Node> children;
+};
+
+// |model|'s items as the shell gets them; submenus' are filtered too.
+std::vector<Node> Collect(ui::MenuModel* model,
+                          bool tab,
+                          std::vector<Target>& targets) {
+  std::vector<Node> nodes;
+  for (size_t i = 0; i < model->GetItemCount(); ++i) {
+    if (!model->IsVisibleAt(i)) {
+      continue;
+    }
+    const ContextMenuItemType type = TypeOf(model->GetTypeAt(i));
+    Node node;
+    node.item = blink::mojom::ContextMenuItem::New();
+    node.item->type = type;
+    if (type == ContextMenuItemType::kSeparator) {
+      // Doubled or at either end: dropped below.
+      if (!nodes.empty() &&
+          nodes.back().item->type != ContextMenuItemType::kSeparator) {
+        nodes.push_back(std::move(node));
+      }
+      continue;
+    }
+    if (type != ContextMenuItemType::kTitle &&
+        !Keeps(model->GetCommandIdAt(i), tab)) {
+      continue;
+    }
+    node.item->label = base::UTF16ToUTF8(
+        gfx::RemoveAccelerator(model->GetLabelAt(i)));
+    node.item->enabled = model->IsEnabledAt(i);
+    node.item->checked = model->IsItemCheckedAt(i);
+    if (type != ContextMenuItemType::kTitle) {
+      targets.push_back({model, i});
+      node.item->id = static_cast<int32_t>(targets.size());
+    }
+    if (type == ContextMenuItemType::kSubmenu) {
+      ui::MenuModel* submenu = model->GetSubmenuModelAt(i);
+      if (!submenu) {
+        continue;
+      }
+      submenu->MenuWillShow();
+      node.children = Collect(submenu, tab, targets);
+      if (node.children.empty()) {
+        continue;
+      }
+    }
+    nodes.push_back(std::move(node));
+  }
+  if (!nodes.empty() &&
+      nodes.back().item->type == ContextMenuItemType::kSeparator) {
+    nodes.pop_back();
+  }
+  return nodes;
+}
+
+void Flatten(std::vector<Node>& nodes,
+             int32_t parent_id,
+             std::vector<blink::mojom::ContextMenuItemPtr>& items) {
+  for (Node& node : nodes) {
+    const int32_t id = node.item->id;
+    node.item->parent_id = parent_id;
+    items.push_back(std::move(node.item));
+    Flatten(node.children, id, items);
+  }
+}
+
+// Runs |on_gone| when |contents| goes or shows another page.
+class GoneObserver : public content::WebContentsObserver {
+ public:
+  GoneObserver(content::WebContents* contents, base::OnceClosure on_gone)
+      : content::WebContentsObserver(contents), on_gone_(std::move(on_gone)) {}
+
+  void WebContentsDestroyed() override { Gone(); }
+  void PrimaryPageChanged(content::Page& page) override { Gone(); }
+
+ private:
+  void Gone() {
+    Observe(nullptr);
+    if (on_gone_) {
+      std::move(on_gone_).Run();
+    }
+  }
+
+  base::OnceClosure on_gone_;
+};
+
+// The menu the shell was last asked to show.
+class Pending {
+ public:
+  Pending(int32_t id,
+          content::WebContents* source,
+          content::WebContents* shell,
+          std::unique_ptr<RenderViewContextMenuBase> menu,
+          std::vector<Target> targets)
+      : id_(id),
+        source_(source),
+        shell_(shell),
+        menu_(std::move(menu)),
+        targets_(std::move(targets)),
+        source_gone_(source,
+                     base::BindOnce(&Pending::OnSourceGone,
+                                    base::Unretained(this))),
+        shell_gone_(shell,
+                    base::BindOnce(&Pending::OnShellGone,
+                                   base::Unretained(this))) {}
+
+  int32_t id() const { return id_; }
+  content::WebContents* shell() const { return shell_; }
+
+  // The shell's answer to the request (whether it shows the menu).
+  void OnRequestAnswered(bool handled) {
+    if (!menu_ || native_) {
+      return;
+    }
+    if (handled) {
+      // Shown, as far as the page is concerned (until MenuClosed()).
+      shown_ = true;
+      menu_->OnMenuWillShow(
+          const_cast<ui::SimpleMenuModel*>(&menu_->menu_model()));
+      // A tab's menu: the keyboard is the shell's while it shows it.
+      if (source_ != shell_) {
+        if (content::SurfaceEmbedConnector* connector =
+                source_->GetSurfaceEmbedConnector()) {
+          connector->ClearFocusOnInnerWebContents();
+        }
+        shell_->Focus();
+      }
+      return;
+    }
+    VLOG(1) << "EXO-CHROME menu #" << id_
+            << ": the shell doesn't show it, Chrome does";
+    ShowNatively();
+  }
+
+  void ShowNatively() {
+    native_ = true;
+    menu_->Show();
+  }
+
+  // Runs |item_id| (if not 0) and closes the menu. Destroys this.
+  static void Close(int32_t item_id) {
+    std::unique_ptr<Pending> self = std::move(Current());
+    if (!self || self->native_ || !self->menu_) {
+      return;
+    }
+    if (item_id > 0 && static_cast<size_t>(item_id) <= self->targets_.size()) {
+      const Target& target = self->targets_[item_id - 1];
+      if (target.model->IsEnabledAt(target.index) &&
+          TypeOf(target.model->GetTypeAt(target.index)) !=
+              ContextMenuItemType::kSubmenu) {
+        VLOG(1) << "EXO-CHROME menu #" << self->id_ << ": running "
+                << target.model->GetCommandIdAt(target.index);
+        target.model->ActivatedAt(target.index, /*event_flags=*/0);
+      }
+    }
+    // Running it may have closed the page.
+    if (self->menu_ && self->shown_) {
+      self->menu_->MenuClosed(
+          const_cast<ui::SimpleMenuModel*>(&self->menu_->menu_model()));
+    }
+  }
+
+  static std::unique_ptr<Pending>& Current() {
+    static base::NoDestructor<std::unique_ptr<Pending>> current;
+    return *current;
+  }
+
+ private:
+  // The menu points into its page: it goes with it, now.
+  void OnSourceGone() {
+    menu_.reset();
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(Current()));
+  }
+
+  // Nobody can answer any more.
+  void OnShellGone() {
+    if (!native_) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(
+                         [](int32_t id) {
+                           if (Current() && Current()->id() == id) {
+                             Close(0);
+                           }
+                         },
+                         id_));
+    }
+  }
+
+  const int32_t id_;
+  const raw_ptr<content::WebContents> source_;
+  const raw_ptr<content::WebContents> shell_;
+  std::unique_ptr<RenderViewContextMenuBase> menu_;
+  const std::vector<Target> targets_;
+  bool native_ = false;
+  // The shell took it.
+  bool shown_ = false;
+  GoneObserver source_gone_;
+  GoneObserver shell_gone_;
+};
+
+}  // namespace
+
+bool MaybeShow(content::WebContents* source,
+               std::unique_ptr<RenderViewContextMenuBase>& menu) {
+  if (!plutonium_shell::IsShellMode() || !source || !menu) {
+    return false;
+  }
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  std::optional<PlutoniumTabs::TabInfo> tab =
+      PlutoniumTabs::Get()->GetTabFor(source);
+  content::WebContents* shell = nullptr;
+  if (tab) {
+    shell = PlutoniumTabs::Get()->shell();
+  } else if (shells && shells->GetShellFor(source)) {
+    shell = source;
+  } else {
+    return false;
+  }
+
+  const bool is_tab = tab.has_value();
+  menu->FilterMenuItems([is_tab](int id) { return Keeps(id, is_tab); });
+
+  // A new menu replaces one the shell still shows.
+  if (Pending::Current()) {
+    Pending::Close(0);
+  }
+
+  std::vector<Target> targets;
+  std::vector<Node> nodes = Collect(
+      const_cast<ui::SimpleMenuModel*>(&menu->menu_model()), is_tab, targets);
+  static int32_t next_id = 1;
+  auto request = blink::mojom::ContextMenuRequest::New();
+  request->id = next_id++;
+  request->tab_id = is_tab ? tab->id : 0;
+  const content::ContextMenuParams& params = menu->params();
+  request->x = params.x;
+  request->y = params.y;
+  Flatten(nodes, 0, request->items);
+  if (params.link_url.is_valid()) {
+    request->link_url = params.link_url.spec();
+  }
+  request->selection_text = base::UTF16ToUTF8(params.selection_text);
+  request->editable = params.is_editable;
+  request->media_type = MediaTypeOf(params.media_type);
+  if (request->items.empty() || !shell) {
+    // Nothing left (Chrome shows no empty menu either), or no shell to ask
+    // (none visible): Chrome's.
+    Pending::Current() = std::make_unique<Pending>(
+        request->id, source, source, std::move(menu), std::move(targets));
+    Pending::Current()->ShowNatively();
+    return true;
+  }
+
+  const int32_t id = request->id;
+  Pending::Current() = std::make_unique<Pending>(id, source, shell,
+                                                 std::move(menu),
+                                                 std::move(targets));
+  const bool asked = plutonium_shell::RequestContextMenu(
+      shell, std::move(request), base::BindOnce([](int32_t id, bool handled) {
+        if (Pending::Current() && Pending::Current()->id() == id) {
+          Pending::Current()->OnRequestAnswered(handled);
+        }
+      }, id));
+  if (!asked) {
+    Pending::Current()->ShowNatively();
+  }
+  return true;
+}
+
+void OnClosedByShell(content::WebContents* shell,
+                     int32_t menu_id,
+                     int32_t item_id) {
+  if (!Pending::Current() || Pending::Current()->id() != menu_id ||
+      Pending::Current()->shell() != shell) {
+    return;
+  }
+  Pending::Close(item_id);
+}
+
+}  // namespace plutonium_context_menu
