+namespace {
+
+std::unique_ptr<Plutonium::MediaSession> ToProtocol(
+    const std::optional<PlutoniumMediaSession::Info>& info) {
+  std::unique_ptr<Plutonium::MediaSession> result =
+      Plutonium::MediaSession::Create()
+          .SetActive(info.has_value())
+          .SetPlaying(info && info->playing)
+          .SetTitle(info ? base::UTF16ToUTF8(info->title) : std::string())
+          .SetArtist(info ? base::UTF16ToUTF8(info->artist) : std::string())
+          .SetAlbum(info ? base::UTF16ToUTF8(info->album) : std::string())
+          .SetSource(info ? base::UTF16ToUTF8(info->source) : std::string())
+          .SetActions(std::make_unique<protocol::Array<std::string>>(
+              info ? info->actions : std::vector<std::string>()))
+          .Build();
+  if (info && info->tab_id) {
+    result->SetTabId(*info->tab_id);
+  }
+  return result;
+}
+
+}  // namespace
+
+Response PlutoniumHandler::GetMediaSession(
+    std::unique_ptr<Plutonium::MediaSession>* session) {
+  *session = ToProtocol(media_session_ ? media_session_->GetInfo()
+                                       : std::nullopt);
+  return Response::Success();
+}
+
+Response PlutoniumHandler::MediaSessionAction(const std::string& action) {
+  if (!media_session_) {
+    return Response::ServerError("Plutonium.enable first.");
+  }
+  if (!media_session_->Perform(action)) {
+    return Response::InvalidParams("No such media session action.");
+  }
+  return Response::Success();
+}
+
+void PlutoniumHandler::OnMediaSessionChanged() {
+  frontend_->MediaSessionChanged(ToProtocol(media_session_->GetInfo()));
+}
