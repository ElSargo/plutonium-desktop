+AcceleratorControllerImpl::PlutoniumSystemKeyHandler&
+PlutoniumSystemKeyHandlerInstance() {
+  static base::NoDestructor<
+      AcceleratorControllerImpl::PlutoniumSystemKeyHandler>
+      handler;
+  return *handler;
+}
+
+// The helper's name for a hardware key's action, and Ash's own action, run
+// when the helper had nothing to do with it (the browser's media session
+// still answers the media keys). nullptr for the other actions.
+const char* PlutoniumSystemKey(AcceleratorAction action,
+                               base::OnceClosure* own_action) {
+  switch (action) {
+    case AcceleratorAction::kVolumeUp:
+      return "volume-up";
+    case AcceleratorAction::kVolumeDown:
+      return "volume-down";
+    case AcceleratorAction::kVolumeMute:
+    case AcceleratorAction::kVolumeMuteToggle:
+      return "volume-mute";
+    case AcceleratorAction::kMicrophoneMuteToggle:
+      return "mic-mute";
+    case AcceleratorAction::kBrightnessUp:
+      return "brightness-up";
+    case AcceleratorAction::kBrightnessDown:
+      return "brightness-down";
+    case AcceleratorAction::kMediaPlayPause:
+      *own_action = base::BindOnce(&accelerators::MediaPlayPause);
+      return "play-pause";
+    case AcceleratorAction::kMediaPlay:
+      *own_action = base::BindOnce(&accelerators::MediaPlay);
+      return "play";
+    case AcceleratorAction::kMediaPause:
+      *own_action = base::BindOnce(&accelerators::MediaPause);
+      return "pause";
+    case AcceleratorAction::kMediaStop:
+      *own_action = base::BindOnce(&accelerators::MediaStop);
+      return "stop";
+    case AcceleratorAction::kMediaNextTrack:
+      *own_action = base::BindOnce(&accelerators::MediaNextTrack);
+      return "next";
+    case AcceleratorAction::kMediaPrevTrack:
+      *own_action = base::BindOnce(&accelerators::MediaPrevTrack);
+      return "previous";
+    default:
+      return nullptr;
+  }
+}
+
 // In shell mode the shell is the desktop, as a Wayland compositor's is: of
 // Ash's own keys only the hardware ones stay (brightness, volume, media,
 // power, the Caps Lock key), and the debug ones when they're turned on. The
@@ -1074,6 +1127,12 @@ bool AcceleratorControllerImpl::CanPerformAction(
   }
 }
 
+// static
+void AcceleratorControllerImpl::SetPlutoniumSystemKeyHandler(
+    PlutoniumSystemKeyHandler handler) {
+  PlutoniumSystemKeyHandlerInstance() = std::move(handler);
+}
+
 void AcceleratorControllerImpl::PerformAction(
     AcceleratorAction action,
     const ui::Accelerator& accelerator) {
@@ -1095,6 +1154,14 @@ void AcceleratorControllerImpl::PerformAction(
         action == AcceleratorAction::kVolumeUp);
   }
 
+  if (IsPlutoniumShellMode() && PlutoniumSystemKeyHandlerInstance()) {
+    base::OnceClosure own_action = base::DoNothing();
+    if (const char* key = PlutoniumSystemKey(action, &own_action)) {
+      PlutoniumSystemKeyHandlerInstance().Run(key, std::move(own_action));
+      return;
+    }
+  }
+
   const bool key_pressed =
       accelerator.key_state() == ui::Accelerator::KeyState::PRESSED;
 
