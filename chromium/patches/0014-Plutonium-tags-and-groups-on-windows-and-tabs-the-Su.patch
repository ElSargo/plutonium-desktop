index 0000000000..d5e5baec32
--- /dev/null
+++ b/chrome/browser/plutonium_groups.h
@@ -0,0 +1,114 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PLUTONIUM_GROUPS_H_
+#define CHROME_BROWSER_PLUTONIUM_GROUPS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+
+class PrefRegistrySimple;
+
+// EXO-TAGS: tags on windows and tabs, and the groups they name.
+//
+// Every window and tab carries a list of tags. Items with the same tag go
+// together, whichever shell shows them: a thread-based shell tags what a
+// thread opens with the thread's tag, a workspace window manager its
+// workspace's, and each can read the other's to place items. Tags are
+// namespaced by convention, "<namespace>:<name>" (t3:thread/<id>,
+// plain:thread/<id>, wm:workspace/2).
+//
+// - The first tag is the item's origin: the thread that started a window's
+//   client (its PLUTONIUM_THREAD_ID, or the nearest ancestor's), or the tag a
+//   tab was created with (inherited by tabs its page opens). It never
+//   changes.
+// - Only shell documents (the broker) and the browser's own UI add or remove
+//   the others. A thread's agent may use every item tagged with the thread.
+//
+// A group is a tag a shell has described: its label and which shell owns
+// it (EXO-SHELLS; the owner gets the helper's requests about the group).
+namespace plutonium_tags {
+
+// The environment variable a thread's processes carry (the helper sets it).
+inline constexpr char kThreadVariable[] = "PLUTONIUM_THREAD_ID";
+// Upper bounds, to keep a misbehaving shell from bloating every entry.
+inline constexpr size_t kMaxTagLength = 256;
+inline constexpr size_t kMaxTags = 32;
+
+// Printable ASCII without spaces, at most kMaxTagLength.
+bool IsValidTag(std::string_view tag);
+
+// |tags| (origin first) with |add| appended and |remove| taken out, except
+// the origin (|tags[0]| when |has_origin|). Invalid and duplicate tags are
+// skipped, and the list is cut at kMaxTags.
+std::vector<std::string> Update(const std::vector<std::string>& tags,
+                                bool has_origin,
+                                const std::vector<std::string>& add,
+                                const std::vector<std::string>& remove);
+
+// The thread tag of process |pid|: its own PLUTONIUM_THREAD_ID, or the
+// nearest ancestor's. Empty if none; nullopt if the browser may not read
+// |pid|'s environment (e.g. Ash in a container with its own user
+// namespace). Blocks (reads /proc).
+std::optional<std::string> ReadThreadTag(int pid);
+
+}  // namespace plutonium_tags
+
+class PlutoniumGroups {
+ public:
+  struct Group {
+    std::string tag;
+    std::string label;
+    // The owning shell's id (PlutoniumShells), or "" outside shell mode.
+    std::string shell_id;
+    bool operator==(const Group&) const = default;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnGroupsChanged() {}
+  };
+
+  // In local state: the groups survive restarts, so items keep their labels
