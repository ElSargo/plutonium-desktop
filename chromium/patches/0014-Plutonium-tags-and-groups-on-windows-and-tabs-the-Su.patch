+      },
+      WrapPersistent(this), WrapPersistent(resolver));
+  if (tab) {
+    remote_->UpdateTabTags(id, add, remove, std::move(done));
+  } else {
+    remote_->UpdateWindowTags(id, add, remove, std::move(done));
+  }
+  return promise;
+}
+
+ScriptPromise<IDLBoolean> NativeWindowBroker::setWindowOriginTag(
+    ScriptState* script_state,
+    int32_t window_id,
+    const String& tag) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLBoolean>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->SetWindowOriginTag(
+      window_id, tag,
+      BindOnce(
+          [](NativeWindowBroker* self, ScriptPromiseResolver<IDLBoolean>* resolver,
+             bool ok) {
+            self->pending_.erase(resolver);
+            resolver->Resolve(ok);
+          },
+          WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+ScriptPromise<IDLSequence<ItemGroup>> NativeWindowBroker::getGroups(
+    ScriptState* script_state) {
+  auto* resolver = MakeGarbageCollected<
+      ScriptPromiseResolver<IDLSequence<ItemGroup>>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->GetGroups(BindOnce(
+      [](NativeWindowBroker* self,
+         ScriptPromiseResolver<IDLSequence<ItemGroup>>* resolver,
+         Vector<mojom::blink::ItemGroupPtr> groups) {
+        self->pending_.erase(resolver);
+        HeapVector<Member<ItemGroup>> result;
+        for (const auto& group : groups) {
+          result.push_back(ToEntry(*group));
+        }
+        resolver->Resolve(result);
+      },
+      WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+void NativeWindowBroker::setGroups(const HeapVector<Member<ItemGroup>>& groups) {
+  if (!BindRemote()) {
+    return;
+  }
+  Vector<mojom::blink::ItemGroupPtr> result;
+  for (const ItemGroup* group : groups) {
+    result.push_back(mojom::blink::ItemGroup::New(group->tag(), group->label(),
+                                                  String("")));
+  }
+  remote_->SetGroups(std::move(result));
+}
+
+ScriptPromise<IDLString> NativeWindowBroker::getShellId(
+    ScriptState* script_state) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLString>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->GetShellId(BindOnce(
+      [](NativeWindowBroker* self, ScriptPromiseResolver<IDLString>* resolver,
+         const String& shell_id) {
+        self->pending_.erase(resolver);
+        resolver->Resolve(shell_id);
+      },
+      WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+ScriptPromise<IDLSequence<ShellEntry>> NativeWindowBroker::getShells(
+    ScriptState* script_state) {
+  auto* resolver = MakeGarbageCollected<
+      ScriptPromiseResolver<IDLSequence<ShellEntry>>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->GetShells(BindOnce(
+      [](NativeWindowBroker* self,
+         ScriptPromiseResolver<IDLSequence<ShellEntry>>* resolver,
+         Vector<mojom::blink::ShellEntryPtr> shells) {
+        self->pending_.erase(resolver);
+        HeapVector<Member<ShellEntry>> result;
+        for (const auto& shell : shells) {
+          result.push_back(ToEntry(*shell));
+        }
+        resolver->Resolve(result);
+      },
+      WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+void NativeWindowBroker::showShell() {
+  if (!BindRemote()) {
+    return;
+  }
+  remote_->ShowShell();
+}
+
 void NativeWindowBroker::Trace(Visitor* visitor) const {
   visitor->Trace(remote_);
   visitor->Trace(observer_receiver_);
   visitor->Trace(tab_observer_receiver_);
+  visitor->Trace(group_observer_receiver_);
+  visitor->Trace(shell_observer_receiver_);
   visitor->Trace(pending_);
   EventTarget::Trace(visitor);
   ExecutionContextClient::Trace(visitor);
