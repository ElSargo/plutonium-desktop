+
+// EXO-SHELLS: the shells overlay, Ash's own UI for several shells. Super+Tab
+// opens it over the visible shell. It lists
+// - the shells: switch to one, add one, edit, turn off or on, reload,
+//   remove;
+// - every window and tab, whichever shell shows it, grouped by their tags'
+//   labels, with search: show it in its shell, pop a window out to the
+//   desktop, add it to a group (a thread), close it.
+// Arrows move, Enter acts, Escape closes, Super+Tab again moves on; the
+// footer lists the other keys.
+class PlutoniumOverlay : public views::WidgetObserver {
+ public:
+  explicit PlutoniumOverlay(PlutoniumShells* shells);
+  PlutoniumOverlay(const PlutoniumOverlay&) = delete;
+  PlutoniumOverlay& operator=(const PlutoniumOverlay&) = delete;
+  ~PlutoniumOverlay() override;
+
+  bool IsOpen() const { return !!widget_; }
+  // Opens it with the shell |step| away from the visible one selected, or
+  // moves the selection by |step| if it is open.
+  void OnSwitchKey(int step);
+  // Closes it (gives the visible shell its focus back unless |acted|: an
+  // action already chose what comes next).
+  void Close(bool acted = false);
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  void Open(int step);
+
+  raw_ptr<PlutoniumShells> shells_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<PlutoniumOverlayView> view_ = nullptr;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+  base::WeakPtrFactory<PlutoniumOverlay> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_OVERLAY_H_
