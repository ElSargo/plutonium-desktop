+class PlutoniumOverlayView : public views::View,
+                             public views::TextfieldController,
+                             public ExoWindowBroker::Observer,
+                             public PlutoniumTabs::Observer,
+                             public PlutoniumGroups::Observer,
+                             public PlutoniumShells::Observer {
+  METADATA_HEADER(PlutoniumOverlayView, views::View)
+
+ public:
+  PlutoniumOverlayView(PlutoniumShells* shells,
+                       PlutoniumOverlay* overlay,
+                       int step)
+      : shells_(shells), overlay_(overlay) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(16), 8));
+    SetBackground(views::CreateRoundedRectBackground(kPanel, 16));
+
+    search_ = AddChildView(std::make_unique<views::Textfield>());
+    search_->SetPlaceholderText(u"Search shells, windows and tabs");
+    search_->SetController(this);
+    search_->SetFontList(gfx::FontList().DeriveWithSizeDelta(4));
+
+    form_ = AddChildView(std::make_unique<views::View>());
+    form_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+    form_title_ = form_->AddChildView(std::make_unique<views::Label>());
+    form_title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    form_title_->SetAutoColorReadabilityEnabled(false);
+    form_title_->SetEnabledColor(kTitle);
+    form_title_->SetFontList(
+        gfx::FontList().DeriveWithSizeDelta(2).DeriveWithWeight(
+            gfx::Font::Weight::BOLD));
+    name_ = form_->AddChildView(std::make_unique<views::Textfield>());
+    name_->SetPlaceholderText(u"Name");
+    name_->SetController(this);
+    url_ = form_->AddChildView(std::make_unique<views::Textfield>());
+    url_->SetPlaceholderText(u"URL, e.g. http://127.0.0.1:8770/?helper=…");
+    url_->SetController(this);
+    form_->SetVisible(false);
+
+    scroll_ = AddChildView(std::make_unique<views::ScrollView>());
+    scroll_->SetBackgroundColor(kPanel);
+    scroll_->SetDrawOverflowIndicator(false);
+    // Rows as wide as the panel.
+    scroll_->SetHorizontalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kDisabled);
+    list_ = scroll_->SetContents(std::make_unique<views::View>());
+    list_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical));
+    static_cast<views::BoxLayout*>(GetLayoutManager())
+        ->SetFlexForView(scroll_, 1);
+
+    status_ = AddChildView(std::make_unique<views::Label>());
+    status_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    status_->SetAutoColorReadabilityEnabled(false);
+    status_->SetEnabledColor(kError);
+    status_->SetVisible(false);
+
+    footer_ = AddChildView(std::make_unique<views::Label>());
+    footer_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    footer_->SetMultiLine(true);
+    footer_->SetAutoColorReadabilityEnabled(false);
+    footer_->SetEnabledColor(kDim);
+
+    if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+      broker->AddObserver(this);
+    }
+    PlutoniumTabs::Get()->AddObserver(this);
+    PlutoniumGroups::Get()->AddObserver(this);
+    shells_->AddObserver(this);
+
+    // Start on the shell |step| away from the visible one.
+    std::vector<std::string> running;
+    std::string visible;
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      if (shell.running) {
+        running.push_back(shell.id);
+      }
+      if (shell.visible) {
+        visible = shell.id;
+      }
+    }
+    if (!running.empty()) {
+      auto it = std::ranges::find(running, visible);
+      const int count = static_cast<int>(running.size());
+      const int current =
+          it == running.end() ? -step : static_cast<int>(it - running.begin());
+      Row target;
+      target.kind = Row::Kind::kShell;
+      target.shell_id = running[((current + step) % count + count) % count];
+      selected_key_ = target.key();
+    }
+    Rebuild();
+  }
+
+  ~PlutoniumOverlayView() override {
+    shells_->RemoveObserver(this);
+    PlutoniumGroups::Get()->RemoveObserver(this);
+    PlutoniumTabs::Get()->RemoveObserver(this);
+    if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+      broker->RemoveObserver(this);
+    }
+  }
+
+  void Step(int step) {
+    if (mode_ == Mode::kEdit) {
+      return;
+    }
+    Move(step);
+  }
+
+  void FocusSearch() { search_->RequestFocus(); }
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    if (sender == search_) {
+      Rebuild();
+    }
+  }
+
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override {
+    if (event.type() != ui::EventType::kKeyPressed) {
+      return false;
+    }
+    return mode_ == Mode::kEdit ? HandleEditKey(event) : HandleListKey(event);
+  }
+
+  // Observers: anything listed changed.
+  void OnWindowAdded(const ExoWindowBroker::WindowInfo&) override {
+    RebuildSoon();
+  }
+  void OnWindowChanged(const ExoWindowBroker::WindowInfo&) override {
+    RebuildSoon();
+  }
+  void OnWindowRemoved(int32_t) override { RebuildSoon(); }
+  void OnTabAdded(const PlutoniumTabs::TabInfo&) override { RebuildSoon(); }
+  void OnTabChanged(const PlutoniumTabs::TabInfo&) override { RebuildSoon(); }
+  void OnTabRemoved(int32_t) override { RebuildSoon(); }
+  void OnGroupsChanged() override { RebuildSoon(); }
+  void OnShellsChanged() override { RebuildSoon(); }
+
+ private:
+  enum class Mode { kList, kPickGroup, kEdit };
+
+  // Lists.
+
+  void RebuildSoon() {
+    if (rebuild_pending_) {
+      return;
+    }
+    rebuild_pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&PlutoniumOverlayView::Rebuild,
+                                  weak_ptr_factory_.GetWeakPtr()));
+  }
+
+  std::u16string Query() const {
+    return base::ToLowerASCII(base::TrimWhitespace(search_->GetText(),
+                                                   base::TRIM_ALL));
+  }
+
+  std::string ShellName(const std::string& id) const {
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      if (shell.id == id) {
+        return shell.name;
+      }
+    }
+    return std::string();
+  }
+
+  // The tag an item is listed under: its first tag a shell has labelled,
+  // else its first tag, else none.
+  static std::string GroupTagOf(const std::vector<std::string>& tags) {
+    for (const std::string& tag : tags) {
+      if (PlutoniumGroups::Get()->Find(tag)) {
+        return tag;
+      }
+    }
+    return tags.empty() ? std::string() : tags.front();
+  }
+
+  std::u16string GroupHeader(const std::string& tag) const {
+    if (tag.empty()) {
+      return u"Not in any group";
+    }
+    std::optional<PlutoniumGroups::Group> group =
+        PlutoniumGroups::Get()->Find(tag);
+    if (!group) {
+      return base::UTF8ToUTF16(tag);
+    }
+    std::string header = group->label.empty() ? tag : group->label;
+    std::string shell = ShellName(group->shell_id);
+    if (!shell.empty()) {
+      header += "  ·  " + shell;
+    }
+    return base::UTF8ToUTF16(header);
+  }
+
+  void BuildListRows() {
+    const std::u16string query = Query();
+    Row header;
+    header.title = u"Shells";
+    rows_.push_back(header);
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      std::u16string name = base::UTF8ToUTF16(shell.name);
+      std::u16string url = base::UTF8ToUTF16(shell.url.spec());
+      if (!Matches(query, {name, url})) {
+        continue;
+      }
+      Row row;
+      row.kind = Row::Kind::kShell;
+      row.shell_id = shell.id;
+      row.title = (shell.visible ? u"> " : u"   ") + name;
+      row.detail = !shell.enabled   ? u"off"
+                   : !shell.running ? u"starting"
+                                    : url;
+      row.dim = !shell.enabled;
+      row.current = shell.visible;
+      rows_.push_back(row);
+    }
+    if (Matches(query, {u"add shell", u"new shell"})) {
+      Row add;
+      add.kind = Row::Kind::kAddShell;
+      add.title = u"   Add a shell…";
+      add.dim = true;
+      rows_.push_back(add);
+    }
+
+    // Windows and tabs by group.
+    std::map<std::string, std::vector<Row>> items;
+    if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+      for (const ExoWindowBroker::WindowInfo& window : broker->GetWindows()) {
+        Row row;
+        row.kind = Row::Kind::kWindow;
+        row.id = window.id;
+        row.title = window.title.empty() ? base::UTF8ToUTF16(window.app_id)
+                                         : window.title;
+        row.detail = u"app  " + base::UTF8ToUTF16(window.app_id);
+        if (!window.tags.empty()) {
+          row.detail += u"   " + JoinTags(window.tags);
+        }
+        const std::string group = GroupTagOf(window.tags);
+        if (!Matches(query, {row.title, row.detail, GroupHeader(group)})) {
+          continue;
+        }
+        items[group].push_back(row);
+      }
+    }
+    for (const PlutoniumTabs::TabInfo& tab : PlutoniumTabs::Get()->GetTabs()) {
+      Row row;
+      row.kind = Row::Kind::kTab;
+      row.id = tab.id;
+      row.title = tab.title.empty() ? base::UTF8ToUTF16(tab.url.spec())
+                                    : tab.title;
+      row.detail = u"tab  " + base::UTF8ToUTF16(tab.url.host());
+      if (!tab.tags.empty()) {
+        row.detail += u"   " + JoinTags(tab.tags);
+      }
+      const std::string group = GroupTagOf(tab.tags);
+      if (!Matches(query, {row.title, base::UTF8ToUTF16(tab.url.spec()),
+                           row.detail, GroupHeader(group)})) {
+        continue;
+      }
+      items[group].push_back(row);
+    }
+    // Labelled groups by label, then unlabelled tags, then the ungrouped.
+    std::vector<std::string> order;
+    for (const auto& [tag, rows] : items) {
+      order.push_back(tag);
+    }
+    std::ranges::sort(order, [&](const std::string& a, const std::string& b) {
+      auto rank = [](const std::string& tag) {
+        return tag.empty() ? 2 : PlutoniumGroups::Get()->Find(tag) ? 0 : 1;
+      };
+      if (rank(a) != rank(b)) {
+        return rank(a) < rank(b);
+      }
+      return GroupHeader(a) < GroupHeader(b);
+    });
+    for (const std::string& tag : order) {
+      Row group_header;
+      group_header.title = GroupHeader(tag);
+      rows_.push_back(group_header);
+      for (Row& row : items[tag]) {
+        rows_.push_back(std::move(row));
+      }
+    }
+  }
+
+  // The groups an item can be added to (or, if it has the tag, taken out
+  // of).
+  void BuildGroupRows() {
+    const std::u16string query = Query();
+    const std::vector<std::string> tags = TagsOf(target_kind_, target_id_);
+    Row header;
+    header.title = u"Add “" + target_title_ + u"” to…";
+    rows_.push_back(header);
+    for (const PlutoniumGroups::Group& group :
+         PlutoniumGroups::Get()->groups()) {
+      Row row;
+      row.kind = Row::Kind::kGroup;
+      row.tag = group.tag;
+      const bool has = std::ranges::find(tags, group.tag) != tags.end();
+      const bool origin = !tags.empty() && tags.front() == group.tag &&
+                          HasOriginTag(target_kind_, target_id_);
+      std::u16string label =
+          base::UTF8ToUTF16(group.label.empty() ? group.tag : group.label);
+      row.title = (has ? u"[x] " : u"[ ] ") + label;
+      row.detail = base::UTF8ToUTF16(ShellName(group.shell_id) + "   " +
+                                     group.tag);
+      row.dim = origin;
+      if (!Matches(query, {label, row.detail})) {
+        continue;
+      }
+      rows_.push_back(row);
+    }
+    if (rows_.size() == 1) {
+      Row none;
+      none.title = u"No shell has described any groups yet";
+      rows_.push_back(none);
+    }
+  }
+
+  void Rebuild() {
+    rebuild_pending_ = false;
+    rows_.clear();
+    if (mode_ == Mode::kPickGroup) {
+      BuildGroupRows();
+    } else {
+      BuildListRows();
+    }
+    // Keep the selection, else take the first selectable row.
+    selected_ = -1;
+    for (size_t i = 0; i < rows_.size(); ++i) {
+      if (rows_[i].selectable() && rows_[i].key() == selected_key_) {
+        selected_ = static_cast<int>(i);
+      }
+    }
+    if (selected_ < 0) {
+      for (size_t i = 0; i < rows_.size(); ++i) {
+        if (rows_[i].selectable()) {
+          selected_ = static_cast<int>(i);
+          break;
+        }
+      }
+    }
+    if (selected_ >= 0) {
+      selected_key_ = rows_[selected_].key();
+    }
+    list_->RemoveAllChildViews();
+    views::View* selected_view = nullptr;
+    for (size_t i = 0; i < rows_.size(); ++i) {
+      const int index = static_cast<int>(i);
+      auto* view = list_->AddChildView(std::make_unique<RowView>(
+          rows_[i], index == selected_,
+          rows_[i].selectable()
+              ? base::BindRepeating(&PlutoniumOverlayView::Click,
+                                    base::Unretained(this), index)
+              : base::RepeatingClosure()));
+      if (index == selected_) {
+        selected_view = view;
+      }
+    }
+    UpdateFooter();
+    // The scroll view doesn't resize its contents when they change: size
+    // them to its width (less the scroll bar) and the rows' height.
+    const int width = scroll_->width() > 0 ? scroll_->width() - 14 : 940;
+    list_->SetSize(gfx::Size(width, list_->GetHeightForWidth(width)));
+    scroll_->InvalidateLayout();
+    if (views::Widget* widget = GetWidget()) {
+      widget->LayoutRootViewIfNecessary();
+    }
+    if (selected_view) {
+      selected_view->ScrollViewToVisible();
+    }
+  }
+
+  void UpdateFooter() {
+    std::u16string keys;
+    switch (mode_) {
+      case Mode::kEdit:
+        keys = u"Enter save   Tab next field   Esc back";
+        break;
+      case Mode::kPickGroup:
+        keys = u"Enter add or take out   type to search   Esc back";
+        break;
+      case Mode::kList: {
+        const Row* row = Selected();
+        keys = u"↑↓ / Super+Tab move   Esc close   ";
+        if (!row) {
+          break;
+        }
+        switch (row->kind) {
+          case Row::Kind::kShell:
+            keys += u"Enter switch   Ctrl+O on/off   Ctrl+R reload   "
+                    u"Ctrl+E edit   Ctrl+N add   Ctrl+Delete remove (when "
+                    u"off)";
+            break;
+          case Row::Kind::kAddShell:
+            keys += u"Enter add a shell";
+            break;
+          case Row::Kind::kWindow:
+            keys += u"Enter show in its shell   Ctrl+P pop out   Ctrl+T "
+                    u"add to a group   Ctrl+W close";
+            break;
+          case Row::Kind::kTab:
+            keys += u"Enter show in its shell   Ctrl+T add to a group   "
+                    u"Ctrl+W close";
+            break;
+          default:
+            break;
+        }
+        break;
+      }
+    }
+    footer_->SetText(keys);
+  }
+
+  const Row* Selected() const {
+    return selected_ >= 0 && selected_ < static_cast<int>(rows_.size())
+               ? &rows_[selected_]
+               : nullptr;
+  }
+
+  void Move(int step) {
+    if (rows_.empty()) {
+      return;
+    }
+    const int count = static_cast<int>(rows_.size());
+    int index = selected_ < 0 ? 0 : selected_;
+    for (int tries = 0; tries < count; ++tries) {
+      index = ((index + (step > 0 ? 1 : -1)) % count + count) % count;
+      if (rows_[index].selectable()) {
+        break;
+      }
+    }
+    if (!rows_[index].selectable()) {
+      return;
+    }
+    selected_key_ = rows_[index].key();
+    SetStatus(std::u16string());
+    Rebuild();
+  }
+
+  void Click(int index) {
+    if (index < 0 || index >= static_cast<int>(rows_.size())) {
+      return;
+    }
+    selected_key_ = rows_[index].key();
+    selected_ = index;
+    Activate();
+  }
+
+  void SetStatus(const std::u16string& text) {
+    status_->SetText(text);
+    status_->SetVisible(!text.empty());
+    InvalidateLayout();
+  }
+
+  // Keys.
+
+  bool HandleListKey(const ui::KeyEvent& event) {
+    const int modifiers = event.flags() & kModifiers;
+    if (modifiers == 0) {
+      switch (event.key_code()) {
+        case ui::VKEY_UP:
+          Move(-1);
+          return true;
+        case ui::VKEY_DOWN:
+          Move(1);
+          return true;
+        case ui::VKEY_RETURN:
+          Activate();
+          return true;
+        case ui::VKEY_ESCAPE:
+          if (mode_ == Mode::kPickGroup) {
+            LeavePickGroup();
+          } else {
+            overlay_->Close();
+          }
+          return true;
+        default:
+          return false;
+      }
+    }
+    if (modifiers != ui::EF_CONTROL_DOWN || mode_ != Mode::kList) {
+      return false;
+    }
+    const Row* row = Selected();
+    if (!row) {
+      return false;
+    }
+    switch (event.key_code()) {
+      case ui::VKEY_O:
+        if (row->kind == Row::Kind::kShell) {
+          ToggleShell(row->shell_id);
+        }
+        return true;
+      case ui::VKEY_R:
+        if (row->kind == Row::Kind::kShell) {
+          shells_->Reload(row->shell_id);
+        }
+        return true;
+      case ui::VKEY_E:
+        if (row->kind == Row::Kind::kShell) {
+          EnterEdit(row->shell_id);
+        }
+        return true;
+      case ui::VKEY_N:
+        EnterEdit(std::string());
+        return true;
+      case ui::VKEY_DELETE:
+        if (row->kind == Row::Kind::kShell) {
+          RemoveShell(row->shell_id);
+        }
+        return true;
+      case ui::VKEY_P:
+        if (row->kind == Row::Kind::kWindow) {
+          exo::EmbeddedWindows::Get()->ShowOnDesktop(row->id);
+          overlay_->Close(/*acted=*/true);
+        }
+        return true;
+      case ui::VKEY_T:
+        if (row->kind == Row::Kind::kWindow || row->kind == Row::Kind::kTab) {
+          EnterPickGroup(*row);
+        }
+        return true;
+      case ui::VKEY_W:
+        if (row->kind == Row::Kind::kWindow) {
+          exo::EmbeddedWindows::Get()->Close(row->id);
+        } else if (row->kind == Row::Kind::kTab) {
+          PlutoniumTabs::Get()->RunCommand(row->id,
+                                           PlutoniumTabs::Command::kClose);
+        }
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  bool HandleEditKey(const ui::KeyEvent& event) {
+    if (event.flags() & kModifiers) {
+      return false;
+    }
+    switch (event.key_code()) {
+      case ui::VKEY_RETURN:
+        SaveEdit();
+        return true;
+      case ui::VKEY_ESCAPE:
+        LeaveEdit();
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  // Actions.
+
+  void Activate() {
+    const Row* row = Selected();
+    if (!row) {
+      return;
+    }
+    switch (row->kind) {
+      case Row::Kind::kShell: {
+        for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+          if (shell.id != row->shell_id) {
+            continue;
+          }
+          if (!shell.enabled) {
+            shells_->SetEnabled(shell.id, true);
+            SetStatus(u"Turning it on…");
+          } else if (shell.running && shells_->Show(shell.id)) {
+            overlay_->Close(/*acted=*/true);
+          }
+          return;
+        }
+        return;
+      }
+      case Row::Kind::kAddShell:
+        EnterEdit(std::string());
+        return;
+      case Row::Kind::kWindow:
+      case Row::Kind::kTab:
+        ShowItem(row->kind, row->id);
+        return;
+      case Row::Kind::kGroup:
+        ToggleGroup(row->tag);
+        return;
+      case Row::Kind::kHeader:
+        return;
+    }
+  }
+
+  // Shows the item in the shell that owns its group (else the visible one)
+  // and asks that shell's page to bring it up.
+  void ShowItem(Row::Kind kind, int32_t id) {
+    std::string owner;
+    for (const std::string& tag : TagsOf(kind, id)) {
+      std::optional<PlutoniumGroups::Group> group =
+          PlutoniumGroups::Get()->Find(tag);
+      if (group && shells_->GetContents(group->shell_id)) {
+        owner = group->shell_id;
+        break;
+      }
+    }
+    if (!owner.empty()) {
+      shells_->Show(owner);
+    }
+    content::WebContents* shell = shells_->GetVisibleContents();
+    const bool asked =
+        shell && (kind == Row::Kind::kWindow
+                      ? plutonium_shell::RequestShowWindow(shell, id)
+                      : plutonium_shell::RequestShowTab(shell, id));
+    if (!asked && kind == Row::Kind::kWindow) {
+      // The shell doesn't take requests: the desktop it is.
+      exo::EmbeddedWindows::Get()->ShowOnDesktop(id);
+    }
+    overlay_->Close(/*acted=*/true);
+  }
+
+  void ToggleShell(const std::string& id) {
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      if (shell.id == id &&
+          !shells_->SetEnabled(id, !shell.enabled)) {
+        SetStatus(u"The last running shell can't be turned off.");
+      }
+    }
+  }
+
+  void RemoveShell(const std::string& id) {
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      if (shell.id != id) {
+        continue;
+      }
+      if (shell.enabled) {
+        SetStatus(u"Turn it off first (Ctrl+O), then Ctrl+Delete removes it.");
+        return;
+      }
+      shells_->RemoveShell(id);
+      SetStatus(std::u16string());
+      return;
+    }
+  }
+
+  static std::vector<std::string> TagsOf(Row::Kind kind, int32_t id) {
+    if (kind == Row::Kind::kWindow) {
+      ExoWindowBroker* broker = ExoWindowBroker::Get();
+      std::optional<ExoWindowBroker::WindowInfo> window =
+          broker ? broker->GetWindow(id) : std::nullopt;
+      return window ? window->tags : std::vector<std::string>();
+    }
+    std::optional<PlutoniumTabs::TabInfo> tab = PlutoniumTabs::Get()->GetTab(id);
+    return tab ? tab->tags : std::vector<std::string>();
+  }
+
+  static bool HasOriginTag(Row::Kind kind, int32_t id) {
+    if (kind == Row::Kind::kWindow) {
+      ExoWindowBroker* broker = ExoWindowBroker::Get();
+      std::optional<ExoWindowBroker::WindowInfo> window =
+          broker ? broker->GetWindow(id) : std::nullopt;
+      return window && !window->tag.empty();
+    }
+    std::optional<PlutoniumTabs::TabInfo> tab = PlutoniumTabs::Get()->GetTab(id);
+    return tab && !tab->tag.empty();
+  }
+
+  void EnterPickGroup(const Row& row) {
+    target_kind_ = row.kind;
+    target_id_ = row.id;
+    target_title_ = row.title;
+    list_selection_key_ = selected_key_;
+    selected_key_.clear();
+    mode_ = Mode::kPickGroup;
+    search_->SetText(std::u16string());
+    Rebuild();
+  }
+
+  void LeavePickGroup() {
+    mode_ = Mode::kList;
+    selected_key_ = list_selection_key_;
+    search_->SetText(std::u16string());
+    SetStatus(std::u16string());
+    Rebuild();
+  }
+
+  void ToggleGroup(const std::string& tag) {
+    std::vector<std::string> tags = TagsOf(target_kind_, target_id_);
+    if (!tags.empty() && tags.front() == tag &&
+        HasOriginTag(target_kind_, target_id_)) {
+      SetStatus(u"That's where it came from: it stays in that group.");
+      return;
+    }
+    const bool has = std::ranges::find(tags, tag) != tags.end();
+    std::vector<std::string> add, remove;
+    (has ? remove : add).push_back(tag);
+    if (target_kind_ == Row::Kind::kWindow) {
+      if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+        broker->UpdateTags(target_id_, add, remove);
+      }
+    } else {
+      PlutoniumTabs::Get()->UpdateTags(target_id_, add, remove);
+    }
+    LeavePickGroup();
+  }
+
+  void EnterEdit(const std::string& id) {
+    editing_id_ = id;
+    mode_ = Mode::kEdit;
+    std::u16string name, url;
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      if (shell.id == id) {
+        name = base::UTF8ToUTF16(shell.name);
+        url = base::UTF8ToUTF16(shell.url.spec());
+      }
+    }
+    form_title_->SetText(id.empty() ? u"Add a shell" : u"Edit " + name);
+    name_->SetText(name);
+    url_->SetText(url);
+    search_->SetVisible(false);
+    scroll_->SetVisible(false);
+    form_->SetVisible(true);
+    SetStatus(std::u16string());
+    UpdateFooter();
+    InvalidateLayout();
+    name_->RequestFocus();
+  }
+
+  void LeaveEdit() {
+    mode_ = Mode::kList;
+    form_->SetVisible(false);
+    search_->SetVisible(true);
+    scroll_->SetVisible(true);
+    SetStatus(std::u16string());
+    InvalidateLayout();
+    search_->RequestFocus();
+    Rebuild();
+  }
+
+  void SaveEdit() {
+    const std::string name = base::UTF16ToUTF8(
+        base::TrimWhitespace(name_->GetText(), base::TRIM_ALL));
+    const GURL url(base::UTF16ToUTF8(
+        base::TrimWhitespace(url_->GetText(), base::TRIM_ALL)));
+    if (!plutonium_shell::IsAcceptableShellUrl(url)) {
+      SetStatus(
+          u"A shell needs an http(s) URL, https unless it's local "
+          u"(127.0.0.1, localhost).");
+      return;
+    }
+    if (editing_id_.empty()) {
+      std::optional<std::string> id = shells_->AddShell(name, url);
+      if (!id) {
+        SetStatus(u"Couldn't add that shell.");
+        return;
+      }
+      Row added;
+      added.kind = Row::Kind::kShell;
+      added.shell_id = *id;
+      selected_key_ = added.key();
+    } else if (!shells_->UpdateShell(editing_id_, name, url)) {
+      SetStatus(u"Couldn't change that shell.");
+      return;
+    }
+    LeaveEdit();
+  }
+
+  raw_ptr<PlutoniumShells> shells_;
+  raw_ptr<PlutoniumOverlay> overlay_;
+  raw_ptr<views::Textfield> search_ = nullptr;
+  raw_ptr<views::View> form_ = nullptr;
+  raw_ptr<views::Label> form_title_ = nullptr;
+  raw_ptr<views::Textfield> name_ = nullptr;
+  raw_ptr<views::Textfield> url_ = nullptr;
+  raw_ptr<views::ScrollView> scroll_ = nullptr;
+  raw_ptr<views::View> list_ = nullptr;
+  raw_ptr<views::Label> status_ = nullptr;
+  raw_ptr<views::Label> footer_ = nullptr;
+
+  Mode mode_ = Mode::kList;
+  std::vector<Row> rows_;
+  int selected_ = -1;
+  std::string selected_key_;
+  bool rebuild_pending_ = false;
+  // kPickGroup: the item, and where the list was.
+  Row::Kind target_kind_ = Row::Kind::kWindow;
+  int32_t target_id_ = 0;
+  std::u16string target_title_;
+  std::string list_selection_key_;
+  // kEdit: the shell, or "" to add one.
+  std::string editing_id_;
+  base::WeakPtrFactory<PlutoniumOverlayView> weak_ptr_factory_{this};
+};
