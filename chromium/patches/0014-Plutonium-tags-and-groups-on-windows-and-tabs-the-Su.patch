+constexpr SkColor kPanel = SkColorSetRGB(0x20, 0x21, 0x24);
+constexpr SkColor kSelected = SkColorSetRGB(0x3c, 0x40, 0x43);
+constexpr SkColor kTitle = SkColorSetRGB(0xe8, 0xea, 0xed);
+constexpr SkColor kDim = SkColorSetRGB(0x9a, 0xa0, 0xa6);
+constexpr SkColor kAccent = SkColorSetRGB(0x8a, 0xb4, 0xf8);
+constexpr SkColor kError = SkColorSetRGB(0xf2, 0x8b, 0x82);
+constexpr int kModifiers = ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+                           ui::EF_SHIFT_DOWN | ui::EF_COMMAND_DOWN;
+
+struct Row {
+  enum class Kind { kHeader, kShell, kAddShell, kWindow, kTab, kGroup };
+  Kind kind = Kind::kHeader;
+  std::string shell_id;
+  int32_t id = 0;
+  std::string tag;
+  std::u16string title;
+  std::u16string detail;
+  bool dim = false;
+  bool current = false;
+
+  bool selectable() const { return kind != Kind::kHeader; }
+  // What a selection is remembered by across rebuilds.
+  std::string key() const {
+    return base::NumberToString(static_cast<int>(kind)) + "/" + shell_id +
+           "/" + base::NumberToString(id) + "/" + tag;
+  }
+};
+
+bool Matches(const std::u16string& query,
+             std::initializer_list<std::u16string_view> fields) {
+  if (query.empty()) {
+    return true;
+  }
+  for (std::u16string_view field : fields) {
+    if (base::ToLowerASCII(field).find(query) != std::u16string::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::u16string JoinTags(const std::vector<std::string>& tags) {
+  return base::UTF8ToUTF16(base::JoinString(tags, "  "));
+}
+
+// One line of the list: a title and a dimmer detail. Clicking selects and
+// acts.
+class RowView : public views::View {
+  METADATA_HEADER(RowView, views::View)
+
+ public:
+  RowView(const Row& row, bool selected, base::RepeatingClosure on_click)
+      : on_click_(std::move(on_click)) {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        row.kind == Row::Kind::kHeader ? gfx::Insets::TLBR(12, 12, 4, 12)
+                                       : gfx::Insets::VH(6, 12),
+        16));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    if (selected) {
+      SetBackground(views::CreateRoundedRectBackground(kSelected, 6));
+    }
+    const gfx::FontList base;
+    auto* title = AddChildView(std::make_unique<views::Label>(row.title));
+    title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title->SetElideBehavior(gfx::ELIDE_TAIL);
+    title->SetAutoColorReadabilityEnabled(false);
+    if (row.kind == Row::Kind::kHeader) {
+      title->SetFontList(base.DeriveWithWeight(gfx::Font::Weight::BOLD));
+      title->SetEnabledColor(kAccent);
+    } else {
+      title->SetFontList(base.DeriveWithSizeDelta(2));
+      title->SetEnabledColor(row.dim ? kDim : kTitle);
+    }
+    layout->SetFlexForView(title, 1);
+    if (!row.detail.empty()) {
+      auto* detail = AddChildView(std::make_unique<views::Label>(row.detail));
+      detail->SetHorizontalAlignment(gfx::ALIGN_RIGHT);
+      detail->SetElideBehavior(gfx::ELIDE_MIDDLE);
+      detail->SetAutoColorReadabilityEnabled(false);
+      detail->SetEnabledColor(kDim);
+      detail->SetMaximumWidthSingleLine(420);
+    }
+  }
+
+  // views::View:
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (on_click_) {
+      on_click_.Run();
+    }
+    return true;
+  }
+
+ private:
+  base::RepeatingClosure on_click_;
+};
+
