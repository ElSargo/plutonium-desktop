+END_METADATA
+
+PlutoniumOverlay::PlutoniumOverlay(PlutoniumShells* shells) : shells_(shells) {}
+
+PlutoniumOverlay::~PlutoniumOverlay() {
+  widget_observation_.Reset();
+  view_ = nullptr;
+  widget_.reset();
+}
+
+void PlutoniumOverlay::OnSwitchKey(int step) {
+  if (IsOpen()) {
+    view_->Step(step);
+  } else {
+    Open(step);
+  }
+}
+
+void PlutoniumOverlay::Open(int step) {
+  aura::Window* root = ash::Shell::GetRootWindowForNewWindows();
+  if (!root) {
+    return;
+  }
+  const gfx::Rect work_area =
+      display::Screen::Get()->GetDisplayNearestWindow(root).work_area();
+  gfx::Rect bounds(std::min(1000, work_area.width() * 9 / 10),
+                   std::min(720, work_area.height() * 85 / 100));
+  bounds.set_origin(
+      gfx::Point(work_area.x() + (work_area.width() - bounds.width()) / 2,
+                 work_area.y() + (work_area.height() - bounds.height()) / 2));
+
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.name = "PlutoniumShellsOverlay";
+  params.parent =
+      ash::Shell::GetContainer(root, ash::kShellWindowId_OverlayContainer);
+  params.bounds = bounds;
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  widget_ = std::make_unique<views::Widget>(std::move(params));
+  view_ = widget_->SetContentsView(
+      std::make_unique<PlutoniumOverlayView>(shells_, this, step));
+  widget_observation_.Observe(widget_.get());
+  widget_->Show();
+  widget_->Activate();
+  view_->FocusSearch();
+  VLOG(1) << "EXO-SHELLS overlay opened";
+}
+
+void PlutoniumOverlay::Close(bool acted) {
+  if (!widget_) {
+    return;
+  }
+  widget_observation_.Reset();
+  view_ = nullptr;
+  // Not from inside one of the widget's own calls (a key or a click).
+  base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(widget_));
+  if (!acted) {
+    // Back to the visible shell's page.
+    if (content::WebContents* shell = shells_->GetVisibleContents()) {
+      if (aura::Window* window = shell->GetTopLevelNativeWindow()) {
+        wm::ActivateWindow(window);
+      }
+    }
+  }
+  VLOG(1) << "EXO-SHELLS overlay closed";
+}
+
+void PlutoniumOverlay::OnWidgetActivationChanged(views::Widget* widget,
+                                                 bool active) {
+  if (!active) {
+    // Clicked away, or something else took over.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&PlutoniumOverlay::Close,
+                                  weak_ptr_factory_.GetWeakPtr(),
+                                  /*acted=*/true));
+  }
+}
+
+void PlutoniumOverlay::OnWidgetDestroying(views::Widget* widget) {
+  widget_observation_.Reset();
+  view_ = nullptr;
+}
