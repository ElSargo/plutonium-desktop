+                                        ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                        std::string());
+    }
+  }
+  Save();
+  NotifyShellsChanged();
+  return true;
+}
+
+bool PlutoniumShellsImpl::SetEnabled(const std::string& id, bool enabled) {
+  Entry* entry = Find(id);
+  if (!entry) {
+    return false;
+  }
+  if (enabled == entry->shell.enabled) {
+    return true;
+  }
+  if (!enabled) {
+    if (entry->browser && RunningCount() <= 1) {
+      return false;
+    }
+    if (id == visible_id_) {
+      ShowNext(1);
+    }
+  }
+  entry->shell.enabled = enabled;
+  Save();
+  LOG(WARNING) << "EXO-SHELLS shell " << id << (enabled ? " on" : " off");
+  if (!enabled) {
+    if (entry->browser) {
+      // OnBrowserClosed() clears it.
+      entry->browser->GetWindow()->Close();
+    }
+    NotifyShellsChanged();
+  } else if (profile_) {
+    OpenWindows(profile_);
+  }
+  return true;
+}
+
+bool PlutoniumShellsImpl::Reload(const std::string& id) {
+  Entry* entry = Find(id);
+  content::WebContents* contents = entry ? ContentsOf(*entry) : nullptr;
+  if (!contents) {
+    return false;
+  }
+  LOG(WARNING) << "EXO-SHELLS reloading shell " << id;
+  contents->GetController().Reload(content::ReloadType::NORMAL,
+                                   /*check_for_repost=*/false);
+  return true;
+}
+
+bool PlutoniumShellsImpl::RemoveShell(const std::string& id) {
+  Entry* entry = Find(id);
+  if (!entry || !SetEnabled(id, false)) {
+    return false;
+  }
+  std::erase_if(entries_,
+                [&](const Entry& entry) { return entry.shell.id == id; });
+  if (startup_id_ == id) {
+    startup_id_.clear();
+  }
+  Save();
+  PlutoniumGroups::Get()->RemoveShell(id);
+  LOG(WARNING) << "EXO-SHELLS removed shell " << id;
+  NotifyShellsChanged();
+  return true;
+}
+
+void PlutoniumShellsImpl::OnSwitchKey(int step) {
+  overlay_->OnSwitchKey(step);
+}
+
+int PlutoniumShellsImpl::RunningCount() const {
+  return static_cast<int>(std::ranges::count_if(entries_, [](const Entry& entry) {
+    return entry.shell.enabled && entry.browser;
+  }));
+}
