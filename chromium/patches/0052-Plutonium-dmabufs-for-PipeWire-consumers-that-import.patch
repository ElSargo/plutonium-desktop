+// The modifier dmabufs are offered with: linear, which every consumer that
+// takes dmabufs can import, and Ash's CPU copy can write.
+constexpr uint64_t kModifier = DRM_FORMAT_MOD_LINEAR;
+
+// A GBM device on the first render node there is, for dmabufs; null if
+// there's none (then the stream is shared memory only).
+std::unique_ptr<ui::GbmDevice> OpenGbmDevice(base::ScopedFD* fd) {
+  for (int minor = 128; minor < 136; ++minor) {
+    base::ScopedFD node(HANDLE_EINTR(
+        open(("/dev/dri/renderD" + base::NumberToString(minor)).c_str(),
+             O_RDWR | O_CLOEXEC)));
+    if (!node.is_valid()) {
+      continue;
+    }
+    std::unique_ptr<ui::GbmDevice> device = ui::CreateGbmDevice(node.get());
+    if (device && device->CanCreateBufferForFormat(DRM_FORMAT_XRGB8888)) {
+      *fd = std::move(node);
+      return device;
+    }
+  }
+  return nullptr;
+}
+
 // One PipeWire video source node. Its callbacks run on PipeWire's own
 // thread; Push() on the UI thread copies a frame in and starts a graph
 // cycle, whose process() fills the next buffer from it.
