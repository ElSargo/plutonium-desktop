+std::string GetTabCommandKey(const input::NativeWebKeyboardEvent& event) {
+  constexpr int kAll =
+      blink::WebInputEvent::kControlKey | blink::WebInputEvent::kAltKey |
+      blink::WebInputEvent::kShiftKey | blink::WebInputEvent::kMetaKey;
+  constexpr int kCtrl = blink::WebInputEvent::kControlKey;
+  constexpr int kShift = blink::WebInputEvent::kShiftKey;
+  const int modifiers = event.GetModifiers() & kAll;
+  switch (event.windows_key_code) {
+    case ui::VKEY_F3:
+      return modifiers == 0       ? "find-next"
+             : modifiers == kShift ? "find-previous"
+                                   : "";
+    case ui::VKEY_F:
+      return modifiers == kCtrl ? "find" : "";
+    case ui::VKEY_G:
+      return modifiers == kCtrl             ? "find-next"
+             : modifiers == (kCtrl | kShift) ? "find-previous"
+                                             : "";
+    case ui::VKEY_P:
+      return modifiers == kCtrl ? "print" : "";
+    case ui::VKEY_OEM_PLUS:
+    case ui::VKEY_ADD:
+      return (modifiers & ~kShift) == kCtrl ? "zoom-in" : "";
+    case ui::VKEY_OEM_MINUS:
+    case ui::VKEY_SUBTRACT:
+      return (modifiers & ~kShift) == kCtrl ? "zoom-out" : "";
+    case ui::VKEY_0:
+    case ui::VKEY_NUMPAD0:
+      return modifiers == kCtrl ? "zoom-reset" : "";
+    default:
+      return "";
+  }
+}
