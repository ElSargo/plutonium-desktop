+bool SendTabRequest(content::WebContents* shell,
+                    blink::mojom::TabRequestPtr request,
+                    base::OnceCallback<void(int32_t taker)> callback) {
+  for (WindowBrokerImpl* impl : WindowBrokerImpl::Instances()) {
+    if (impl->contents() == shell && impl->SendTabRequest(request, callback)) {
+      return true;
+    }
+  }
+  return false;
+}
