+ScriptPromise<IDLBoolean> NativeWindowBroker::answerTabRequest(
+    ScriptState* script_state,
+    int32_t request_id,
+    const String& answer_json) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLBoolean>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->AnswerTabRequest(
+      request_id, answer_json,
+      BindOnce(
+          [](NativeWindowBroker* self,
+             ScriptPromiseResolver<IDLBoolean>* resolver, int32_t request_id,
+             bool ok) {
+            self->pending_.erase(resolver);
+            if (ok) {
+              self->taken_tab_requests_.erase(request_id);
+            }
+            resolver->Resolve(ok);
+          },
+          WrapPersistent(this), WrapPersistent(resolver), request_id));
+  return promise;
+}
