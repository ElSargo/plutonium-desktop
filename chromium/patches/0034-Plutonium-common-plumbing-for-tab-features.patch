+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HTML_TAB_REQUEST_EVENT_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HTML_TAB_REQUEST_EVENT_H_
+
+#include "third_party/blink/renderer/bindings/core/v8/script_value.h"
+#include "third_party/blink/renderer/core/dom/events/event.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+class ScriptState;
+
+// EXO-TAB-FEATURES: see tab_request_event.idl.
+class TabRequestEvent final : public Event {
+  DEFINE_WRAPPERTYPEINFO();
+
+ public:
+  // "tabrequest" (cancelable) with |detail_json|, or "tabrequestend".
+  TabRequestEvent(const AtomicString& type,
+                  int32_t request_id,
+                  int32_t tab_id,
+                  const String& kind,
+                  const String& detail_json);
+
+  int32_t requestId() const { return request_id_; }
+  int32_t tabId() const { return tab_id_; }
+  const String& kind() const { return kind_; }
+  ScriptValue detail(ScriptState*) const;
+
+  const AtomicString& InterfaceName() const override;
+
+ private:
+  const int32_t request_id_;
+  const int32_t tab_id_;
+  const String kind_;
+  const String detail_json_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HTML_TAB_REQUEST_EVENT_H_
