@@ -0,0 +1,29 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// EXO-TAB-FEATURES: navigator.windowBroker's "tabrequest" and
+// "tabrequestend" (docs/features/TAB_FEATURES.md, "The common shape").
+//
+// "tabrequest" (cancelable): one of this document's tabs needs the user (a
+// file chooser, a permission prompt, print, find: |kind|). Calling
+// preventDefault() takes it: the shell shows its UI and answers with
+// answerTabRequest(requestId, answerJson). Otherwise the browser's fallback
+// runs at once.
+//
+// "tabrequestend": a request this document took is over without its answer
+// (an agent answered it, the browser cancelled it, or its tab closed). Put
+// its UI away.
+[
+    Exposed=Window,
+    RuntimeEnabled=PlutoniumShell,
+    SecureContext
+] interface TabRequestEvent : Event {
+    readonly attribute long requestId;
+    readonly attribute long tabId;
+    // "fileChooser", "permission", "print", "find", ...
+    readonly attribute DOMString kind;
+    // The kind's details, a fresh object on every read (null for
+    // "tabrequestend").
+    [CallWith=ScriptState] readonly attribute any detail;
+};
