+#ifndef CHROME_BROWSER_PLUTONIUM_TAB_REQUESTS_H_
+#define CHROME_BROWSER_PLUTONIUM_TAB_REQUESTS_H_
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/plutonium_tabs.h"
+
+namespace content {
+class WebContents;
+}
+
+// EXO-TAB-FEATURES (docs/features/TAB_FEATURES.md, "The common shape"): what
+// a tab's page needs the user for, asked of a shell. A file chooser, a
+// permission prompt, print, find: each feature is a "kind" of request, with
+// its own details and answers (JSON), and its own fallback.
+//
+// The shell showing the tab (else the visible shell; ShellFor()) gets a
+// cancelable "tabrequest" event on navigator.windowBroker: {requestId, tabId,
+// kind, detail}. Calling preventDefault() takes it; the shell then shows its
+// UI and answers with answerTabRequest(requestId, answer). If no shell
+// listens, or none takes it, the fallback runs at once. If the shell that took
+// it goes away (it reloads, closes or crashes), the fallback runs then. A
+// request never hangs.
+//
+// While a request is open, the tab's state (PlutoniumTabs::SetTabState) has
+// "pending": {<kind>: {requestId, taken, detail}}, so every shell, the
+// switcher and agents see a tab that waits on the user. An agent can answer
+// one too (the DevTools Plutonium domain's answerTabRequest); each kind says
+// whether it accepts that (From::kAgent).
+//
+// When a request ends some other way (answered by an agent, cancelled by the
+// feature, or the tab closed), the shell that took it gets "tabrequestend"
+// {requestId, tabId, kind}, and puts its UI away.
+class PlutoniumTabRequests : public PlutoniumTabs::Observer {
+ public:
+  // Who answered.
+  enum class From { kShell, kAgent };
+  // Why the fallback runs.
+  enum class FallbackReason {
+    // No shell listens, or none took it.
+    kNotTaken,
+    // The shell that took it went away before answering.
+    kShellGone,
+  };
+
+  struct Params {
+    Params();
+    Params(Params&&);
+    Params& operator=(Params&&);
+    ~Params();
+
+    // "fileChooser", "permission", "print", "find", ... (lowerCamelCase).
+    std::string kind;
+    // What the shell gets as the event's detail, and agents and other
+    // shells see in the tab's pending state.
+    base::DictValue detail;
+    // |answer| (the JSON value the shell or agent gave). Return true to end
+    // the request; false if it isn't an answer this kind takes (from that
+    // answerer), and the request stays open.
+    base::RepeatingCallback<bool(From from, const base::Value& answer)>
+        on_answer;
+    // The request ended without an answer: run the fallback (Chrome's own
+    // UI, or cancel or dismiss), depending on the kind and the reason.
+    base::OnceCallback<void(FallbackReason reason)> on_fallback;
+  };
+
+  // An open request. Destroying it cancels the request if it is still open
+  // (the shell gets "tabrequestend"), and no callback runs after that.
+  class Handle {
+   public:
+    explicit Handle(int32_t id);
+    Handle(const Handle&) = delete;
+    Handle& operator=(const Handle&) = delete;
+    ~Handle();
+
+    int32_t id() const { return id_; }
+    // Whether the request is still open.
+    bool is_open() const;
+
+   private:
+    const int32_t id_;
+  };
+
+  static PlutoniumTabRequests* Get();
+
+  PlutoniumTabRequests(const PlutoniumTabRequests&) = delete;
+  PlutoniumTabRequests& operator=(const PlutoniumTabRequests&) = delete;
+
+  // Asks about tab |contents|. Null if |contents| isn't one of the registry's
+  // tabs: then nothing was sent and no callback will run. Callbacks never
+  // run from inside Start().
+  std::unique_ptr<Handle> Start(content::WebContents* contents,
+                                Params params);
+
+  // The shell page to ask about tab |contents|: the one whose <embed> shows
+  // it, else (a hidden or presented tab) the visible shell. Null if none.
+  static content::WebContents* ShellFor(content::WebContents* contents);
+
+  // The shell (|taker|, the broker connection that took it) or an agent
+  // (|taker| 0) answers request |id| with |answer_json|. False if there is no
+  // such open request, |taker| didn't take it, the JSON is invalid, or the
+  // kind refuses the answer.
+  bool Answer(int32_t id,
+              From from,
+              int32_t taker,
+              const std::string& answer_json);
+
+  // Broker connection |taker| went away: the requests it took fall back.
+  void OnShellGone(int32_t taker);
+
+  // PlutoniumTabs::Observer:
+  void OnTabRemoved(int32_t tab_id) override;
+
+  // The "test-request" command (with --plutonium-test-tab-requests): asks a
+  // request of kind "test" with |args| as its detail, and resolves once it
+  // ends: {"answeredBy": "shell" | "agent", "answer": ...} or {"fallback":
+  // "notTaken" | "shellGone"}.
+  static void RunTestRequest(content::WebContents* contents,
+                             const base::DictValue& args,
+                             PlutoniumTabs::CommandCallback done);
+
+ private:
+  friend class base::NoDestructor<PlutoniumTabRequests>;
+  friend class Handle;
+
+  struct Request {
+    Request();
+    ~Request();
+    int32_t id = 0;
+    int32_t tab_id = 0;
+    std::string kind;
+    base::DictValue detail;
+    base::RepeatingCallback<bool(From, const base::Value&)> on_answer;
+    base::OnceCallback<void(FallbackReason)> on_fallback;
+    // The broker connection that took it, or 0 (being asked).
+    int32_t taker = 0;
+    // In its on_answer: the answerer needs no "tabrequestend".
+    bool answering = false;
+  };
+
+  PlutoniumTabRequests();
+  ~PlutoniumTabRequests() override;
+
+  // The shell answered whether it takes request |id|.
+  void OnTaken(int32_t id, int32_t taker);
+  // Ends request |id|: tells its taker (|tell_taker|) and updates the
+  // tab's pending state. Returns it, or null if it wasn't open.
+  std::unique_ptr<Request> End(int32_t id, bool tell_taker);
+  // Ends request |id| and runs its fallback (later).
+  void FallBack(int32_t id, FallbackReason reason);
+  // Destroying a Handle.
+  void Cancel(int32_t id);
+  void UpdatePending(int32_t tab_id);
+
+  int32_t next_id_ = 1;
+  std::map<int32_t, std::unique_ptr<Request>> requests_;
+  base::ScopedObservation<PlutoniumTabs, PlutoniumTabs::Observer>
+      tabs_observation_{this};
+};
+
+#endif  // CHROME_BROWSER_PLUTONIUM_TAB_REQUESTS_H_
