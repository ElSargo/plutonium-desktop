+  // EXO-TAB-FEATURES:
+  void AddTabRequestObserver(
+      mojo::PendingAssociatedRemote<blink::mojom::TabRequestObserver> observer)
+      override {
+    if (!StillShell()) {
+      return;
+    }
+    // A new observer replaces the old one; what the old one took falls back.
+    if (tab_request_observer_.is_bound()) {
+      tab_request_observer_.reset();
+      if (asked_) {
+        PlutoniumTabRequests::Get()->OnShellGone(id_);
+      }
+    }
+    tab_request_observer_.Bind(std::move(observer));
+    // The page stopped listening: what it took falls back.
+    tab_request_observer_.set_disconnect_handler(base::BindOnce(
+        [](WindowBrokerImpl* self) {
+          self->tab_request_observer_.reset();
+          if (self->asked_) {
+            PlutoniumTabRequests::Get()->OnShellGone(self->id_);
+          }
+        },
+        base::Unretained(this)));
+  }
