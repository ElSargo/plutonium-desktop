From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sarol263@student.otago.ac.nz>
Date: Fri, 23 Oct 2026 09:01:03 +1300
Subject: [PATCH 35/89] Plutonium: tab features plumbing follow-ups

EXO-TAB-FEATURES:
- A feature's command that waits on the user (through a tab request)
  never ran its callback when the tab closed meanwhile, so the shell's
  tabCommand() or the agent's Plutonium.tabCommand waited forever.
  RunNamedCommand() now answers "ended unanswered" for a dropped
  callback.
- Tab::AttachHelpers() runs once the tab is registered and announced,
  so a helper can report its state (SetTabState()) right away.
---
 chrome/browser/plutonium_tabs.cc | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/plutonium_tabs.cc b/chrome/browser/plutonium_tabs.cc
index a694932588..9d14224d57 100644
--- a/chrome/browser/plutonium_tabs.cc
+++ b/chrome/browser/plutonium_tabs.cc
@@ -56,6 +56,7 @@
 #include "content/public/browser/web_contents.h"
 #include "content/public/browser/web_contents_delegate.h"
 #include "content/public/browser/web_contents_observer.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
 #include "media/base/video_frame.h"
 #include "media/capture/mojom/video_capture_buffer.mojom.h"
 #include "mojo/public/cpp/bindings/remote.h"
@@ -330,7 +331,6 @@ class PlutoniumTabs::Tab : public content::WebContentsDelegate,
     info_.opened_by = opened_by;
     if (owned_contents_) {
       contents_->SetDelegate(this);
-      AttachHelpers();
     }
     info_.content_id =
         surface_embed::SurfaceEmbedHandle::CreateForWebContents(contents_.get())
@@ -752,13 +752,16 @@ class PlutoniumTabs::Tab : public content::WebContentsDelegate,
     tabs_->TabChanged(this);
   }
 
- private:
   // EXO-TAB-FEATURES: the WebContents-only helpers Chrome's TabFeatures
   // would attach (chrome/browser/ui/tabs/tab_features.cc), for the features
   // in TAB_FEATURES.md. One line per feature; what a feature needs from the
   // delegate, Tab implements below, as BrowserWebContentsDelegate does.
+  // Called once the tab is registered (so a helper may SetTabState()), for
+  // the tab's own page only.
   void AttachHelpers() {}
 
+ private:
+
   // Keeps the tab's own (hidden) view in the shell's window tree while no
   // <embed> shows it (and, while presented, the presenter doesn't).
   void Park() {
@@ -1178,6 +1181,10 @@ void PlutoniumTabs::RunNamedCommand(
     const std::string& args_json,
     base::OnceCallback<void(bool, const std::string&)> done) {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // A feature that drops its CommandCallback (its tab closed while it
+  // waited on the user) still answers.
+  done = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      std::move(done), false, std::string("The command ended unanswered"));
   Tab* tab = FindTab(tab_id);
   if (!tab) {
     std::move(done).Run(false, "No such tab");
@@ -1358,6 +1365,10 @@ PlutoniumTabs::Tab* PlutoniumTabs::AddTab(
   for (Observer& observer : observers_) {
     observer.OnTabAdded(tab->info());
   }
+  // EXO-TAB-FEATURES: not DevTools' page.
+  if (!tab->borrowed()) {
+    tab->AttachHelpers();
+  }
   return tab;
 }
 
