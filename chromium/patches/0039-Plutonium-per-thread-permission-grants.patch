+std::optional<content::PermissionResult>
+PermissionContextBase::GetThreadDecision(
+    content::RenderFrameHost* render_frame_host,
+    const GURL& requesting_origin) const {
+  const ThreadDecisionCallback& callback = ThreadDecision();
+  if (!render_frame_host || callback.is_null()) {
+    return std::nullopt;
+  }
+  const std::optional<bool> granted =
+      callback.Run(render_frame_host, requesting_origin, content_settings_type_);
+  if (!granted) {
+    return std::nullopt;
+  }
+  const PermissionStatus status =
+      *granted ? PermissionStatus::GRANTED : PermissionStatus::DENIED;
+  const content_settings::PermissionSettingsInfo* info =
+      content_settings::PermissionSettingsRegistry::GetInstance()->Get(
+          content_settings_type_);
+  if (!info) {
+    return content::PermissionResult(status);
+  }
+  return content::PermissionResult(
+      status, content::PermissionStatusSource::UNSPECIFIED,
+      info->delegate().ToPermissionSetting(*granted ? CONTENT_SETTING_ALLOW
+                                                    : CONTENT_SETTING_BLOCK));
+}
