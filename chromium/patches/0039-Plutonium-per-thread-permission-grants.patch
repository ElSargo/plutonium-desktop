+// EXO-TAB-PERMISSIONS, "Grants and threads": the threads' decisions, in
+// local state: {thread: {origin: {permission: "allow" | "block"}}}.
+constexpr char kThreadsPref[] = "plutonium.thread_permissions";
+
+// A content setting's name: its request type's (TypeName()), or empty.
+std::string SettingName(ContentSettingsType type) {
+  std::optional<permissions::RequestType> request_type =
+      permissions::ContentSettingsTypeToRequestTypeIfExists(type);
+  return request_type ? TypeName(*request_type) : std::string();
+}
+
+// The content setting permission |name| is, if a thread or "everywhere" can
+// hold it: not file access or several downloads, whose decisions aren't
+// PermissionContextBase's.
+std::optional<ContentSettingsType> SettingType(const std::string& name) {
+  if (name == "automatic-downloads" || name == "file-write" ||
+      name == "file-read") {
+    return std::nullopt;
+  }
+  for (int i = 0; i <= static_cast<int>(permissions::RequestType::kMaxValue);
+       ++i) {
+    const auto request_type = static_cast<permissions::RequestType>(i);
+    if (TypeName(request_type) != name) {
+      continue;
+    }
+    std::optional<ContentSettingsType> type =
+        permissions::RequestTypeToContentSettingsType(request_type);
+    if (type &&
+        content_settings::PermissionSettingsRegistry::GetInstance()->Get(
+            *type)) {
+      return type;
+    }
+    return std::nullopt;
+  }
+  return std::nullopt;
+}
+
+// What |thread| decided about |permission| for |origin|: true (allow),
+// false (block) or nothing.
+std::optional<bool> GetThreadDecision(const std::string& thread,
+                                      const std::string& origin,
+                                      const std::string& permission) {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state || thread.empty()) {
+    return std::nullopt;
+  }
+  const base::DictValue* origins =
+      local_state->GetDict(kThreadsPref).FindDict(thread);
+  const base::DictValue* decisions =
+      origins ? origins->FindDict(origin) : nullptr;
+  const std::string* decision =
+      decisions ? decisions->FindString(permission) : nullptr;
+  if (!decision) {
+    return std::nullopt;
+  }
+  return *decision == "allow";
+}
+
+void SetThreadDecision(const std::string& thread,
+                       const std::string& origin,
+                       const std::string& permission,
+                       bool granted) {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state || thread.empty()) {
+    return;
+  }
+  base::DictValue threads = local_state->GetDict(kThreadsPref).Clone();
+  threads.EnsureDict(thread)->EnsureDict(origin)->Set(
+      permission, granted ? "allow" : "block");
+  local_state->SetDict(kThreadsPref, std::move(threads));
+}
+
+// Removes |thread|'s decisions for |origin| and |permission| (empty: any);
+// returns how many it removed.
+int RevokeThreadDecisions(const std::string& thread,
+                          const std::string& origin,
+                          const std::string& permission) {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state || thread.empty()) {
+    return 0;
+  }
+  base::DictValue threads = local_state->GetDict(kThreadsPref).Clone();
+  base::DictValue* origins = threads.FindDict(thread);
+  if (!origins) {
+    return 0;
+  }
+  int revoked = 0;
+  std::vector<std::string> emptied;
+  for (auto [key, value] : *origins) {
+    if ((!origin.empty() && key != origin) || !value.is_dict()) {
+      continue;
+    }
+    base::DictValue& decisions = value.GetDict();
+    if (permission.empty()) {
+      revoked += static_cast<int>(decisions.size());
+      decisions.clear();
+    } else if (decisions.Remove(permission)) {
+      ++revoked;
+    }
+    if (decisions.empty()) {
+      emptied.push_back(key);
+    }
+  }
+  for (const std::string& key : emptied) {
+    origins->Remove(key);
+  }
+  if (origins->empty()) {
+    threads.Remove(thread);
+  }
+  local_state->SetDict(kThreadsPref, std::move(threads));
+  return revoked;
+}
+
+// [{thread, origin, permission, decision, scope: "thread"}], for |thread|
+// and |origin| (empty: any).
+base::ListValue ListThreadDecisions(const std::string& thread,
+                                    const std::string& origin) {
+  base::ListValue list;
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state) {
+    return list;
+  }
+  for (const auto [thread_key, origins] : local_state->GetDict(kThreadsPref)) {
+    if ((!thread.empty() && thread_key != thread) || !origins.is_dict()) {
+      continue;
+    }
+    for (const auto [origin_key, decisions] : origins.GetDict()) {
+      if ((!origin.empty() && origin_key != origin) || !decisions.is_dict()) {
+        continue;
+      }
+      for (const auto [permission, decision] : decisions.GetDict()) {
+        if (!decision.is_string()) {
+          continue;
+        }
+        list.Append(base::DictValue()
+                        .Set("thread", thread_key)
+                        .Set("origin", origin_key)
+                        .Set("permission", permission)
+                        .Set("decision", decision.GetString())
+                        .Set("scope", "thread"));
+      }
+    }
+  }
+  return list;
+}
+
+// PermissionContextBase's thread decision: the tab's thread's, where
+// Chrome's own setting asks.
+std::optional<bool> ThreadDecisionFor(
+    content::RenderFrameHost* render_frame_host,
+    const GURL& requesting_origin,
+    ContentSettingsType type) {
+  content::WebContents* contents =
+      content::WebContents::FromRenderFrameHost(render_frame_host);
+  std::optional<PlutoniumTabs::TabInfo> tab =
+      contents ? PlutoniumTabs::Get()->GetTabFor(contents) : std::nullopt;
+  const std::string name = SettingName(type);
+  if (!tab || tab->tag.empty() || name.empty()) {
+    return std::nullopt;
+  }
+  return GetThreadDecision(
+      tab->tag, url::Origin::Create(requesting_origin).Serialize(), name);
+}
+
+// Sets Chrome's own setting (|granted|), or takes it back (nullopt).
+void SetEverywhere(content::BrowserContext* context,
+                   const url::Origin& origin,
+                   ContentSettingsType type,
+                   std::optional<bool> granted) {
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(context);
+  const content_settings::PermissionSettingsInfo* info =
+      content_settings::PermissionSettingsRegistry::GetInstance()->Get(type);
+  if (!map || !info) {
+    return;
+  }
+  std::optional<PermissionSetting> setting;
+  if (granted) {
+    setting = info->delegate().ToPermissionSetting(
+        *granted ? CONTENT_SETTING_ALLOW : CONTENT_SETTING_BLOCK);
+  }
+  const GURL url = origin.GetURL();
+  map->SetPermissionSettingDefaultScope(url, url, type, setting);
+}
+
+const char* AnswerName(Answer answer) {
+  switch (answer) {
+    case Answer::kAllow:
+      return "allow";
+    case Answer::kDeny:
+      return "deny";
+    case Answer::kDismiss:
+      return "dismiss";
+  }
+  return "dismiss";
+}
