+  // An installed shell (~/.pluto/shells/<name>): customizing it, and its
+  // server if Plutonium runs one.
+  void BuildPackageSections(const base::DictValue& package) {
+    auto text = [](const base::DictValue& dict, const char* key) {
+      const std::string* value = dict.FindString(key);
+      return value ? *value : std::string();
+    };
+    const std::string name = text(package, "name");
+    const std::string kind = text(package, "kind");
+    auto* customize = AddSection(u"Customize");
+    AddParagraph(customize,
+                 u"Its files are yours to change. An agent can do it for you, "
+                 u"in the shell's folder. Every save reloads the shell and is "
+                 u"committed; a change that breaks it is rolled back to the "
+                 u"last version that worked.",
+                 kDim);
+    auto* buttons = AddButtons(customize);
+    AddButton(buttons, u"Ask an agent",
+              Bind(&PlutoniumOverlayView::PackageAction, name,
+                   std::string("agent")),
+              ActionButton::Style::kPrimary);
+    AddButton(buttons, u"Open a terminal",
+              Bind(&PlutoniumOverlayView::PackageAction, name,
+                   std::string("terminal")));
+    AddButton(buttons, u"History, log and updates…",
+              Bind(&PlutoniumOverlayView::OpenPackagePage, name));
+    if (const std::string notice = text(package, "notice"); !notice.empty()) {
+      AddParagraph(customize, base::UTF8ToUTF16(notice), kWarn);
+    }
+    AddField(customize, u"Folder", base::UTF8ToUTF16(text(package, "dir")));
+    AddField(customize, u"Version",
+             base::UTF8ToUTF16(text(package, "version") +
+                               (text(package, "commit").empty()
+                                    ? std::string()
+                                    : "  (" + text(package, "commit") + ")")));
+    const base::DictValue* server = package.FindDict("server");
+    if (kind != "plutonium" || !server) {
+      return;
+    }
+    auto* section = AddSection(u"Its server");
+    const std::string state = text(*server, "state");
+    AddField(section, u"State", base::UTF8ToUTF16(text(*server, "detail")));
+    AddField(section, u"Command", base::UTF8ToUTF16(text(*server, "command")));
+    AddField(section, u"Log", base::UTF8ToUTF16(text(*server, "log")));
+    auto* controls = AddButtons(section);
+    const bool stopped = state == "stopped" || state == "failed";
+    AddButton(controls, stopped ? u"Start" : u"Restart",
+              Bind(&PlutoniumOverlayView::PackageAction, name,
+                   std::string(stopped ? "start" : "restart")));
+    AddButton(controls, u"Stop",
+              Bind(&PlutoniumOverlayView::PackageAction, name,
+                   std::string("stop")),
+              ActionButton::Style::kNormal, !stopped);
+  }
+
+  // POST /v1/shells/<name>/<action>: agent and terminal open a tab of the
+  // backup terminal in the shell's folder.
+  void PackageAction(const std::string& name, const std::string& action) {
+    SetStatus(action == "agent"      ? u"Starting an agent…"
+              : action == "terminal" ? u"Opening a terminal…"
+                                     : u"Asking the helper…",
+              /*error=*/false);
+    plutonium_helper::Post(
+        "/v1/shells/" + name + "/" + action, base::DictValue(),
+        base::BindOnce(&PlutoniumOverlayView::OnPackageAction,
+                       weak_ptr_factory_.GetWeakPtr(), action));
+  }
+
+  void OnPackageAction(const std::string& action,
+                       std::optional<base::Value> value,
+                       const std::string& error) {
+    if (!value) {
+      SetStatus(base::UTF8ToUTF16(error));
+      return;
+    }
+    if (action == "agent" || action == "terminal") {
+      OpenBackup(PlutoniumShells::Backup::kTerminal);
+      return;
+    }
+    SetStatus(u"Done.", /*error=*/false);
+    LoadPackages();
+  }
+
+  // The helper's page for installed shells (history, log, updates, adding
+  // one), in the backup browser.
+  void OpenPackagePage(const std::string& name) {
+    const std::u16string helper = HelperUrl();
+    if (helper.empty() ||
+        !shells_->OpenBackup(
+            PlutoniumShells::Backup::kBrowser,
+            GURL(base::UTF16ToUTF8(helper) + "/v1/shells/page/#" +
+                 (name.empty() ? std::string("add") : name)))) {
+      SetStatus(u"Couldn't open the helper's page for shells.");
+      return;
+    }
+    overlay_->Close(/*acted=*/true);
+  }
