+// static
+bool PlutoniumTabs::MaybeOpenFromShell(
+    NavigateParams* params,
+    base::WeakPtr<content::NavigationHandle>* handle) {
+  content::WebContents* source = params->source_contents;
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  if (!source || !shells) {
+    return false;
+  }
+  switch (params->disposition) {
+    case WindowOpenDisposition::NEW_FOREGROUND_TAB:
+    case WindowOpenDisposition::NEW_BACKGROUND_TAB:
+    case WindowOpenDisposition::NEW_POPUP:
+    case WindowOpenDisposition::NEW_WINDOW:
+    case WindowOpenDisposition::SINGLETON_TAB:
+      break;
+    default:
+      return false;
+  }
+  // Only the shells' own pages; their tabs handle this themselves (Tab).
+  std::optional<PlutoniumShells::Shell> shell = shells->GetShellFor(source);
+  if (!shell || Get()->IsTab(source)) {
+    return false;
+  }
+  const bool inserted = !!params->contents_to_insert;
+  std::unique_ptr<content::WebContents> contents =
+      std::move(params->contents_to_insert);
+  if (!contents) {
+    if (!params->url.is_valid()) {
+      return false;
+    }
+    content::WebContents::CreateParams create(source->GetBrowserContext());
+    create.initially_hidden = true;
+    contents = content::WebContents::Create(create);
+  }
+  if (contents->GetContainerBounds().IsEmpty()) {
+    contents->Resize(gfx::Rect(kDefaultTabSize));
+  }
+  Tab* tab = Get()->AddTab(std::move(contents), std::string(), {}, 0,
+                           "shell:" + shell->id);
+  VLOG(1) << "EXO-TABS tab #" << tab->info().id << " for "
+          << params->url.possibly_invalid_spec() << " from shell "
+          << shell->id << " (disposition "
+          << static_cast<int>(params->disposition) << ")";
+  if (!inserted) {
+    content::NavigationController::LoadURLParams load =
+        LoadURLParamsFromNavigateParams(params);
+    *handle = tab->contents()->GetController().LoadURLWithParams(load);
+  }
+  tab->Refresh();
+  params->navigated_or_inserted_contents = tab->contents();
+  return true;
+}
