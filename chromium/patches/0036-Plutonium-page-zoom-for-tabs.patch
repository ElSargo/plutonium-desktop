diff --git a/chrome/browser/plutonium_zoom.cc b/chrome/browser/plutonium_zoom.cc
new file mode 100644
index 0000000000..1558cd361b
--- /dev/null
+++ b/chrome/browser/plutonium_zoom.cc
@@ -0,0 +1,139 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/plutonium_zoom.h"
+
+#include <algorithm>
+#include <cmath>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/plutonium_tabs.h"
+#include "components/zoom/page_zoom.h"
+#include "components/zoom/zoom_controller.h"
+#include "components/zoom/zoom_observer.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "content/public/common/page_zoom.h"
+#include "third_party/blink/public/common/page/page_zoom.h"
+
+namespace plutonium_zoom {
+
+namespace {
+
+// Chrome's zoom menu's range.
+constexpr int kMinPercent = 25;
+constexpr int kMaxPercent = 500;
+
+// Reports the tab's zoom to the registry (its state).
+class ZoomReporter : public content::WebContentsUserData<ZoomReporter>,
+                     public zoom::ZoomObserver {
+ public:
+  ZoomReporter(const ZoomReporter&) = delete;
+  ZoomReporter& operator=(const ZoomReporter&) = delete;
+  ~ZoomReporter() override = default;
+
+  void Report() {
+    zoom::ZoomController* controller =
+        zoom::ZoomController::FromWebContents(&GetWebContents());
+    if (!controller) {
+      return;
+    }
+    PlutoniumTabs* tabs = PlutoniumTabs::Get();
+    tabs->SetTabState(&GetWebContents(), "zoom",
+                      base::Value(controller->GetZoomPercent()));
+    tabs->SetTabState(&GetWebContents(), "zoomDefault",
+                      base::Value(controller->IsAtDefaultZoom()));
+  }
+
+  // zoom::ZoomObserver:
+  void OnZoomControllerDestroyed(
+      zoom::ZoomController* zoom_controller) override {
+    observation_.Reset();
+  }
+  void OnZoomChanged(
+      const zoom::ZoomController::ZoomChangedEventData& data) override {
+    Report();
+  }
+
+ private:
+  friend class content::WebContentsUserData<ZoomReporter>;
+
+  explicit ZoomReporter(content::WebContents* contents)
+      : content::WebContentsUserData<ZoomReporter>(*contents) {
+    if (zoom::ZoomController* controller =
+            zoom::ZoomController::FromWebContents(contents)) {
+      observation_.Observe(controller);
+    }
+  }
+
+  base::ScopedObservation<zoom::ZoomController, zoom::ZoomObserver>
+      observation_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ZoomReporter);
+
+void AddZoomCommand(PlutoniumTabs* tabs,
+                    const char* name,
+                    content::PageZoom how) {
+  tabs->AddCommand(
+      name, base::BindRepeating(
+                [](content::PageZoom how, content::WebContents* contents,
+                   const base::DictValue& args,
+                   PlutoniumTabs::CommandCallback done) {
+                  zoom::PageZoom::Zoom(contents, how);
+                  zoom::ZoomController* controller =
+                      zoom::ZoomController::FromWebContents(contents);
+                  std::move(done).Run(
+                      controller ? base::Value(controller->GetZoomPercent())
+                                 : base::Value());
+                },
+                how));
+}
+
+}  // namespace
+
+void AttachHelpers(content::WebContents* contents) {
+  zoom::ZoomController::CreateForWebContents(contents);
+  ZoomReporter::CreateForWebContents(contents);
+  ZoomReporter::FromWebContents(contents)->Report();
+}
+
+void AddCommands(PlutoniumTabs* tabs) {
+  AddZoomCommand(tabs, "zoom-in", content::PAGE_ZOOM_IN);
+  AddZoomCommand(tabs, "zoom-out", content::PAGE_ZOOM_OUT);
+  AddZoomCommand(tabs, "zoom-reset", content::PAGE_ZOOM_RESET);
+  // {percent}: the site's level (as Chrome's zoom menu sets it).
+  tabs->AddCommand(
+      "zoom-set",
+      base::BindRepeating([](content::WebContents* contents,
+                             const base::DictValue& args,
+                             PlutoniumTabs::CommandCallback done) {
+        zoom::ZoomController* controller =
+            zoom::ZoomController::FromWebContents(contents);
+        std::optional<double> percent = args.FindDouble("percent");
+        if (!controller || !percent || !std::isfinite(*percent)) {
+          std::move(done).Run(std::nullopt);
+          return;
+        }
+        const double clamped = std::clamp<double>(*percent, kMinPercent,
+                                                  kMaxPercent);
+        controller->SetZoomLevel(
+            blink::ZoomFactorToZoomLevel(clamped / 100.0));
+        std::move(done).Run(base::Value(controller->GetZoomPercent()));
+      }));
+}
+
+void ZoomChange(content::WebContents* contents, bool zoom_in) {
+  zoom::PageZoom::Zoom(contents, zoom_in ? content::PAGE_ZOOM_IN
+                                         : content::PAGE_ZOOM_OUT);
+}
+
+}  // namespace plutonium_zoom
diff --git a/chrome/browser/plutonium_zoom.h b/chrome/browser/plutonium_zoom.h
new file mode 100644
index 0000000000..c946cbfdac
--- /dev/null
+++ b/chrome/browser/plutonium_zoom.h
@@ -0,0 +1,34 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PLUTONIUM_ZOOM_H_
+#define CHROME_BROWSER_PLUTONIUM_ZOOM_H_
+
+class PlutoniumTabs;
+
+namespace content {
+class WebContents;
+}
+
+// EXO-TAB-FEATURES (docs/features/TAB_FEATURES.md, "Zoom"): page zoom for
+// the registry's tabs, as Chrome's. Levels are Chrome's per-site ones in the
+// profile (HostZoomMap), so every thread shares them.
+//
+// The tab's state has "zoom" (the percent) and "zoomDefault" (whether it is
+// at the default level). Commands: "zoom-in", "zoom-out", "zoom-reset" (also
+// Ctrl+plus, Ctrl+minus, Ctrl+0 and Ctrl+wheel) and "zoom-set" {percent}.
+namespace plutonium_zoom {
+
+// Tab::AttachHelpers(): Chrome's ZoomController, and the state it reports.
+void AttachHelpers(content::WebContents* contents);
+
+// The commands, in PlutoniumTabs' constructor.
+void AddCommands(PlutoniumTabs* tabs);
+
+// WebContentsDelegate::ContentsZoomChange() (Ctrl+wheel).
+void ZoomChange(content::WebContents* contents, bool zoom_in);
+
+}  // namespace plutonium_zoom
+
+#endif  // CHROME_BROWSER_PLUTONIUM_ZOOM_H_
