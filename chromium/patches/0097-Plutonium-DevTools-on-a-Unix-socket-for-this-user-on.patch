+// Plutonium: --plutonium-remote-debugging-socket=<path> serves DevTools on a
+// Unix socket at <path> instead of a TCP port, as Chrome on Android does. A
+// port on 127.0.0.1 can be reached by every process on the machine (other
+// users, sandboxed apps that share the network), and DevTools has no
+// authentication of its own; the socket takes only this user's processes
+// (SO_PEERCRED), and its directory can be private as well.
+constexpr char kPlutoniumRemoteDebuggingSocketSwitch[] =
+    "plutonium-remote-debugging-socket";
+
+bool IsSameUser(const net::UnixDomainServerSocket::Credentials& credentials) {
+  return credentials.user_id == geteuid();
+}
+
+class PlutoniumUnixSocketFactory : public content::DevToolsSocketFactory {
+ public:
+  explicit PlutoniumUnixSocketFactory(std::string path)
+      : path_(std::move(path)) {}
+
+  PlutoniumUnixSocketFactory(const PlutoniumUnixSocketFactory&) = delete;
+  PlutoniumUnixSocketFactory& operator=(const PlutoniumUnixSocketFactory&) =
+      delete;
+
+ private:
+  // content::DevToolsSocketFactory.
+  std::unique_ptr<net::ServerSocket> CreateForHttpServer() override {
+    // A socket left by a browser that crashed would make the bind fail.
+    unlink(path_.c_str());
+    auto socket = std::make_unique<net::UnixDomainServerSocket>(
+        base::BindRepeating(&IsSameUser), /*use_abstract_namespace=*/false);
+    if (socket->BindAndListen(path_, kBackLog) != net::OK) {
+      LOG(ERROR) << "Plutonium: couldn't listen for DevTools on " << path_;
+      return nullptr;
+    }
+    return socket;
+  }
+
+  std::unique_ptr<net::ServerSocket> CreateForTethering(
+      std::string* name) override {
+    return nullptr;
+  }
+
+  const std::string path_;
+};
+
 // Returns true, or a reason why remote debugging is not allowed.
 base::expected<bool, RemoteDebuggingServer::NotStartedReason>
 IsRemoteDebuggingAllowed(const std::optional<bool>& is_default_user_data_dir,
@@ -360,6 +408,22 @@ RemoteDebuggingServer::GetInstance(PrefService* local_state) {
     server->StartPipeHandler();
   }
 
+  if (command_line.HasSwitch(kPlutoniumRemoteDebuggingSocketSwitch)) {
+    if (const auto maybe_allow_debugging =
+            IsRemoteDebuggingAllowed(is_default_user_data_dir, local_state);
+        !maybe_allow_debugging.has_value()) {
+      return base::unexpected(maybe_allow_debugging.error());
+    }
+    debugging_server_started = true;
+    server->StartHttpServer(
+        std::make_unique<PlutoniumUnixSocketFactory>(
+            command_line.GetSwitchValueASCII(
+                kPlutoniumRemoteDebuggingSocketSwitch)),
+        /*output_dir=*/base::FilePath(), /*debug_frontend_dir=*/base::FilePath(),
+        content::DevToolsAgentHost::RemoteDebuggingServerMode::kDefault);
+    return server;
+  }
+
   std::string port_str =
       command_line.GetSwitchValueASCII(::switches::kRemoteDebuggingPort);
   if (auto port = ParsePort(port_str)) {
