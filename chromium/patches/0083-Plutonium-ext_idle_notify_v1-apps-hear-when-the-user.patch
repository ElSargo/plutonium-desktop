diff --git a/components/exo/wayland/ext_idle_notify.cc b/components/exo/wayland/ext_idle_notify.cc
new file mode 100644
index 0000000000..5f5c5d7375
--- /dev/null
+++ b/components/exo/wayland/ext_idle_notify.cc
@@ -0,0 +1,185 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/exo/wayland/ext_idle_notify.h"
+
+#include <ext-idle-notify-v1-server-protocol.h>
+#include <wayland-server-core.h>
+#include <wayland-server-protocol-core.h>
+
+#include <algorithm>
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/exo/session_idle.h"
+#include "components/exo/wayland/server_util.h"
+#include "ui/base/user_activity/user_activity_detector.h"
+#include "ui/base/user_activity/user_activity_observer.h"
+
+namespace exo {
+namespace wayland {
+
+namespace {
+
+////////////////////////////////////////////////////////////////////////////////
+// ext_idle_notification_v1 interface:
+
+// Idle once there's been no activity for |timeout| since it was made or the
+// user last did something, and (if it obeys inhibitors) since the last
+// inhibitor went. As wlroots does, an inhibitor that comes while it's idle
+// leaves it idle; only activity resumes it.
+class IdleNotification : public ui::UserActivityObserver,
+                         public SessionIdle::Observer {
+ public:
+  IdleNotification(wl_resource* resource,
+                   base::TimeDelta timeout,
+                   bool obey_inhibitors)
+      : resource_(resource),
+        timeout_(timeout),
+        obey_inhibitors_(obey_inhibitors),
+        since_(base::TimeTicks::Now()) {
+    if (ui::UserActivityDetector* detector = ui::UserActivityDetector::Get()) {
+      detector->AddObserver(this);
+    }
+    SessionIdle::Get()->AddObserver(this);
+    Update();
+  }
+  IdleNotification(const IdleNotification&) = delete;
+  IdleNotification& operator=(const IdleNotification&) = delete;
+  ~IdleNotification() override {
+    SessionIdle::Get()->RemoveObserver(this);
+    if (ui::UserActivityDetector* detector = ui::UserActivityDetector::Get()) {
+      detector->RemoveObserver(this);
+    }
+  }
+
+  // ui::UserActivityObserver:
+  void OnUserActivity(const ui::Event* event) override {
+    since_ = base::TimeTicks::Now();
+    if (idle_) {
+      idle_ = false;
+      ext_idle_notification_v1_send_resumed(resource_);
+      wl_client_flush(wl_resource_get_client(resource_));
+    }
+    Update();
+  }
+
+  // SessionIdle::Observer:
+  void OnIdleInhibitedChanged(bool inhibited) override {
+    if (!obey_inhibitors_) {
+      return;
+    }
+    if (!inhibited) {
+      since_ = base::TimeTicks::Now();
+    }
+    Update();
+  }
+
+ private:
+  // Goes idle if it's time, else waits until it might be. The detector
+  // notifies observers at most every 200 ms, so its last activity time is
+  // looked at too.
+  void Update() {
+    timer_.Stop();
+    if (idle_ || (obey_inhibitors_ && SessionIdle::Get()->inhibited())) {
+      return;
+    }
+    base::TimeTicks last = since_;
+    if (ui::UserActivityDetector* detector = ui::UserActivityDetector::Get()) {
+      last = std::max(last, detector->last_activity_time());
+    }
+    base::TimeDelta left = last + timeout_ - base::TimeTicks::Now();
+    if (left.is_positive()) {
+      timer_.Start(FROM_HERE, left,
+                   base::BindOnce(&IdleNotification::Update,
+                                  base::Unretained(this)));
+      return;
+    }
+    idle_ = true;
+    ext_idle_notification_v1_send_idled(resource_);
+    wl_client_flush(wl_resource_get_client(resource_));
+  }
+
+  const raw_ptr<wl_resource> resource_;
+  const base::TimeDelta timeout_;
+  const bool obey_inhibitors_;
+  base::TimeTicks since_;
+  bool idle_ = false;
+  base::OneShotTimer timer_;
+};
+
+void idle_notification_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct ext_idle_notification_v1_interface
+    idle_notification_implementation = {idle_notification_destroy};
+
+////////////////////////////////////////////////////////////////////////////////
+// ext_idle_notifier_v1 interface:
+
+void CreateNotification(wl_client* client,
+                        wl_resource* resource,
+                        uint32_t id,
+                        uint32_t timeout,
+                        bool obey_inhibitors) {
+  wl_resource* notification_resource =
+      wl_resource_create(client, &ext_idle_notification_v1_interface,
+                         wl_resource_get_version(resource), id);
+  if (!notification_resource) {
+    wl_client_post_no_memory(client);
+    return;
+  }
+  // Exo has one seat, so the seat isn't looked at.
+  SetImplementation(notification_resource, &idle_notification_implementation,
+                    std::make_unique<IdleNotification>(
+                        notification_resource, base::Milliseconds(timeout),
+                        obey_inhibitors));
+}
+
+void idle_notifier_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void idle_notifier_get_idle_notification(wl_client* client,
+                                         wl_resource* resource,
+                                         uint32_t id,
+                                         uint32_t timeout,
+                                         wl_resource* seat) {
+  CreateNotification(client, resource, id, timeout, /*obey_inhibitors=*/true);
+}
+
+void idle_notifier_get_input_idle_notification(wl_client* client,
+                                               wl_resource* resource,
+                                               uint32_t id,
+                                               uint32_t timeout,
+                                               wl_resource* seat) {
+  CreateNotification(client, resource, id, timeout, /*obey_inhibitors=*/false);
+}
+
+constexpr struct ext_idle_notifier_v1_interface idle_notifier_implementation =
+    {idle_notifier_destroy, idle_notifier_get_idle_notification,
+     idle_notifier_get_input_idle_notification};
+
+}  // namespace
+
+void bind_idle_notifier(wl_client* client,
+                        void* data,
+                        uint32_t version,
+                        uint32_t id) {
+  wl_resource* resource = wl_resource_create(
+      client, &ext_idle_notifier_v1_interface, std::min(version, 2u), id);
+  if (!resource) {
+    wl_client_post_no_memory(client);
+    return;
+  }
+  wl_resource_set_implementation(resource, &idle_notifier_implementation,
+                                 data, nullptr);
+}
+
+}  // namespace wayland
+}  // namespace exo
