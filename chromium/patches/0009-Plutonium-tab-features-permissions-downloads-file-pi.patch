+
+using From = PlutoniumTabRequests::From;
+using FallbackReason = PlutoniumTabRequests::FallbackReason;
+
+// The fallback: Chrome's tab-modal print preview, which needs somewhere to
+// show (HasWebContentsModalDialogHost() in print_preview_dialog_controller.cc).
+// A tab's dialogs show over the window of the shell that would be asked about
+// it.
+class ShellDialogHost : public web_modal::WebContentsModalDialogManagerDelegate {
+ public:
+  static ShellDialogHost* Get() {
+    static base::NoDestructor<ShellDialogHost> instance;
+    return instance.get();
+  }
+
+  web_modal::WebContentsModalDialogHost* GetWebContentsModalDialogHost(
+      content::WebContents* contents) override {
+    content::WebContents* shell = PlutoniumTabRequests::ShellFor(contents);
+    if (!shell) {
+      return nullptr;
+    }
+    BrowserWindowInterface* browser =
+        GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(shell);
+    return browser ? browser->GetWebContentsModalDialogHostForWindow()
+                   : nullptr;
+  }
+
+  // A tab no <embed> shows is hidden: its dialog waits until one does, as a
+  // background tab's does in Chrome.
+  bool IsWebContentsVisible(content::WebContents* contents) override {
+    return contents->GetVisibility() != content::Visibility::HIDDEN;
+  }
+};
+
+// A tab's print request: from PrintViewManager's preview to the shell's
+// answer.
+class TabPrint : public content::WebContentsObserver,
+                 public content::WebContentsUserData<TabPrint> {
+ public:
+  ~TabPrint() override = default;
+
+  // Asks the shell about |initiator|'s print preview (|initiator| is the tab,
+  // or a page inside it, such as a PDF viewer). False to show Chrome's.
+  static bool ShowPreview(content::WebContents* initiator,
+                          content::RenderFrameHost* rfh,
+                          const printing::mojom::RequestPrintPreviewParams& params,
+                          bool is_pdf,
+                          bool scripted) {
+    content::WebContents* tab =
+        guest_view::GuestViewBase::GetTopLevelWebContents(initiator);
+    TabPrint* print = tab ? FromWebContents(tab) : nullptr;
+    return print && print->Start(initiator, rfh, params, is_pdf, scripted);
+  }
+
+  // The frame to print to PDF: the one that asked, while a request is open.
+  // Its renderer can't print while it is in a print preview (it stops
+  // responding), so the first PDF ends the preview there: the page gets
+  // "afterprint" and window.print() returns, while the request stays open
+  // until it is answered.
+  content::RenderFrameHost* FrameToPrint() {
+    content::RenderFrameHost* rfh =
+        request_ && request_->is_open()
+            ? content::RenderFrameHost::FromID(frame_)
+            : nullptr;
+    if (rfh && !page_released_) {
+      page_released_ = true;
+      EndPreview();
+    }
+    return rfh;
+  }
+
+  // content::WebContentsObserver:
+  void RenderFrameDeleted(content::RenderFrameHost* rfh) override {
+    // PrintViewManager ends its preview; so does the shell.
+    if (request_ && rfh->GetGlobalId() == frame_) {
+      request_.reset();
+    }
+  }
+
+ private:
+  friend class content::WebContentsUserData<TabPrint>;
+
+  explicit TabPrint(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<TabPrint>(*contents) {}
+
+  bool Start(content::WebContents* initiator,
+             content::RenderFrameHost* rfh,
+             const printing::mojom::RequestPrintPreviewParams& params,
+             bool is_pdf,
+             bool scripted) {
+    // PrintViewManager allows one preview at a time; a new one replaces an
+    // old request.
+    request_.reset();
+    weak_factory_.InvalidateWeakPtrs();
+    page_released_ = false;
+    initiator_ = initiator->GetWeakPtr();
+    frame_ = rfh->GetGlobalId();
+    params_ = params.Clone();
+    is_pdf_ = is_pdf;
+
+    std::optional<PlutoniumTabs::TabInfo> info =
+        PlutoniumTabs::Get()->GetTabFor(web_contents());
+    PlutoniumTabRequests::Params request;
+    request.kind = "print";
+    request.detail =
+        base::DictValue()
+            .Set("title", base::UTF16ToUTF8(web_contents()->GetTitle()))
+            .Set("url", web_contents()->GetLastCommittedURL().spec())
+            .Set("thread", info ? info->tag : std::string())
+            .Set("hasSelection", params.has_selection)
+            .Set("scripted", scripted)
+            .Set("pdf", is_pdf);
+    request.on_answer = base::BindRepeating(
+        [](base::WeakPtr<TabPrint> print, From from,
+           const base::Value& answer) {
+          return print && print->OnAnswer(from, answer);
+        },
+        weak_factory_.GetWeakPtr());
+    request.on_fallback = base::BindOnce(&TabPrint::OnFallback,
+                                         weak_factory_.GetWeakPtr());
+    request_ = PlutoniumTabRequests::Get()->Start(web_contents(),
+                                                  std::move(request));
+    return !!request_;
+  }
+
+  // "done" (printed or saved) or "cancel", from the shell or an agent:
+  // agents may print like any other program (TAB_FEATURES.md, Decision 8).
+  bool OnAnswer(From from, const base::Value& answer) {
+    const std::string* text = answer.GetIfString();
+    if (!text || (*text != "done" && *text != "cancel")) {
+      return false;
+    }
+    // Not from inside the answer.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&TabPrint::Finish, weak_factory_.GetWeakPtr()));
+    return true;
+  }
+
+  void OnFallback(FallbackReason reason) {
+    content::WebContents* initiator = initiator_.get();
+    if (!initiator) {
+      return;
+    }
+    // The shell that took it went away: printing is cancelled, and
+    // window.print() returns.
+    if (reason == FallbackReason::kShellGone) {
+      Finish();
+      return;
+    }
+    // No shell takes it: Chrome's preview, over the shell's window. It ends
+    // the preview itself if it can't show.
+    auto* controller = printing::PrintPreviewDialogController::GetInstance();
+    if (!controller) {
+      Finish();
+      return;
+    }
+    controller->PrintPreview(initiator, *params_, is_pdf_);
+  }
+
+  // Ends the preview: the page gets "afterprint" and window.print()
+  // returns.
+  void Finish() {
+    request_.reset();
+    if (!page_released_) {
+      page_released_ = true;
+      EndPreview();
+    }
+  }
+
+  void EndPreview() {
+    content::WebContents* initiator = initiator_.get();
+    if (!initiator) {
+      return;
+    }
+    if (auto* manager =
+            printing::PrintViewManager::FromWebContents(initiator)) {
+      manager->PrintPreviewDone();
+    }
+  }
+
+  std::unique_ptr<PlutoniumTabRequests::Handle> request_;
+  base::WeakPtr<content::WebContents> initiator_;
+  content::GlobalRenderFrameHostId frame_;
+  printing::mojom::RequestPrintPreviewParamsPtr params_;
+  bool is_pdf_ = false;
+  // EndPreview() ran for this request.
+  bool page_released_ = false;
+  base::WeakPtrFactory<TabPrint> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabPrint);
+
+std::optional<std::string> FindString(const base::DictValue& args,
+                                      const char* key) {
+  const std::string* value = args.FindString(key);
+  return value ? std::optional<std::string>(*value) : std::nullopt;
+}
+
+}  // namespace
+
+void AttachHelpers(content::WebContents* contents) {
+  static bool hooked = false;
+  if (!hooked) {
+    hooked = true;
+    printing::PrintViewManager::SetPreviewOverride(
+        base::BindRepeating(&TabPrint::ShowPreview));
+  }
+  printing::InitializePrintingForWebContents(contents);
+  TabPrint::CreateForWebContents(contents);
+  web_modal::WebContentsModalDialogManager::CreateForWebContents(contents);
+  web_modal::WebContentsModalDialogManager::FromWebContents(contents)
+      ->SetDelegate(ShellDialogHost::Get());
+}
+
+void RunPrintCommand(content::WebContents* contents,
+                     const base::DictValue& args,
+                     PlutoniumTabs::CommandCallback done) {
+  // As Chrome's Print command (chrome::Print()): the preview, which is the
+  // shell's request.
+  const bool started = printing::StartPrint(contents,
+                                            mojo::NullAssociatedRemote(),
+                                            /*print_preview_disabled=*/false,
+                                            /*has_selection=*/false);
+  std::move(done).Run(base::Value(started));
+}
+
+void RunPrintToPdfCommand(content::WebContents* contents,
+                          const base::DictValue& args,
+                          PlutoniumTabs::CommandCallback done) {
+  content::RenderFrameHost* rfh = nullptr;
+  if (TabPrint* print = TabPrint::FromWebContents(contents)) {
+    rfh = print->FrameToPrint();
+  }
+  if (!rfh) {
+    rfh = printing::GetFullPagePlugin(contents);
+  }
+  if (!rfh) {
+    rfh = contents->GetPrimaryMainFrame();
+  }
+  auto* manager = printing::PrintViewManager::FromWebContents(
+      content::WebContents::FromRenderFrameHost(rfh));
+  if (!manager || !rfh->IsRenderFrameLive()) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  // Not while Chrome's preview is open: the renderer would stop responding
+  // (FrameToPrint()).
+  if (manager->print_preview_rfh()) {
+    LOG(WARNING) << "EXO-TAB-FEATURES print-to-pdf: Chrome's print preview "
+                    "is open";
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  std::variant<printing::mojom::PrintPagesParamsPtr, std::string> params =
+      print_to_pdf::GetPrintPagesParams(
+          rfh->GetLastCommittedURL(), args.FindBool("landscape"),
+          args.FindBool("displayHeaderFooter"),
+          args.FindBool("printBackground"), args.FindDouble("scale"),
+          args.FindDouble("paperWidth"), args.FindDouble("paperHeight"),
+          args.FindDouble("marginTop"), args.FindDouble("marginBottom"),
+          args.FindDouble("marginLeft"), args.FindDouble("marginRight"),
+          FindString(args, "headerTemplate"),
+          FindString(args, "footerTemplate"),
+          args.FindBool("preferCSSPageSize"),
+          /*generate_tagged_pdf=*/std::nullopt,
+          /*generate_document_outline=*/std::nullopt);
+  if (std::holds_alternative<std::string>(params)) {
+    LOG(WARNING) << "EXO-TAB-FEATURES print-to-pdf: "
+                 << std::get<std::string>(params);
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  manager->PrintToPdf(
+      rfh, FindString(args, "pageRanges").value_or(""),
+      std::move(std::get<printing::mojom::PrintPagesParamsPtr>(params)),
+      base::BindOnce(
+          [](PlutoniumTabs::CommandCallback done,
+             print_to_pdf::PdfPrintResult result,
+             scoped_refptr<base::RefCountedMemory> data) {
+            if (result != print_to_pdf::PdfPrintResult::kPrintSuccess ||
+                !data) {
+              LOG(WARNING) << "EXO-TAB-FEATURES print-to-pdf: "
+                           << print_to_pdf::PdfPrintResultToString(result);
+              std::move(done).Run(std::nullopt);
+              return;
+            }
+            std::move(done).Run(base::Value(base::DictValue().Set(
+                "data", base::Base64Encode(base::span<const uint8_t>(*data)))));
+          },
+          std::move(done)));
+}
+
+}  // namespace plutonium_print
