+using blink::mojom::ContextMenuItemType;
+
+// Whether a shell page's (|tab| false) or a tab's menu keeps command |id|.
+bool Keeps(int id, bool tab) {
+  // The page's own items (<menu>, plugins).
+  if (RenderViewContextMenuBase::IsContentCustomCommandId(id)) {
+    return true;
+  }
+  // Spelling suggestions, then the spell-check languages (their last ids
+  // are RenderViewContextMenu's own).
+  if (id >= IDC_SPELLCHECK_SUGGESTION_0 &&
+      id < IDC_CHECK_SPELLING_WHILE_TYPING) {
+    return true;
+  }
+  switch (id) {
+    // A shell page isn't somewhere to go back from or reload: it's the
+    // desktop.
+    case IDC_BACK:
+    case IDC_FORWARD:
+    case IDC_RELOAD:
+    case IDC_CONTENT_CONTEXT_RELOADFRAME:
+      return tab;
+    // EXO-TAB-FEATURES: printing goes to the shell (plutonium_print.h).
+    case IDC_PRINT:
+      return tab;
+    // Links and media open as tabs (plutonium_tabs.h). "New window",
+    // incognito and other profiles would be Chrome windows.
+    case IDC_CONTENT_CONTEXT_OPENLINKNEWTAB:
+    case IDC_CONTENT_CONTEXT_COPYLINKLOCATION:
+    case IDC_CONTENT_CONTEXT_COPYLINKTEXT:
+    case IDC_CONTENT_CONTEXT_OPENIMAGENEWTAB:
+    case IDC_CONTENT_CONTEXT_OPEN_ORIGINAL_IMAGE_NEW_TAB:
+    case IDC_CONTENT_CONTEXT_LOAD_IMAGE:
+    case IDC_CONTENT_CONTEXT_COPYIMAGE:
+    case IDC_CONTENT_CONTEXT_COPYIMAGELOCATION:
+    case IDC_CONTENT_CONTEXT_OPENAVNEWTAB:
+    case IDC_CONTENT_CONTEXT_COPYAVLOCATION:
+    case IDC_CONTENT_CONTEXT_COPYVIDEOFRAME:
+    case IDC_CONTENT_CONTEXT_LOOP:
+    case IDC_CONTENT_CONTEXT_CONTROLS:
+    case IDC_CONTENT_CONTEXT_ROTATECW:
+    case IDC_CONTENT_CONTEXT_ROTATECCW:
+    // Editing.
+    case IDC_CONTENT_CONTEXT_UNDO:
+    case IDC_CONTENT_CONTEXT_REDO:
+    case IDC_CONTENT_CONTEXT_CUT:
+    case IDC_CONTENT_CONTEXT_COPY:
+    case IDC_CONTENT_CONTEXT_PASTE:
+    case IDC_CONTENT_CONTEXT_PASTE_AND_MATCH_STYLE:
+    case IDC_CONTENT_CONTEXT_DELETE:
+    case IDC_CONTENT_CONTEXT_SELECTALL:
+    case IDC_WRITING_DIRECTION_MENU:
+    case IDC_WRITING_DIRECTION_DEFAULT:
+    case IDC_WRITING_DIRECTION_LTR:
+    case IDC_WRITING_DIRECTION_RTL:
+    // A selection.
+    case IDC_CONTENT_CONTEXT_SEARCHWEBFOR:
+    case IDC_CONTENT_CONTEXT_SEARCHWEBFORNEWTAB:
+    case IDC_CONTENT_CONTEXT_GOTOURL:
+    case IDC_CONTENT_CONTEXT_COPYLINKTOTEXT:
+    case IDC_CONTENT_CONTEXT_RESHARELINKTOTEXT:
+    case IDC_CONTENT_CONTEXT_REMOVELINKTOTEXT:
+    // Spelling, but not its settings page.
+    case IDC_SPELLCHECK_MENU:
+    case IDC_SPELLCHECK_ADD_TO_DICTIONARY:
+    case IDC_SPELLCHECK_REMOVE_FROM_DICTIONARY:
+    case IDC_CHECK_SPELLING_WHILE_TYPING:
+    case IDC_SPELLCHECK_MULTI_LINGUAL:
+      return true;
+    default:
+      return false;
+  }
+}
+
+ContextMenuItemType TypeOf(ui::MenuModel::ItemType type) {
+  switch (type) {
+    case ui::MenuModel::TYPE_CHECK:
+      return ContextMenuItemType::kCheckbox;
+    case ui::MenuModel::TYPE_RADIO:
+      return ContextMenuItemType::kRadio;
+    case ui::MenuModel::TYPE_SEPARATOR:
+      return ContextMenuItemType::kSeparator;
+    case ui::MenuModel::TYPE_SUBMENU:
+    case ui::MenuModel::TYPE_ACTIONABLE_SUBMENU:
+      return ContextMenuItemType::kSubmenu;
+    case ui::MenuModel::TYPE_TITLE:
+      return ContextMenuItemType::kTitle;
+    default:
+      return ContextMenuItemType::kCommand;
+  }
+}
+
+std::string MediaTypeOf(blink::mojom::ContextMenuDataMediaType type) {
+  switch (type) {
+    case blink::mojom::ContextMenuDataMediaType::kImage:
+      return "image";
+    case blink::mojom::ContextMenuDataMediaType::kVideo:
+      return "video";
+    case blink::mojom::ContextMenuDataMediaType::kAudio:
+      return "audio";
+    case blink::mojom::ContextMenuDataMediaType::kCanvas:
+      return "canvas";
+    case blink::mojom::ContextMenuDataMediaType::kFile:
+      return "file";
+    case blink::mojom::ContextMenuDataMediaType::kPlugin:
+      return "plugin";
+    default:
+      return std::string();
+  }
+}
