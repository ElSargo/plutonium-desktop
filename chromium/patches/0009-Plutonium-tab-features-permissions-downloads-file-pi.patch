+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PLUTONIUM_FILE_CHOOSER_H_
+#define CHROME_BROWSER_PLUTONIUM_FILE_CHOOSER_H_
+
+#include <memory>
+
+#include "ui/shell_dialogs/select_file_dialog_factory.h"
+
+namespace base {
+class FilePath;
+}
+
+namespace content {
+class WebContents;
+}
+
+// EXO-TAB-FEATURES (docs/features/TAB_FEATURES.md, "File pickers"): every
+// file picker a registry tab or a shell page opens (<input type=file> through
+// FileSelectHelper, the File System Access pickers, a download's Save As)
+// asks the shell, as a "fileChooser" tab request (PlutoniumTabRequests; tab
+// id 0 for the shell page's own):
+//
+//   detail: {mode: "open" | "open-multiple" | "folder" | "save", upload,
+//            title, origin, filters: [{name, patterns: ["*.png", ...]}],
+//            currentFilter, currentName, currentFolder, defaultExtension}
+//   answer: {paths: ["/abs/path", ...], filter?} (filter: an index into
+//           filters), or null (or no paths) to cancel.
+//
+// Paths are host paths: they must be visible to the browser (Ash outside the
+// container, or a container that mounts the user's home at the same path).
+// An agent may answer too (it can read the files anyway).
+//
+// A folder upload (detail.upload) answered here was confirmed by whoever
+// answered: the library's picker asks "Upload N files to <site>?" itself.
+// So Chrome's own confirmation (FileSelectHelper's tab-modal dialog) is
+// skipped for it; behind the Files app's picker it still shows.
+//
+// If no shell takes the request, or the one that took it goes away, the
+// picker the factory this wraps makes (the Files app's) opens instead.
+// Pickers for anything but a registry tab go straight to it.
+class PlutoniumSelectFileDialogFactory : public ui::SelectFileDialogFactory {
+ public:
+  explicit PlutoniumSelectFileDialogFactory(
+      std::unique_ptr<ui::SelectFileDialogFactory> fallback);
+  PlutoniumSelectFileDialogFactory(const PlutoniumSelectFileDialogFactory&) =
+      delete;
+  PlutoniumSelectFileDialogFactory& operator=(
+      const PlutoniumSelectFileDialogFactory&) = delete;
+  ~PlutoniumSelectFileDialogFactory() override;
+
+  // ui::SelectFileDialogFactory:
+  ui::SelectFileDialog* Create(
+      ui::SelectFileDialog::Listener* listener,
+      std::unique_ptr<ui::SelectFilePolicy> policy) override;
+
+ private:
+  std::unique_ptr<ui::SelectFileDialogFactory> fallback_;
+};
+
+// True once, for `folder`, if a shell or an agent answered `contents`'s
+// folder upload with it (above). FileSelectHelper then skips its
+// confirmation.
+bool PlutoniumTakeFolderUploadConfirmed(content::WebContents* contents,
+                                        const base::FilePath& folder);
+
+#endif  // CHROME_BROWSER_PLUTONIUM_FILE_CHOOSER_H_
diff --git a/chrome/browser/plutonium_find.cc b/chrome/browser/plutonium_find.cc
