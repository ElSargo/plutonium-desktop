+
+namespace plutonium_permissions {
+
+namespace {
+
+using From = PlutoniumTabRequests::From;
+using FallbackReason = PlutoniumTabRequests::FallbackReason;
+
+constexpr char kKind[] = "permission";
+// How many blocked requests a tab remembers.
+constexpr size_t kMaxBlocked = 32;
+
+// The name shells and agents see for |type|: the Permissions API's where
+// there is one, else Chrome's key with dashes.
+std::string TypeName(permissions::RequestType type) {
+  switch (type) {
+    case permissions::RequestType::kCameraStream:
+      return "camera";
+    case permissions::RequestType::kMicStream:
+      return "microphone";
+    case permissions::RequestType::kClipboard:
+      return "clipboard-read";
+    case permissions::RequestType::kMultipleDownloads:
+      return "automatic-downloads";
+    case permissions::RequestType::kFileSystemAccess:
+      return "file-write";
+    default:
+      break;
+  }
+  const char* key = permissions::PermissionKeyForRequestType(type);
+  std::string name = key ? key : "unknown";
+  std::replace(name.begin(), name.end(), '_', '-');
+  return name;
+}
+
+base::ListValue ToList(const std::vector<std::string>& strings) {
+  base::ListValue list;
+  for (const std::string& string : strings) {
+    list.Append(string);
+  }
+  return list;
+}
+
+// What every permission request's detail has.
+base::DictValue Detail(content::WebContents* contents,
+                       const url::Origin& origin,
+                       const std::vector<std::string>& types,
+                       const std::vector<std::string>& scopes) {
+  std::optional<PlutoniumTabs::TabInfo> tab =
+      PlutoniumTabs::Get()->GetTabFor(contents);
+  return base::DictValue()
+      .Set("origin", origin.Serialize())
+      .Set("embeddingOrigin",
+           contents->GetPrimaryMainFrame()->GetLastCommittedOrigin().Serialize())
+      .Set("thread", tab ? tab->tag : std::string())
+      .Set("types", ToList(types))
+      .Set("scopes", ToList(scopes));
+}
+
+enum class Answer { kAllow, kDeny, kDismiss };
+
+struct Decision {
+  Answer answer = Answer::kDismiss;
+  // For allow: one of the request's scopes. For deny: "once" or one of them.
+  std::string scope;
+};
+
+// {answer, scope?} or just the answer; nullopt if it isn't one for a
+// request offering |scopes|.
+std::optional<Decision> ParseDecision(const base::Value& value,
+                                      const std::vector<std::string>& scopes) {
+  const std::string* answer = nullptr;
+  const std::string* scope = nullptr;
+  if (value.is_string()) {
+    answer = &value.GetString();
+  } else if (value.is_dict()) {
+    answer = value.GetDict().FindString("answer");
+    scope = value.GetDict().FindString("scope");
+  }
+  if (!answer) {
+    return std::nullopt;
+  }
+  Decision decision;
+  if (*answer == "allow") {
+    decision.answer = Answer::kAllow;
+  } else if (*answer == "deny") {
+    decision.answer = Answer::kDeny;
+  } else if (*answer == "dismiss") {
+    return decision;
+  } else {
+    return std::nullopt;
+  }
+  if (scope) {
+    if (!std::ranges::contains(scopes, *scope) &&
+        !(decision.answer == Answer::kDeny && *scope == "once")) {
+      return std::nullopt;
+    }
+    decision.scope = *scope;
+  } else if (decision.answer == Answer::kDeny || scopes.empty()) {
+    // A denial stores nothing unless it says where.
+    decision.scope = "once";
+  } else {
+    decision.scope =
+        std::ranges::contains(scopes, "thread") ? "thread" : scopes.front();
+  }
+  return decision;
+}
+
+// EXO-TAB-PERMISSIONS, "Grants and threads": the threads' decisions, in
+// local state: {thread: {origin: {permission: "allow" | "block"}}}.
+constexpr char kThreadsPref[] = "plutonium.thread_permissions";
+
+// A content setting's name: its request type's (TypeName()), or empty.
+std::string SettingName(ContentSettingsType type) {
+  std::optional<permissions::RequestType> request_type =
+      permissions::ContentSettingsTypeToRequestTypeIfExists(type);
+  return request_type ? TypeName(*request_type) : std::string();
+}
+
+// The content setting permission |name| is, if a thread or "everywhere" can
+// hold it: not file access or several downloads, whose decisions aren't
+// PermissionContextBase's.
+std::optional<ContentSettingsType> SettingType(const std::string& name) {
+  if (name == "automatic-downloads" || name == "file-write" ||
+      name == "file-read") {
+    return std::nullopt;
+  }
+  for (int i = 0; i <= static_cast<int>(permissions::RequestType::kMaxValue);
+       ++i) {
+    const auto request_type = static_cast<permissions::RequestType>(i);
+    if (TypeName(request_type) != name) {
+      continue;
+    }
+    std::optional<ContentSettingsType> type =
+        permissions::RequestTypeToContentSettingsType(request_type);
+    if (type &&
+        content_settings::PermissionSettingsRegistry::GetInstance()->Get(
+            *type)) {
+      return type;
+    }
+    return std::nullopt;
+  }
+  return std::nullopt;
+}
+
+// What |thread| decided about |permission| for |origin|: true (allow),
+// false (block) or nothing.
+std::optional<bool> GetThreadDecision(const std::string& thread,
+                                      const std::string& origin,
+                                      const std::string& permission) {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state || thread.empty()) {
+    return std::nullopt;
+  }
+  const base::DictValue* origins =
+      local_state->GetDict(kThreadsPref).FindDict(thread);
+  const base::DictValue* decisions =
+      origins ? origins->FindDict(origin) : nullptr;
+  const std::string* decision =
+      decisions ? decisions->FindString(permission) : nullptr;
+  if (!decision) {
+    return std::nullopt;
+  }
+  return *decision == "allow";
+}
+
+void SetThreadDecision(const std::string& thread,
+                       const std::string& origin,
+                       const std::string& permission,
+                       bool granted) {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state || thread.empty()) {
+    return;
+  }
+  base::DictValue threads = local_state->GetDict(kThreadsPref).Clone();
+  threads.EnsureDict(thread)->EnsureDict(origin)->Set(
+      permission, granted ? "allow" : "block");
+  local_state->SetDict(kThreadsPref, std::move(threads));
+}
+
+// Removes |thread|'s decisions for |origin| and |permission| (empty: any);
+// returns how many it removed.
+int RevokeThreadDecisions(const std::string& thread,
+                          const std::string& origin,
+                          const std::string& permission) {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state || thread.empty()) {
+    return 0;
+  }
+  base::DictValue threads = local_state->GetDict(kThreadsPref).Clone();
+  base::DictValue* origins = threads.FindDict(thread);
+  if (!origins) {
+    return 0;
+  }
+  int revoked = 0;
+  std::vector<std::string> emptied;
+  for (auto [key, value] : *origins) {
+    if ((!origin.empty() && key != origin) || !value.is_dict()) {
+      continue;
+    }
+    base::DictValue& decisions = value.GetDict();
+    if (permission.empty()) {
+      revoked += static_cast<int>(decisions.size());
+      decisions.clear();
+    } else if (decisions.Remove(permission)) {
+      ++revoked;
+    }
+    if (decisions.empty()) {
+      emptied.push_back(key);
+    }
+  }
+  for (const std::string& key : emptied) {
+    origins->Remove(key);
+  }
+  if (origins->empty()) {
+    threads.Remove(thread);
+  }
+  local_state->SetDict(kThreadsPref, std::move(threads));
+  return revoked;
+}
+
+// [{thread, origin, permission, decision, scope: "thread"}], for |thread|
+// and |origin| (empty: any).
+base::ListValue ListThreadDecisions(const std::string& thread,
+                                    const std::string& origin) {
+  base::ListValue list;
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state) {
+    return list;
+  }
+  for (const auto [thread_key, origins] : local_state->GetDict(kThreadsPref)) {
+    if ((!thread.empty() && thread_key != thread) || !origins.is_dict()) {
+      continue;
+    }
+    for (const auto [origin_key, decisions] : origins.GetDict()) {
+      if ((!origin.empty() && origin_key != origin) || !decisions.is_dict()) {
+        continue;
+      }
+      for (const auto [permission, decision] : decisions.GetDict()) {
+        if (!decision.is_string()) {
+          continue;
+        }
+        list.Append(base::DictValue()
+                        .Set("thread", thread_key)
+                        .Set("origin", origin_key)
+                        .Set("permission", permission)
+                        .Set("decision", decision.GetString())
+                        .Set("scope", "thread"));
+      }
+    }
+  }
+  return list;
+}
+
+// PermissionContextBase's thread decision: the tab's thread's, where
+// Chrome's own setting asks.
+std::optional<bool> ThreadDecisionFor(
+    content::RenderFrameHost* render_frame_host,
+    const GURL& requesting_origin,
+    ContentSettingsType type) {
+  content::WebContents* contents =
+      content::WebContents::FromRenderFrameHost(render_frame_host);
+  std::optional<PlutoniumTabs::TabInfo> tab =
+      contents ? PlutoniumTabs::Get()->GetTabFor(contents) : std::nullopt;
+  const std::string name = SettingName(type);
+  if (!tab || tab->tag.empty() || name.empty()) {
+    return std::nullopt;
+  }
+  return GetThreadDecision(
+      tab->tag, url::Origin::Create(requesting_origin).Serialize(), name);
+}
+
+// Sets Chrome's own setting (|granted|), or takes it back (nullopt).
+void SetEverywhere(content::BrowserContext* context,
+                   const url::Origin& origin,
+                   ContentSettingsType type,
+                   std::optional<bool> granted) {
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(context);
+  const content_settings::PermissionSettingsInfo* info =
+      content_settings::PermissionSettingsRegistry::GetInstance()->Get(type);
+  if (!map || !info) {
+    return;
+  }
+  std::optional<PermissionSetting> setting;
+  if (granted) {
+    setting = info->delegate().ToPermissionSetting(
+        *granted ? CONTENT_SETTING_ALLOW : CONTENT_SETTING_BLOCK);
+  }
+  const GURL url = origin.GetURL();
+  map->SetPermissionSettingDefaultScope(url, url, type, setting);
+}
+
+const char* AnswerName(Answer answer) {
+  switch (answer) {
+    case Answer::kAllow:
+      return "allow";
+    case Answer::kDeny:
+      return "deny";
+    case Answer::kDismiss:
+      return "dismiss";
+  }
+  return "dismiss";
+}
+
+// A tab's permission state: the requests no one answered ("blocked").
+class TabPermissions : public content::WebContentsObserver,
+                       public content::WebContentsUserData<TabPermissions> {
+ public:
+  ~TabPermissions() override = default;
+
+  void Block(const url::Origin& origin, const std::vector<std::string>& types) {
+    for (const std::string& type : types) {
+      std::pair<std::string, std::string> entry(origin.Serialize(), type);
+      if (!std::ranges::contains(blocked_, entry)) {
+        blocked_.push_back(std::move(entry));
+      }
+    }
+    if (blocked_.size() > kMaxBlocked) {
+      blocked_.erase(blocked_.begin(),
+                     blocked_.begin() + (blocked_.size() - kMaxBlocked));
+    }
+    Update();
+  }
+
+  void Unblock(const url::Origin& origin,
+               const std::vector<std::string>& types) {
+    const std::string serialized = origin.Serialize();
+    const size_t erased = std::erase_if(blocked_, [&](const auto& entry) {
+      return entry.first == serialized &&
+             std::ranges::contains(types, entry.second);
+    });
+    if (erased) {
+      Update();
+    }
+  }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && handle->HasCommitted() &&
+        !handle->IsSameDocument() && !blocked_.empty()) {
+      blocked_.clear();
+      Update();
+    }
+  }
+
+ private:
+  friend class content::WebContentsUserData<TabPermissions>;
+
+  explicit TabPermissions(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<TabPermissions>(*contents) {}
+
+  void Update() {
+    base::ListValue list;
+    for (const auto& [origin, permission] : blocked_) {
+      list.Append(base::DictValue()
+                      .Set("origin", origin)
+                      .Set("permission", permission));
+    }
+    PlutoniumTabs::Get()->SetTabState(
+        web_contents(), "blocked",
+        list.empty() ? base::Value() : base::Value(std::move(list)));
+  }
+
+  // (origin, permission), oldest first.
+  std::vector<std::pair<std::string, std::string>> blocked_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabPermissions);
+
+void Block(content::WebContents* contents,
+           const url::Origin& origin,
+           const std::vector<std::string>& types) {
+  if (TabPermissions* tab =
+          contents ? TabPermissions::FromWebContents(contents) : nullptr) {
+    tab->Block(origin, types);
+  }
+}
+
+void Unblock(content::WebContents* contents,
+             const url::Origin& origin,
+             const std::vector<std::string>& types) {
+  if (TabPermissions* tab =
+          contents ? TabPermissions::FromWebContents(contents) : nullptr) {
+    tab->Unblock(origin, types);
+  }
+}
+
+// What the tabs capture now: their "inUse" state.
+class CaptureObserver : public MediaStreamCaptureIndicator::Observer {
+ public:
+  static void Ensure() { static base::NoDestructor<CaptureObserver> observer; }
+
+  CaptureObserver() {
+    indicator_ = MediaCaptureDevicesDispatcher::GetInstance()
+                     ->GetMediaStreamCaptureIndicator();
+    if (indicator_) {
+      observation_.Observe(indicator_.get());
+    }
+  }
+
+  // MediaStreamCaptureIndicator::Observer:
+  void OnIsCapturingVideoChanged(content::WebContents* contents,
+                                 bool) override {
+    Update(contents);
+  }
+  void OnIsCapturingAudioChanged(content::WebContents* contents,
+                                 bool) override {
+    Update(contents);
+  }
+  void OnIsCapturingTabChanged(content::WebContents* contents, bool) override {
+    Update(contents);
+  }
+  void OnIsCapturingWindowChanged(content::WebContents* contents,
+                                  bool) override {
+    Update(contents);
+  }
+  void OnIsCapturingDisplayChanged(content::WebContents* contents,
+                                   bool) override {
+    Update(contents);
+  }
+
+ private:
+  void Update(content::WebContents* contents) {
+    if (!contents || !PlutoniumTabs::Get()->IsTab(contents)) {
+      return;
+    }
+    const bool camera = indicator_->IsCapturingVideo(contents);
+    const bool microphone = indicator_->IsCapturingAudio(contents);
+    const bool screen = indicator_->IsCapturingTab(contents) ||
+                        indicator_->IsCapturingWindow(contents) ||
+                        indicator_->IsCapturingDisplay(contents);
+    PlutoniumTabs::Get()->SetTabState(
+        contents, "inUse",
+        camera || microphone || screen
+            ? base::Value(base::DictValue()
+                              .Set("camera", camera)
+                              .Set("microphone", microphone)
+                              .Set("screen", screen))
+            : base::Value());
+  }
+
+  scoped_refptr<MediaStreamCaptureIndicator> indicator_;
+  base::ScopedObservation<MediaStreamCaptureIndicator,
+                          MediaStreamCaptureIndicator::Observer>
+      observation_{this};
+};
+
+// The request manager's prompt for a registry tab: a "permission" request.
+class Prompt : public permissions::PermissionPrompt {
+ public:
+  Prompt(content::WebContents* contents, Delegate* delegate)
+      : contents_(contents), delegate_(delegate) {
+    origin_ = url::Origin::Create(delegate->GetRequestingOrigin());
+    bool once = true;
+    for (const auto& request : delegate->Requests()) {
+      const std::string type = TypeName(request->request_type());
+      if (!std::ranges::contains(types_, type)) {
+        types_.push_back(type);
+      }
+      once = once && permissions::PermissionUtil::DoesSupportTemporaryGrants(
+                         request->GetContentSettingsType());
+      settings_.push_back(request->GetContentSettingsType());
+    }
+    // "This thread" first (TAB_FEATURES.md, Decisions 1), where it holds.
+    std::optional<PlutoniumTabs::TabInfo> tab =
+        PlutoniumTabs::Get()->GetTabFor(contents);
+    thread_ = tab ? tab->tag : std::string();
+    if (!thread_.empty() &&
+        std::ranges::all_of(settings_, [](ContentSettingsType type) {
+          return SettingType(SettingName(type)).has_value();
+        })) {
+      scopes_.push_back("thread");
+    }
+    if (once) {
+      scopes_.push_back("once");
+    }
+    scopes_.push_back("everywhere");
+
+    PlutoniumTabRequests::Params params;
+    params.kind = kKind;
+    params.detail = Detail(contents, origin_, types_, scopes_);
+    params.on_answer = base::BindRepeating(
+        [](base::WeakPtr<Prompt> prompt, From from, const base::Value& answer) {
+          return prompt && prompt->OnAnswer(from, answer);
+        },
+        weak_factory_.GetWeakPtr());
+    params.on_fallback = base::BindOnce(
+        [](base::WeakPtr<Prompt> prompt, FallbackReason reason) {
+          if (prompt) {
+            prompt->OnFallback(reason);
+          }
+        },
+        weak_factory_.GetWeakPtr());
+    handle_ = PlutoniumTabRequests::Get()->Start(contents, std::move(params));
+    VLOG(1) << "EXO-TAB-PERMISSIONS " << origin_.Serialize() << " asks for "
+            << types_.front() << (types_.size() > 1 ? " and more" : "")
+            << (handle_ ? "" : " (not a tab)");
+  }
+
+  ~Prompt() override = default;
+
+  // permissions::PermissionPrompt:
+  bool UpdateAnchor() override { return true; }
+  TabSwitchingBehavior GetTabSwitchingBehavior() override {
+    return TabSwitchingBehavior::kKeepPromptAlive;
+  }
+  permissions::PermissionPromptDisposition GetPromptDisposition()
+      const override {
+    return permissions::PermissionPromptDisposition::CUSTOM_MODAL_DIALOG;
+  }
+  bool IsAskPrompt() const override { return true; }
+  std::optional<gfx::Rect> GetViewBoundsInScreen() const override {
+    return std::nullopt;
+  }
+  std::vector<permissions::ElementAnchoredBubbleVariant> GetPromptVariants()
+      const override {
+    return {};
+  }
+  std::optional<permissions::feature_params::PermissionElementPromptPosition>
+  GetPromptPosition() const override {
+    return std::nullopt;
+  }
+
+ private:
+  PromptOptions Options() const {
+    const auto& requests = delegate_->Requests();
+    if (!requests.empty() &&
+        requests.front()->GetContentSettingsType() ==
+            ContentSettingsType::GEOLOCATION_WITH_OPTIONS) {
+      return GeolocationPromptOptions{.selected_accuracy =
+                                          GeolocationAccuracy::kPrecise};
+    }
+    return std::monostate();
+  }
+
+  // The delegate's calls end the requests and destroy |this|: nothing runs
+  // after them.
+  bool OnAnswer(From from, const base::Value& value) {
+    std::optional<Decision> decision = ParseDecision(value, scopes_);
+    if (!decision ||
+        (from == From::kAgent && decision->answer == Answer::kAllow)) {
+      return false;
+    }
+    VLOG(1) << "EXO-TAB-PERMISSIONS " << origin_.Serialize() << ": "
+            << (from == From::kAgent ? "agent" : "shell") << " answered "
+            << value.DebugString();
+    Unblock(contents_, origin_, types_);
+    Delegate* delegate = delegate_;
+    const PromptOptions options = Options();
+    if (decision->answer != Answer::kDismiss && decision->scope == "thread") {
+      // The thread holds the decision (PermissionContextBase reports it,
+      // also as this request's result); Chrome stores nothing, and the
+      // dismissal doesn't count towards embargo.
+      for (ContentSettingsType type : settings_) {
+        SetThreadDecision(thread_, origin_.Serialize(), SettingName(type),
+                          decision->answer == Answer::kAllow);
+      }
+      content::BrowserContext* context = contents_->GetBrowserContext();
+      const GURL origin = origin_.GetURL();
+      const std::vector<ContentSettingsType> settings = settings_;
+      delegate->Dismiss(options);
+      if (permissions::PermissionDecisionAutoBlocker* blocker =
+              permissions::PermissionsClient::Get()
+                  ->GetPermissionDecisionAutoBlocker(context)) {
+        for (ContentSettingsType type : settings) {
+          blocker->RemoveEmbargoAndResetCounts(origin, type);
+        }
+      }
+      return true;
+    }
+    switch (decision->answer) {
+      case Answer::kAllow:
+        if (decision->scope == "everywhere") {
+          delegate->Accept(options);
+        } else {
+          delegate->AcceptThisTime(options);
+        }
+        break;
+      case Answer::kDeny:
+        if (decision->scope == "everywhere") {
+          delegate->Deny(options);
+        } else {
+          delegate->Dismiss(options);
+        }
+        break;
+      case Answer::kDismiss:
+        delegate->Dismiss(options);
+        break;
+    }
+    return true;
+  }
+
+  // TAB_FEATURES.md, Decisions 2: dismiss, and record it on the tab.
+  void OnFallback(FallbackReason reason) {
+    VLOG(1) << "EXO-TAB-PERMISSIONS " << origin_.Serialize()
+            << ": no shell answered, dismissed";
+    Block(contents_, origin_, types_);
+    delegate_->Dismiss(Options());
+  }
+
+  const raw_ptr<content::WebContents> contents_;
+  const raw_ptr<Delegate> delegate_;
+  url::Origin origin_;
+  std::vector<std::string> types_;
+  // The requests' settings, in order.
+  std::vector<ContentSettingsType> settings_;
+  std::vector<std::string> scopes_;
+  // The tab's thread (its origin tag), or empty.
+  std::string thread_;
+  std::unique_ptr<PlutoniumTabRequests::Handle> handle_;
+  base::WeakPtrFactory<Prompt> weak_factory_{this};
+};
+
+}  // namespace
