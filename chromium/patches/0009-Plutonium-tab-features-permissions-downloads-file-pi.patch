+// An item the shell can choose: where it is in the menu's models.
+struct Target {
+  raw_ptr<ui::MenuModel> model;
+  size_t index;
+};
+
+struct Node {
+  blink::mojom::ContextMenuItemPtr item;
+  std::vector<Node> children;
+};
+
+// |model|'s items as the shell gets them; submenus' are filtered too.
+std::vector<Node> Collect(ui::MenuModel* model,
+                          bool tab,
+                          std::vector<Target>& targets) {
+  std::vector<Node> nodes;
+  for (size_t i = 0; i < model->GetItemCount(); ++i) {
+    if (!model->IsVisibleAt(i)) {
+      continue;
+    }
+    const ContextMenuItemType type = TypeOf(model->GetTypeAt(i));
+    Node node;
+    node.item = blink::mojom::ContextMenuItem::New();
+    node.item->type = type;
+    if (type == ContextMenuItemType::kSeparator) {
+      // Doubled or at either end: dropped below.
+      if (!nodes.empty() &&
+          nodes.back().item->type != ContextMenuItemType::kSeparator) {
+        nodes.push_back(std::move(node));
+      }
+      continue;
+    }
+    if (type != ContextMenuItemType::kTitle &&
+        !Keeps(model->GetCommandIdAt(i), tab)) {
+      continue;
+    }
+    node.item->label = base::UTF16ToUTF8(
+        gfx::RemoveAccelerator(model->GetLabelAt(i)));
+    node.item->enabled = model->IsEnabledAt(i);
+    node.item->checked = model->IsItemCheckedAt(i);
+    if (type != ContextMenuItemType::kTitle) {
+      targets.push_back({model, i});
+      node.item->id = static_cast<int32_t>(targets.size());
+    }
+    if (type == ContextMenuItemType::kSubmenu) {
+      ui::MenuModel* submenu = model->GetSubmenuModelAt(i);
+      if (!submenu) {
+        continue;
+      }
+      submenu->MenuWillShow();
+      node.children = Collect(submenu, tab, targets);
+      if (node.children.empty()) {
+        continue;
+      }
+    }
+    nodes.push_back(std::move(node));
+  }
+  if (!nodes.empty() &&
+      nodes.back().item->type == ContextMenuItemType::kSeparator) {
+    nodes.pop_back();
+  }
+  return nodes;
+}
+
+void Flatten(std::vector<Node>& nodes,
+             int32_t parent_id,
+             std::vector<blink::mojom::ContextMenuItemPtr>& items) {
+  for (Node& node : nodes) {
+    const int32_t id = node.item->id;
+    node.item->parent_id = parent_id;
+    items.push_back(std::move(node.item));
+    Flatten(node.children, id, items);
+  }
+}
