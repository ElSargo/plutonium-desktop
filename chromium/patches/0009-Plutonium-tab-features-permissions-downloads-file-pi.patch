+
+#ifndef CHROME_BROWSER_PLUTONIUM_FIND_H_
+#define CHROME_BROWSER_PLUTONIUM_FIND_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "chrome/browser/plutonium_tab_requests.h"
+#include "chrome/browser/plutonium_tabs.h"
+#include "components/find_in_page/find_result_observer.h"
+#include "components/find_in_page/find_tab_helper.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+// EXO-TAB-FEATURES (docs/features/TAB_FEATURES.md, "Find in page"): find in
+// a registry tab, with the shell's find bar in place of Chrome's
+// (FindBarController needs a BrowserView).
+//
+// - "find" (Ctrl+F) asks the shell to open its find bar: a "find" tab
+//   request {initialText} (the selection, else the last search). It stays
+//   open while the bar is; the bar answers {action: "keep" | "clear" |
+//   "activate"} when it closes, which stops the search. If no shell takes
+//   it, nothing happens: there is no bar to fall back to.
+// - "find-text" {text, forward, matchCase, select, scroll} searches, or moves
+//   to the next match of the same text (FindTabHelper::StartFinding()), and
+//   resolves with the result once all frames have answered.
+// - "find-next" and "find-previous" (F3, Ctrl+G, Shift+F3, Ctrl+Shift+G)
+//   search again for the last text; with none, they open the bar.
+// - "stop-find" {action} ends the search, and closes the bar.
+//
+// Every result is the tab's state "find": {text, matchCase, matches,
+// activeMatch, rect: {x, y, width, height} (the active match, in the tab's
+// view), final}; it goes when the search stops.
+class PlutoniumFind : public content::WebContentsUserData<PlutoniumFind>,
+                      public content::WebContentsObserver,
+                      public find_in_page::FindResultObserver {
+ public:
+  PlutoniumFind(const PlutoniumFind&) = delete;
+  PlutoniumFind& operator=(const PlutoniumFind&) = delete;
+  ~PlutoniumFind() override;
+
+  // Tab::AttachHelpers(): Chrome's FindTabHelper (with the profile's
+  // FindBarState, as FindBarState::ConfigureWebContents() does) and this.
+  static void Attach(content::WebContents* contents);
+  // The PlutoniumTabs constructor: the commands above.
+  static void AddCommands(PlutoniumTabs* tabs);
+
+  // content::WebContentsObserver:
+  void NavigationEntryCommitted(
+      const content::LoadCommittedDetails& load_details) override;
+
+  // find_in_page::FindResultObserver:
+  void OnFindResultAvailable(content::WebContents* contents) override;
+  void OnFindEmptyText(content::WebContents* contents) override;
+  void OnFindTabHelperDestroyed(find_in_page::FindTabHelper* helper) override;
+
+ private:
+  friend class content::WebContentsUserData<PlutoniumFind>;
+
+  explicit PlutoniumFind(content::WebContents* contents);
+
+  static void RunFind(content::WebContents* contents,
+                      const base::DictValue& args,
+                      PlutoniumTabs::CommandCallback done);
+  static void RunFindText(content::WebContents* contents,
+                          const base::DictValue& args,
+                          PlutoniumTabs::CommandCallback done);
+  static void RunFindNext(bool forward,
+                          content::WebContents* contents,
+                          const base::DictValue& args,
+                          PlutoniumTabs::CommandCallback done);
+  static void RunStopFind(content::WebContents* contents,
+                          const base::DictValue& args,
+                          PlutoniumTabs::CommandCallback done);
+
+  // Asks the shell to open its find bar, with |text| or the initial text.
+  void OpenBar(const std::u16string& text,
+               PlutoniumTabs::CommandCallback done);
+  // Searches for |text|; |done| gets the final result.
+  void Find(const std::u16string& text,
+            bool forward,
+            bool match_case,
+            bool select,
+            bool scroll,
+            PlutoniumTabs::CommandCallback done);
+  // Stops the search (|action|: "keep", "clear" or "activate"), and closes
+  // the bar unless |close_bar| is false.
+  void Stop(const std::string& action, bool close_bar);
+  // The bar's answer.
+  bool OnAnswer(PlutoniumTabRequests::From from, const base::Value& answer);
+  // |generation|: the bar it was for (a newer one may be open).
+  void OnFallback(int generation, PlutoniumTabRequests::FallbackReason reason);
+
+  // The search's result, as in the tab's "find" state.
+  base::Value Result() const;
+  // Resolves the "find-text" commands waiting on a final result.
+  void ResolveWaiting();
+
+  find_in_page::FindTabHelper* helper() const;
+
+  // The text the bar starts with: the selection, else this tab's last
+  // search, else the last search anywhere.
+  std::u16string InitialText() const;
+
+  // The bar's request, while it is open.
+  std::unique_ptr<PlutoniumTabRequests::Handle> bar_;
+  int bar_generation_ = 0;
+  // Opening the bar moved the keyboard focus from the tab to the shell.
+  bool bar_took_focus_ = false;
+  bool match_case_ = false;
+  std::vector<PlutoniumTabs::CommandCallback> waiting_;
+  // A final result that never comes (a frame went away) doesn't keep the
+  // commands waiting.
+  base::OneShotTimer waiting_timeout_;
+  base::ScopedObservation<find_in_page::FindTabHelper,
+                          find_in_page::FindResultObserver>
+      helper_observation_{this};
+  base::WeakPtrFactory<PlutoniumFind> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_PLUTONIUM_FIND_H_
