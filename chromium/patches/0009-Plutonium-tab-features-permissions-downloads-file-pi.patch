index 0000000000..9ae56f313c
--- /dev/null
+++ b/chrome/browser/plutonium_find.cc
@@ -0,0 +1,383 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/plutonium_find.h"
+
+#include <algorithm>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/find_bar/find_bar_state.h"
+#include "components/find_in_page/find_notification_details.h"
+#include "components/find_in_page/find_types.h"
+#include "content/public/browser/navigation_details.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/surface_embed_connector.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace {
+
+// Chrome's find bar takes the selection up to this long.
+constexpr size_t kMaxSelectionLength = 250;
+constexpr base::TimeDelta kWaitingTimeout = base::Seconds(5);
+
+std::optional<find_in_page::SelectionAction> ParseAction(
+    const std::string& action) {
+  if (action == "keep") {
+    return find_in_page::SelectionAction::kKeep;
+  }
+  if (action == "clear") {
+    return find_in_page::SelectionAction::kClear;
+  }
+  if (action == "activate") {
+    return find_in_page::SelectionAction::kActivate;
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+PlutoniumFind::PlutoniumFind(content::WebContents* contents)
+    : content::WebContentsUserData<PlutoniumFind>(*contents),
+      content::WebContentsObserver(contents) {
+  if (find_in_page::FindTabHelper* find_helper = helper()) {
+    helper_observation_.Observe(find_helper);
+  }
+}
+
+PlutoniumFind::~PlutoniumFind() {
+  // A command always answers, even when its tab goes.
+  std::vector<PlutoniumTabs::CommandCallback> waiting = std::move(waiting_);
+  for (PlutoniumTabs::CommandCallback& done : waiting) {
+    std::move(done).Run(std::nullopt);
+  }
+}
+
+// static
+void PlutoniumFind::Attach(content::WebContents* contents) {
+  FindBarState::ConfigureWebContents(contents);
+  CreateForWebContents(contents);
+}
+
+// static
+void PlutoniumFind::AddCommands(PlutoniumTabs* tabs) {
+  tabs->AddCommand("find", base::BindRepeating(&PlutoniumFind::RunFind));
+  tabs->AddCommand("find-text",
+                   base::BindRepeating(&PlutoniumFind::RunFindText));
+  tabs->AddCommand("find-next",
+                   base::BindRepeating(&PlutoniumFind::RunFindNext, true));
+  tabs->AddCommand("find-previous",
+                   base::BindRepeating(&PlutoniumFind::RunFindNext, false));
+  tabs->AddCommand("stop-find",
+                   base::BindRepeating(&PlutoniumFind::RunStopFind));
+}
+
+// static
+void PlutoniumFind::RunFind(content::WebContents* contents,
+                            const base::DictValue& args,
+                            PlutoniumTabs::CommandCallback done) {
+  PlutoniumFind* find = FromWebContents(contents);
+  if (!find) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  const std::string* text = args.FindString("text");
+  find->OpenBar(text ? base::UTF8ToUTF16(*text) : std::u16string(),
+                std::move(done));
+}
+
+// static
+void PlutoniumFind::RunFindText(content::WebContents* contents,
+                                const base::DictValue& args,
+                                PlutoniumTabs::CommandCallback done) {
+  PlutoniumFind* find = FromWebContents(contents);
+  const std::string* text = args.FindString("text");
+  if (!find || !text) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  find->Find(base::UTF8ToUTF16(*text), args.FindBool("forward").value_or(true),
+             args.FindBool("matchCase").value_or(false),
+             args.FindBool("select").value_or(true),
+             args.FindBool("scroll").value_or(true), std::move(done));
+}
+
+// static
+void PlutoniumFind::RunFindNext(bool forward,
+                                content::WebContents* contents,
+                                const base::DictValue& args,
+                                PlutoniumTabs::CommandCallback done) {
+  PlutoniumFind* find = FromWebContents(contents);
+  find_in_page::FindTabHelper* find_helper = find ? find->helper() : nullptr;
+  if (!find_helper) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  std::u16string text = find_helper->find_text();
+  if (text.empty()) {
+    text = find_helper->GetInitialSearchText();
+  }
+  // Nothing searched for yet: open the bar, as Chrome's F3 does.
+  if (text.empty()) {
+    find->OpenBar(std::u16string(), std::move(done));
+    return;
+  }
+  find->Find(text, forward, find->match_case_, /*select=*/true,
+             /*scroll=*/true, std::move(done));
+}
+
+// static
+void PlutoniumFind::RunStopFind(content::WebContents* contents,
+                                const base::DictValue& args,
+                                PlutoniumTabs::CommandCallback done) {
+  PlutoniumFind* find = FromWebContents(contents);
+  const std::string* action = args.FindString("action");
+  const std::string stop_action = action ? *action : "clear";
+  if (!find || !ParseAction(stop_action)) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  find->Stop(stop_action, /*close_bar=*/true);
+  std::move(done).Run(base::Value());
+}
+
+void PlutoniumFind::OpenBar(const std::u16string& text,
+                            PlutoniumTabs::CommandCallback done) {
+  // Ctrl+F with the bar open: the bar opens again (and takes focus).
+  bar_.reset();
+  bool from_selection = false;
+  std::u16string initial = text;
+  if (initial.empty()) {
+    if (content::RenderWidgetHostView* view =
+            web_contents()->GetRenderWidgetHostView()) {
+      base::TrimWhitespace(view->GetSelectedText(), base::TRIM_ALL, &initial);
+      if (initial.size() > kMaxSelectionLength) {
+        initial.clear();
+      }
+      from_selection = !initial.empty();
+    }
+  }
+  if (initial.empty()) {
+    initial = InitialText();
+  }
+  const int generation = ++bar_generation_;
+  PlutoniumTabRequests::Params params;
+  params.kind = "find";
+  params.detail.Set("initialText", base::UTF16ToUTF8(initial));
+  params.detail.Set("fromSelection", from_selection);
+  params.detail.Set("matchCase", match_case_);
+  params.on_answer = base::BindRepeating(
+      [](base::WeakPtr<PlutoniumFind> find, PlutoniumTabRequests::From from,
+         const base::Value& answer) {
+        return find && find->OnAnswer(from, answer);
+      },
+      weak_factory_.GetWeakPtr());
+  params.on_fallback = base::BindOnce(&PlutoniumFind::OnFallback,
+                                      weak_factory_.GetWeakPtr(), generation);
+  // The tab is an inner WebContents of the shell page whose <embed> shows
+  // it; whether it, not the page, has the keyboard.
+  content::SurfaceEmbedConnector* embed =
+      web_contents()->GetSurfaceEmbedConnector();
+  const bool tab_focused =
+      embed && web_contents()->ContainsOrIsFocusedWebContents();
+  bar_ = PlutoniumTabRequests::Get()->Start(web_contents(), std::move(params));
+  if (!bar_) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  // The bar takes the keyboard, as Chrome's does. The shell's page can't
+  // take it from the tab itself (focusing its field only moves the focus
+  // within the page), so it moves from the tab to the page here, to the
+  // element the page focused; the tab gets it back if no shell takes the
+  // request.
+  bar_took_focus_ = tab_focused;
+  if (tab_focused) {
+    embed->ClearFocusOnInnerWebContents();
+  }
+  std::move(done).Run(
+      base::Value(base::DictValue().Set("requestId", bar_->id())));
+}
+
+void PlutoniumFind::Find(const std::u16string& text,
+                         bool forward,
+                         bool match_case,
+                         bool select,
+                         bool scroll,
+                         PlutoniumTabs::CommandCallback done) {
+  find_in_page::FindTabHelper* find_helper = helper();
+  if (!find_helper) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  // The same search again without selecting a match: the helper does
+  // nothing, and no result comes.
+  const bool no_reply = text.empty() || (!select &&
+                                         find_helper->find_text() == text &&
+                                         match_case_ == match_case);
+  match_case_ = match_case;
+  if (!no_reply) {
+    waiting_.push_back(std::move(done));
+    waiting_timeout_.Start(FROM_HERE, kWaitingTimeout,
+                           base::BindOnce(&PlutoniumFind::ResolveWaiting,
+                                          base::Unretained(this)));
+  }
+  find_helper->StartFinding(text, forward, match_case, select, scroll);
+  if (no_reply) {
+    std::move(done).Run(Result());
+  }
+}
+
+void PlutoniumFind::Stop(const std::string& action, bool close_bar) {
+  std::optional<find_in_page::SelectionAction> selection_action =
+      ParseAction(action);
+  if (find_in_page::FindTabHelper* find_helper = helper();
+      find_helper && selection_action) {
+    find_helper->StopFinding(*selection_action);
+  }
+  PlutoniumTabs::Get()->SetTabState(web_contents(), "find", base::Value());
+  ResolveWaiting();
+  if (close_bar) {
+    bar_.reset();
+  }
+}
+
+bool PlutoniumFind::OnAnswer(PlutoniumTabRequests::From from,
+                             const base::Value& answer) {
+  // {action}, or null: the bar closed (Escape keeps the match selected, as
+  // in Chrome).
+  std::string action = "keep";
+  if (answer.is_dict()) {
+    if (const std::string* given = answer.GetDict().FindString("action")) {
+      action = *given;
+    }
+  } else if (!answer.is_none()) {
+    return false;
+  }
+  if (!ParseAction(action)) {
+    return false;
+  }
+  VLOG(1) << "EXO-TAB-FEATURES find bar closed: " << action;
+  Stop(action, /*close_bar=*/true);
+  return true;
+}
+
+void PlutoniumFind::OnFallback(int generation,
+                               PlutoniumTabRequests::FallbackReason reason) {
+  // A bar opened since.
+  if (generation != bar_generation_) {
+    return;
+  }
+  bar_.reset();
+  if (reason == PlutoniumTabRequests::FallbackReason::kNotTaken &&
+      bar_took_focus_) {
+    if (content::SurfaceEmbedConnector* embed =
+            web_contents()->GetSurfaceEmbedConnector()) {
+      embed->FocusInnerWebContents();
+    }
+  }
+  bar_took_focus_ = false;
+  // There is no bar of Chrome's to fall back to. A bar that went away with
+  // its shell leaves no highlights behind.
+  if (reason == PlutoniumTabRequests::FallbackReason::kShellGone) {
+    Stop("clear", /*close_bar=*/false);
+  }
+}
+
+void PlutoniumFind::NavigationEntryCommitted(
+    const content::LoadCommittedDetails& load_details) {
+  if (!load_details.is_navigation_to_different_page()) {
+    return;
+  }
+  find_in_page::FindTabHelper* find_helper = helper();
+  // As Chrome's bar: a new page closes the bar.
+  if (bar_ || (find_helper && !find_helper->find_text().empty())) {
+    Stop("keep", /*close_bar=*/true);
+  }
+}
+
+void PlutoniumFind::OnFindResultAvailable(content::WebContents* contents) {
+  find_in_page::FindTabHelper* find_helper = helper();
+  if (!find_helper || find_helper->find_text().empty()) {
+    return;
+  }
+  PlutoniumTabs::Get()->SetTabState(web_contents(), "find", Result());
+  const find_in_page::FindNotificationDetails& result =
+      find_helper->find_result();
+  if (result.final_update() &&
+      result.request_id() >= find_helper->current_find_request_id()) {
+    ResolveWaiting();
+  }
+}
+
+void PlutoniumFind::OnFindEmptyText(content::WebContents* contents) {
+  PlutoniumTabs::Get()->SetTabState(web_contents(), "find", base::Value());
+  ResolveWaiting();
+}
+
+void PlutoniumFind::OnFindTabHelperDestroyed(
+    find_in_page::FindTabHelper* find_helper) {
+  helper_observation_.Reset();
+}
+
+base::Value PlutoniumFind::Result() const {
+  find_in_page::FindTabHelper* find_helper = helper();
+  if (!find_helper || find_helper->find_text().empty()) {
+    return base::Value(base::DictValue()
+                           .Set("text", "")
+                           .Set("matchCase", match_case_)
+                           .Set("matches", 0)
+                           .Set("activeMatch", 0)
+                           .Set("final", true));
+  }
+  const find_in_page::FindNotificationDetails& result =
+      find_helper->find_result();
+  const gfx::Rect rect = result.selection_rect();
+  base::DictValue dict;
+  dict.Set("text", base::UTF16ToUTF8(find_helper->find_text()));
+  dict.Set("matchCase", match_case_);
+  dict.Set("matches", std::max(result.number_of_matches(), 0));
+  dict.Set("activeMatch", std::max(result.active_match_ordinal(), 0));
+  if (!rect.IsEmpty()) {
+    dict.Set("rect", base::DictValue()
+                         .Set("x", rect.x())
+                         .Set("y", rect.y())
+                         .Set("width", rect.width())
+                         .Set("height", rect.height()));
+  }
+  dict.Set("final", result.final_update());
+  return base::Value(std::move(dict));
+}
+
+void PlutoniumFind::ResolveWaiting() {
+  waiting_timeout_.Stop();
+  if (waiting_.empty()) {
+    return;
+  }
+  std::vector<PlutoniumTabs::CommandCallback> waiting = std::move(waiting_);
+  waiting_.clear();
+  for (PlutoniumTabs::CommandCallback& done : waiting) {
+    std::move(done).Run(Result());
+  }
+}
+
+find_in_page::FindTabHelper* PlutoniumFind::helper() const {
+  return find_in_page::FindTabHelper::FromWebContents(web_contents());
+}
+
+std::u16string PlutoniumFind::InitialText() const {
+  find_in_page::FindTabHelper* find_helper = helper();
+  if (!find_helper) {
+    return std::u16string();
+  }
+  std::u16string text = find_helper->find_text();
+  return text.empty() ? find_helper->GetInitialSearchText() : text;
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PlutoniumFind);
