@@ -0,0 +1,166 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PLUTONIUM_DOWNLOADS_H_
+#define CHROME_BROWSER_PLUTONIUM_DOWNLOADS_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/scoped_multi_source_observation.h"
+#include "base/values.h"
+#include "components/download/public/common/download_item.h"
+#include "content/public/browser/download_manager.h"
+
+namespace content {
+class BrowserContext;
+}
+
+// EXO-TAB-FEATURES (docs/features/TAB_FEATURES.md, "Downloads"): the shells'
+// downloads. Chrome's download manager already saves what tabs download; its
+// UI (Ash notifications on ChromeOS) doesn't show in shell mode. This lists
+// the downloads for the shells (navigator.windowBroker's "downloadadded",
+// "downloadchanged" and "downloadremoved") and agents (the DevTools Plutonium
+// domain), with the thread each came from: the origin tag of the tab that
+// started it, kept even after the tab closes.
+//
+// Where files go (FolderFor()): ~/Downloads (the XDG download folder), unless
+// a shell set a folder for the thread, or a default for its own threads
+// (SetFolder()): "thread" (~/Downloads/<thread label>/) or a path, such as a
+// ".downloads" folder in the thread's working directory. An agent's tab
+// downloads where the user's tabs in its thread do.
+//
+// A tab whose first navigation became a download (a link opened in a new tab)
+// closes, as Chrome closes such a tab in its tab strip. Downloads from earlier
+// runs (Chrome's history) aren't listed.
+class PlutoniumDownloads : public content::DownloadManager::Observer,
+                           public download::DownloadItem::Observer {
+ public:
+  // Downloads as JSON objects (ToValue()): {id, tabId, thread, url,
+  // filename, path, mime, receivedBytes, totalBytes, state ("in-progress",
+  // "paused", "complete", "cancelled", "interrupted"), danger? (Chrome's
+  // danger type, while the file waits on "keep" or "discard"), error? (why
+  // it was interrupted), canResume, startTime (ms since the epoch)}.
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnDownloadAdded(const base::DictValue& download) {}
+    virtual void OnDownloadChanged(const base::DictValue& download) {}
+    virtual void OnDownloadRemoved(int32_t id) {}
+  };
+
+  // (ok, why not).
+  using CommandCallback =
+      base::OnceCallback<void(bool ok, const std::string& error)>;
+  // Opens a downloaded file (or, with |show|, its folder) in |thread| (its
+  // environment): the helper does, as the user. Set by Ash's main parts.
+  using Opener = base::RepeatingCallback<void(const base::FilePath& path,
+                                              const std::string& thread,
+                                              bool show,
+                                              CommandCallback done)>;
+
+  // Created on first use; lives until the browser exits.
+  static PlutoniumDownloads* Get();
+
+  PlutoniumDownloads(const PlutoniumDownloads&) = delete;
+  PlutoniumDownloads& operator=(const PlutoniumDownloads&) = delete;
+
+  // The folder |item| goes to (DownloadTargetDeterminer, for downloads that
+  // don't ask where), or nullopt outside shell mode (Chrome's own folder).
+  static std::optional<base::FilePath> FolderFor(download::DownloadItem* item);
+
+  void SetOpener(Opener opener);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Lists |context|'s downloads from now on (once per context).
+  void ObserveContext(content::BrowserContext* context);
+
+  // Every download, oldest first.
+  std::vector<base::DictValue> GetDownloads() const;
+
+  // Runs |command| on download |id|: "pause", "resume", "cancel", "open",
+  // "show", "keep" (a dangerous file: keep it), "discard" (a dangerous file:
+  // delete it), or "remove" (from the list; the file stays). An agent
+  // (|from_agent|) may not "keep".
+  void RunCommand(int32_t id,
+                  const std::string& command,
+                  bool from_agent,
+                  CommandCallback done);
+
+  // Shell |shell_id|'s download folder for thread |tag|, or with an empty
+  // |tag| for every thread it owns (PlutoniumGroups) that has no folder of
+  // its own: "downloads" (~/Downloads), "thread" (~/Downloads/<label>/), an
+  // absolute path (a leading "~/" is the home folder), or "" to go back to
+  // the default.
+  void SetFolder(const std::string& shell_id,
+                 const std::string& tag,
+                 const std::string& folder);
+
+  // content::DownloadManager::Observer:
+  void OnDownloadCreated(content::DownloadManager* manager,
+                         download::DownloadItem* item) override;
+  void ManagerGoingDown(content::DownloadManager* manager) override;
+
+  // download::DownloadItem::Observer:
+  void OnDownloadUpdated(download::DownloadItem* item) override;
+  void OnDownloadRemoved(download::DownloadItem* item) override;
+  void OnDownloadDestroyed(download::DownloadItem* item) override;
+
+ private:
+  friend class base::NoDestructor<PlutoniumDownloads>;
+
+  struct Record {
+    Record();
+    Record(Record&&);
+    Record& operator=(Record&&);
+    ~Record();
+
+    raw_ptr<download::DownloadItem> item;
+    // The tab that started it (0 for the shell page or another page), and
+    // that tab's origin tag (its thread), or "".
+    int32_t tab_id = 0;
+    std::string thread;
+    // What observers last got.
+    base::DictValue last;
+  };
+
+  PlutoniumDownloads();
+  ~PlutoniumDownloads() override;
+
+  base::DictValue ToValue(int32_t id, const Record& record) const;
+  // |item|'s id here, or 0.
+  int32_t IdOf(download::DownloadItem* item) const;
+  void Forget(download::DownloadItem* item);
+  // The folder for a download from |thread| ("" for none).
+  base::FilePath ResolveFolder(const std::string& thread) const;
+  // ~/Downloads, or the XDG download folder once read.
+  base::FilePath DefaultFolder() const;
+  void OnDefaultFolder(const base::FilePath& folder);
+
+  int32_t next_id_ = 1;
+  std::map<int32_t, Record> records_;
+  std::map<download::DownloadItem*, int32_t> ids_;
+  // By shell id, then by tag ("" for the shell's default).
+  std::map<std::string, std::map<std::string, std::string>> folders_;
+  base::FilePath xdg_folder_;
+  Opener opener_;
+  base::ObserverList<Observer> observers_;
+  base::ScopedMultiSourceObservation<content::DownloadManager,
+                                     content::DownloadManager::Observer>
+      manager_observations_{this};
+  base::ScopedMultiSourceObservation<download::DownloadItem,
+                                     download::DownloadItem::Observer>
+      item_observations_{this};
+};
+
+#endif  // CHROME_BROWSER_PLUTONIUM_DOWNLOADS_H_
diff --git a/chrome/browser/plutonium_file_chooser.cc b/chrome/browser/plutonium_file_chooser.cc
new file mode 100644
index 0000000000..3a99dfe6e0
--- /dev/null
+++ b/chrome/browser/plutonium_file_chooser.cc
@@ -0,0 +1,381 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/plutonium_file_chooser.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/supports_user_data.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/values.h"
+#include "chrome/browser/plutonium_tab_requests.h"
+#include "chrome/browser/plutonium_shell.h"
+#include "chrome/browser/plutonium_tabs.h"
+#include "chrome/browser/ui/select_file_policy/chrome_select_file_policy.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tracker.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+#include "ui/shell_dialogs/select_file_policy.h"
+#include "ui/shell_dialogs/selected_file_info.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace {
+
+using From = PlutoniumTabRequests::From;
+using FallbackReason = PlutoniumTabRequests::FallbackReason;
+
+// The folder a shell or an agent answered a tab's folder upload with.
+const char kConfirmedFolderKey[] = "plutonium-confirmed-upload-folder";
+
+struct ConfirmedFolder : public base::SupportsUserData::Data {
+  explicit ConfirmedFolder(base::FilePath folder) : path(std::move(folder)) {}
+  base::FilePath path;
+};
+
+const char* ModeName(ui::SelectFileDialog::Type type) {
+  switch (type) {
+    case ui::SelectFileDialog::SELECT_OPEN_MULTI_FILE:
+      return "open-multiple";
+    case ui::SelectFileDialog::SELECT_FOLDER:
+    case ui::SelectFileDialog::SELECT_UPLOAD_FOLDER:
+    case ui::SelectFileDialog::SELECT_EXISTING_FOLDER:
+      return "folder";
+    case ui::SelectFileDialog::SELECT_SAVEAS_FILE:
+      return "save";
+    case ui::SelectFileDialog::SELECT_NONE:
+    case ui::SelectFileDialog::SELECT_OPEN_FILE:
+      return "open";
+  }
+  return "open";
+}
+
+// A tab's or a shell page's picker: asks the shell (a "fileChooser" request), and opens
+// the fallback factory's picker if no shell takes it.
+class PlutoniumSelectFileDialog : public ui::SelectFileDialog {
+ public:
+  PlutoniumSelectFileDialog(Listener* listener,
+                            std::unique_ptr<ui::SelectFilePolicy> policy,
+                            content::WebContents* contents,
+                            ui::SelectFileDialogFactory* fallback)
+      : SelectFileDialog(listener, std::move(policy)),
+        contents_(contents->GetWeakPtr()),
+        fallback_factory_(fallback) {}
+
+  PlutoniumSelectFileDialog(const PlutoniumSelectFileDialog&) = delete;
+  PlutoniumSelectFileDialog& operator=(const PlutoniumSelectFileDialog&) =
+      delete;
+
+  // ui::BaseShellDialog:
+  bool IsRunning(gfx::NativeWindow owning_window) const override {
+    if (fallback_dialog_) {
+      return fallback_dialog_->IsRunning(owning_window);
+    }
+    return handle_ && handle_->is_open() &&
+           owning_window_.Contains(owning_window);
+  }
+
+  void ListenerDestroyed() override {
+    listener_ = nullptr;
+    handle_.reset();
+    if (fallback_dialog_) {
+      fallback_dialog_->ListenerDestroyed();
+    }
+  }
+
+ protected:
+  ~PlutoniumSelectFileDialog() override = default;
+
+  // ui::SelectFileDialog:
+  void SelectFileImpl(Type type,
+                      const std::u16string& title,
+                      const base::FilePath& default_path,
+                      const FileTypeInfo* file_types,
+                      int file_type_index,
+                      const base::FilePath::StringType& default_extension,
+                      gfx::NativeWindow owning_window,
+                      const GURL* caller) override {
+    type_ = type;
+    title_ = title;
+    default_path_ = default_path;
+    file_types_.reset();
+    if (file_types) {
+      file_types_.emplace(*file_types);
+    }
+    file_type_index_ = file_type_index;
+    default_extension_ = default_extension;
+    owning_window_.RemoveAll();
+    if (owning_window) {
+      owning_window_.Add(owning_window);
+    }
+    if (caller) {
+      caller_ = *caller;
+    }
+
+    PlutoniumTabRequests::Params params;
+    params.kind = "fileChooser";
+    params.detail = Detail();
+    params.on_answer = base::BindRepeating(
+        &PlutoniumSelectFileDialog::OnAnswer, base::Unretained(this));
+    // The fallback is posted, and may arrive after the handle is gone.
+    params.on_fallback = base::BindOnce(&PlutoniumSelectFileDialog::OnFallback,
+                                        weak_factory_.GetWeakPtr());
+    // on_answer only runs while the request (our handle) is open.
+    handle_ = PlutoniumTabRequests::Get()->Start(contents_.get(),
+                                                 std::move(params));
+    if (!handle_) {
+      // Not a tab after all (it closed meanwhile).
+      PostCancel();
+    }
+  }
+
+  bool HasMultipleFileTypeChoicesImpl() override {
+    return filters_count_ > 1;
+  }
+
+ private:
+  // The request's detail (see plutonium_file_chooser.h).
+  base::DictValue Detail() {
+    base::DictValue detail;
+    detail.Set("mode", ModeName(type_));
+    detail.Set("upload", type_ == SELECT_UPLOAD_FOLDER);
+    detail.Set("title", title_);
+    if (caller_.is_valid()) {
+      detail.Set("origin", url::Origin::Create(caller_).Serialize());
+    }
+    base::ListValue filters;
+    if (file_types_) {
+      const std::vector<std::vector<base::FilePath::StringType>>& extensions =
+          file_types_->extensions;
+      for (size_t i = 0; i < extensions.size(); ++i) {
+        base::ListValue patterns;
+        for (const base::FilePath::StringType& extension : extensions[i]) {
+          patterns.Append("*." + extension);
+        }
+        std::string name;
+        if (i < file_types_->extension_description_overrides.size()) {
+          name = base::UTF16ToUTF8(
+              file_types_->extension_description_overrides[i]);
+        }
+        filters.Append(base::DictValue()
+                           .Set("name", name)
+                           .Set("patterns", std::move(patterns)));
+      }
+      if (file_types_->include_all_files && !extensions.empty()) {
+        filters.Append(
+            base::DictValue()
+                .Set("name", "")
+                .Set("patterns", base::ListValue().Append("*")));
+      }
+    }
+    filters_count_ = filters.size();
+    detail.Set("currentFilter",
+               file_type_index_ > 0 &&
+                       static_cast<size_t>(file_type_index_) <= filters_count_
+                   ? file_type_index_ - 1
+                   : 0);
+    detail.Set("filters", std::move(filters));
+    // A folder and a name, either of which may be missing: the default path
+    // is a folder, a file in one, or (Chrome's default) just a name.
+    std::string name;
+    std::string folder;
+    if (!default_path_.empty()) {
+      if (type_ == SELECT_FOLDER || type_ == SELECT_UPLOAD_FOLDER ||
+          type_ == SELECT_EXISTING_FOLDER) {
+        folder = default_path_.value();
+      } else if (default_path_.IsAbsolute()) {
+        folder = default_path_.DirName().value();
+        name = default_path_.BaseName().value();
+      } else {
+        name = default_path_.BaseName().value();
+      }
+    }
+    detail.Set("currentName", type_ == SELECT_SAVEAS_FILE ? name : "");
+    detail.Set("currentFolder", folder);
+    detail.Set("defaultExtension", default_extension_);
+    return detail;
+  }
+
+  // {paths: [...], filter?}, or null (or no paths) to cancel. False if it
+  // isn't an answer this picker takes.
+  bool OnAnswer(From from, const base::Value& answer) {
+    std::vector<ui::SelectedFileInfo> files;
+    int filter = file_type_index_;
+    if (answer.is_dict()) {
+      const base::DictValue& dict = answer.GetDict();
+      const base::ListValue* paths = dict.FindList("paths");
+      if (!paths && dict.Find("paths")) {
+        return false;
+      }
+      if (paths) {
+        for (const base::Value& value : *paths) {
+          if (!value.is_string()) {
+            return false;
+          }
+          base::FilePath path(value.GetString());
+          if (!path.IsAbsolute() || path.ReferencesParent()) {
+            return false;
+          }
+          path = path.StripTrailingSeparators();
+          if (type_ == SELECT_SAVEAS_FILE && !default_extension_.empty() &&
+              path.Extension().empty()) {
+            path = path.AddExtension(default_extension_);
+          }
+          files.emplace_back(path);
+        }
+      }
+      if (files.size() > 1 && type_ != SELECT_OPEN_MULTI_FILE) {
+        return false;
+      }
+      if (std::optional<int> index = dict.FindInt("filter")) {
+        if (*index < 0 || static_cast<size_t>(*index) >= filters_count_) {
+          return false;
+        }
+        filter = *index + 1;
+      }
+    } else if (!answer.is_none()) {
+      return false;
+    }
+    if (type_ == SELECT_UPLOAD_FOLDER && files.size() == 1 && contents_) {
+      contents_->SetUserData(
+          kConfirmedFolderKey,
+          std::make_unique<ConfirmedFolder>(files.front().path()));
+    }
+    VLOG(1) << "EXO-TAB-FEATURES fileChooser answered by the "
+            << (from == From::kShell ? "shell" : "agent") << ": "
+            << files.size() << " path(s)";
+    // The listener may let go of us: tell it later, keeping us alive.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&PlutoniumSelectFileDialog::Notify,
+                                  base::WrapRefCounted(this), std::move(files),
+                                  filter));
+    return true;
+  }
+
+  void Notify(std::vector<ui::SelectedFileInfo> files, int filter) {
+    if (!listener_) {
+      return;
+    }
+    if (files.empty()) {
+      listener_->FileSelectionCanceled();
+    } else if (type_ == SELECT_OPEN_MULTI_FILE) {
+      listener_->MultiFilesSelected(files);
+    } else {
+      listener_->FileSelected(files.front(), filter);
+    }
+  }
+
+  // No shell took it: the fallback factory's picker (the Files app's).
+  void OnFallback(FallbackReason reason) {
+    if (!listener_) {
+      return;
+    }
+    // A shell page's own picker when that shell went away: the page that asked
+    // is what's gone (a reload), so there is no one to pick for.
+    const bool own_page_gone =
+        reason == PlutoniumTabRequests::FallbackReason::kShellGone && contents_ &&
+        !PlutoniumTabs::Get()->IsTab(contents_.get());
+    if (!fallback_factory_ || !contents_ || own_page_gone) {
+      Notify({}, 0);
+      return;
+    }
+    VLOG(1) << "EXO-TAB-FEATURES fileChooser: no shell took it, opening the "
+               "fallback picker";
+    fallback_dialog_ = fallback_factory_->Create(
+        listener_, std::make_unique<ChromeSelectFilePolicy>(contents_.get()));
+    if (!fallback_dialog_) {
+      Notify({}, 0);
+      return;
+    }
+    gfx::NativeWindow owning_window = gfx::NativeWindow();
+    if (!owning_window_.windows().empty()) {
+      owning_window = owning_window_.windows().front().get();
+    }
+    fallback_dialog_->SelectFile(
+        type_, title_, default_path_,
+        file_types_ ? &file_types_.value() : nullptr, file_type_index_,
+        default_extension_, owning_window,
+        caller_.is_valid() ? &caller_ : nullptr);
+  }
+
+  void PostCancel() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PlutoniumSelectFileDialog::Notify,
+                       base::WrapRefCounted(this),
+                       std::vector<ui::SelectedFileInfo>(), 0));
+  }
+
+  base::WeakPtr<content::WebContents> contents_;
+  raw_ptr<ui::SelectFileDialogFactory, LeakedDanglingUntriaged>
+      fallback_factory_;
+  std::unique_ptr<PlutoniumTabRequests::Handle> handle_;
+  scoped_refptr<ui::SelectFileDialog> fallback_dialog_;
+
+  // What SelectFile() got, for the request and the fallback.
+  Type type_ = SELECT_NONE;
+  std::u16string title_;
+  base::FilePath default_path_;
+  std::optional<FileTypeInfo> file_types_;
+  int file_type_index_ = 0;
+  base::FilePath::StringType default_extension_;
+  aura::WindowTracker owning_window_;
+  GURL caller_;
+  size_t filters_count_ = 0;
+  base::WeakPtrFactory<PlutoniumSelectFileDialog> weak_factory_{this};
+};
+
+}  // namespace
+
+PlutoniumSelectFileDialogFactory::PlutoniumSelectFileDialogFactory(
+    std::unique_ptr<ui::SelectFileDialogFactory> fallback)
+    : fallback_(std::move(fallback)) {}
+
+PlutoniumSelectFileDialogFactory::~PlutoniumSelectFileDialogFactory() =
+    default;
+
+ui::SelectFileDialog* PlutoniumSelectFileDialogFactory::Create(
+    ui::SelectFileDialog::Listener* listener,
+    std::unique_ptr<ui::SelectFilePolicy> policy) {
+  content::WebContents* contents =
+      ChromeSelectFilePolicy::GetSourceContents(policy.get());
+  // A tab's picker, or the shell page's own (an <input type=file> in it): the
+  // page is the shell, so it is asked about itself, with tab id 0.
+  if (contents && (PlutoniumTabs::Get()->IsTab(contents) ||
+                   plutonium_shell::IsShellWindowContents(contents))) {
+    return new PlutoniumSelectFileDialog(listener, std::move(policy), contents,
+                                         fallback_.get());
+  }
+  if (fallback_) {
+    return fallback_->Create(listener, std::move(policy));
+  }
+  return nullptr;
+}
+
+bool PlutoniumTakeFolderUploadConfirmed(content::WebContents* contents,
+                                        const base::FilePath& folder) {
+  if (!contents) {
+    return false;
+  }
+  auto* confirmed =
+      static_cast<ConfirmedFolder*>(contents->GetUserData(kConfirmedFolderKey));
+  if (!confirmed) {
+    return false;
+  }
+  const bool same = confirmed->path == folder.StripTrailingSeparators();
+  contents->RemoveUserData(kConfirmedFolderKey);
+  return same;
+}
