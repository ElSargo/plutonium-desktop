+
+void AskFileSystemAccess(
+    const FileSystemAccessPermissionRequestManager::RequestData& request,
+    base::OnceCallback<void(permissions::PermissionAction result)> callback,
+    content::WebContents* contents) {
+  using Access = FileSystemAccessPermissionRequestManager::Access;
+  struct State {
+    std::unique_ptr<PlutoniumTabRequests::Handle> handle;
+    base::OnceCallback<void(permissions::PermissionAction)> callback;
+  };
+  // Lives as long as the request (its fallback holds it).
+  auto state = std::make_shared<State>();
+  state->callback = std::move(callback);
+
+  bool write = false;
+  bool directory = false;
+  base::ListValue files;
+  for (const auto& file : request.file_request_data) {
+    write = write || file.access != Access::kRead;
+    directory =
+        directory ||
+        file.handle_type ==
+            content::FileSystemAccessPermissionContext::HandleType::kDirectory;
+    files.Append(file.path_info.display_name);
+  }
+  const std::vector<std::string> types = {write ? "file-write" : "file-read"};
+  PlutoniumTabRequests::Params params;
+  params.kind = kKind;
+  params.detail = Detail(contents, request.origin, types, {"once"})
+                      .Set("files", std::move(files))
+                      .Set("directory", directory);
+  params.on_answer = base::BindRepeating(
+      [](std::weak_ptr<State> weak, base::WeakPtr<content::WebContents> tab,
+         url::Origin origin, std::vector<std::string> types, From from,
+         const base::Value& value) {
+        std::shared_ptr<State> state = weak.lock();
+        std::optional<Decision> decision = ParseDecision(value, {"once"});
+        if (!state || !state->callback || !decision ||
+            (from == From::kAgent && decision->answer == Answer::kAllow)) {
+          return false;
+        }
+        Unblock(tab.get(), origin, types);
+        std::move(state->callback)
+            .Run(decision->answer == Answer::kAllow
+                     ? permissions::PermissionAction::GRANTED
+                 : decision->answer == Answer::kDeny
+                     ? permissions::PermissionAction::DENIED
+                     : permissions::PermissionAction::DISMISSED);
+        return true;
+      },
+      std::weak_ptr<State>(state), contents->GetWeakPtr(), request.origin,
+      types);
+  params.on_fallback = base::BindOnce(
+      [](std::shared_ptr<State> state, base::WeakPtr<content::WebContents> tab,
+         url::Origin origin, std::vector<std::string> types,
+         FallbackReason reason) {
+        Block(tab.get(), origin, types);
+        if (state->callback) {
+          std::move(state->callback)
+              .Run(permissions::PermissionAction::DISMISSED);
+        }
+      },
+      state, contents->GetWeakPtr(), request.origin, types);
+  state->handle = PlutoniumTabRequests::Get()->Start(contents, std::move(params));
+  if (!state->handle && state->callback) {
+    std::move(state->callback).Run(permissions::PermissionAction::DISMISSED);
+  }
+}
+
+void RegisterLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kThreadsPref);
+}
+
+void RunRequestCommand(content::WebContents* contents,
+                       const base::DictValue& args,
+                       PlutoniumTabs::CommandCallback done) {
+  std::optional<PlutoniumTabs::TabInfo> tab =
+      PlutoniumTabs::Get()->GetTabFor(contents);
+  const base::ListValue* names = args.FindList("permissions");
+  url::Origin origin = contents->GetPrimaryMainFrame()->GetLastCommittedOrigin();
+  if (const std::string* given = args.FindString("origin")) {
+    origin = url::Origin::Create(GURL(*given));
+  }
+  if (!tab || !names || names->empty() || origin.opaque()) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  std::vector<std::string> types;
+  std::vector<ContentSettingsType> settings;
+  for (const base::Value& name : *names) {
+    std::optional<ContentSettingsType> setting =
+        name.is_string() ? SettingType(name.GetString()) : std::nullopt;
+    if (!setting) {
+      std::move(done).Run(std::nullopt);
+      return;
+    }
+    if (!std::ranges::contains(types, name.GetString())) {
+      types.push_back(name.GetString());
+      settings.push_back(*setting);
+    }
+  }
+  const std::string thread = tab->tag;
+  // The thread allows them all already: nothing to ask.
+  if (!thread.empty() &&
+      std::ranges::all_of(types, [&](const std::string& type) {
+        return GetThreadDecision(thread, origin.Serialize(), type) == true;
+      })) {
+    std::move(done).Run(base::Value(base::DictValue()
+                                        .Set("answer", "allow")
+                                        .Set("scope", "thread")
+                                        .Set("asked", false)));
+    return;
+  }
+  std::vector<std::string> scopes;
+  if (!thread.empty()) {
+    scopes.push_back("thread");
+  }
+  scopes.push_back("everywhere");
+
+  struct State {
+    std::unique_ptr<PlutoniumTabRequests::Handle> handle;
+    PlutoniumTabs::CommandCallback done;
+  };
+  // Lives as long as the request (its fallback holds it).
+  auto state = std::make_shared<State>();
+  state->done = std::move(done);
+  PlutoniumTabRequests::Params params;
+  params.kind = kKind;
+  params.detail = Detail(contents, origin, types, scopes);
+  if (const std::string* by = args.FindString("by"); by && *by == "agent") {
+    params.detail.Set("by", "agent");
+  }
+  params.on_answer = base::BindRepeating(
+      [](std::weak_ptr<State> weak, base::WeakPtr<content::WebContents> tab,
+         std::string thread, url::Origin origin,
+         std::vector<std::string> types,
+         std::vector<ContentSettingsType> settings,
+         std::vector<std::string> scopes, From from,
+         const base::Value& value) {
+        std::shared_ptr<State> state = weak.lock();
+        std::optional<Decision> decision = ParseDecision(value, scopes);
+        if (!state || !state->done || !tab || !decision ||
+            (from == From::kAgent && decision->answer == Answer::kAllow)) {
+          return false;
+        }
+        if (decision->answer != Answer::kDismiss) {
+          const bool granted = decision->answer == Answer::kAllow;
+          for (size_t i = 0; i < types.size(); ++i) {
+            if (decision->scope == "thread") {
+              SetThreadDecision(thread, origin.Serialize(), types[i], granted);
+            } else if (decision->scope == "everywhere") {
+              SetEverywhere(tab->GetBrowserContext(), origin, settings[i],
+                            granted);
+            }
+          }
+        }
+        Unblock(tab.get(), origin, types);
+        base::DictValue result =
+            base::DictValue().Set("answer", AnswerName(decision->answer));
+        if (decision->answer != Answer::kDismiss) {
+          result.Set("scope", decision->scope);
+        }
+        std::move(state->done).Run(base::Value(std::move(result)));
+        return true;
+      },
+      std::weak_ptr<State>(state), contents->GetWeakPtr(), thread, origin,
+      types, settings, scopes);
+  params.on_fallback = base::BindOnce(
+      [](std::shared_ptr<State> state, FallbackReason reason) {
+        if (state->done) {
+          std::move(state->done)
+              .Run(base::Value(base::DictValue()
+                                   .Set("answer", "dismiss")
+                                   .Set("fallback",
+                                        reason == FallbackReason::kNotTaken
+                                            ? "notTaken"
+                                            : "shellGone")));
+        }
+      },
+      state);
+  state->handle = PlutoniumTabRequests::Get()->Start(contents, std::move(params));
+  if (!state->handle && state->done) {
+    std::move(state->done).Run(std::nullopt);
+  }
+}
+
+void RunListCommand(content::WebContents* contents,
+                    const base::DictValue& args,
+                    PlutoniumTabs::CommandCallback done) {
+  std::optional<PlutoniumTabs::TabInfo> tab =
+      PlutoniumTabs::Get()->GetTabFor(contents);
+  if (!tab) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  base::ListValue decisions;
+  if (!tab->tag.empty()) {
+    decisions = ListThreadDecisions(tab->tag, std::string());
+  }
+  // Chrome's own settings for the page's origin.
+  const url::Origin origin =
+      contents->GetPrimaryMainFrame()->GetLastCommittedOrigin();
+  HostContentSettingsMap* map =
+      HostContentSettingsMapFactory::GetForProfile(
+          contents->GetBrowserContext());
+  if (!origin.opaque() && map) {
+    const GURL url = origin.GetURL();
+    std::vector<ContentSettingsType> seen;
+    for (int i = 0;
+         i <= static_cast<int>(permissions::RequestType::kMaxValue); ++i) {
+      const std::string name =
+          TypeName(static_cast<permissions::RequestType>(i));
+      std::optional<ContentSettingsType> type = SettingType(name);
+      if (!type || std::ranges::contains(seen, *type)) {
+        continue;
+      }
+      seen.push_back(*type);
+      const content_settings::PermissionSettingsInfo* info =
+          content_settings::PermissionSettingsRegistry::GetInstance()->Get(
+              *type);
+      const PermissionSetting setting =
+          map->GetUserModifiablePermissionSetting(url, url, *type);
+      if (setting == map->GetDefaultPermissionSetting(*type)) {
+        continue;
+      }
+      const char* decision =
+          info->delegate().IsAnyPermissionAllowed(setting) ? "allow"
+          : info->delegate().IsBlocked(setting)             ? "block"
+                                                            : nullptr;
+      if (!decision) {
+        continue;
+      }
+      decisions.Append(base::DictValue()
+                           .Set("origin", origin.Serialize())
+                           .Set("permission", name)
+                           .Set("decision", decision)
+                           .Set("scope", "everywhere"));
+    }
+  }
+  std::move(done).Run(base::Value(base::DictValue()
+                                      .Set("thread", tab->tag)
+                                      .Set("decisions", std::move(decisions))));
+}
+
+void RunRevokeCommand(content::WebContents* contents,
+                      const base::DictValue& args,
+                      PlutoniumTabs::CommandCallback done) {
+  std::optional<PlutoniumTabs::TabInfo> tab =
+      PlutoniumTabs::Get()->GetTabFor(contents);
+  const std::string* scope = args.FindString("scope");
+  const std::string* origin = args.FindString("origin");
+  const std::string* permission = args.FindString("permission");
+  if (!tab) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  if (!scope || *scope == "thread") {
+    std::string origin_key;
+    if (origin) {
+      const url::Origin parsed = url::Origin::Create(GURL(*origin));
+      origin_key = parsed.opaque() ? *origin : parsed.Serialize();
+    }
+    const int revoked = RevokeThreadDecisions(
+        tab->tag, origin_key, permission ? *permission : std::string());
+    std::move(done).Run(
+        base::Value(base::DictValue().Set("revoked", revoked)));
+    return;
+  }
+  std::optional<ContentSettingsType> type =
+      permission ? SettingType(*permission) : std::nullopt;
+  const url::Origin target =
+      origin ? url::Origin::Create(GURL(*origin))
+             : contents->GetPrimaryMainFrame()->GetLastCommittedOrigin();
+  if (*scope != "everywhere" || !type || target.opaque()) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  SetEverywhere(contents->GetBrowserContext(), target, *type, std::nullopt);
+  std::move(done).Run(base::Value(base::DictValue().Set("revoked", 1)));
+}
+
+void RunShellCommand(const std::string& command,
+                     const std::string& args_json,
+                     base::OnceCallback<void(bool, const std::string&)> done) {
+  base::DictValue args;
+  if (!args_json.empty()) {
+    std::optional<base::DictValue> parsed =
+        base::JSONReader::ReadDict(args_json, base::JSON_PARSE_RFC);
+    if (!parsed) {
+      std::move(done).Run(false, "args must be a JSON object");
+      return;
+    }
+    args = std::move(*parsed);
+  }
+  const std::string* thread = args.FindString("thread");
+  const std::string* origin = args.FindString("origin");
+  const std::string* permission = args.FindString("permission");
+  base::Value result;
+  if (command == "list") {
+    result = base::Value(
+        ListThreadDecisions(thread ? *thread : std::string(),
+                            origin ? *origin : std::string()));
+  } else if (command == "revoke") {
+    if (!thread || thread->empty()) {
+      std::move(done).Run(false, "thread is required");
+      return;
+    }
+    result = base::Value(base::DictValue().Set(
+        "revoked",
+        RevokeThreadDecisions(*thread, origin ? *origin : std::string(),
+                              permission ? *permission : std::string())));
+  } else {
+    std::move(done).Run(false, "Unknown command: " + command);
+    return;
+  }
+  std::string json;
+  base::JSONWriter::Write(result, &json);
+  std::move(done).Run(true, json);
+}
+
+}  // namespace plutonium_permissions
