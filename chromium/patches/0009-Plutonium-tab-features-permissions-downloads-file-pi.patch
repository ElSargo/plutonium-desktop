+void RenderViewContextMenuBase::FilterMenuItems(
+    base::FunctionRef<bool(int command_id)> keep) {
+  for (size_t index = menu_model_.GetItemCount(); index > 0; --index) {
+    if (menu_model_.GetTypeAt(index - 1) !=
+            ui::MenuModel::ItemType::TYPE_SEPARATOR &&
+        !keep(menu_model_.GetCommandIdAt(index - 1))) {
+      menu_model_.RemoveItemAt(index - 1);
+    }
+  }
+  for (size_t index = menu_model_.GetItemCount(); index > 0; --index) {
+    const bool separator = menu_model_.GetTypeAt(index - 1) ==
+                           ui::MenuModel::ItemType::TYPE_SEPARATOR;
+    if (separator &&
+        (index == 1 || index == menu_model_.GetItemCount() ||
+         menu_model_.GetTypeAt(index - 2) ==
+             ui::MenuModel::ItemType::TYPE_SEPARATOR)) {
+      menu_model_.RemoveItemAt(index - 1);
+    }
+  }
+  if (toolkit_delegate_) {
+    toolkit_delegate_->RebuildMenu();
+  }
+}
