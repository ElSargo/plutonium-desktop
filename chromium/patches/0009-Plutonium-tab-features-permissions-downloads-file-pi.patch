+// Runs |on_gone| when |contents| goes or shows another page.
+class GoneObserver : public content::WebContentsObserver {
+ public:
+  GoneObserver(content::WebContents* contents, base::OnceClosure on_gone)
+      : content::WebContentsObserver(contents), on_gone_(std::move(on_gone)) {}
+
+  void WebContentsDestroyed() override { Gone(); }
+  void PrimaryPageChanged(content::Page& page) override { Gone(); }
+
+ private:
+  void Gone() {
+    Observe(nullptr);
+    if (on_gone_) {
+      std::move(on_gone_).Run();
+    }
+  }
+
+  base::OnceClosure on_gone_;
+};
