+// The menu the shell was last asked to show.
+class Pending {
+ public:
+  Pending(int32_t id,
+          content::WebContents* source,
+          content::WebContents* shell,
+          std::unique_ptr<RenderViewContextMenuBase> menu,
+          std::vector<Target> targets)
+      : id_(id),
+        source_(source),
+        shell_(shell),
+        menu_(std::move(menu)),
+        targets_(std::move(targets)),
+        source_gone_(source,
+                     base::BindOnce(&Pending::OnSourceGone,
+                                    base::Unretained(this))),
+        shell_gone_(shell,
+                    base::BindOnce(&Pending::OnShellGone,
+                                   base::Unretained(this))) {}
+
+  int32_t id() const { return id_; }
+  content::WebContents* shell() const { return shell_; }
+
+  // The shell's answer to the request (whether it shows the menu).
+  void OnRequestAnswered(bool handled) {
+    if (!menu_ || native_) {
+      return;
+    }
+    if (handled) {
+      // Shown, as far as the page is concerned (until MenuClosed()).
+      shown_ = true;
+      menu_->OnMenuWillShow(
+          const_cast<ui::SimpleMenuModel*>(&menu_->menu_model()));
+      // A tab's menu: the keyboard is the shell's while it shows it.
+      if (source_ != shell_) {
+        if (content::SurfaceEmbedConnector* connector =
+                source_->GetSurfaceEmbedConnector()) {
+          connector->ClearFocusOnInnerWebContents();
+        }
+        shell_->Focus();
+      }
+      return;
+    }
+    VLOG(1) << "EXO-CHROME menu #" << id_
+            << ": the shell doesn't show it, Chrome does";
+    ShowNatively();
+  }
+
+  void ShowNatively() {
+    native_ = true;
+    menu_->Show();
+  }
+
+  // Runs |item_id| (if not 0) and closes the menu. Destroys this.
+  static void Close(int32_t item_id) {
+    std::unique_ptr<Pending> self = std::move(Current());
+    if (!self || self->native_ || !self->menu_) {
+      return;
+    }
+    if (item_id > 0 && static_cast<size_t>(item_id) <= self->targets_.size()) {
+      const Target& target = self->targets_[item_id - 1];
+      if (target.model->IsEnabledAt(target.index) &&
+          TypeOf(target.model->GetTypeAt(target.index)) !=
+              ContextMenuItemType::kSubmenu) {
+        VLOG(1) << "EXO-CHROME menu #" << self->id_ << ": running "
+                << target.model->GetCommandIdAt(target.index);
+        // A tab's menu: the tab gets back the focus it gave the shell first.
+        // Spelling suggestions, paste, cut, undo, select all and the like
+        // act on the focused frame; without it they did nothing. (The shell
+        // focusing its <embed> again comes later, over another pipe.)
+        if (self->shown_ && self->source_ != self->shell_) {
+          if (content::SurfaceEmbedConnector* connector =
+                  self->source_->GetSurfaceEmbedConnector()) {
+            connector->FocusInnerWebContents();
+          } else {
+            self->source_->Focus();
+          }
+        }
+        target.model->ActivatedAt(target.index, /*event_flags=*/0);
+      }
+    }
+    // Running it may have closed the page.
+    if (self->menu_ && self->shown_) {
+      self->menu_->MenuClosed(
+          const_cast<ui::SimpleMenuModel*>(&self->menu_->menu_model()));
+    }
+  }
+
+  static std::unique_ptr<Pending>& Current() {
+    static base::NoDestructor<std::unique_ptr<Pending>> current;
+    return *current;
+  }
+
+ private:
+  // The menu points into its page: it goes with it, now.
+  void OnSourceGone() {
+    menu_.reset();
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(Current()));
+  }
+
+  // Nobody can answer any more.
+  void OnShellGone() {
+    if (!native_) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(
+                         [](int32_t id) {
+                           if (Current() && Current()->id() == id) {
+                             Close(0);
+                           }
+                         },
+                         id_));
+    }
+  }
+
+  const int32_t id_;
+  const raw_ptr<content::WebContents> source_;
+  const raw_ptr<content::WebContents> shell_;
+  std::unique_ptr<RenderViewContextMenuBase> menu_;
+  const std::vector<Target> targets_;
+  bool native_ = false;
+  // The shell took it.
+  bool shown_ = false;
+  GoneObserver source_gone_;
+  GoneObserver shell_gone_;
+};
+
+}  // namespace
+
+bool MaybeShow(content::WebContents* source,
+               std::unique_ptr<RenderViewContextMenuBase>& menu) {
+  if (!plutonium_shell::IsShellMode() || !source || !menu) {
+    return false;
+  }
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  std::optional<PlutoniumTabs::TabInfo> tab =
+      PlutoniumTabs::Get()->GetTabFor(source);
+  content::WebContents* shell = nullptr;
+  if (tab) {
+    shell = PlutoniumTabs::Get()->shell();
+  } else if (shells && shells->GetShellFor(source)) {
+    shell = source;
+  } else {
+    return false;
+  }
+
+  const bool is_tab = tab.has_value();
+  menu->FilterMenuItems([is_tab](int id) { return Keeps(id, is_tab); });
+
+  // A new menu replaces one the shell still shows.
+  if (Pending::Current()) {
+    Pending::Close(0);
+  }
+
+  std::vector<Target> targets;
+  std::vector<Node> nodes = Collect(
+      const_cast<ui::SimpleMenuModel*>(&menu->menu_model()), is_tab, targets);
+  static int32_t next_id = 1;
+  auto request = blink::mojom::ContextMenuRequest::New();
+  request->id = next_id++;
+  request->tab_id = is_tab ? tab->id : 0;
+  const content::ContextMenuParams& params = menu->params();
+  request->x = params.x;
+  request->y = params.y;
+  Flatten(nodes, 0, request->items);
+  if (params.link_url.is_valid()) {
+    request->link_url = params.link_url.spec();
+  }
+  request->selection_text = base::UTF16ToUTF8(params.selection_text);
+  request->editable = params.is_editable;
+  request->media_type = MediaTypeOf(params.media_type);
+  if (request->items.empty() || !shell) {
+    // Nothing left (Chrome shows no empty menu either), or no shell to ask
+    // (none visible): Chrome's.
+    Pending::Current() = std::make_unique<Pending>(
+        request->id, source, source, std::move(menu), std::move(targets));
+    Pending::Current()->ShowNatively();
+    return true;
+  }
+
+  const int32_t id = request->id;
+  Pending::Current() = std::make_unique<Pending>(id, source, shell,
+                                                 std::move(menu),
+                                                 std::move(targets));
+  const bool asked = plutonium_shell::RequestContextMenu(
+      shell, std::move(request), base::BindOnce([](int32_t id, bool handled) {
+        if (Pending::Current() && Pending::Current()->id() == id) {
+          Pending::Current()->OnRequestAnswered(handled);
+        }
+      }, id));
+  if (!asked) {
+    Pending::Current()->ShowNatively();
+  }
+  return true;
+}
+
+void OnClosedByShell(content::WebContents* shell,
+                     int32_t menu_id,
+                     int32_t item_id) {
+  if (!Pending::Current() || Pending::Current()->id() != menu_id ||
+      Pending::Current()->shell() != shell) {
+    return;
+  }
+  Pending::Close(item_id);
+}
+
+}  // namespace plutonium_context_menu
