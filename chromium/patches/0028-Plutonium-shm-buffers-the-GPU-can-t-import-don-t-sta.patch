diff --git a/components/exo/wayland/wl_shm.cc b/components/exo/wayland/wl_shm.cc
index 0a517f4f9e..fff749f32e 100644
--- a/components/exo/wayland/wl_shm.cc
+++ b/components/exo/wayland/wl_shm.cc
@@ -7,6 +7,7 @@
 #include <wayland-server-protocol-core.h>
 
 #include <algorithm>
+#include <optional>
 
 #include "base/functional/bind.h"
 #include "components/exo/buffer.h"
@@ -39,6 +40,18 @@ const struct shm_supported_format {
     {WL_SHM_FORMAT_XRGB8888, viz::SinglePlaneFormat::kBGRX_8888},
     {WL_SHM_FORMAT_ARGB8888, viz::SinglePlaneFormat::kBGRA_8888}};
 
+// EXO-IMPORT: the format with an alpha channel in place of an X format's
+// padding.
+std::optional<viz::SharedImageFormat> WithAlpha(viz::SharedImageFormat format) {
+  if (format == viz::SinglePlaneFormat::kBGRX_8888) {
+    return viz::SinglePlaneFormat::kBGRA_8888;
+  }
+  if (format == viz::SinglePlaneFormat::kRGBX_8888) {
+    return viz::SinglePlaneFormat::kRGBA_8888;
+  }
+  return std::nullopt;
+}
+
 void shm_pool_create_buffer(wl_client* client,
                             wl_resource* resource,
                             uint32_t id,
@@ -55,6 +68,22 @@ void shm_pool_create_buffer(wl_client* client,
     return;
   }
 
+  // EXO-IMPORT: a format the GPU can't import as is: an X format is imported
+  // as its A twin, with the alpha byte ignored, and otherwise the buffer is
+  // refused here rather than failing on every commit.
+  viz::SharedImageFormat si_format = supported_format->si_format;
+  bool alpha_is_padding = false;
+  if (!Buffer::CanImportSharedMemoryFormat(si_format)) {
+    std::optional<viz::SharedImageFormat> with_alpha = WithAlpha(si_format);
+    if (!with_alpha || !Buffer::CanImportSharedMemoryFormat(*with_alpha)) {
+      wl_resource_post_error(resource, WL_SHM_ERROR_INVALID_FORMAT,
+                             "the GPU can't import format 0x%x", format);
+      return;
+    }
+    si_format = *with_alpha;
+    alpha_is_padding = true;
+  }
+
   if (offset < 0) {
     wl_resource_post_error(resource, WL_SHM_ERROR_INVALID_FORMAT,
                            "invalid offset %d", offset);
@@ -63,12 +92,12 @@ void shm_pool_create_buffer(wl_client* client,
 
   std::unique_ptr<Buffer> buffer =
       GetUserDataAs<SharedMemory>(resource)->CreateBuffer(
-          gfx::Size(width, height), supported_format->si_format, offset,
-          stride);
+          gfx::Size(width, height), si_format, offset, stride);
   if (!buffer) {
     wl_resource_post_no_memory(resource);
     return;
   }
+  buffer->set_alpha_is_padding(alpha_is_padding);
 
   wl_resource* buffer_resource =
       wl_resource_create(client, &wl_buffer_interface, 1, id);
@@ -134,8 +163,16 @@ void bind_shm(wl_client* client, void* data, uint32_t version, uint32_t id) {
 
   wl_resource_set_implementation(resource, &shm_implementation, data, nullptr);
 
-  for (const auto& supported_format : shm_supported_formats)
-    wl_shm_send_format(resource, supported_format.shm_format);
+  // EXO-IMPORT: only formats the GPU can import, as is or with alpha. (Clients
+  // may assume ARGB8888 and XRGB8888 without being told.)
+  for (const auto& supported_format : shm_supported_formats) {
+    std::optional<viz::SharedImageFormat> with_alpha =
+        WithAlpha(supported_format.si_format);
+    if (Buffer::CanImportSharedMemoryFormat(supported_format.si_format) ||
+        (with_alpha && Buffer::CanImportSharedMemoryFormat(*with_alpha))) {
+      wl_shm_send_format(resource, supported_format.shm_format);
+    }
+  }
 }
 
 }  // namespace wayland
