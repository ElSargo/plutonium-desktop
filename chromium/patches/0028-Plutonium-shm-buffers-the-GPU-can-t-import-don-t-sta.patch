diff --git a/components/exo/buffer.cc b/components/exo/buffer.cc
index 34cbb3e81e..a3426841bd 100644
--- a/components/exo/buffer.cc
+++ b/components/exo/buffer.cc
@@ -10,6 +10,7 @@
 #include <cstddef>
 #include <string_view>
 #include <utility>
+#include <vector>
 
 #include "base/functional/bind.h"
 #include "base/functional/callback_helpers.h"
@@ -124,6 +125,22 @@ bool IsSupportedFormat(viz::SharedImageFormat format) {
   return false;
 }
 
+// EXO-IMPORT: |format| is one the GPU reports on for shared-memory buffers,
+// and it can't import it.
+bool IsUnimportableSharedMemoryFormat(gpu::SharedImageInterface* sii,
+                                      viz::SharedImageFormat format) {
+  if (format != viz::SinglePlaneFormat::kRGBA_8888 &&
+      format != viz::SinglePlaneFormat::kRGBX_8888 &&
+      format != viz::SinglePlaneFormat::kBGRA_8888 &&
+      format != viz::SinglePlaneFormat::kBGRX_8888) {
+    return false;
+  }
+  const std::vector<viz::SharedImageFormat>& formats =
+      sii->GetCapabilities().shared_memory_import_formats;
+  // An empty list is a GPU process that doesn't say.
+  return !formats.empty() && !std::ranges::contains(formats, format);
+}
+
 perfetto::NamedTrack GetTrack(const void* buffer_id) {
   return perfetto::NamedTrack(kBufferInUse,
                               reinterpret_cast<uintptr_t>(buffer_id));
@@ -331,6 +348,17 @@ std::unique_ptr<Buffer::Texture> Buffer::Texture::Create(
     return nullptr;
   }
 
+  // EXO-IMPORT: drop a buffer the GPU can't import rather than try, which
+  // would lose every context of the channel, again on each commit.
+  if (gpu_memory_buffer_handle->type == gfx::SHARED_MEMORY_BUFFER &&
+      IsUnimportableSharedMemoryFormat(sii, format)) {
+    static bool warned = false;
+    LOG_IF(WARNING, !std::exchange(warned, true))
+        << "Exo: the GPU can't import shared-memory buffers as "
+        << format.ToString() << "; not drawing them";
+    return nullptr;
+  }
+
   gpu::SharedImageUsageSet usage = gpu::SHARED_IMAGE_USAGE_RASTER_READ |
                                    gpu::SHARED_IMAGE_USAGE_RASTER_WRITE |
                                    gpu::SHARED_IMAGE_USAGE_DISPLAY_READ;
@@ -608,6 +636,19 @@ Buffer::Buffer(gfx::GpuMemoryBufferHandle gpu_memory_buffer_handle,
 
 Buffer::~Buffer() = default;
 
+// static
+bool Buffer::CanImportSharedMemoryFormat(viz::SharedImageFormat format) {
+  scoped_refptr<viz::RasterContextProvider> context_provider =
+      aura::Env::GetInstance()
+          ->context_factory()
+          ->SharedMainThreadRasterContextProvider();
+  if (!context_provider || !context_provider->SharedImageInterface()) {
+    return true;
+  }
+  return !IsUnimportableSharedMemoryFormat(
+      context_provider->SharedImageInterface(), format);
+}
+
 // static
 std::unique_ptr<Buffer> Buffer::CreateBufferFromGMBHandle(
     gfx::GpuMemoryBufferHandle buffer_handle,
