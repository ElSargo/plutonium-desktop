From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sarol263@student.otago.ac.nz>
Date: Sat, 24 Oct 2026 09:57:57 +1300
Subject: [PATCH 43/49] Plutonium: no clipboard history nudges in shell mode

Ash's clipboard nudges ("Press Search+V to see your clipboard") showed
after copying and pasting between apps and tabs. In shell mode the web
page is the desktop, and Ash's clipboard history isn't its UI.
---
 ash/clipboard/clipboard_nudge_controller.cc | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/ash/clipboard/clipboard_nudge_controller.cc b/ash/clipboard/clipboard_nudge_controller.cc
index c3019be716..627eb27a81 100644
--- a/ash/clipboard/clipboard_nudge_controller.cc
+++ b/ash/clipboard/clipboard_nudge_controller.cc
@@ -15,6 +15,7 @@
 #include "ash/session/session_controller_impl.h"
 #include "ash/shell.h"
 #include "ash/strings/grit/ash_strings.h"
+#include "base/command_line.h"
 #include "base/json/values_util.h"
 #include "base/metrics/histogram_functions.h"
 #include "base/notreached.h"
@@ -369,6 +370,14 @@ void ClipboardNudgeController::OnClipboardHistoryPasted() {
 }
 
 void ClipboardNudgeController::ShowNudge(ClipboardNudgeType nudge_type) {
+  // PLUTONIUM (EXO-CHROME): in shell mode (--plutonium-shell-url) a web page
+  // is the desktop, and Ash's clipboard history and its Search+V aren't its
+  // UI. Copying and pasting between apps and tabs shows no nudges.
+  static const bool shell_mode =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("plutonium-shell-url");
+  if (shell_mode) {
+    return;
+  }
   current_nudge_type_ = nudge_type;
 
   const std::u16string shortcut_key =
