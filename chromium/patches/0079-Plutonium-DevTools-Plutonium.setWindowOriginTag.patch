From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Tue, 27 Oct 2026 22:09:52 +1300
Subject: [PATCH 79/95] Plutonium: DevTools Plutonium.setWindowOriginTag

The helper resolves an untagged window's thread from its client's pid
(Ash in a container can't read the environment). The command lets it name
the window's origin tag once for the browser and every shell, as a
shell's windowBroker.setWindowOriginTag() does.
---
 chrome/browser/devtools/cros_protocol.pdl            | 12 ++++++++++++
 .../browser/devtools/protocol/plutonium_handler.cc   | 11 +++++++++++
 chrome/browser/devtools/protocol/plutonium_handler.h |  3 +++
 3 files changed, 26 insertions(+)

diff --git a/chrome/browser/devtools/cros_protocol.pdl b/chrome/browser/devtools/cros_protocol.pdl
index ab392b29c6..aeb7dfdefe 100644
--- a/chrome/browser/devtools/cros_protocol.pdl
+++ b/chrome/browser/devtools/cros_protocol.pdl
@@ -233,6 +233,18 @@ experimental domain Plutonium
     parameters
       integer id
 
+  # Names window |id|'s origin tag (the thread that started it) when the
+  # browser couldn't read its client's environment, as a shell page's
+  # setWindowOriginTag does: once, for every shell.
+  command setWindowOriginTag
+    parameters
+      integer id
+      string tag
+    returns
+      # False if the browser read the origin itself, it was named already, or
+      # |tag| isn't a valid tag.
+      boolean ok
+
   # Asks the app for this window geometry size (DIPs). Only while no page
   # shows it: then the page decides.
   command resizeWindow
diff --git a/chrome/browser/devtools/protocol/plutonium_handler.cc b/chrome/browser/devtools/protocol/plutonium_handler.cc
index 358bce4d95..8afd615286 100644
--- a/chrome/browser/devtools/protocol/plutonium_handler.cc
+++ b/chrome/browser/devtools/protocol/plutonium_handler.cc
@@ -507,6 +507,17 @@ Response PlutoniumHandler::CloseWindow(int id) {
   return Response::Success();
 }
 
+Response PlutoniumHandler::SetWindowOriginTag(int id,
+                                              const std::string& tag,
+                                              bool* ok) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    return NoWindow();
+  }
+  *ok = broker->SetOriginTag(id, tag);
+  return Response::Success();
+}
+
 Response PlutoniumHandler::ResizeWindow(int id, int width, int height) {
   ExoWindowBroker* broker = ExoWindowBroker::Get();
   std::optional<ExoWindowBroker::WindowInfo> window =
diff --git a/chrome/browser/devtools/protocol/plutonium_handler.h b/chrome/browser/devtools/protocol/plutonium_handler.h
index 75518bc1d7..784ea2f4e0 100644
--- a/chrome/browser/devtools/protocol/plutonium_handler.h
+++ b/chrome/browser/devtools/protocol/plutonium_handler.h
@@ -91,6 +91,9 @@ class PlutoniumHandler : public protocol::Plutonium::Backend,
   protocol::Response SetWindowAwake(int id, bool awake) override;
   protocol::Response SetWindowAgentFocus(int id, bool focused) override;
   protocol::Response CloseWindow(int id) override;
+  protocol::Response SetWindowOriginTag(int id,
+                                       const std::string& tag,
+                                       bool* ok) override;
   protocol::Response ResizeWindow(int id, int width, int height) override;
   protocol::Response SetDisplaysForTesting(
       std::unique_ptr<protocol::Array<std::string>> specs) override;
