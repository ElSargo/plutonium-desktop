From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Tue, 27 Oct 2026 22:09:52 +1300
Subject: [PATCH 78/96] Plutonium: only the shell window is held fullscreen

Shell mode held every browser window in fullscreen, as kiosk mode does,
with no exit bubble, exit button or immersive reveal. Scope it to the
shells' own windows: the backup browser, popups and app windows enter and
leave fullscreen as usual.
---
 chrome/browser/plutonium_shell.cc                  |  8 ++++++++
 chrome/browser/plutonium_shell.h                   |  5 +++++
 .../exclusive_access/exclusive_access_manager.cc   |  4 +++-
 .../ui/exclusive_access/fullscreen_controller.cc   | 14 ++++++++++----
 .../ui/views/frame/browser_frame_view_chromeos.cc  |  5 +++--
 chrome/browser/ui/views/frame/browser_view.cc      | 11 +++++++----
 .../fullscreen_control/fullscreen_control_host.cc  | 11 ++++++-----
 7 files changed, 42 insertions(+), 16 deletions(-)

diff --git a/chrome/browser/plutonium_shell.cc b/chrome/browser/plutonium_shell.cc
index 61f955f0b2..9ce0dd6395 100644
--- a/chrome/browser/plutonium_shell.cc
+++ b/chrome/browser/plutonium_shell.cc
@@ -1371,6 +1371,14 @@ bool IsShellBrowser(BrowserWindowInterface* browser) {
          browser->GetType() == BrowserWindowInterface::TYPE_APP;
 }
 
+bool IsShellWindowContents(content::WebContents* contents) {
+  if (!IsShellMode() || !contents) {
+    return false;
+  }
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  return !shells || shells->GetShellFor(contents).has_value();
+}
+
 bool IsCommandAllowedInShell(int command_id) {
   switch (command_id) {
     case IDC_DEV_TOOLS:
diff --git a/chrome/browser/plutonium_shell.h b/chrome/browser/plutonium_shell.h
index 7e266789cb..30df8b2aab 100644
--- a/chrome/browser/plutonium_shell.h
+++ b/chrome/browser/plutonium_shell.h
@@ -86,6 +86,11 @@ bool IsShellBrowser(BrowserWindowInterface* browser);
 // window), Ctrl+W (close the shell), Ctrl+P, Ctrl+S, F5 and the like do
 // nothing, and the key is the page's alone.
 bool IsCommandAllowedInShell(int command_id);
+// Whether |contents| is a shell's page in its own window (in shell mode;
+// before the shells are set up, any page in shell mode). Kiosk-style
+// fullscreen, always on and without exit instructions, is the shell
+// window's only: other browser windows leave fullscreen as usual.
+bool IsShellWindowContents(content::WebContents* contents);
 
 // In shell mode, opens the shell URL at startup (as --app=<url> with
 // --start-fullscreen). Call before the startup browser is created.
diff --git a/chrome/browser/ui/exclusive_access/exclusive_access_manager.cc b/chrome/browser/ui/exclusive_access/exclusive_access_manager.cc
index 8e92cda791..9f110b8791 100644
--- a/chrome/browser/ui/exclusive_access/exclusive_access_manager.cc
+++ b/chrome/browser/ui/exclusive_access/exclusive_access_manager.cc
@@ -101,7 +101,9 @@ ExclusiveAccessManager::GetExclusiveAccessExitBubbleType() const {
   // want to show exit instructions for browser mode fullscreen.
   bool app_mode = false;
 #if !BUILDFLAG(IS_MAC)  // App mode (kiosk) is not available on Mac yet.
-  app_mode = IsRunningInAppMode() || plutonium_shell::IsShellMode();
+  app_mode = IsRunningInAppMode() ||
+             plutonium_shell::IsShellWindowContents(
+                 exclusive_access_context_->GetWebContentsForExclusiveAccess());
 #endif
 
   if (fullscreen_controller_.IsWindowFullscreenForTabOrPending()) {
diff --git a/chrome/browser/ui/exclusive_access/fullscreen_controller.cc b/chrome/browser/ui/exclusive_access/fullscreen_controller.cc
index 9fd943eeb3..179ebe27fc 100644
--- a/chrome/browser/ui/exclusive_access/fullscreen_controller.cc
+++ b/chrome/browser/ui/exclusive_access/fullscreen_controller.cc
@@ -408,7 +408,9 @@ void FullscreenController::WindowFullscreenStateChanged() {
     NotifyTabExclusiveAccessLost();
   } else {
     toggled_into_fullscreen_ = true;
-    if (!IsRunningInAppMode() && !plutonium_shell::IsShellMode()) {
+    if (!IsRunningInAppMode() &&
+        !plutonium_shell::IsShellWindowContents(
+            exclusive_access_context->GetWebContentsForExclusiveAccess())) {
       exclusive_access_manager()->UpdateBubble(base::NullCallback(),
                                                /*force_update=*/true);
     }
@@ -652,9 +654,13 @@ void FullscreenController::EnterFullscreenModeInternal(
 }
 
 void FullscreenController::ExitFullscreenModeInternal() {
-  // In kiosk mode and in Plutonium's shell mode (EXO-BOOT), we always want to
-  // be fullscreen.
-  if (IsRunningInAppMode() || plutonium_shell::IsShellMode()) {
+  // In kiosk mode and in Plutonium's shell window (EXO-BOOT), we always want
+  // to be fullscreen.
+  if (IsRunningInAppMode() ||
+      plutonium_shell::IsShellWindowContents(
+          exclusive_access_manager()
+              ->context()
+              ->GetWebContentsForExclusiveAccess())) {
     return;
   }
 
diff --git a/chrome/browser/ui/views/frame/browser_frame_view_chromeos.cc b/chrome/browser/ui/views/frame/browser_frame_view_chromeos.cc
index a3e5d427e1..b3794319ff 100644
--- a/chrome/browser/ui/views/frame/browser_frame_view_chromeos.cc
+++ b/chrome/browser/ui/views/frame/browser_frame_view_chromeos.cc
@@ -810,9 +810,10 @@ void BrowserFrameViewChromeOS::OnAppRegistryCacheWillBeDestroyed(
 }
 
 bool BrowserFrameViewChromeOS::ShouldEnableImmersiveModeController() const {
-  // Do not support immersive mode in kiosk, nor in Plutonium's shell mode
+  // Do not support immersive mode in kiosk, nor in Plutonium's shell window
   // (EXO-BOOT): the shell has the whole screen, without a top-edge reveal.
-  if (chromeos::IsKioskSession() || plutonium_shell::IsShellMode()) {
+  if (chromeos::IsKioskSession() ||
+      plutonium_shell::IsShellBrowser(GetBrowserView()->browser())) {
     return false;
   }
 
