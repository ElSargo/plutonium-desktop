   return false;
 #else
   // Kiosk mode is a fullscreen experience, which makes the exit UI
-  // inappropriate. So is Plutonium's shell mode (EXO-BOOT).
-  return !IsRunningInAppMode() && !plutonium_shell::IsShellMode();
+  // inappropriate. So is Plutonium's shell window (EXO-BOOT).
+  return !IsRunningInAppMode() &&
+         !plutonium_shell::IsShellBrowser(browser_view->browser());
 #endif
 }
 
@@ -166,7 +167,7 @@ void FullscreenControlHost::OnKeyEvent(const ui::KeyEvent& event) {
 }
 
 void FullscreenControlHost::OnMouseEvent(const ui::MouseEvent& event) {
