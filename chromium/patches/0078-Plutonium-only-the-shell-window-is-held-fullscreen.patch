+  if (!IsExitUiEnabled(browser_view_)) {
     return;
   }
 
@@ -228,7 +229,7 @@ void FullscreenControlHost::OnTouchEvent(const ui::TouchEvent& event) {
 }
 
 void FullscreenControlHost::OnGestureEvent(const ui::GestureEvent& event) {
-  if (!IsExitUiEnabled()) {
+  if (!IsExitUiEnabled(browser_view_)) {
     return;
