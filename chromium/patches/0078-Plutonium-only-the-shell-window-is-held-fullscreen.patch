--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -521,9 +521,10 @@ bool WidgetHasChildModalDialog(views::Widget* parent_widget) {
 // Returns whether immmersive fullscreen should replace fullscreen. This
 // should only occur for "browser-fullscreen" for tabbed-typed windows (not
 // for tab-fullscreen and not for app/popup type windows).
-bool ShouldUseImmersiveFullscreenForUrl(ExclusiveAccessBubbleType type) {
+bool ShouldUseImmersiveFullscreenForUrl(ExclusiveAccessBubbleType type,
+                                        BrowserWindowInterface* browser) {
   // Kiosk mode needs the whole screen, and so does the Plutonium shell.
-  if (IsRunningInAppMode() || plutonium_shell::IsShellMode()) {
+  if (IsRunningInAppMode() || plutonium_shell::IsShellBrowser(browser)) {
     return false;
   }
   // An empty URL signifies browser fullscreen. Immersive is used for browser
@@ -789,8 +790,10 @@ class BrowserView::ExclusiveAccessContextImpl
       // crbug.com/741069).
       // Immersive mode logic for downloads is handled by the download
       // controller.
-      should_close_bubble |= ShouldUseImmersiveFullscreenForUrl(params.type) &&
-                             !chromeos::IsManagedGuestSession();
+      should_close_bubble |=
