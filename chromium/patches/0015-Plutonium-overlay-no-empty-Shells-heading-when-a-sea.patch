From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sarol263@student.otago.ac.nz>
Date: Sat, 17 Oct 2026 16:12:46 +1300
Subject: [PATCH 15/94] Plutonium overlay: no empty Shells heading when a
 search matches no shell

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LcsChPspky5SrH4g8Ej5ND
---
 chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc b/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc
index d7b2fa90a5..8a0f72651b 100644
--- a/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc
+++ b/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc
@@ -357,6 +357,7 @@ class PlutoniumOverlayView : public views::View,
     Row header;
     header.title = u"Shells";
     rows_.push_back(header);
+    const size_t shells_start = rows_.size();
     for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
       std::u16string name = base::UTF8ToUTF16(shell.name);
       std::u16string url = base::UTF8ToUTF16(shell.url.spec());
@@ -381,6 +382,10 @@ class PlutoniumOverlayView : public views::View,
       add.dim = true;
       rows_.push_back(add);
     }
+    // A search that matches no shell leaves no header behind.
+    if (rows_.size() == shells_start) {
+      rows_.pop_back();
+    }
 
     // Windows and tabs by group.
     std::map<std::string, std::vector<Row>> items;
