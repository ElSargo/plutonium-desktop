+void EmbeddedWindows::SetShown(
+    int32_t window_id,
+    std::optional<gfx::PointF> geometry_origin_in_screen,
+    float scale) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  if (!shell_surface) {
+    return;
+  }
+  if (!geometry_origin_in_screen) {
+    shell_surface->SetEmbedShown(false, 1.f);
+    return;
+  }
+  // Rounding in the page's layout.
+  if (std::abs(scale - 1.f) < 0.005f) {
+    scale = 1.f;
+  }
+  // Placed first, so popups that show again are where the page is.
+  shell_surface->MoveEmbedOrigin(
+      *geometry_origin_in_screen -
+      gfx::Vector2dF(shell_surface->GetEmbedGeometry().OffsetFromOrigin()));
+  shell_surface->SetEmbedShown(true, scale);
+}
