+void ShellSurfaceBase::SetEmbedShown(bool shown, float scale) {
+  if (embed_shown_ == shown && embed_scale_ == scale) {
+    return;
+  }
+  embed_shown_ = shown;
+  embed_scale_ = scale;
+  UpdateEmbedPopups();
+}
+
+std::vector<ShellSurfaceBase*> ShellSurfaceBase::GetEmbedPopups() const {
+  std::vector<ShellSurfaceBase*> popups;
+  if (!widget_) {
+    return popups;
+  }
+  std::vector<aura::Window*> windows = {widget_->GetNativeWindow()};
+  // Breadth first: parents before their children.
+  for (size_t i = 0; i < windows.size(); ++i) {
+    for (aura::Window* child : wm::GetTransientChildren(windows[i])) {
+      ShellSurfaceBase* shell_surface = GetShellSurfaceBaseForWindow(child);
+      if (!shell_surface || shell_surface->IsEmbeddableToplevel()) {
+        continue;
+      }
+      popups.push_back(shell_surface);
+      windows.push_back(child);
+    }
+  }
+  return popups;
+}
+
+ShellSurfaceBase* ShellSurfaceBase::GetEmbedPopupOwner() const {
+  if (!widget_ || IsEmbeddableToplevel()) {
+    return nullptr;
+  }
+  for (aura::Window* window =
+           wm::GetTransientParent(widget_->GetNativeWindow());
+       window; window = wm::GetTransientParent(window)) {
+    ShellSurfaceBase* shell_surface = GetShellSurfaceBaseForWindow(window);
+    if (shell_surface && shell_surface->IsEmbeddableToplevel()) {
+      return shell_surface;
+    }
+  }
+  return nullptr;
+}
+
+void ShellSurfaceBase::UpdateEmbedPopups() {
+  // Parents first, so a grab goes back to the innermost grabbing popup.
+  for (ShellSurfaceBase* popup : GetEmbedPopups()) {
+    popup->UpdateEmbedPopup();
+  }
+}
+
+void ShellSurfaceBase::UpdateEmbedPopup() {
+  if (!widget_) {
+    return;
+  }
+  ShellSurfaceBase* owner = GetEmbedPopupOwner();
+  if (!owner && !embed_popup_hidden_ &&
+      widget_->GetNativeWindow()->transform().IsIdentity()) {
+    return;
+  }
+  const bool hidden = owner && owner->EmbedPopupsHidden();
+  SetEmbedPopupHidden(hidden);
+  // Shown smaller with its window: scaled about the window geometry's
+  // origin, where the page shows it. Aura maps the user's input through the
+  // transform.
+  gfx::Transform transform;
+  if (owner && owner->embed_parked_ && !hidden && owner->embed_scale_ != 1.f &&
+      owner->host_window()) {
+    const gfx::Point anchor =
+        owner->host_window()->GetBoundsInScreen().origin() +
+        owner->GetEmbedGeometry().OffsetFromOrigin();
+    const gfx::Vector2dF offset(
+        anchor - widget_->GetWindowBoundsInScreen().origin());
+    transform.Translate(offset);
+    transform.Scale(owner->embed_scale_, owner->embed_scale_);
+    transform.Translate(-offset);
+  }
+  if (widget_->GetNativeWindow()->transform() != transform) {
+    widget_->GetNativeWindow()->SetTransform(transform);
+  }
+}
+
+void ShellSurfaceBase::SetEmbedPopupHidden(bool hidden) {
+  if (embed_popup_hidden_ == hidden || !widget_) {
+    return;
+  }
+  embed_popup_hidden_ = hidden;
+  aura::Window* window = widget_->GetNativeWindow();
+  window->layer()->SetOpacity(hidden ? 0.f : 1.f);
+  window->SetEventTargetingPolicy(
+      hidden ? aura::EventTargetingPolicy::kNone
+             : aura::EventTargetingPolicy::kTargetAndDescendants);
+  if (hidden) {
+    // Let go of the user's pointer, keeping the popup open (losing the
+    // capture would otherwise close it, see OnCaptureChanged()).
+    if (widget_->HasCapture()) {
+      WMHelper::GetInstance()->GetCaptureClient()->RemoveObserver(this);
+      widget_->ReleaseCapture();
+    }
+  } else if (has_grab_ && widget_->IsVisible()) {
+    StartCapture();
+  }
+}
