Date: Sat, 24 Oct 2026 09:57:58 +1300
Subject: [PATCH 44/67] Plutonium: a folder upload the shell confirmed skips
 Chrome's dialog

The library's picker asks "Upload N files to <site>?" itself. When a
shell or an agent answers a tab's folder upload, FileSelectHelper skips
its tab-modal confirmation for that folder. Behind the Files app's
picker (the fallback) it still shows.
---
 chrome/browser/file_select_helper.cc     | 10 ++++++++
 chrome/browser/plutonium_file_chooser.cc | 29 ++++++++++++++++++++++++
 chrome/browser/plutonium_file_chooser.h  | 19 ++++++++++++++++
 3 files changed, 58 insertions(+)

diff --git a/chrome/browser/file_select_helper.cc b/chrome/browser/file_select_helper.cc
index 6e869e1e24..c5d6dc4095 100644
--- a/chrome/browser/file_select_helper.cc
+++ b/chrome/browser/file_select_helper.cc
@@ -54,6 +54,7 @@
 #if BUILDFLAG(IS_CHROMEOS)
 #include "chrome/browser/ash/file_manager/fileapi_util.h"
 #include "chrome/browser/ash/fusebox/fusebox_server.h"
+#include "chrome/browser/plutonium_file_chooser.h"
 #include "chrome/browser/plutonium_shell.h"
 #include "chrome/browser/plutonium_tabs.h"
 #include "content/public/browser/site_instance.h"
@@ -338,6 +339,15 @@ void FileSelectHelper::OnListDone(int error) {
         FileChooserFileInfo::NewNativeFile(native_file->Clone()));
   }
 
+#if BUILDFLAG(IS_CHROMEOS)
+  // PLUTONIUM (EXO-TAB-FEATURES): the shell's picker (or an agent) that
