+    return;
+  }
+#endif
   if (dialog_type_ == ui::SelectFileDialog::SELECT_UPLOAD_FOLDER) {
     auto model = CreateConfirmationDialog(
         entry->display_name_, std::move(chooser_files),
diff --git a/chrome/browser/plutonium_file_chooser.cc b/chrome/browser/plutonium_file_chooser.cc
index 5311930678..50cc5192ab 100644
--- a/chrome/browser/plutonium_file_chooser.cc
+++ b/chrome/browser/plutonium_file_chooser.cc
@@ -15,6 +15,7 @@
 #include "base/memory/raw_ptr.h"
 #include "base/memory/scoped_refptr.h"
 #include "base/memory/weak_ptr.h"
+#include "base/supports_user_data.h"
 #include "base/strings/string_util.h"
 #include "base/strings/utf_string_conversions.h"
 #include "base/task/sequenced_task_runner.h"
@@ -36,6 +37,14 @@ namespace {
 using From = PlutoniumTabRequests::From;
 using FallbackReason = PlutoniumTabRequests::FallbackReason;
 
+// The folder a shell or an agent answered a tab's folder upload with.
+const char kConfirmedFolderKey[] = "plutonium-confirmed-upload-folder";
+
+struct ConfirmedFolder : public base::SupportsUserData::Data {
+  explicit ConfirmedFolder(base::FilePath folder) : path(std::move(folder)) {}
+  base::FilePath path;
+};
+
 const char* ModeName(ui::SelectFileDialog::Type type) {
   switch (type) {
     case ui::SelectFileDialog::SELECT_OPEN_MULTI_FILE:
@@ -239,6 +248,11 @@ class PlutoniumSelectFileDialog : public ui::SelectFileDialog {
     } else if (!answer.is_none()) {
       return false;
     }
+    if (type_ == SELECT_UPLOAD_FOLDER && files.size() == 1 && contents_) {
+      contents_->SetUserData(
+          kConfirmedFolderKey,
+          std::make_unique<ConfirmedFolder>(files.front().path()));
+    }
     VLOG(1) << "EXO-TAB-FEATURES fileChooser answered by the "
             << (from == From::kShell ? "shell" : "agent") << ": "
             << files.size() << " path(s)";
@@ -341,3 +355,18 @@ ui::SelectFileDialog* PlutoniumSelectFileDialogFactory::Create(
   }
   return nullptr;
 }
+
+bool PlutoniumTakeFolderUploadConfirmed(content::WebContents* contents,
+                                        const base::FilePath& folder) {
+  if (!contents) {
+    return false;
+  }
+  auto* confirmed =
+      static_cast<ConfirmedFolder*>(contents->GetUserData(kConfirmedFolderKey));
+  if (!confirmed) {
+    return false;
+  }
+  const bool same = confirmed->path == folder.StripTrailingSeparators();
+  contents->RemoveUserData(kConfirmedFolderKey);
+  return same;
+}
diff --git a/chrome/browser/plutonium_file_chooser.h b/chrome/browser/plutonium_file_chooser.h
index 3f14a881e1..fdf98400b5 100644
--- a/chrome/browser/plutonium_file_chooser.h
+++ b/chrome/browser/plutonium_file_chooser.h
