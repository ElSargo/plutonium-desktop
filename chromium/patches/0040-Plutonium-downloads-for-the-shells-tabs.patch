+Response PlutoniumHandler::GetDownloads(
+    std::unique_ptr<protocol::Array<std::string>>* downloads_json) {
+  *downloads_json = std::make_unique<protocol::Array<std::string>>();
+  for (const base::DictValue& download :
+       PlutoniumDownloads::Get()->GetDownloads()) {
+    std::string json;
+    base::JSONWriter::Write(download, &json);
+    (*downloads_json)->push_back(std::move(json));
+  }
+  return Response::Success();
+}
+
+void PlutoniumHandler::DownloadCommand(
+    int id,
+    const std::string& command,
+    std::unique_ptr<DownloadCommandCallback> callback) {
+  PlutoniumDownloads::Get()->RunCommand(
+      id, command, /*from_agent=*/true,
+      base::BindOnce(
+          [](std::unique_ptr<DownloadCommandCallback> callback, bool ok,
+             const std::string& error) {
+            if (!ok) {
+              callback->sendFailure(Response::InvalidParams(error));
+              return;
+            }
+            callback->sendSuccess();
+          },
+          std::move(callback)));
+}
