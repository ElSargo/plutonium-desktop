+namespace {
+
+// The thread a tab belongs to: its origin tag, or for a link a shell opened
+// (untagged until the shell picks a thread) the first tag it was given.
+std::string ThreadOf(const PlutoniumTabs::TabInfo& tab) {
+  if (!tab.tag.empty() || tab.tags.empty()) {
+    return tab.tag;
+  }
+  return tab.tags.front();
+}
+
+base::FilePath HomeFolder() {
+  std::optional<std::string> home = base::Environment::Create()->GetVar("HOME");
+  return base::FilePath(home && !home->empty() ? *home : "/");
+}
+
+bool IsFolderSetting(const std::string& folder) {
+  return folder == "downloads" || folder == "thread" ||
+         base::StartsWith(folder, "/") || base::StartsWith(folder, "~/");
+}
+
+}  // namespace
+
+PlutoniumDownloads::Record::Record() = default;
+PlutoniumDownloads::Record::Record(Record&&) = default;
+PlutoniumDownloads::Record& PlutoniumDownloads::Record::operator=(Record&&) =
+    default;
+PlutoniumDownloads::Record::~Record() = default;
+
+// static
+PlutoniumDownloads* PlutoniumDownloads::Get() {
+  static base::NoDestructor<PlutoniumDownloads> instance;
+  return instance.get();
+}
+
+PlutoniumDownloads::PlutoniumDownloads() {
+  // ~/.config/user-dirs.dirs may name another folder; reading it blocks.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [] { return base::nix::GetXDGUserDirectory("DOWNLOAD", "Downloads"); }),
+      // Never destroyed (NoDestructor).
+      base::BindOnce(&PlutoniumDownloads::OnDefaultFolder,
+                     base::Unretained(this)));
+}
+
+PlutoniumDownloads::~PlutoniumDownloads() = default;
+
+// static
+std::optional<base::FilePath> PlutoniumDownloads::FolderFor(
+    download::DownloadItem* item) {
+  if (!plutonium_shell::IsShellMode()) {
+    return std::nullopt;
+  }
+  PlutoniumDownloads* self = Get();
+  std::string thread;
+  if (int32_t id = self->IdOf(item)) {
+    thread = self->records_[id].thread;
+  } else if (content::WebContents* contents =
+                 content::DownloadItemUtils::GetWebContents(item)) {
+    if (std::optional<PlutoniumTabs::TabInfo> tab =
+            PlutoniumTabs::Get()->GetTabFor(contents)) {
+      thread = ThreadOf(*tab);
+    }
+  }
+  base::FilePath folder = self->ResolveFolder(thread);
+  VLOG(1) << "EXO-TAB-FEATURES download from thread \"" << thread
+          << "\" goes to " << folder;
+  return folder;
+}
+
+void PlutoniumDownloads::SetOpener(Opener opener) {
+  opener_ = std::move(opener);
+}
+
+void PlutoniumDownloads::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void PlutoniumDownloads::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void PlutoniumDownloads::ObserveContext(content::BrowserContext* context) {
+  content::DownloadManager* manager =
+      context ? context->GetDownloadManager() : nullptr;
+  if (!manager || manager_observations_.IsObservingSource(manager)) {
+    return;
+  }
+  manager_observations_.AddObservation(manager);
+}
+
+std::vector<base::DictValue> PlutoniumDownloads::GetDownloads() const {
+  std::vector<base::DictValue> downloads;
+  for (const auto& [id, record] : records_) {
+    downloads.push_back(record.last.Clone());
+  }
+  return downloads;
+}
+
+void PlutoniumDownloads::RunCommand(int32_t id,
+                                    const std::string& command,
+                                    bool from_agent,
+                                    CommandCallback done) {
+  auto it = records_.find(id);
+  if (it == records_.end()) {
+    std::move(done).Run(false, "No such download");
+    return;
+  }
+  download::DownloadItem* item = it->second.item;
+  const bool in_progress =
+      item->GetState() == download::DownloadItem::IN_PROGRESS;
+  const bool dangerous =
+      in_progress && (item->IsDangerous() || item->IsInsecure());
+  VLOG(1) << "EXO-TAB-FEATURES download #" << id << ": " << command;
+  if (command == "pause") {
+    if (!in_progress) {
+      std::move(done).Run(false, "It isn't downloading");
+      return;
+    }
+    item->Pause();
+  } else if (command == "resume") {
+    if (!item->CanResume()) {
+      std::move(done).Run(false, "It can't be resumed");
+      return;
+    }
+    item->Resume(/*user_resume=*/true);
+  } else if (command == "cancel") {
+    if (item->IsDone()) {
+      std::move(done).Run(false, "It is over");
+      return;
+    }
+    item->Cancel(/*user_cancel=*/true);
+  } else if (command == "keep") {
+    if (from_agent) {
+      std::move(done).Run(false, "Only the user can keep a dangerous file");
+      return;
+    }
+    if (!dangerous) {
+      std::move(done).Run(false, "It isn't waiting to be kept");
+      return;
+    }
+    if (item->IsDangerous()) {
+      item->ValidateDangerousDownload();
+    } else {
+      item->ValidateInsecureDownload();
+    }
+  } else if (command == "discard") {
+    if (!dangerous) {
+      std::move(done).Run(false, "It isn't waiting to be kept");
+      return;
+    }
+    // Deletes the file and the entry (OnDownloadRemoved()).
+    item->Remove();
+  } else if (command == "remove") {
+    // In progress, it is cancelled first. A finished file stays.
+    item->Remove();
+  } else if (command == "open" || command == "show") {
+    const bool show = command == "show";
+    const base::FilePath path = item->GetTargetFilePath();
+    if (!show && item->GetState() != download::DownloadItem::COMPLETE) {
+      std::move(done).Run(false, "It hasn't finished");
+      return;
+    }
+    if (path.empty()) {
+      std::move(done).Run(false, "It has no file yet");
+      return;
+    }
+    if (!opener_) {
+      std::move(done).Run(false, "No helper to open files with");
+      return;
+    }
+    opener_.Run(path, it->second.thread, show, std::move(done));
+    return;
+  } else {
+    std::move(done).Run(false, "Unknown command: " + command);
+    return;
+  }
+  std::move(done).Run(true, std::string());
+}
+
+void PlutoniumDownloads::SetFolder(const std::string& shell_id,
+                                   const std::string& tag,
+                                   const std::string& folder) {
+  if (folder.empty()) {
+    auto shell = folders_.find(shell_id);
+    if (shell != folders_.end()) {
+      shell->second.erase(tag);
+      if (shell->second.empty()) {
+        folders_.erase(shell);
+      }
+    }
+    return;
+  }
+  if (!IsFolderSetting(folder)) {
+    LOG(WARNING) << "EXO-TAB-FEATURES: not a download folder: " << folder;
+    return;
+  }
+  VLOG(1) << "EXO-TAB-FEATURES shell \"" << shell_id << "\" downloads \""
+          << tag << "\" to " << folder;
+  folders_[shell_id][tag] = folder;
+}
+
+void PlutoniumDownloads::OnDownloadCreated(content::DownloadManager* manager,
+                                           download::DownloadItem* item) {
+  // Not earlier runs' downloads, nor ones nobody sees (DevTools', a
+  // background fetch's).
+  if (item->GetDownloadCreationType() ==
+          download::DownloadItem::TYPE_HISTORY_IMPORT ||
+      item->IsTransient() || ids_.contains(item)) {
+    return;
+  }
+  Record record;
+  record.item = item;
+  content::WebContents* contents =
+      content::DownloadItemUtils::GetWebContents(item);
+  std::optional<PlutoniumTabs::TabInfo> tab =
+      contents ? PlutoniumTabs::Get()->GetTabFor(contents) : std::nullopt;
+  if (tab) {
+    record.tab_id = tab->id;
+    record.thread = ThreadOf(*tab);
+  }
+  const int32_t id = next_id_++;
+  record.last = ToValue(id, record);
+  base::DictValue added = record.last.Clone();
+  ids_[item] = id;
+  records_.emplace(id, std::move(record));
+  item_observations_.AddObservation(item);
+  VLOG(1) << "EXO-TAB-FEATURES download #" << id << " from tab #"
+          << (tab ? tab->id : 0) << ": " << item->GetURL().spec();
+  for (Observer& observer : observers_) {
+    observer.OnDownloadAdded(added);
+  }
+  // A link opened in a new tab that turned out to be a download leaves an
+  // empty tab: close it, as Chrome does in its tab strip
+  // (DownloadUIController). Not an agent's: its automation holds the page.
+  if (tab && contents->GetController().IsInitialNavigation() &&
+      tab->opened_by != "agent" && tab->opened_by != "devtools") {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](int32_t tab_id) {
+                         if (PlutoniumTabs::Get()->GetTab(tab_id)) {
+                           PlutoniumTabs::Get()->RunCommand(
+                               tab_id, PlutoniumTabs::Command::kClose);
+                         }
+                       },
+                       tab->id));
+  }
+}
+
+void PlutoniumDownloads::ManagerGoingDown(content::DownloadManager* manager) {
+  // Its items are destroyed too (OnDownloadDestroyed()).
+  manager_observations_.RemoveObservation(manager);
+}
+
+void PlutoniumDownloads::OnDownloadUpdated(download::DownloadItem* item) {
+  const int32_t id = IdOf(item);
+  if (!id) {
+    return;
+  }
+  Record& record = records_[id];
+  base::DictValue value = ToValue(id, record);
+  if (value == record.last) {
+    return;
+  }
+  record.last = value.Clone();
+  for (Observer& observer : observers_) {
+    observer.OnDownloadChanged(value);
+  }
+}
+
+void PlutoniumDownloads::OnDownloadRemoved(download::DownloadItem* item) {
+  Forget(item);
+}
+
+void PlutoniumDownloads::OnDownloadDestroyed(download::DownloadItem* item) {
+  Forget(item);
+}
+
+base::DictValue PlutoniumDownloads::ToValue(int32_t id,
+                                            const Record& record) const {
+  const download::DownloadItem* item = record.item;
+  const char* state = "interrupted";
+  switch (item->GetState()) {
+    case download::DownloadItem::IN_PROGRESS:
+      state = item->IsPaused() ? "paused" : "in-progress";
+      break;
+    case download::DownloadItem::COMPLETE:
+      state = "complete";
+      break;
+    case download::DownloadItem::CANCELLED:
+      state = "cancelled";
+      break;
+    case download::DownloadItem::INTERRUPTED:
+    case download::DownloadItem::MAX_DOWNLOAD_STATE:
+      break;
+  }
+  base::DictValue value;
+  value.Set("id", id);
+  value.Set("tabId", record.tab_id);
+  value.Set("thread", record.thread);
+  value.Set("url", item->GetURL().possibly_invalid_spec());
+  value.Set("filename", item->GetFileNameToReportUser().AsUTF8Unsafe());
+  value.Set("path", item->GetTargetFilePath().AsUTF8Unsafe());
+  value.Set("mime", item->GetMimeType());
+  value.Set("receivedBytes", static_cast<double>(item->GetReceivedBytes()));
+  value.Set("totalBytes",
+            static_cast<double>(std::max<int64_t>(item->GetTotalBytes(), 0)));
+  value.Set("state", state);
+  value.Set("canResume", item->CanResume());
+  value.Set("startTime",
+            item->GetStartTime().InMillisecondsFSinceUnixEpochIgnoringNull());
+  if (item->GetState() == download::DownloadItem::IN_PROGRESS) {
+    if (item->IsDangerous()) {
+      value.Set("danger",
+                download::GetDownloadDangerTypeString(item->GetDangerType()));
+    } else if (item->IsInsecure()) {
+      value.Set("danger", "Insecure");
+    }
+  }
+  if (item->GetState() == download::DownloadItem::INTERRUPTED) {
+    value.Set("error",
+              download::DownloadInterruptReasonToString(item->GetLastReason()));
+  }
+  return value;
+}
+
+int32_t PlutoniumDownloads::IdOf(download::DownloadItem* item) const {
+  auto it = ids_.find(item);
+  return it == ids_.end() ? 0 : it->second;
+}
+
+void PlutoniumDownloads::Forget(download::DownloadItem* item) {
+  if (item_observations_.IsObservingSource(item)) {
+    item_observations_.RemoveObservation(item);
+  }
+  auto it = ids_.find(item);
+  if (it == ids_.end()) {
+    return;
+  }
+  const int32_t id = it->second;
+  ids_.erase(it);
+  records_.erase(id);
+  for (Observer& observer : observers_) {
+    observer.OnDownloadRemoved(id);
+  }
+}
+
+base::FilePath PlutoniumDownloads::ResolveFolder(
+    const std::string& thread) const {
+  const std::string* folder = nullptr;
+  std::optional<PlutoniumGroups::Group> group;
+  if (!thread.empty()) {
+    // The thread's own folder, from whichever shell set it.
+    for (const auto& [shell_id, folders] : folders_) {
+      auto it = folders.find(thread);
+      if (it != folders.end()) {
+        folder = &it->second;
+        break;
+      }
+    }
+    group = PlutoniumGroups::Get()->Find(thread);
+    // Else the default of the shell that owns the thread.
+    if (!folder && group) {
+      auto shell = folders_.find(group->shell_id);
+      if (shell != folders_.end()) {
+        auto it = shell->second.find(std::string());
+        if (it != shell->second.end()) {
+          folder = &it->second;
+        }
+      }
+    }
+  }
+  const base::FilePath downloads = DefaultFolder();
+  if (!folder || *folder == "downloads") {
+    return downloads;
+  }
+  if (*folder == "thread") {
+    if (thread.empty()) {
+      return downloads;
+    }
+    base::FilePath::StringType name =
+        group && !group->label.empty() ? group->label : thread;
+    base::i18n::ReplaceIllegalCharactersInPath(&name, '_');
+    name = std::string(base::TrimString(name, " .", base::TRIM_ALL));
+    return name.empty() ? downloads : downloads.Append(name);
+  }
+  if (base::StartsWith(*folder, "~/")) {
+    return HomeFolder().Append(folder->substr(2));
+  }
+  return base::FilePath(*folder);
+}
+
+base::FilePath PlutoniumDownloads::DefaultFolder() const {
+  return xdg_folder_.empty() ? HomeFolder().Append("Downloads") : xdg_folder_;
+}
+
+void PlutoniumDownloads::OnDefaultFolder(const base::FilePath& folder) {
+  // xdg-user-dirs falls back to the home folder itself; keep ~/Downloads.
+  if (!folder.empty() && folder != HomeFolder()) {
+    xdg_folder_ = folder;
+  }
+}
