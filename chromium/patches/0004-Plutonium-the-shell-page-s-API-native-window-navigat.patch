@@ -0,0 +1,21 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// EXO-BROKER: a navigator.windowBroker window event ("windowadded",
+// "windowchanged", "windowremoved", "windowfocusrequest", "grantrevoked").
+[
+    Exposed=Window,
+    RuntimeEnabled=PlutoniumShell,
+    SecureContext
+] interface NativeWindowEvent : Event {
+    constructor(DOMString type, optional NativeWindowEventInit eventInitDict = {});
+    // The broker's window id.
+    readonly attribute long windowId;
+    // The window as a NativeWindowEntry dictionary (a fresh object on every
+    // read); null for "windowremoved" and "grantrevoked".
+    [CallWith=ScriptState] readonly attribute any entry;
+    // For "grantrevoked": the grant that is no longer valid. Elements using it
+    // have detached ("windowclose"). Otherwise "".
+    readonly attribute DOMString grant;
+};
diff --git a/third_party/blink/renderer/core/html/native_window_event_init.idl b/third_party/blink/renderer/core/html/native_window_event_init.idl
new file mode 100644
index 0000000000..769b678707
--- /dev/null
+++ b/third_party/blink/renderer/core/html/native_window_event_init.idl
@@ -0,0 +1,13 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// EXO-BROKER: what new NativeWindowEvent(type, init) takes (so a shell, or
+// its tests, can make the events navigator.windowBroker fires).
+dictionary NativeWindowEventInit : EventInit {
+    long windowId = 0;
+    // Left out for "windowremoved" and "grantrevoked".
+    NativeWindowEntry entry;
+    // For "grantrevoked".
+    DOMString grant = "";
+};
