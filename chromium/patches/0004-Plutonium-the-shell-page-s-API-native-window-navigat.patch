+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HTML_HTML_NATIVE_WINDOW_ELEMENT_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HTML_HTML_NATIVE_WINDOW_ELEMENT_H_
+
+#include <memory>
+#include <optional>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+#include "components/viz/common/surfaces/frame_sink_id.h"
+#include "third_party/blink/public/mojom/native_window/native_window.mojom-blink.h"
+#include "third_party/blink/renderer/bindings/core/v8/script_promise.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/core/html/html_element.h"
+#include "third_party/blink/renderer/platform/mojo/heap_mojo_receiver.h"
+#include "third_party/blink/renderer/platform/graphics/compositor_element_id.h"
+#include "third_party/blink/renderer/platform/mojo/heap_mojo_remote.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/geometry/vector2d.h"
+
+namespace cc {
+class Layer;
+class SurfaceLayer;
+}  // namespace cc
+
+namespace blink {
+
+class EffectPaintPropertyNode;
+class IntersectionObserver;
+class IntersectionObserverEntry;
+class PropertyTreeState;
+class TimingFunction;
+
+// EXO-EMBED: <native-window grant="TOKEN" [window="ID"]> shows the native
+// (Wayland) window that grant TOKEN is for as a replaced element. EXO-BROKER:
+// the grant must have been issued by the browser's window broker to this
+// document (and be for window ID, if given); otherwise nothing is attached
+// and "windowerror" fires. The window draws as
+// a composited layer in the page and receives the pointer input that lands on
+// the element; clicking it gives the window keyboard focus.
+//
+// Sizing: without a CSS size the element takes the window's size. With a CSS
+// size the window is asked to resize to the element, and the content box is
+// where the window is: until the app has drawn at the size asked for, its
+// latest frame is stretched to the box (as Hyprland draws a window it is
+// resizing). Where the app answers with another size (it won't take that
+// size, or snaps to whole cells), object-fit and object-position place its
+// frame; the UA default is "none" at the top left.
+//
+// EXO-CROSSFADE: with crossfade="MS", a resize the page makes also fades the
+// frame from before it (stretched to the box) into the app's frame at the new
+// size once it arrives, over MS milliseconds eased by crossfade-easing, as
+// niri mixes them. A page animating the box (a FLIP transform from the old
+// size) gets niri's resize animation by starting it when the app has drawn
+// (windowchange) with the same duration and easing. Resizes in quick
+// succession (a drag), small ones, and the first size the element gives a
+// window don't fade.
+class CORE_EXPORT HTMLNativeWindowElement final
+    : public HTMLElement,
+      public mojom::blink::NativeWindowClient {
+  DEFINE_WRAPPERTYPEINFO();
+
+ public:
+  explicit HTMLNativeWindowElement(Document&);
+  ~HTMLNativeWindowElement() override;
+
+  ElementType GetElementType() const final {
+    return ElementType::kHTMLNativeWindowElement;
+  }
+
+  // IDL.
+  String windowState() const;
+  String windowTitle() const;
+  String appId() const;
+  unsigned windowWidth() const;
+  unsigned windowHeight() const;
+  unsigned windowMinWidth() const;
+  unsigned windowMinHeight() const;
+  unsigned windowMaxWidth() const;
+  unsigned windowMaxHeight() const;
+  bool windowFocused() const;
+  int32_t windowId() const;
+  void focusWindow();
+  void blurWindow();
+
+  // For LayoutNativeWindow.
+  cc::SurfaceLayer* ContentsCcLayer() const;
+  // The window's size in pixels; empty until the window is known.
+  gfx::Size WindowSizeInPixels() const;
+  // Where the window geometry starts inside the surface, in pixels.
+  gfx::Vector2d GeometryOffsetInPixels() const;
+  // The whole surface (geometry and client-side shadows), in pixels.
+  gfx::Size SurfaceSizeInPixels() const;
+
+  // Whether the app has yet to answer the size the page asked for (recently)
+  // by drawing at a new size: its frame is then stretched to the content box.
+  bool AwaitingSize() const;
+
+  // EXO-CROSSFADE: the frame from before a resize, stretched to the content
+  // box over the window while it fades out.
+  struct FadeFrame {
+    scoped_refptr<cc::SurfaceLayer> layer;
+    gfx::Size geometry_size;
+    gfx::Vector2d geometry_offset;
+    gfx::Size surface_size;
+  };
+  const FadeFrame* GetFadeFrame() const {
+    return fade_ ? &fade_->frame : nullptr;
+  }
+  // The effect node the faded frame paints under (its opacity), child of
+  // |parent|'s effect.
+  const EffectPaintPropertyNode& UpdateFadeEffect(
+      const PropertyTreeState& parent);
+  // The element stopped showing the window (hidden, not laid out, off
+  // screen): the next size it gives the window isn't animated from what it
+  // showed before.
+  void ForgetShownFrame();
+  // Called on paint with the element's content box size in pixels.
+  void ContentSizeChanged(const gfx::Size& size_in_pixels);
+  // Called on paint with where the content box is in the widget, in pixels
+  // (which element a press on the window landed in), and how much
+  // transforms scale it (where the window's popups go, and their size).
+  void ContentRectChanged(const gfx::Rect& rect_in_widget, float scale);
+
+  // For hit testing (WebFrameWidgetImpl): the embedded window's frame sink.
+  viz::FrameSinkId EmbeddedFrameSinkId() const;
+  // For hit testing: if the element shows its window floating and
+  // |point_in_root_frame| (blink space) is at most
+  // mojom::blink::kResizeEdgeMargin CSS pixels outside its content box, where
+  // the app's client-side resize edges are, where that is in the window's
+  // surface (blink space).
+  std::optional<gfx::PointF> ResizeEdgePoint(
+      const gfx::PointF& point_in_root_frame) const;
+
+  // EXO-FULLSCREEN: called by Fullscreen when the element becomes, or stops
+  // being, its document's fullscreen element.
+  void FullscreenChanged(bool fullscreen);
+
+  void Trace(Visitor*) const override;
+
+ private:
+  // HTMLElement:
+  void ParseAttribute(const AttributeModificationParams&) override;
+  LayoutObject* CreateLayoutObject(const ComputedStyle&) override;
+  InsertionNotificationRequest InsertedInto(ContainerNode&) override;
+  void RemovedFrom(ContainerNode&) override;
+  void DetachLayoutTree(bool performing_reattach) override;
+
+  // mojom::blink::NativeWindowClient:
+  void OnInfoChanged(mojom::blink::NativeWindowInfoPtr info) override;
+  void OnClosed() override;
+  void SetFullscreen(bool fullscreen) override;
+  void OnRequest(mojom::blink::NativeWindowRequest request,
+                 uint32_t edges) override;
+  void OnTaken() override;
+
+  // EXO-EMBED: whether the element is on screen, for the browser's choice
+  // of which element drives the window.
+  void ObserveVisibility();
+  void OnIntersectionChanged(
+      const HeapVector<Member<IntersectionObserverEntry>>& entries);
+
+  // Attaches with the "grant" (and "window") attributes while connected.
+  void UpdateAttachment();
+  void DetachWindow();
+  void BindHost();
+  void OnAttached(uint64_t attach_id, bool success);
+  void UpdateSurfaceLayer();
+  void DispatchSimpleEvent(const char* type);
+
+  // EXO-CROSSFADE.
+  class FadeFrameCallback;
+  class FadeAnimator;
+  base::TimeDelta CrossfadeDuration() const;
+  const TimingFunction& CrossfadeEasing();
+  // The page is about to ask for a content box of |size| (pixels), from the
+  // box |shown| it showed the window in.
+  void StartResize(const gfx::Size& size, const gfx::Size& shown);
+  void EndFade();
+  // The old frame starts fading out: on the compositor thread if it can.
+  void StartFadeOut(base::TimeTicks now);
+  void OnFadeFrame();
+  // The compositor's fade animation is over (or was aborted), or the time it
+  // should have taken is (in case it never started: the frame not composited).
+  void OnFadeAnimationEnded(int group_id);
+  void OnFadeTimeout(uint64_t generation);
+  float FadeOpacity();
+  // Repaints each frame while a frame is stretched or fading.
+  void InvalidateFadePaint();
+
+  HeapMojoRemote<mojom::blink::NativeWindowHost> host_;
+  HeapMojoReceiver<mojom::blink::NativeWindowClient, HTMLNativeWindowElement>
+      client_receiver_;
+  // Whether the element has a "grant" and is connected, and what it asked
+  // for. |grant_| is empty if the attribute isn't a valid token.
+  bool attach_requested_ = false;
+  std::optional<base::UnguessableToken> grant_;
+  int32_t window_id_ = 0;
+  // Identifies the current attach request, for OnAttached().
+  uint64_t attach_id_ = 0;
+  bool closed_ = false;
+  // EXO-DISPLAYS: the window another page took from this element (-1 if its
+  // id isn't known), or 0.
+  int32_t taken_window_id_ = 0;
+  mojom::blink::NativeWindowInfoPtr info_;
+  scoped_refptr<cc::SurfaceLayer> surface_layer_;
+  gfx::Size last_sent_size_;
+  gfx::Rect last_sent_rect_;
+  float last_sent_scale_ = 1.f;
+  Member<IntersectionObserver> visibility_observer_;
+  // Whether the element is on screen (intersects the viewport).
+  bool visible_ = false;
+  // EXO-FULLSCREEN: what the browser was last told.
+  bool fullscreen_ = false;
+
+  // When the page last asked for a size (|last_sent_size_|), and the window's
+  // size then: any other size it draws is its answer.
+  base::TimeTicks size_requested_;
+  gfx::Size size_at_request_;
+
+  // EXO-CROSSFADE: the old frame, from a resize until it has faded out.
+  struct Fade {
+    FadeFrame frame;
+    // When the resize was asked for; the frame fades out once the app has
+    // drawn at a new size, or after a while if it doesn't.
+    base::TimeTicks hold_start;
+    // When fading started (null while holding), and from what opacity (a
+    // resize during a fade holds the frame where the fade had got to).
+    base::TimeTicks fade_start;
+    float from_opacity = 1.f;
+    // The compositor's opacity animation fading it (its keyframe model and
+    // group; 0 when it fades from the main thread, or isn't fading).
+    int keyframe_model_id = 0;
+    int group_id = 0;
+  };
+  std::optional<Fade> fade_;
+  Member<EffectPaintPropertyNode> fade_effect_;
+  // The fade effect's element id, for the compositor's opacity animation.
+  CompositorElementId fade_element_id_;
+  std::unique_ptr<FadeAnimator> fade_animator_;
+  // Counts fade-outs, so a timeout knows whether its fade is still running.
+  uint64_t fade_generation_ = 0;
+  bool fade_frame_requested_ = false;
+  // When a resize was last asked for (continuous resizes don't fade).
+  base::TimeTicks last_resize_;
+  // The content box this element last showed the window in (empty when it
+  // hasn't shown it, so there's nothing to fade from).
+  gfx::Size shown_box_;
+  // crossfade-easing, parsed (null until needed).
+  scoped_refptr<TimingFunction> easing_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HTML_HTML_NATIVE_WINDOW_ELEMENT_H_
