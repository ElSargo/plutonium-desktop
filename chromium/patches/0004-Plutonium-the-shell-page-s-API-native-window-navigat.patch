@@ -0,0 +1,117 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module blink.mojom;
+
+import "mojo/public/mojom/base/unguessable_token.mojom";
+import "services/viz/public/mojom/compositing/surface_id.mojom";
+import "ui/gfx/geometry/mojom/geometry.mojom";
+
+// EXO-EMBED: lets a <native-window> element show a native (Wayland) window
+// from the browser's window list and route input to it.
+//
+// EXO-BROKER: embedding needs a grant, an opaque token the browser's window
+// broker (ExoWindowBroker) issued to this document for one window. Without
+// a valid grant nothing is attached, no frame sinks are linked and no input
+// reaches the window. Grants come from the shell-only WindowBroker
+// (window_broker.mojom), and attaching is also refused outside the shell
+// document.
+
+struct NativeWindowInfo {
+  // The broker's id for the window (not a capability).
+  int32 window_id;
+  // The window's latest surface. The element embeds this surface and any
+  // later one from the same frame sink.
+  viz.mojom.SurfaceId surface_id;
+  // The window geometry in surface coordinates (DIPs). The element shows
+  // this part of the surface, without client-side shadows.
+  gfx.mojom.Rect geometry;
+  // The whole surface: the geometry plus client-side shadows (DIPs).
+  gfx.mojom.Size surface_size;
+  // PLUTONIUM: the app's size limits for its geometry (DIPs). 0 on an axis
+  // means no limit on it.
+  gfx.mojom.Size min_size;
+  gfx.mojom.Size max_size;
+  // Scale of the window's surface (pixels per DIP).
+  float device_scale_factor;
+  string title;
+  string app_id;
+  // Whether the window has keyboard focus.
+  bool focused;
+};
+
+// EXO-EMBED: what the app asked for (its own maximize button, a drag on its
+// title bar or edge). The app's window state doesn't change: the page
+// decides what, if anything, to do.
+enum NativeWindowRequest { kMaximize, kUnmaximize, kMinimize, kMove, kResize };
+
+// Window edges, for kResize.
+const uint32 kNativeWindowEdgeTop = 1;
+const uint32 kNativeWindowEdgeBottom = 2;
+const uint32 kNativeWindowEdgeLeft = 4;
+const uint32 kNativeWindowEdgeRight = 8;
+
+interface NativeWindowClient {
+  // Sent on attach and whenever the info changes.
+  OnInfoChanged(NativeWindowInfo info);
+  // The window was closed; no more messages follow.
+  OnClosed();
+  // EXO-FULLSCREEN: the browser asks the element to enter or leave
+  // fullscreen (the user pressed Super+F, or the app asked to be
+  // fullscreen). Entering needs no user activation: the browser decided.
+  SetFullscreen(bool fullscreen);
+  // EXO-EMBED: the app asked for |request|; |edges| (kNativeWindowEdge*) is
+  // where it wants to resize from. Sent to one element showing the window
+  // (see NativeWindowHost.SetVisible()).
+  OnRequest(NativeWindowRequest request, uint32 edges);
+  // EXO-DISPLAYS: another page's element took the window (a window is shown
+  // in one page at a time; the newest claim wins). The element stops showing
+  // it until it gets it back, which OnInfoChanged() then says: when its
+  // shell is shown again, or once no page shows the window.
+  OnTaken();
+};
+
+// One per element. Bound through the frame's BrowserInterfaceBroker.
+interface NativeWindowHost {
+  // Embeds the window that |grant| is for in this frame. |grant| must have
+  // been issued to this frame's current document. If |window_id| isn't 0 the
+  // grant must also be for that window. Replies false, and attaches nothing,
+  // otherwise. If the grant is revoked later (window closed, grant revoked
+  // by the broker) the window is detached and the client gets OnClosed().
+  // EXO-DISPLAYS: attaching takes the window from other pages' elements
+  // (they get OnTaken()), unless this is a hidden shell's page and the
+  // other a visible one's: then this element gets OnTaken() at once.
+  Attach(mojo_base.mojom.UnguessableToken grant,
+         int32 window_id,
+         pending_remote<NativeWindowClient> client) => (bool success);
+  Detach();
+  // Asks the app to resize its window to |size| pixels. When several
+  // elements show one window, one of them sizes it and gets its requests:
+  // the one the user last pressed in, else a visible one, else the last
+  // attached (a fullscreen one before all).
+  SetSize(gfx.mojom.Size size_in_pixels);
+  // Whether the element is on screen (intersects the viewport).
+  SetVisible(bool visible);
+  // Where the element's content box is in its widget, in pixels, for
+  // telling which element a press on the window landed in, and how much
+  // CSS transforms scale it (1 if not), for placing the window's popups.
+  SetRectInWidget(gfx.mojom.Rect rect_in_pixels, float scale);
+  // Gives the window keyboard focus, or takes it back.
+  Focus();
+  Blur();
+  // EXO-FULLSCREEN: the element became, or stopped being, the document's
+  // fullscreen element. The app is told it is fullscreen while it is.
+  OnFullscreenChanged(bool fullscreen);
+  // Whether the page shows the window floating (its `floating` attribute):
+  // the app isn't told it is tiled, so it keeps its client-side shadow and
+  // the resize edges in it, and presses up to kResizeEdgeMargin CSS pixels
+  // outside the content box reach it where nothing of the page's covers
+  // them. Tiled (the default), the app drops its shadow and edges.
+  SetFloating(bool floating);
+};
+
+// How far outside a floating window's content box (CSS pixels, in the
+// element's own space) presses go to the app, for its client-side resize
+// edges.
+const int32 kResizeEdgeMargin = 8;
