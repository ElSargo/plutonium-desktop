+#include "third_party/blink/renderer/platform/bindings/script_state.h"
+
+namespace blink {
+
+BrowserDownloadEvent::BrowserDownloadEvent(const AtomicString& type,
+                                           int32_t download_id,
+                                           const String& download_json)
+    : Event(type, Bubbles::kNo, Cancelable::kNo),
+      download_id_(download_id),
+      download_json_(download_json) {}
+
+ScriptValue BrowserDownloadEvent::download(ScriptState* script_state) const {
+  v8::Isolate* isolate = script_state->GetIsolate();
+  if (download_json_.empty()) {
+    return ScriptValue(isolate, v8::Null(isolate));
+  }
+  v8::Local<v8::Value> value = FromJSONString(script_state, download_json_);
+  if (value.IsEmpty()) {
+    return ScriptValue(isolate, v8::Null(isolate));
+  }
+  return ScriptValue(isolate, value);
+}
+
+const AtomicString& BrowserDownloadEvent::InterfaceName() const {
+  return event_interface_names::kBrowserDownloadEvent;
+}
+
+}  // namespace blink
