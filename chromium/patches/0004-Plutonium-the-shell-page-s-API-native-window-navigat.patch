+// found in the LICENSE file.
+
+// EXO-CHROME: an item of Chrome's context menu, as the shell shows it
+// (ContextMenuRequestEvent.items).
+dictionary ContextMenuItem {
+    // What closeContextMenu() names it by; 0 for separators and titles.
+    required long id;
+    // The submenu item it is in, or 0.
+    required long parentId;
+    // "command", "checkbox", "radio", "separator", "submenu" or "title".
+    required DOMString type;
+    DOMString label = "";
+    boolean enabled = true;
+    boolean checked = false;
+};
diff --git a/third_party/blink/renderer/core/html/context_menu_request_event.cc b/third_party/blink/renderer/core/html/context_menu_request_event.cc
new file mode 100644
