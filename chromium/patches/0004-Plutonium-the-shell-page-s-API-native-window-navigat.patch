+ScriptPromise<Blob> NativeWindowBroker::screenshot(ScriptState* script_state,
+                                                   const String& source_json) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<Blob>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->Screenshot(
+      source_json,
+      BindOnce(
+          [](NativeWindowBroker* self, ScriptPromiseResolver<Blob>* resolver,
+             std::optional<mojo_base::BigBuffer> png, const String& error) {
+            self->pending_.erase(resolver);
+            if (!png) {
