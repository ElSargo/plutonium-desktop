+void HTMLNativeWindowElement::ContentSizeChanged(
+    const gfx::Size& size_in_pixels) {
+  // Only ask the window to resize once it is known, and only to sizes the
+  // page chose: an element without a CSS size takes the window's size.
+  if (!info_ || !host_.is_bound() || size_in_pixels.IsEmpty()) {
+    return;
+  }
+  const gfx::Size shown_box = shown_box_;
+  if (visible_) {
+    shown_box_ = size_in_pixels;
+  }
+  if (size_in_pixels == last_sent_size_ ||
+      size_in_pixels == WindowSizeInPixels()) {
+    return;
+  }
+  last_sent_size_ = size_in_pixels;
+  size_requested_ = base::TimeTicks::Now();
+  size_at_request_ = WindowSizeInPixels();
+  // EXO-CROSSFADE: only a box this element showed the window in changing
+  // fades; not the first size it gives a window (just attached, or shown
+  // again).
+  if (!shown_box.IsEmpty() && shown_box != size_in_pixels) {
+    StartResize(size_in_pixels, shown_box);
+  } else {
+    EndFade();
+  }
+  host_->SetSize(size_in_pixels);
+  InvalidateFadePaint();
+}
+
+void HTMLNativeWindowElement::ContentRectChanged(
+    const gfx::Rect& rect_in_widget,
+    float scale) {
+  if (!info_ || !host_.is_bound() ||
+      (rect_in_widget == last_sent_rect_ && scale == last_sent_scale_)) {
+    return;
+  }
+  last_sent_rect_ = rect_in_widget;
+  last_sent_scale_ = scale;
+  host_->SetRectInWidget(rect_in_widget, scale);
+}
+
+void HTMLNativeWindowElement::ObserveVisibility() {
+  if (visibility_observer_) {
+    return;
+  }
+  visibility_observer_ = IntersectionObserver::Create(
+      GetDocument(),
+      BindRepeating(&HTMLNativeWindowElement::OnIntersectionChanged,
+                    WrapWeakPersistent(this)),
+      std::nullopt, IntersectionObserver::Params{.thresholds = {0}});
+  visibility_observer_->observe(this);
+}
+
+void HTMLNativeWindowElement::OnIntersectionChanged(
+    const HeapVector<Member<IntersectionObserverEntry>>& entries) {
+  if (entries.empty() || !host_.is_bound()) {
+    return;
+  }
+  visible_ = entries.back()->isIntersecting();
+  if (!visible_) {
+    ForgetShownFrame();
+  }
+  host_->SetVisible(visible_);
+}
+
+void HTMLNativeWindowElement::OnRequest(
+    mojom::blink::NativeWindowRequest request,
+    uint32_t edges) {
+  const char* name = "";
+  switch (request) {
+    case mojom::blink::NativeWindowRequest::kMaximize:
+      name = "maximize";
+      break;
+    case mojom::blink::NativeWindowRequest::kUnmaximize:
+      name = "unmaximize";
+      break;
+    case mojom::blink::NativeWindowRequest::kMinimize:
+      name = "minimize";
+      break;
+    case mojom::blink::NativeWindowRequest::kMove:
+      name = "move";
+      break;
+    case mojom::blink::NativeWindowRequest::kResize:
+      name = "resize";
+      break;
+  }
+  StringBuilder edge;
+  if (edges & mojom::blink::kNativeWindowEdgeTop) {
+    edge.Append("top");
+  } else if (edges & mojom::blink::kNativeWindowEdgeBottom) {
+    edge.Append("bottom");
+  }
+  const char* side = (edges & mojom::blink::kNativeWindowEdgeLeft)    ? "left"
+                     : (edges & mojom::blink::kNativeWindowEdgeRight) ? "right"
+                                                                      : nullptr;
+  if (side) {
+    if (!edge.empty()) {
+      edge.Append('-');
+    }
+    edge.Append(side);
+  }
+  DispatchEvent(*MakeGarbageCollected<NativeWindowRequestEvent>(
+      String(name), edge.ToString()));
+}
+
+base::TimeDelta HTMLNativeWindowElement::CrossfadeDuration() const {
+  int value = 0;
+  if (!ParseHTMLInteger(FastGetAttribute(html_names::kCrossfadeAttr), value) ||
+      value <= 0) {
+    return base::TimeDelta();
+  }
+  return base::Milliseconds(std::min(value, 10000));
+}
+
+const TimingFunction& HTMLNativeWindowElement::CrossfadeEasing() {
+  if (easing_) {
+    return *easing_;
+  }
+  // A CSS <easing-function>, as for transition-timing-function.
+  const String value = FastGetAttribute(html_names::kCrossfadeEasingAttr);
+  if (!value.empty()) {
+    const auto* list = DynamicTo<CSSValueList>(CSSParser::ParseSingleValue(
+        CSSPropertyID::kTransitionTimingFunction, value,
+        StrictCSSParserContext(
+            GetExecutionContext()
+                ? GetExecutionContext()->GetSecureContextMode()
+                : SecureContextMode::kInsecureContext)));
+    if (list && list->length() == 1) {
+      MediaValues* media_values =
+          MediaValues::CreateDynamicIfFrameExists(GetDocument().GetFrame());
+      easing_ = CSSToStyleMap::MapAnimationTimingFunction(*media_values,
+                                                          list->Item(0));
+    }
+  }
+  if (!easing_) {
+    // Close to niri's default, a critically damped spring.
+    easing_ = CubicBezierTimingFunction::Create(0.25, 1, 0.5, 1);
+  }
+  return *easing_;
+}
+
+bool HTMLNativeWindowElement::AwaitingSize() const {
+  if (!info_ || last_sent_size_.IsEmpty() ||
+      WindowSizeInPixels() == last_sent_size_) {
+    return false;
+  }
+  const base::TimeDelta since = base::TimeTicks::Now() - size_requested_;
+  // Any new size is the app's answer (a terminal snaps to whole cells), but
+  // during a drag it may answer an earlier request: keep stretching then.
+  return since < kMaxFadeHold && (WindowSizeInPixels() == size_at_request_ ||
+                                  since < kContinuousResize);
+}
+
+void HTMLNativeWindowElement::StartResize(const gfx::Size& size,
+                                          const gfx::Size& shown) {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const base::TimeTicks last_resize = last_resize_;
+  last_resize_ = now;
+  const bool continuous =
+      !last_resize.is_null() && now - last_resize < kContinuousResize;
+  const bool small =
+      std::abs(size.width() - shown.width()) <= kResizeAnimationThreshold &&
+      std::abs(size.height() - shown.height()) <= kResizeAnimationThreshold;
+  if (CrossfadeDuration().is_zero() || !info_ ||
+      !info_->surface_id.is_valid() || continuous || small) {
+    EndFade();
+    return;
+  }
+  if (fade_) {
+    // Resized again before the app caught up, or while fading: keep the
+    // frame from before the first resize, where its fade had got to.
+    fade_->from_opacity = FadeOpacity();
+    if (fade_->keyframe_model_id) {
+      fade_animator_->Remove(fade_->keyframe_model_id);
+      fade_->keyframe_model_id = 0;
+      fade_->group_id = 0;
+    }
+    fade_->fade_start = base::TimeTicks();
+    fade_->hold_start = now;
+    return;
+  }
+  // The window's current surface: its last frame at the old size. Embedding
+  // that exact surface keeps it alive in viz after the app moves on to a
+  // surface of the new size.
+  auto layer = cc::SurfaceLayer::Create();
+  layer->SetSurfaceId(info_->surface_id,
+                      cc::DeadlinePolicy::UseSpecifiedDeadline(0));
+  layer->SetOldestAcceptableFallback(info_->surface_id);
+  layer->SetStretchContentToFillBounds(true);
+  layer->SetSurfaceHitTestable(false);
+  // Nothing to wait for: it's already drawn (and may go before the fade ends).
+  layer->SetBlocksActivation(false);
+  layer->SetIsDrawable(true);
+  fade_.emplace();
+  fade_->frame.layer = std::move(layer);
+  fade_->frame.geometry_size = WindowSizeInPixels();
+  fade_->frame.geometry_offset = GeometryOffsetInPixels();
+  fade_->frame.surface_size = SurfaceSizeInPixels();
+  fade_->hold_start = now;
+}
+
+void HTMLNativeWindowElement::EndFade() {
+  if (!fade_) {
+    return;
+  }
+  if (fade_->keyframe_model_id) {
+    fade_animator_->Remove(fade_->keyframe_model_id);
+  }
+  fade_.reset();
+  fade_effect_ = nullptr;
+  if (auto* view = GetDocument().View()) {
+    view->SetPaintArtifactCompositorNeedsUpdate();
+  }
+  if (auto* layout_object = GetLayoutObject()) {
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+}
+
+void HTMLNativeWindowElement::ForgetShownFrame() {
+  shown_box_ = gfx::Size();
+  EndFade();
+}
+
+float HTMLNativeWindowElement::FadeOpacity() {
+  if (!fade_) {
+    return 0.f;
+  }
+  if (fade_->fade_start.is_null()) {
+    return fade_->from_opacity;
+  }
+  const base::TimeDelta duration = CrossfadeDuration();
+  const double t =
+      duration.is_zero()
+          ? 1.0
+          : std::clamp((base::TimeTicks::Now() - fade_->fade_start) / duration,
+                       0.0, 1.0);
+  const double progress = std::clamp(
+      CrossfadeEasing().Evaluate(t, TimingFunction::LimitDirection::RIGHT),
+      0.0, 1.0);
+  return fade_->from_opacity * static_cast<float>(1.0 - progress);
+}
+
+void HTMLNativeWindowElement::StartFadeOut(base::TimeTicks now) {
+  DCHECK(fade_);
+  fade_->fade_start = now;
+  ++fade_generation_;
+  const base::TimeDelta duration = CrossfadeDuration();
+  if (duration.is_zero()) {
+    return;
+  }
+  if (!fade_animator_) {
+    fade_animator_ = std::make_unique<FadeAnimator>(this, fade_element_id_);
+  }
+  if (!fade_animator_->AttachTimeline(GetDocument())) {
+    // Stepped from here each frame instead (OnFadeFrame).
+    return;
+  }
+  auto curve = gfx::KeyframedFloatAnimationCurve::Create();
+  curve->AddKeyframe(gfx::FloatKeyframe::Create(
+      base::TimeDelta(), fade_->from_opacity, CrossfadeEasing().CloneToCC()));
+  curve->AddKeyframe(gfx::FloatKeyframe::Create(duration, 0.f, nullptr));
+  auto model = cc::KeyframeModel::Create(
+      std::move(curve), cc::AnimationIdProvider::NextKeyframeModelId(),
+      cc::AnimationIdProvider::NextGroupId(),
+      cc::KeyframeModel::TargetPropertyId(cc::TargetProperty::OPACITY));
+  fade_->keyframe_model_id = model->id();
+  fade_->group_id = model->group();
+  fade_animator_->Add(std::move(model));
+  // The effect node's own opacity is where the animation ends, so the frame
+  // doesn't flash back before EndFade() removes it. The compositor drops the
+  // frame once the animation finishes; in case it never starts (the frame
+  // not composited), end the fade when it should have.
+  GetDocument()
+      .GetTaskRunner(TaskType::kInternalDefault)
+      ->PostDelayedTask(FROM_HERE,
+                        BindOnce(&HTMLNativeWindowElement::OnFadeTimeout,
+                                 WrapWeakPersistent(this), fade_generation_),
+                        duration + base::Milliseconds(100));
+  InvalidateFadePaint();
+}
+
+void HTMLNativeWindowElement::OnFadeAnimationEnded(int group_id) {
+  if (!fade_ || !fade_->keyframe_model_id || fade_->group_id != group_id) {
+    return;
+  }
+  // The compositor is done with the keyframe model; nothing to remove.
+  fade_->keyframe_model_id = 0;
+  EndFade();
+}
+
+void HTMLNativeWindowElement::OnFadeTimeout(uint64_t generation) {
+  if (fade_ && fade_->keyframe_model_id && generation == fade_generation_) {
+    EndFade();
+  }
+}
+
+void HTMLNativeWindowElement::OnFadeFrame() {
+  fade_frame_requested_ = false;
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (fade_ && fade_->fade_start.is_null() &&
+      now - fade_->hold_start >= kMaxFadeHold) {
+    StartFadeOut(now);
+  }
+  // Stepped from here when it isn't fading on the compositor.
+  if (fade_ && !fade_->keyframe_model_id && !fade_->fade_start.is_null() &&
+      now - fade_->fade_start >= CrossfadeDuration()) {
+    EndFade();
+  }
+  InvalidateFadePaint();
+}
+
+void HTMLNativeWindowElement::InvalidateFadePaint() {
+  if (auto* layout_object = GetLayoutObject()) {
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+  // Until the fade is over and the app has drawn at its size (or the wait
+  // for it is over: its frame goes back to object-fit).
+  const bool stretch_over =
+      base::TimeTicks::Now() - size_requested_ >
+      kMaxFadeHold + base::Milliseconds(50);
+  const bool compositor_fading = fade_ && fade_->keyframe_model_id;
+  if (fade_frame_requested_ || (!fade_ && last_sent_size_.IsEmpty()) ||
+      ((!fade_ || compositor_fading) && stretch_over)) {
+    return;
+  }
+  fade_frame_requested_ = true;
+  GetDocument().RequestAnimationFrame(
+      MakeGarbageCollected<FadeFrameCallback>(this),
+      FrameCallbackType::kInternal);
+}
+
+const EffectPaintPropertyNode& HTMLNativeWindowElement::UpdateFadeEffect(
+    const PropertyTreeState& parent) {
+  EffectPaintPropertyNode::State state;
+  state.local_transform_space = &parent.Transform();
+  // While the compositor fades it, the node keeps the opacity the fade ends
+  // at (see StartFadeOut()).
+  state.opacity = fade_ && fade_->keyframe_model_id ? 0.f : FadeOpacity();
+  state.compositor_element_id = fade_element_id_;
+  // EffectPaintPropertyNode::Update() doesn't look at changes in the
+  // compositing reasons: always composited, so the animation has a node to
+  // run on (as LinkHighlightImpl does).
+  state.direct_compositing_reasons = {
+      CompositingReason::kActiveOpacityAnimation};
+  if (fade_effect_) {
+    PropertyChanged(GetDocument(),
+                    fade_effect_->Update(parent.Effect(), std::move(state)));
+  } else {
+    fade_effect_ =
+        EffectPaintPropertyNode::Create(parent.Effect(), std::move(state));
+    PropertyChanged(GetDocument(),
+                    PaintPropertyChangeType::kNodeAddedOrRemoved);
+  }
+  return *fade_effect_;
+}
+
+viz::FrameSinkId HTMLNativeWindowElement::EmbeddedFrameSinkId() const {
+  return info_ ? info_->surface_id.frame_sink_id() : viz::FrameSinkId();
+}
+
+std::optional<gfx::PointF> HTMLNativeWindowElement::ResizeEdgePoint(
+    const gfx::PointF& point_in_root_frame) const {
+  auto* box = DynamicTo<LayoutBox>(GetLayoutObject());
+  LocalFrameView* view = GetDocument().View();
+  if (!FastHasAttribute(html_names::kFloatingAttr) || !box || !view ||
+      !EmbeddedFrameSinkId().is_valid() ||
+      box->Style().Visibility() != EVisibility::kVisible ||
+      box->Style().UsedPointerEvents() == EPointerEvents::kNone) {
+    return std::nullopt;
+  }
+  // In the box's own space, through any transforms on the way.
+  const gfx::PointF local =
+      box->AbsoluteToLocalPoint(view->RootFrameToDocument(point_in_root_frame));
+  const gfx::RectF content_box(box->PhysicalContentBoxRect());
+  gfx::RectF edges = content_box;
+  edges.Outset(mojom::blink::kResizeEdgeMargin *
+               box->Style().EffectiveZoom());
+  if (content_box.IsEmpty() || !edges.Contains(local) ||
+      content_box.Contains(local)) {
+    return std::nullopt;
+  }
+  return local - content_box.OffsetFromOrigin() +
+         gfx::Vector2dF(GeometryOffsetInPixels());
+}
+
+void HTMLNativeWindowElement::FullscreenChanged(bool fullscreen) {
+  if (fullscreen == fullscreen_) {
+    return;
+  }
+  fullscreen_ = fullscreen;
+  if (host_.is_bound() && client_receiver_.is_bound()) {
+    host_->OnFullscreenChanged(fullscreen);
+  }
+}
+
+void HTMLNativeWindowElement::SetFullscreen(bool fullscreen) {
+  if (!isConnected()) {
+    return;
+  }
+  if (fullscreen) {
+    if (!Fullscreen::IsFullscreenElement(*this)) {
+      ScopedAllowFullscreen allow(ScopedAllowFullscreen::kBrowserRequest);
+      Fullscreen::RequestFullscreen(*this);
+    }
+  } else if (Fullscreen::IsFullscreenElement(*this)) {
+    Fullscreen::FullyExitFullscreen(GetDocument());
+  }
+}
+
+void HTMLNativeWindowElement::Trace(Visitor* visitor) const {
+  visitor->Trace(host_);
+  visitor->Trace(client_receiver_);
+  visitor->Trace(fade_effect_);
+  visitor->Trace(visibility_observer_);
+  HTMLElement::Trace(visitor);
+}
+
+void HTMLNativeWindowElement::ParseAttribute(
+    const AttributeModificationParams& params) {
+  if (params.name == html_names::kWindowAttr ||
+      params.name == html_names::kGrantAttr) {
+    UpdateAttachment();
+    return;
+  }
+  if (params.name == html_names::kCrossfadeAttr) {
+    if (CrossfadeDuration().is_zero()) {
+      EndFade();
+    }
+    return;
+  }
+  if (params.name == html_names::kCrossfadeEasingAttr) {
+    easing_ = nullptr;
+    return;
+  }
+  if (params.name == html_names::kFloatingAttr) {
+    if (attach_requested_ && host_.is_bound()) {
+      host_->SetFloating(!params.new_value.IsNull());
+    }
+    return;
+  }
+  HTMLElement::ParseAttribute(params);
+}
+
+LayoutObject* HTMLNativeWindowElement::CreateLayoutObject(
+    const ComputedStyle&) {
+  return MakeGarbageCollected<LayoutNativeWindow>(this);
+}
+
+Node::InsertionNotificationRequest HTMLNativeWindowElement::InsertedInto(
+    ContainerNode& insertion_point) {
+  HTMLElement::InsertedInto(insertion_point);
+  UpdateAttachment();
+  return kInsertionDone;
+}
+
+void HTMLNativeWindowElement::RemovedFrom(ContainerNode& insertion_point) {
+  HTMLElement::RemovedFrom(insertion_point);
+  UpdateAttachment();
+}
+
+void HTMLNativeWindowElement::DetachLayoutTree(bool performing_reattach) {
+  HTMLElement::DetachLayoutTree(performing_reattach);
+  // Not laid out (display: none, or removed): it no longer shows the window.
+  if (!performing_reattach) {
+    ForgetShownFrame();
+  }
+}
+
+void HTMLNativeWindowElement::OnInfoChanged(
+    mojom::blink::NativeWindowInfoPtr info) {
+  const bool size_changed =
+      !info_ || info_->geometry.size() != info->geometry.size() ||
+      info_->device_scale_factor != info->device_scale_factor;
+  const bool focus_changed =
+      info_ ? info_->focused != info->focused : info->focused;
+  const bool first_info = !info_;
+  // EXO-DISPLAYS: back from another page.
+  taken_window_id_ = 0;
+  info_ = std::move(info);
+  // EXO-CROSSFADE: the app drew at a new size; fade the old frame out.
+  if (fade_ && fade_->fade_start.is_null() &&
+      WindowSizeInPixels() != fade_->frame.geometry_size) {
+    StartFadeOut(base::TimeTicks::Now());
+    InvalidateFadePaint();
+  }
+  UpdateSurfaceLayer();
+  // Attached while already fullscreen: tell the browser now.
+  if (first_info && !fullscreen_ && Fullscreen::IsFullscreenElement(*this)) {
+    FullscreenChanged(true);
+  }
+  if (auto* layout_object = DynamicTo<LayoutNativeWindow>(GetLayoutObject())) {
+    if (size_changed) {
+      layout_object->NaturalSizeChanged();
+    }
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+  DispatchSimpleEvent("windowchange");
+  if (focus_changed) {
+    DispatchSimpleEvent(info_->focused ? "windowfocus" : "windowblur");
+  }
+}
+
+void HTMLNativeWindowElement::OnTaken() {
+  // EXO-DISPLAYS: another page shows the window now; the page may show a
+  // placeholder until it comes back (OnInfoChanged()).
+  taken_window_id_ = info_ ? info_->window_id : window_id_;
+  if (!taken_window_id_) {
+    taken_window_id_ = -1;
+  }
+  info_.reset();
+  ForgetShownFrame();
+  UpdateSurfaceLayer();
+  if (auto* layout_object = DynamicTo<LayoutNativeWindow>(GetLayoutObject())) {
+    layout_object->NaturalSizeChanged();
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+  DispatchSimpleEvent("windowchange");
+  DispatchSimpleEvent("windowtaken");
+}
+
+void HTMLNativeWindowElement::OnClosed() {
+  closed_ = true;
+  taken_window_id_ = 0;
+  client_receiver_.reset();
+  info_.reset();
+  ForgetShownFrame();
+  UpdateSurfaceLayer();
+  if (auto* layout_object = DynamicTo<LayoutNativeWindow>(GetLayoutObject())) {
+    layout_object->NaturalSizeChanged();
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+  DispatchSimpleEvent("windowclose");
+}
+
+void HTMLNativeWindowElement::UpdateAttachment() {
+  bool attach_requested = false;
+  std::optional<base::UnguessableToken> grant;
+  int32_t window_id = 0;
+  if (isConnected() && GetExecutionContext()) {
+    const AtomicString& grant_attr = FastGetAttribute(html_names::kGrantAttr);
+    if (!grant_attr.empty()) {
+      attach_requested = true;
+      grant = base::UnguessableToken::DeserializeFromString(
+          grant_attr.GetString().Utf8());
+      int value = 0;
+      if (ParseHTMLInteger(FastGetAttribute(html_names::kWindowAttr), value) &&
+          value > 0) {
+        window_id = value;
+      }
+    }
+  }
+  if (attach_requested == attach_requested_ && grant == grant_ &&
+      window_id == window_id_) {
+    return;
+  }
+  DetachWindow();
+  if (!attach_requested) {
+    return;
+  }
+  attach_requested_ = true;
+  grant_ = grant;
+  window_id_ = window_id;
+  const uint64_t attach_id = ++attach_id_;
+  ExecutionContext* context = GetExecutionContext();
+  scoped_refptr<base::SingleThreadTaskRunner> task_runner =
+      context->GetTaskRunner(TaskType::kInternalDefault);
+  if (!grant) {
+    // Not a token at all: fail without asking the browser, but just as
+    // asynchronously.
+    task_runner->PostTask(
+        FROM_HERE, BindOnce(&HTMLNativeWindowElement::OnAttached,
+                            WrapWeakPersistent(this), attach_id, false));
+    return;
+  }
+  BindHost();
+  ObserveVisibility();
+  host_->Attach(*grant, window_id,
+                client_receiver_.BindNewPipeAndPassRemote(task_runner),
+                BindOnce(&HTMLNativeWindowElement::OnAttached,
+                         WrapWeakPersistent(this), attach_id));
+  host_->SetFloating(FastHasAttribute(html_names::kFloatingAttr));
+}
+
+void HTMLNativeWindowElement::BindHost() {
+  if (host_.is_bound()) {
+    return;
+  }
+  ExecutionContext* context = GetExecutionContext();
+  context->GetBrowserInterfaceBroker().GetInterface(
+      host_.BindNewPipeAndPassReceiver(
+          context->GetTaskRunner(TaskType::kInternalDefault)));
+}
+
+void HTMLNativeWindowElement::DetachWindow() {
+  if (!attach_requested_) {
+    return;
+  }
+  if (host_.is_bound() && client_receiver_.is_bound()) {
+    host_->Detach();
+  }
+  client_receiver_.reset();
+  attach_requested_ = false;
+  grant_.reset();
+  window_id_ = 0;
+  taken_window_id_ = 0;
+  closed_ = false;
+  last_sent_size_ = gfx::Size();
+  last_resize_ = base::TimeTicks();
+  last_sent_rect_ = gfx::Rect();
+  last_sent_scale_ = 1.f;
+  if (visibility_observer_) {
+    visibility_observer_->disconnect();
+    visibility_observer_ = nullptr;
+  }
+  visible_ = false;
+  fullscreen_ = false;
+  // Whatever attaches next is a different window (or the same one anew):
+  // nothing to animate from.
+  ForgetShownFrame();
+  const bool had_info = !!info_;
+  info_.reset();
+  UpdateSurfaceLayer();
+  if (auto* layout_object = DynamicTo<LayoutNativeWindow>(GetLayoutObject())) {
+    if (had_info) {
+      layout_object->NaturalSizeChanged();
+    }
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+}
+
+void HTMLNativeWindowElement::OnAttached(uint64_t attach_id, bool success) {
+  if (attach_id != attach_id_ || !attach_requested_ || success) {
+    return;
+  }
+  // EXO-BROKER: refused (no valid grant for this document, or the window
+  // can't be embedded).
+  client_receiver_.reset();
+  DispatchSimpleEvent("windowchange");
+  DispatchSimpleEvent("windowerror");
+}
+
+void HTMLNativeWindowElement::UpdateSurfaceLayer() {
+  if (!info_ || !info_->surface_id.is_valid()) {
+    surface_layer_ = nullptr;
+    return;
+  }
+  const viz::SurfaceId& current = info_->surface_id;
+  const viz::LocalSurfaceId& lsi = current.local_surface_id();
+  viz::SurfaceId range_end(
+      current.frame_sink_id(),
+      viz::LocalSurfaceId(lsi.parent_sequence_number() + kSurfaceRangeSpan,
+                          lsi.child_sequence_number() + kSurfaceRangeSpan,
+                          lsi.embed_token()));
+  if (!surface_layer_) {
+    surface_layer_ = cc::SurfaceLayer::Create();
+    surface_layer_->SetStretchContentToFillBounds(false);
+    surface_layer_->SetSurfaceHitTestable(true);
+    surface_layer_->SetBlocksActivation(false);
+    surface_layer_->SetIsDrawable(true);
+  }
+  surface_layer_->SetOldestAcceptableFallback(current);
+  surface_layer_->SetSurfaceId(range_end,
+                               cc::DeadlinePolicy::UseSpecifiedDeadline(0));
+}
+
+void HTMLNativeWindowElement::DispatchSimpleEvent(const char* type) {
+  DispatchEvent(*Event::Create(AtomicString(type)));
+}
+
+}  // namespace blink
