@@ -0,0 +1,79 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/html/context_menu_request_event.h"
+
+#include "third_party/blink/renderer/bindings/core/v8/idl_types.h"
+#include "third_party/blink/renderer/bindings/core/v8/to_v8_traits.h"
+#include "third_party/blink/renderer/bindings/core/v8/v8_context_menu_item.h"
+#include "third_party/blink/renderer/core/event_interface_names.h"
+#include "third_party/blink/renderer/core/event_type_names.h"
+#include "third_party/blink/renderer/platform/bindings/script_state.h"
+
+namespace blink {
+
+namespace {
+
+String TypeName(mojom::blink::ContextMenuItemType type) {
+  switch (type) {
+    case mojom::blink::ContextMenuItemType::kCommand:
+      return "command";
+    case mojom::blink::ContextMenuItemType::kCheckbox:
+      return "checkbox";
+    case mojom::blink::ContextMenuItemType::kRadio:
+      return "radio";
+    case mojom::blink::ContextMenuItemType::kSeparator:
+      return "separator";
+    case mojom::blink::ContextMenuItemType::kSubmenu:
+      return "submenu";
+    case mojom::blink::ContextMenuItemType::kTitle:
+      return "title";
+  }
+  return "command";
+}
+
+}  // namespace
+
+ContextMenuRequestEvent::ContextMenuRequestEvent(
+    const mojom::blink::ContextMenuRequest& request,
+    float scale)
+    : Event(event_type_names::kContextmenurequest,
+            Bubbles::kNo,
+            Cancelable::kYes),
+      menu_id_(request.id),
+      tab_id_(request.tab_id),
+      x_(request.x * scale),
+      y_(request.y * scale),
+      link_url_(request.link_url),
+      selection_text_(request.selection_text),
+      editable_(request.editable),
+      media_type_(request.media_type) {
+  for (const auto& item : request.items) {
+    auto* entry = ContextMenuItem::Create();
+    entry->setId(item->id);
+    entry->setParentId(item->parent_id);
+    entry->setType(TypeName(item->type));
+    entry->setLabel(item->label);
+    entry->setEnabled(item->enabled);
+    entry->setChecked(item->checked);
+    items_.push_back(entry);
+  }
+}
+
+ScriptValue ContextMenuRequestEvent::items(ScriptState* script_state) const {
+  return ScriptValue(script_state->GetIsolate(),
+                     ToV8Traits<IDLSequence<ContextMenuItem>>::ToV8(
+                         script_state, items_));
+}
+
+const AtomicString& ContextMenuRequestEvent::InterfaceName() const {
+  return event_interface_names::kContextMenuRequestEvent;
+}
+
+void ContextMenuRequestEvent::Trace(Visitor* visitor) const {
+  visitor->Trace(items_);
+  Event::Trace(visitor);
+}
+
+}  // namespace blink
