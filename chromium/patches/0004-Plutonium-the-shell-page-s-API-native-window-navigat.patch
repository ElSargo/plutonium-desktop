diff --git a/third_party/blink/renderer/core/html/native_display_entry.idl b/third_party/blink/renderer/core/html/native_display_entry.idl
new file mode 100644
index 0000000000..8efe478a61
--- /dev/null
+++ b/third_party/blink/renderer/core/html/native_display_entry.idl
@@ -0,0 +1,32 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// EXO-DISPLAYS: a display (NativeWindowBroker.getDisplays()). Each has its
+// own shell windows (a page per enabled shell) and its own visible shell.
+dictionary NativeDisplayEntry {
+    // Stable while it is plugged in.
+    required DOMString id;
+    // 1-based, left to right (then top to bottom): "display 2".
+    required unsigned long index;
+    required DOMString label;
+    // In CSS pixels at zoom 1 (DIPs), in the desktop's coordinates.
+    required long x;
+    required long y;
+    required long width;
+    required long height;
+    // Without system UI (in shell mode, the whole display).
+    required long workX;
+    required long workY;
+    required long workWidth;
+    required long workHeight;
+    required double scaleFactor;
+    // Degrees, clockwise.
+    required long rotation;
+    required boolean primary;
+    required boolean internal;
+    // It has keyboard focus.
+    required boolean focused;
+    // This document's display.
+    required boolean current;
+};
