+const char NavigatorNativeWindowBroker::kSupplementName[] =
+    "NavigatorNativeWindowBroker";
+
+// static
+NativeWindowBroker* NavigatorNativeWindowBroker::windowBroker(
+    Navigator& navigator) {
+  auto* supplement =
+      Supplement<Navigator>::From<NavigatorNativeWindowBroker>(navigator);
+  if (!supplement) {
+    supplement = MakeGarbageCollected<NavigatorNativeWindowBroker>(navigator);
+    ProvideTo(navigator, supplement);
+  }
+  return supplement->broker_.Get();
+}
+
+NavigatorNativeWindowBroker::NavigatorNativeWindowBroker(Navigator& navigator)
+    : Supplement(navigator),
+      broker_(MakeGarbageCollected<NativeWindowBroker>(
+          navigator.GetExecutionContext())) {}
+
+void NavigatorNativeWindowBroker::Trace(Visitor* visitor) const {
+  visitor->Trace(broker_);
+  Supplement<Navigator>::Trace(visitor);
+}
