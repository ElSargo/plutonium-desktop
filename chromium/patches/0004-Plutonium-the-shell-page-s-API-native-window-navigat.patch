+  remote_->GetGroups(BindOnce(
+      [](NativeWindowBroker* self,
+         ScriptPromiseResolver<IDLSequence<ItemGroup>>* resolver,
+         Vector<mojom::blink::ItemGroupPtr> groups) {
+        self->pending_.erase(resolver);
