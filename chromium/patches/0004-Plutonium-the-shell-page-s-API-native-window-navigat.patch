+
+NativeWindowBroker::NativeWindowBroker(ExecutionContext* context)
+    : ExecutionContextClient(context),
+      remote_(context),
+      observer_receiver_(this, context),
+      tab_observer_receiver_(this, context),
+      group_observer_receiver_(this, context),
+      shell_observer_receiver_(this, context),
+      context_menu_observer_receiver_(this, context),
+      tab_request_observer_receiver_(this, context),
+      download_observer_receiver_(this, context),
+      capture_observer_receiver_(this, context) {}
+
+bool NativeWindowBroker::BindRemote() {
+  ExecutionContext* context = GetExecutionContext();
+  if (!context || disconnected_) {
+    return false;
+  }
+  if (!remote_.is_bound()) {
+    context->GetBrowserInterfaceBroker().GetInterface(
+        remote_.BindNewPipeAndPassReceiver(
+            context->GetTaskRunner(TaskType::kInternalDefault)));
+    remote_.set_disconnect_handler(BindOnce(
+        &NativeWindowBroker::OnDisconnected, WrapWeakPersistent(this)));
+  }
+  return true;
+}
+
+bool NativeWindowBroker::EnsureBound(ScriptPromiseResolverBase* resolver) {
+  if (!BindRemote()) {
+    resolver->RejectWithDOMException(DOMExceptionCode::kNotAllowedError,
+                                     "The window broker is not available.");
+    return false;
+  }
+  pending_.insert(resolver);
+  return true;
+}
+
+void NativeWindowBroker::AddedEventListener(
+    const AtomicString& event_type,
+    RegisteredEventListener& registered_listener) {
+  EventTarget::AddedEventListener(event_type, registered_listener);
+  if (IsWindowEvent(event_type)) {
+    Subscribe();
+  }
+  if (IsTabEvent(event_type)) {
+    SubscribeTabs();
+  }
+  if (event_type == event_type_names::kGroupschanged) {
+    SubscribeGroups();
+  }
+  if (event_type == event_type_names::kShellschanged ||
+      event_type == event_type_names::kDisplayschanged ||
+      event_type == event_type_names::kTouchpadswipe) {
+    SubscribeShells();
+  }
+  if (event_type == event_type_names::kContextmenurequest) {
+    SubscribeContextMenus();
+  }
+  if (event_type == event_type_names::kTabrequest ||
+      event_type == event_type_names::kTabrequestend) {
+    SubscribeTabRequests();
+  }
+  if (IsDownloadEvent(event_type)) {
+    SubscribeDownloads();
+  }
+  if (IsCaptureEvent(event_type)) {
+    SubscribeCaptures();
+  }
+}
+
+void NativeWindowBroker::RemovedEventListener(
+    const AtomicString& event_type,
+    const RegisteredEventListener& registered_listener) {
+  EventTarget::RemovedEventListener(event_type, registered_listener);
+  // The last listener of a kind went: unsubscribe. Closing the observer's
+  // end is enough; the browser drops it.
+  if (IsWindowEvent(event_type) &&
+      !HasAnyEventListeners({event_type_names::kWindowadded,
+                             event_type_names::kWindowchanged,
+                             event_type_names::kWindowremoved,
+                             event_type_names::kWindowfocusrequest,
+                             event_type_names::kGrantrevoked})) {
+    observer_receiver_.reset();
+  }
+  if (IsTabEvent(event_type) &&
+      !HasAnyEventListeners(
+          {event_type_names::kTabadded, event_type_names::kTabchanged,
+           event_type_names::kTabremoved,
+           event_type_names::kTabfocusrequest})) {
+    tab_observer_receiver_.reset();
+  }
+  if (event_type == event_type_names::kGroupschanged &&
+      !HasEventListeners(event_type)) {
+    group_observer_receiver_.reset();
+  }
+  if ((event_type == event_type_names::kShellschanged ||
+       event_type == event_type_names::kDisplayschanged ||
+       event_type == event_type_names::kTouchpadswipe) &&
+      !HasAnyEventListeners({event_type_names::kShellschanged,
+                             event_type_names::kDisplayschanged,
+                             event_type_names::kTouchpadswipe})) {
+    shell_observer_receiver_.reset();
+  }
+  if (event_type == event_type_names::kContextmenurequest &&
+      !HasEventListeners(event_type)) {
+    context_menu_observer_receiver_.reset();
+  }
+  // What it took falls back in the browser.
+  if ((event_type == event_type_names::kTabrequest ||
+       event_type == event_type_names::kTabrequestend) &&
+      !HasAnyEventListeners({event_type_names::kTabrequest,
+                             event_type_names::kTabrequestend})) {
+    tab_request_observer_receiver_.reset();
+    taken_tab_requests_.clear();
+  }
+  if (IsDownloadEvent(event_type) &&
+      !HasAnyEventListeners({event_type_names::kDownloadadded,
+                             event_type_names::kDownloadchanged,
+                             event_type_names::kDownloadremoved})) {
+    download_observer_receiver_.reset();
+  }
+  // What it took goes to Ash's picker.
+  if (IsCaptureEvent(event_type) &&
+      !HasAnyEventListeners({event_type_names::kCapturerequest,
+                             event_type_names::kCapturerequestend,
+                             event_type_names::kCapturestart,
+                             event_type_names::kCapturechange,
+                             event_type_names::kCapturestop,
+                             event_type_names::kCapturesettingschange})) {
+    capture_observer_receiver_.reset();
+    taken_capture_requests_.clear();
+  }
+}
+
+void NativeWindowBroker::SubscribeContextMenus() {
+  if (context_menu_observer_receiver_.is_bound() || !BindRemote()) {
+    return;
+  }
+  remote_->AddContextMenuObserver(
+      context_menu_observer_receiver_.BindNewEndpointAndPassRemote(
+          GetExecutionContext()->GetTaskRunner(TaskType::kInternalDefault)));
+}
+
+void NativeWindowBroker::OnContextMenuRequested(
+    mojom::blink::ContextMenuRequestPtr request,
+    OnContextMenuRequestedCallback callback) {
+  auto* window = DynamicTo<LocalDOMWindow>(GetExecutionContext());
+  LocalFrame* frame = window ? window->GetFrame() : nullptr;
+  if (!frame) {
+    std::move(callback).Run(false);
+    return;
+  }
+  // The browser's point is in DIPs; script works in CSS pixels.
+  const float scale =
+      frame->GetChromeClient().WindowToViewportScalar(frame, 1.0f) /
+      frame->LayoutZoomFactor();
+  auto* event = MakeGarbageCollected<ContextMenuRequestEvent>(*request, scale);
+  DispatchEvent(*event);
+  std::move(callback).Run(event->defaultPrevented());
+}
+
+void NativeWindowBroker::closeContextMenu(int32_t menu_id, int32_t item_id) {
+  if (!BindRemote()) {
+    return;
+  }
+  remote_->CloseContextMenu(menu_id, item_id);
+}
+
+void NativeWindowBroker::SubscribeTabRequests() {
+  if (tab_request_observer_receiver_.is_bound() || !BindRemote()) {
+    return;
+  }
+  remote_->AddTabRequestObserver(
+      tab_request_observer_receiver_.BindNewEndpointAndPassRemote(
+          GetExecutionContext()->GetTaskRunner(TaskType::kInternalDefault)));
+}
+
+void NativeWindowBroker::OnTabRequest(mojom::blink::TabRequestPtr request,
+                                      OnTabRequestCallback callback) {
+  auto* event = MakeGarbageCollected<TabRequestEvent>(
+      event_type_names::kTabrequest, request->id, request->tab_id,
+      request->kind, request->detail_json);
+  DispatchEvent(*event);
+  const bool taken = event->defaultPrevented();
+  if (taken) {
+    taken_tab_requests_.Set(request->id,
+                            std::make_pair(request->tab_id, request->kind));
+  }
+  std::move(callback).Run(taken);
+}
+
+void NativeWindowBroker::OnTabRequestEnded(int32_t request_id) {
+  auto it = taken_tab_requests_.find(request_id);
+  if (it == taken_tab_requests_.end()) {
+    return;
+  }
+  const auto [tab_id, kind] = it->value;
+  taken_tab_requests_.erase(it);
+  DispatchEvent(*MakeGarbageCollected<TabRequestEvent>(
+      event_type_names::kTabrequestend, request_id, tab_id, kind, String()));
+}
+
+ScriptPromise<IDLString> NativeWindowBroker::permissionCommand(
+    ScriptState* script_state,
+    const String& command,
+    const String& args_json) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLString>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->RunPermissionCommand(
+      command, args_json,
+      BindOnce(
+          [](NativeWindowBroker* self, ScriptPromiseResolver<IDLString>* resolver,
+             bool ok, const String& result) {
+            self->pending_.erase(resolver);
+            if (!ok) {
+              resolver->RejectWithDOMException(
+                  DOMExceptionCode::kOperationError, result);
+              return;
+            }
+            resolver->Resolve(result);
+          },
+          WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+void NativeWindowBroker::focusPage(ExecutionContext* context) {
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    if (LocalFrame* frame = window->GetFrame()) {
+      frame->DidFocus();
+    }
+  }
+}
+
+File* NativeWindowBroker::fileForPath(ExecutionContext* context,
+                                      const String& path) {
+  if (BindRemote()) {
+    remote_->GrantFileAccess({path});
+  }
+  return File::CreateForUserProvidedFile(context, path, String());
+}
+
+String NativeWindowBroker::pathForFile(File* file) {
+  return file && file->HasBackingFile() ? file->GetPath() : String("");
+}
+
+ScriptPromise<IDLString> NativeWindowBroker::startFileDrag(
+    ScriptState* script_state,
+    const Vector<String>& paths,
+    const String& image_png_base64) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLString>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->StartFileDrag(
+      paths, image_png_base64,
+      BindOnce(
+          [](NativeWindowBroker* self,
+             ScriptPromiseResolver<IDLString>* resolver,
+             const String& operation) {
+            self->pending_.erase(resolver);
+            resolver->Resolve(operation);
+          },
+          WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+ScriptPromise<IDLBoolean> NativeWindowBroker::answerTabRequest(
+    ScriptState* script_state,
+    int32_t request_id,
+    const String& answer_json) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLBoolean>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->AnswerTabRequest(
+      request_id, answer_json,
+      BindOnce(
+          [](NativeWindowBroker* self,
+             ScriptPromiseResolver<IDLBoolean>* resolver, int32_t request_id,
+             bool ok) {
+            self->pending_.erase(resolver);
+            if (ok) {
+              self->taken_tab_requests_.erase(request_id);
+            }
+            resolver->Resolve(ok);
+          },
+          WrapPersistent(this), WrapPersistent(resolver), request_id));
+  return promise;
+}
+
+void NativeWindowBroker::SubscribeDownloads() {
+  if (download_observer_receiver_.is_bound() || !BindRemote()) {
+    return;
+  }
+  remote_->AddDownloadObserver(
+      download_observer_receiver_.BindNewEndpointAndPassRemote(
+          GetExecutionContext()->GetTaskRunner(TaskType::kInternalDefault)),
+      BindOnce(&NativeWindowBroker::OnDownloadSnapshot,
+               WrapWeakPersistent(this), ++download_subscription_));
+}
+
+void NativeWindowBroker::OnDownloadSnapshot(
