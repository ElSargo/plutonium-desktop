+bool IsWindowEvent(const AtomicString& event_type) {
+  return event_type == event_type_names::kWindowadded ||
+         event_type == event_type_names::kWindowchanged ||
+         event_type == event_type_names::kWindowremoved ||
+         event_type == event_type_names::kWindowfocusrequest ||
+         event_type == event_type_names::kGrantrevoked;
+}
+
+bool IsDownloadEvent(const AtomicString& event_type) {
+  return event_type == event_type_names::kDownloadadded ||
+         event_type == event_type_names::kDownloadchanged ||
+         event_type == event_type_names::kDownloadremoved;
+}
+
+bool IsCaptureEvent(const AtomicString& event_type) {
+  return event_type == event_type_names::kCapturerequest ||
+         event_type == event_type_names::kCapturerequestend ||
+         event_type == event_type_names::kCapturestart ||
+         event_type == event_type_names::kCapturechange ||
+         event_type == event_type_names::kCapturestop ||
+         event_type == event_type_names::kCapturesettingschange;
+}
+
+bool IsTabEvent(const AtomicString& event_type) {
+  return event_type == event_type_names::kTabadded ||
+         event_type == event_type_names::kTabchanged ||
+         event_type == event_type_names::kTabremoved ||
+         event_type == event_type_names::kTabfocusrequest;
+}
+
+NativeWindowEntry* ToEntry(const mojom::blink::NativeWindowEntry& window) {
+  auto* entry = NativeWindowEntry::Create();
+  entry->setId(window.id);
+  entry->setAppId(window.app_id);
+  entry->setTitle(window.title);
+  entry->setWidth(window.width);
+  entry->setHeight(window.height);
+  entry->setMinWidth(window.min_width);
+  entry->setMinHeight(window.min_height);
+  entry->setMaxWidth(window.max_width);
+  entry->setMaxHeight(window.max_height);
+  entry->setDeviceScaleFactor(window.device_scale_factor);
+  entry->setEmbedded(window.embedded);
+  entry->setFocused(window.focused);
+  entry->setPid(window.pid);
+  entry->setTag(window.tag);
+  entry->setTags(window.tags);
+  entry->setIconName(window.icon_name);
+  entry->setIcon(window.icon_url);
+  return entry;
+}
+
+BrowserTabEntry* ToEntry(const mojom::blink::BrowserTabEntry& tab) {
+  auto* entry = BrowserTabEntry::Create();
+  entry->setId(tab.id);
+  entry->setContentId(String(tab.content_id.ToString()));
+  entry->setUrl(tab.url);
+  entry->setTitle(tab.title);
+  entry->setLoading(tab.loading);
+  entry->setCanGoBack(tab.can_go_back);
+  entry->setCanGoForward(tab.can_go_forward);
+  entry->setEmbedded(tab.embedded);
+  entry->setFocused(tab.focused);
+  entry->setTag(tab.tag);
+  entry->setOpenerId(tab.opener_id);
+  entry->setOpenedBy(tab.opened_by);
+  entry->setDialogType(tab.dialog_type);
+  entry->setDialogMessage(tab.dialog_message);
+  entry->setDialogDefaultPrompt(tab.dialog_default_prompt);
+  entry->setTags(tab.tags);
+  entry->setStateJson(tab.state_json);
+  entry->setIncognito(tab.incognito);
+  return entry;
+}
+
+ShellEntry* ToEntry(const mojom::blink::ShellEntry& shell) {
+  auto* entry = ShellEntry::Create();
+  entry->setId(shell.id);
+  entry->setName(shell.name);
+  entry->setUrl(shell.url);
+  entry->setOrigin(shell.origin);
+  entry->setEnabled(shell.enabled);
+  entry->setRunning(shell.running);
+  entry->setVisible(shell.visible);
+  entry->setDisplays(shell.displays);
+  entry->setVisibleOn(shell.visible_on);
+  return entry;
+}
+
+NativeDisplayEntry* ToEntry(const mojom::blink::NativeDisplayEntry& display) {
+  auto* entry = NativeDisplayEntry::Create();
+  entry->setId(display.id);
+  entry->setIndex(display.index);
+  entry->setLabel(display.label);
+  entry->setX(display.x);
+  entry->setY(display.y);
+  entry->setWidth(display.width);
+  entry->setHeight(display.height);
+  entry->setWorkX(display.work_x);
+  entry->setWorkY(display.work_y);
+  entry->setWorkWidth(display.work_width);
+  entry->setWorkHeight(display.work_height);
+  entry->setScaleFactor(display.scale_factor);
+  entry->setRotation(display.rotation);
+  entry->setPrimary(display.primary);
+  entry->setInternal(display.internal);
+  entry->setFocused(display.focused);
+  entry->setCurrent(display.current);
+  return entry;
+}
