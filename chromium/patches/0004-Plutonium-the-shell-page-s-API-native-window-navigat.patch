+void NativeWindowBroker::Trace(Visitor* visitor) const {
+  visitor->Trace(remote_);
+  visitor->Trace(observer_receiver_);
+  visitor->Trace(tab_observer_receiver_);
+  visitor->Trace(group_observer_receiver_);
+  visitor->Trace(shell_observer_receiver_);
+  visitor->Trace(context_menu_observer_receiver_);
+  visitor->Trace(tab_request_observer_receiver_);
+  visitor->Trace(download_observer_receiver_);
+  visitor->Trace(capture_observer_receiver_);
+  visitor->Trace(pending_);
+  EventTarget::Trace(visitor);
+  ExecutionContextClient::Trace(visitor);
