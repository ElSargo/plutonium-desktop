@@ -0,0 +1,512 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module blink.mojom;
+
+import "mojo/public/mojom/base/big_buffer.mojom";
+import "mojo/public/mojom/base/unguessable_token.mojom";
+
+// EXO-BROKER: the privileged shell's window broker API.
+//
+// Bound only for the shell document: the primary main frame of a top-level
+// WebContents whose committed URL and origin are the origin given by
+// --plutonium-shell-origin (see chrome/browser/plutonium_shell.h). Any other
+// frame's receiver is dropped. The JS API (navigator.windowBroker) is only
+// exposed to that document too, but the browser-side check is the security
+// boundary.
+
+// A native window as the broker lists it.
+struct NativeWindowEntry {
+  // The broker's window id. Stable and never reused; not a capability.
+  int32 id;
+  string app_id;
+  string title;
+  // Window geometry size in DIPs.
+  int32 width;
+  int32 height;
+  // PLUTONIUM: the app's size limits (DIPs); 0 on an axis means no limit.
+  // A window whose minimum equals its maximum can't be resized.
+  int32 min_width;
+  int32 min_height;
+  int32 max_width;
+  int32 max_height;
+  float device_scale_factor;
+  // Whether an element shows the window, and whether it has embedded
+  // keyboard focus.
+  bool embedded;
+  bool focused;
+  // Pid of the Wayland client in the browser's pid namespace (0 if unknown).
+  int32 pid;
+  // EXO-TAGS (see chrome/browser/plutonium_groups.h): the thread that
+  // started the client (its PLUTONIUM_THREAD_ID, or the nearest ancestor's),
+  // or "". Never changes.
+  string tag;
+  // |tag| (if any) first, then the tags shells added. Items with the same
+  // tag go together.
+  array<string> tags;
+  // PLUTONIUM: the app's icon (xdg_toplevel_icon_v1): an icon theme name,
+  // and a PNG data URL of its pixels; each empty if it set none.
+  string icon_name;
+  string icon_url;
+};
+
+// Window lifecycle events, surfaced to script as navigator.windowBroker's
+// "windowadded", "windowchanged", "windowremoved" and "grantrevoked" events.
+// The renderer unsubscribes by closing its end, when the page has no
+// listeners left.
+interface WindowBrokerObserver {
+  OnWindowAdded(NativeWindowEntry window);
+  OnWindowChanged(NativeWindowEntry window);
+  OnWindowRemoved(int32 window_id);
+  // EXO-BROKER: |grant| (for |window_id|), held by this document, is no
+  // longer valid: the shell revoked it, or the window closed (then just
+  // before OnWindowRemoved()). Elements using it have detached. Surfaced as
+  // a "grantrevoked" event.
+  OnGrantRevoked(mojo_base.mojom.UnguessableToken grant, int32 window_id);
+  // EXO-SHELLS: the browser's own UI (the shells overlay) asks this shell to
+  // show |window|. Surfaced as a "windowfocusrequest" event.
+  OnWindowFocusRequested(NativeWindowEntry window);
+};
+
+// EXO-TABS: a browser tab as the broker lists it. A tab is a real web page
+// (its own WebContents, in the shell's profile) that the shell shows with
+//   <embed type="application/x-chromium-surface-embed"
+//          data-content-id="{content_id}">
+// Tabs outlive the shell document that created them (a reloaded shell sees
+// them again) and close with their profile.
+struct BrowserTabEntry {
+  // The broker's tab id. Stable and never reused; not a capability.
+  int32 id;
+  // What an <embed> in the shell document needs to show the tab. Only the
+  // shell document can attach it (other documents get no SurfaceEmbed host).
+  mojo_base.mojom.UnguessableToken content_id;
+  // The visible URL and title.
+  string url;
+  string title;
+  bool loading;
+  bool can_go_back;
+  bool can_go_forward;
+  // Whether an <embed> shows the tab, and whether it has focus.
+  bool embedded;
+  bool focused;
+  // Set by the shell when it creates the tab and inherited by tabs the page
+  // opens (e.g. an agent thread id). Opaque to the browser.
+  string tag;
+  // The tab whose page opened this one (window.open, target=_blank, a
+  // middle click), or 0.
+  int32 opener_id;
+  // Who opened it: "shell" (CreateTab) or "page" (opened by the page in
+  // opener_id, or by a page that has since closed).
+  string opened_by;
+  // A dialog the page waits on: "alert", "confirm", "prompt" or
+  // "beforeunload", or "" if none. The shell shows it and answers with
+  // AnswerTabDialog(). One at a time: the page's further dialogs are
+  // suppressed until it is answered.
+  string dialog_type;
+  string dialog_message;
+  string dialog_default_prompt;
+  // EXO-TAGS: |tag| (if any) first, then the tags shells added (a page's new
+  // tab starts with its opener's).
+  array<string> tags;
+  // EXO-TAB-FEATURES (chrome/browser/plutonium_tabs.h, SetTabState()): what
+  // the tab's features report, a JSON object: "zoom", "pending" (the tab
+  // requests it waits on, by kind) and the like (TAB_FEATURES.md).
+  string state_json;
+  // EXO-INCOGNITO: in a throwaway off-the-record profile of its own
+  // (CreateTab with incognito, or opened by such a tab's page).
+  bool incognito;
+};
+
+// EXO-TAGS: a tag a shell has described.
+struct ItemGroup {
+  string tag;
+  // What to call the group (e.g. the thread's title).
+  string label;
+  // The owning shell's id (EXO-SHELLS), or "" outside shell mode. Ignored
+  // in SetGroups().
+  string shell_id;
+};
+
+// EXO-SHELLS: a shell in the browser's list (chrome/browser/plutonium_shells.h).
+struct ShellEntry {
+  string id;
+  string name;
+  string url;
+  // The origin its documents must have.
+  string origin;
+  // Off: no window.
+  bool enabled;
+  // Its window is open.
+  bool running;
+  // The visible shell on the focused display.
+  bool visible;
+  // EXO-DISPLAYS: the displays it has a window on (NativeDisplayEntry.id),
+  // and the ones it is the visible shell of.
+  array<string> displays;
+  array<string> visible_on;
+};
+
+// EXO-DISPLAYS: a display. Each has its own shell windows (a page per
+// enabled shell) and its own visible shell.
+struct NativeDisplayEntry {
+  // Stable while it is plugged in (an int64, in decimal).
+  string id;
+  // 1-based, left to right (then top to bottom): "display 2".
+  int32 index;
+  string label;
+  // In DIPs, in the desktop's coordinates.
+  int32 x;
+  int32 y;
+  int32 width;
+  int32 height;
+  // Without system UI (in shell mode, the whole display).
+  int32 work_x;
+  int32 work_y;
+  int32 work_width;
+  int32 work_height;
+  float scale_factor;
+  // Degrees, clockwise.
+  int32 rotation;
+  bool primary;
+  bool internal;
+  // It has keyboard focus.
+  bool focused;
+  // The display of the document that asked.
+  bool current;
+};
+
+interface ShellObserver {
+  // Every shell, after any change.
+  OnShellsChanged(array<ShellEntry> shells);
+  // EXO-DISPLAYS: every display, after any change (one added, removed or
+  // changed, or keyboard focus moved), and once on subscribing.
+  OnDisplaysChanged(array<NativeDisplayEntry> displays);
+  // PLUTONIUM: a touchpad swipe with three fingers or more, to the visible
+  // shell on the focused display only. |swipe_json|: {phase: "begin" |
+  // "update" | "end", fingers, dx, dy (the fingers' movement since the last
+  // one, in pixels), x, y (the pointer)}.
+  OnTouchpadSwipe(string swipe_json);
+};
+
+interface GroupObserver {
+  // Every group, after any change.
+  OnGroupsChanged(array<ItemGroup> groups);
+};
+
+// Tab lifecycle events, surfaced to script as navigator.windowBroker's
+// "tabadded", "tabchanged" and "tabremoved" events.
+interface BrowserTabObserver {
+  OnTabAdded(BrowserTabEntry tab);
+  OnTabChanged(BrowserTabEntry tab);
+  OnTabRemoved(int32 tab_id);
+  // EXO-SHELLS: as OnWindowFocusRequested(), for a tab ("tabfocusrequest").
+  OnTabFocusRequested(BrowserTabEntry tab);
+};
+
+// EXO-CHROME (chrome/browser/plutonium_context_menu.h): Chrome's context menu
+// for the shell page itself or one of its tabs, for the shell to show in its
+// own style. Only what makes sense on a desktop is in it: editing, links,
+// images, media, spelling, and for a tab back, forward and reload. Not Cast,
+// Print, Save as, Inspect, Exit full screen and other browser-window items.
+enum ContextMenuItemType {
+  kCommand,
+  kCheckbox,
+  kRadio,
+  kSeparator,
+  kSubmenu,
+  kTitle,
+};
+
+struct ContextMenuItem {
+  // What CloseContextMenu() names it by; 0 for separators and titles.
+  int32 id;
+  // The submenu item it is in, or 0.
+  int32 parent_id;
+  ContextMenuItemType type;
+  string label;
+  bool enabled;
+  bool checked;
+};
+
+struct ContextMenuRequest {
+  int32 id;
+  // The tab whose page asked for the menu, or 0 for this document itself.
+  int32 tab_id;
+  // Where it was asked for, in this document's CSS pixels.
+  float x;
+  float y;
+  // The items, a submenu's after it, in order.
+  array<ContextMenuItem> items;
+  // What was under the pointer.
+  string link_url;
+  string selection_text;
+  bool editable;
+  // "image", "video", "audio", "canvas", "file", "plugin" or "".
+  string media_type;
+};
+
+interface ContextMenuObserver {
+  // Surfaced as a cancelable "contextmenurequest" event. |handled|: the page
+  // called preventDefault(), so it shows the menu and answers with
+  // CloseContextMenu(); otherwise Chrome shows its own (the same items).
+  OnContextMenuRequested(ContextMenuRequest request) => (bool handled);
+};
+
+// EXO-TAB-FEATURES (chrome/browser/plutonium_tab_requests.h): a tab's page
+// needs the user: a file chooser, a permission prompt, print, find.
+struct TabRequest {
+  int32 id;
+  int32 tab_id;
+  // "fileChooser", "permission", "print", "find", ...
+  string kind;
+  // Its details, a JSON object (each kind's are in TAB_FEATURES.md).
+  string detail_json;
+};
+
+interface TabRequestObserver {
+  // Surfaced as a cancelable "tabrequest" event. |taken|: the page called
+  // preventDefault(), so it shows its UI and answers with
+  // AnswerTabRequest(). Otherwise the browser's fallback runs at once.
+  OnTabRequest(TabRequest request) => (bool taken);
+  // Request |id|, which this page took, is over: an agent answered it, the
+  // browser cancelled it, or its tab closed. Surfaced as "tabrequestend".
+  OnTabRequestEnded(int32 id);
+};
+
+// EXO-TAB-FEATURES (chrome/browser/plutonium_downloads.h): a download from
+// a tab or the shell page, with the thread it came from.
+struct BrowserDownload {
+  // The browser's id for it, stable for the session.
+  int32 id;
+  // A JSON object: {id, tabId, thread, url, filename, path, mime,
+  // receivedBytes, totalBytes, state, danger?, error?, canResume, startTime}
+  // (docs/features/TAB_FEATURES.md, "Downloads").
+  string json;
+};
+
+interface BrowserDownloadObserver {
+  // Surfaced as "downloadadded", "downloadchanged" and "downloadremoved".
+  OnDownloadAdded(BrowserDownload download);
+  OnDownloadChanged(BrowserDownload download);
+  OnDownloadRemoved(int32 download_id);
+};
+
+// EXO-CAPTURE (chrome/browser/plutonium_capture.h, docs/features/CAPTURE.md):
+// screen captures, for every shell. A capture is a JSON object: {id, kind
+// ("stream": a shell's MediaStream, "pipewire": an app's, through the portal,
+// "display": a tab's getDisplayMedia), source ({type: "output" | "window" |
+// "tab", id, region?}), label (what the source is called), consumer ({kind:
+// "shell" | "app" | "tab" | "agent", name, appId?, pid?, thread?, tabId?,
+// shellId?}), size? ({width, height}: a window held at a capture size),
+// cursor ("hidden", "embedded" or "metadata"), nodeId? (PipeWire), startTime
+// (ms since the epoch), acknowledged (the focused shell shows it)}.
+interface CaptureObserver {
+  // A consumer asks for a capture, and this is the focused shell: a
+  // cancelable "capturerequest" event, with |detail_json| as its detail:
+  // {requestId, kind ("screencast" or "screenshot"), consumer, types (of
+  // source), multiple, cursorModes}. |taken|: the page called
+  // preventDefault(), so it asks the user and answers with the "answer"
+  // command. Otherwise Ash's own picker asks.
+  OnCaptureRequest(int32 id, string detail_json) => (bool taken);
+  // Request |id|, which this page took, is over (the consumer went away).
+  // Surfaced as "capturerequestend".
+  OnCaptureRequestEnded(int32 id);
+  // "capturestart", "capturechange" and "capturestop", with the capture.
+  OnCaptureStarted(int32 id, string capture_json);
+  OnCaptureChanged(int32 id, string capture_json);
+  OnCaptureStopped(int32 id, string capture_json);
+  // The global switches changed: {recording, screenshots}.
+  // "capturesettingschange".
+  OnCaptureSettingsChanged(string settings_json);
+};
+
+interface WindowBroker {
+  // The current windows.
+  GetWindows() => (array<NativeWindowEntry> windows);
+  // The current windows, then every later change through |observer|.
+  // |observer| is associated with this pipe, so the reply (the snapshot) is
+  // ordered before any event that follows it: nothing is missed or seen
+  // twice between the snapshot and the first event.
+  AddObserver(pending_associated_remote<WindowBrokerObserver> observer)
+      => (array<NativeWindowEntry> windows);
+  // Issues a grant for |window_id| to this (the shell's) document: a
+  // <native-window grant=…> in this document may then show the window. Null
+  // if there is no such window.
+  RequestGrant(int32 window_id) => (mojo_base.mojom.UnguessableToken? grant);
+  // Revokes a grant this document holds (elements using it detach and fire
+  // "windowclose"). Grants issued to other documents are left alone.
+  RevokeGrant(mojo_base.mojom.UnguessableToken grant);
+  // Shows |window_id| on the Ash desktop and activates it ("pops it out").
+  // While page elements still show the window, this happens as soon as the
+  // last one detaches.
+  ShowOnDesktop(int32 window_id);
+  // EXO-BRIDGE: asks the app to close |window_id|, as its close button
+  // would. The app may refuse or ask the user first.
+  Close(int32 window_id);
+  // EXO-BRIDGE: a PNG of what |window_id| shows (its window geometry, in
+  // physical pixels), even while it is hidden. Null if there is no such
+  // window or the copy failed.
+  Snapshot(int32 window_id) => (mojo_base.mojom.BigBuffer? png);
+
+  // EXO-TABS: browser tabs.
+  //
+  // The current tabs.
+  GetTabs() => (array<BrowserTabEntry> tabs);
+  // The current tabs, then every later change through |observer| (ordered
+  // with the reply, as AddObserver()).
+  AddTabObserver(pending_associated_remote<BrowserTabObserver> observer)
+      => (array<BrowserTabEntry> tabs);
+  // Opens a new tab at |url| (anything the omnibox would load, except
+  // javascript:), tagged |tag|; with |incognito|, in a throwaway
+  // off-the-record profile of its own. Null if |url| isn't loadable.
+  CreateTab(string url, string tag, bool incognito) => (BrowserTabEntry? tab);
+  // Loads |url| in |tab_id|, as typed in the omnibox. False if there is no
+  // such tab or |url| isn't loadable.
+  NavigateTab(int32 tab_id, string url) => (bool ok);
+  // Runs |command| on |tab_id|: "back", "forward", "reload", "stop",
+  // "close" (as the page's own window.close(), skipping beforeunload), or a
+  // tab feature's ("zoom-in", "find", ...; TAB_FEATURES.md), with
+  // |args_json| (a JSON object, or empty). |result_json| is its result as
+  // JSON, or why it failed.
+  RunTabCommand(int32 tab_id, string command, string args_json)
+      => (bool ok, string result_json);
+  // Answers |tab_id|'s pending dialog: OK (|accept|) or Cancel, with
+  // |prompt_text| for a prompt(). For "beforeunload", accept leaves the page.
+  AnswerTabDialog(int32 tab_id, bool accept, string prompt_text);
+  // A PNG of what |tab_id| shows, in physical pixels at its last size, even
+  // while no element shows it. Null if there is no such tab or the copy
+  // failed.
+  SnapshotTab(int32 tab_id) => (mojo_base.mojom.BigBuffer? png);
+  // Sends DevTools protocol command |method| (page domains only: Runtime,
+  // Input, Page, DOM, Accessibility, Emulation, Log, Network) with
+  // |params_json| (a JSON object, or empty) to |tab_id|, for automation.
+  // |result| is the command's result as JSON, or the error message.
+  SendTabDevToolsCommand(int32 tab_id, string method, string params_json)
+      => (bool ok, string result);
+
+  // EXO-KEYS: key combinations the shell handles itself. While an embedded
+  // window or a tab has keyboard focus, a key press matching one of these
+  // goes to the shell document (as an ordinary key event) instead of the
+  // app or page. Each is "[Ctrl+][Alt+][Shift+][Super+]<code>", <code> being
+  // a KeyboardEvent.code value ("KeyT", "Digit1", "Tab", "Space"); invalid
+  // entries are ignored. Replaces the previous list. Browser-wide keys
+  // (Super+F, which toggles fullscreen) come first.
+  SetShellShortcuts(array<string> shortcuts);
+
+  // EXO-TAGS: adds |add| to and takes |remove| out of an item's tags. The
+  // origin tag (the first) stays. Tags are printable ASCII without spaces,
+  // conventionally "<namespace>:<name>"; invalid ones are skipped. False if
+  // there is no such item.
+  UpdateWindowTags(int32 window_id, array<string> add, array<string> remove)
+      => (bool ok);
+  UpdateTabTags(int32 tab_id, array<string> add, array<string> remove)
+      => (bool ok);
+  // Names a window's origin tag when the browser couldn't read its client's
+  // environment (Ash in a container with its own user namespace), once:
+  // e.g. what the helper resolved from the client's pid. False if the
+  // browser knows the origin, or it has already been named.
+  SetWindowOriginTag(int32 window_id, string tag) => (bool ok);
+  // The session's helper (its origin, from the launcher's
+  // --plutonium-helper-url), or "" if the session didn't say.
+  GetHelperUrl() => (string url);
+  // Every shell's groups.
+  GetGroups() => (array<ItemGroup> groups);
+  // The groups now, then every later change through |observer| (ordered
+  // with the reply, as AddObserver()).
+  AddGroupObserver(pending_associated_remote<GroupObserver> observer)
+      => (array<ItemGroup> groups);
+  // Replaces this shell's groups. A tag another shell owns stays its.
+  SetGroups(array<ItemGroup> groups);
+
+  // EXO-SHELLS: this document's shell's id ("" outside shell mode).
+  GetShellId() => (string shell_id);
+  // The browser's shells (none outside shell mode).
+  GetShells() => (array<ShellEntry> shells);
+  // The shells now, then every later change through |observer| (ordered
+  // with the reply, as AddObserver()).
+  AddShellObserver(pending_associated_remote<ShellObserver> observer)
+      => (array<ShellEntry> shells);
+  // Makes this document's shell the visible one (e.g. to show something an
+  // agent asked for). Does nothing outside shell mode.
+  ShowShell();
+  // EXO-DISPLAYS: the displays, by index.
+  GetDisplays() => (array<NativeDisplayEntry> displays);
+  // Asks the visible shell on |display_id| to show window |window_id| (a
+  // "windowfocusrequest", which takes the window from where it is shown
+  // now) or tab |tab_id| ("tabfocusrequest"), and moves keyboard focus
+  // there. False if there is no such display or item, or that shell doesn't
+  // listen.
+  ShowWindowOnDisplay(int32 window_id, string display_id) => (bool ok);
+  ShowTabOnDisplay(int32 tab_id, string display_id) => (bool ok);
+  // Moves keyboard focus to |display_id|'s visible shell. False if there is
+  // no such display.
+  FocusDisplay(string display_id) => (bool ok);
+
+  // EXO-CHROME: context menus (ContextMenuRequest) for this document and,
+  // while it is the visible shell, for its tabs, through |observer|.
+  AddContextMenuObserver(
+      pending_associated_remote<ContextMenuObserver> observer);
+  // Closes menu |menu_id| (one this document took), running item |item_id|
+  // first unless it is 0.
+  CloseContextMenu(int32 menu_id, int32 item_id);
+
+  // EXO-TAB-FEATURES: requests about this document's tabs (the ones it
+  // shows, and, while it is the visible shell, the hidden ones), through
+  // |observer|. Replaces the previous one.
+  AddTabRequestObserver(pending_associated_remote<TabRequestObserver> observer);
+  // Answers request |id|, which this document took, with |answer_json| (its
+  // form depends on the kind). False if there is no such open request, or
+  // the kind doesn't take that answer.
+  AnswerTabRequest(int32 id, string answer_json) => (bool ok);
+  // EXO-FILES (docs/features/FILE_MANAGER.md): lets this document's renderer
+  // read |paths|, so File objects for them can be dragged or attached.
+  GrantFileAccess(array<string> paths);
+  // Starts a drag of the host files |paths| at the pointer, with no button
+  // held: the file rides on the pointer until a click or Enter drops it, or
+  // Escape cancels; hjkl and the arrows move the pointer. |image_png_base64|
+  // is the drag image, if any. |operation| is "copy", "move", "link" or
+  // "none", once it is over.
+  StartFileDrag(array<string> paths, string image_png_base64)
+      => (string operation);
+  // EXO-TAB-PERMISSIONS: the threads' permission decisions (TAB_FEATURES.md,
+  // "Grants and threads"): "list" {thread?, origin?}, "revoke" {thread,
+  // origin?, permission?} (a thread archived or deleted: {thread}).
+  // |result_json| is the result as JSON, or why it failed.
+  RunPermissionCommand(string command, string args_json)
+      => (bool ok, string result_json);
+
+  // EXO-TAB-FEATURES: the downloads now, then every later change through
+  // |observer| (ordered with the reply, as AddObserver()).
+  AddDownloadObserver(
+      pending_associated_remote<BrowserDownloadObserver> observer)
+      => (array<BrowserDownload> downloads);
+  // Runs |command| on download |download_id|: "pause", "resume", "cancel",
+  // "open", "show" (its folder), "keep" or "discard" (a dangerous file),
+  // "remove" (from the list). |error| says why it failed.
+  RunDownloadCommand(int32 download_id, string command)
+      => (bool ok, string error);
+  // Where this shell's thread |tag| downloads to, or with an empty |tag|
+  // every thread this shell owns that has no folder of its own: "downloads"
+  // (~/Downloads, the default), "thread" (~/Downloads/<thread label>/), an
+  // absolute path ("~/" for the home folder), or "" for the default.
+  SetDownloadFolder(string tag, string folder);
+
+  // EXO-CAPTURE: the captures now and the settings, then every later change
+  // and the capture requests for this page through |observer| (ordered with
+  // the reply, as AddObserver()). Replaces the previous one.
+  AddCaptureObserver(pending_associated_remote<CaptureObserver> observer)
+      => (array<string> captures_json, string settings_json);
+  // A PNG of |source_json| ({type, id, region?}; region {x, y, width,
+  // height} in the source's pixels), or null and why not (screenshots are
+  // switched off, there's no such source, or the copy failed).
+  Screenshot(string source_json)
+      => (mojo_base.mojom.BigBuffer? png, string error);
+  // Runs capture command |command| with |args_json| (a JSON object):
+  // "sources", "list", "settings", "setSettings", "stream" (a MediaStream's
+  // id for this page's getUserMedia()), "stop", "acknowledge", "setSize",
+  // "answer" (docs/features/CAPTURE.md). |result_json| is its result as
+  // JSON, or why it failed.
+  RunCaptureCommand(string command, string args_json)
+      => (bool ok, string result_json);
+};
