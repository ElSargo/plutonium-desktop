new file mode 100644
index 0000000000..2b9caa6d31
--- /dev/null
+++ b/third_party/blink/renderer/core/layout/layout_native_window.cc
@@ -0,0 +1,163 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/layout/layout_native_window.h"
+
+#include "cc/layers/surface_layer.h"
+#include "third_party/blink/renderer/core/frame/local_frame_view.h"
+#include "third_party/blink/renderer/core/paint/paint_info.h"
+#include "third_party/blink/renderer/platform/geometry/layout_unit.h"
+#include "third_party/blink/renderer/platform/graphics/paint/foreign_layer_display_item.h"
+#include "third_party/blink/renderer/platform/graphics/paint/paint_controller.h"
+#include "third_party/blink/renderer/platform/graphics/paint/property_tree_state.h"
+#include "ui/gfx/geometry/size_conversions.h"
+#include "ui/gfx/geometry/vector2d_conversions.h"
+
+namespace blink {
+
+namespace {
+
+// Where to put a surface layer so that the window geometry (|geometry_size|,
+// starting |geometry_offset| into a surface of |surface_size|) lands on
+// |target|, the surface stretched to fit.
+gfx::Rect StretchedSurfaceRect(const gfx::Rect& target,
+                               const gfx::Size& geometry_size,
+                               const gfx::Vector2d& geometry_offset,
+                               const gfx::Size& surface_size) {
+  const float sx = static_cast<float>(target.width()) / geometry_size.width();
+  const float sy =
+      static_cast<float>(target.height()) / geometry_size.height();
+  gfx::Size surface = surface_size;
+  if (surface.IsEmpty()) {
+    surface = geometry_size + gfx::Size(geometry_offset.x(), geometry_offset.y());
+  }
+  const gfx::Vector2d offset =
+      gfx::ToRoundedVector2d(gfx::ScaleVector2d(geometry_offset, sx, sy));
+  return gfx::Rect(target.origin() - offset,
+                   gfx::ToRoundedSize(gfx::ScaleSize(gfx::SizeF(surface), sx,
+                                                     sy)));
+}
+
+}  // namespace
+
+LayoutNativeWindow::LayoutNativeWindow(HTMLNativeWindowElement* element)
+    : LayoutReplaced(element) {}
+
+PhysicalNaturalSizingInfo LayoutNativeWindow::GetNaturalDimensions() const {
+  NOT_DESTROYED();
+  // One layout unit per window pixel, so the surface is shown 1:1 whatever
+  // the page zoom.
+  gfx::Size size = To<HTMLNativeWindowElement>(GetNode())->WindowSizeInPixels();
+  if (size.IsEmpty()) {
+    // LayoutReplaced's default, like <canvas> before it has content.
+    PhysicalSize default_size(gfx::Size(kDefaultWidth, kDefaultHeight));
+    default_size.Scale(Style().EffectiveZoom());
+    return PhysicalNaturalSizingInfo::MakeFixed(default_size);
+  }
+  return PhysicalNaturalSizingInfo::MakeFixed(PhysicalSize(size));
+}
+
+void LayoutNativeWindow::PaintReplaced(
+    const PaintInfo& paint_info,
+    const PhysicalOffset& paint_offset) const {
+  NOT_DESTROYED();
+  auto* element = To<HTMLNativeWindowElement>(GetNode());
+  // The window is resized to the element's content box. Until its frame is
+  // that size (or if it won't be), object-fit and object-position place the
+  // frame in the box.
+  PhysicalRect content_rect = PhysicalContentBoxRect();
+  const gfx::Size window_size = element->WindowSizeInPixels();
+  PhysicalRect window_rect = content_rect;
+  if (!window_size.IsEmpty()) {
+    window_rect = ComputeReplacedContentRect(
+        content_rect,
+        PhysicalNaturalSizingInfo::MakeFixed(PhysicalSize(window_size)));
+  }
+  content_rect.Move(paint_offset);
+  window_rect.Move(paint_offset);
+  const gfx::Rect snapped = ToPixelSnappedRect(content_rect);
+  element->ContentSizeChanged(snapped.size());
+  if (const LocalFrameView* frame_view = GetFrameView()) {
+    // Where the content box is on screen (in its widget), transforms and
+    // scrolling included, and how much the transforms scale it.
+    const PhysicalRect content_box = PhysicalContentBoxRect();
+    const PhysicalRect absolute = LocalToAbsoluteRect(content_box);
+    const float scale = content_box.Width() > 0
+                            ? absolute.Width().ToFloat() /
+                                  content_box.Width().ToFloat()
+                            : 1.f;
+    element->ContentRectChanged(
+        ToPixelSnappedRect(frame_view->ConvertToRootFrame(
+            frame_view->DocumentToFrame(absolute))),
+        scale);
+  }
+
+  cc::SurfaceLayer* layer = element->ContentsCcLayer();
+  if (!layer || paint_info.ShouldOmitCompositingInfo()) {
+    return;
+  }
+  // The surface includes client-side decorations (e.g. shadows) around the
+  // window geometry; they fall outside the content box, where the element's
+  // overflow clip hides them.
+  const gfx::Vector2d offset = element->GeometryOffsetInPixels();
+  // Until the app has drawn at the size asked for, the box is where the
+  // window is: its frame is stretched to it (no gap, nothing lagging behind
+  // the page). Then object-fit places what the app drew.
+  const gfx::Rect placed = element->AwaitingSize() && !snapped.IsEmpty()
+                               ? snapped
+                               : ToPixelSnappedRect(window_rect);
+  gfx::Rect layer_rect;
+  if (window_size.IsEmpty() || placed.size() == window_size) {
+    // 1:1. The layer reaches the content box's far edges, where viz shows
+    // what's behind the window if the frame is smaller.
+    const gfx::Point origin = placed.origin() - offset;
+    layer_rect = gfx::Rect(origin, gfx::Size(std::max(snapped.right() - origin.x(), 0),
+                                             std::max(snapped.bottom() - origin.y(), 0)));
+    layer->SetStretchContentToFillBounds(false);
+  } else {
+    layer_rect = StretchedSurfaceRect(placed, window_size, offset,
+                                      element->SurfaceSizeInPixels());
+    layer->SetStretchContentToFillBounds(true);
+  }
+  layer->SetBounds(layer_rect.size());
+  layer->SetIsDrawable(true);
+  layer->SetHitTestable(true);
+  RecordForeignLayer(paint_info.context, *this,
+                     DisplayItem::kForeignLayerPlugin, layer,
+                     layer_rect.origin());
+
+  // EXO-CROSSFADE: the frame from before a resize, stretched to the content
+  // box, over the window while it fades out.
+  const HTMLNativeWindowElement::FadeFrame* fade = element->GetFadeFrame();
+  if (!fade || fade->geometry_size.IsEmpty() || snapped.IsEmpty()) {
+    return;
+  }
+  const gfx::Rect fade_rect =
+      StretchedSurfaceRect(snapped, fade->geometry_size, fade->geometry_offset,
+                           fade->surface_size);
+  fade->layer->SetBounds(fade_rect.size());
+  fade->layer->SetIsDrawable(true);
+  PropertyTreeState properties =
+      paint_info.context.GetPaintController()
+          .CurrentPaintChunkProperties()
+          .Unalias();
+  properties.SetEffect(element->UpdateFadeEffect(properties));
+  RecordForeignLayer(paint_info.context, *this,
+                     DisplayItem::kForeignLayerCanvas, fade->layer,
+                     fade_rect.origin(), &properties);
+}
+
+void LayoutNativeWindow::StyleDidChange(StyleDifference diff,
+                                        const ComputedStyle* old_style,
+                                        const ComputedStyle& new_style,
+                                        const StyleChangeContext& context) {
+  NOT_DESTROYED();
+  LayoutReplaced::StyleDidChange(diff, old_style, new_style, context);
+  // EXO-CROSSFADE: hidden, it no longer shows the window.
+  if (new_style.Visibility() != EVisibility::kVisible) {
+    To<HTMLNativeWindowElement>(GetNode())->ForgetShownFrame();
+  }
+}
