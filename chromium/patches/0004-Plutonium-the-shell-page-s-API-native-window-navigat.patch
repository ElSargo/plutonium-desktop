+    bool tab,
+    int32_t id,
+    const Vector<String>& add,
+    const Vector<String>& remove) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLUndefined>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  auto done = BindOnce(
+      [](NativeWindowBroker* self, ScriptPromiseResolver<IDLUndefined>* resolver,
+         bool ok) {
+        self->pending_.erase(resolver);
+        if (!ok) {
+          resolver->RejectWithDOMException(DOMExceptionCode::kNotFoundError,
+                                           "No such item.");
+          return;
+        }
+        resolver->Resolve();
+      },
+      WrapPersistent(this), WrapPersistent(resolver));
+  if (tab) {
+    remote_->UpdateTabTags(id, add, remove, std::move(done));
+  } else {
+    remote_->UpdateWindowTags(id, add, remove, std::move(done));
+  }
+  return promise;
+}
