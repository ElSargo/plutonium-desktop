+  int capture_subscription_ = 0;
+  bool disconnected_ = false;
+  // Counts subscriptions, so a snapshot that arrives after its subscription
+  // ended (the page stopped and started listening again) is dropped.
+  int window_subscription_ = 0;
+  int tab_subscription_ = 0;
+  int download_subscription_ = 0;
+  // Calls in flight, rejected if the pipe closes.
+  HeapHashSet<Member<ScriptPromiseResolverBase>> pending_;
+};
+
+class CORE_EXPORT NavigatorNativeWindowBroker final
+    : public GarbageCollected<NavigatorNativeWindowBroker>,
+      public Supplement<Navigator> {
+ public:
+  static const char kSupplementName[];
+
+  static NativeWindowBroker* windowBroker(Navigator& navigator);
+
+  explicit NavigatorNativeWindowBroker(Navigator&);
+
+  void Trace(Visitor*) const override;
+
+ private:
+  Member<NativeWindowBroker> broker_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HTML_NATIVE_WINDOW_BROKER_H_
diff --git a/third_party/blink/renderer/core/html/native_window_broker.idl b/third_party/blink/renderer/core/html/native_window_broker.idl
new file mode 100644
index 0000000000..c9181b6b7b
--- /dev/null
+++ b/third_party/blink/renderer/core/html/native_window_broker.idl
@@ -0,0 +1,241 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// EXO-BROKER: the Plutonium shell's window broker API (navigator.windowBroker).
+// Exposed only to the shell document: the browser force-enables the
+// PlutoniumShell origin trial for shell navigations, and refuses to bind the
+// broker for any other document regardless.
+[
+    Exposed=Window,
+    RuntimeEnabled=PlutoniumShell,
+    SecureContext
+] interface NativeWindowBroker : EventTarget {
+    // The current native windows.
+    [CallWith=ScriptState] Promise<sequence<NativeWindowEntry>> getWindows();
+    // A grant for window |windowId|, for <native-window grant=…> elements in
+    // this document. Rejects (NotAllowedError) if there is no such window.
+    [CallWith=ScriptState] Promise<DOMString> requestGrant(long windowId);
+    // Revokes a grant this document holds; elements using it detach and fire
+    // "windowclose".
+    undefined revokeGrant(DOMString grant);
+    // Shows window |windowId| on the desktop and activates it, as soon as no
+    // element shows it any more.
+    undefined showOnDesktop(long windowId);
+    // Asks the app to close window |windowId|, as its close button would.
+    undefined close(long windowId);
+    // A PNG of what window |windowId| shows (its window geometry, in
+    // physical pixels), even while it is hidden. Rejects (NotFoundError) if
+    // there is no such window or the copy failed.
+    [CallWith=ScriptState] Promise<Blob> snapshot(long windowId);
+
+    // NativeWindowEvents. Adding the first listener for any of these
+    // subscribes; the current windows then arrive as "windowadded" events,
+    // followed by every later change, with no gap or overlap between the two.
+    attribute EventHandler onwindowadded;
+    attribute EventHandler onwindowchanged;
+    attribute EventHandler onwindowremoved;
+    // EXO-SHELLS: the browser's shells overlay asks this shell to show a
+    // window. Listening subscribes, as for "windowadded".
+    attribute EventHandler onwindowfocusrequest;
+    // A grant this document holds is no longer valid (event.grant,
+    // event.windowId): revokeGrant(), or the window closed (just before its
+    // "windowremoved"). Listening subscribes, as for "windowadded".
+    attribute EventHandler ongrantrevoked;
+    // Removing the last listener of these five unsubscribes; listening again
+    // subscribes again, and the current windows arrive again as
+    // "windowadded". The same holds for each of the other kinds of events
+    // below.
+
+    // EXO-TABS: browser tabs (see BrowserTabEntry).
+    //
+    // The current tabs.
+    [CallWith=ScriptState] Promise<sequence<BrowserTabEntry>> getTabs();
+    // Opens a tab at |url| (anything the omnibox would load, except
+    // javascript:), tagged |tag|. Rejects (SyntaxError) if |url| can't be
+    // loaded. With |incognito|, the tab gets throwaway storage of its own
+    // (shared only with the tabs its page opens), gone when they close.
+    [CallWith=ScriptState] Promise<BrowserTabEntry> createTab(
+        DOMString url, optional DOMString tag = "",
+        optional boolean incognito = false);
+    // Loads |url| in tab |tabId| as if typed in the omnibox. Rejects
+    // (NotFoundError) if there is no such tab or |url| can't be loaded.
+    [CallWith=ScriptState] Promise<undefined> navigateTab(long tabId,
+                                                         DOMString url);
+    // Runs |command| on tab |tabId|: "back", "forward", "reload", "stop",
+    // "close", or a tab feature's ("zoom-in", "find", ...;
+    // docs/features/TAB_FEATURES.md), with |argsJson| (a JSON object).
+    // Resolves with the result as JSON; rejects (OperationError) if there is
+    // no such tab or command, or it failed.
+    [CallWith=ScriptState] Promise<DOMString> tabCommand(
+        long tabId, DOMString command, optional DOMString argsJson = "");
+    // Answers tab |tabId|'s pending dialog: OK (|accept|) or Cancel, with
+    // |promptText| for a prompt().
+    undefined answerTabDialog(long tabId, boolean accept,
+                              optional DOMString promptText = "");
+    // A PNG of what tab |tabId| shows, even while no element shows it.
+    // Rejects (NotFoundError) if there is no such tab or the copy failed.
+    [CallWith=ScriptState] Promise<Blob> snapshotTab(long tabId);
+    // Sends DevTools protocol command |method| (page domains only) with
+    // |paramsJson| to tab |tabId|; resolves with the result as JSON. For
+    // automation (synthetic input, evaluating script, snapshots).
+    [CallWith=ScriptState] Promise<DOMString> sendTabDevToolsCommand(
+        long tabId, DOMString method, optional DOMString paramsJson = "");
+
+    // EXO-KEYS: key combinations this document handles itself, such as
+    // "Ctrl+KeyT", "Alt+Digit1" or "Ctrl+Shift+Tab" (modifiers Ctrl, Alt,
+    // Shift and Super, then a KeyboardEvent.code). While an embedded window
+    // or a tab has keyboard focus, pressing one sends the key event to this
+    // document instead. Replaces the previous list.
+    undefined setShellShortcuts(sequence<DOMString> shortcuts);
+
+    // EXO-TAGS: adds |add| to and takes |remove| out of an item's tags (the
+    // origin tag, the first, stays). Tags are printable ASCII without
+    // spaces, conventionally "<namespace>:<name>". Rejects (NotFoundError)
+    // if there is no such item.
+    [CallWith=ScriptState] Promise<undefined> updateWindowTags(
+        long windowId, sequence<DOMString> add,
+        optional sequence<DOMString> remove = []);
+    [CallWith=ScriptState] Promise<undefined> updateTabTags(
+        long tabId, sequence<DOMString> add,
+        optional sequence<DOMString> remove = []);
+    // Names window |windowId|'s origin tag when the browser couldn't read its
+    // app's environment, once. Resolves to false if it knows the origin or
+    // the origin was already named.
+    [CallWith=ScriptState] Promise<boolean> setWindowOriginTag(
+        long windowId, DOMString tag);
+    // The session's helper (its origin, e.g. "http://127.0.0.1:3780"), as
+    // the launcher told the browser; "" if it didn't.
+    [CallWith=ScriptState] Promise<DOMString> getHelperUrl();
+    // Every shell's groups (tag, label, owning shell).
+    [CallWith=ScriptState] Promise<sequence<ItemGroup>> getGroups();
+    // Replaces this shell's groups. A tag another shell owns stays its.
+    undefined setGroups(sequence<ItemGroup> groups);
+    // Fired after any shell's groups change (and once on subscribing, which
+    // adding the first listener does); read them with getGroups().
+    attribute EventHandler ongroupschanged;
+
+    // EXO-SHELLS: this document's shell's id ("" outside shell mode).
+    [CallWith=ScriptState] Promise<DOMString> getShellId();
+    // Makes this document's shell the visible one.
+    undefined showShell();
+    // The browser's shells (none outside shell mode).
+    [CallWith=ScriptState] Promise<sequence<ShellEntry>> getShells();
+    // Fired after any change to the shells (and once on subscribing, which
+    // adding the first listener does); read them with getShells().
+    attribute EventHandler onshellschanged;
+
+    // EXO-DISPLAYS: the displays, by index ("current" is this document's).
+    [CallWith=ScriptState] Promise<sequence<NativeDisplayEntry>> getDisplays();
+    // Fired after a display is added, removed or changed, or keyboard focus
+    // moves to another display (and once on subscribing, as
+    // "shellschanged"); read them with getDisplays().
+    attribute EventHandler ondisplayschanged;
+    // PLUTONIUM: a touchpad swipe with three fingers or more (a
+    // ShellCaptureEvent: its |detail| is {phase: "begin" | "update" | "end",
+    // fingers, dx, dy, x, y}), to the visible shell on the focused display.
+    // Nothing else gets these swipes.
+    attribute EventHandler ontouchpadswipe;
+    // Asks the visible shell on display |displayId| to show window
+    // |windowId| or tab |tabId| (a "windowfocusrequest" or
+    // "tabfocusrequest" there; showing it takes it from where it is shown
+    // now), and moves keyboard focus to that display. Resolves to false if
+    // there is no such display or item, or that shell doesn't listen.
+    [CallWith=ScriptState] Promise<boolean> showWindowOnDisplay(
+        long windowId, DOMString displayId);
+    [CallWith=ScriptState] Promise<boolean> showTabOnDisplay(
+        long tabId, DOMString displayId);
+    // Moves keyboard focus to display |displayId| (its visible shell).
+    [CallWith=ScriptState] Promise<boolean> focusDisplay(DOMString displayId);
+
+    // EXO-CHROME: Chrome's context menu for this document, or (while this
+    // is the visible shell) for one of its tabs: a cancelable
+    // ContextMenuRequestEvent. preventDefault() takes it; then show the
+    // items and answer with closeContextMenu(). Listening subscribes.
+    attribute EventHandler oncontextmenurequest;
+    // Closes menu |menuId|, running item |itemId| first unless it is 0.
+    undefined closeContextMenu(long menuId, optional long itemId = 0);
+
+    // EXO-TAB-FEATURES: what this document's tabs (the ones it shows, and,
+    // while it is the visible shell, the hidden ones) need the user for: a
+    // cancelable TabRequestEvent. preventDefault() takes it; then answer with
+    // answerTabRequest(). "tabrequestend": one it took is over. Listening to
+    // either subscribes.
+    attribute EventHandler ontabrequest;
+    attribute EventHandler ontabrequestend;
+    // Answers request |requestId|, which this document took, with
+    // |answerJson| (its form depends on the kind). Resolves to false if
+    // there is no such open request, or the kind refuses the answer.
+    [CallWith=ScriptState] Promise<boolean> answerTabRequest(
+        long requestId, optional DOMString answerJson = "");
+    // EXO-FILES: takes the keyboard from a tab or window this page embeds, for
+    // this page. element.focus() alone doesn't: the page's frame was focused
+    // all along, so the browser hears nothing and keys still go to the tab.
+    [CallWith=ExecutionContext] undefined focusPage();
+    // EXO-FILES (docs/features/FILE_MANAGER.md): a File for the host file
+    // |path| (this document may read it, drag it, or attach it to an input),
+    // and the path of a File that has one (a drop's, say), else "".
+    [CallWith=ExecutionContext] File fileForPath(DOMString path);
+    DOMString pathForFile(File file);
+    // Starts a drag of the host files |paths| with no button held: it rides
+    // on the pointer until a click or Enter drops it, or Escape cancels; hjkl
+    // and the arrows move the pointer. |imagePngBase64| is its drag image.
+    // Resolves with "copy", "move", "link" or "none" once it is over.
+    [CallWith=ScriptState] Promise<DOMString> startFileDrag(
+        sequence<DOMString> paths, optional DOMString imagePngBase64 = "");
+    // EXO-TAB-PERMISSIONS: the threads' permission decisions: "list"
+    // {thread?, origin?}, "revoke" {thread, origin?, permission?}. Resolves
+    // with the result as JSON; rejects (OperationError) if it failed.
+    [CallWith=ScriptState] Promise<DOMString> permissionCommand(
+        DOMString command, optional DOMString argsJson = "");
+
+    // EXO-TAB-FEATURES: downloads (BrowserDownloadEvent), from tabs and this
+    // page, with the thread each came from. Adding the first listener for
+    // any of these subscribes; the current downloads then arrive as
+    // "downloadadded" events.
+    attribute EventHandler ondownloadadded;
+    attribute EventHandler ondownloadchanged;
+    attribute EventHandler ondownloadremoved;
+    // Runs |command| on download |downloadId|: "pause", "resume", "cancel",
+    // "open", "show" (its folder), "keep" or "discard" (a dangerous file),
+    // "remove" (from the list). Rejects (OperationError) if it can't.
+    [CallWith=ScriptState] Promise<undefined> downloadCommand(
+        long downloadId, DOMString command);
+    // Where this shell's thread |tag| downloads to, or with tag "" every
+    // thread this shell owns that has no folder of its own: "downloads"
+    // (~/Downloads, the default), "thread" (~/Downloads/<thread label>/), an
+    // absolute path ("~/" for the home folder), or "" for the default.
+    undefined setDownloadFolder(DOMString tag, DOMString folder);
+
+    // EXO-CAPTURE (docs/features/CAPTURE.md): screenshots and captures.
+    //
+    // A PNG of |sourceJson| ({type: "output" | "window" | "tab", id,
+    // region?}; region {x, y, width, height} in the source's pixels). Rejects
+    // (NotAllowedError) while screenshots are switched off, else
+    // (NotFoundError) if there's no such source or the copy failed.
+    [CallWith=ScriptState] Promise<Blob> screenshot(DOMString sourceJson);
+    // Runs capture command |command| ("sources", "list", "settings",
+    // "setSettings", "stream", "stop", "acknowledge", "setSize", "answer")
+    // with |argsJson| (a JSON object). Resolves with the result as JSON;
+    // rejects (OperationError) with why it failed.
+    [CallWith=ScriptState] Promise<DOMString> captureCommand(
+        DOMString command, optional DOMString argsJson = "");
+    // ShellCaptureEvents. Adding the first listener for any of these
+    // subscribes; the running captures then arrive as "capturestart"
+    // events, and the settings as "capturesettingschange". While this is
+    // the focused shell, capture requests arrive as "capturerequest".
+    attribute EventHandler oncapturerequest;
+    attribute EventHandler oncapturerequestend;
+    attribute EventHandler oncapturestart;
+    attribute EventHandler oncapturechange;
+    attribute EventHandler oncapturestop;
+    attribute EventHandler oncapturesettingschange;
+
+    // BrowserTabEvents. Adding the first listener for any of these
+    // subscribes; the current tabs then arrive as "tabadded" events.
+    attribute EventHandler ontabadded;
+    attribute EventHandler ontabchanged;
+    attribute EventHandler ontabremoved;
+    // EXO-SHELLS: as onwindowfocusrequest, for a tab.
+    attribute EventHandler ontabfocusrequest;
+};
diff --git a/third_party/blink/renderer/core/html/native_window_entry.idl b/third_party/blink/renderer/core/html/native_window_entry.idl
new file mode 100644
index 0000000000..51c9bc0f8a
--- /dev/null
+++ b/third_party/blink/renderer/core/html/native_window_entry.idl
@@ -0,0 +1,35 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// EXO-BROKER: a native window as NativeWindowBroker lists it.
+dictionary NativeWindowEntry {
+    // The broker's window id (not a capability).
+    required long id;
+    required DOMString appId;
+    required DOMString title;
+    // Window size in CSS pixels at zoom 1 (DIPs).
+    required unsigned long width;
+    required unsigned long height;
+    // PLUTONIUM: the app's size limits in CSS pixels at zoom 1 (DIPs); 0 on
+    // an axis means no limit. Minimum equal to maximum: it can't be resized.
+    required unsigned long minWidth;
+    required unsigned long minHeight;
+    required unsigned long maxWidth;
+    required unsigned long maxHeight;
+    required double deviceScaleFactor;
+    // An element shows it / it has embedded keyboard focus.
+    required boolean embedded;
+    required boolean focused;
+    // Pid of the Wayland client (0 if unknown).
+    required long pid;
+    // EXO-TAGS: the thread that started the client, or "". Never changes.
+    required DOMString tag;
+    // |tag| (if any) first, then the tags shells added. Items with the same
+    // tag go together.
+    required sequence<DOMString> tags;
+    // PLUTONIUM: the app's icon (xdg_toplevel_icon_v1): an icon theme name,
+    // and a PNG data URL of its pixels; each "" if it set none.
+    required DOMString iconName;
+    required DOMString icon;
+};
