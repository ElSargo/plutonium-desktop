+// found in the LICENSE file.
+
+// EXO-EMBED: a native (Wayland) window shown as an element.
+// Events (not bubbling): "windowchange" (title, app id, size or focus
+// changed), "windowfocus", "windowblur", "windowclose" (window closed or
+// grant revoked), "windowerror" (attaching was refused), "windowtaken"
+// (EXO-DISPLAYS: another page shows the window now; a "windowchange" with
+// windowState "attached" says it is back).
+//
+// EXO-BROKER: the element attaches only with a grant (an opaque token the
+// browser's window broker issued to this document for one window). The shell
+// gets grants from navigator.windowBroker.requestGrant().
+[
+    Exposed=Window,
+    HTMLConstructor
+] interface HTMLNativeWindowElement : HTMLElement {
+    // Grant for the window to show. Without one nothing is attached.
+    [CEReactions, Reflect] attribute DOMString grant;
+    // Optional: the window id the grant must be for.
+    [CEReactions, Reflect] attribute DOMString window;
+    // EXO-CROSSFADE: milliseconds over which a resize the page makes
+    // animates (the window's frame from before it stretching and fading into
+    // the app's new one, as in niri); 0 (default) for none.
+    [CEReactions, Reflect] attribute unsigned long crossfade;
+    // The animation's CSS easing function; by default close to niri's.
+    [CEReactions, Reflect=crossfade_easing] attribute DOMString crossfadeEasing;
+    // The page shows the window floating rather than tiled: the app keeps its
+    // client-side shadow, and presses just outside the element's content box
+    // (where nothing of the page's covers them) reach its resize edges there.
+    [CEReactions, Reflect] attribute boolean floating;
+    // The attached window's id, or 0.
+    readonly attribute long windowId;
+    // "none", "attaching", "attached", "taken" (another page shows it),
+    // "failed" or "closed".
+    readonly attribute DOMString windowState;
+    readonly attribute DOMString windowTitle;
+    readonly attribute DOMString appId;
+    // The window's current size in CSS pixels at zoom 1 (DIPs).
+    readonly attribute unsigned long windowWidth;
+    readonly attribute unsigned long windowHeight;
+    // PLUTONIUM: the size limits the app set for itself, in CSS pixels at
+    // zoom 1 (DIPs); 0 on an axis means no limit. A page sizing the element
+    // keeps it within them, or the app draws at another size than the box
+    // (placed by object-fit). Minimum equal to maximum: it can't be resized.
+    // They change with a "windowchange" event.
+    readonly attribute unsigned long windowMinWidth;
+    readonly attribute unsigned long windowMinHeight;
+    readonly attribute unsigned long windowMaxWidth;
+    readonly attribute unsigned long windowMaxHeight;
+    readonly attribute boolean windowFocused;
+    // Gives the window keyboard focus, or takes it back.
+    undefined focusWindow();
+    undefined blurWindow();
+
+};
