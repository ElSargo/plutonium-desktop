+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// EXO-CHROME: navigator.windowBroker's "contextmenurequest": Chrome would
+// show its context menu for this document or one of its tabs. Calling
+// preventDefault() takes it: the shell shows the items and answers with
+// closeContextMenu(menuId, itemId). Otherwise Chrome shows its own menu.
+[
+    Exposed=Window,
+    RuntimeEnabled=PlutoniumShell,
+    SecureContext
+] interface ContextMenuRequestEvent : Event {
+    readonly attribute long menuId;
+    // The tab whose page asked, or 0 for this document.
+    readonly attribute long tabId;
+    // Where, in this document's CSS pixels (as clientX and clientY).
+    readonly attribute double x;
+    readonly attribute double y;
+    // The items as ContextMenuItem dictionaries (a fresh array on every
+    // read), each submenu's after it.
+    [CallWith=ScriptState] readonly attribute any items;
+    // What was under the pointer.
+    readonly attribute DOMString linkUrl;
+    readonly attribute DOMString selectionText;
+    readonly attribute boolean editable;
+    // "image", "video", "audio", "canvas", "file", "plugin" or "".
+    readonly attribute DOMString mediaType;
+};
