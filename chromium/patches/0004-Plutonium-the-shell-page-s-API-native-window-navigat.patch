+ScriptPromise<IDLString> NativeWindowBroker::requestGrant(
+    ScriptState* script_state,
+    int32_t window_id) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLString>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->RequestGrant(
+      window_id,
+      BindOnce(
+          [](NativeWindowBroker* self,
+             ScriptPromiseResolver<IDLString>* resolver,
+             const std::optional<base::UnguessableToken>& grant) {
+            self->pending_.erase(resolver);
+            if (!grant) {
+              resolver->RejectWithDOMException(
+                  DOMExceptionCode::kNotAllowedError, "No such window.");
+              return;
+            }
+            resolver->Resolve(String(grant->ToString()));
+          },
+          WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+void NativeWindowBroker::revokeGrant(const String& grant) {
+  std::optional<base::UnguessableToken> token =
+      base::UnguessableToken::DeserializeFromString(grant.Utf8());
+  if (!token || disconnected_ || !GetExecutionContext()) {
+    return;
+  }
+  if (!remote_.is_bound()) {
+    // Nothing to revoke: this document never got a grant from us.
+    return;
+  }
+  remote_->RevokeGrant(*token);
+}
