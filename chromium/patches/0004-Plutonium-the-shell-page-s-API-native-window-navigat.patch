+// The element embeds the window's surface range [current, current + this],
+// so viz keeps drawing the window's latest surface as it resizes without the
+// page having to follow every new surface id. The range's end is a bound that
+// is never drawn, so it mustn't be an activation dependency of the page's
+// frames: whenever another layer (a tab whose surface changed) asked for a
+// deadline, viz would hold each frame for the whole deadline, waiting for it.
+constexpr uint32_t kSurfaceRangeSpan = 1u << 30;
+
+// How long the app's frame is stretched to the content box, waiting for it to
+// draw at the size asked for (the app may not take that size), and how long
+// EXO-CROSSFADE's old frame waits for it before fading anyway. niri's
+// transactions wait as long.
+constexpr base::TimeDelta kMaxFadeHold = base::Milliseconds(300);
+// Resizes closer together than this are continuous (a drag): the app keeps
+// up live, and a stretched old frame over it would only smear.
+constexpr base::TimeDelta kContinuousResize = base::Milliseconds(100);
+// Resizes this small (pixels, either way) don't fade, as niri doesn't
+// animate them.
+constexpr int kResizeAnimationThreshold = 10;
+
+// Changed property nodes, not only new paint: the compositor's layers and
+// property trees need updating (its fast path is for paint alone).
+void PropertyChanged(Document& document, PaintPropertyChangeType change) {
+  if (change == PaintPropertyChangeType::kUnchanged) {
+    return;
+  }
+  if (auto* view = document.View()) {
+    view->SetPaintArtifactCompositorNeedsUpdate();
+  }
+}
+
+gfx::Size ToPixels(const gfx::Size& size, float scale) {
+  return gfx::ToRoundedSize(gfx::ScaleSize(gfx::SizeF(size), scale));
+}
