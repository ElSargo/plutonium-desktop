+TEST_F(PlutoniumAttachTest, NotTheShellEvenWithItsOwnGrant) {
+  // Grants only come from the shell API, but the broker would issue one to
+  // any live frame: attaching still refuses a document that isn't the shell.
+  std::unique_ptr<content::WebContents> other = CreateTestWebContents();
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      other.get(), GURL(kOtherSiteUrl));
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(other->GetPrimaryMainFrame(), kWindow);
+  ASSERT_TRUE(grant);
+  EXPECT_FALSE(Attach(other->GetPrimaryMainFrame(), *grant, kWindow));
