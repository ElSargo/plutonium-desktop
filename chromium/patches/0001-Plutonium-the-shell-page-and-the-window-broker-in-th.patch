+// The shell document's window broker API. One per binding; lives as long as
+// the document (or until the pipe closes).
+class WindowBrokerImpl
+    : public content::DocumentService<blink::mojom::WindowBroker>,
+      public ExoWindowBroker::Observer,
+      public PlutoniumTabs::Observer,
+      public PlutoniumGroups::Observer,
+      public PlutoniumShells::Observer,
+      public PlutoniumDownloads::Observer,
+      public PlutoniumCapture::Observer {
+ public:
+  WindowBrokerImpl(content::RenderFrameHost& render_frame_host,
+                   mojo::PendingReceiver<blink::mojom::WindowBroker> receiver)
+      : DocumentService(render_frame_host, std::move(receiver)) {
+    static int32_t next_id = 1;
+    id_ = next_id++;
+    Instances().insert(this);
+    // Outlives this: BindWindowBroker() needs the broker, and documents go
+    // away before ExoParts does.
+    ExoWindowBroker::Get()->AddObserver(this);
+  }
+
+  ~WindowBrokerImpl() override {
+    Instances().erase(this);
+    // EXO-TAB-FEATURES: the requests this document was asked fall back
+    // (dropping the observer answers the open questions "not taken").
+    tab_request_observer_.reset();
+    if (asked_) {
+      PlutoniumTabRequests::Get()->OnShellGone(id_);
+    }
+    // EXO-CAPTURE: so do the capture requests it took.
+    capture_observer_.reset();
+    if (capture_asked_) {
+      PlutoniumCapture::Get()->OnShellGone(id_);
+    }
+    if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+      broker->RemoveObserver(this);
+    }
+  }
+
+  static std::set<WindowBrokerImpl*>& Instances() {
+    static base::NoDestructor<std::set<WindowBrokerImpl*>> instances;
+    return *instances;
+  }
+
+  content::WebContents* contents() {
+    return content::WebContents::FromRenderFrameHost(&render_frame_host());
+  }
+
+  // EXO-TAB-FEATURES: this connection, as a request's taker.
+  int32_t id() const { return id_; }
+
+  // EXO-SHELLS: the overlay asks this document to show an item.
+  bool RequestShowWindow(const ExoWindowBroker::WindowInfo& window) {
+    if (observers_.empty() || !StillShell()) {
+      return false;
+    }
+    for (auto& observer : observers_) {
+      observer->OnWindowFocusRequested(ToMojo(window));
+    }
+    return true;
+  }
+  // EXO-CHROME: false if this document doesn't listen for context menus.
+  bool RequestContextMenu(
+      blink::mojom::ContextMenuRequestPtr& request,
+      base::OnceCallback<void(bool handled)>& callback) {
+    if (!context_menu_observer_.is_bound() || !StillShell()) {
+      return false;
+    }
+    context_menu_observer_->OnContextMenuRequested(
+        std::move(request), mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                                std::move(callback), false));
+    return true;
+  }
+
+  // EXO-TAB-FEATURES: false if this document doesn't listen for tab
+  // requests.
+  bool SendTabRequest(blink::mojom::TabRequestPtr& request,
+                      base::OnceCallback<void(int32_t taker)>& callback) {
+    if (!tab_request_observer_.is_bound() || !StillShell()) {
+      return false;
+    }
+    asked_ = true;
+    tab_request_observer_->OnTabRequest(
+        std::move(request),
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(
+                [](base::OnceCallback<void(int32_t)> callback, int32_t taker,
+                   bool taken) { std::move(callback).Run(taken ? taker : 0); },
+                std::move(callback), id_),
+            false));
+    return true;
+  }
+
+  void EndTabRequest(int32_t request_id) {
+    if (tab_request_observer_.is_bound()) {
+      tab_request_observer_->OnTabRequestEnded(request_id);
+    }
+  }
+
+  // EXO-CAPTURE: false if this document doesn't listen for capture
+  // requests.
+  bool SendCaptureRequest(int32_t request_id,
+                          const std::string& detail_json,
+                          base::OnceCallback<void(int32_t taker)>& callback) {
+    if (!capture_observer_.is_bound() || !StillShell()) {
+      return false;
+    }
+    capture_asked_ = true;
+    capture_observer_->OnCaptureRequest(
+        request_id, detail_json,
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(
+                [](base::OnceCallback<void(int32_t)> callback, int32_t taker,
+                   bool taken) { std::move(callback).Run(taken ? taker : 0); },
+                std::move(callback), id_),
+            false));
+    return true;
+  }
+
+  void EndCaptureRequest(int32_t request_id) {
+    if (capture_observer_.is_bound()) {
+      capture_observer_->OnCaptureRequestEnded(request_id);
+    }
+  }
+
+  bool RequestShowTab(const PlutoniumTabs::TabInfo& tab) {
+    if (tab_observers_.empty() || !StillShell()) {
+      return false;
+    }
+    for (auto& observer : tab_observers_) {
+      observer->OnTabFocusRequested(ToMojo(tab));
+    }
+    return true;
+  }
+
+  // blink::mojom::WindowBroker:
+  void GetWindows(GetWindowsCallback callback) override {
+    std::move(callback).Run(StillShell() ? CurrentWindows()
+                                         : CurrentWindowsNone());
+  }
+
+  void AddObserver(
+      mojo::PendingAssociatedRemote<blink::mojom::WindowBrokerObserver>
+          observer,
+      AddObserverCallback callback) override {
+    if (!StillShell()) {
+      std::move(callback).Run(CurrentWindowsNone());
+      return;
+    }
+    observers_.Add(std::move(observer));
+    VLOG(1) << "EXO-BROKER shell observer added (" << observers_.size()
+            << " on this document)";
+    // Sent before any later event on the (associated) observer.
+    std::move(callback).Run(CurrentWindows());
+  }
+
+  void RequestGrant(int32_t window_id,
+                    RequestGrantCallback callback) override {
+    ExoWindowBroker* broker = ExoWindowBroker::Get();
+    if (!StillShell() || !broker) {
+      std::move(callback).Run(std::nullopt);
+      return;
+    }
+    std::optional<base::UnguessableToken> grant =
+        broker->IssueGrant(&render_frame_host(), window_id);
+    if (!grant) {
+      VLOG(1) << "EXO-BROKER shell grant refused: no window #" << window_id;
+    }
+    std::move(callback).Run(grant);
+  }
+
+  void RevokeGrant(const base::UnguessableToken& grant) override {
+    ExoWindowBroker* broker = ExoWindowBroker::Get();
+    // Only grants this document holds.
+    if (broker && broker->ResolveGrant(grant, &render_frame_host())) {
+      broker->RevokeGrant(grant);
+    }
+  }
+
+  void ShowOnDesktop(int32_t window_id) override {
+    if (StillShell() && ExoWindowBroker::Get()) {
+      exo::EmbeddedWindows::Get()->ShowOnDesktop(window_id);
+    }
+  }
+
+  void Close(int32_t window_id) override {
+    if (StillShell() && ExoWindowBroker::Get()) {
+      exo::EmbeddedWindows::Get()->Close(window_id);
+    }
+  }
+
+  void Snapshot(int32_t window_id, SnapshotCallback callback) override {
+    ExoWindowBroker* broker = ExoWindowBroker::Get();
+    if (!StillShell() || !broker || !broker->GetWindow(window_id)) {
+      std::move(callback).Run(std::nullopt);
+      return;
+    }
+    exo::EmbeddedWindows::Get()->Snapshot(
+        window_id, base::BindOnce(&EncodePng, std::move(callback)));
+  }
+
+  // EXO-TABS:
+  void GetTabs(GetTabsCallback callback) override {
+    std::move(callback).Run(
+        StillShell() ? CurrentTabs()
+                     : std::vector<blink::mojom::BrowserTabEntryPtr>());
+  }
+
+  void AddTabObserver(
+      mojo::PendingAssociatedRemote<blink::mojom::BrowserTabObserver> observer,
+      AddTabObserverCallback callback) override {
+    if (!StillShell()) {
+      std::move(callback).Run({});
+      return;
+    }
+    if (!tabs_observation_.IsObserving()) {
+      tabs_observation_.Observe(PlutoniumTabs::Get());
+    }
+    tab_observers_.Add(std::move(observer));
+    std::move(callback).Run(CurrentTabs());
+  }
+
+  void CreateTab(const std::string& url,
+                 const std::string& tag,
+                 bool incognito,
+                 CreateTabCallback callback) override {
+    if (!StillShell()) {
+      std::move(callback).Run(nullptr);
+      return;
+    }
+    std::optional<PlutoniumTabs::TabInfo> tab = PlutoniumTabs::Get()->CreateTab(
+        content::WebContents::FromRenderFrameHost(&render_frame_host()), url,
+        tag, "shell", incognito);
+    std::move(callback).Run(tab ? ToMojo(*tab) : nullptr);
+  }
+
+  void NavigateTab(int32_t tab_id,
+                   const std::string& url,
+                   NavigateTabCallback callback) override {
+    std::move(callback).Run(StillShell() &&
+                            PlutoniumTabs::Get()->Navigate(tab_id, url));
+  }
+
+  void RunTabCommand(int32_t tab_id,
+                     const std::string& command,
+                     const std::string& args_json,
+                     RunTabCommandCallback callback) override {
+    if (!StillShell()) {
+      std::move(callback).Run(false, "Not the shell");
+      return;
+    }
+    PlutoniumTabs::Get()->RunNamedCommand(tab_id, command, args_json,
+                                          std::move(callback));
+  }
+
+  void AnswerTabDialog(int32_t tab_id,
+                       bool accept,
+                       const std::string& prompt_text) override {
+    if (StillShell()) {
+      PlutoniumTabs::Get()->AnswerDialog(tab_id, accept,
+                                         base::UTF8ToUTF16(prompt_text));
+    }
+  }
+
