+  void GrantFileAccess(const std::vector<std::string>& paths) override {
+    if (!StillShell()) {
+      return;
+    }
+    auto* policy = content::ChildProcessSecurityPolicy::GetInstance();
+    const auto process = render_frame_host().GetProcess()->GetID();
+    for (const std::string& value : paths) {
+      base::FilePath path(value);
+      if (path.IsAbsolute() && !path.ReferencesParent()) {
+        policy->GrantReadFile(process, path);
+      }
+    }
+  }
+
+  void StartFileDrag(const std::vector<std::string>& paths,
+                     const std::string& image_png_base64,
+                     StartFileDragCallback callback) override {
+    std::vector<ui::FileInfo> files;
+    for (const std::string& value : paths) {
+      base::FilePath path(value);
+      if (!path.IsAbsolute() || path.ReferencesParent()) {
+        std::move(callback).Run("none");
+        return;
+      }
+      files.emplace_back(path, path.BaseName());
+    }
+    aura::Window* source = contents()->GetNativeView();
+    aura::Window* root = source ? source->GetRootWindow() : nullptr;
+    aura::client::DragDropClient* client =
+        root ? aura::client::GetDragDropClient(root) : nullptr;
+    if (!StillShell() || files.empty() || !client) {
+      std::move(callback).Run("none");
+      return;
+    }
+    auto data = std::make_unique<ui::OSExchangeData>();
+    data->SetFilenames(files);
+    std::string png;
+    if (base::Base64Decode(image_png_base64, &png)) {
+      SkBitmap bitmap = gfx::PNGCodec::Decode(base::as_byte_span(png));
+      if (!bitmap.isNull()) {
+        data->provider().SetDragImage(
+            gfx::ImageSkia::CreateFrom1xBitmap(bitmap),
+            gfx::Vector2d(bitmap.width() / 2, bitmap.height() / 2));
+      }
+    }
+    // Starting runs a nested loop until the drop, so it can't run from this
+    // message.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<content::WebContents> contents,
+               std::unique_ptr<ui::OSExchangeData> data,
+               StartFileDragCallback callback) {
+              aura::Window* source =
+                  contents ? contents->GetNativeView() : nullptr;
+              aura::Window* root = source ? source->GetRootWindow() : nullptr;
+              auto* client =
+                  root ? aura::client::GetDragDropClient(root) : nullptr;
+              if (!client) {
+                std::move(callback).Run("none");
+                return;
+              }
+              ash::DragDropController::SetNextDragSticky();
+              const ui::mojom::DragOperation operation =
+                  client->StartDragAndDrop(
+                      std::move(data), root, source,
+                      display::Screen::Get()->GetCursorScreenPoint(),
+                      ui::DragDropTypes::DRAG_COPY |
+                          ui::DragDropTypes::DRAG_MOVE |
+                          ui::DragDropTypes::DRAG_LINK,
+                      ui::mojom::DragEventSource::kMouse);
+              const char* name = "none";
+              if (operation == ui::mojom::DragOperation::kCopy) {
+                name = "copy";
+              } else if (operation == ui::mojom::DragOperation::kMove) {
+                name = "move";
+              } else if (operation == ui::mojom::DragOperation::kLink) {
+                name = "link";
+              }
+              std::move(callback).Run(name);
+            },
+            contents()->GetWeakPtr(), std::move(data),
+            mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(callback),
+                                                        "none")));
+  }
