+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/plutonium_agent.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/ptr_util.h"
+#include "skia/ext/image_operations.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/gfx/geometry/size_conversions.h"
+
+namespace plutonium_agent {
+
+// static
+std::unique_ptr<WindowScreencast> WindowScreencast::Start(
+    int32_t window_id,
+    const gfx::Size& max_size,
+    FrameCallback on_frame) {
+  exo::EmbeddedWindows* windows = exo::EmbeddedWindows::Get();
+  if (!windows->GetInfo(window_id)) {
+    return nullptr;
+  }
+  auto screencast = base::WrapUnique(
+      new WindowScreencast(window_id, max_size, std::move(on_frame)));
+  screencast->windows_observation_.Observe(windows);
+  // What it shows now, before it draws anything new.
+  screencast->Capture();
+  return screencast;
+}
+
+WindowScreencast::WindowScreencast(int32_t window_id,
+                                   const gfx::Size& max_size,
+                                   FrameCallback on_frame)
+    : window_id_(window_id),
+      max_size_(max_size),
+      on_frame_(std::move(on_frame)) {}
+
+WindowScreencast::~WindowScreencast() = default;
+
+void WindowScreencast::OnEmbeddedWindowCommitted(int32_t window_id) {
+  if (window_id == window_id_) {
+    Capture();
+  }
+}
+
+void WindowScreencast::Capture() {
+  dirty_ = true;
+  if (copying_ || timer_.IsRunning()) {
+    return;
+  }
+  const base::TimeDelta wait =
+      last_copy_ + base::Seconds(1) / kMaxRate - base::TimeTicks::Now();
+  if (wait.is_positive()) {
+    timer_.Start(FROM_HERE, wait,
+                 base::BindOnce(&WindowScreencast::Capture,
+                                base::Unretained(this)));
+    return;
+  }
+  dirty_ = false;
+  copying_ = true;
+  last_copy_ = base::TimeTicks::Now();
+  exo::EmbeddedWindows::Get()->Snapshot(
+      window_id_, base::BindOnce(&WindowScreencast::OnCopied,
+                                 weak_factory_.GetWeakPtr()));
+}
+
+void WindowScreencast::OnCopied(const SkBitmap& bitmap) {
+  copying_ = false;
+  if (!bitmap.drawsNothing()) {
+    gfx::Size size(bitmap.width(), bitmap.height());
+    if (!max_size_.IsEmpty() && (size.width() > max_size_.width() ||
+                                 size.height() > max_size_.height())) {
+      const float scale = std::min(
+          static_cast<float>(max_size_.width()) / size.width(),
+          static_cast<float>(max_size_.height()) / size.height());
+      size = gfx::ToFlooredSize(gfx::ScaleSize(gfx::SizeF(size), scale));
+      size.SetToMax(gfx::Size(1, 1));
+      on_frame_.Run(skia::ImageOperations::Resize(
+          bitmap, skia::ImageOperations::RESIZE_GOOD, size.width(),
+          size.height()));
+    } else {
+      on_frame_.Run(bitmap);
+    }
+  }
+  // It drew again while this copy was on its way.
+  if (dirty_) {
+    Capture();
+  }
+}
+
+}  // namespace plutonium_agent
diff --git a/chrome/browser/plutonium_agent.h b/chrome/browser/plutonium_agent.h
new file mode 100644
index 0000000000..b01ec65bff
--- /dev/null
+++ b/chrome/browser/plutonium_agent.h
@@ -0,0 +1,72 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PLUTONIUM_AGENT_H_
+#define CHROME_BROWSER_PLUTONIUM_AGENT_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/exo/embedded_windows.h"
+#include "ui/gfx/geometry/size.h"
+
+class SkBitmap;
+
+namespace plutonium_agent {
+
+// PLUTONIUM (EXO-AGENT): a native window's frames as it draws, also while
+// no page shows it. A parked window isn't part of any frame the display
+// draws, so a video capturer on it sees no damage: instead each frame the app
+// commits is copied (as EmbeddedWindows::Snapshot does), one copy at a time
+// and at most kMaxRate a second, the last frame of a burst always included.
+class WindowScreencast : public exo::EmbeddedWindows::Observer {
+ public:
+  using FrameCallback = base::RepeatingCallback<void(const SkBitmap&)>;
+
+  // Null if there is no such window. Frames are at most |max_size| physical
+  // pixels (keeping the aspect ratio), or the window's size if empty.
+  static std::unique_ptr<WindowScreencast> Start(int32_t window_id,
+                                                 const gfx::Size& max_size,
+                                                 FrameCallback on_frame);
+
+  WindowScreencast(const WindowScreencast&) = delete;
+  WindowScreencast& operator=(const WindowScreencast&) = delete;
+  ~WindowScreencast() override;
+
+  // exo::EmbeddedWindows::Observer:
+  void OnEmbeddedWindowCommitted(int32_t window_id) override;
+
+ private:
+  static constexpr int kMaxRate = 30;
+
+  WindowScreencast(int32_t window_id,
+                   const gfx::Size& max_size,
+                   FrameCallback on_frame);
+
+  // Copies the window now, or once the copy in flight is done, or once
+  // kMaxRate allows.
+  void Capture();
+  void OnCopied(const SkBitmap& bitmap);
+
+  const int32_t window_id_;
+  const gfx::Size max_size_;
+  FrameCallback on_frame_;
+  // A copy is in flight.
+  bool copying_ = false;
+  // The window committed since the last copy started.
+  bool dirty_ = false;
+  base::TimeTicks last_copy_;
+  base::OneShotTimer timer_;
+  base::ScopedObservation<exo::EmbeddedWindows, exo::EmbeddedWindows::Observer>
+      windows_observation_{this};
+  base::WeakPtrFactory<WindowScreencast> weak_factory_{this};
+};
+
+}  // namespace plutonium_agent
+
+#endif  // CHROME_BROWSER_PLUTONIUM_AGENT_H_
