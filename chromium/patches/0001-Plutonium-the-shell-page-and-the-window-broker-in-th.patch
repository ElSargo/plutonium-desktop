+TEST_F(PlutoniumShellTest, ForwardsTheDocumentsRevokedGrants) {
+  mojo::Remote<blink::mojom::WindowBroker> shell = BindBroker(main_rfh());
+  FakeObserver observer;
+  base::test::TestFuture<std::vector<blink::mojom::NativeWindowEntryPtr>>
+      snapshot;
+  shell->AddObserver(observer.receiver.BindNewEndpointAndPassRemote(),
+                     snapshot.GetCallback());
+  ASSERT_TRUE(snapshot.Wait());
+
+  base::test::TestFuture<const std::optional<base::UnguessableToken>&> grant;
+  shell->RequestGrant(kWindow, grant.GetCallback());
+  ASSERT_TRUE(grant.Get());
+  base::UnguessableToken token = *grant.Get();
+
+  // The shell revokes it.
+  shell->RevokeGrant(token);
+  shell.FlushForTesting();
+  ASSERT_EQ(1u, observer.revoked.size());
+  EXPECT_EQ(token, observer.revoked[0]);
+  EXPECT_EQ((std::vector<std::string>{"revoked 7"}), observer.events);
+
+  // The window closes: its grant goes first, then the window.
+  base::test::TestFuture<const std::optional<base::UnguessableToken>&> second;
+  shell->RequestGrant(kOtherWindow, second.GetCallback());
+  ASSERT_TRUE(second.Get());
+  observer.events.clear();
+  broker()->OnEmbeddedWindowDestroyed(kOtherWindow);
+  shell.FlushForTesting();
+  EXPECT_EQ((std::vector<std::string>{"revoked 8", "removed 8"}),
+            observer.events);
+  EXPECT_EQ(*second.Get(), observer.revoked.back());
+}
