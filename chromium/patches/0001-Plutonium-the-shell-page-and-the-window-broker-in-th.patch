+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PLUTONIUM_SHELL_H_
+#define CHROME_BROWSER_PLUTONIUM_SHELL_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/functional/callback_forward.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/struct_ptr.h"
+#include "third_party/blink/public/mojom/native_window/window_broker.mojom-forward.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+class BrowserWindowInterface;
+
+namespace blink::mojom {
+class ContextMenuRequest;
+class WindowBroker;
+}  // namespace blink::mojom
+
+namespace content {
+class NavigationThrottleRegistry;
+class RenderFrameHost;
+class WebContents;
+}  // namespace content
+
+// EXO-BROKER: the privileged shell.
+//
+// The shell is the one web page allowed to use the window broker (list
+// windows, get grants to embed them). It is identified by origin, given on
+// the command line:
+//
+//   --plutonium-shell-origin=http://localhost:8765
+//
+// The origin must be http(s) and potentially trustworthy (https, localhost or
+// a loopback address). A document is the shell document only if all of these
+// hold, checked in the browser:
+//   * it is the primary main frame of its page (not an iframe, fenced frame,
+//     prerendered or back/forward-cached page),
+//   * its WebContents is top-level (not a guest or other inner contents) and
+//     not one of the shell's browser tabs (plutonium_tabs.h),
+//   * its committed origin is the shell origin, and so is the origin of its
+//     committed URL (so about:blank, srcdoc, data: or sandboxed documents
+//     that inherit or mask the origin don't count).
+namespace plutonium_shell {
+
+inline constexpr char kShellOriginSwitch[] = "plutonium-shell-origin";
+
+// EXO-BOOT: shell mode. Boot straight into the shell:
+//
+//   --plutonium-shell-url=http://127.0.0.1:8770/
+//
+// opens that URL as the only window, an app window (no tab strip or
+// omnibox) in plain fullscreen: no immersive top-edge reveal, no exit
+// bubble, and it can't leave fullscreen. Ash runs as in kiosk ("app mode"):
+// the shelf and status area stay hidden, notifications are blocked, and
+// window-management accelerators (overview, launcher, Alt+Tab, desks, lock)
+// are off. Unlike Chrome's own --kiosk, DevTools and context menus stay.
+// The URL's origin is the shell origin unless --plutonium-shell-origin says
+// otherwise.
+inline constexpr char kShellUrlSwitch[] = "plutonium-shell-url";
+
+// Whether |url| can be a shell's: http(s), and https, localhost or
+// loopback.
+bool IsAcceptableShellUrl(const GURL& url);
+
+// Whether the browser runs in shell mode (see kShellUrlSwitch).
+inline bool IsShellMode() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(kShellUrlSwitch);
+}
+
+// EXO-CHROME: Chrome's own UI in shell mode. A shell is the desktop, not a
+// browser window: Chrome shouldn't show through it.
+//
+// Whether |browser| is a shell's window (in shell mode, every app window).
+bool IsShellBrowser(BrowserWindowInterface* browser);
+// Whether a shell's window runs browser command |command_id| (IDC_*, from a
+// key or a menu). Only DevTools and the clipboard: F1 (help), Ctrl+N (a new
+// window), Ctrl+W (close the shell), Ctrl+P, Ctrl+S, F5 and the like do
+// nothing, and the key is the page's alone.
+bool IsCommandAllowedInShell(int command_id);
+// Whether |contents| is a shell's page in its own window (in shell mode;
+// before the shells are set up, any page in shell mode). Kiosk-style
+// fullscreen, always on and without exit instructions, is the shell
+// window's only: other browser windows leave fullscreen as usual.
+bool IsShellWindowContents(content::WebContents* contents);
+
+// In shell mode, opens the shell URL at startup (as --app=<url> with
+// --start-fullscreen). Call before the startup browser is created.
+void SetUpShellMode();
+
+// The origin-trial name that exposes navigator.windowBroker to script. The
+// browser force-enables it only for shell navigations (see
+// MaybeAddNavigationThrottle()); no token can enable it.
+inline constexpr char kShellOriginTrial[] = "PlutoniumShell";
+
+// The shell origin from the command line, or nullopt if there is none or it
+// isn't acceptable. In shell mode, the startup shell's (see GetShellOrigins).
+const std::optional<url::Origin>& GetShellOrigin();
+
+// EXO-SHELLS: every shell's origin. In shell mode there can be several
+// shells (plutonium_shells.h); a shell document must be in its own shell's
+// window and on that shell's origin. Otherwise there's GetShellOrigin()
+// only, in any top-level page.
+std::vector<url::Origin> GetShellOrigins();
+bool IsShellOrigin(const url::Origin& origin);
+
+// Whether |render_frame_host|'s current document is a shell document.
+bool IsShellDocument(content::RenderFrameHost* render_frame_host);
+
+// EXO-SHELLS: whether |contents| is (in) the visible shell's page. Only
+// it drives windows and tabs: sizes, focus, fullscreen. Always true outside
+// shell mode.
+bool IsVisibleShell(content::WebContents* contents);
+bool IsVisibleShellDocument(content::RenderFrameHost* render_frame_host);
+
+// Called by PlutoniumShells when another shell becomes visible.
+void OnVisibleShellChanged(content::WebContents* previous,
+                           content::WebContents* visible);
+
+// EXO-SHELLS: asks |shell|'s page to show window |window_id| or tab
+// |tab_id| ("windowfocusrequest" / "tabfocusrequest"). False if the page
+// doesn't listen (or there's no such item).
+bool RequestShowWindow(content::WebContents* shell, int32_t window_id);
+bool RequestShowTab(content::WebContents* shell, int32_t tab_id);
+
+// EXO-ACTIVATION: an app asked for window |window_id| to be shown
+// (xdg_activation_v1): asks the shell that owns its group, else the visible
+// shell, as RequestShowWindow() does. The shell isn't switched to. False if
+// no shell takes it.
+bool RequestActivateWindow(int32_t window_id);
+
+// EXO-DISPLAYS: asks the visible shell on display |display_id| to show window
+// |window_id| or tab |tab_id| (as above: it takes the item from where it is
+// shown now), and moves keyboard focus to that display. False if there's no
+// such display or item, or that shell doesn't listen.
+bool ShowWindowOnDisplay(int32_t window_id, int64_t display_id);
+bool ShowTabOnDisplay(int32_t tab_id, int64_t display_id);
+
+// EXO-CHROME: asks |shell|'s page to show a context menu
+// (plutonium_context_menu.h). False if it doesn't listen; otherwise
+// |callback| gets whether it took the menu (false if it went away).
+bool RequestContextMenu(content::WebContents* shell,
+                        mojo::StructPtr<blink::mojom::ContextMenuRequest> request,
+                        base::OnceCallback<void(bool handled)> callback);
+
+// EXO-TAB-FEATURES: asks |shell|'s page about a tab request
+// (plutonium_tab_requests.h). False if it doesn't listen; otherwise
+// |callback| gets the broker connection that took it ("taker", for
+// EndTabRequest()), or 0 if it didn't take it (or went away first).
+bool SendTabRequest(content::WebContents* shell,
+                    blink::mojom::TabRequestPtr request,
+                    base::OnceCallback<void(int32_t taker)> callback);
+// Tells broker connection |taker| that request |request_id| is over
+// ("tabrequestend").
+void EndTabRequest(int32_t taker, int32_t request_id);
+
+// EXO-CAPTURE: asks |shell|'s page about capture request |request_id|
+// (plutonium_capture.h), |detail_json| being the "capturerequest" event's
+// detail. False if it doesn't listen; otherwise |callback| gets the broker
+// connection that took it, or 0 if it didn't (or went away first).
+bool SendCaptureRequest(content::WebContents* shell,
+                        int32_t request_id,
+                        const std::string& detail_json,
+                        base::OnceCallback<void(int32_t taker)> callback);
+// Tells broker connection |taker| that capture request |request_id| is over
+// ("capturerequestend").
+void EndCaptureRequest(int32_t taker, int32_t request_id);
+
+// Adds a throttle that exposes the shell API to navigations that will commit
+// the shell (the renderer side only; IsShellDocument() is what's enforced).
+void MaybeAddNavigationThrottle(content::NavigationThrottleRegistry& registry);
+
+// Binder for blink.mojom.WindowBroker. Drops the receiver unless the frame
+// is the shell document and the window broker exists.
+void BindWindowBroker(content::RenderFrameHost* render_frame_host,
+                      mojo::PendingReceiver<blink::mojom::WindowBroker>
+                          receiver);
+
+}  // namespace plutonium_shell
+
+#endif  // CHROME_BROWSER_PLUTONIUM_SHELL_H_
