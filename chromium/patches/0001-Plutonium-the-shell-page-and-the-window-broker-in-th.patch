+++ b/chrome/browser/plutonium_groups.cc
@@ -0,0 +1,237 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/plutonium_groups.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/containers/flat_set.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+
+namespace plutonium_tags {
+
+namespace {
+
+// Enough to get from a GUI app through shells and wrappers to the agent
+// (as the helper's threadForPid()).
+constexpr int kMaxParentDepth = 16;
+
+std::optional<std::string> ReadOwnThreadTag(int pid) {
+  std::string environ;
+  if (!base::ReadFileToString(
+          base::FilePath("/proc/" + base::NumberToString(pid) + "/environ"),
+          &environ)) {
+    return std::nullopt;
+  }
+  const std::string prefix = std::string(kThreadVariable) + "=";
+  for (std::string_view entry : base::SplitStringPiece(
+           environ, std::string_view("\0", 1), base::KEEP_WHITESPACE,
+           base::SPLIT_WANT_NONEMPTY)) {
+    if (base::StartsWith(entry, prefix)) {
+      return std::string(entry.substr(prefix.size()));
+    }
+  }
+  return std::string();
+}
+
+int ReadParentPid(int pid) {
+  std::string stat;
+  if (!base::ReadFileToString(
+          base::FilePath("/proc/" + base::NumberToString(pid) + "/stat"),
+          &stat)) {
+    return 0;
+  }
+  // The command name is in parentheses and may contain anything.
+  size_t close = stat.rfind(')');
+  if (close == std::string::npos) {
+    return 0;
+  }
+  std::vector<std::string_view> fields = base::SplitStringPiece(
+      std::string_view(stat).substr(close + 1), " ", base::TRIM_WHITESPACE,
+      base::SPLIT_WANT_NONEMPTY);
+  int parent = 0;
+  // State, then the parent pid.
+  if (fields.size() < 2 || !base::StringToInt(fields[1], &parent)) {
+    return 0;
+  }
+  return parent > 1 ? parent : 0;
+}
+
+}  // namespace
+
+bool IsValidTag(std::string_view tag) {
+  return !tag.empty() && tag.size() <= kMaxTagLength &&
+         std::ranges::all_of(tag, [](char c) { return c > ' ' && c < 0x7f; });
+}
+
+std::vector<std::string> Update(const std::vector<std::string>& tags,
+                                bool has_origin,
+                                const std::vector<std::string>& add,
+                                const std::vector<std::string>& remove) {
+  base::flat_set<std::string> removed(remove.begin(), remove.end());
+  std::vector<std::string> result;
+  auto append = [&](const std::string& tag, bool origin) {
+    if (result.size() >= kMaxTags || !IsValidTag(tag) ||
+        (!origin && removed.contains(tag)) ||
+        std::ranges::find(result, tag) != result.end()) {
+      return;
+    }
+    result.push_back(tag);
+  };
+  for (size_t i = 0; i < tags.size(); ++i) {
+    append(tags[i], has_origin && i == 0);
+  }
+  for (const std::string& tag : add) {
+    append(tag, false);
+  }
+  return result;
+}
+
+std::optional<std::string> ReadThreadTag(int pid) {
+  for (int depth = 0; pid > 1 && depth < kMaxParentDepth; ++depth) {
+    std::optional<std::string> tag = ReadOwnThreadTag(pid);
+    if (!tag) {
+      // The client itself is unreadable: nothing is known. An ancestor
+      // that is (init, another user's) just ends the search.
+      if (depth == 0) {
+        return std::nullopt;
+      }
+      break;
+    }
+    if (!tag->empty()) {
+      return IsValidTag(*tag) ? *tag : std::string();
+    }
+    pid = ReadParentPid(pid);
+  }
+  return std::string();
+}
+
+}  // namespace plutonium_tags
+
+namespace {
+
+constexpr char kTagKey[] = "tag";
+constexpr char kLabelKey[] = "label";
+constexpr char kShellKey[] = "shell";
+constexpr size_t kMaxLabelLength = 200;
+constexpr size_t kMaxGroupsPerShell = 1000;
+
+}  // namespace
+
+// static
+void PlutoniumGroups::RegisterLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterListPref(kGroupsPref);
+}
+
+// static
+PlutoniumGroups* PlutoniumGroups::Get() {
+  static base::NoDestructor<PlutoniumGroups> instance;
+  return instance.get();
+}
+
+PlutoniumGroups::PlutoniumGroups() {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state) {
+    return;
+  }
+  for (const base::Value& value : local_state->GetList(kGroupsPref)) {
+    const base::DictValue* dict = value.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const std::string* tag = dict->FindString(kTagKey);
+    const std::string* label = dict->FindString(kLabelKey);
+    const std::string* shell = dict->FindString(kShellKey);
+    if (!tag || !plutonium_tags::IsValidTag(*tag) || Find(*tag)) {
+      continue;
+    }
+    groups_.push_back({*tag, label ? *label : std::string(),
+                       shell ? *shell : std::string()});
+  }
+}
+
+PlutoniumGroups::~PlutoniumGroups() = default;
+
+void PlutoniumGroups::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void PlutoniumGroups::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+std::optional<PlutoniumGroups::Group> PlutoniumGroups::Find(
+    std::string_view tag) const {
+  auto it = std::ranges::find(groups_, tag, &Group::tag);
+  if (it == groups_.end()) {
+    return std::nullopt;
+  }
+  return *it;
+}
+
+void PlutoniumGroups::SetGroups(const std::string& shell_id,
+                                std::vector<Group> groups) {
+  std::vector<Group> result;
+  for (const Group& group : groups_) {
+    if (group.shell_id != shell_id) {
+      result.push_back(group);
+    }
+  }
+  size_t added = 0;
+  for (Group& group : groups) {
+    if (added >= kMaxGroupsPerShell) {
+      break;
+    }
+    if (!plutonium_tags::IsValidTag(group.tag) ||
+        std::ranges::find(result, group.tag, &Group::tag) != result.end()) {
+      continue;
+    }
+    if (group.label.size() > kMaxLabelLength) {
+      group.label.resize(kMaxLabelLength);
+    }
+    group.shell_id = shell_id;
+    result.push_back(std::move(group));
+    ++added;
+  }
+  if (result == groups_) {
+    return;
+  }
+  groups_ = std::move(result);
+  Changed();
+}
+
+void PlutoniumGroups::RemoveShell(const std::string& shell_id) {
+  size_t erased = std::erase_if(
+      groups_, [&](const Group& group) { return group.shell_id == shell_id; });
+  if (erased) {
+    Changed();
+  }
+}
+
+void PlutoniumGroups::Changed() {
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    base::ListValue list;
+    for (const Group& group : groups_) {
+      list.Append(base::DictValue()
+                      .Set(kTagKey, group.tag)
+                      .Set(kLabelKey, group.label)
+                      .Set(kShellKey, group.shell_id));
+    }
+    local_state->SetList(kGroupsPref, std::move(list));
+  }
+  VLOG(1) << "EXO-TAGS " << groups_.size() << " groups";
+  for (Observer& observer : observers_) {
+    observer.OnGroupsChanged();
+  }
+}
