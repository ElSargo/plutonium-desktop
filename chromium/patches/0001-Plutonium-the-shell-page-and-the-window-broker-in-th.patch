+bool IsAcceptableShellUrl(const GURL& url) {
+  url::Origin origin = url::Origin::Create(url);
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() && !origin.opaque() &&
+         network::IsOriginPotentiallyTrustworthy(origin);
+}
+
+namespace {
+
+std::optional<url::Origin> ParseShellOrigin() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  // The shell URL's origin, unless the origin is given on its own.
+  const char* switch_name = command_line->HasSwitch(kShellOriginSwitch)
+                                ? kShellOriginSwitch
+                                : kShellUrlSwitch;
+  if (!command_line->HasSwitch(switch_name)) {
+    return std::nullopt;
+  }
+  GURL url(command_line->GetSwitchValueASCII(switch_name));
+  if (!IsAcceptableShellUrl(url)) {
+    LOG(ERROR) << "EXO-BROKER: ignoring --" << switch_name << "="
+               << url.possibly_invalid_spec()
+               << " (needs an http(s) origin that is https, localhost or "
+                  "loopback)";
+    return std::nullopt;
+  }
+  url::Origin origin = url::Origin::Create(url);
+  LOG(WARNING) << "EXO-BROKER: shell origin is " << origin;
+  return origin;
+}
+
+// The origin |contents|'s shell documents must have: its shell's, in shell
+// mode (EXO-SHELLS), else the one shell origin.
+std::optional<url::Origin> ShellOriginFor(
+    const content::WebContents* contents) {
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    std::optional<PlutoniumShells::Shell> shell =
+        shells->GetShellFor(contents);
+    if (!shell) {
+      return std::nullopt;
+    }
+    return shell->origin;
+  }
+  return GetShellOrigin();
+}
+
+// Whether |url| (a document or navigation URL in |contents|) is on the
+// shell origin.
+bool IsShellUrl(const content::WebContents* contents, const GURL& url) {
+  std::optional<url::Origin> shell = ShellOriginFor(contents);
+  return shell && url.SchemeIsHTTPOrHTTPS() &&
+         url::Origin::Create(url) == *shell;
+}
