+TEST_F(PlutoniumAttachTest, NoGrantOrForgedGrant) {
+  // (An empty token can't be sent: Mojo refuses to serialize one.)
+  EXPECT_FALSE(Attach(main_rfh(), base::UnguessableToken::Create(), kWindow));
+  EXPECT_TRUE(WasLogged("attach refused: no valid grant"));
+  Logged().clear();
+  EXPECT_FALSE(Attach(main_rfh(), base::UnguessableToken::Create(), 0));
+  EXPECT_TRUE(WasLogged("attach refused: no valid grant"));
+}
