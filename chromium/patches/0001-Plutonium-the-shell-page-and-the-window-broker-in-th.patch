index 0000000000..e3b889bb84
--- /dev/null
+++ b/chrome/browser/exo_window_broker_unittest.cc
@@ -0,0 +1,328 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/exo_window_broker.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/test/scoped_feature_list.h"
+#include "base/unguessable_token.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/content_features.h"
+#include "content/public/test/navigation_simulator.h"
+#include "content/public/test/test_renderer_host.h"
+#include "content/public/test/web_contents_tester.h"
+#include "content/test/render_document_feature.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+// EXO-BROKER: the registry's grants, and when they stop working.
+namespace {
+
+constexpr int32_t kWindow = 7;
+constexpr int32_t kOtherWindow = 8;
+
+ExoWindowBroker::WindowInfo MakeWindow(int32_t id) {
+  ExoWindowBroker::WindowInfo window;
+  window.id = id;
+  window.app_id = "org.example.app";
+  window.title = u"App";
+  window.size = gfx::Size(400, 300);
+  return window;
+}
+
+// Records what the broker reports, in order.
+class Recorder : public ExoWindowBroker::Observer {
+ public:
+  struct Revoked {
+    base::UnguessableToken grant;
+    int32_t window_id;
+    content::GlobalRenderFrameHostId frame;
+  };
+
+  void OnWindowAdded(const ExoWindowBroker::WindowInfo& window) override {
+    events.push_back("added " + base::NumberToString(window.id));
+  }
+  void OnWindowRemoved(int32_t window_id) override {
+    events.push_back("removed " + base::NumberToString(window_id));
+  }
+  void OnGrantRevoked(const base::UnguessableToken& grant,
+                      int32_t window_id,
+                      content::GlobalRenderFrameHostId frame) override {
+    events.push_back("revoked " + base::NumberToString(window_id));
+    revoked.push_back({grant, window_id, frame});
+  }
+
+  std::vector<std::string> events;
+  std::vector<Revoked> revoked;
+};
+
+class ExoWindowBrokerTest : public content::RenderViewHostTestHarness {
+ public:
+  void SetUp() override {
+    content::RenderViewHostTestHarness::SetUp();
+    broker_ = std::make_unique<ExoWindowBroker>();
+    broker_->AddObserver(&recorder_);
+    broker_->AddWindowForTesting(MakeWindow(kWindow));
+    broker_->AddWindowForTesting(MakeWindow(kOtherWindow));
+    NavigateAndCommit(GURL("http://localhost:8765/shell.html"));
+  }
+
+  void TearDown() override {
+    broker_->RemoveObserver(&recorder_);
+    DeleteContents();
+    broker_.reset();
+    content::RenderViewHostTestHarness::TearDown();
+  }
+
+ protected:
+  ExoWindowBroker* broker() { return broker_.get(); }
+
+  std::unique_ptr<ExoWindowBroker> broker_;
+  Recorder recorder_;
+};
+
+TEST_F(ExoWindowBrokerTest, GetReturnsTheBroker) {
+  EXPECT_EQ(broker(), ExoWindowBroker::Get());
+  EXPECT_TRUE(broker()->GetWindow(kWindow));
+  EXPECT_FALSE(broker()->GetWindow(99));
+}
+
+TEST_F(ExoWindowBrokerTest, GrantNeedsAKnownWindowAndALiveFrame) {
+  EXPECT_FALSE(broker()->IssueGrant(main_rfh(), 99));
+  EXPECT_FALSE(broker()->IssueGrant(nullptr, kWindow));
+  EXPECT_TRUE(broker()->IssueGrant(main_rfh(), kWindow));
+  EXPECT_EQ(1u, broker()->grant_count());
+}
+
+TEST_F(ExoWindowBrokerTest, EveryGrantIsNew) {
+  std::optional<base::UnguessableToken> a =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  std::optional<base::UnguessableToken> b =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(a && b);
+  EXPECT_NE(*a, *b);
+  EXPECT_EQ(2u, broker()->grant_count());
+}
+
+TEST_F(ExoWindowBrokerTest, GrantResolvesToItsWindowOnly) {
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(grant);
+  EXPECT_EQ(kWindow, broker()->ResolveGrant(*grant, main_rfh()));
+  EXPECT_TRUE(broker()->ValidateGrant(*grant, main_rfh(), kWindow));
+  // Never another window's, even with a matching document.
+  EXPECT_FALSE(broker()->ValidateGrant(*grant, main_rfh(), kOtherWindow));
+}
+
+TEST_F(ExoWindowBrokerTest, ForgedAndEmptyTokensResolveToNothing) {
+  ASSERT_TRUE(broker()->IssueGrant(main_rfh(), kWindow));
+  EXPECT_FALSE(
+      broker()->ResolveGrant(base::UnguessableToken::Create(), main_rfh()));
+  EXPECT_FALSE(broker()->ResolveGrant(base::UnguessableToken(), main_rfh()));
+  EXPECT_FALSE(broker()->ResolveGrant(base::UnguessableToken::Create(),
+                                      nullptr));
+}
+
+TEST_F(ExoWindowBrokerTest, GrantDoesNothingInAnIframe) {
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(grant);
+  content::RenderFrameHost* child =
+      content::RenderFrameHostTester::For(main_rfh())->AppendChild("child");
+  child = content::NavigationSimulator::NavigateAndCommitFromDocument(
+      GURL("http://localhost:8765/frame.html"), child);
+  EXPECT_FALSE(broker()->ResolveGrant(*grant, child));
+  // And a grant issued to the iframe does nothing in its parent.
+  std::optional<base::UnguessableToken> child_grant =
+      broker()->IssueGrant(child, kWindow);
+  ASSERT_TRUE(child_grant);
+  EXPECT_FALSE(broker()->ResolveGrant(*child_grant, main_rfh()));
+  EXPECT_EQ(kWindow, broker()->ResolveGrant(*child_grant, child));
+}
+
+TEST_F(ExoWindowBrokerTest, GrantDoesNothingInAnotherPage) {
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(grant);
+  // The same URL, in another tab.
+  std::unique_ptr<content::WebContents> other = CreateTestWebContents();
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      other.get(), GURL("http://localhost:8765/shell.html"));
+  EXPECT_FALSE(broker()->ResolveGrant(*grant, other->GetPrimaryMainFrame()));
+}
+
+// A document that leaves for the back/forward cache isn't gone: it keeps its
+// grants (they work again if it comes back), but they resolve nowhere else.
+TEST_F(ExoWindowBrokerTest, NavigatingAwayLeavesTheGrantBehind) {
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(grant);
+  NavigateAndCommit(GURL("http://127.0.0.1:8766/elsewhere.html"));
+  EXPECT_FALSE(broker()->ResolveGrant(*grant, main_rfh()));
+}
+
+TEST_F(ExoWindowBrokerTest, ClosingTheWindowRevokesItsGrantsFirst) {
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  std::optional<base::UnguessableToken> other =
+      broker()->IssueGrant(main_rfh(), kOtherWindow);
+  ASSERT_TRUE(grant && other);
+  recorder_.events.clear();
+  broker()->OnEmbeddedWindowDestroyed(kWindow);
+  EXPECT_EQ((std::vector<std::string>{"revoked 7", "removed 7"}),
+            recorder_.events);
+  EXPECT_FALSE(broker()->ResolveGrant(*grant, main_rfh()));
+  EXPECT_EQ(kOtherWindow, broker()->ResolveGrant(*other, main_rfh()));
+  // The window is gone: no new grants for it.
+  EXPECT_FALSE(broker()->IssueGrant(main_rfh(), kWindow));
+}
+
+TEST_F(ExoWindowBrokerTest, RevokeGrantRevokesThatGrantOnly) {
+  std::optional<base::UnguessableToken> a =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  std::optional<base::UnguessableToken> b =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(a && b);
+  broker()->RevokeGrant(*a);
+  EXPECT_FALSE(broker()->ResolveGrant(*a, main_rfh()));
+  EXPECT_EQ(kWindow, broker()->ResolveGrant(*b, main_rfh()));
+  ASSERT_EQ(1u, recorder_.revoked.size());
+  EXPECT_EQ(*a, recorder_.revoked[0].grant);
+  // Revoking again, or a token that was never issued, reports nothing.
+  broker()->RevokeGrant(*a);
+  broker()->RevokeGrant(base::UnguessableToken::Create());
+  EXPECT_EQ(1u, recorder_.revoked.size());
+}
+
+// An observer that changes the registry while being told something (an
+// element detaching from a revoked grant changes its window): every observer
+// hears of the revocation first, then of the change.
+TEST_F(ExoWindowBrokerTest, EventsCausedByAnObserverWaitTheirTurn) {
+  class Reacting : public ExoWindowBroker::Observer {
+   public:
+    explicit Reacting(ExoWindowBroker* broker) : broker_(broker) {}
+    void OnGrantRevoked(const base::UnguessableToken&,
+                        int32_t,
+                        content::GlobalRenderFrameHostId) override {
+      broker_->AddWindowForTesting(MakeWindow(9));
+    }
+
+   private:
+    raw_ptr<ExoWindowBroker> broker_;
+  };
+  // Told before |recorder_| would be, were it not already registered: so
+  // register a second recorder after it.
+  Reacting reacting(broker());
+  Recorder later;
+  broker()->AddObserver(&reacting);
+  broker()->AddObserver(&later);
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(grant);
+  recorder_.events.clear();
+  broker()->RevokeGrant(*grant);
+  EXPECT_EQ((std::vector<std::string>{"revoked 7", "added 9"}),
+            recorder_.events);
+  EXPECT_EQ((std::vector<std::string>{"revoked 7", "added 9"}), later.events);
+  broker()->RemoveObserver(&later);
+  broker()->RemoveObserver(&reacting);
+}
+
+TEST_F(ExoWindowBrokerTest, RevokeGrantsForWindow) {
+  std::optional<base::UnguessableToken> a =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  std::optional<base::UnguessableToken> b =
+      broker()->IssueGrant(main_rfh(), kOtherWindow);
+  ASSERT_TRUE(a && b);
+  broker()->RevokeGrantsForWindow(kWindow);
+  EXPECT_FALSE(broker()->ResolveGrant(*a, main_rfh()));
+  EXPECT_TRUE(broker()->ResolveGrant(*b, main_rfh()));
+  // The window itself stays.
+  EXPECT_TRUE(broker()->GetWindow(kWindow));
+}
+
+// Without the back/forward cache, a document that navigates away is gone.
+class ExoWindowBrokerNoCacheTest : public ExoWindowBrokerTest {
+ public:
+  ExoWindowBrokerNoCacheTest() {
+    back_forward_cache_.InitAndDisableFeature(features::kBackForwardCache);
+  }
+
+ private:
+  base::test::ScopedFeatureList back_forward_cache_;
+};
+
+TEST_F(ExoWindowBrokerNoCacheTest, NavigatingRevokesTheDocumentsGrants) {
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(grant);
+  content::GlobalRenderFrameHostId frame = main_rfh()->GetGlobalId();
+  NavigateAndCommit(GURL("http://127.0.0.1:8766/elsewhere.html"));
+  EXPECT_EQ(0u, broker()->grant_count());
+  ASSERT_EQ(1u, recorder_.revoked.size());
+  EXPECT_EQ(*grant, recorder_.revoked[0].grant);
+  EXPECT_EQ(kWindow, recorder_.revoked[0].window_id);
+  EXPECT_EQ(frame, recorder_.revoked[0].frame);
+  EXPECT_FALSE(broker()->ResolveGrant(*grant, main_rfh()));
+}
+
+TEST_F(ExoWindowBrokerNoCacheTest, ReloadingRevokesTheDocumentsGrants) {
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(grant);
+  content::NavigationSimulator::Reload(web_contents());
+  EXPECT_EQ(0u, broker()->grant_count());
+  EXPECT_FALSE(broker()->ResolveGrant(*grant, main_rfh()));
+}
+
+// A navigation that keeps the RenderFrameHost (no RenderDocument for main
+// frames) still starts a new document, which doesn't inherit the old one's
+// grants.
+class ExoWindowBrokerSameFrameTest : public ExoWindowBrokerNoCacheTest {
+ public:
+  ExoWindowBrokerSameFrameTest() {
+    content::InitAndEnableRenderDocumentFeature(&render_document_,
+                                                "crashed-frame");
+  }
+
+ private:
+  base::test::ScopedFeatureList render_document_;
+};
+
+TEST_F(ExoWindowBrokerSameFrameTest, NewDocumentInTheSameFrameHasNoGrants) {
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(grant);
+  content::GlobalRenderFrameHostId frame = main_rfh()->GetGlobalId();
+  content::NavigationSimulator::NavigateAndCommitFromDocument(
+      GURL("http://localhost:8765/other.html"), main_rfh());
+  // The point of this test: same frame, new document.
+  ASSERT_EQ(frame, main_rfh()->GetGlobalId());
+  EXPECT_FALSE(broker()->ResolveGrant(*grant, main_rfh()));
+  EXPECT_EQ(0u, broker()->grant_count());
+  // The new document gets grants of its own.
+  std::optional<base::UnguessableToken> fresh =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(fresh);
+  EXPECT_EQ(kWindow, broker()->ResolveGrant(*fresh, main_rfh()));
+}
+
+TEST_F(ExoWindowBrokerSameFrameTest, SameDocumentNavigationKeepsGrants) {
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(grant);
+  content::NavigationSimulator::CreateRendererInitiated(
+      GURL("http://localhost:8765/shell.html#elsewhere"), main_rfh())
+      ->CommitSameDocument();
+  EXPECT_EQ(kWindow, broker()->ResolveGrant(*grant, main_rfh()));
+}
+
+}  // namespace
