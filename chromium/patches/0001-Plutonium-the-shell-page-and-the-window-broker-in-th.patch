+      groups_observation_{this};
+  mojo::AssociatedRemoteSet<blink::mojom::ShellObserver> shell_observers_;
+  mojo::AssociatedRemote<blink::mojom::ContextMenuObserver>
+      context_menu_observer_;
+  mojo::AssociatedRemote<blink::mojom::TabRequestObserver>
+      tab_request_observer_;
+  int32_t id_ = 0;
+  // It was sent a tab request (so PlutoniumTabRequests exists).
+  bool asked_ = false;
+  base::ScopedObservation<PlutoniumShells, PlutoniumShells::Observer>
+      shells_observation_{this};
+  // EXO-TAB-FEATURES: downloads.
+  mojo::AssociatedRemoteSet<blink::mojom::BrowserDownloadObserver>
+      download_observers_;
+  base::ScopedObservation<PlutoniumDownloads, PlutoniumDownloads::Observer>
+      downloads_observation_{this};
+  // EXO-CAPTURE: captures and capture requests.
+  mojo::AssociatedRemote<blink::mojom::CaptureObserver> capture_observer_;
+  // It was sent a capture request.
+  bool capture_asked_ = false;
+  base::ScopedObservation<PlutoniumCapture, PlutoniumCapture::Observer>
+      capture_observation_{this};
+};
+
+}  // namespace
+
+void SetUpShellMode() {
+  if (!IsShellMode()) {
+    return;
+  }
+  base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  GURL url(command_line->GetSwitchValueASCII(kShellUrlSwitch));
+  if (!IsAcceptableShellUrl(url)) {
+    LOG(ERROR) << "EXO-BOOT: not opening --" << kShellUrlSwitch << "="
+               << url.possibly_invalid_spec()
+               << " (needs an http(s) URL that is https, localhost or "
+                  "loopback)";
+    return;
+  }
+  const std::optional<url::Origin>& shell = GetShellOrigin();
+  if (!shell || !url::Origin::Create(url).IsSameOriginWith(*shell)) {
+    LOG(WARNING) << "EXO-BOOT: the shell URL " << url.spec()
+                 << " is not on the shell origin; it won't get the window "
+                    "broker";
+  }
+  LOG(WARNING) << "EXO-BOOT: shell mode, opening " << url.spec();
+  // The startup browser creator opens --app URLs as app windows and makes
+  // them fullscreen with --start-fullscreen; the fullscreen controller,
+  // BrowserView and Ash (app mode) check IsShellMode() for the rest.
+  command_line->AppendSwitchASCII("app", url.spec());
+  command_line->AppendSwitch("start-fullscreen");
+}
+
+const std::optional<url::Origin>& GetShellOrigin() {
+  static const base::NoDestructor<std::optional<url::Origin>> origin(
+      ParseShellOrigin());
+  return *origin;
+}
+
+std::vector<url::Origin> GetShellOrigins() {
+  std::vector<url::Origin> origins;
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    for (const PlutoniumShells::Shell& shell : shells->GetShells()) {
+      if (shell.enabled && !std::ranges::contains(origins, shell.origin)) {
+        origins.push_back(shell.origin);
+      }
+    }
+  } else if (const std::optional<url::Origin>& shell = GetShellOrigin()) {
+    origins.push_back(*shell);
+  }
+  return origins;
+}
+
+bool IsShellOrigin(const url::Origin& origin) {
+  return std::ranges::contains(GetShellOrigins(), origin);
+}
+
+bool IsShellDocument(content::RenderFrameHost* render_frame_host) {
+  if (!render_frame_host ||
+      !render_frame_host->IsInPrimaryMainFrame() ||
+      !render_frame_host->IsRenderFrameLive() ||
+      render_frame_host->IsErrorDocument()) {
+    return false;
+  }
+  content::WebContents* web_contents =
+      content::WebContents::FromRenderFrameHost(render_frame_host);
+  // EXO-TABS: a browser tab (shown through SurfaceEmbed, so it has no
+  // outer WebContents) is never the shell, even on the shell's URL.
+  if (!web_contents || web_contents->GetOuterWebContents() ||
+      web_contents->GetSurfaceEmbedConnector() ||
+      PlutoniumTabs::Get()->IsTab(web_contents)) {
+    return false;
+  }
+  std::optional<url::Origin> shell = ShellOriginFor(web_contents);
+  return shell && render_frame_host->GetLastCommittedOrigin() == *shell &&
+         IsShellUrl(web_contents,
+                    render_frame_host->GetLastCommittedURL());
+}
+
+bool IsVisibleShell(content::WebContents* contents) {
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  // EXO-DISPLAYS: the visible shell on its display.
+  return !shells || (contents && shells->IsVisible(contents));
+}
+
+bool IsVisibleShellDocument(content::RenderFrameHost* render_frame_host) {
+  return IsShellDocument(render_frame_host) &&
+         IsVisibleShell(
+             content::WebContents::FromRenderFrameHost(render_frame_host));
+}
+
+void OnVisibleShellChanged(content::WebContents* previous,
+                           content::WebContents* visible) {
+  // Fullscreen and keyboard focus belong to what the previous shell showed.
+  // EXO-DISPLAYS: only its fullscreen windows; other displays keep theirs.
+  if (ExoEmbedder* embedder = ExoEmbedder::Get(); embedder && previous) {
+    embedder->ExitFullscreen(previous);
+  }
+  PlutoniumTabs::Get()->ExitFullscreen();
+  if (exo::EmbeddedWindows::Get()->focused_window_id()) {
+    exo::EmbeddedWindows::Get()->ClearFocus();
+  }
+  // Tabs park in, and send keys to, the focused display's visible shell.
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    PlutoniumTabs::Get()->SetShell(shells->GetVisibleContents());
+  } else {
+    PlutoniumTabs::Get()->SetShell(visible);
+  }
+  if (!visible) {
+    return;
+  }
+  // The visible shell's elements size what they show again, and its
+  // <embed>s take back the tabs another shell showed meanwhile.
+  if (ExoEmbedder* embedder = ExoEmbedder::Get()) {
+    embedder->OnVisibleShellChanged();
+  }
+  // EXO-DISPLAYS: not tabs another display's visible shell shows.
+  surface_embed::SurfaceEmbedHost::ReattachHosts(
+      base::BindRepeating(
+          [](content::WebContents* visible, content::RenderFrameHost* rfh) {
+            return content::WebContents::FromRenderFrameHost(rfh)
+                       ->GetOutermostWebContents() == visible;
+          },
+          visible),
+      base::BindRepeating([](content::WebContents* child) {
+        content::RenderFrameHost* embedder =
+            surface_embed::SurfaceEmbedHost::GetEmbedderFrame(child);
+        return !embedder || !IsVisibleShellDocument(embedder);
+      }));
+}
+
+bool RequestShowWindow(content::WebContents* shell, int32_t window_id) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  std::optional<ExoWindowBroker::WindowInfo> window =
+      broker ? broker->GetWindow(window_id) : std::nullopt;
+  if (!window) {
+    return false;
+  }
+  bool requested = false;
+  for (WindowBrokerImpl* impl : WindowBrokerImpl::Instances()) {
+    if (impl->contents() == shell) {
+      requested |= impl->RequestShowWindow(*window);
+    }
+  }
+  return requested;
+}
+
+bool RequestActivateWindow(int32_t window_id) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  std::optional<ExoWindowBroker::WindowInfo> window =
+      broker ? broker->GetWindow(window_id) : std::nullopt;
+  if (!window || !shells) {
+    return false;
+  }
+  content::WebContents* shell = nullptr;
+  for (const std::string& tag : window->tags) {
+    std::optional<PlutoniumGroups::Group> group =
+        PlutoniumGroups::Get()->Find(tag);
+    shell = group ? shells->GetContents(group->shell_id) : nullptr;
+    if (shell) {
+      break;
+    }
+  }
+  if (!shell) {
+    shell = shells->GetVisibleContents();
+  }
+  const bool requested = shell && RequestShowWindow(shell, window_id);
+  VLOG(1) << "EXO-ACTIVATION window #" << window_id
+          << (requested ? " asked of its shell" : ": no shell takes it");
+  return requested;
+}
+
+bool ShowWindowOnDisplay(int32_t window_id, int64_t display_id) {
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  content::WebContents* shell =
+      shells ? shells->GetVisibleContentsOn(display_id) : nullptr;
+  if (!shell || !RequestShowWindow(shell, window_id)) {
+    LOG(WARNING) << "EXO-DISPLAYS window #" << window_id
+                 << " not shown on display " << display_id << ": "
+                 << (!shell ? "no visible shell there"
+                            : "its shell doesn't take requests (or no such "
+                              "window)");
+    return false;
+  }
+  LOG(WARNING) << "EXO-DISPLAYS window #" << window_id << " to display "
+               << display_id;
+  shells->FocusDisplay(display_id);
+  return true;
+}
+
+bool ShowTabOnDisplay(int32_t tab_id, int64_t display_id) {
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  content::WebContents* shell =
+      shells ? shells->GetVisibleContentsOn(display_id) : nullptr;
+  if (!shell || !RequestShowTab(shell, tab_id)) {
+    LOG(WARNING) << "EXO-DISPLAYS tab #" << tab_id << " not shown on display "
+                 << display_id << ": "
+                 << (!shell ? "no visible shell there"
+                            : "its shell doesn't take requests (or no such "
+                              "tab)");
+    return false;
+  }
+  LOG(WARNING) << "EXO-DISPLAYS tab #" << tab_id << " to display "
+               << display_id;
+  shells->FocusDisplay(display_id);
+  return true;
+}
+
+bool RequestShowTab(content::WebContents* shell, int32_t tab_id) {
+  std::optional<PlutoniumTabs::TabInfo> tab =
+      PlutoniumTabs::Get()->GetTab(tab_id);
+  if (!tab) {
+    return false;
+  }
+  bool requested = false;
+  for (WindowBrokerImpl* impl : WindowBrokerImpl::Instances()) {
+    if (impl->contents() == shell) {
+      requested |= impl->RequestShowTab(*tab);
+    }
+  }
+  return requested;
+}
+
+bool RequestContextMenu(content::WebContents* shell,
+                        blink::mojom::ContextMenuRequestPtr request,
+                        base::OnceCallback<void(bool handled)> callback) {
+  for (WindowBrokerImpl* impl : WindowBrokerImpl::Instances()) {
+    if (impl->contents() == shell &&
+        impl->RequestContextMenu(request, callback)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool SendTabRequest(content::WebContents* shell,
+                    blink::mojom::TabRequestPtr request,
+                    base::OnceCallback<void(int32_t taker)> callback) {
+  for (WindowBrokerImpl* impl : WindowBrokerImpl::Instances()) {
+    if (impl->contents() == shell && impl->SendTabRequest(request, callback)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void EndTabRequest(int32_t taker, int32_t request_id) {
+  for (WindowBrokerImpl* impl : WindowBrokerImpl::Instances()) {
+    if (impl->id() == taker) {
+      impl->EndTabRequest(request_id);
+    }
+  }
+}
+
+bool SendCaptureRequest(content::WebContents* shell,
+                        int32_t request_id,
+                        const std::string& detail_json,
+                        base::OnceCallback<void(int32_t taker)> callback) {
+  for (WindowBrokerImpl* impl : WindowBrokerImpl::Instances()) {
+    if (impl->contents() == shell &&
+        impl->SendCaptureRequest(request_id, detail_json, callback)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void EndCaptureRequest(int32_t taker, int32_t request_id) {
+  for (WindowBrokerImpl* impl : WindowBrokerImpl::Instances()) {
+    if (impl->id() == taker) {
+      impl->EndCaptureRequest(request_id);
+    }
+  }
+}
+
+bool IsShellBrowser(BrowserWindowInterface* browser) {
+  return IsShellMode() && browser &&
+         browser->GetType() == BrowserWindowInterface::TYPE_APP;
+}
+
+bool IsShellWindowContents(content::WebContents* contents) {
+  if (!IsShellMode() || !contents) {
+    return false;
+  }
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  return !shells || shells->GetShellFor(contents).has_value();
+}
+
+bool IsCommandAllowedInShell(int command_id) {
+  switch (command_id) {
+    case IDC_DEV_TOOLS:
+    case IDC_DEV_TOOLS_CONSOLE:
+    case IDC_DEV_TOOLS_INSPECT:
+    case IDC_DEV_TOOLS_TOGGLE:
+    case IDC_CUT:
+    case IDC_COPY:
+    case IDC_PASTE:
+      return true;
+    default:
+      return false;
+  }
+}
+
+void MaybeAddNavigationThrottle(content::NavigationThrottleRegistry& registry) {
+  if (GetShellOrigins().empty() ||
+      !registry.GetNavigationHandle().IsInPrimaryMainFrame()) {
+    return;
+  }
+  registry.AddThrottle(std::make_unique<ShellNavigationThrottle>(registry));
+}
+
+void BindWindowBroker(
+    content::RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<blink::mojom::WindowBroker> receiver) {
+  if (!ExoWindowBroker::Get()) {
+    return;
+  }
+  if (!IsShellDocument(render_frame_host)) {
+    // A renderer only asks when script sees navigator.windowBroker, which
+    // the browser exposes to the shell document only (or to everything with
+    // --enable-blink-features=PlutoniumShell, for testing this check).
+    // Nothing is bound: the pipe just closes.
+    VLOG(1) << "EXO-BROKER shell API refused for frame "
+            << render_frame_host->GetGlobalId() << " ("
+            << render_frame_host->GetLastCommittedURL().spec() << ")";
+    return;
+  }
+  VLOG(1) << "EXO-BROKER shell API bound for frame "
+          << render_frame_host->GetGlobalId();
+  new WindowBrokerImpl(*render_frame_host, std::move(receiver));
+}
+
+}  // namespace plutonium_shell
