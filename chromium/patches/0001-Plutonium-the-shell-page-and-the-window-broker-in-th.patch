+// Attaching (NativeWindowHost.Attach). Refusals are told apart by the
+// browser's log; a fake window can't be embedded, so a grant that passes
+// every check fails afterwards with "not embeddable".
+class PlutoniumAttachTest : public PlutoniumShellTest {
+ public:
+  void SetUp() override {
+    PlutoniumShellTest::SetUp();
+    vmodule_.InitWithSwitches("exo_embedder=1");
+    Logged().clear();
+    previous_handler_ = logging::GetLogMessageHandler();
+    logging::SetLogMessageHandler(&RecordLog);
+  }
+
+  void TearDown() override {
+    logging::SetLogMessageHandler(previous_handler_);
+    PlutoniumShellTest::TearDown();
+  }
+
+ protected:
+  bool Attach(content::RenderFrameHost* rfh,
+              const base::UnguessableToken& grant,
+              int32_t window_id) {
+    mojo::Remote<blink::mojom::NativeWindowHost> host;
+    ExoEmbedder::BindNativeWindowHost(rfh, host.BindNewPipeAndPassReceiver());
+    mojo::PendingRemote<blink::mojom::NativeWindowClient> client;
+    std::ignore = client.InitWithNewPipeAndPassReceiver();
+    base::test::TestFuture<bool> attached;
+    host->Attach(grant, window_id, std::move(client), attached.GetCallback());
+    return attached.Get();
+  }
+
+ private:
+  logging::ScopedVmoduleSwitches vmodule_;
+  logging::LogMessageHandlerFunction previous_handler_ = nullptr;
+};
+
+TEST_F(PlutoniumAttachTest, ValidGrantPassesTheChecks) {
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(grant);
+  EXPECT_FALSE(Attach(main_rfh(), *grant, kWindow));
+  EXPECT_TRUE(WasLogged("attach failed: window #7 not embeddable"));
+  EXPECT_FALSE(WasLogged("attach refused"));
+  // Without the window id too: the grant decides.
+  Logged().clear();
+  EXPECT_FALSE(Attach(main_rfh(), *grant, 0));
+  EXPECT_TRUE(WasLogged("attach failed: window #7 not embeddable"));
+}
