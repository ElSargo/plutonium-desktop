+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXO_EMBEDDER_H_
+#define CHROME_BROWSER_EXO_EMBEDDER_H_
+
+#include <map>
+#include <utility>
+#include <vector>
+
+#include "components/input/render_widget_host_input_event_router.h"
+#include "components/viz/common/surfaces/frame_sink_id.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+
+namespace blink::mojom {
+class NativeWindowHost;
+}
+
+namespace content {
+class RenderFrameHost;
+class WebContents;
+}
+
+// EXO-EMBED: connects <native-window> elements in web pages to Exo windows.
+//
+// Owned by ExoParts. Binds blink.mojom.NativeWindowHost for frames, links the
+// embedding page's frame sink to the window's frame sink in viz (so viz
+// composites and hit-tests the window inside the page), and turns input that
+// the browser's input router hit-tests onto a window into Exo input.
+class ExoEmbedder : public input::ForeignFrameSinkDelegate {
+ public:
+  ExoEmbedder();
+  ExoEmbedder(const ExoEmbedder&) = delete;
+  ExoEmbedder& operator=(const ExoEmbedder&) = delete;
+  ~ExoEmbedder() override;
+
+  static ExoEmbedder* Get();
+
+  // Binder for blink.mojom.NativeWindowHost. Does nothing unless the Wayland
+  // server is running.
+  static void BindNativeWindowHost(
+      content::RenderFrameHost* render_frame_host,
+      mojo::PendingReceiver<blink::mojom::NativeWindowHost> receiver);
+
+  // EXO-FULLSCREEN: toggles fullscreen for the element showing |window_id|
+  // (see plutonium_keys.h). False if no element shows it.
+  bool ToggleFullscreen(int32_t window_id);
+  // Takes every element showing a window (in |page|, if given) out of
+  // fullscreen; false if none was fullscreen.
+  bool ExitFullscreen(content::WebContents* page = nullptr);
+
+  // EXO-SHELLS: another shell is visible; its elements size their windows
+  // again, and (EXO-DISPLAYS) take back the windows other pages took.
+  void OnVisibleShellChanged();
+  // EXO-SHELLS: the pages with an element showing |window_id| (the shells
+  // overlay lists the shells that show a window), each once.
+  std::vector<content::WebContents*> GetEmbedders(int32_t window_id) const;
+
+  // Counted: viz needs each parent/child link registered once.
+  bool LinkFrameSinks(const viz::FrameSinkId& parent,
+                      const viz::FrameSinkId& child);
+  void UnlinkFrameSinks(const viz::FrameSinkId& parent,
+                        const viz::FrameSinkId& child);
+
+  // input::ForeignFrameSinkDelegate:
+  bool IsEmbeddedIn(const viz::FrameSinkId& frame_sink_id,
+                    const viz::FrameSinkId& parent_frame_sink_id) override;
+  void RouteMouseEvent(const viz::FrameSinkId& frame_sink_id,
+                       const gfx::PointF& location,
+                       const blink::WebMouseEvent& event) override;
+  void PointerLeft(const viz::FrameSinkId& frame_sink_id) override;
+  void PageMouseDown() override;
+  bool NearResizeEdge(const viz::FrameSinkId& parent_frame_sink_id,
+                      const gfx::PointF& point) override;
+
+ private:
+  std::map<std::pair<viz::FrameSinkId, viz::FrameSinkId>, int> links_;
+};
+
+#endif  // CHROME_BROWSER_EXO_EMBEDDER_H_
