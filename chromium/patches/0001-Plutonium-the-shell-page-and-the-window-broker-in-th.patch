new file mode 100644
index 0000000000..d5e5baec32
--- /dev/null
+++ b/chrome/browser/plutonium_groups.h
@@ -0,0 +1,114 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PLUTONIUM_GROUPS_H_
+#define CHROME_BROWSER_PLUTONIUM_GROUPS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+
+class PrefRegistrySimple;
+
+// EXO-TAGS: tags on windows and tabs, and the groups they name.
+//
+// Every window and tab carries a list of tags. Items with the same tag go
+// together, whichever shell shows them: a thread-based shell tags what a
+// thread opens with the thread's tag, a workspace window manager its
+// workspace's, and each can read the other's to place items. Tags are
+// namespaced by convention, "<namespace>:<name>" (t3:thread/<id>,
+// plain:thread/<id>, wm:workspace/2).
+//
+// - The first tag is the item's origin: the thread that started a window's
+//   client (its PLUTONIUM_THREAD_ID, or the nearest ancestor's), or the tag a
+//   tab was created with (inherited by tabs its page opens). It never
+//   changes.
+// - Only shell documents (the broker) and the browser's own UI add or remove
+//   the others. A thread's agent may use every item tagged with the thread.
+//
+// A group is a tag a shell has described: its label and which shell owns
+// it (EXO-SHELLS; the owner gets the helper's requests about the group).
+namespace plutonium_tags {
+
+// The environment variable a thread's processes carry (the helper sets it).
+inline constexpr char kThreadVariable[] = "PLUTONIUM_THREAD_ID";
+// Upper bounds, to keep a misbehaving shell from bloating every entry.
+inline constexpr size_t kMaxTagLength = 256;
+inline constexpr size_t kMaxTags = 32;
+
+// Printable ASCII without spaces, at most kMaxTagLength.
+bool IsValidTag(std::string_view tag);
+
+// |tags| (origin first) with |add| appended and |remove| taken out, except
+// the origin (|tags[0]| when |has_origin|). Invalid and duplicate tags are
+// skipped, and the list is cut at kMaxTags.
+std::vector<std::string> Update(const std::vector<std::string>& tags,
+                                bool has_origin,
+                                const std::vector<std::string>& add,
+                                const std::vector<std::string>& remove);
+
+// The thread tag of process |pid|: its own PLUTONIUM_THREAD_ID, or the
+// nearest ancestor's. Empty if none; nullopt if the browser may not read
+// |pid|'s environment (e.g. Ash in a container with its own user
+// namespace). Blocks (reads /proc).
+std::optional<std::string> ReadThreadTag(int pid);
+
+}  // namespace plutonium_tags
+
+class PlutoniumGroups {
+ public:
+  struct Group {
+    std::string tag;
+    std::string label;
+    // The owning shell's id (PlutoniumShells), or "" outside shell mode.
+    std::string shell_id;
+    bool operator==(const Group&) const = default;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnGroupsChanged() {}
+  };
+
+  // In local state: the groups survive restarts, so items keep their labels
+  // while their shell is off.
+  static constexpr char kGroupsPref[] = "plutonium.groups";
+  static void RegisterLocalStatePrefs(PrefRegistrySimple* registry);
+
+  // Created on first use (after local state exists); lives until exit.
+  static PlutoniumGroups* Get();
+
+  PlutoniumGroups(const PlutoniumGroups&) = delete;
+  PlutoniumGroups& operator=(const PlutoniumGroups&) = delete;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  const std::vector<Group>& groups() const { return groups_; }
+  std::optional<Group> Find(std::string_view tag) const;
+
+  // Replaces |shell_id|'s groups with |groups| (their shell_id is ignored).
+  // A tag another shell owns stays that shell's.
+  void SetGroups(const std::string& shell_id, std::vector<Group> groups);
+  // Drops |shell_id|'s groups (the shell was removed).
+  void RemoveShell(const std::string& shell_id);
+
+ private:
+  friend class base::NoDestructor<PlutoniumGroups>;
+
+  PlutoniumGroups();
+  ~PlutoniumGroups();
+
+  void Changed();
+
+  std::vector<Group> groups_;
+  base::ObserverList<Observer> observers_;
+};
+
+#endif  // CHROME_BROWSER_PLUTONIUM_GROUPS_H_
diff --git a/chrome/browser/plutonium_keys.cc b/chrome/browser/plutonium_keys.cc
new file mode 100644
index 0000000000..11227d9327
--- /dev/null
+++ b/chrome/browser/plutonium_keys.cc
@@ -0,0 +1,435 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/plutonium_keys.h"
+
+#include <optional>
+#include <set>
+#include <utility>
+#include <vector>
+
+#include "ash/shell.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_split.h"
+#include "chrome/browser/exo_embedder.h"
+#include "chrome/browser/plutonium_lock.h"
+#include "chrome/browser/plutonium_shell.h"
+#include "chrome/browser/plutonium_shells.h"
+#include "chrome/browser/plutonium_tabs.h"
+#include "components/exo/embedded_windows.h"
+#include "components/exo/pointer.h"
+#include "components/input/native_web_keyboard_event.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "ui/events/event.h"
+#include "ui/events/event_handler.h"
+#include "ui/events/keycodes/dom/dom_code.h"
+#include "ui/events/keycodes/dom/keycode_converter.h"
+#include "ui/display/types/display_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/wm/core/accelerator_filter.h"
+
+namespace plutonium_keys {
+
+namespace {
+
+// The modifiers shortcuts are made of, as ui::EventFlags.
+constexpr int kModifiers = ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+                           ui::EF_SHIFT_DOWN | ui::EF_COMMAND_DOWN;
+
+struct Shortcut {
+  ui::DomCode code;
+  int modifiers;
+  auto operator<=>(const Shortcut&) const = default;
+};
+
+// A shell page's shortcuts (EXO-SHELLS: each shell has its own).
+class ShellShortcutsData
+    : public content::WebContentsUserData<ShellShortcutsData> {
+ public:
+  std::set<Shortcut> shortcuts;
+
+ private:
+  friend class content::WebContentsUserData<ShellShortcutsData>;
+  explicit ShellShortcutsData(content::WebContents* contents)
+      : content::WebContentsUserData<ShellShortcutsData>(*contents) {}
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ShellShortcutsData);
+
+// Outside shell mode: the page that set shortcuts last.
+base::WeakPtr<content::WebContents>& LastShell() {
+  static base::NoDestructor<base::WeakPtr<content::WebContents>> shell;
+  return *shell;
+}
+
+// The shell page that gets the shell's shortcuts: the visible shell's.
+content::WebContents* KeyShell() {
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    return shells->GetVisibleContents();
+  }
+  return LastShell().get();
+}
+
+const std::set<Shortcut>* ShellShortcuts() {
+  content::WebContents* shell = KeyShell();
+  ShellShortcutsData* data =
+      shell ? ShellShortcutsData::FromWebContents(shell) : nullptr;
+  return data ? &data->shortcuts : nullptr;
+}
+
+std::optional<Shortcut> ParseShortcut(const std::string& text) {
+  std::vector<std::string> parts = base::SplitString(
+      text, "+", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (parts.empty()) {
+    return std::nullopt;
+  }
+  Shortcut shortcut{ui::DomCode::NONE, 0};
+  for (size_t i = 0; i + 1 < parts.size(); ++i) {
+    const std::string& part = parts[i];
+    if (part == "Ctrl" || part == "Control") {
+      shortcut.modifiers |= ui::EF_CONTROL_DOWN;
+    } else if (part == "Alt") {
+      shortcut.modifiers |= ui::EF_ALT_DOWN;
+    } else if (part == "Shift") {
+      shortcut.modifiers |= ui::EF_SHIFT_DOWN;
+    } else if (part == "Super" || part == "Meta") {
+      shortcut.modifiers |= ui::EF_COMMAND_DOWN;
+    } else {
+      return std::nullopt;
+    }
+  }
+  shortcut.code = ui::KeycodeConverter::CodeStringToDomCode(parts.back());
+  if (shortcut.code == ui::DomCode::NONE) {
+    return std::nullopt;
+  }
+  return shortcut;
+}
+
+bool IsShellShortcut(ui::DomCode code, int flags) {
+  const std::set<Shortcut>* shortcuts = ShellShortcuts();
+  return shortcuts &&
+         shortcuts->contains(Shortcut{code, flags & kModifiers});
+}
+
+// EXO-SHELLS: Super+Tab and Super+Shift+Tab open the shells overlay and
+// move through it.
+std::optional<int> SwitchShellStep(const ui::KeyEvent& event) {
+  if (event.key_code() != ui::VKEY_TAB || !PlutoniumShells::Get()) {
+    return std::nullopt;
+  }
+  switch (event.flags() & kModifiers) {
+    case ui::EF_COMMAND_DOWN:
+      return 1;
+    case ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN:
+      return -1;
+    default:
+      return std::nullopt;
+  }
+}
+
+// EXO-DISPLAYS: Super+Shift+Left/Right focus the display to the left or
+// right; with Ctrl too, they move the focused window or tab there (niri's
+// focus-monitor and move-column-to-monitor). |move| says which.
+std::optional<int> DisplayStep(const ui::KeyEvent& event, bool* move) {
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  if (!shells || (event.key_code() != ui::VKEY_LEFT &&
+                  event.key_code() != ui::VKEY_RIGHT)) {
+    return std::nullopt;
+  }
+  switch (event.flags() & kModifiers) {
+    case ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN:
+      *move = false;
+      break;
+    case ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN | ui::EF_CONTROL_DOWN:
+      *move = true;
+      break;
+    default:
+      return std::nullopt;
+  }
+  return event.key_code() == ui::VKEY_LEFT ? -1 : 1;
+}
+
+void StepDisplay(int step, bool move) {
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  const int64_t target = shells->GetNextDisplayId(step);
+  if (target == display::kInvalidDisplayId) {
+    return;
+  }
+  if (move) {
+    if (int32_t window_id = exo::EmbeddedWindows::Get()->focused_window_id()) {
+      if (plutonium_shell::ShowWindowOnDisplay(window_id, target)) {
+        return;
+      }
+    } else {
+      bool moved = false;
+      for (const PlutoniumTabs::TabInfo& tab :
+           PlutoniumTabs::Get()->GetTabs()) {
+        if (tab.focused && tab.embedded) {
+          moved = plutonium_shell::ShowTabOnDisplay(tab.id, target);
+          break;
+        }
+      }
+      if (moved) {
+        return;
+      }
+      LOG(WARNING) << "EXO-DISPLAYS nothing focused to move to display "
+                   << target;
+    }
+  }
+  // (Or what was to move stayed: the keyboard goes there anyway.)
+  shells->FocusDisplay(target);
+}
+
+bool IsReleasePointer(const ui::KeyEvent& event) {
+  return event.key_code() == ui::VKEY_ESCAPE &&
+         (event.flags() & kModifiers) == ui::EF_COMMAND_DOWN;
+}
+
+bool IsToggleFullscreen(const ui::KeyEvent& event) {
+  return event.key_code() == ui::VKEY_F &&
+         (event.flags() & kModifiers) == ui::EF_COMMAND_DOWN;
+}
+
+class HandlerImpl : public Handler, public ui::EventHandler {
+ public:
+  HandlerImpl() {
+    ash::Shell::Get()->AddPreTargetHandler(this,
+                                           ui::EventTarget::Priority::kSystem);
+  }
+  ~HandlerImpl() override {
+    if (ash::Shell::HasInstance()) {
+      ash::Shell::Get()->RemovePreTargetHandler(this);
+    }
+  }
+
+  // ui::EventHandler:
+  void OnKeyEvent(ui::KeyEvent* event) override {
+    // EXO-LOCK: none of these while the lock is up (it has the keyboard).
+    if (PlutoniumLock* lock = PlutoniumLock::Get(); lock && lock->IsLocked()) {
+      return;
+    }
+    const ui::DomCode code = event->code();
+    const bool pressed = event->type() == ui::EventType::kKeyPressed;
+    if (!pressed) {
+      // A release goes where its press went.
+      if (shortcut_.erase(code)) {
+        MarkShellShortcut(event);
+      }
+      if (consumed_.erase(code)) {
+        event->StopPropagation();
+      } else if (to_shell_.erase(code)) {
+        MarkForShell(event);
+      }
+      return;
+    }
+    if (IsToggleFullscreen(*event)) {
+      consumed_.insert(code);
+      event->StopPropagation();
+      if (!event->is_repeat()) {
+        ToggleFullscreen();
+      }
+      return;
+    }
+    if (std::optional<int> step = SwitchShellStep(*event)) {
+      consumed_.insert(code);
+      event->StopPropagation();
+      if (!event->is_repeat()) {
+        PlutoniumShells::Get()->OnSwitchKey(*step);
+      }
+      return;
+    }
+    if (IsReleasePointer(*event)) {
+      consumed_.insert(code);
+      event->StopPropagation();
+      if (!event->is_repeat() && exo::Pointer::UnconstrainAllByUserAction()) {
+        VLOG(1) << "EXO-CAPTURE released the pointer";
+      }
+      return;
+    }
+    const bool shell_shortcut = IsShellShortcut(code, event->flags());
+    // EXO-DISPLAYS: unless the shell takes them itself.
+    bool move = false;
+    if (std::optional<int> step = DisplayStep(*event, &move);
+        step && !shell_shortcut) {
+      consumed_.insert(code);
+      event->StopPropagation();
+      if (!event->is_repeat()) {
+        StepDisplay(*step, move);
+      }
+      return;
+    }
+    // EXO-NIRI: the shell's own shortcuts beat Ash's accelerators.
+    if (shell_shortcut) {
+      shortcut_.insert(code);
+      MarkShellShortcut(event);
+    }
+    // Keys for an embedded window: its keyboard sends them to the app
+    // unless they are the shell's. (Keys for a tab go through
+    // PlutoniumTabs.)
+    if (exo::EmbeddedWindows::Get()->focused_window_id() && shell_shortcut) {
+      to_shell_.insert(code);
+      MarkForShell(event);
+    }
+  }
+
+ private:
+  static void MarkForShell(ui::KeyEvent* event) {
+    ui::Event::Properties properties =
+        event->properties() ? *event->properties() : ui::Event::Properties();
+    properties.emplace(exo::kShellKeyEventKey, std::vector<uint8_t>());
+    event->SetProperties(properties);
+  }
+
+  static void MarkShellShortcut(ui::KeyEvent* event) {
+    ui::Event::Properties properties =
+        event->properties() ? *event->properties() : ui::Event::Properties();
+    properties.emplace(wm::kShellShortcutEventKey, std::vector<uint8_t>());
+    event->SetProperties(properties);
+  }
+
+  // Keys whose press was a shell shortcut (kept from Ash's accelerators).
+  std::set<ui::DomCode> shortcut_;
+  // Keys whose press was taken here, or sent to the shell.
+  std::set<ui::DomCode> consumed_;
+  std::set<ui::DomCode> to_shell_;
+};
+
+}  // namespace
+
+std::unique_ptr<Handler> Install() {
+  return std::make_unique<HandlerImpl>();
+}
+
+void SetShellShortcuts(content::WebContents* shell,
+                       const std::vector<std::string>& shortcuts) {
+  if (!shell) {
+    return;
+  }
+  LastShell() = shell->GetWeakPtr();
+  std::set<Shortcut>& set =
+      ShellShortcutsData::GetOrCreateForWebContents(shell)->shortcuts;
+  set.clear();
+  for (const std::string& text : shortcuts) {
+    if (std::optional<Shortcut> shortcut = ParseShortcut(text)) {
+      set.insert(*shortcut);
+    } else {
+      VLOG(1) << "EXO-KEYS ignoring shell shortcut \"" << text << "\"";
+    }
+  }
+  VLOG(1) << "EXO-KEYS the shell handles " << set.size() << " shortcuts";
+}
+
+bool IsShellShortcut(const input::NativeWebKeyboardEvent& event) {
+  int flags = 0;
+  const int modifiers = event.GetModifiers();
+  if (modifiers & blink::WebInputEvent::kControlKey) {
+    flags |= ui::EF_CONTROL_DOWN;
+  }
+  if (modifiers & blink::WebInputEvent::kAltKey) {
+    flags |= ui::EF_ALT_DOWN;
+  }
+  if (modifiers & blink::WebInputEvent::kShiftKey) {
+    flags |= ui::EF_SHIFT_DOWN;
+  }
+  if (modifiers & blink::WebInputEvent::kMetaKey) {
+    flags |= ui::EF_COMMAND_DOWN;
+  }
+  return IsShellShortcut(static_cast<ui::DomCode>(event.dom_code), flags);
+}
+
+DevToolsKey GetDevToolsKey(const input::NativeWebKeyboardEvent& event) {
+  constexpr int kAll =
+      blink::WebInputEvent::kControlKey | blink::WebInputEvent::kAltKey |
+      blink::WebInputEvent::kShiftKey | blink::WebInputEvent::kMetaKey;
+  const int modifiers = event.GetModifiers() & kAll;
+  if (event.windows_key_code == ui::VKEY_F12 && modifiers == 0) {
+    return DevToolsKey::kToggle;
+  }
+  if (modifiers !=
+      (blink::WebInputEvent::kControlKey | blink::WebInputEvent::kShiftKey)) {
+    return DevToolsKey::kNone;
+  }
+  switch (event.windows_key_code) {
+    case ui::VKEY_I:
+      return DevToolsKey::kToggle;
+    case ui::VKEY_J:
+      return DevToolsKey::kConsole;
+    case ui::VKEY_C:
+      return DevToolsKey::kInspect;
+    default:
+      return DevToolsKey::kNone;
+  }
+}
+
+std::string GetTabCommandKey(const input::NativeWebKeyboardEvent& event) {
+  constexpr int kAll =
+      blink::WebInputEvent::kControlKey | blink::WebInputEvent::kAltKey |
+      blink::WebInputEvent::kShiftKey | blink::WebInputEvent::kMetaKey;
+  constexpr int kCtrl = blink::WebInputEvent::kControlKey;
+  constexpr int kShift = blink::WebInputEvent::kShiftKey;
+  const int modifiers = event.GetModifiers() & kAll;
+  switch (event.windows_key_code) {
+    case ui::VKEY_F3:
+      return modifiers == 0       ? "find-next"
+             : modifiers == kShift ? "find-previous"
+                                   : "";
+    case ui::VKEY_F:
+      return modifiers == kCtrl ? "find" : "";
+    case ui::VKEY_G:
+      return modifiers == kCtrl             ? "find-next"
+             : modifiers == (kCtrl | kShift) ? "find-previous"
+                                             : "";
+    case ui::VKEY_P:
+      return modifiers == kCtrl ? "print" : "";
+    case ui::VKEY_OEM_PLUS:
+    case ui::VKEY_ADD:
+      return (modifiers & ~kShift) == kCtrl ? "zoom-in" : "";
+    case ui::VKEY_OEM_MINUS:
+    case ui::VKEY_SUBTRACT:
+      return (modifiers & ~kShift) == kCtrl ? "zoom-out" : "";
+    case ui::VKEY_0:
+    case ui::VKEY_NUMPAD0:
+      return modifiers == kCtrl ? "zoom-reset" : "";
+    default:
+      return "";
+  }
+}
+
+void ToggleFullscreen() {
+  // EXO-PRESENT: a window or tab the shells overlay showed fullscreen
+  // leaves it, back to the visible shell.
+  if (exo::EmbeddedWindows::Get()->presented_window_id() ||
+      PlutoniumTabs::Get()->presented_tab_id()) {
+    PlutoniumShells* shells = PlutoniumShells::Get();
+    for (const PlutoniumShells::Shell& shell :
+         shells ? shells->GetShells() : std::vector<PlutoniumShells::Shell>()) {
+      if (shell.visible) {
+        shells->Show(shell.id);
+      }
+    }
+    exo::EmbeddedWindows::Get()->EndPresentation();
+    PlutoniumTabs::Get()->EndPresentation();
+    return;
+  }
+  ExoEmbedder* embedder = ExoEmbedder::Get();
+  if (int32_t window_id = exo::EmbeddedWindows::Get()->focused_window_id();
+      window_id && embedder && embedder->ToggleFullscreen(window_id)) {
+    VLOG(1) << "EXO-FULLSCREEN toggled window #" << window_id;
+    return;
+  }
+  if (PlutoniumTabs::Get()->ToggleFocusedTabFullscreen()) {
+    return;
+  }
+  // Neither has focus (e.g. the shell page has): only leaving fullscreen
+  // makes sense.
+  if (!(embedder && embedder->ExitFullscreen())) {
+    PlutoniumTabs::Get()->ExitFullscreen();
+  }
+}
+
+}  // namespace plutonium_keys
diff --git a/chrome/browser/plutonium_keys.h b/chrome/browser/plutonium_keys.h
new file mode 100644
index 0000000000..c5f59fc176
--- /dev/null
+++ b/chrome/browser/plutonium_keys.h
@@ -0,0 +1,90 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PLUTONIUM_KEYS_H_
+#define CHROME_BROWSER_PLUTONIUM_KEYS_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace content {
+class WebContents;
+}
+
+namespace input {
+struct NativeWebKeyboardEvent;
+}
+
+// EXO-KEYS: keys the Plutonium browser handles, whatever has keyboard focus
+// (the shell page, an embedded window or a tab).
+//
+//   Super+Escape  releases a captured pointer (EXO-CAPTURE: an app's
+//            pointer lock or confinement); the app may capture it again
+//            after the next click on it.
+//   Super+Tab, Super+Shift+Tab  show the next or previous shell
+//            (EXO-SHELLS, shell mode with more than one shell).
+//   Super+F  toggles fullscreen for the focused embedded window or tab
+//            (EXO-FULLSCREEN): the element showing it becomes the shell
+//            document's fullscreen element, so the app or page is resized
+//            to the whole screen. With neither focused, it leaves
+//            fullscreen if an element is fullscreen.
+//            A window the shells overlay opened fullscreen
+//            (EXO-PRESENT) goes back to the visible shell instead.
+//   Super+Shift+Left, Super+Shift+Right  move keyboard focus to the display
+//            to the left or right (EXO-DISPLAYS, with several displays).
+//   Super+Ctrl+Shift+Left, Super+Ctrl+Shift+Right  move the focused window
+//            or tab to the display to the left or right: that display's
+//            visible shell is asked to show it. Unless the visible shell
+//            took these keys (SetShellShortcuts).
+//
+// And the shell's own shortcuts (WindowBroker.SetShellShortcuts): while an
+// embedded window or a tab has keyboard focus, a matching key press goes to
+// the shell page as an ordinary key event instead of the app or page. For
+// windows that happens in the handler installed here (the keyboard then
+// leaves the event to the page, see exo::kShellKeyEventKey); for tabs, in
+// the tab's WebContentsDelegate (PlutoniumTabs), which gets their keys
+// first.
+namespace plutonium_keys {
+
+// Installs the key handler on Ash's shell (ExoParts owns the result).
+class Handler {
+ public:
+  virtual ~Handler() = default;
+};
+std::unique_ptr<Handler> Install();
+
+// Replaces |shell|'s shortcuts. Each is "[Ctrl+][Alt+][Shift+][Super+]
+// <code>", <code> a KeyboardEvent.code value; invalid entries are dropped.
+// The visible shell's (in shell mode), else the last caller's, apply.
+void SetShellShortcuts(content::WebContents* shell,
+                       const std::vector<std::string>& shortcuts);
+
