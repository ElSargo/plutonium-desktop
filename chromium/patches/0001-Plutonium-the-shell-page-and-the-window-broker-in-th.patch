+// EXO-TABS: whether |render_frame| is the main frame of a Plutonium shell
+// document: one the browser exposed the shell API to when it committed
+// (ShellNavigationThrottle). Asked of the document, not of a list of origins
+// given to the process when it launched: a shell turned on later can land in a
+// spare renderer that was launched before it. Not a security check: the
+// browser binds the SurfaceEmbed host for shell documents only.
+bool IsPlutoniumShellFrame(content::RenderFrame* render_frame) {
+#if BUILDFLAG(IS_CHROMEOS)
+  return render_frame->IsMainFrame() &&
+         render_frame->GetWebFrame()->GetDocument().IsPlutoniumShell();
