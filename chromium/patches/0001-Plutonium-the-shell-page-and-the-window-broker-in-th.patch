@@ -0,0 +1,395 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/exo_window_broker.h"
+
+#include <sstream>
+#include <utility>
+
+#include "base/auto_reset.h"
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/plutonium_groups.h"
+#include "chrome/browser/plutonium_shell.h"
+#include "content/public/browser/document_user_data.h"
+#include "content/public/browser/render_frame_host.h"
+
+namespace {
+
+ExoWindowBroker* g_instance = nullptr;
+
+ExoWindowBroker::WindowInfo FromExo(int32_t window_id,
+                                    const exo::EmbeddedWindows::Info& info) {
+  ExoWindowBroker::WindowInfo window;
+  window.id = window_id;
+  window.app_id = info.app_id;
+  window.title = info.title;
+  window.size = info.geometry.size();
+  window.device_scale_factor = info.device_scale_factor;
+  window.embedded = info.attached;
+  window.focused = info.focused;
+  window.pid = info.client_pid;
+  window.icon_name = info.icon_name;
+  window.icon_url = info.icon_url;
+  return window;
+}
+
+std::string Describe(const ExoWindowBroker::WindowInfo& window) {
+  std::ostringstream out;
+  out << "#" << window.id << " app_id=\"" << window.app_id
+             << "\" title=\"" << base::UTF16ToUTF8(window.title)
+             << "\" size=" << window.size.ToString()
+             << " scale=" << window.device_scale_factor
+             << " embedded=" << window.embedded
+             << " focused=" << window.focused << " pid=" << window.pid
+             << " tags=[" << base::JoinString(window.tags, " ") << "]";
+  return out.str();
+}
+
+}  // namespace
+
+// Lives exactly as long as one document. Gives the document an id that grants
+// are bound to, and revokes the document's grants when it goes away.
+class ExoWindowBroker::DocumentGrants
+    : public content::DocumentUserData<DocumentGrants> {
+ public:
+  ~DocumentGrants() override {
+    if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+      broker->RevokeGrantsForDocument(document_id_);
+    }
+  }
+
+  const base::UnguessableToken& document_id() const { return document_id_; }
+
+ private:
+  explicit DocumentGrants(content::RenderFrameHost* render_frame_host)
+      : DocumentUserData(render_frame_host) {}
+
+  friend content::DocumentUserData<DocumentGrants>;
+  DOCUMENT_USER_DATA_KEY_DECL();
+
+  const base::UnguessableToken document_id_ = base::UnguessableToken::Create();
+};
+
+DOCUMENT_USER_DATA_KEY_IMPL(ExoWindowBroker::DocumentGrants);
+
+ExoWindowBroker::WindowInfo::WindowInfo() = default;
+ExoWindowBroker::WindowInfo::WindowInfo(const WindowInfo&) = default;
+ExoWindowBroker::WindowInfo& ExoWindowBroker::WindowInfo::operator=(
+    const WindowInfo&) = default;
+ExoWindowBroker::WindowInfo::~WindowInfo() = default;
+bool ExoWindowBroker::WindowInfo::operator==(const WindowInfo&) const =
+    default;
+
+ExoWindowBroker::ExoWindowBroker() {
+  DCHECK(!g_instance);
+  g_instance = this;
+  auto* windows = exo::EmbeddedWindows::Get();
+  windows->AddObserver(this);
+  // Pick up windows created before the broker.
+  for (int32_t window_id : windows->GetWindowIds()) {
+    UpdateWindow(window_id);
+  }
+}
+
+ExoWindowBroker::~ExoWindowBroker() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  exo::EmbeddedWindows::Get()->RemoveObserver(this);
+  g_instance = nullptr;
+}
+
+// static
+ExoWindowBroker* ExoWindowBroker::Get() {
+  return g_instance;
+}
+
+void ExoWindowBroker::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void ExoWindowBroker::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+std::vector<ExoWindowBroker::WindowInfo> ExoWindowBroker::GetWindows() const {
+  std::vector<WindowInfo> windows;
+  for (const auto& [id, window] : windows_) {
+    windows.push_back(window);
+  }
+  return windows;
+}
+
+std::optional<ExoWindowBroker::WindowInfo> ExoWindowBroker::GetWindow(
+    int32_t window_id) const {
+  auto it = windows_.find(window_id);
+  if (it == windows_.end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
+
+std::optional<base::UnguessableToken> ExoWindowBroker::IssueGrant(
+    content::RenderFrameHost* render_frame_host,
+    int32_t window_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!render_frame_host || !render_frame_host->IsRenderFrameLive() ||
+      !render_frame_host->IsActive() || !windows_.contains(window_id)) {
+    return std::nullopt;
+  }
+  DocumentGrants* document =
+      DocumentGrants::GetOrCreateForCurrentDocument(render_frame_host);
+  base::UnguessableToken token = base::UnguessableToken::Create();
+  grants_[token] = Grant{window_id, render_frame_host->GetGlobalId(),
+                         document->document_id()};
+  VLOG(1) << "EXO-BROKER grant issued: window #" << window_id << " to frame "
+          << render_frame_host->GetGlobalId() << " ("
+          << grants_.size() << " grants)";
+  return token;
+}
+
+std::optional<int32_t> ExoWindowBroker::ResolveGrant(
+    const base::UnguessableToken& grant,
+    content::RenderFrameHost* render_frame_host) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (grant.is_empty() || !render_frame_host) {
+    return std::nullopt;
+  }
+  auto it = grants_.find(grant);
+  if (it == grants_.end() ||
+      it->second.frame != render_frame_host->GetGlobalId()) {
+    return std::nullopt;
+  }
+  // Same frame, but it must also be the same document.
+  const DocumentGrants* document =
+      DocumentGrants::GetForCurrentDocument(render_frame_host);
+  if (!document || document->document_id() != it->second.document_id) {
+    return std::nullopt;
+  }
+  return it->second.window_id;
+}
+
+bool ExoWindowBroker::ValidateGrant(const base::UnguessableToken& grant,
+                                    content::RenderFrameHost* render_frame_host,
+                                    int32_t window_id) const {
+  std::optional<int32_t> granted = ResolveGrant(grant, render_frame_host);
+  return granted && *granted == window_id;
+}
+
+void ExoWindowBroker::RevokeGrant(const base::UnguessableToken& grant) {
+  RevokeGrantsIf(
+      [&grant](const base::UnguessableToken& token, const Grant&) {
+        return token == grant;
+      });
+}
+
+void ExoWindowBroker::RevokeGrantsForWindow(int32_t window_id) {
+  RevokeGrantsIf([window_id](const base::UnguessableToken&, const Grant& g) {
+    return g.window_id == window_id;
+  });
+}
+
+void ExoWindowBroker::RevokeGrantsForDocument(
+    const base::UnguessableToken& document_id) {
+  RevokeGrantsIf([&document_id](const base::UnguessableToken&, const Grant& g) {
+    return g.document_id == document_id;
+  });
+}
+
+template <typename Pred>
+void ExoWindowBroker::RevokeGrantsIf(Pred pred) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::vector<std::pair<base::UnguessableToken, Grant>> revoked;
+  for (auto it = grants_.begin(); it != grants_.end();) {
+    if (pred(it->first, it->second)) {
+      revoked.emplace_back(it->first, it->second);
+      it = grants_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  // Notify after erasing, so observers see a consistent state.
+  for (const auto& [token, grant] : revoked) {
+    VLOG(1) << "EXO-BROKER grant revoked: window #" << grant.window_id
+            << " frame " << grant.frame << " (" << grants_.size()
+            << " grants)";
+    Notify(base::BindRepeating(
+        [](const base::UnguessableToken& token, const Grant& grant,
+           Observer& observer) {
+          observer.OnGrantRevoked(token, grant.window_id, grant.frame);
+        },
+        token, grant));
+  }
+}
+
+void ExoWindowBroker::AddWindowForTesting(const WindowInfo& window) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  windows_[window.id] = window;
+  Notify(base::BindRepeating(
+      [](const WindowInfo& window, Observer& observer) {
+        observer.OnWindowAdded(window);
+      },
+      window));
+}
+
+void ExoWindowBroker::OnEmbeddedWindowChanged(int32_t window_id) {
+  UpdateWindow(window_id);
+}
+
+bool ExoWindowBroker::UpdateTags(int32_t window_id,
+                                 const std::vector<std::string>& add,
+                                 const std::vector<std::string>& remove) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!windows_.contains(window_id)) {
+    return false;
+  }
+  tags_[window_id] = plutonium_tags::Update(
+      tags_[window_id], has_origin_tag_[window_id], add, remove);
+  UpdateWindow(window_id);
+  return true;
+}
+
+void ExoWindowBroker::OnOriginTagRead(int32_t window_id,
+                                      std::optional<std::string> tag) {
+  if (!reading_tags_.erase(window_id)) {
+    // Destroyed meanwhile.
+    return;
+  }
+  if (!tag) {
+    VLOG(1) << "EXO-TAGS can't read window #" << window_id
+            << "'s client environment: a shell may name its origin";
+    origin_unknown_.insert(window_id);
+    tag = std::string();
+  }
+  has_origin_tag_[window_id] = !tag->empty();
+  tags_[window_id] = tag->empty() ? std::vector<std::string>()
+                                  : std::vector<std::string>{std::move(*tag)};
+  UpdateWindow(window_id);
+}
+
+bool ExoWindowBroker::SetOriginTag(int32_t window_id, const std::string& tag) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!windows_.contains(window_id) || !origin_unknown_.contains(window_id) ||
+      !plutonium_tags::IsValidTag(tag)) {
+    return false;
+  }
+  origin_unknown_.erase(window_id);
+  std::vector<std::string> tags{tag};
+  for (const std::string& other : tags_[window_id]) {
+    if (other != tag) {
+      tags.push_back(other);
+    }
+  }
+  has_origin_tag_[window_id] = true;
+  tags_[window_id] = plutonium_tags::Update(tags, true, {}, {});
+  UpdateWindow(window_id);
+  return true;
+}
+
+// EXO-ACTIVATION: an app raising its window (xdg_activation_v1) is the
+// shell's to show, as the overlay asks it to.
+void ExoWindowBroker::OnEmbeddedWindowActivationRequested(int32_t window_id) {
+  plutonium_shell::RequestActivateWindow(window_id);
+}
+
+void ExoWindowBroker::OnEmbeddedWindowDestroyed(int32_t window_id) {
+  reading_tags_.erase(window_id);
+  origin_unknown_.erase(window_id);
+  tags_.erase(window_id);
+  has_origin_tag_.erase(window_id);
+  RevokeGrantsForWindow(window_id);
+  if (windows_.erase(window_id) == 0) {
+    return;
+  }
+  VLOG(1) << "EXO-BROKER window removed: #" << window_id;
+  Notify(base::BindRepeating(
+      [](int32_t window_id, Observer& observer) {
+        observer.OnWindowRemoved(window_id);
+      },
+      window_id));
+}
+
+void ExoWindowBroker::UpdateWindow(int32_t window_id) {
+  std::optional<exo::EmbeddedWindows::Info> info =
+      exo::EmbeddedWindows::Get()->GetInfo(window_id);
+  // A window without a surface isn't embeddable yet. One that loses its
+  // surface keeps its last known info until it is destroyed.
+  if (!info) {
+    return;
+  }
+  WindowInfo window = FromExo(window_id, *info);
+  auto it = windows_.find(window_id);
+  if (it == windows_.end()) {
+    // Nor is one whose first commit has no content yet.
+    if (window.size.IsEmpty()) {
+      return;
+    }
+    // EXO-TAGS: nor one whose thread isn't known yet, so that shells see
+    // the origin tag from the start.
+    if (!has_origin_tag_.contains(window_id)) {
+      if (window.pid <= 0) {
+        has_origin_tag_[window_id] = false;
+      } else {
+        if (reading_tags_.insert(window_id).second) {
+          base::ThreadPool::PostTaskAndReplyWithResult(
+              FROM_HERE,
+              {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+               base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+              base::BindOnce(&plutonium_tags::ReadThreadTag, window.pid),
+              base::BindOnce(&ExoWindowBroker::OnOriginTagRead,
+                             weak_ptr_factory_.GetWeakPtr(), window_id));
+        }
+        return;
+      }
+    }
+  }
+  if (has_origin_tag_[window_id]) {
+    window.tag = tags_[window_id].front();
+  }
+  window.tags = tags_[window_id];
+  if (it == windows_.end()) {
+    windows_.emplace(window_id, window);
+    VLOG(1) << "EXO-BROKER window added: " << Describe(window);
+    Notify(base::BindRepeating(
+        [](const WindowInfo& window, Observer& observer) {
+          observer.OnWindowAdded(window);
+        },
+        window));
+    return;
+  }
+  // Surface id and geometry origin churn every frame or resize; only report
+  // what the broker exposes.
+  if (it->second == window) {
+    return;
+  }
+  it->second = window;
+  VLOG(1) << "EXO-BROKER window changed: " << Describe(window);
+  Notify(base::BindRepeating(
+      [](const WindowInfo& window, Observer& observer) {
+        observer.OnWindowChanged(window);
+      },
+      window));
+}
+
+void ExoWindowBroker::Notify(base::RepeatingCallback<void(Observer&)> event) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  pending_events_.push_back(std::move(event));
+  // An event an observer causes (an element detaching from a revoked grant
+  // changes the window) waits until the current one has reached everyone.
+  if (notifying_) {
+    return;
+  }
+  base::AutoReset<bool> notifying(&notifying_, true);
+  while (!pending_events_.empty()) {
+    base::RepeatingCallback<void(Observer&)> next =
+        std::move(pending_events_.front());
+    pending_events_.pop_front();
+    for (Observer& observer : observers_) {
+      next.Run(observer);
+    }
+  }
+}
