+// static
+GURL PlutoniumShells::GetTerminalUrl() {
+  const GURL helper(base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      kHelperUrlSwitch));
+  if (!helper.is_valid() || !helper.SchemeIsHTTPOrHTTPS()) {
+    return GURL();
+  }
+  return helper.Resolve("/v1/terminal/");
+}
