+  // EXO-CAPTURE:
+  void AddCaptureObserver(
+      mojo::PendingAssociatedRemote<blink::mojom::CaptureObserver> observer,
+      AddCaptureObserverCallback callback) override {
+    if (!StillShell()) {
+      std::move(callback).Run({}, "{}");
+      return;
+    }
+    // A new observer replaces the old one; what the old one took goes to
+    // Ash's picker.
+    if (capture_observer_.is_bound()) {
+      capture_observer_.reset();
+      if (capture_asked_) {
+        PlutoniumCapture::Get()->OnShellGone(id_);
+      }
+    }
+    capture_observer_.Bind(std::move(observer));
+    capture_observer_.set_disconnect_handler(base::BindOnce(
+        [](WindowBrokerImpl* self) {
+          self->capture_observer_.reset();
+          self->capture_observation_.Reset();
+          if (self->capture_asked_) {
+            PlutoniumCapture::Get()->OnShellGone(self->id_);
+          }
+        },
+        base::Unretained(this)));
+    PlutoniumCapture* capture = PlutoniumCapture::Get();
+    if (!capture_observation_.IsObserving()) {
+      capture_observation_.Observe(capture);
+    }
+    std::vector<std::string> captures;
+    for (const base::DictValue& entry : capture->GetCaptures()) {
+      captures.push_back(ToJson(entry));
+    }
+    std::move(callback).Run(std::move(captures),
+                            ToJson(capture->GetSettings()));
+  }
+
+  void Screenshot(const std::string& source_json,
+                  ScreenshotCallback callback) override {
+    if (!StillShell()) {
+      std::move(callback).Run(std::nullopt, "Not the shell");
+      return;
+    }
+    std::optional<base::Value> parsed = base::JSONReader::Read(
+        source_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    std::optional<PlutoniumCapture::Source> source =
+        parsed ? PlutoniumCapture::Source::FromValue(*parsed) : std::nullopt;
+    if (!source) {
+      std::move(callback).Run(std::nullopt, "Which source?");
+      return;
+    }
+    PlutoniumCapture::Get()->Screenshot(
+        *source,
+        base::BindOnce(
+            [](ScreenshotCallback callback, const SkBitmap& bitmap,
+               const std::string& error) {
+              if (bitmap.drawsNothing()) {
+                std::move(callback).Run(std::nullopt, error);
+                return;
+              }
+              EncodePng(base::BindOnce(
+                            [](ScreenshotCallback callback,
+                               std::optional<mojo_base::BigBuffer> png) {
+                              const std::string error =
+                                  png ? "" : "Couldn't encode the image";
+                              std::move(callback).Run(std::move(png), error);
+                            },
+                            std::move(callback)),
+                        bitmap);
+            },
+            std::move(callback)));
+  }
+
