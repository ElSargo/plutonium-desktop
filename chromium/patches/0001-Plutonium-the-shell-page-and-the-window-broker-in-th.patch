+bool ChromeContentBrowserClient::IsFullscreenAllowedWithoutUserActivation(
+    content::RenderFrameHost* requesting_frame) {
+  // EXO-FULLSCREEN: the Plutonium shell is the desktop; the browser asks it
+  // to make an element fullscreen on Super+F or for an app (see
+  // plutonium_keys.h). Its page script still needs activation (Blink checks).
+  return plutonium_shell::IsShellDocument(requesting_frame);
+}
