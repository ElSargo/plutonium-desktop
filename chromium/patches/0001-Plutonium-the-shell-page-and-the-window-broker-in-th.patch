+  void AddDownloadObserver(
+      mojo::PendingAssociatedRemote<blink::mojom::BrowserDownloadObserver>
+          observer,
+      AddDownloadObserverCallback callback) override {
+    if (!StillShell()) {
+      std::move(callback).Run({});
+      return;
+    }
+    PlutoniumDownloads* downloads = PlutoniumDownloads::Get();
+    // Downloads from the shell page too, before it opened any tab.
+    downloads->ObserveContext(contents()->GetBrowserContext());
+    if (!downloads_observation_.IsObserving()) {
+      downloads_observation_.Observe(downloads);
+    }
+    download_observers_.Add(std::move(observer));
+    std::vector<blink::mojom::BrowserDownloadPtr> result;
+    for (const base::DictValue& download : downloads->GetDownloads()) {
+      result.push_back(ToMojo(download));
