+      snapshot;
+  shell->AddObserver(observer.receiver.BindNewEndpointAndPassRemote(),
+                     snapshot.GetCallback());
+  ASSERT_TRUE(snapshot.Wait());
+
+  // Another shell page (same origin, its own tab) has a grant.
+  std::unique_ptr<content::WebContents> other = CreateTestWebContents();
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(other.get(),
+                                                             GURL(kShellUrl));
+  std::optional<base::UnguessableToken> theirs =
+      broker()->IssueGrant(other->GetPrimaryMainFrame(), kWindow);
+  ASSERT_TRUE(theirs);
+
+  // This shell can't revoke it...
+  shell->RevokeGrant(*theirs);
+  shell.FlushForTesting();
+  EXPECT_EQ(kWindow,
+            broker()->ResolveGrant(*theirs, other->GetPrimaryMainFrame()));
+  // ...and isn't told when it goes.
+  broker()->RevokeGrant(*theirs);
+  shell.FlushForTesting();
+  EXPECT_TRUE(observer.revoked.empty());
+}
