+int64_t PlutoniumShells::GetNextDisplayId(int step) const {
+  const std::vector<Display> displays = GetDisplays();
+  const int count = static_cast<int>(displays.size());
+  if (count < 2) {
+    return display::kInvalidDisplayId;
+  }
+  const int64_t focused = GetFocusedDisplayId();
+  int current = 0;
+  for (int i = 0; i < count; ++i) {
+    if (displays[i].id == focused) {
+      current = i;
+    }
+  }
+  return displays[((current + step) % count + count) % count].id;
+}
