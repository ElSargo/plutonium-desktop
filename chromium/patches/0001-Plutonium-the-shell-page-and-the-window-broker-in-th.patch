+void PlutoniumShells::NotifyVisibleShellChanged(
+    content::WebContents* previous,
+    content::WebContents* visible) {
+  // The browser's own pieces first (attachments, keys, tabs' parking), then
+  // whoever else watches.
+  plutonium_shell::OnVisibleShellChanged(previous, visible);
+  for (Observer& observer : observers_) {
+    observer.OnVisibleShellChanged(previous, visible);
+  }
+}
diff --git a/chrome/browser/plutonium_shells.h b/chrome/browser/plutonium_shells.h
new file mode 100644
index 0000000000..79d1c57ccc
--- /dev/null
+++ b/chrome/browser/plutonium_shells.h
@@ -0,0 +1,262 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PLUTONIUM_SHELLS_H_
+#define CHROME_BROWSER_PLUTONIUM_SHELLS_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "ui/gfx/geometry/rect.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+class PrefRegistrySimple;
+
+namespace content {
+class WebContents;
+}
+
+// EXO-SHELLS: several shells (frontends) in one session, in shell mode
+// (--plutonium-shell-url, see plutonium_shell.h).
+//
+// Every enabled shell has its own page, in its own fullscreen app window,
+// loaded and running all the time. One of them is visible; the others'
+// windows are hidden. Windows (Exo) and browser tabs (PlutoniumTabs) don't
+// belong to any shell, so every shell sees and can show all of them. Only
+// the visible shell drives them: a hidden shell's elements keep their
+// attachments but can't resize, focus or fullscreen what they show, and a
+// tab follows the visible shell's <embed> (a hidden shell's <embed> gets it
+// back when that shell is shown again).
+//
+// The list is in local state (kShellsPref). Shells on the command line are
+// added to it if it doesn't have them yet:
+//
+//   --plutonium-shell-url=<url>          the startup shell, shown first
+//   --plutonium-shells=<name>=<url>|...  more shells
+//
+// EXO-DISPLAYS: each display has its own shell windows, one page per
+// enabled shell (MULTI_MONITOR.md), and its own visible shell. "The visible
+// shell" without a display is the one on the focused display (the one with
+// the active window). The pages a shell opens on displays other than the
+// startup one get "display=<id>" in their URL's query. Unplugging a display
+// closes its shells' windows; what they showed is still in the shared pool.
+//
+// Implemented in chrome/browser/ui/ash/main_extra_parts (it needs browser
+// windows); exists only in shell mode.
+class PlutoniumShells {
+ public:
+  struct Shell {
+    Shell();
+    Shell(const Shell&);
+    Shell& operator=(const Shell&);
+    ~Shell();
+
+    // Stable, from the list.
+    std::string id;
+    std::string name;
+    GURL url;
+    // The origin its documents must have to be the shell: the URL's, or
+    // --plutonium-shell-origin for the startup shell.
+    url::Origin origin;
+    bool enabled = true;
+    // Whether its page is loaded (it has a window).
+    bool running = false;
+    // The visible shell on the focused display.
+    bool visible = false;
+    // EXO-DISPLAYS: the displays it has a window on, and the ones it is the
+    // visible shell of.
+    std::vector<int64_t> displays;
+    std::vector<int64_t> visible_on;
+  };
+
+  // EXO-DISPLAYS: a display.
+  struct Display {
+    int64_t id = 0;
+    // 1-based, in reading order of where the displays are (left to right,
+    // then top to bottom): "display 2".
+    int index = 0;
+    std::string label;
+    // DIPs, in the desktop's coordinates.
+    gfx::Rect bounds;
+    gfx::Rect work_area;
+    float scale_factor = 1.f;
+    // Degrees, clockwise.
+    int rotation = 0;
+    bool primary = false;
+    bool internal = false;
+    // It has keyboard focus (the active window is on it).
+    bool focused = false;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // The list or a shell's state changed.
+    virtual void OnShellsChanged() {}
+    // Another shell is visible on a display (|visible| may be null while
+    // none is). EXO-DISPLAYS: |previous| and |visible| are that display's.
+    virtual void OnVisibleShellChanged(content::WebContents* previous,
+                                       content::WebContents* visible) {}
+    // The registry is going away (shutdown): stop observing.
+    virtual void OnShellsDestroying() {}
+    // EXO-DISPLAYS: a display was added, removed or changed, or keyboard
+    // focus moved to another display.
+    virtual void OnDisplaysChanged() {}
+    // A touchpad swipe with three fingers or more (window_broker.mojom's
+    // ShellObserver.OnTouchpadSwipe), for the focused display's visible shell.
+    virtual void OnTouchpadSwipe(const std::string& swipe_json) {}
+  };
+
+  inline static constexpr char kShellsPref[] = "plutonium.shells";
+  // EXO-DISPLAYS: the shell last visible on each display (display id →
+  // shell id), shown there again when the display comes back.
+  inline static constexpr char kDisplayShellsPref[] =
+      "plutonium.display_shells";
+  // EXO-DISPLAYS: lets DevTools replace the displays
+  // (Plutonium.setDisplaysForTesting), for testing hotplug on X11.
+  inline static constexpr char kTestDisplaysSwitch[] =
+      "plutonium-test-displays";
+  inline static constexpr char kShellsSwitch[] = "plutonium-shells";
+  // --plutonium-shells is the whole list, in order: shells it doesn't name
+  // are dropped, and "!<name>=<url>" is a shell that's off. The launcher's
+  // list of installed shells (~/.pluto/shells.json) is the one to keep.
+  inline static constexpr char kShellsExactSwitch[] =
+      "plutonium-shells-exact";
+  // The session's helper (plutoniumd): its URL for pages
+  // (http://127.0.0.1:<port>), and its Unix socket, which the shells overlay
+  // asks for desktop apps and starts them through.
+  inline static constexpr char kHelperUrlSwitch[] = "plutonium-helper-url";
+  inline static constexpr char kHelperSocketSwitch[] =
+      "plutonium-helper-socket";
+
+  // The shells overlay's stand-ins for when no shell works:
+  //   kTerminal  the helper's terminal page (tabs of shells on the host), in
+  //              an app window;
+  //   kBrowser   Chrome's own tabbed browser window.
+  // Neither is a shell: they're ordinary windows on the desktop, maximized,
+  // above the shells until one is shown.
+  enum class Backup { kTerminal, kBrowser };
+
+  static void RegisterLocalStatePrefs(PrefRegistrySimple* registry);
+
+  // The registry, or null outside shell mode.
+  static PlutoniumShells* Get();
+
+  PlutoniumShells(const PlutoniumShells&) = delete;
+  PlutoniumShells& operator=(const PlutoniumShells&) = delete;
+  virtual ~PlutoniumShells();
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  virtual std::vector<Shell> GetShells() const = 0;
+  // The shell whose window shows |contents|, if any.
+  virtual std::optional<Shell> GetShellFor(
+      const content::WebContents* contents) const = 0;
+  // The visible shell's page on the focused display, or null.
+  virtual content::WebContents* GetVisibleContents() const = 0;
+  // Shows shell |id| (enabled and running) on the focused display, hides
+  // the others there and brings it to the front: above a backup window, and
+  // ending a presented window's fullscreen (exo::EmbeddedWindows::Present()).
+  virtual bool Show(const std::string& id) = 0;
+  // Shows the next (|step| 1) or previous (-1) running shell on the focused
+  // display.
+  virtual void ShowNext(int step) = 0;
+  // Shell |id|'s page, or null if it isn't running: the one visible on the
+  // focused display, else one visible on another, else the focused
+  // display's.
+  virtual content::WebContents* GetContents(const std::string& id) const = 0;
+
+  // EXO-DISPLAYS.
+  //
+  // The displays, by index.
+  virtual std::vector<Display> GetDisplays() const = 0;
+  // The display with keyboard focus.
+  virtual int64_t GetFocusedDisplayId() const = 0;
+  // The display a shell's page (|contents|, or a page inside it) is on, or
+  // display::kInvalidDisplayId if it isn't a shell's.
+  virtual int64_t GetDisplayOf(const content::WebContents* contents) const = 0;
+  // Whether |contents| (or the page it is in) is the visible shell's page on
+  // its display. Only those drive windows and tabs.
+  virtual bool IsVisible(const content::WebContents* contents) const = 0;
+  // As GetVisibleContents(), Show() and GetContents(), on display
+  // |display_id|.
+  virtual content::WebContents* GetVisibleContentsOn(
+      int64_t display_id) const = 0;
+  virtual bool ShowOn(const std::string& id, int64_t display_id) = 0;
+  virtual content::WebContents* GetContentsOn(const std::string& id,
+                                              int64_t display_id) const = 0;
+  // Activates the visible shell's window on display |display_id|, so
+  // keyboard focus moves there.
+  virtual bool FocusDisplay(int64_t display_id) = 0;
+  // The display |step| places from the focused one in index order
+  // (wrapping), or kInvalidDisplayId with only one.
+  int64_t GetNextDisplayId(int step) const;
+  // Replaces the displays with host windows (--ash-host-window-bounds specs
+  // such as "1280+0-1280x800"), with --plutonium-test-displays only. Each
+  // spec may start with "<id>:" to keep a display's id. False if refused.
+  virtual bool SetDisplaysForTesting(const std::vector<std::string>& specs) = 0;
+
+  // Management (the shells overlay). Each tells observers.
+  //
+  // Adds a shell (enabled: its window opens hidden). Its id, or nullopt if
+  // |url| isn't acceptable (http(s), and https unless local).
+  virtual std::optional<std::string> AddShell(const std::string& name,
+                                              const GURL& url) = 0;
+  // Renames shell |id| and, if |url| differs, loads it there.
+  virtual bool UpdateShell(const std::string& id,
+                           const std::string& name,
+                           const GURL& url) = 0;
+  // Turns shell |id| on (opens its window) or off (closes it; another shell
+  // is shown first if it was visible). The last running shell can't be
+  // turned off.
+  virtual bool SetEnabled(const std::string& id, bool enabled) = 0;
+  // Reloads shell |id|'s page (e.g. after its renderer crashed), from the
+  // network if |bypass_cache|.
+  virtual bool Reload(const std::string& id, bool bypass_cache) = 0;
+  // Turns shell |id| off and forgets it, with its groups.
+  virtual bool RemoveShell(const std::string& id) = 0;
+  // Moves shell |id| |delta| places in the list (Super+Tab's order).
+  virtual bool MoveShell(const std::string& id, int delta) = 0;
+
+  // Backups (see Backup). Opens it, or brings it to the front; |url| is a
+  // tab the browser opens (empty: none if it's open, else a new tab page).
+  virtual bool OpenBackup(Backup backup, const GURL& url) = 0;
+  virtual bool IsBackupOpen(Backup backup) const = 0;
+  virtual void CloseBackup(Backup backup) = 0;
+  // The helper's terminal page, or an empty URL without --plutonium-helper-url.
+  static GURL GetTerminalUrl();
+
+  // Super+Tab (|step| 1) / Super+Shift+Tab (-1): opens the shells overlay
+  // with the next shell selected, or moves its selection if it is open.
+  virtual void OnSwitchKey(int step) = 0;
+  // Opens the shells overlay (or, if it's open, goes) on one of its settings
+  // pages: "settings" (quick settings), "displays", "network", "bluetooth",
+  // "sound", "power" or "notifications". False for another name.
+  virtual bool OpenSwitcher(const std::string& page) = 0;
+
+  // EXO-DISPLAYS: configuring the displays (plutonium_display_config.h), as
+  // JSON: the configuration, and a change ("" once applied, else why not).
+  virtual std::string GetDisplayConfigJson() const = 0;
+  virtual std::string ConfigureDisplays(const std::string& change_json) = 0;
+
+  // Sends a touchpad swipe (OnTouchpadSwipe) to the observers.
+  void NotifyTouchpadSwipe(const std::string& swipe_json);
+
+ protected:
+  PlutoniumShells();
+
+  void NotifyShellsChanged();
+  void NotifyDisplaysChanged();
+  void NotifyVisibleShellChanged(content::WebContents* previous,
+                                 content::WebContents* visible);
+
+ private:
+  base::ObserverList<Observer> observers_;
+};
+
+#endif  // CHROME_BROWSER_PLUTONIUM_SHELLS_H_
