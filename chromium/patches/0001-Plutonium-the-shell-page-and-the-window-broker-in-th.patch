+// Turns a Blink mouse or wheel event back into an aura event for Exo. The
+// location is filled in by Exo.
+std::unique_ptr<ui::MouseEvent> ToMouseEvent(
+    const blink::WebMouseEvent& event) {
+  int flags = ui::WebEventModifiersToEventFlags(event.GetModifiers());
+  constexpr int kButtonFlags = ui::EF_LEFT_MOUSE_BUTTON |
+                               ui::EF_MIDDLE_MOUSE_BUTTON |
+                               ui::EF_RIGHT_MOUSE_BUTTON;
+  switch (event.GetType()) {
+    case blink::WebInputEvent::Type::kMouseWheel: {
+      const auto& wheel = static_cast<const blink::WebMouseWheelEvent&>(event);
+      // PLUTONIUM: touchpads (precise pixels) scroll by pixels, as a
+      // ui::ScrollEvent that Exo sends as finger axis events; the end of the
+      // gesture becomes axis_stop. Not as wheel ticks, which truncated the
+      // small steps to nothing. Momentum is left to the client.
+      if (wheel.delta_units == ui::ScrollGranularity::kScrollByPrecisePixel) {
+        if (wheel.momentum_phase != blink::WebMouseWheelEvent::kPhaseNone) {
+          return nullptr;
+        }
+        const bool end =
+            wheel.phase == blink::WebMouseWheelEvent::kPhaseEnded ||
+            wheel.phase == blink::WebMouseWheelEvent::kPhaseCancelled;
+        if (!end && !wheel.delta_x && !wheel.delta_y) {
+          return nullptr;
+        }
+        return std::make_unique<ui::ScrollEvent>(
+            end ? ui::EventType::kScrollFlingStart : ui::EventType::kScroll,
+            gfx::PointF(), gfx::PointF(), ui::EventTimeForNow(), flags,
+            wheel.delta_x, wheel.delta_y, wheel.delta_x, wheel.delta_y,
+            /*finger_count=*/2);
+      }
+      if (!wheel.delta_x && !wheel.delta_y) {
+        return nullptr;
+      }
+      // PLUTONIUM: a wheel notch is 120 here (evdev's ticks, unscaled), but
+      // MouseWheelEvent::kWheelDelta is 53 on ChromeOS. Pass the notches as
+      // tick_120ths and the offset in kWheelDelta units, so Exo sends one
+      // notch per notch instead of 120/53 of one.
+      const gfx::Vector2d ticks(base::ClampRound(wheel.delta_x),
+                                base::ClampRound(wheel.delta_y));
+      const gfx::Vector2d offset(
+          base::ClampRound(wheel.delta_x * ui::MouseWheelEvent::kWheelDelta /
+                           120.f),
+          base::ClampRound(wheel.delta_y * ui::MouseWheelEvent::kWheelDelta /
+                           120.f));
+      return std::make_unique<ui::MouseWheelEvent>(
+          offset, gfx::PointF(), gfx::PointF(), ui::EventTimeForNow(), flags,
+          0, ticks);
+    }
+    case blink::WebInputEvent::Type::kMouseMove:
+      return std::make_unique<ui::MouseEvent>(
+          (flags & kButtonFlags) ? ui::EventType::kMouseDragged
+                                 : ui::EventType::kMouseMoved,
+          gfx::PointF(), gfx::PointF(), ui::EventTimeForNow(), flags, 0);
+    case blink::WebInputEvent::Type::kMouseDown:
+    case blink::WebInputEvent::Type::kMouseUp: {
+      int changed = ButtonToEventFlag(event.button);
+      if (!changed) {
+        return nullptr;
+      }
+      bool down = event.GetType() == blink::WebInputEvent::Type::kMouseDown;
+      return std::make_unique<ui::MouseEvent>(
+          down ? ui::EventType::kMousePressed : ui::EventType::kMouseReleased,
+          gfx::PointF(), gfx::PointF(), ui::EventTimeForNow(),
+          down ? (flags | changed) : (flags & ~changed), changed);
+    }
+    default:
+      return nullptr;
+  }
+}
+
+blink::mojom::NativeWindowInfoPtr ToMojo(
+    int32_t window_id,
+    const exo::EmbeddedWindows::Info& info) {
+  return blink::mojom::NativeWindowInfo::New(
+      window_id, info.surface_id, info.geometry, info.surface_size,
+      info.device_scale_factor,
+      base::UTF16ToUTF8(info.title), info.app_id, info.focused);
+}
+
+// Backs one <native-window> element.
+//
+// EXO-BROKER: attaching needs a grant from ExoWindowBroker for this document,
+// and the document must be the shell (plutonium_shell::IsShellDocument()).
+// The host only ever acts on the window its grant names, re-checks the grant
+// before acting, and detaches (and tells the element the window is gone) as
+// soon as the grant is revoked.
+class NativeWindowHostImpl;
+
+// Every host, newest last (EXO-FULLSCREEN picks among them).
+std::vector<NativeWindowHostImpl*>& Hosts() {
+  static base::NoDestructor<std::vector<NativeWindowHostImpl*>> hosts;
+  return *hosts;
+}
+
+// EXO-EMBED: the element that sizes each window and gets its requests (see
+// Driver()), as last applied.
+std::map<int32_t, NativeWindowHostImpl*>& Drivers() {
+  static base::NoDestructor<std::map<int32_t, NativeWindowHostImpl*>> drivers;
+  return *drivers;
+}
+
+NativeWindowHostImpl* Driver(int32_t window_id);
+void UpdateDriver(int32_t window_id);
+void UpdateShown(int32_t window_id);
+void ReclaimFreed(int32_t window_id);
+
+blink::mojom::NativeWindowRequest ToMojo(
+    exo::EmbeddedWindows::Request request) {
+  switch (request) {
+    case exo::EmbeddedWindows::Request::kMaximize:
+      return blink::mojom::NativeWindowRequest::kMaximize;
+    case exo::EmbeddedWindows::Request::kUnmaximize:
+      return blink::mojom::NativeWindowRequest::kUnmaximize;
+    case exo::EmbeddedWindows::Request::kMinimize:
+      return blink::mojom::NativeWindowRequest::kMinimize;
+    case exo::EmbeddedWindows::Request::kMove:
+      return blink::mojom::NativeWindowRequest::kMove;
+    case exo::EmbeddedWindows::Request::kResize:
+      return blink::mojom::NativeWindowRequest::kResize;
+  }
+}
+
+uint32_t ToEdges(int component) {
+  switch (component) {
+    case HTTOP:
+      return blink::mojom::kNativeWindowEdgeTop;
+    case HTBOTTOM:
+      return blink::mojom::kNativeWindowEdgeBottom;
+    case HTLEFT:
+      return blink::mojom::kNativeWindowEdgeLeft;
+    case HTRIGHT:
+      return blink::mojom::kNativeWindowEdgeRight;
+    case HTTOPLEFT:
+      return blink::mojom::kNativeWindowEdgeTop |
+             blink::mojom::kNativeWindowEdgeLeft;
+    case HTTOPRIGHT:
+      return blink::mojom::kNativeWindowEdgeTop |
+             blink::mojom::kNativeWindowEdgeRight;
+    case HTBOTTOMLEFT:
+      return blink::mojom::kNativeWindowEdgeBottom |
+             blink::mojom::kNativeWindowEdgeLeft;
+    case HTBOTTOMRIGHT:
+      return blink::mojom::kNativeWindowEdgeBottom |
+             blink::mojom::kNativeWindowEdgeRight;
+    default:
+      return 0;
+  }
+}
+
+class NativeWindowHostImpl
+    : public content::DocumentService<blink::mojom::NativeWindowHost>,
+      public exo::EmbeddedWindows::Observer,
+      public ExoWindowBroker::Observer {
+ public:
+  NativeWindowHostImpl(
+      content::RenderFrameHost& render_frame_host,
+      mojo::PendingReceiver<blink::mojom::NativeWindowHost> receiver)
+      : DocumentService(render_frame_host, std::move(receiver)) {
+    Hosts().push_back(this);
+    exo::EmbeddedWindows::Get()->AddObserver(this);
+    // Outlives every host: ExoEmbedder (and so BindNativeWindowHost) only
+    // exists while the broker does, and DocumentServices go away with their
+    // frames before ExoParts is destroyed.
+    ExoWindowBroker::Get()->AddObserver(this);
+  }
+
+  ~NativeWindowHostImpl() override {
+    std::erase(Hosts(), this);
+    DoDetach();
+    if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+      broker->RemoveObserver(this);
+    }
+    exo::EmbeddedWindows::Get()->RemoveObserver(this);
+  }
+
+  // blink::mojom::NativeWindowHost:
+  void Attach(const base::UnguessableToken& grant,
+              int32_t requested_window_id,
+              mojo::PendingRemote<blink::mojom::NativeWindowClient> client,
+              AttachCallback callback) override {
+    DoDetach();
+    // Defence in depth: grants are only issued to the shell document, but
+    // refuse anything else outright too.
+    if (!plutonium_shell::IsShellDocument(&render_frame_host())) {
+      VLOG(1) << "EXO-BROKER attach refused: frame "
+              << render_frame_host().GetGlobalId() << " is not the shell";
+      std::move(callback).Run(false);
+      return;
+    }
+    ExoWindowBroker* broker = ExoWindowBroker::Get();
+    std::optional<int32_t> window_id =
+        broker ? broker->ResolveGrant(grant, &render_frame_host())
+               : std::nullopt;
+    if (!window_id) {
+      VLOG(1) << "EXO-BROKER attach refused: no valid grant for frame "
+              << render_frame_host().GetGlobalId() << " (window #"
+              << requested_window_id << ")";
+      std::move(callback).Run(false);
+      return;
+    }
+    if (requested_window_id && requested_window_id != *window_id) {
+      VLOG(1) << "EXO-BROKER attach refused: grant is for window #"
+              << *window_id << ", not #" << requested_window_id
+              << " (frame " << render_frame_host().GetGlobalId() << ")";
+      std::move(callback).Run(false);
+      return;
+    }
+    auto* windows = exo::EmbeddedWindows::Get();
+    std::optional<exo::EmbeddedWindows::Info> info =
+        windows->GetInfo(*window_id);
+    ExoEmbedder* embedder = ExoEmbedder::Get();
+    viz::FrameSinkId parent =
+        render_frame_host().GetRenderWidgetHost()->GetFrameSinkId();
+    viz::FrameSinkId child = windows->GetFrameSinkId(*window_id);
+    if (!info || !embedder || !child.is_valid() ||
+        !embedder->LinkFrameSinks(parent, child)) {
+      VLOG(1) << "EXO-BROKER attach failed: window #" << *window_id
+              << " not embeddable";
+      std::move(callback).Run(false);
+      return;
+    }
+    VLOG(1) << "EXO-BROKER attach: window #" << *window_id << " in frame "
+            << render_frame_host().GetGlobalId();
+    static uint64_t next_attach_seq = 0;
+    attach_seq_ = ++next_attach_seq;
+    grant_ = grant;
+    window_id_ = *window_id;
+    parent_frame_sink_id_ = parent;
+    frame_sink_id_ = child;
+    client_.Bind(std::move(client));
+    std::move(callback).Run(true);
+    // EXO-DISPLAYS: one window, one place. The newest claim takes the
+    // window from other pages' elements, except that a hidden shell doesn't
+    // take it from a visible one: it gets it when it's shown.
+    if (!visible() && IsHeldByVisiblePage()) {
+      embedder->UnlinkFrameSinks(parent_frame_sink_id_, frame_sink_id_);
+      SetTaken();
+      return;
+    }
+    TakeFromOtherPages();
+    windows->Attach(window_id_);
+    focused_ = info->focused;
+    client_->OnInfoChanged(ToMojo(window_id_, *info));
+    UpdateDriver(window_id_);
+    // EXO-FULLSCREEN: the app wants fullscreen (e.g. a game that started
+    // fullscreen): shown means shown fullscreen.
+    if (windows->IsFullscreenRequested(window_id_) &&
+        Driver(window_id_) == this) {
+      client_->SetFullscreen(true);
+    }
+  }
+
+  void Detach() override { DoDetach(); }
+
+  void SetSize(const gfx::Size& size_in_pixels) override {
+    // EXO-SHELLS: a hidden shell's element is sized again when it's shown.
+    // EXO-EMBED: so is an element that becomes the window's driver.
+    last_size_in_pixels_ = size_in_pixels;
+    if (!HasValidGrant() || !visible() || Driver(window_id_) != this) {
+      return;
+    }
+    auto* windows = exo::EmbeddedWindows::Get();
+    std::optional<exo::EmbeddedWindows::Info> info =
+        windows->GetInfo(window_id_);
+    if (!info || info->device_scale_factor <= 0) {
+      return;
+    }
+    // EXO-DISPLAYS: the page's pixels in its own display's DIPs. The window
+    // may still be on another display, at another scale, until it is shown
+    // here (SetShown() moves it), and would otherwise get a size in the
+    // wrong DIPs that nothing corrects.
+    content::RenderWidgetHostView* view = render_frame_host().GetView();
+    const float scale = view && view->GetDeviceScaleFactor() > 0
+                            ? view->GetDeviceScaleFactor()
+                            : info->device_scale_factor;
+    windows->SetSize(window_id_, gfx::ToRoundedSize(gfx::ScaleSize(
+                                     gfx::SizeF(size_in_pixels), 1.f / scale)));
+  }
+
+  void SetVisible(bool visible) override {
+    if (element_visible_ == visible) {
+      return;
+    }
+    element_visible_ = visible;
+    if (window_id_) {
+      UpdateDriver(window_id_);
+    }
+  }
+
+  void SetRectInWidget(const gfx::Rect& rect_in_pixels, float scale) override {
+    rect_in_widget_ = rect_in_pixels;
+    scale_ = scale > 0 ? scale : 1.f;
+    UpdateShown(window_id_);
+  }
+
+  void Focus() override {
+    content::RenderWidgetHostView* view = render_frame_host().GetView();
+    if (HasValidGrant() && view && visible() && !taken_) {
+      exo::EmbeddedWindows::Get()->Focus(window_id_, view->GetNativeView());
+    }
+  }
+
+  void Blur() override {
+    if (HasValidGrant() && !taken_) {
+      exo::EmbeddedWindows::Get()->Blur(window_id_);
+    }
+  }
+
+  void OnFullscreenChanged(bool fullscreen) override {
+    if (!HasValidGrant() || fullscreen == fullscreen_) {
+      return;
+    }
+    if (fullscreen && (!visible() || taken_)) {
+      // EXO-SHELLS: a hidden shell doesn't make windows fullscreen.
+      client_->SetFullscreen(false);
+      return;
+    }
+    VLOG(1) << "EXO-FULLSCREEN window #" << window_id_ << "'s element "
+            << (fullscreen ? "entered" : "left") << " fullscreen";
+    fullscreen_ = fullscreen;
+    exo::EmbeddedWindows::Get()->SetFullscreen(window_id_, fullscreen);
+    UpdateDriver(window_id_);
+  }
+
+  // EXO-FULLSCREEN: asks the element to enter or leave fullscreen.
+  void SetElementFullscreen(bool fullscreen) {
+    if (client_ && HasValidGrant()) {
+      client_->SetFullscreen(fullscreen);
+    }
+  }
+  int32_t window_id() const { return window_id_; }
+  content::WebContents* contents() {
+    return content::WebContents::FromRenderFrameHost(&render_frame_host());
+  }
+  const viz::FrameSinkId& frame_sink_id() const { return frame_sink_id_; }
+  bool fullscreen() const { return fullscreen_; }
+  // EXO-DISPLAYS: another page's element took the window; this one gets it
+  // back when its shell is shown, or once no page shows the window.
+  bool taken() const { return taken_; }
+  // Attached and not taken: the window is in this page.
+  bool holds(int32_t window_id) const {
+    return window_id && window_id_ == window_id && !taken_;
+  }
+
+  // Another page's element claimed the window: let go of it, but keep the
+  // grant, to take it back later (Reclaim()).
+  void Take() {
+    if (!window_id_ || taken_) {
+      return;
+    }
+    VLOG(1) << "EXO-DISPLAYS window #" << window_id_ << " taken from frame "
+            << render_frame_host().GetGlobalId();
+    if (focused_) {
+      RestorePageTextInput();
+      focused_ = false;
+    }
+    if (fullscreen_) {
+      fullscreen_ = false;
+      exo::EmbeddedWindows::Get()->SetFullscreen(window_id_, false);
+    }
+    exo::EmbeddedWindows::Get()->Detach(window_id_);
+    if (ExoEmbedder* embedder = ExoEmbedder::Get()) {
+      embedder->UnlinkFrameSinks(parent_frame_sink_id_, frame_sink_id_);
+    }
+    SetTaken();
+    UpdateDriver(window_id_);
+  }
+
+  // Takes the window back (from other pages' elements). False if the grant
+  // is gone or the window can't be embedded here any more.
+  bool Reclaim() {
+    if (!taken_ || !HasValidGrant()) {
+      return false;
+    }
+    auto* windows = exo::EmbeddedWindows::Get();
+    std::optional<exo::EmbeddedWindows::Info> info =
+        windows->GetInfo(window_id_);
+    ExoEmbedder* embedder = ExoEmbedder::Get();
+    content::RenderWidgetHost* widget =
+        render_frame_host().GetRenderWidgetHost();
+    if (!info || !embedder || !widget) {
+      return false;
+    }
+    const viz::FrameSinkId parent = widget->GetFrameSinkId();
+    const viz::FrameSinkId child = windows->GetFrameSinkId(window_id_);
+    if (!child.is_valid() || !embedder->LinkFrameSinks(parent, child)) {
+      return false;
+    }
+    VLOG(1) << "EXO-DISPLAYS window #" << window_id_ << " back in frame "
+            << render_frame_host().GetGlobalId();
+    TakeFromOtherPages();
+    taken_ = false;
+    parent_frame_sink_id_ = parent;
+    frame_sink_id_ = child;
+    windows->Attach(window_id_);
+    focused_ = info->focused;
+    client_->OnInfoChanged(ToMojo(window_id_, *info));
+    UpdateDriver(window_id_);
+    return true;
+  }
+  uint64_t attach_seq() const { return attach_seq_; }
+
+  // EXO-EMBED: whether this element should drive its window rather than
+  // |other|: fullscreen, else the one the user last pressed in, else one on
+  // screen, else the last attached.
+  bool Outranks(const NativeWindowHostImpl& other) const {
+    if (fullscreen_ != other.fullscreen_) {
+      return fullscreen_;
+    }
+    if (last_press_ != other.last_press_) {
+      return last_press_ > other.last_press_;
+    }
+    if (element_visible_ != other.element_visible_) {
+      return element_visible_;
+    }
+    return attach_seq_ > other.attach_seq_;
+  }
+
+  // Whether a press at |point| (DIPs in the root view) is in this element.
+  bool ContainsPoint(const gfx::PointF& point) {
+    content::RenderWidgetHostView* view = render_frame_host().GetView();
+    if (!view || rect_in_widget_.IsEmpty()) {
+      return false;
+    }
+    return gfx::ScaleRect(gfx::RectF(rect_in_widget_),
+                          1.f / view->GetDeviceScaleFactor())
+        .Contains(point);
+  }
+
+  void OnPressed() {
+    last_press_ = base::TimeTicks::Now();
+    UpdateDriver(window_id_);
+  }
+  // EXO-EMBED: where the element's content box is on screen (DIPs), if it's
+  // on screen in the visible shell. The window's frame is drawn from its top
+  // left (object-fit: none, the default), scaled by scale().
+  std::optional<gfx::PointF> ShownOrigin() {
+    if (!window_id_ || taken_ || !element_visible_ ||
+        rect_in_widget_.IsEmpty() || !HasValidGrant() || !visible()) {
+      return std::nullopt;
+    }
+    content::RenderWidgetHostView* view = render_frame_host().GetView();
+    if (!view) {
+      return std::nullopt;
+    }
+    return gfx::ScalePoint(gfx::PointF(rect_in_widget_.origin()),
+                           1.f / view->GetDeviceScaleFactor()) +
+           gfx::Vector2dF(view->GetViewBounds().OffsetFromOrigin());
+  }
+  float scale() const { return scale_; }
+
+  // EXO-SHELLS: whether the element is in the visible shell, which alone
+  // sizes, focuses and fullscreens windows.
+  bool visible() {
+    return plutonium_shell::IsVisibleShell(
+        content::WebContents::FromRenderFrameHost(&render_frame_host()));
+  }
+  // Tells the app whether it is tiled, as the driver shows it.
+  void ApplyFloating() {
+    if (window_id_ && HasValidGrant() && visible() && !taken_ &&
+        Driver(window_id_) == this) {
+      exo::EmbeddedWindows::Get()->SetFloating(window_id_, floating_);
+    }
+  }
+  // Sizes the window as the element last asked, if it's in the visible
+  // shell.
+  void ApplyLastSize() {
+    if (window_id_ && !last_size_in_pixels_.IsEmpty()) {
+      SetSize(last_size_in_pixels_);
+    }
+    ApplyFloating();
+  }
+
+  void SetFloating(bool floating) override {
+    floating_ = floating;
+    ApplyFloating();
+  }
+
+  // EXO-EMBED: whether |point| (DIPs in the root view) is just outside this
+  // floating element's content box, where the app's client-side resize
+  // edges are. Its renderer decides whether the page covers it.
+  bool NearResizeEdge(const gfx::PointF& point) {
+    if (!floating_ || !window_id_ || taken_ || !element_visible_ ||
+        !HasValidGrant() || !visible() || rect_in_widget_.IsEmpty()) {
+      return false;
+    }
+    content::RenderWidgetHostView* view = render_frame_host().GetView();
+    if (!view || view->GetDeviceScaleFactor() <= 0) {
+      return false;
+    }
+    gfx::RectF box = gfx::ScaleRect(gfx::RectF(rect_in_widget_),
+                                    1.f / view->GetDeviceScaleFactor());
+    gfx::RectF edges = box;
+    // A pixel more: the renderer has the exact geometry.
+    edges.Outset(blink::mojom::kResizeEdgeMargin * scale_ + 1);
+    return edges.Contains(point) && !box.Contains(point);
+  }
+  const viz::FrameSinkId& parent_frame_sink_id() const {
+    return parent_frame_sink_id_;
+  }
+
+  // exo::EmbeddedWindows::Observer:
+  void OnEmbeddedWindowChanged(int32_t window_id) override {
+    // A taken window isn't this element's to show.
+    if (window_id != window_id_ || !client_ || taken_) {
+      return;
+    }
+    if (std::optional<exo::EmbeddedWindows::Info> info =
+            exo::EmbeddedWindows::Get()->GetInfo(window_id)) {
+      if (focused_ && !info->focused) {
+        RestorePageTextInput();
+      }
+      focused_ = info->focused;
+      client_->OnInfoChanged(ToMojo(window_id_, *info));
+    }
+  }
+
+  void OnEmbeddedWindowFullscreenRequested(int32_t window_id,
+                                           bool fullscreen) override {
+    // One element acts: the window's driver.
+    if (window_id != window_id_ || !client_ || taken_ ||
+        Driver(window_id) != this) {
+      return;
+    }
+    SetElementFullscreen(fullscreen);
+  }
+
+  void OnEmbeddedWindowRequested(int32_t window_id,
+                                 exo::EmbeddedWindows::Request request,
+                                 int component) override {
+    if (window_id != window_id_ || !client_ || !HasValidGrant() ||
+        Driver(window_id) != this) {
+      return;
+    }
+    // EXO-EMBED: an interactive move or resize is the page's to do: it gets
+    // the pointer for the rest of the drag.
+    if (request == exo::EmbeddedWindows::Request::kMove ||
+        request == exo::EmbeddedWindows::Request::kResize) {
+      input::RenderWidgetHostInputEventRouter::HandForeignDragToPage(
+          frame_sink_id_);
+    }
+    client_->OnRequest(ToMojo(request), ToEdges(component));
+  }
+
+  // The broker revokes the window's grants when it is destroyed, which
+  // closes this host through OnGrantRevoked(). Both the broker and this host
+  // observe exo::EmbeddedWindows, in no particular order, so handle the
+  // window going away here too.
+  void OnEmbeddedWindowDestroyed(int32_t window_id) override {
+    if (window_id == window_id_) {
+      Close("window destroyed");
+    }
+  }
+
+  // ExoWindowBroker::Observer:
+  void OnGrantRevoked(const base::UnguessableToken& grant,
+                      int32_t window_id,
+                      content::GlobalRenderFrameHostId frame) override {
+    if (window_id_ && grant == grant_) {
+      Close("grant revoked");
+    }
+  }
+
+ private:
+  void SetTaken() {
+    taken_ = true;
+    if (client_) {
+      client_->OnTaken();
+    }
+  }
+
+  // Whether another page's element in the visible shell (on its display)
+  // holds the window.
+  bool IsHeldByVisiblePage() {
+    for (NativeWindowHostImpl* host : Hosts()) {
+      if (host != this && host->holds(window_id_) &&
+          host->contents() != contents() && host->visible()) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // Takes the window from every other page's elements.
+  void TakeFromOtherPages() {
+    for (NativeWindowHostImpl* host :
+         std::vector<NativeWindowHostImpl*>(Hosts())) {
+      if (host != this && host->holds(window_id_) &&
+          host->contents() != contents()) {
+        host->Take();
+      }
+    }
+  }
+
+  // Whether this host is attached and its grant is still valid for this
+  // document and window. Revocation detaches the host, so this only fails
+  // if that went wrong; it is checked anyway before acting on the window.
+  bool HasValidGrant() {
+    ExoWindowBroker* broker = ExoWindowBroker::Get();
+    return window_id_ && broker &&
+           broker->ValidateGrant(grant_, &render_frame_host(), window_id_);
+  }
+
+  // Detaches and tells the element the window is gone.
+  void Close(const char* reason) {
+    if (!window_id_) {
+      return;
+    }
+    VLOG(1) << "EXO-BROKER detach: window #" << window_id_ << " from frame "
+            << render_frame_host().GetGlobalId() << " (" << reason << ")";
+    if (focused_) {
+      RestorePageTextInput();
+    }
+    if (client_) {
+      client_->OnClosed();
+    }
+    DoDetach();
+  }
+
+  // A window using text input takes the browser window's input method and
+  // drops it when it loses keyboard focus. The page's view never lost aura
+  // focus, so it would not take it back by itself: hand it back unless
+  // another text input has it.
+  void RestorePageTextInput() {
+    content::RenderWidgetHostView* view =
+        render_frame_host().GetOutermostMainFrame()->GetView();
+    if (!view || !view->HasFocus() || !view->GetNativeView() ||
+        !view->GetNativeView()->GetHost()) {
+      return;
+    }
+    ui::InputMethod* input_method =
+        view->GetNativeView()->GetHost()->GetInputMethod();
+    if (input_method && !input_method->GetTextInputClient() &&
+        view->GetTextInputClient()) {
+      input_method->SetFocusedTextInputClient(view->GetTextInputClient());
+    }
+  }
+
+  void DoDetach() {
+    if (!window_id_) {
+      return;
+    }
+    if (fullscreen_) {
+      fullscreen_ = false;
+      exo::EmbeddedWindows::Get()->SetFullscreen(window_id_, false);
+    }
+    const int32_t window_id = window_id_;
+    const bool held = !taken_;
+    if (held) {
+      exo::EmbeddedWindows::Get()->Detach(window_id_);
+      if (ExoEmbedder* embedder = ExoEmbedder::Get()) {
+        embedder->UnlinkFrameSinks(parent_frame_sink_id_, frame_sink_id_);
+      }
+    }
+    taken_ = false;
+    client_.reset();
+    grant_ = base::UnguessableToken();
+    window_id_ = 0;
+    focused_ = false;
+    parent_frame_sink_id_ = viz::FrameSinkId();
+    frame_sink_id_ = viz::FrameSinkId();
+    last_press_ = base::TimeTicks();
+    UpdateDriver(window_id);
+    // EXO-DISPLAYS: a window no page shows any more goes back to an element
+    // it was taken from.
+    if (held) {
+      ReclaimFreed(window_id);
+    }
+  }
+
+  base::UnguessableToken grant_;
+  int32_t window_id_ = 0;
+  gfx::Size last_size_in_pixels_;
+  bool focused_ = false;
+  // EXO-FULLSCREEN: whether the element is its document's fullscreen
+  // element.
+  bool fullscreen_ = false;
+  // Whether the page shows the window floating (SetFloating()).
+  bool floating_ = false;
+  // EXO-DISPLAYS: see taken().
+  bool taken_ = false;
+  // EXO-EMBED: what decides which element drives the window (Outranks()).
+  base::TimeTicks last_press_;
+  bool element_visible_ = true;
+  uint64_t attach_seq_ = 0;
+  gfx::Rect rect_in_widget_;
+  float scale_ = 1.f;
+  viz::FrameSinkId parent_frame_sink_id_;
+  viz::FrameSinkId frame_sink_id_;
+  mojo::Remote<blink::mojom::NativeWindowClient> client_;
+};
+
+NativeWindowHostImpl* Driver(int32_t window_id) {
+  NativeWindowHostImpl* driver = nullptr;
+  for (NativeWindowHostImpl* host : Hosts()) {
+    // EXO-SHELLS: only the visible shell sizes windows.
+    if (host->holds(window_id) && host->visible() &&
+        (!driver || host->Outranks(*driver))) {
+      driver = host;
+    }
+  }
+  return driver;
+}
+
+// Recomputes |window_id|'s driver; a new one sizes the window as it last
+// asked.
+void UpdateDriver(int32_t window_id) {
+  if (!window_id) {
+    return;
+  }
+  UpdateShown(window_id);
+  NativeWindowHostImpl* driver = Driver(window_id);
+  auto it = Drivers().find(window_id);
+  NativeWindowHostImpl* old = it == Drivers().end() ? nullptr : it->second;
+  if (driver == old) {
+    return;
+  }
+  if (driver) {
+    Drivers()[window_id] = driver;
+    driver->ApplyLastSize();
+  } else {
+    Drivers().erase(window_id);
+  }
+}
+
+// EXO-EMBED: tells Exo whether a page shows |window_id|, and where: at its
+// driver's element if that's on screen, else at any element on screen.
+void UpdateShown(int32_t window_id) {
+  if (!window_id) {
+    return;
+  }
+  NativeWindowHostImpl* shown = Driver(window_id);
+  std::optional<gfx::PointF> origin;
+  if (shown) {
+    origin = shown->ShownOrigin();
+  }
+  for (NativeWindowHostImpl* host : Hosts()) {
+    if (origin) {
+      break;
+    }
+    if (host->window_id() == window_id) {
+      shown = host;
+      origin = host->ShownOrigin();
+    }
+  }
+  exo::EmbeddedWindows::Get()->SetShown(window_id, origin,
+                                        origin ? shown->scale() : 1.f);
+}
+
+// EXO-DISPLAYS: if no element holds |window_id|, the visible shell's
+// elements it was taken from (the page that attached it last) get it back.
+void ReclaimFreed(int32_t window_id) {
+  NativeWindowHostImpl* newest = nullptr;
+  for (NativeWindowHostImpl* host : Hosts()) {
+    if (host->holds(window_id)) {
+      return;
+    }
+    if (host->window_id() == window_id && host->taken() && host->visible() &&
+        (!newest || host->attach_seq() > newest->attach_seq())) {
+      newest = host;
+    }
+  }
+  if (!newest) {
+    return;
+  }
+  content::WebContents* page = newest->contents();
+  for (NativeWindowHostImpl* host :
+       std::vector<NativeWindowHostImpl*>(Hosts())) {
+    if (host->window_id() == window_id && host->taken() &&
+        host->contents() == page) {
+      host->Reclaim();
+    }
+  }
+}
+
+}  // namespace
+
+ExoEmbedder::ExoEmbedder() {
+  DCHECK(!g_instance);
+  g_instance = this;
+  input::RenderWidgetHostInputEventRouter::SetForeignFrameSinkDelegate(this);
+  exo::EmbeddedWindows::Get()->SetCursorCallback(base::BindRepeating(
+      &input::RenderWidgetHostInputEventRouter::SetForeignFrameSinkCursor));
+}
+
+ExoEmbedder::~ExoEmbedder() {
+  exo::EmbeddedWindows::Get()->SetCursorCallback({});
+  input::RenderWidgetHostInputEventRouter::SetForeignFrameSinkDelegate(nullptr);
+  for (const auto& [link, count] : links_) {
+    GetHostFrameSinkManager()->UnregisterFrameSinkHierarchy(link.first,
+                                                           link.second);
+  }
+  g_instance = nullptr;
+}
+
+// static
+ExoEmbedder* ExoEmbedder::Get() {
+  return g_instance;
+}
+
+// static
+void ExoEmbedder::BindNativeWindowHost(
+    content::RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<blink::mojom::NativeWindowHost> receiver) {
+  if (!g_instance || !ExoWindowBroker::Get()) {
+    return;
+  }
+  // EXO-BROKER: any frame may bind the host (so refusals reach the element
+  // as "windowerror"), but only the shell document can attach, and only with
+  // a grant the broker issued to it (see NativeWindowHostImpl).
+  new NativeWindowHostImpl(*render_frame_host, std::move(receiver));
+}
+
+bool ExoEmbedder::ToggleFullscreen(int32_t window_id) {
+  // The driver: the fullscreen element if there is one.
+  NativeWindowHostImpl* target = Driver(window_id);
+  if (!target) {
+    return false;
+  }
+  target->SetElementFullscreen(!target->fullscreen());
+  return true;
+}
+
+bool ExoEmbedder::ExitFullscreen(content::WebContents* page) {
+  bool any = false;
+  for (NativeWindowHostImpl* host : Hosts()) {
+    if (host->fullscreen() &&
+        (!page || host->contents()->GetOutermostWebContents() == page)) {
+      host->SetElementFullscreen(false);
+      any = true;
+    }
+  }
+  return any;
+}
+
+void ExoEmbedder::OnVisibleShellChanged() {
+  // EXO-DISPLAYS: the newly visible shell's elements take back the windows
+  // taken from them, unless another display's visible shell shows them.
+  std::vector<content::WebContents*> reclaimed;
+  for (NativeWindowHostImpl* host :
+       std::vector<NativeWindowHostImpl*>(Hosts())) {
+    if (!host->taken() || !host->visible() ||
+        std::ranges::contains(reclaimed, host->contents())) {
+      continue;
+    }
+    const int32_t window_id = host->window_id();
+    const bool shown_elsewhere = std::ranges::any_of(
+        Hosts(), [&](NativeWindowHostImpl* other) {
+          return other->holds(window_id) && other->visible() &&
+                 other->contents() != host->contents();
+        });
+    if (!shown_elsewhere) {
+      host->Reclaim();
+    }
+  }
+  // Every window's driver may have changed; size each window as its driver
+  // last asked.
+  Drivers().clear();
+  std::vector<int32_t> window_ids;
+  for (NativeWindowHostImpl* host : Hosts()) {
+    window_ids.push_back(host->window_id());
+  }
+  for (int32_t window_id : window_ids) {
+    UpdateDriver(window_id);
+  }
+}
+
+std::vector<content::WebContents*> ExoEmbedder::GetEmbedders(
+    int32_t window_id) const {
+  std::vector<content::WebContents*> pages;
+  if (!window_id) {
+    return pages;
+  }
+  for (NativeWindowHostImpl* host : Hosts()) {
+    // EXO-DISPLAYS: not pages another page took it from.
+    if (!host->holds(window_id)) {
+      continue;
+    }
+    content::WebContents* contents = host->contents();
+    if (contents && !std::ranges::contains(pages, contents)) {
+      pages.push_back(contents);
+    }
+  }
+  return pages;
+}
+
+bool ExoEmbedder::LinkFrameSinks(const viz::FrameSinkId& parent,
+                                 const viz::FrameSinkId& child) {
+  auto link = std::make_pair(parent, child);
+  auto it = links_.find(link);
+  if (it != links_.end()) {
+    ++it->second;
+    return true;
+  }
+  if (!GetHostFrameSinkManager()->RegisterFrameSinkHierarchy(parent, child)) {
+    return false;
+  }
+  links_[link] = 1;
+  return true;
+}
+
+void ExoEmbedder::UnlinkFrameSinks(const viz::FrameSinkId& parent,
+                                   const viz::FrameSinkId& child) {
+  auto it = links_.find(std::make_pair(parent, child));
+  if (it == links_.end() || --it->second > 0) {
+    return;
+  }
+  links_.erase(it);
+  GetHostFrameSinkManager()->UnregisterFrameSinkHierarchy(parent, child);
+}
+
+bool ExoEmbedder::IsEmbeddedIn(const viz::FrameSinkId& frame_sink_id,
+                               const viz::FrameSinkId& parent_frame_sink_id) {
+  return links_.contains(std::make_pair(parent_frame_sink_id, frame_sink_id));
+}
+
+void ExoEmbedder::RouteMouseEvent(const viz::FrameSinkId& frame_sink_id,
+                                  const gfx::PointF& location,
+                                  const blink::WebMouseEvent& event) {
+  // EXO-EMBED: the element the user pressed in drives the window. The
+  // window's frame sink alone doesn't say which element showing it was
+  // hit; their rects do (the newest wins where they overlap).
+  if (event.GetType() == blink::WebInputEvent::Type::kMouseDown) {
+    for (NativeWindowHostImpl* host : base::Reversed(Hosts())) {
+      if (host->frame_sink_id() == frame_sink_id && !host->taken() &&
+          host->visible() &&
+          host->ContainsPoint(event.PositionInWidget())) {
+        host->OnPressed();
+        break;
+      }
+    }
+  }
+  std::unique_ptr<ui::MouseEvent> mouse_event = ToMouseEvent(event);
+  if (!mouse_event) {
+    return;
+  }
+  exo::EmbeddedWindows::Get()->DispatchMouseEvent(
+      frame_sink_id, location, event.PositionInScreen(),
+      std::move(mouse_event));
+}
+
+bool ExoEmbedder::NearResizeEdge(const viz::FrameSinkId& parent_frame_sink_id,
+                                 const gfx::PointF& point) {
+  for (NativeWindowHostImpl* host : Hosts()) {
+    if (host->parent_frame_sink_id() == parent_frame_sink_id &&
+        host->NearResizeEdge(point)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void ExoEmbedder::PointerLeft(const viz::FrameSinkId& frame_sink_id) {
+  exo::EmbeddedWindows::Get()->PointerLeave(frame_sink_id);
+}
+
+void ExoEmbedder::PageMouseDown() {
+  exo::EmbeddedWindows::Get()->ClearFocus();
+}
