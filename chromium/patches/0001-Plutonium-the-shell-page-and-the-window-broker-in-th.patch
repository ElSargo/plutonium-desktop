+  EXPECT_FALSE(WasLogged("not embeddable"));
+}
+
+TEST_F(PlutoniumAttachTest, StolenShellGrantInAnotherPage) {
+  std::optional<base::UnguessableToken> grant =
+      broker()->IssueGrant(main_rfh(), kWindow);
+  ASSERT_TRUE(grant);
+  // Another page on the shell origin (a top-level page there is a shell
+  // document outside shell mode): the grant is still the first page's.
+  std::unique_ptr<content::WebContents> other = CreateTestWebContents();
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(other.get(),
+                                                             GURL(kShellUrl));
+  EXPECT_FALSE(Attach(other->GetPrimaryMainFrame(), *grant, kWindow));
+  EXPECT_TRUE(WasLogged("attach refused: no valid grant"));
+}
+
+// What a compromised renderer can send without attaching: the host acts on
+// no window.
+TEST_F(PlutoniumAttachTest, UnattachedHostDoesNothing) {
+  mojo::Remote<blink::mojom::NativeWindowHost> host;
+  ExoEmbedder::BindNativeWindowHost(main_rfh(),
+                                    host.BindNewPipeAndPassReceiver());
+  host->Focus();
+  host->SetVisible(true);
+  host->SetSize(gfx::Size(800, 600));
+  host->OnFullscreenChanged(true);
+  host->Blur();
+  host->Detach();
+  host.FlushForTesting();
+  EXPECT_TRUE(host.is_connected());
+  EXPECT_EQ(0, exo::EmbeddedWindows::Get()->focused_window_id());
+  EXPECT_FALSE(exo::EmbeddedWindows::Get()->IsAttached(kWindow));
+  EXPECT_FALSE(WasLogged("EXO-FULLSCREEN"));
+}
