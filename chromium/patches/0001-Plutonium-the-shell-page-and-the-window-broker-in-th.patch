+  void OnGrantRevoked(const base::UnguessableToken& grant,
+                      int32_t window_id,
+                      content::GlobalRenderFrameHostId frame) override {
+    // Only this document's grants. Grants are issued to the current
+    // document, and a document's grants are revoked when it goes away, so
+    // a grant for this frame is this document's.
+    if (frame != render_frame_host().GetGlobalId() || observers_.empty() ||
+        !StillShell()) {
+      return;
+    }
+    for (auto& observer : observers_) {
+      observer->OnGrantRevoked(grant, window_id);
+    }
+  }
