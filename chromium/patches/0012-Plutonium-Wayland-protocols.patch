+////////////////////////////////////////////////////////////////////////////////
+// text_input_v3 interface:
+
+// Plutonium: zwp_text_input_v3 (GTK 4, Qt 6, foot) on the same TextInput as
+// v1. The client enables text input on the surface it was told it entered,
+// and its state is double-buffered until commit. Each change from the IME is
+// sent as its events followed by done, whose serial is the number of commits.
+class WaylandTextInputV3Delegate : public TextInput::Delegate,
+                                   public SeatObserver,
+                                   public SurfaceObserver {
+ public:
+  WaylandTextInputV3Delegate(wl_resource* text_input, Seat* seat)
+      : text_input_(text_input), seat_(seat->GetWeakPtr()) {
+    seat_->AddObserver(this, kTextInputV3SeatObserverPriority);
+  }
+  WaylandTextInputV3Delegate(const WaylandTextInputV3Delegate&) = delete;
+  WaylandTextInputV3Delegate& operator=(const WaylandTextInputV3Delegate&) =
+      delete;
+  ~WaylandTextInputV3Delegate() override {
+    SetEnteredSurface(nullptr);
+    if (seat_) {
+      seat_->RemoveObserver(this);
+    }
+  }
+
+  void set_text_input(TextInput* text_input) {
+    text_input_object_ = text_input;
+    // The client may create its text input while it already has keyboard
+    // focus.
+    if (seat_) {
+      OnSurfaceFocused(seat_->GetFocusedSurface(), nullptr, true);
+    }
+  }
+
+  void Enable() {
+    // Enabling resets all state from earlier requests.
+    pending_enabled_ = true;
+    pending_surrounding_text_.reset();
+    pending_content_type_ = std::make_pair(
+        static_cast<uint32_t>(ZWP_TEXT_INPUT_V3_CONTENT_HINT_NONE),
+        static_cast<uint32_t>(ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_NORMAL));
+    pending_cursor_rectangle_.reset();
+  }
+
+  void Disable() { pending_enabled_ = false; }
+
+  void SetPendingSurroundingText(std::string text,
+                                 int32_t cursor,
+                                 int32_t anchor) {
+    pending_surrounding_text_.emplace(std::move(text), cursor, anchor);
+  }
+
+  void SetPendingContentType(uint32_t hint, uint32_t purpose) {
+    pending_content_type_ = std::make_pair(hint, purpose);
+  }
+
+  void SetPendingCursorRectangle(const gfx::Rect& rect) {
+    pending_cursor_rectangle_ = rect;
+  }
+
+  void CommitState() {
+    ++commit_count_;
+    const bool was_enabled = enabled_;
+    enabled_ = pending_enabled_ && entered_surface_ && seat_;
+    if (!enabled_) {
+      if (was_enabled) {
+        text_input_object_->Deactivate();
+      }
+      return;
+    }
+    if (!was_enabled) {
+      text_input_object_->Activate(seat_.get(), entered_surface_,
+                                   ui::TextInputClient::FOCUS_REASON_OTHER);
+    }
+    if (pending_content_type_) {
+      SetContentType(pending_content_type_->first,
+                     pending_content_type_->second);
+      pending_content_type_.reset();
+    }
+    if (pending_surrounding_text_) {
+      const auto& [text, cursor, anchor] = *pending_surrounding_text_;
+      SetSurroundingText(text, cursor, anchor);
+      pending_surrounding_text_.reset();
+    }
+    if (pending_cursor_rectangle_) {
+      text_input_object_->SetCaretBounds(*pending_cursor_rectangle_);
+      pending_cursor_rectangle_.reset();
+    }
+  }
+
+ private:
+  static constexpr int kTextInputV3SeatObserverPriority = 1;
+
+  wl_client* client() { return wl_resource_get_client(text_input_); }
+
+  void SetEnteredSurface(Surface* surface) {
+    if (entered_surface_) {
+      entered_surface_->RemoveSurfaceObserver(this);
+    }
+    entered_surface_ = surface;
+    if (entered_surface_) {
+      entered_surface_->AddSurfaceObserver(this);
+    }
+  }
+
+  void SetSurroundingText(std::string_view text,
+                          int32_t cursor,
+                          int32_t anchor) {
+    if (cursor < 0 || anchor < 0) {
+      return;
+    }
+    auto minmax = std::minmax(cursor, anchor);
+    std::vector<size_t> offsets{static_cast<size_t>(minmax.first),
+                                static_cast<size_t>(minmax.second)};
+    std::u16string u16_text = base::UTF8ToUTF16AndAdjustOffsets(text, &offsets);
+    if (offsets[0] == std::u16string::npos ||
+        offsets[1] == std::u16string::npos) {
+      return;
+    }
+    text_input_object_->SetSurroundingText(u16_text, 0u,
+                                           gfx::Range(offsets[0], offsets[1]),
+                                           std::nullopt, std::nullopt);
+  }
+
+  void SetContentType(uint32_t hint, uint32_t purpose) {
+    ui::TextInputType type = ui::TEXT_INPUT_TYPE_TEXT;
+    ui::TextInputMode mode = ui::TEXT_INPUT_MODE_DEFAULT;
+    int flags = ui::TEXT_INPUT_FLAG_NONE;
+    bool should_do_learning = true;
+    if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_COMPLETION) {
+      flags |= ui::TEXT_INPUT_FLAG_AUTOCOMPLETE_ON;
+    }
+    if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_SPELLCHECK) {
+      flags |= ui::TEXT_INPUT_FLAG_SPELLCHECK_ON;
+    }
+    if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_AUTO_CAPITALIZATION) {
+      flags |= ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_SENTENCES;
+    }
+    if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_LOWERCASE) {
+      flags |= ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_NONE;
+    }
+    if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_UPPERCASE) {
+      flags |= ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_CHARACTERS;
+    }
+    if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_TITLECASE) {
+      flags |= ui::TEXT_INPUT_FLAG_AUTOCAPITALIZE_WORDS;
+    }
+    if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_HIDDEN_TEXT) {
+      flags |= ui::TEXT_INPUT_FLAG_AUTOCOMPLETE_OFF |
+               ui::TEXT_INPUT_FLAG_AUTOCORRECT_OFF;
+    }
+    if (hint & ZWP_TEXT_INPUT_V3_CONTENT_HINT_SENSITIVE_DATA) {
+      should_do_learning = false;
+    }
+    // Unused hints: LATIN, MULTILINE.
+
+    switch (purpose) {
+      case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_DIGITS:
+        mode = ui::TEXT_INPUT_MODE_DECIMAL;
+        type = ui::TEXT_INPUT_TYPE_NUMBER;
+        break;
+      case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_NUMBER:
+        mode = ui::TEXT_INPUT_MODE_NUMERIC;
+        type = ui::TEXT_INPUT_TYPE_NUMBER;
+        break;
+      case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_PIN:
+        should_do_learning = false;
+        mode = ui::TEXT_INPUT_MODE_NUMERIC;
+        type = ui::TEXT_INPUT_TYPE_NUMBER;
+        break;
+      case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_PHONE:
+        mode = ui::TEXT_INPUT_MODE_TEL;
+        type = ui::TEXT_INPUT_TYPE_TELEPHONE;
+        break;
+      case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_URL:
+        mode = ui::TEXT_INPUT_MODE_URL;
+        type = ui::TEXT_INPUT_TYPE_URL;
+        break;
+      case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_EMAIL:
+        mode = ui::TEXT_INPUT_MODE_EMAIL;
+        type = ui::TEXT_INPUT_TYPE_EMAIL;
+        break;
+      case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_PASSWORD:
+        should_do_learning = false;
+        type = ui::TEXT_INPUT_TYPE_PASSWORD;
+        break;
+      case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_DATE:
+        type = ui::TEXT_INPUT_TYPE_DATE;
+        break;
+      case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_TIME:
+        type = ui::TEXT_INPUT_TYPE_TIME;
+        break;
+      case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_DATETIME:
+        type = ui::TEXT_INPUT_TYPE_DATE_TIME;
+        break;
+      default:
+        // NORMAL, ALPHA, NAME, TERMINAL: no special type / mode are set.
+        break;
+    }
+
+    text_input_object_->SetTypeModeFlags(type, mode, flags, should_do_learning,
+                                         /*can_compose_inline=*/true,
+                                         /*surrounding_text_supported=*/true);
+  }
+
+  void SendDone() {
+    zwp_text_input_v3_send_done(text_input_, commit_count_);
+    wl_client_flush(client());
+  }
+
+  // SeatObserver:
+  void OnSurfaceFocused(Surface* gained_focus,
+                        Surface* lost_focus,
+                        bool has_focused_client) override {
+    if (gained_focus == entered_surface_) {
+      return;
+    }
+    if (entered_surface_) {
+      if (wl_resource* surface = GetSurfaceResource(entered_surface_)) {
+        zwp_text_input_v3_send_leave(text_input_, surface);
+      }
+      SetEnteredSurface(nullptr);
+      enabled_ = false;
+    }
+    wl_resource* surface =
+        gained_focus ? GetSurfaceResource(gained_focus) : nullptr;
+    if (surface && wl_resource_get_client(surface) == client()) {
+      SetEnteredSurface(gained_focus);
+      zwp_text_input_v3_send_enter(text_input_, surface);
+    }
+    wl_client_flush(client());
+  }
+
+  // SurfaceObserver:
+  void OnSurfaceDestroying(Surface* surface) override {
+    DCHECK_EQ(surface, entered_surface_);
+    SetEnteredSurface(nullptr);
+    enabled_ = false;
+  }
+
+  // TextInput::Delegate:
+  // enter and leave follow keyboard focus, not the input method.
+  void Activated() override {}
+  void Deactivated() override {}
+  void OnVirtualKeyboardVisibilityChanged(bool is_visible) override {}
+  void OnVirtualKeyboardOccludedBoundsChanged(
+      const gfx::Rect& screen_bounds) override {}
+  bool SupportsFinalizeVirtualKeyboardChanges() override { return false; }
+
+  void SetCompositionText(const ui::CompositionText& composition) override {
+    std::vector<size_t> offsets = {composition.selection.start(),
+                                   composition.selection.end()};
+    const std::string utf8 =
+        base::UTF16ToUTF8AndAdjustOffsets(composition.text, &offsets);
+    int32_t cursor_begin = -1;
+    int32_t cursor_end = -1;
+    if (!utf8.empty() && offsets[0] != std::string::npos &&
+        offsets[1] != std::string::npos) {
+      auto minmax = std::minmax(offsets[0], offsets[1]);
+      cursor_begin = static_cast<int32_t>(minmax.first);
+      cursor_end = static_cast<int32_t>(minmax.second);
+    }
+    zwp_text_input_v3_send_preedit_string(text_input_,
+                                          utf8.empty() ? nullptr : utf8.c_str(),
+                                          cursor_begin, cursor_end);
+    SendDone();
+  }
+
+  void Commit(std::u16string_view text) override {
+    zwp_text_input_v3_send_commit_string(text_input_,
+                                         base::UTF16ToUTF8(text).c_str());
+    SendDone();
+  }
+
+  // v3 has no event for moving the cursor.
+  void SetCursor(std::u16string_view surrounding_text,
+                 const gfx::Range& selection) override {}
+
+  void DeleteSurroundingText(std::u16string_view surrounding_text,
+                             const gfx::Range& range) override {
+    // v3 counts the bytes to delete before and after the selection.
+    gfx::Range selection;
+    if (!text_input_object_->GetEditableSelectionRange(&selection)) {
+      return;
+    }
+    std::vector<size_t> offsets{range.GetMin(), range.GetMax(),
+                                selection.GetMin(), selection.GetMax()};
+    base::UTF16ToUTF8AndAdjustOffsets(surrounding_text, &offsets);
+    if (std::ranges::contains(offsets, std::string::npos) ||
+        offsets[0] > offsets[2] || offsets[1] < offsets[3]) {
+      return;
+    }
+    zwp_text_input_v3_send_delete_surrounding_text(
+        text_input_, static_cast<uint32_t>(offsets[2] - offsets[0]),
+        static_cast<uint32_t>(offsets[1] - offsets[3]));
+    SendDone();
+  }
+
+  void SendKey(const ui::KeyEvent& event) override {
+    // v3 has no key events: a key the IME consumed but passed on as a
+    // character arrives as committed text.
+    char16_t character = event.GetCharacter();
+    if (character < 0x20 || character == 0x7f) {
+      return;
+    }
+    if (event.type() != ui::EventType::kKeyPressed) {
+      return;
+    }
+    Commit(std::u16string(1u, character));
+  }
+
+  void OnTextDirectionChanged(base::i18n::TextDirection direction) override {}
+
+  void SetCompositionFromExistingText(
+      std::u16string_view surrounding_text,
+      const gfx::Range& cursor,
+      const gfx::Range& range,
+      const std::vector<ui::ImeTextSpan>& ui_ime_text_spans) override {}
+
+  void ClearGrammarFragments(std::u16string_view surrounding_text,
+                             const gfx::Range& range) override {}
+
+  void AddGrammarFragment(std::u16string_view surrounding_text,
+                          const ui::GrammarFragment& fragment) override {}
+
+  void SetAutocorrectRange(std::u16string_view surrounding_text,
+                           const gfx::Range& range) override {}
+
+  bool ConfirmComposition(bool keep_selection) override { return false; }
+
+  bool SupportsConfirmPreedit() override { return false; }
+
+  bool HasImageInsertSupport() override { return false; }
+
+  void InsertImage(const GURL& src) override {}
+
+  raw_ptr<wl_resource, DanglingUntriaged> text_input_;
+  raw_ptr<TextInput> text_input_object_ = nullptr;
+  base::WeakPtr<Seat> seat_;
+  raw_ptr<Surface> entered_surface_ = nullptr;
+
+  // Number of commit requests, the serial of done events.
+  uint32_t commit_count_ = 0;
+  bool enabled_ = false;
+
+  // Double-buffered state, applied on commit.
+  bool pending_enabled_ = false;
+  std::optional<std::tuple<std::string, int32_t, int32_t>>
+      pending_surrounding_text_;
+  std::optional<std::pair<uint32_t, uint32_t>> pending_content_type_;
+  std::optional<gfx::Rect> pending_cursor_rectangle_;
+};
+
+WaylandTextInputV3Delegate* GetTextInputV3Delegate(wl_resource* resource) {
+  return static_cast<WaylandTextInputV3Delegate*>(
+      GetUserDataAs<TextInput>(resource)->delegate());
+}
+
+void text_input_v3_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void text_input_v3_enable(wl_client* client, wl_resource* resource) {
+  GetTextInputV3Delegate(resource)->Enable();
+}
+
+void text_input_v3_disable(wl_client* client, wl_resource* resource) {
+  GetTextInputV3Delegate(resource)->Disable();
+}
+
+void text_input_v3_set_surrounding_text(wl_client* client,
+                                        wl_resource* resource,
+                                        const char* text,
+                                        int32_t cursor,
+                                        int32_t anchor) {
+  GetTextInputV3Delegate(resource)->SetPendingSurroundingText(text, cursor,
+                                                              anchor);
+}
+
+void text_input_v3_set_text_change_cause(wl_client* client,
+                                         wl_resource* resource,
+                                         uint32_t cause) {
+  // Nothing needs to be done.
+}
+
+void text_input_v3_set_content_type(wl_client* client,
+                                    wl_resource* resource,
+                                    uint32_t hint,
+                                    uint32_t purpose) {
+  GetTextInputV3Delegate(resource)->SetPendingContentType(hint, purpose);
+}
+
+void text_input_v3_set_cursor_rectangle(wl_client* client,
+                                        wl_resource* resource,
+                                        int32_t x,
+                                        int32_t y,
+                                        int32_t width,
+                                        int32_t height) {
+  GetTextInputV3Delegate(resource)->SetPendingCursorRectangle(
+      gfx::Rect(x, y, width, height));
+}
+
+void text_input_v3_commit(wl_client* client, wl_resource* resource) {
+  GetTextInputV3Delegate(resource)->CommitState();
+}
+
+void text_input_v3_set_available_actions(wl_client* client,
+                                         wl_resource* resource,
+                                         wl_array* available_actions) {
+  // Version 2; not advertised.
+}
+
+void text_input_v3_show_input_panel(wl_client* client, wl_resource* resource) {
+  GetUserDataAs<TextInput>(resource)->ShowVirtualKeyboardIfEnabled();
+}
+
+void text_input_v3_hide_input_panel(wl_client* client, wl_resource* resource) {
+  GetUserDataAs<TextInput>(resource)->HideVirtualKeyboard();
+}
+
+constexpr struct zwp_text_input_v3_interface text_input_v3_implementation = {
+    text_input_v3_destroy,
+    text_input_v3_enable,
+    text_input_v3_disable,
+    text_input_v3_set_surrounding_text,
+    text_input_v3_set_text_change_cause,
+    text_input_v3_set_content_type,
+    text_input_v3_set_cursor_rectangle,
+    text_input_v3_commit,
+    text_input_v3_set_available_actions,
+    text_input_v3_show_input_panel,
+    text_input_v3_hide_input_panel,
+};
+
+////////////////////////////////////////////////////////////////////////////////
+// text_input_manager_v3 interface:
+
+void text_input_manager_v3_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void text_input_manager_v3_get_text_input(wl_client* client,
+                                          wl_resource* resource,
+                                          uint32_t id,
+                                          wl_resource* seat_resource) {
+  Seat* seat = GetUserDataAs<WaylandSeat>(seat_resource)->seat;
+  wl_resource* text_input_resource =
+      wl_resource_create(client, &zwp_text_input_v3_interface,
+                         wl_resource_get_version(resource), id);
+
+  auto delegate =
+      std::make_unique<WaylandTextInputV3Delegate>(text_input_resource, seat);
+  auto* delegate_ptr = delegate.get();
+  auto text_input = std::make_unique<TextInput>(std::move(delegate));
+  auto* text_input_ptr = text_input.get();
+  SetImplementation(text_input_resource, &text_input_v3_implementation,
+                    std::move(text_input));
+  delegate_ptr->set_text_input(text_input_ptr);
+}
+
+constexpr struct zwp_text_input_manager_v3_interface
+    text_input_manager_v3_implementation = {
+        text_input_manager_v3_destroy,
+        text_input_manager_v3_get_text_input,
+};
