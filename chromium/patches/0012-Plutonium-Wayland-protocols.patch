diff --git a/components/exo/wayland/xdg_activation.cc b/components/exo/wayland/xdg_activation.cc
new file mode 100644
index 0000000000..eb7edc4261
--- /dev/null
+++ b/components/exo/wayland/xdg_activation.cc
@@ -0,0 +1,176 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/exo/wayland/xdg_activation.h"
+
+#include <wayland-server-core.h>
+#include <wayland-server-protocol-core.h>
+#include <xdg-activation-v1-server-protocol.h>
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+#include "components/exo/display.h"
+#include "components/exo/embedded_windows.h"
+#include "components/exo/seat.h"
+#include "components/exo/surface.h"
+#include "components/exo/wayland/server_util.h"
+
+namespace exo {
+namespace wayland {
+namespace {
+
+// How long a token can be used for.
+constexpr base::TimeDelta kTokenLifetime = base::Seconds(60);
+
+// The tokens handed out and not used yet, by token: whether each is valid
+// (its client had keyboard focus) and when it was made.
+struct Token {
+  bool valid = false;
+  base::TimeTicks created;
+};
+
+std::map<std::string, Token>& Tokens() {
+  static base::NoDestructor<std::map<std::string, Token>> tokens;
+  return *tokens;
+}
+
+// Whether a surface of |client| has keyboard focus.
+bool ClientHasKeyboardFocus(Display* display, wl_client* client) {
+  Surface* focused = display->seat()->GetFocusedSurface();
+  wl_resource* resource = focused ? GetSurfaceResource(focused) : nullptr;
+  return resource && wl_resource_get_client(resource) == client;
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// xdg_activation_token_v1 interface:
+
+class ActivationToken {
+ public:
+  explicit ActivationToken(Display* display) : display_(display) {}
+  ActivationToken(const ActivationToken&) = delete;
+  ActivationToken& operator=(const ActivationToken&) = delete;
+
+  // Returns false if it was committed before.
+  bool Commit(wl_resource* resource) {
+    if (committed_) {
+      return false;
+    }
+    committed_ = true;
+    wl_client* client = wl_resource_get_client(resource);
+    // What counts is that the client is the one the user is using, not the
+    // surface or serial it names.
+    const bool valid = ClientHasKeyboardFocus(display_, client);
+    std::string token = base::UnguessableToken::Create().ToString();
+    std::erase_if(Tokens(), [](const auto& entry) {
+      return base::TimeTicks::Now() - entry.second.created > kTokenLifetime;
+    });
+    Tokens()[token] = {valid, base::TimeTicks::Now()};
+    VLOG(1) << "EXO-ACTIVATION token for client "
+            << static_cast<const void*>(client) << (valid ? "" : " (invalid)");
+    xdg_activation_token_v1_send_done(resource, token.c_str());
+    wl_client_flush(client);
+    return true;
+  }
+
+ private:
+  const raw_ptr<Display> display_;
+  bool committed_ = false;
+};
+
+void activation_token_set_serial(wl_client* client,
+                                 wl_resource* resource,
+                                 uint32_t serial,
+                                 wl_resource* seat) {
+  // Nothing needs to be done: keyboard focus at commit decides.
+}
+
+void activation_token_set_app_id(wl_client* client,
+                                 wl_resource* resource,
+                                 const char* app_id) {
+  // Nothing needs to be done.
+}
+
+void activation_token_set_surface(wl_client* client,
+                                  wl_resource* resource,
+                                  wl_resource* surface_resource) {
+  // Nothing needs to be done.
+}
+
+void activation_token_commit(wl_client* client, wl_resource* resource) {
+  if (!GetUserDataAs<ActivationToken>(resource)->Commit(resource)) {
+    wl_resource_post_error(resource, XDG_ACTIVATION_TOKEN_V1_ERROR_ALREADY_USED,
+                           "the activation token was already committed");
+  }
+}
+
+void activation_token_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct xdg_activation_token_v1_interface
+    activation_token_implementation = {
+        activation_token_set_serial, activation_token_set_app_id,
+        activation_token_set_surface, activation_token_commit,
+        activation_token_destroy};
+
+////////////////////////////////////////////////////////////////////////////////
+// xdg_activation_v1 interface:
+
+void activation_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void activation_get_activation_token(wl_client* client,
+                                     wl_resource* resource,
+                                     uint32_t id) {
+  wl_resource* token_resource =
+      wl_resource_create(client, &xdg_activation_token_v1_interface, 1, id);
+  SetImplementation(
+      token_resource, &activation_token_implementation,
+      std::make_unique<ActivationToken>(GetUserDataAs<Display>(resource)));
+}
+
+void activation_activate(wl_client* client,
+                         wl_resource* resource,
+                         const char* token,
+                         wl_resource* surface_resource) {
+  auto it = Tokens().find(token);
+  if (it == Tokens().end()) {
+    VLOG(1) << "EXO-ACTIVATION unknown token";
+    return;
+  }
+  const Token found = it->second;
+  Tokens().erase(it);
+  if (!found.valid || base::TimeTicks::Now() - found.created > kTokenLifetime) {
+    VLOG(1) << "EXO-ACTIVATION token not valid";
+    return;
+  }
+  EmbeddedWindows::Get()->RequestActivation(
+      GetUserDataAs<Surface>(surface_resource));
+}
+
+constexpr struct xdg_activation_v1_interface activation_implementation = {
+    activation_destroy, activation_get_activation_token, activation_activate};
+
+}  // namespace
+
+void bind_xdg_activation(wl_client* client,
+                         void* data,
+                         uint32_t version,
+                         uint32_t id) {
+  wl_resource* resource =
+      wl_resource_create(client, &xdg_activation_v1_interface, 1, id);
+  wl_resource_set_implementation(resource, &activation_implementation, data,
+                                 nullptr);
+}
+
+}  // namespace wayland
+}  // namespace exo
