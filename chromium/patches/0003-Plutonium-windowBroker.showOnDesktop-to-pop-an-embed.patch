From: Oliver Sargison <sarol263@student.otago.ac.nz>
Date: Fri, 16 Oct 2026 08:38:41 +1300
Subject: [PATCH 03/52] Plutonium: windowBroker.showOnDesktop to pop an
 embedded window out

Shows and activates a window on the Ash desktop, as soon as no page element shows it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/plutonium_shell.cc             |  6 ++++
 components/exo/embedded_windows.cc            | 29 +++++++++++++++++++
 components/exo/embedded_windows.h             |  6 ++++
 .../mojom/native_window/window_broker.mojom   |  4 +++
 .../core/html/native_window_broker.cc         |  7 +++++
 .../renderer/core/html/native_window_broker.h |  1 +
 .../core/html/native_window_broker.idl        |  3 ++
 7 files changed, 56 insertions(+)

diff --git a/chrome/browser/plutonium_shell.cc b/chrome/browser/plutonium_shell.cc
index 9c68d8a4f2..f45a9deb31 100644
--- a/chrome/browser/plutonium_shell.cc
+++ b/chrome/browser/plutonium_shell.cc
@@ -164,6 +164,12 @@ class WindowBrokerImpl
     }
   }
 
+  void ShowOnDesktop(int32_t window_id) override {
+    if (StillShell() && ExoWindowBroker::Get()) {
+      exo::EmbeddedWindows::Get()->ShowOnDesktop(window_id);
+    }
+  }
+
   // ExoWindowBroker::Observer:
   void OnWindowAdded(const ExoWindowBroker::WindowInfo& window) override {
     if (observers_.empty() || !StillShell()) {
diff --git a/components/exo/embedded_windows.cc b/components/exo/embedded_windows.cc
index a7e0e68827..4e833b005f 100644
--- a/components/exo/embedded_windows.cc
+++ b/components/exo/embedded_windows.cc
@@ -16,6 +16,7 @@
 #include "components/exo/surface.h"
 #include "components/exo/wm_helper.h"
 #include "ui/aura/window.h"
+#include "ui/views/widget/widget.h"
 #include "ui/compositor/layer.h"
 #include "ui/events/base_event_utils.h"
 #include "ui/events/event.h"
@@ -128,10 +129,38 @@ void EmbeddedWindows::Detach(int32_t window_id) {
       ClearFocus();
     }
     it->second.shell_surface->SetEmbedParked(false);
+    if (it->second.show_on_detach) {
+      it->second.show_on_detach = false;
+      ActivateOnDesktop(it->second.shell_surface);
+    }
     NotifyIfChanged(window_id);
   }
 }
 
+void EmbeddedWindows::ShowOnDesktop(int32_t window_id) {
+  auto it = windows_.find(window_id);
+  if (it == windows_.end()) {
+    return;
+  }
+  if (it->second.attach_count > 0) {
+    it->second.show_on_detach = true;
+    return;
+  }
+  ActivateOnDesktop(it->second.shell_surface);
+}
+
+void EmbeddedWindows::ActivateOnDesktop(ShellSurfaceBase* shell_surface) {
+  views::Widget* widget = shell_surface->GetWidget();
+  if (!widget) {
+    return;
+  }
+  if (widget->IsMinimized()) {
+    widget->Restore();
+  }
+  widget->Show();
+  widget->Activate();
+}
+
 void EmbeddedWindows::SetSize(int32_t window_id, const gfx::Size& size) {
   if (ShellSurfaceBase* shell_surface = FindShellSurface(window_id)) {
     shell_surface->SetEmbedSize(size);
