+
+// EXO-SHELLS: the shells overlay (the switcher), Ash's own UI for several
+// shells. Super+Tab opens it over whatever is in front. A sidebar lists
+// - at the top, the shells, then the built-ins: add a shell, the backup
+//   terminal and browser, and launching a desktop app;
+// - below, every window and tab, whichever shell shows it, grouped by their
+//   tags' labels.
+// A search box filters both. The main area shows the selected item's page:
+// its state and everything that can be done with it. Left click acts (a
+// shell is shown, a window opens fullscreen, a tab is shown in its shell);
+// right click only selects, for the page. Arrows move, Enter acts, Tab goes
+// into the page, Escape closes, Super+Tab again moves on.
+class PlutoniumOverlay : public views::WidgetObserver,
+                         public ExoWindowBroker::Observer {
+ public:
+  // The thread that apps started from the overlay run in.
+  static constexpr char kLaunchThread[] = "plutonium:switcher";
+  // The backup terminal's (the helper's).
+  static constexpr char kTerminalThread[] = "plutonium:terminal";
+
+  explicit PlutoniumOverlay(PlutoniumShells* shells);
+  PlutoniumOverlay(const PlutoniumOverlay&) = delete;
+  PlutoniumOverlay& operator=(const PlutoniumOverlay&) = delete;
+  ~PlutoniumOverlay() override;
+
+  bool IsOpen() const { return !!widget_; }
+  // Opens it with the shell |step| away from the visible one selected, or
+  // moves the selection by |step| if it is open.
+  void OnSwitchKey(int step);
+  // Closes it (gives the visible shell its focus back unless |acted|: an
+  // action already chose what comes next).
+  void Close(bool acted = false);
+  // Gives it its focus back (a shell's window opening took it), if open.
+  void Reactivate();
+  // EXO-SETTINGS: opens it (or, if open, goes) on a settings page:
+  // "settings", "displays", "network", "bluetooth", "sound", "power" or
+  // "notifications". False for another name.
+  bool OpenPage(const std::string& page);
+  // EXO-DISPLAYS: back in the middle of its display (after a display
+  // changed).
+  void Recenter();
+
+  // Starts desktop app |app_id| (a helper /v1/apps id) in kLaunchThread and
+  // presents its first window fullscreen once it opens. Outlives the
+  // overlay's widget. |callback| gets an error, or "" once it started.
+  void LaunchApp(const std::string& app_id,
+                 base::OnceCallback<void(const std::string& error)> callback);
+  // Whether a launch waits for its window.
+  bool IsLaunching() const;
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+  // ExoWindowBroker::Observer:
+  void OnWindowAdded(const ExoWindowBroker::WindowInfo& window) override;
+
+ private:
+  void Open(int step);
+  static gfx::Rect BoundsIn(const gfx::Rect& work_area);
+  void MaybePresentLaunched(int32_t window_id, const std::string& thread);
+
+  raw_ptr<PlutoniumShells> shells_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<PlutoniumOverlayView> view_ = nullptr;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+  // While a launch waits for its window.
+  base::TimeTicks launch_deadline_;
+  base::ScopedObservation<ExoWindowBroker, ExoWindowBroker::Observer>
+      broker_observation_{this};
+  base::WeakPtrFactory<PlutoniumOverlay> weak_ptr_factory_{this};
+};
