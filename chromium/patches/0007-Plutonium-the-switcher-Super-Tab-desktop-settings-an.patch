+  // EXO-SETTINGS: a slider on a service's level.
+  struct SliderBinding {
+    std::string service;
+    std::string action;
+    // The value's key in the action's args, and the rest of them.
+    std::string key;
+    base::DictValue args;
+    // The service's value is the slider's (0 to 1) times this.
+    double scale = 1;
+    base::RepeatingCallback<std::optional<double>()> read;
+    raw_ptr<views::Slider> slider = nullptr;
+    raw_ptr<views::Label> label = nullptr;
+    bool dragging = false;
+    bool in_flight = false;
+    // The value to send once the one in flight is answered.
+    std::optional<double> queued;
+  };
+
+  // EXO-SETTINGS: the desktop's settings (DESKTOP_SERVICES.md): the helper's
+  // services over its socket (/v1/system/services, as a shell that uses them
+  // all sees them), and Ash's own displays (PlutoniumDisplayConfig).
+
+  const base::DictValue* ServiceState(std::string_view name) const {
+    const base::DictValue* state = services_.FindDict(name);
+    return state && !state->FindString("error") ? state : nullptr;
+  }
+
+  // The service is there and has what it serves (PipeWire, NetworkManager…).
+  bool Has(std::string_view name) const {
+    const base::DictValue* state = ServiceState(name);
+    return state && state->FindBool("available").value_or(true);
+  }
+
+  void LoadServices() {
+    if (services_loading_ || !plutonium_helper::IsAvailable()) {
+      return;
+    }
+    services_loading_ = true;
+    plutonium_helper::Get("/v1/system/services",
+                          base::BindOnce(&PlutoniumOverlayView::OnServices,
+                                         weak_ptr_factory_.GetWeakPtr()));
+  }
+
+  void OnServices(std::optional<base::Value> value, const std::string& error) {
+    services_loading_ = false;
+    if (!value || !value->is_dict()) {
+      services_error_ = U(error);
+      if (!services_loaded_) {
+        services_loaded_ = true;
+        RebuildSoon();
+      }
+      return;
+    }
+    const bool first = !services_loaded_;
+    services_loaded_ = true;
+    services_error_.clear();
+    std::string json = base::WriteJson(*value).value_or(std::string());
+    if (json == services_json_ && !first) {
+      return;
+    }
+    services_json_ = std::move(json);
+    services_ = std::move(value->GetDict());
+    RefreshLive();
+    RebuildSoon();
+  }
+
+  static std::string ServicePath(const std::string& service,
+                                 const std::string& action) {
+    return "/v1/system/services/" + service + "/" + action;
+  }
+
+  // Runs a service's action; |doing| goes in the status line meanwhile.
+  void CallService(const std::string& service,
+                   const std::string& action,
+                   const base::DictValue& args,
+                   const std::u16string& doing = std::u16string()) {
+    if (!doing.empty()) {
+      SetStatus(doing, /*error=*/false);
+    }
+    plutonium_helper::Post(
+        ServicePath(service, action), args.Clone(),
+        base::BindOnce(&PlutoniumOverlayView::OnServiceCalled,
+                       weak_ptr_factory_.GetWeakPtr(), !doing.empty()));
+  }
+
+  void OnServiceCalled(bool said,
+                       std::optional<base::Value> value,
+                       const std::string& error) {
+    if (!value) {
+      SetStatus(u"Couldn't do that: " + U(error));
+    } else if (said) {
+      SetStatus(u"Done.", /*error=*/false);
+    }
+    LoadServices();
+  }
+
+  // A button that asks before it acts: the first click arms it.
+  bool Confirmed(const std::string& action) {
+    if (confirm_action_ == action) {
+      confirm_action_.clear();
+      return true;
+    }
+    confirm_action_ = action;
+    UpdatePage(/*force=*/true);
+    return false;
+  }
+
+  std::u16string ConfirmLabel(const std::string& action,
+                              const std::u16string& label) const {
+    return confirm_action_ == action ? label + u": click again" : label;
+  }
+
+  // Summaries, for the rows.
+
+  std::u16string NetworkSummary(SkColor* dot) const {
+    *dot = kDim;
+    const base::DictValue* net = ServiceState("network");
+    if (!net || !Has("network")) {
+      return services_loaded_ ? u"No NetworkManager" : u"…";
+    }
+    const base::DictValue* wifi = net->FindDict("wifi");
+    if (const base::DictValue* primary = net->FindDict("primary")) {
+      *dot = kOk;
+      std::u16string text = U(Str(primary, "name"));
+      const std::string connectivity = Str(net, "connectivity");
+      if (connectivity == "portal") {
+        *dot = kWarn;
+        text += u"  ·  sign-in needed";
+      } else if (connectivity == "limited" || connectivity == "none") {
+        *dot = kWarn;
+        text += u"  ·  no internet";
+      }
+      return text;
+    }
+    if (Str(net, "state") == "connecting") {
+      *dot = kWarn;
+      return u"Connecting…";
+    }
+    if (wifi && Bool(wifi, "available") && !Bool(wifi, "enabled")) {
+      return u"Wi-Fi off";
+    }
+    return u"Not connected";
+  }
+
+  std::u16string BluetoothSummary(SkColor* dot) const {
+    *dot = kDim;
+    const base::DictValue* bluetooth = ServiceState("bluetooth");
+    if (!bluetooth || !Has("bluetooth")) {
+      return services_loaded_ ? u"No Bluetooth" : u"…";
+    }
+    const base::DictValue* adapter = bluetooth->FindDict("adapter");
+    if (!adapter) {
+      return u"No adapter";
+    }
+    if (!Bool(adapter, "powered")) {
+      return u"Off";
+    }
+    *dot = kOk;
+    int connected = 0;
+    if (const base::ListValue* devices = bluetooth->FindList("devices")) {
+      for (const base::Value& device : *devices) {
+        connected += Bool(device.GetIfDict(), "connected") ? 1 : 0;
+      }
+    }
+    return connected
+               ? u"On  ·  " + base::NumberToString16(connected) + u" connected"
+               : u"On";
+  }
+
+  std::u16string SoundSummary(SkColor* dot) const {
+    *dot = kDim;
+    const base::DictValue* audio = ServiceState("audio");
+    if (!audio || !Has("audio")) {
+      return services_loaded_ ? u"No PipeWire" : u"…";
+    }
+    *dot = Bool(audio, "muted") ? kDim : kOk;
+    std::u16string text = Bool(audio, "muted")
+                              ? u"Muted"
+                              : u"Volume " + Percent(Num(audio, "volume"));
+    if (const base::DictValue* output = audio->FindDict("output")) {
+      text += u"  ·  " + U(Str(output, "name"));
+    }
+    return text;
+  }
+
+  std::u16string PowerSummary(SkColor* dot) const {
+    *dot = kDim;
+    const base::DictValue* power = ServiceState("power");
+    if (!power) {
+      return services_loaded_ ? u"Suspend, restart, power off" : u"…";
+    }
+    *dot = kOk;
+    if (const base::DictValue* battery = power->FindDict("battery")) {
+      const double percent = Num(battery, "percent");
+      const bool charging = Bool(battery, "charging");
+      if (percent < 15 && !charging) {
+        *dot = kError;
+      }
+      return u"Battery " + base::NumberToString16(std::lround(percent)) + u"%" +
+             (charging ? u"  ·  charging" : u"");
+    }
+    return u"On mains power";
+  }
+
+  std::u16string NotificationsSummary(SkColor* dot) const {
+    *dot = kDim;
+    const base::DictValue* notifications = ServiceState("notifications");
+    if (!notifications) {
+      return services_loaded_ ? u"None" : u"…";
+    }
+    const base::ListValue* list = notifications->FindList("notifications");
+    const size_t count = list ? list->size() : 0;
+    const bool quiet = Bool(notifications, "doNotDisturb");
+    if (count) {
+      *dot = kAccent;
+    }
+    std::u16string text =
+        count ? base::NumberToString16(count) +
+                    (count == 1 ? u" notification" : u" notifications")
+              : u"None";
+    return quiet ? text + u"  ·  do not disturb" : text;
+  }
+
+  base::DictValue DisplayConfig() const {
+    PlutoniumDisplayConfig* config = PlutoniumDisplayConfig::Get();
+    return config ? config->GetConfig() : base::DictValue();
+  }
+
+  std::u16string DisplaysSummary(SkColor* dot) const {
+    *dot = kOk;
+    const base::DictValue config = DisplayConfig();
+    const base::ListValue* displays = config.FindList("displays");
+    if (!displays || displays->empty()) {
+      *dot = kDim;
+      return u"Arrangement, resolution, size, rotation";
+    }
+    std::u16string text =
+        displays->size() == 1
+            ? u"1 display"
+            : base::NumberToString16(displays->size()) + u" displays";
+    if (Bool(&config, "mirror")) {
+      text += u", mirrored";
+    }
+    for (const base::Value& item : *displays) {
+      const base::DictValue* display = item.GetIfDict();
+      const base::DictValue* mode =
+          display ? display->FindDict("mode") : nullptr;
+      if (Bool(display, "primary") && mode) {
+        text += u"  ·  " +
+                base::NumberToString16(static_cast<int>(Num(mode, "width"))) +
+                u"×" +
+                base::NumberToString16(static_cast<int>(Num(mode, "height")));
+      }
+    }
+    if (config.FindDict("pending")) {
+      *dot = kWarn;
+    }
+    return text;
+  }
