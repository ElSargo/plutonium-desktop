+// EXO-DISPLAYS: the displays as they're arranged, to drag into place. A
+// click selects one; a drag moves it, and Ash puts it against the nearest
+// edge of another (PlutoniumDisplayConfig's layout).
+class ArrangementView : public views::View {
+  METADATA_HEADER(ArrangementView, views::View)
+
+ public:
+  struct Item {
+    std::string id;
+    int index = 0;
+    std::u16string name;
+    std::u16string detail;
+    gfx::Rect bounds;
+    bool primary = false;
+  };
+  using SelectCallback = base::RepeatingCallback<void(const std::string&)>;
+  using MoveCallback =
+      base::RepeatingCallback<void(const std::string&, const gfx::Point&)>;
+
+  ArrangementView(std::vector<Item> items,
+                  std::string selected,
+                  SelectCallback on_select,
+                  MoveCallback on_move)
+      : items_(std::move(items)),
+        selected_(std::move(selected)),
+        on_select_(std::move(on_select)),
+        on_move_(std::move(on_move)) {
+    SetPreferredSize(gfx::Size(600, 220));
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    views::View::OnPaint(canvas);
+    if (dragging_ < 0) {
+      Fit();
+    }
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), 10, Fill(kSidebar));
+    const gfx::FontList big =
+        gfx::FontList().DeriveWithSizeDelta(14).DeriveWithWeight(
+            gfx::Font::Weight::BOLD);
+    const gfx::FontList small = gfx::FontList().DeriveWithSizeDelta(-1);
+    // The dragged one last, above the others.
+    std::vector<int> order;
+    for (int i = 0; i < static_cast<int>(items_.size()); ++i) {
+      if (i != dragging_) {
+        order.push_back(i);
+      }
+    }
+    if (dragging_ >= 0) {
+      order.push_back(dragging_);
+    }
+    for (int i : order) {
+      const Item& item = items_[i];
+      gfx::RectF rect = Map(item.bounds);
+      if (i == dragging_) {
+        rect.Offset(drag_delta_);
+      }
+      rect.Inset(2);
+      const bool selected = item.id == selected_;
+      canvas->DrawRoundRect(rect, 8, Fill(selected ? kSelected : kButton));
+      if (selected) {
+        cc::PaintFlags stroke = Fill(kAccent);
+        stroke.setStyle(cc::PaintFlags::kStroke_Style);
+        stroke.setStrokeWidth(2);
+        canvas->DrawRoundRect(rect, 8, stroke);
+      }
+      const gfx::Rect box = gfx::ToEnclosedRect(rect);
+      const bool room = box.height() >= 78 && box.width() >= 150;
+      gfx::Rect number = box;
+      if (room) {
+        number.set_height(box.height() / 2 + 6);
+      }
+      canvas->DrawStringRectWithFlags(base::NumberToString16(item.index), big,
+                                      kTitle, number,
+                                      gfx::Canvas::TEXT_ALIGN_CENTER);
+      if (room) {
+        gfx::Rect line(box.x() + 6, number.bottom(), box.width() - 12, 18);
+        canvas->DrawStringRectWithFlags(item.name, small, kTitle, line,
+                                        gfx::Canvas::TEXT_ALIGN_CENTER);
+        line.Offset(0, 17);
+        canvas->DrawStringRectWithFlags(
+            item.primary ? item.detail + u"  ·  primary" : item.detail, small,
+            kDim, line, gfx::Canvas::TEXT_ALIGN_CENTER);
+      }
+    }
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    Fit();
+    pressed_ = -1;
+    for (int i = static_cast<int>(items_.size()) - 1; i >= 0; --i) {
+      if (Map(items_[i].bounds).Contains(event.location_f())) {
+        pressed_ = i;
+        break;
+      }
+    }
+    press_point_ = event.location();
+    return pressed_ >= 0;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    if (pressed_ < 0) {
+      return false;
+    }
+    const gfx::Vector2d delta = event.location() - press_point_;
+    if (dragging_ < 0 && std::abs(delta.x()) + std::abs(delta.y()) < 4) {
+      return true;
+    }
+    dragging_ = pressed_;
+    drag_delta_ = gfx::Vector2dF(delta.x(), delta.y());
+    SchedulePaint();
+    return true;
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    const int pressed = std::exchange(pressed_, -1);
+    const int dragged = std::exchange(dragging_, -1);
+    const gfx::Vector2dF delta = std::exchange(drag_delta_, gfx::Vector2dF());
+    SchedulePaint();
+    if (pressed < 0) {
+      return;
+    }
+    const Item& item = items_[pressed];
+    // Both rebuild the page this view is on: from a fresh task.
+    if (dragged < 0) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(on_select_, item.id));
+      return;
+    }
+    const gfx::Point origin(
+        item.bounds.x() + static_cast<int>(std::lround(delta.x() / scale_)),
+        item.bounds.y() + static_cast<int>(std::lround(delta.y() / scale_)));
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(on_move_, item.id, origin));
+  }
+
+  void OnMouseCaptureLost() override {
+    pressed_ = -1;
+    dragging_ = -1;
+    drag_delta_ = gfx::Vector2dF();
+    SchedulePaint();
+  }
+
+ private:
+  // The desktop's DIPs into this view, centered, with a margin.
+  void Fit() {
+    gfx::Rect all;
+    for (const Item& item : items_) {
+      all.Union(item.bounds);
+    }
+    const gfx::Rect area = gfx::Rect(size());
+    if (all.IsEmpty() || area.width() < 40 || area.height() < 40) {
+      scale_ = 1;
+      return;
+    }
+    scale_ = std::min((area.width() - 48.f) / all.width(),
+                      (area.height() - 32.f) / all.height());
+    origin_ = all.origin();
+    offset_ = gfx::Vector2dF((area.width() - all.width() * scale_) / 2,
+                             (area.height() - all.height() * scale_) / 2);
+  }
+
+  gfx::RectF Map(const gfx::Rect& bounds) const {
+    return gfx::RectF((bounds.x() - origin_.x()) * scale_ + offset_.x(),
+                      (bounds.y() - origin_.y()) * scale_ + offset_.y(),
+                      bounds.width() * scale_, bounds.height() * scale_);
+  }
+
+  std::vector<Item> items_;
+  std::string selected_;
+  SelectCallback on_select_;
+  MoveCallback on_move_;
+  float scale_ = 1;
+  gfx::Point origin_;
+  gfx::Vector2dF offset_;
+  int pressed_ = -1;
+  int dragging_ = -1;
+  gfx::Point press_point_;
+  gfx::Vector2dF drag_delta_;
+};
+
+BEGIN_METADATA(ArrangementView)
+END_METADATA
+
