+  // Levels that change without the page being built again: the sliders
+  // (unless the user is on them) and their percentages, the countdown.
+  void RefreshLive() {
+    for (auto& [id, binding] : sliders_) {
+      std::optional<double> value = binding.read.Run();
+      if (!value) {
+        continue;
+      }
+      if (binding.slider && !binding.dragging && !binding.in_flight &&
+          !binding.queued) {
+        if (binding.label) {
+          binding.label->SetText(Percent(*value));
+        }
+        binding.slider->SetValue(
+            static_cast<float>(std::clamp(*value / binding.scale, 0.0, 1.0)));
+      }
+    }
+    if (pending_label_) {
+      PlutoniumDisplayConfig* config = PlutoniumDisplayConfig::Get();
+      if (config && config->HasPending()) {
+        pending_label_->SetText(
+            u"Keep this?  " + config->PendingWhat() + u" goes back in " +
+            base::NumberToString16(config->PendingSecondsLeft()) + u" s.");
+      }
+    }
+  }
+
+  // A slider for a service's level: |read| gives it from the state, and a
+  // move sends |action| with the value as |key| (values are slider × |scale|).
+  views::Slider* AddSlider(
+      views::View* parent,
+      const std::u16string& label,
+      const std::string& service,
+      const std::string& action,
+      const std::string& key,
+      base::DictValue args,
+      base::RepeatingCallback<std::optional<double>()> read,
+      double scale = 1.0) {
+    auto* row = AddBox(parent, views::BoxLayout::Orientation::kHorizontal, 12);
+    views::Label* name = AddLabel(row, label, kDim);
+    name->SetPreferredSize(
+        gfx::Size(120, name->GetPreferredSize(views::SizeBounds()).height()));
+    auto* slider = row->AddChildView(std::make_unique<views::Slider>(this));
+    slider->SetPreferredSize(gfx::Size(340, 28));
+    slider->GetViewAccessibility().SetName(label);
+    views::Label* value = AddLabel(row, u"", kTitle);
+    value->SetPreferredSize(
+        gfx::Size(52, value->GetPreferredSize(views::SizeBounds()).height()));
+    SliderBinding& binding = sliders_[next_slider_++];
+    binding.service = service;
+    binding.action = action;
+    binding.key = key;
+    binding.args = std::move(args);
+    binding.scale = scale;
+    binding.read = std::move(read);
+    binding.slider = slider;
+    binding.label = value;
+    if (std::optional<double> current = binding.read.Run()) {
+      slider->SetValue(
+          static_cast<float>(std::clamp(*current / scale, 0.0, 1.0)));
+      value->SetText(Percent(*current));
+    }
+    return slider;
+  }
+
+  SliderBinding* BindingFor(views::Slider* slider, int* id = nullptr) {
+    for (auto& [key, binding] : sliders_) {
+      if (binding.slider == slider) {
+        if (id) {
+          *id = key;
+        }
+        return &binding;
+      }
+    }
+    return nullptr;
+  }
+
+  // views::SliderListener:
+  void SliderValueChanged(views::Slider* sender,
+                          float value,
+                          float old_value,
+                          views::SliderChangeReason reason) override {
+    int id = 0;
+    SliderBinding* binding = BindingFor(sender, &id);
+    if (!binding || reason != views::SliderChangeReason::kByUser) {
+      return;
+    }
+    binding->queued = value * binding->scale;
+    if (binding->label) {
+      binding->label->SetText(Percent(*binding->queued));
+    }
+    if (!binding->in_flight) {
+      SendSlider(id);
+    }
+  }
+  void SliderDragStarted(views::Slider* sender) override {
+    if (SliderBinding* binding = BindingFor(sender)) {
+      binding->dragging = true;
+    }
+  }
+  void SliderDragEnded(views::Slider* sender) override {
+    if (SliderBinding* binding = BindingFor(sender)) {
+      binding->dragging = false;
+    }
+  }
+
+  // One request at a time per slider; the latest value goes next.
+  void SendSlider(int id) {
+    auto it = sliders_.find(id);
+    if (it == sliders_.end() || !it->second.queued) {
+      return;
+    }
+    SliderBinding& binding = it->second;
+    base::DictValue args = binding.args.Clone();
+    args.Set(binding.key, *binding.queued);
+    binding.queued.reset();
+    binding.in_flight = true;
+    plutonium_helper::Post(ServicePath(binding.service, binding.action),
+                           std::move(args),
+                           base::BindOnce(&PlutoniumOverlayView::OnSliderSent,
+                                          weak_ptr_factory_.GetWeakPtr(), id));
+  }
+
+  void OnSliderSent(int id,
+                    std::optional<base::Value> value,
+                    const std::string& error) {
+    auto it = sliders_.find(id);
+    if (it != sliders_.end()) {
+      it->second.in_flight = false;
+      if (it->second.queued) {
+        SendSlider(id);
+        return;
+      }
+    }
+    if (!value) {
+      SetStatus(u"Couldn't change it: " + U(error));
+    }
+    LoadServices();
+  }
+
+  // What reads a level from the state.
+  base::RepeatingCallback<std::optional<double>()> Reader(std::string service,
+                                                          std::string dict,
+                                                          std::string key) {
+    return base::BindRepeating(
+        [](base::WeakPtr<PlutoniumOverlayView> view, const std::string& service,
+           const std::string& dict,
+           const std::string& key) -> std::optional<double> {
+          if (!view) {
+            return std::nullopt;
+          }
+          const base::DictValue* state = view->ServiceState(service);
+          if (state && !dict.empty()) {
+            state = state->FindDict(dict);
+          }
+          return state ? state->FindDouble(key) : std::nullopt;
+        },
+        weak_ptr_factory_.GetWeakPtr(), std::move(service), std::move(dict),
+        std::move(key));
+  }
