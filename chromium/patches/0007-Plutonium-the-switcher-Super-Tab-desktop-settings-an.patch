+views::ScrollView* AddScrollList(views::View* parent, SkColor background) {
+  auto* scroll = parent->AddChildView(std::make_unique<views::ScrollView>());
+  scroll->SetBackgroundColor(background);
+  scroll->SetDrawOverflowIndicator(false);
+  // Rows as wide as the list.
+  scroll->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  auto* contents = scroll->SetContents(std::make_unique<views::View>());
+  contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+  return scroll;
+}
+
+// The scroll view doesn't resize its contents when they change: size them to
+// its width (less the scroll bar) and their height.
+void SizeContents(views::ScrollView* scroll, int fallback_width) {
+  views::View* contents = scroll->contents();
+  const int width =
+      scroll->width() > 0 ? scroll->width() - 14 : fallback_width;
+  contents->SetSize(gfx::Size(width, contents->GetHeightForWidth(width)));
+  scroll->InvalidateLayout();
+}
