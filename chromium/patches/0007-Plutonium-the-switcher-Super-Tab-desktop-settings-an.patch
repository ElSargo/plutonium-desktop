+  void BuildBluetoothPage() {
+    SkColor dot;
+    const std::u16string summary = BluetoothSummary(&dot);
+    AddTitle(u"Bluetooth", summary, dot);
+    const base::DictValue* bluetooth = ServiceState("bluetooth");
+    const base::DictValue* adapter =
+        bluetooth ? bluetooth->FindDict("adapter") : nullptr;
+    if (!bluetooth || !Has("bluetooth") || !adapter) {
+      AddNotAvailable(
+          u"There's no Bluetooth adapter (or BlueZ isn't "
+          u"running).");
+      return;
+    }
+    const bool on = Bool(adapter, "powered");
+    const bool discovering = Bool(adapter, "discovering");
+    auto* actions = AddButtons(page_);
+    AddButton(
+        actions, on ? u"Turn Bluetooth off" : u"Turn Bluetooth on",
+        Bind(&PlutoniumOverlayView::CallService, std::string("bluetooth"),
+             std::string("set-powered"), base::DictValue().Set("powered", !on),
+             std::u16string()),
+        on ? ActionButton::Style::kNormal : ActionButton::Style::kPrimary);
+    AddButton(actions, discovering ? u"Stop looking" : u"Find devices",
+              Bind(&PlutoniumOverlayView::CallService, std::string("bluetooth"),
+                   std::string("discover"),
+                   base::DictValue().Set("on", !discovering), std::u16string()),
+              ActionButton::Style::kNormal, on);
+    if (discovering) {
+      AddParagraph(page_, u"Looking for devices nearby (30 s)…", kWarn);
+    }
+    AddField(
+        page_, u"Adapter",
+        U(Str(adapter, "name")) + u"  (" + U(Str(adapter, "address")) + u")");
+    const base::ListValue* devices = bluetooth->FindList("devices");
+    auto* list = AddSection(u"Devices");
+    if (!devices || devices->empty()) {
+      AddParagraph(list,
+                   on ? u"No devices yet: Find devices, with the device in "
+                        u"pairing mode."
+                      : u"Turn Bluetooth on to see your devices.",
+                   kDim);
+      return;
+    }
+    for (const base::Value& item : *devices) {
+      const base::DictValue* device = item.GetIfDict();
+      if (!device) {
+        continue;
+      }
+      const std::string id = Str(device, "id");
+      const bool connected = Bool(device, "connected");
+      const bool paired = Bool(device, "paired");
+      const bool pairing = Bool(device, "pairing");
+      auto* row = AddButtons(list);
+      auto* text = AddBox(row, views::BoxLayout::Orientation::kVertical, 1);
+      AddLabel(text, U(Str(device, "name")), connected ? kAccent : kTitle, 1,
+               connected);
+      std::u16string detail = pairing     ? u"Pairing…"
+                              : connected ? u"Connected"
+                              : paired    ? u"Paired"
+                                          : u"Not paired";
+      if (const std::optional<double> battery = device->FindDouble("battery")) {
+        detail += u"  ·  battery " +
+                  base::NumberToString16(static_cast<int>(*battery)) + u"%";
+      }
+      AddLabel(text, detail, kDim, -1);
+      text->SetPreferredSize(
+          gfx::Size(340, text->GetPreferredSize(views::SizeBounds()).height()));
+      const base::DictValue args = base::DictValue().Set("device", id);
+      if (!paired) {
+        AddButton(row, u"Pair",
+                  Bind(&PlutoniumOverlayView::CallService,
+                       std::string("bluetooth"), std::string("pair"),
+                       args.Clone(), std::u16string(u"Pairing…")),
+                  ActionButton::Style::kPrimary, on && !pairing);
+        continue;
+      }
+      AddButton(
+          row, connected ? u"Disconnect" : u"Connect",
+          Bind(&PlutoniumOverlayView::CallService, std::string("bluetooth"),
+               std::string(connected ? "disconnect" : "connect"), args.Clone(),
+               std::u16string(connected ? u"Disconnecting…" : u"Connecting…")),
+          connected ? ActionButton::Style::kNormal
+                    : ActionButton::Style::kPrimary,
+          on);
+      AddButton(row, ConfirmLabel("forget/" + id, u"Forget"),
+                Bind(&PlutoniumOverlayView::ForgetDevice, id),
+                ActionButton::Style::kDanger);
+    }
+    AddParagraph(page_,
+                 u"A device that shows or asks for a code while pairing does "
+                 u"so in the visible shell.",
+                 kDim);
+  }
