+// A flat, rounded button in the panel's colors.
+class ActionButton : public views::LabelButton {
+  METADATA_HEADER(ActionButton, views::LabelButton)
+
+ public:
+  enum class Style { kNormal, kPrimary, kDanger };
+
+  ActionButton(base::RepeatingClosure action,
+               std::u16string_view text,
+               Style style)
+      : LabelButton(base::BindRepeating(
+                        [](base::RepeatingClosure action, const ui::Event&) {
+                          action.Run();
+                        },
+                        Deferred(std::move(action))),
+                    text),
+        style_(style) {
+    SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(7, 16)));
+    const SkColor color = style == Style::kPrimary  ? kOnAccent
+                          : style == Style::kDanger ? kError
+                                                    : kTitle;
+    for (ButtonState state : {STATE_NORMAL, STATE_HOVERED, STATE_PRESSED}) {
+      SetTextColor(state, color);
+    }
+    SetTextColor(STATE_DISABLED, kDim);
+    UpdateBackground();
+  }
+
+  // views::Button:
+  void StateChanged(ButtonState old_state) override {
+    LabelButton::StateChanged(old_state);
+    UpdateBackground();
+  }
+
+ private:
+  void UpdateBackground() {
+    const bool hot =
+        GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+    SkColor color = hot ? kButtonHover : kButton;
+    if (style_ == Style::kPrimary && GetState() != STATE_DISABLED) {
+      color = hot ? kAccentHover : kAccent;
+    }
+    SetBackground(views::CreateRoundedRectBackground(color, 6));
+  }
+
+  const Style style_;
+};
