+class PlutoniumTabPresenter;
+class PlutoniumTabSession;
+class Profile;
+
+// EXO-SHELLS: PlutoniumShells with a fullscreen app window per enabled
+// shell. The startup browser (--plutonium-shell-url, opened as --app) is the
+// startup shell's window; the other shells' windows are opened hidden once
+// it exists. EXO-DISPLAYS: that's on every display, each with its own
+// visible shell.
+class PlutoniumShellsImpl : public PlutoniumShells,
+                            public BrowserCollectionObserver,
+                            public display::DisplayObserver,
+                            public wm::ActivationChangeObserver {
+ public:
+  PlutoniumShellsImpl();
+  ~PlutoniumShellsImpl() override;
+
+  // PlutoniumShells:
+  std::vector<Shell> GetShells() const override;
+  std::optional<Shell> GetShellFor(
+      const content::WebContents* contents) const override;
+  content::WebContents* GetVisibleContents() const override;
+  bool Show(const std::string& id) override;
+  void ShowNext(int step) override;
+  content::WebContents* GetContents(const std::string& id) const override;
+  std::optional<std::string> AddShell(const std::string& name,
+                                      const GURL& url) override;
+  bool UpdateShell(const std::string& id,
+                   const std::string& name,
+                   const GURL& url) override;
+  bool SetEnabled(const std::string& id, bool enabled) override;
+  bool Reload(const std::string& id, bool bypass_cache) override;
+  bool RemoveShell(const std::string& id) override;
+  bool MoveShell(const std::string& id, int delta) override;
+  bool OpenBackup(Backup backup, const GURL& url) override;
+  bool IsBackupOpen(Backup backup) const override;
+  void CloseBackup(Backup backup) override;
+  void OnSwitchKey(int step) override;
+  bool OpenSwitcher(const std::string& page) override;
+  std::string GetDisplayConfigJson() const override;
+  std::string ConfigureDisplays(const std::string& change_json) override;
+  std::vector<Display> GetDisplays() const override;
+  int64_t GetFocusedDisplayId() const override;
+  int64_t GetDisplayOf(const content::WebContents* contents) const override;
+  bool IsVisible(const content::WebContents* contents) const override;
+  content::WebContents* GetVisibleContentsOn(
+      int64_t display_id) const override;
+  bool ShowOn(const std::string& id, int64_t display_id) override;
+  content::WebContents* GetContentsOn(const std::string& id,
+                                      int64_t display_id) const override;
+  bool FocusDisplay(int64_t display_id) override;
+  bool SetDisplaysForTesting(const std::vector<std::string>& specs) override;
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+
+  // display::DisplayObserver:
+  void OnDisplayAdded(const display::Display& new_display) override;
+  void OnWillRemoveDisplays(const display::Displays& removed_displays) override;
+  void OnDisplaysRemoved(const display::Displays& removed_displays) override;
+  void OnDisplayMetricsChanged(const display::Display& display,
+                               uint32_t changed_metrics) override;
+
+  // wm::ActivationChangeObserver:
+  void OnWindowActivated(ActivationReason reason,
+                         aura::Window* gained_active,
+                         aura::Window* lost_active) override;
+
+ private:
+  // EXO-SHELLS: the active backup window goes above floating windows.
+  void RaiseActiveBackup(aura::Window* active);
+
+  struct Entry {
+    Entry();
+    Entry(const Entry&);
+    Entry& operator=(const Entry&);
+    ~Entry();
+
+    Shell shell;
+    // EXO-DISPLAYS: its window on each display.
+    std::map<int64_t, raw_ptr<BrowserWindowInterface>> browsers;
+  };
+
+  // Reads the list from local state and adds the command line's shells.
+  void Load();
+  void Save();
+  // Returns the shell's id.
+  std::string AddFromCommandLine(const std::string& name,
+                                 const GURL& url,
+                                 bool startup);
+  // Opens the windows of enabled shells that have none, hidden, on every
+  // display.
+  void OpenWindows(Profile* profile);
+  // Opens shell |entry|'s window on |display_id|: true if it did.
+  bool OpenWindow(Profile* profile, const Entry& entry, int64_t display_id);
+  static content::WebContents* ContentsOf(BrowserWindowInterface* browser);
+  Entry* Find(const std::string& id);
+  const Entry* Find(const std::string& id) const;
+  // The entry and display |browser| is the window of.
+  Entry* FindByBrowser(BrowserWindowInterface* browser, int64_t* display_id);
+  // The shell window showing |contents|.
+  BrowserWindowInterface* FindByBrowserContents(
+      const content::WebContents* contents) const;
+  // The running shells, in list order.
+  int RunningCount() const;
+  Shell StateOf(const Entry& entry) const;
+  // The visible shell on |display_id| ("" for none).
+  std::string VisibleOn(int64_t display_id) const;
+  // ShowOn(), activating the window or not.
+  bool DoShow(const std::string& id, int64_t display_id, bool activate);
+  // Shows the next running shell on |display_id|.
+  void ShowNextOn(int64_t display_id, int step);
+  // Picks the visible shell for a display that came (back): the one it last
+  // showed, else the startup shell. Doesn't move the focus.
+  void PickVisible(int64_t display_id);
+  void SaveDisplayShells();
+  // Starts watching displays and activation, once Ash is up.
+  void ObserveAsh();
+
+  std::vector<Entry> entries_;
+  // The shell the startup browser shows.
+  std::string startup_id_;
+  // Set while a shell's window is being opened, and where.
+  std::string opening_id_;
+  int64_t opening_display_ = 0;
+  // Set while a backup's window is being opened.
+  bool opening_backup_ = false;
+  raw_ptr<BrowserWindowInterface> backup_terminal_ = nullptr;
+  raw_ptr<BrowserWindowInterface> backup_browser_ = nullptr;
+  // EXO-DISPLAYS: the visible shell on each display.
+  std::map<int64_t, std::string> visible_;
+  // The display with keyboard focus, as last told.
+  int64_t focused_display_ = 0;
+  // The display the startup browser opened on. Pages there get no
+  // "display=" in their URL.
+  int64_t startup_display_ = 0;
+  // Whether the startup shell's page was announced (OpenWindows()).
+  bool told_startup_ = false;
+  // Whether OpenWindows() ran (at startup, focus goes to the startup
+  // display).
+  bool opened_once_ = false;
+  // The startup browser's: where the other shells' windows open.
+  raw_ptr<Profile> profile_ = nullptr;
+  std::unique_ptr<PlutoniumOverlay> overlay_;
+  // EXO-DISPLAYS: made once Ash is up (ObserveAsh()).
+  std::unique_ptr<PlutoniumDisplayConfig> display_config_;
+  // EXO-PRESENT: shows a tab on its own.
+  std::unique_ptr<PlutoniumTabPresenter> tab_presenter_;
+  // EXO-SESSION: the tabs, saved and restored.
+  std::unique_ptr<PlutoniumTabSession> tab_session_;
+  base::ScopedObservation<BrowserCollection, BrowserCollectionObserver>
+      browsers_observation_{this};
+  std::optional<display::ScopedDisplayObserver> display_observer_;
+  base::ScopedObservation<wm::ActivationClient, wm::ActivationChangeObserver>
+      activation_observation_{this};
+  base::WeakPtrFactory<PlutoniumShellsImpl> weak_ptr_factory_{this};
+};
