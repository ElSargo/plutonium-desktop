+
+bool PlutoniumShellsImpl::ShowOn(const std::string& id, int64_t display_id) {
+  return DoShow(id, display_id, /*activate=*/true);
+}
+
+bool PlutoniumShellsImpl::DoShow(const std::string& id,
+                                 int64_t display_id,
+                                 bool activate) {
+  Entry* entry = Find(id);
+  if (!entry || !entry->shell.enabled ||
+      !entry->browsers.contains(display_id)) {
+    return false;
+  }
+  BrowserWindowInterface* browser = entry->browsers[display_id];
+  // Whatever is in front of the shells goes behind them.
+  exo::EmbeddedWindows::Get()->EndPresentation();
+  PlutoniumTabs::Get()->EndPresentation();
+  const std::string previous_id = VisibleOn(display_id);
+  if (id == previous_id) {
+    if (activate) {
+      browser->GetWindow()->Show();
+      browser->GetWindow()->Activate();
+    } else {
+      browser->GetWindow()->ShowInactive();
+    }
+    return true;
+  }
+  content::WebContents* previous_contents =
+      GetContentsOn(previous_id, display_id);
+  Entry* previous = Find(previous_id);
+  visible_[display_id] = id;
+  SaveDisplayShells();
+  LOG(WARNING) << "EXO-SHELLS showing " << id << " \"" << entry->shell.name
+               << "\" on display " << display_id;
+  // Before its window is activated: activation restores the page's focus,
+  // which may be in a tab whose view must be in that window by then.
+  NotifyVisibleShellChanged(previous_contents, ContentsOf(browser));
+  if (activate) {
+    browser->GetWindow()->Show();
+    browser->GetWindow()->Activate();
+  } else {
+    browser->GetWindow()->ShowInactive();
+  }
+  if (previous && previous->browsers.contains(display_id)) {
+    previous->browsers[display_id]->GetWindow()->Hide();
+  }
+  NotifyShellsChanged();
+  return true;
+}
+
+void PlutoniumShellsImpl::ShowNext(int step) {
+  ShowNextOn(GetFocusedDisplayId(), step);
+}
+
+void PlutoniumShellsImpl::ShowNextOn(int64_t display_id, int step) {
+  std::vector<std::string> running;
+  for (const Entry& entry : entries_) {
+    if (entry.shell.enabled && entry.browsers.contains(display_id)) {
+      running.push_back(entry.shell.id);
+    }
+  }
+  if (running.empty()) {
+    return;
+  }
+  auto it = std::ranges::find(running, VisibleOn(display_id));
+  const int count = static_cast<int>(running.size());
+  const int current =
+      it == running.end() ? -step : static_cast<int>(it - running.begin());
+  ShowOn(running[((current + step) % count + count) % count], display_id);
+}
+
+void PlutoniumShellsImpl::OnBrowserCreated(BrowserWindowInterface* browser) {
+  if (browser->GetType() != BrowserWindowInterface::TYPE_APP ||
+      opening_backup_) {
+    return;
+  }
+  if (!opening_id_.empty()) {
+    if (Entry* entry = Find(opening_id_)) {
+      entry->browsers[opening_display_] = browser;
+    }
+    return;
+  }
+  Entry* startup = Find(startup_id_);
+  if (!startup || !startup->browsers.empty() || profile_) {
+    return;
+  }
+  // The startup browser: the --app window for --plutonium-shell-url, on the
+  // display new windows open on (the primary one, at startup).
+  ObserveAsh();
+  const int64_t display_id = GetFocusedDisplayId();
+  startup->browsers[display_id] = browser;
+  profile_ = browser->GetProfile();
+  tab_session_ = std::make_unique<PlutoniumTabSession>(profile_);
+  startup_display_ = display_id;
+  visible_[display_id] = startup_id_;
+  // Once it has its page and is shown; the other shells' windows come next.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PlutoniumShellsImpl::OpenWindows,
+                                weak_ptr_factory_.GetWeakPtr(),
+                                browser->GetProfile()));
+}
+
+void PlutoniumShellsImpl::OnBrowserClosed(BrowserWindowInterface* browser) {
+  if (browser == backup_terminal_ || browser == backup_browser_) {
+    (browser == backup_terminal_ ? backup_terminal_ : backup_browser_) =
+        nullptr;
+    NotifyShellsChanged();
+    return;
+  }
+  int64_t display_id = display::kInvalidDisplayId;
+  Entry* entry = FindByBrowser(browser, &display_id);
+  if (!entry) {
+    return;
+  }
+  entry->browsers.erase(display_id);
+  LOG(WARNING) << "EXO-SHELLS shell " << entry->shell.id
+               << "'s window on display " << display_id << " closed";
+  if (VisibleOn(display_id) == entry->shell.id) {
+    visible_.erase(display_id);
+    if (!browser_shutdown::HasShutdownStarted()) {
+      NotifyVisibleShellChanged(nullptr, nullptr);
+      ShowNextOn(display_id, 1);
+    }
+  }
+  NotifyShellsChanged();
+}
+
+void PlutoniumShellsImpl::OpenWindows(Profile* profile) {
+  if (browser_shutdown::HasShutdownStarted()) {
+    return;
+  }
+  if (!told_startup_) {
+    told_startup_ = true;
+    // The startup shell's page exists now: tell the rest of the browser.
+    if (content::WebContents* startup =
+            GetContentsOn(VisibleOn(startup_display_), startup_display_)) {
+      NotifyVisibleShellChanged(nullptr, startup);
+      // EXO-SESSION: the tabs from before (in the shells' profile).
+      if (tab_session_) {
+        tab_session_->Restore(startup);
+      }
+    }
+  }
+  // Opening windows on other displays moves the focus there: it goes back
+  // (at startup, to the startup display).
+  const int64_t focused = DisplayExists(startup_display_) && !opened_once_
+                              ? startup_display_
+                              : GetFocusedDisplayId();
+  opened_once_ = true;
+  // EXO-DISPLAYS: every enabled shell on every display.
+  std::vector<int64_t> opened_on;
+  for (const display::Display& display : SortedDisplays()) {
+    for (const Entry& entry : std::vector<Entry>(entries_)) {
+      if (entry.shell.enabled && !entry.browsers.contains(display.id()) &&
+          OpenWindow(profile, entry, display.id()) &&
+          !std::ranges::contains(opened_on, display.id())) {
+        opened_on.push_back(display.id());
+      }
+    }
+  }
+  // A display that came (back): the shell it showed last, if it can.
+  for (int64_t display_id : opened_on) {
+    PickVisible(display_id);
+  }
+  if (overlay_->IsOpen()) {
+    // Started from the overlay: it stays.
+    overlay_->Reactivate();
+  } else if (content::WebContents* visible = GetVisibleContentsOn(focused)) {
+    if (BrowserWindowInterface* browser =
+            FindByBrowserContents(visible)) {
+      browser->GetWindow()->Activate();
+    }
+  }
+  NotifyShellsChanged();
+}
+
+bool PlutoniumShellsImpl::OpenWindow(Profile* profile,
+                                     const Entry& entry,
+                                     int64_t display_id) {
+  opening_id_ = entry.shell.id;
+  opening_display_ = display_id;
+  {
+    // EXO-DISPLAYS: on that display; the pages there know which it is,
+    // except on the startup display (as before there were several).
+    display::ScopedDisplayForNewWindows scoped_display(display_id);
+    OpenAppShortcutWindow(profile, display_id == startup_display_
+                                       ? entry.shell.url
+                                       : WithDisplay(entry.shell.url,
+                                                     display_id));
+  }
+  opening_id_.clear();
+  opening_display_ = display::kInvalidDisplayId;
+  Entry* opened = Find(entry.shell.id);
+  if (!opened || !opened->browsers.contains(display_id)) {
+    LOG(ERROR) << "EXO-SHELLS could not open shell " << entry.shell.id
+               << " on display " << display_id;
+    return false;
+  }
+  BrowserWindowInterface* browser = opened->browsers[display_id];
+  LOG(WARNING) << "EXO-SHELLS opened shell " << entry.shell.id << " \""
+               << entry.shell.name << "\" on display " << display_id;
+  // An app window opens where it last was (its saved bounds), whatever the
+  // display for new windows: put it on its display before it goes
+  // fullscreen there.
+  display::Display display;
+  aura::Window* window = browser->GetWindow()->GetNativeWindow();
+  if (window &&
+      display::Screen::Get()->GetDisplayWithDisplayId(display_id, &display) &&
+      display::Screen::Get()->GetDisplayNearestWindow(window).id() !=
+          display_id) {
+    window->SetBoundsInScreen(display.work_area(), display);
+  }
+  chrome::ToggleFullscreenMode(browser, /*user_initiated=*/false);
+  if (GetVisibleContentsOn(display_id)) {
+    browser->GetWindow()->Hide();
+  } else {
+    // Nothing was visible there (a new display, or the startup shell's
+    // window is gone).
+    visible_[display_id] = opened->shell.id;
+    NotifyVisibleShellChanged(nullptr, ContentsOf(browser));
+  }
+  return true;
+}
+
+content::WebContents* PlutoniumShellsImpl::GetContents(
+    const std::string& id) const {
+  const Entry* entry = Find(id);
+  if (!entry || entry->browsers.empty()) {
+    return nullptr;
+  }
+  const int64_t focused = GetFocusedDisplayId();
+  if (VisibleOn(focused) == id) {
+    return GetContentsOn(id, focused);
+  }
+  for (const auto& [display_id, browser] : entry->browsers) {
+    if (VisibleOn(display_id) == id) {
+      return ContentsOf(browser);
+    }
+  }
+  if (content::WebContents* contents = GetContentsOn(id, focused)) {
+    return contents;
+  }
+  return ContentsOf(entry->browsers.begin()->second);
+}
+
+content::WebContents* PlutoniumShellsImpl::GetContentsOn(
+    const std::string& id,
+    int64_t display_id) const {
+  const Entry* entry = Find(id);
+  if (!entry) {
+    return nullptr;
+  }
+  auto it = entry->browsers.find(display_id);
+  return it == entry->browsers.end() ? nullptr : ContentsOf(it->second);
+}
+
+std::optional<std::string> PlutoniumShellsImpl::AddShell(
+    const std::string& name,
+    const GURL& url) {
+  if (!plutonium_shell::IsAcceptableShellUrl(url)) {
+    return std::nullopt;
+  }
+  Entry entry;
+  entry.shell.id = NewId();
+  entry.shell.name = name.empty() ? url.host() : name;
+  entry.shell.url = url;
+  entry.shell.origin = url::Origin::Create(url);
+  const std::string id = entry.shell.id;
+  entries_.push_back(std::move(entry));
+  Save();
+  LOG(WARNING) << "EXO-SHELLS added shell " << id << " (" << url.spec()
+               << ")";
+  if (profile_) {
+    OpenWindows(profile_);
+  } else {
+    NotifyShellsChanged();
+  }
+  return id;
+}
+
+bool PlutoniumShellsImpl::UpdateShell(const std::string& id,
+                                      const std::string& name,
+                                      const GURL& url) {
+  Entry* entry = Find(id);
+  if (!entry || !plutonium_shell::IsAcceptableShellUrl(url)) {
+    return false;
+  }
+  if (!name.empty()) {
+    entry->shell.name = name;
+  }
+  if (url != entry->shell.url) {
+    entry->shell.url = url;
+    // The startup shell keeps --plutonium-shell-origin's origin only for its
+    // command-line URL.
+    entry->shell.origin = url::Origin::Create(url);
+    for (const auto& [display_id, browser] : entry->browsers) {
+      if (content::WebContents* contents = ContentsOf(browser)) {
+        contents->GetController().LoadURL(
+            display_id == startup_display_ ? url
+                                           : WithDisplay(url, display_id),
+            content::Referrer(), ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+            std::string());
+      }
+    }
+  }
+  Save();
+  NotifyShellsChanged();
+  return true;
+}
+
+bool PlutoniumShellsImpl::SetEnabled(const std::string& id, bool enabled) {
+  Entry* entry = Find(id);
+  if (!entry) {
+    return false;
+  }
+  if (enabled == entry->shell.enabled) {
+    return true;
+  }
+  if (!enabled) {
+    if (!entry->browsers.empty() && RunningCount() <= 1) {
+      return false;
+    }
+    for (const auto& [display_id, visible_id] :
+         std::map<int64_t, std::string>(visible_)) {
+      if (visible_id == id) {
+        ShowNextOn(display_id, 1);
+      }
+    }
+  }
+  entry->shell.enabled = enabled;
+  Save();
+  LOG(WARNING) << "EXO-SHELLS shell " << id << (enabled ? " on" : " off");
+  if (!enabled) {
+    // OnBrowserClosed() forgets each.
+    for (const auto& [display_id, browser] :
+         std::map<int64_t, raw_ptr<BrowserWindowInterface>>(
+             entry->browsers)) {
+      browser->GetWindow()->Close();
+    }
+    NotifyShellsChanged();
+  } else if (profile_) {
+    OpenWindows(profile_);
+  }
+  return true;
+}
+
+bool PlutoniumShellsImpl::Reload(const std::string& id, bool bypass_cache) {
+  Entry* entry = Find(id);
+  if (!entry || entry->browsers.empty()) {
+    return false;
+  }
+  LOG(WARNING) << "EXO-SHELLS reloading shell " << id
+               << (bypass_cache ? " (bypassing the cache)" : "");
+  // Its page on every display.
+  for (const auto& [display_id, browser] : entry->browsers) {
+    if (content::WebContents* contents = ContentsOf(browser)) {
+      contents->GetController().Reload(
+          bypass_cache ? content::ReloadType::BYPASSING_CACHE
+                       : content::ReloadType::NORMAL,
+          /*check_for_repost=*/false);
+    }
+  }
+  return true;
+}
+
+bool PlutoniumShellsImpl::MoveShell(const std::string& id, int delta) {
+  auto it = std::ranges::find_if(
+      entries_, [&](const Entry& entry) { return entry.shell.id == id; });
+  if (it == entries_.end()) {
+    return false;
+  }
+  const int from = static_cast<int>(it - entries_.begin());
+  const int to = std::clamp(from + delta, 0,
+                            static_cast<int>(entries_.size()) - 1);
+  if (to == from) {
+    return true;
+  }
+  Entry entry = std::move(*it);
+  entries_.erase(it);
+  entries_.insert(entries_.begin() + to, std::move(entry));
+  Save();
+  NotifyShellsChanged();
+  return true;
+}
+
+bool PlutoniumShellsImpl::OpenBackup(Backup backup, const GURL& url) {
+  if (!profile_ || browser_shutdown::HasShutdownStarted()) {
+    return false;
+  }
+  exo::EmbeddedWindows::Get()->EndPresentation();
+  PlutoniumTabs::Get()->EndPresentation();
+  raw_ptr<BrowserWindowInterface>& browser =
+      backup == Backup::kTerminal ? backup_terminal_ : backup_browser_;
+  if (!browser) {
+    const GURL terminal = GetTerminalUrl();
+    if (backup == Backup::kTerminal && !terminal.is_valid()) {
+      return false;
+    }
+    // Not shells' windows: OnBrowserCreated() leaves them alone.
+    opening_backup_ = true;
+    if (backup == Backup::kTerminal) {
+      content::WebContents* contents =
+          OpenAppShortcutWindow(profile_, terminal);
+      tabs::TabInterface* tab =
+          contents ? tabs::TabInterface::MaybeGetFromContents(contents)
+                   : nullptr;
+      browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+    } else {
+      browser = chrome::OpenEmptyWindow(profile_,
+                                        /*should_trigger_session_restore=*/
+                                        false);
+    }
+    opening_backup_ = false;
+    if (!browser) {
+      LOG(ERROR) << "EXO-SHELLS could not open the backup "
+                 << (backup == Backup::kTerminal ? "terminal" : "browser");
+      return false;
+    }
+    LOG(WARNING) << "EXO-SHELLS opened the backup "
+                 << (backup == Backup::kTerminal ? "terminal" : "browser");
+    if (backup == Backup::kBrowser && url.is_empty() &&
+        !browser->GetActiveTabInterface()) {
+      chrome::AddTabAt(browser, GURL(), -1, /*foreground=*/true);
+    }
+  }
+  if (backup == Backup::kBrowser && url.is_valid()) {
+    chrome::AddTabAt(browser, url, -1, /*foreground=*/true);
+  }
+  browser->GetWindow()->Show();
+  browser->GetWindow()->Maximize();
+  browser->GetWindow()->Activate();
+  NotifyShellsChanged();
+  return true;
+}
+
+// EXO-SHELLS: the backup window in front covers everything below the
+// switcher, including what floats above normal windows (the popups of a
+// window a shell behind it shows); once something else is active (a
+// presented window or tab, a shell), it's an ordinary window again.
+void PlutoniumShellsImpl::RaiseActiveBackup(aura::Window* active) {
+  for (BrowserWindowInterface* browser :
+       {backup_terminal_.get(), backup_browser_.get()}) {
+    if (!browser || !browser->GetWindow()) {
+      continue;
+    }
+    aura::Window* window = browser->GetWindow()->GetNativeWindow();
+    views::Widget* widget = views::Widget::GetWidgetForNativeWindow(window);
+    if (!widget) {
+      continue;
+    }
+    const bool front = active && window->Contains(active);
+    widget->SetZOrderLevel(front ? ui::ZOrderLevel::kFloatingUIElement
+                                 : ui::ZOrderLevel::kNormal);
+  }
+}
+
+bool PlutoniumShellsImpl::IsBackupOpen(Backup backup) const {
+  return !!(backup == Backup::kTerminal ? backup_terminal_ : backup_browser_);
+}
+
+void PlutoniumShellsImpl::CloseBackup(Backup backup) {
+  BrowserWindowInterface* browser =
+      backup == Backup::kTerminal ? backup_terminal_ : backup_browser_;
+  if (browser) {
+    // OnBrowserClosed() forgets it.
+    browser->GetWindow()->Close();
+  }
+}
+
+bool PlutoniumShellsImpl::RemoveShell(const std::string& id) {
+  Entry* entry = Find(id);
+  if (!entry || !SetEnabled(id, false)) {
+    return false;
+  }
+  std::erase_if(entries_,
+                [&](const Entry& entry) { return entry.shell.id == id; });
+  if (startup_id_ == id) {
+    startup_id_.clear();
+  }
+  Save();
+  PlutoniumGroups::Get()->RemoveShell(id);
+  LOG(WARNING) << "EXO-SHELLS removed shell " << id;
+  NotifyShellsChanged();
+  return true;
+}
+
+void PlutoniumShellsImpl::OnSwitchKey(int step) {
+  overlay_->OnSwitchKey(step);
+}
+
+bool PlutoniumShellsImpl::OpenSwitcher(const std::string& page) {
+  return overlay_->OpenPage(page);
+}
+
+std::string PlutoniumShellsImpl::GetDisplayConfigJson() const {
+  if (!display_config_) {
+    return "{\"displays\":[]}";
+  }
+  return base::WriteJson(display_config_->GetConfig()).value_or("{}");
+}
+
+std::string PlutoniumShellsImpl::ConfigureDisplays(
+    const std::string& change_json) {
+  if (!display_config_) {
+    return "There are no displays yet.";
+  }
+  std::optional<base::DictValue> change =
+      base::JSONReader::ReadDict(change_json, base::JSON_PARSE_RFC);
+  if (!change) {
+    return "The change isn't a JSON object.";
+  }
+  return display_config_->Configure(*change);
+}
+
+int PlutoniumShellsImpl::RunningCount() const {
+  return static_cast<int>(std::ranges::count_if(entries_, [](const Entry& entry) {
+    return entry.shell.enabled && !entry.browsers.empty();
+  }));
+}
+
+// static
+content::WebContents* PlutoniumShellsImpl::ContentsOf(
+    BrowserWindowInterface* browser) {
+  if (!browser) {
+    return nullptr;
+  }
+  tabs::TabInterface* tab = browser->GetActiveTabInterface();
+  return tab ? tab->GetContents() : nullptr;
+}
+
+PlutoniumShellsImpl::Entry* PlutoniumShellsImpl::FindByBrowser(
+    BrowserWindowInterface* browser,
+    int64_t* display_id) {
+  for (Entry& entry : entries_) {
+    for (const auto& [id, entry_browser] : entry.browsers) {
+      if (entry_browser == browser) {
+        *display_id = id;
+        return &entry;
+      }
+    }
+  }
+  return nullptr;
+}
+
+BrowserWindowInterface* PlutoniumShellsImpl::FindByBrowserContents(
+    const content::WebContents* contents) const {
+  for (const Entry& entry : entries_) {
+    for (const auto& [display_id, browser] : entry.browsers) {
+      if (ContentsOf(browser) == contents) {
+        return browser;
+      }
+    }
+  }
+  return nullptr;
+}
+
+PlutoniumShellsImpl::Entry* PlutoniumShellsImpl::Find(const std::string& id) {
+  if (id.empty()) {
+    return nullptr;
+  }
+  auto it = std::ranges::find_if(
+      entries_, [&](const Entry& entry) { return entry.shell.id == id; });
+  return it == entries_.end() ? nullptr : &*it;
+}
+
+const PlutoniumShellsImpl::Entry* PlutoniumShellsImpl::Find(
+    const std::string& id) const {
+  return const_cast<PlutoniumShellsImpl*>(this)->Find(id);
+}
+
+PlutoniumShells::Shell PlutoniumShellsImpl::StateOf(const Entry& entry) const {
+  Shell shell = entry.shell;
+  shell.running = !entry.browsers.empty();
+  shell.visible = VisibleOn(GetFocusedDisplayId()) == entry.shell.id;
+  for (const auto& [display_id, browser] : entry.browsers) {
+    shell.displays.push_back(display_id);
+    if (VisibleOn(display_id) == entry.shell.id) {
+      shell.visible_on.push_back(display_id);
+    }
+  }
+  return shell;
+}
+
+std::string PlutoniumShellsImpl::VisibleOn(int64_t display_id) const {
+  auto it = visible_.find(display_id);
+  return it == visible_.end() ? std::string() : it->second;
+}
+
+void PlutoniumShellsImpl::PickVisible(int64_t display_id) {
+  // The startup display shows the startup shell first, as before.
+  if (display_id == startup_display_) {
+    return;
+  }
+  const base::DictValue& saved = g_browser_process->local_state()->GetDict(
+      kDisplayShellsPref);
+  const std::string* last = saved.FindString(base::NumberToString(display_id));
+  // The shell it showed last, else the startup shell (the desktop).
+  const std::string id =
+      last && GetContentsOn(*last, display_id) ? *last : startup_id_;
+  if (!id.empty() && GetContentsOn(id, display_id) &&
+      id != VisibleOn(display_id)) {
+    DoShow(id, display_id, /*activate=*/false);
+  }
+}
+
+void PlutoniumShellsImpl::SaveDisplayShells() {
+  ScopedDictPrefUpdate update(g_browser_process->local_state(),
+                              kDisplayShellsPref);
+  for (const auto& [display_id, id] : visible_) {
+    update->Set(base::NumberToString(display_id), id);
+  }
+}
+
+void PlutoniumShellsImpl::ObserveAsh() {
+  if (display_observer_ || !ash::Shell::HasInstance()) {
+    return;
+  }
+  display_observer_.emplace(this);
+  display_config_ = std::make_unique<PlutoniumDisplayConfig>();
+  activation_observation_.Observe(ash::Shell::Get()->activation_client());
+  focused_display_ = display::Screen::Get()->GetDisplayForNewWindows().id();
+}
+
+std::vector<PlutoniumShells::Display> PlutoniumShellsImpl::GetDisplays()
+    const {
+  std::vector<Display> result;
+  if (!display::Screen::Get()) {
+    return result;
+  }
+  const int64_t primary = display::Screen::Get()->GetPrimaryDisplay().id();
+  const int64_t focused = GetFocusedDisplayId();
+  display::DisplayManager* manager =
+      ash::Shell::HasInstance() ? ash::Shell::Get()->display_manager()
+                                : nullptr;
+  for (const display::Display& display : SortedDisplays()) {
+    Display entry;
+    entry.id = display.id();
+    entry.index = static_cast<int>(result.size()) + 1;
+    entry.label = !display.label().empty() ? display.label()
+                  : manager ? manager->GetDisplayNameForId(display.id())
+                            : std::string();
+    entry.bounds = display.bounds();
+    entry.work_area = display.work_area();
+    entry.scale_factor = display.device_scale_factor();
+    entry.rotation = display.RotationAsDegree();
+    entry.primary = display.id() == primary;
+    entry.internal = display.IsInternal();
+    entry.focused = display.id() == focused;
+    result.push_back(std::move(entry));
+  }
+  return result;
+}
+
+int64_t PlutoniumShellsImpl::GetFocusedDisplayId() const {
+  if (DisplayExists(focused_display_)) {
+    return focused_display_;
+  }
+  return display::Screen::Get()
+             ? display::Screen::Get()->GetDisplayForNewWindows().id()
+             : display::kInvalidDisplayId;
+}
+
+int64_t PlutoniumShellsImpl::GetDisplayOf(
+    const content::WebContents* contents) const {
+  if (!contents) {
+    return display::kInvalidDisplayId;
+  }
+  contents = const_cast<content::WebContents*>(contents)
+                 ->GetOutermostWebContents();
+  for (const Entry& entry : entries_) {
+    for (const auto& [display_id, browser] : entry.browsers) {
+      if (ContentsOf(browser) == contents) {
+        return display_id;
+      }
+    }
+  }
+  return display::kInvalidDisplayId;
+}
+
+bool PlutoniumShellsImpl::IsVisible(
+    const content::WebContents* contents) const {
+  const int64_t display_id = GetDisplayOf(contents);
+  if (display_id == display::kInvalidDisplayId) {
+    return false;
+  }
+  return GetVisibleContentsOn(display_id) ==
+         const_cast<content::WebContents*>(contents)
+             ->GetOutermostWebContents();
+}
+
+bool PlutoniumShellsImpl::FocusDisplay(int64_t display_id) {
+  content::WebContents* visible = GetVisibleContentsOn(display_id);
+  BrowserWindowInterface* browser =
+      visible ? FindByBrowserContents(visible) : nullptr;
+  if (!browser) {
+    return false;
+  }
+  exo::EmbeddedWindows::Get()->EndPresentation();
+  PlutoniumTabs::Get()->EndPresentation();
+  browser->GetWindow()->Show();
+  browser->GetWindow()->Activate();
+  return true;
+}
+
+bool PlutoniumShellsImpl::SetDisplaysForTesting(
+    const std::vector<std::string>& specs) {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          kTestDisplaysSwitch) ||
+      specs.empty() || !ash::Shell::HasInstance()) {
+    return false;
+  }
+  std::vector<display::ManagedDisplayInfo> infos;
+  for (const std::string& item : specs) {
+    // "<id>:<spec>" keeps a display's id; a bare spec is a new display.
+    std::string spec = item;
+    int64_t id = display::kInvalidDisplayId;
+    if (size_t colon = item.find(':'); colon != std::string::npos) {
+      if (!base::StringToInt64(item.substr(0, colon), &id)) {
+        return false;
+      }
+      spec = item.substr(colon + 1);
+    }
+    infos.push_back(
+        display::ManagedDisplayInfo::CreateFromSpecWithID(spec, id));
+  }
+  LOG(WARNING) << "EXO-DISPLAYS testing with " << infos.size()
+               << " display(s)";
+  ash::Shell::Get()->display_manager()->OnNativeDisplaysChanged(infos);
+  return true;
+}
+
+void PlutoniumShellsImpl::OnDisplayAdded(const display::Display& new_display) {
+  LOG(WARNING) << "EXO-DISPLAYS display " << new_display.id() << " added ("
+               << new_display.bounds().ToString() << ")";
+  NotifyDisplaysChanged();
+  // Not from inside the display manager's update.
+  if (profile_) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&PlutoniumShellsImpl::OpenWindows,
+                                  weak_ptr_factory_.GetWeakPtr(),
+                                  profile_.get()));
+  }
+}
+
+void PlutoniumShellsImpl::OnWillRemoveDisplays(
+    const display::Displays& removed_displays) {
+  // Ash moves their windows to another display: they go out of sight first,
+  // so that only that display's own shell shows there.
+  for (const display::Display& display : removed_displays) {
+    for (Entry& entry : entries_) {
+      auto it = entry.browsers.find(display.id());
+      if (it != entry.browsers.end()) {
+        it->second->GetWindow()->Hide();
+      }
+    }
+  }
+}
+
+void PlutoniumShellsImpl::OnDisplaysRemoved(
+    const display::Displays& removed_displays) {
+  for (const display::Display& display : removed_displays) {
+    LOG(WARNING) << "EXO-DISPLAYS display " << display.id() << " removed";
+    const std::string visible_id = VisibleOn(display.id());
+    for (Entry& entry : entries_) {
+      auto it = entry.browsers.find(display.id());
+      if (it == entry.browsers.end()) {
+        continue;
+      }
+      BrowserWindowInterface* browser = it->second;
+      // Forgotten first: OnBrowserClosed() has nothing to show instead.
+      entry.browsers.erase(it);
+      if (entry.shell.id == visible_id) {
+        NotifyVisibleShellChanged(ContentsOf(browser), nullptr);
+      }
+      browser->GetWindow()->Close();
+    }
+    visible_.erase(display.id());
+  }
+  NotifyDisplaysChanged();
+  NotifyShellsChanged();
+}
+
+void PlutoniumShellsImpl::OnDisplayMetricsChanged(
+    const display::Display& display,
+    uint32_t changed_metrics) {
+  NotifyDisplaysChanged();
+}
+
+void PlutoniumShellsImpl::OnWindowActivated(ActivationReason reason,
+                                            aura::Window* gained_active,
+                                            aura::Window* lost_active) {
+  RaiseActiveBackup(gained_active);
+  if (!gained_active) {
+    return;
+  }
+  const int64_t display_id =
+      display::Screen::Get()->GetDisplayNearestWindow(gained_active).id();
+  if (display_id == focused_display_) {
+    return;
+  }
+  focused_display_ = display_id;
+  VLOG(1) << "EXO-DISPLAYS focus on display " << display_id;
+  // Hidden tabs park in, and tab keys go to, the focused display's shell
+  // (not from inside activation).
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<PlutoniumShellsImpl> self) {
+                       if (content::WebContents* visible =
+                               self ? self->GetVisibleContents() : nullptr) {
+                         PlutoniumTabs::Get()->SetShell(visible);
+                       }
+                     },
+                     weak_ptr_factory_.GetWeakPtr()));
+  NotifyDisplaysChanged();
+  NotifyShellsChanged();
+}
