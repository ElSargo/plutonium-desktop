+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_DISPLAY_CONFIG_H_
+#define CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_DISPLAY_CONFIG_H_
+
+#include <optional>
+#include <string>
+
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "ui/display/display_observer.h"
+#include "ui/display/manager/display_configurator.h"
+#include "ui/display/types/display_constants.h"
+
+// EXO-DISPLAYS (MULTI_MONITOR.md, "Configuring displays"): the displays'
+// configuration, for the switcher's Displays page and, through the Plutonium
+// DevTools domain, the helper's display service. It is Ash's own
+// (CrosDisplayConfigImpl, as ChromeOS's Settings uses): where each display
+// is, its mode (resolution and refresh rate), its size (zoom), rotation,
+// which one is primary, mirroring, and the built-in panel off while a
+// monitor is on (DisplayConfigurator's power state).
+//
+// JSON, as the helper's display service gives it (display ids are strings:
+// they don't fit in a double):
+//   { displays: [{ id, index, name, internal, primary, enabled, bounds,
+//                  workArea, rotation, scale, zoom, zooms, mode, modes }],
+//     mirror, canMirror, pending: { what, secondsLeft } | null }
+// A change (Configure()), one of:
+//   { display, mode?: {width, height, refreshRate?}, zoom?, rotation?,
+//     primary?: true, position?: {x, y}, enabled?, confirm? }
+//   { layout: [{ display, x, y }] }     where each display goes (DIPs)
+//   { mirror: bool, confirm? }
+//   { keep: true } / { revert: true }   the change waiting for Keep
+// With |confirm|, a change that could leave the user without a usable
+// screen (a mode, size, rotation, mirroring, the panel off) goes back by
+// itself after kConfirmTime unless kept.
+class PlutoniumDisplayConfig : public display::DisplayObserver {
+ public:
+  static constexpr base::TimeDelta kConfirmTime = base::Seconds(15);
+
+  // Null outside shell mode (made by PlutoniumShellsImpl once Ash is up).
+  static PlutoniumDisplayConfig* Get();
+
+  PlutoniumDisplayConfig();
+  PlutoniumDisplayConfig(const PlutoniumDisplayConfig&) = delete;
+  PlutoniumDisplayConfig& operator=(const PlutoniumDisplayConfig&) = delete;
+  ~PlutoniumDisplayConfig() override;
+
+  base::DictValue GetConfig() const;
+  // "" once applied, else why not.
+  std::string Configure(const base::DictValue& change);
+
+  // The change waiting for Keep, if any.
+  bool HasPending() const { return pending_.has_value(); }
+  std::u16string PendingWhat() const;
+  int PendingSecondsLeft() const;
+
+  // EXO-LOCK: what turning the displays on means (the panel stays off if
+  // it was turned off here).
+  chromeos::DisplayPowerState PowerStateForOn() const;
+  bool IsInternalOff() const { return internal_off_; }
+
+  // display::DisplayObserver:
+  void OnDisplaysRemoved(const display::Displays& removed_displays) override;
+
+ private:
+  struct Pending {
+    Pending();
+    Pending(Pending&&);
+    Pending& operator=(Pending&&);
+    ~Pending();
+
+    std::u16string what;
+    // The change that puts it back.
+    base::DictValue undo;
+    base::TimeTicks deadline;
+  };
+
+  std::string ConfigureDisplay(const base::DictValue& change, bool confirm);
+  std::string Arrange(const base::ListValue& layout);
+  std::string SetMirror(bool on, bool confirm);
+  std::string SetInternalEnabled(int64_t id, bool enabled, bool confirm);
+  void SetPending(std::u16string what, base::DictValue undo);
+  void RevertPending();
+
+  bool internal_off_ = false;
+  int64_t internal_id_ = display::kInvalidDisplayId;
+  // The panel's entry from before it went off (GetConfig() lists it).
+  base::DictValue internal_entry_;
+  std::optional<Pending> pending_;
+  base::OneShotTimer revert_timer_;
+  display::ScopedDisplayObserver display_observer_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_DISPLAY_CONFIG_H_
