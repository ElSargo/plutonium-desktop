new file mode 100644
index 0000000000..57fc8e8909
--- /dev/null
+++ b/chrome/browser/ui/ash/main_extra_parts/plutonium_helper_client.cc
@@ -0,0 +1,205 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/ash/main_extra_parts/plutonium_helper_client.h"
+
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <array>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/files/scoped_file.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "chrome/browser/plutonium_shells.h"
+
+namespace plutonium_helper {
+
+namespace {
+
+struct Response {
+  int status = 0;
+  std::string body;
+  std::string error;
+};
+
+std::string SocketPath() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      PlutoniumShells::kHelperSocketSwitch);
+}
+
+// One HTTP/1.0 request (the helper then neither keeps the connection nor
+// chunks the answer: the body is everything after the headers).
+Response Request(const std::string& socket_path, const std::string& request) {
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::WILL_BLOCK);
+  Response response;
+  sockaddr_un address = {};
+  address.sun_family = AF_UNIX;
+  if (socket_path.empty() || socket_path.size() >= sizeof(address.sun_path)) {
+    response.error = "no helper socket";
+    return response;
+  }
+  base::span(address.sun_path)
+      .first(socket_path.size())
+      .copy_from(base::span(socket_path));
+  base::ScopedFD fd(socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0));
+  if (!fd.is_valid()) {
+    response.error = "socket() failed";
+    return response;
+  }
+  // Launching waits for nothing, listing reads a few files: don't hang on a
+  // stuck helper.
+  const timeval timeout = {.tv_sec = 15, .tv_usec = 0};
+  setsockopt(fd.get(), SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+  setsockopt(fd.get(), SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+  if (HANDLE_EINTR(connect(fd.get(), reinterpret_cast<sockaddr*>(&address),
+                           sizeof(address))) != 0) {
+    response.error = "the helper isn't running (" + socket_path + ")";
+    return response;
+  }
+  base::span<const char> unsent(request);
+  while (!unsent.empty()) {
+    ssize_t n = HANDLE_EINTR(
+        send(fd.get(), unsent.data(), unsent.size(), MSG_NOSIGNAL));
+    if (n <= 0) {
+      response.error = "couldn't write to the helper";
+      return response;
+    }
+    unsent = unsent.subspan(static_cast<size_t>(n));
+  }
+  std::string raw;
+  std::array<char, 16384> buffer;
+  while (true) {
+    ssize_t n = HANDLE_EINTR(read(fd.get(), buffer.data(), buffer.size()));
+    if (n < 0) {
+      response.error = "the helper didn't answer";
+      return response;
+    }
+    if (n == 0) {
+      break;
+    }
+    raw.append(base::as_string_view(
+        base::span(buffer).first(static_cast<size_t>(n))));
+    if (raw.size() > (32u << 20)) {
+      response.error = "the helper's answer is too large";
+      return response;
+    }
+  }
+  const size_t end = raw.find("\r\n\r\n");
+  if (end == std::string::npos) {
+    response.error = "the helper's answer is malformed";
+    return response;
+  }
+  // "HTTP/1.1 200 OK"
+  std::vector<std::string_view> status = base::SplitStringPiece(
+      std::string_view(raw).substr(0, raw.find("\r\n")), " ",
+      base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (status.size() < 2 || !base::StringToInt(status[1], &response.status)) {
+    response.error = "the helper's answer is malformed";
+    return response;
+  }
+  response.body = raw.substr(end + 4);
+  return response;
+}
+
+void Send(const std::string& method,
+          const std::string& path,
+          const std::string& body,
+          Callback callback) {
+  std::string request = method + " " + path +
+                        " HTTP/1.0\r\nHost: helper\r\nConnection: close\r\n";
+  if (method == "POST") {
+    request += "Content-Type: application/json\r\nContent-Length: " +
+               base::NumberToString(body.size()) + "\r\n";
+  }
+  request += "\r\n" + body;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&Request, SocketPath(), std::move(request)),
+      base::BindOnce(
+          [](Callback callback, Response response) {
+            std::optional<base::Value> value =
+                base::JSONReader::Read(response.body, base::JSON_PARSE_RFC);
+            if (!response.error.empty()) {
+              std::move(callback).Run(std::nullopt, response.error);
+              return;
+            }
+            if (response.status < 200 || response.status >= 300) {
+              // The helper's errors are {"error": "..."}.
+              const std::string* message =
+                  value && value->is_dict()
+                      ? value->GetDict().FindString("error")
+                      : nullptr;
+              std::move(callback).Run(
+                  std::nullopt,
+                  message ? *message
+                          : "the helper answered " +
+                                base::NumberToString(response.status));
+              return;
+            }
+            if (!value) {
+              std::move(callback).Run(std::nullopt,
+                                      "the helper's answer isn't JSON");
+              return;
+            }
+            std::move(callback).Run(std::move(value), std::string());
+          },
+          std::move(callback)));
+}
+
+}  // namespace
+
+bool IsAvailable() {
+  return !SocketPath().empty();
+}
+
+void Get(const std::string& path, Callback callback) {
+  Send("GET", path, std::string(), std::move(callback));
+}
+
+void Post(const std::string& path, base::DictValue body, Callback callback) {
+  std::string json;
+  base::JSONWriter::Write(body, &json);
+  Send("POST", path, json, std::move(callback));
+}
+
+void GetBytes(const std::string& path, BytesCallback callback) {
+  std::string request = "GET " + path +
+                        " HTTP/1.0\r\nHost: helper\r\nConnection: close\r\n\r\n";
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&Request, SocketPath(), std::move(request)),
+      base::BindOnce(
+          [](BytesCallback callback, Response response) {
+            if (!response.error.empty()) {
+              std::move(callback).Run(std::nullopt, response.error);
+            } else if (response.status < 200 || response.status >= 300) {
+              std::move(callback).Run(
+                  std::nullopt,
+                  "the helper answered " +
+                      base::NumberToString(response.status));
+            } else {
+              std::move(callback).Run(std::move(response.body),
+                                      std::string());
+            }
+          },
+          std::move(callback)));
+}
+
+}  // namespace plutonium_helper
