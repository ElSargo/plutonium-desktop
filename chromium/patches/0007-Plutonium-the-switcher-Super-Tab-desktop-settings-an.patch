+class PlutoniumAppIcons : public content::WebContentsObserver {
+ public:
+  static PlutoniumAppIcons* Get();
+
+  PlutoniumAppIcons(const PlutoniumAppIcons&) = delete;
+  PlutoniumAppIcons& operator=(const PlutoniumAppIcons&) = delete;
+
+  // The icon for app (or window app id) |id|: empty while it loads (then the
+  // callbacks run) or when there's none.
+  gfx::ImageSkia GetIcon(const std::string& id);
+
+  // |loaded| runs each time an icon arrives.
+  base::CallbackListSubscription AddLoadedCallback(
+      base::RepeatingClosure loaded);
+
+  // content::WebContentsObserver:
+  void DidStopLoading() override;
+
+ private:
+  friend class base::NoDestructor<PlutoniumAppIcons>;
+
+  enum class State { kLoading, kLoaded, kNone };
+  struct Entry {
+    State state = State::kLoading;
+    gfx::ImageSkia image;
+  };
+
+  PlutoniumAppIcons();
+  ~PlutoniumAppIcons() override;
+
+  void OnBytes(const std::string& id,
+               std::optional<std::string> body,
+               const std::string& error);
+  void Decode(const std::string& id, const std::string& data_url);
+  void OnDecoded(const std::string& id, const std::vector<SkBitmap>& bitmaps);
+  void Done(const std::string& id, gfx::ImageSkia image);
+  void DropDecoder();
+
+  std::map<std::string, Entry> icons_;
+  base::RepeatingClosureList loaded_callbacks_;
+  // The decoder (about:blank), and what waits for it to load.
+  std::unique_ptr<content::WebContents> decoder_;
+  bool decoder_ready_ = false;
+  std::vector<base::OnceClosure> waiting_;
+  int decoding_ = 0;
+  base::OneShotTimer drop_timer_;
+  base::WeakPtrFactory<PlutoniumAppIcons> weak_factory_{this};
+};
