+  // Shell page: its state, start/stop/reload, DevTools, its place in the
+  // list, editing and removing it.
+  void BuildShellPage(const std::string& id) {
+    std::optional<PlutoniumShells::Shell> shell = FindShell(id);
+    if (!shell) {
+      return;
+    }
+    content::WebContents* contents = shells_->GetContents(id);
+    SkColor color;
+    const std::u16string state = ShellState(*shell, &color);
+    std::vector<PlutoniumShells::Shell> shells = shells_->GetShells();
+    const int index = static_cast<int>(
+        std::ranges::find_if(shells,
+                             [&](const auto& s) { return s.id == id; }) -
+        shells.begin());
+    AddTitle(base::UTF8ToUTF16(shell->name), state, color,
+             u"Shell " + base::NumberToString16(index + 1) + u" of " +
+                 base::NumberToString16(shells.size()));
+
+    auto* actions = AddButtons(page_);
+    if (!shell->enabled) {
+      AddButton(actions, u"Start", Bind(&PlutoniumOverlayView::ToggleShell, id),
+                ActionButton::Style::kPrimary);
+    } else {
+      AddButton(actions, shell->visible ? u"Bring to front" : u"Switch to it",
+                Bind(&PlutoniumOverlayView::SwitchTo, id),
+                ActionButton::Style::kPrimary, shell->running);
+      AddButton(actions, u"Stop", Bind(&PlutoniumOverlayView::ToggleShell, id));
+    }
+    // EXO-DISPLAYS: each display has its own visible shell.
+    if (const std::vector<PlutoniumShells::Display> displays =
+            shells_->GetDisplays();
+        shell->running && displays.size() > 1) {
+      auto* on_display = AddButtons(page_);
+      for (const PlutoniumShells::Display& display : displays) {
+        const bool shown = std::ranges::contains(shell->visible_on, display.id);
+        AddButton(on_display,
+                  (shown ? u"Visible on display " : u"Show on display ") +
+                      base::NumberToString16(display.index),
+                  Bind(&PlutoniumOverlayView::ShowShellOn, id, display.id),
+                  ActionButton::Style::kNormal,
+                  std::ranges::contains(shell->displays, display.id));
+      }
+    }
+    AddButton(actions, u"Reload",
+              Bind(&PlutoniumOverlayView::ReloadShell, id, false),
+              ActionButton::Style::kNormal, !!contents);
+    AddButton(actions, u"Reload from the network",
+              Bind(&PlutoniumOverlayView::ReloadShell, id, true),
+              ActionButton::Style::kNormal, !!contents);
+    auto* more = AddButtons(page_);
+    AddButton(more, u"Open DevTools",
+              Bind(&PlutoniumOverlayView::OpenShellDevTools, id),
+              ActionButton::Style::kNormal, !!contents);
+    AddButton(more, u"Move up", Bind(&PlutoniumOverlayView::MoveShell, id, -1),
+              ActionButton::Style::kNormal, index > 0);
+    AddButton(more, u"Move down",
+              Bind(&PlutoniumOverlayView::MoveShell, id, 1),
+              ActionButton::Style::kNormal,
+              index + 1 < static_cast<int>(shells.size()));
+
+    if (const base::DictValue* package = PackageFor(*shell)) {
+      BuildPackageSections(*package);
+    }
+
+    auto* status = AddSection(u"Status");
+    std::u16string page_state =
+        !shell->enabled ? u"Not running: it's off"
+        : !contents     ? u"Its window is opening"
+        : contents->IsCrashed()
+            ? u"Its renderer crashed: reload it"
+        : contents->IsLoading() ? u"Loading"
+        : shell->visible        ? u"Loaded, on screen"
+                                : u"Loaded, hidden (throttled like a "
+                                  u"background tab, but running)";
+    AddField(status, u"Page", page_state);
+    AddField(status, u"Address", base::UTF8ToUTF16(shell->url.spec()));
+    if (contents && contents->GetLastCommittedURL().is_valid() &&
+        contents->GetLastCommittedURL() != shell->url) {
+      AddField(status, u"Showing",
+               base::UTF8ToUTF16(contents->GetLastCommittedURL().spec()));
+    }
+    if (contents) {
+      AddField(status, u"Title", contents->GetTitle());
+    }
+    AddField(status, u"Shell rights for",
+             base::UTF8ToUTF16(shell->origin.Serialize()));
+    std::vector<std::u16string> labels;
+    for (const PlutoniumGroups::Group& group :
+         PlutoniumGroups::Get()->groups()) {
+      if (group.shell_id == id) {
+        labels.push_back(base::UTF8ToUTF16(
+            group.label.empty() ? group.tag : group.label));
+      }
+    }
+    AddField(status, u"Groups",
+             labels.empty()
+                 ? u"none described"
+                 : base::NumberToString16(labels.size()) + u":  " +
+                       base::JoinString(labels, u",  "));
+    int shown = 0;
+    if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+      for (const ExoWindowBroker::WindowInfo& window : broker->GetWindows()) {
+        if (std::ranges::contains(ShellsShowing(window.id), id)) {
+          ++shown;
+        }
+      }
+    }
+    AddField(status, u"Windows it shows", base::NumberToString16(shown));
+
+    auto* edit = AddSection(u"Edit");
+    name_field_ = AddTextfield(edit, u"Name", u"Name",
+                               base::UTF8ToUTF16(shell->name));
+    url_field_ = AddTextfield(edit, u"Address", u"http://127.0.0.1:8770/?helper=…",
+                              base::UTF8ToUTF16(shell->url.spec()));
+    AddParagraph(edit,
+                 u"A new address loads in place. Enter in a field saves.",
+                 kDim);
+    auto* save = AddButtons(edit);
+    AddButton(save, u"Save changes", Bind(&PlutoniumOverlayView::SubmitForm));
+
+    auto* remove = AddSection(u"Remove");
+    AddParagraph(remove,
+                 u"Removing forgets the shell and the groups it described. "
+                 u"Its windows and tabs stay. An installed shell keeps its "
+                 u"folder, and is listed again, off, on the next start.",
+                 kDim);
+    auto* remove_row = AddButtons(remove);
+    AddButton(remove_row,
+              confirm_remove_id_ == id ? u"Remove it: click again"
+                                       : u"Remove",
+              Bind(&PlutoniumOverlayView::RemoveShell, id),
+              ActionButton::Style::kDanger, !shell->enabled);
+    if (shell->enabled) {
+      AddLabel(remove_row, u"Stop it first.", kDim);
+    }
+  }
