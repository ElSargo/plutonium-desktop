+// One line of a list: a state dot, a title and a dimmer detail below it.
+// Left click selects and acts, right click selects.
+class RowView : public views::View {
+  METADATA_HEADER(RowView, views::View)
+
+ public:
+  RowView(const Row& row,
+          bool selected,
+          base::RepeatingClosure on_click,
+          base::RepeatingClosure on_context_click)
+      : selected_(selected),
+        on_click_(on_click ? Deferred(std::move(on_click))
+                           : base::RepeatingClosure()),
+        on_context_click_(on_context_click
+                              ? Deferred(std::move(on_context_click))
+                              : base::RepeatingClosure()) {
+    // Hover stays on while the pointer is over the row's labels, which would
+    // otherwise take the enter/exit events from it.
+    SetNotifyEnterExitOnChild(true);
+    const bool header = row.kind == Row::Kind::kHeader;
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        header ? gfx::Insets::TLBR(12, 10, 4, 10) : gfx::Insets::VH(6, 10),
+        10));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    if (!header) {
+      auto* dot = AddChildView(std::make_unique<views::View>());
+      dot->SetPreferredSize(gfx::Size(8, 8));
+      if (row.dot) {
+        dot->SetBackground(views::CreateRoundedRectBackground(row.dot, 4));
+      }
+      if (!row.icon.isNull()) {
+        auto* icon = AddChildView(std::make_unique<views::ImageView>());
+        icon->SetImage(ui::ImageModel::FromImageSkia(row.icon));
+        icon->SetImageSize(gfx::Size(20, 20));
+      } else if (row.icon_column) {
+        // The launcher's names line up, with an icon or without.
+        AddChildView(std::make_unique<views::View>())
+            ->SetPreferredSize(gfx::Size(20, 20));
+      }
+    }
+    auto* text = AddChildView(std::make_unique<views::View>());
+    text->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 1));
+    layout->SetFlexForView(text, 1);
+    if (header) {
+      AddLabel(text, row.title, kDim, -1, /*bold=*/true);
+    } else {
+      AddLabel(text, row.title, row.dim ? kDim : kTitle, 1);
+      if (!row.detail.empty()) {
+        views::Label* detail = AddLabel(text, row.detail, kDim, -1);
+        detail->SetElideBehavior(gfx::ELIDE_MIDDLE);
+      }
+    }
+    UpdateBackground();
+  }
+
+  // views::View:
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (event.IsRightMouseButton()) {
+      if (on_context_click_) {
+        on_context_click_.Run();
+      }
+    } else if (event.IsOnlyLeftMouseButton() && on_click_) {
+      on_click_.Run();
+    }
+    return true;
+  }
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    hovered_ = true;
+    UpdateBackground();
+  }
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    hovered_ = false;
+    UpdateBackground();
+  }
+  // Lists are rebuilt as windows and tabs change: a new row under a pointer
+  // that doesn't move gets no enter event.
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override {
+    if (hovered_ != IsMouseHovered()) {
+      hovered_ = !hovered_;
+      UpdateBackground();
+    }
+  }
+
+ private:
+  void UpdateBackground() {
+    if (selected_) {
+      SetBackground(views::CreateRoundedRectBackground(kSelected, 6));
+    } else if (hovered_ && on_click_) {
+      SetBackground(views::CreateRoundedRectBackground(kHover, 6));
+    } else {
+      SetBackground(nullptr);
+    }
+  }
+
+  const bool selected_;
+  bool hovered_ = false;
+  base::RepeatingClosure on_click_;
+  base::RepeatingClosure on_context_click_;
+};
