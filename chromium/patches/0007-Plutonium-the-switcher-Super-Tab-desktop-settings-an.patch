+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+constexpr char kUrlKey[] = "url";
+constexpr char kEnabledKey[] = "enabled";
+
+std::string NewId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString().substr(0, 8);
+}
+
+// EXO-DISPLAYS: |url| for a page on another display than the startup one.
+GURL WithDisplay(const GURL& url, int64_t display_id) {
+  std::string query(url.query());
+  if (!query.empty()) {
+    query += "&";
+  }
+  query += "display=" + base::NumberToString(display_id);
+  GURL::Replacements replacements;
+  replacements.SetQueryStr(query);
+  return url.ReplaceComponents(replacements);
+}
+
+bool DisplayExists(int64_t display_id) {
+  display::Display display;
+  // No screen before Ash is up.
+  return display_id != display::kInvalidDisplayId && display::Screen::Get() &&
+         display::Screen::Get()->GetDisplayWithDisplayId(display_id, &display);
+}
+
+std::vector<display::Display> SortedDisplays() {
+  if (!display::Screen::Get()) {
+    return {};
+  }
+  std::vector<display::Display> displays =
+      display::Screen::Get()->GetAllDisplays();
+  std::ranges::stable_sort(displays, [](const display::Display& a,
+                                        const display::Display& b) {
+    return std::pair(a.bounds().x(), a.bounds().y()) <
+           std::pair(b.bounds().x(), b.bounds().y());
+  });
+  return displays;
+}
