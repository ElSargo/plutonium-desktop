+constexpr SkColor kAccentHover = SkColorSetRGB(0xa8, 0xc7, 0xfa);
+constexpr SkColor kOnAccent = SkColorSetRGB(0x20, 0x21, 0x24);
+constexpr SkColor kOk = SkColorSetRGB(0x81, 0xc9, 0x95);
+constexpr SkColor kWarn = SkColorSetRGB(0xfd, 0xd6, 0x63);
+constexpr SkColor kError = SkColorSetRGB(0xf2, 0x8b, 0x82);
+constexpr int kModifiers = ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+                           ui::EF_SHIFT_DOWN | ui::EF_COMMAND_DOWN;
+constexpr int kSidebarWidth = 360;
+// How long a launched app has to open its window.
+constexpr base::TimeDelta kLaunchTimeout = base::Seconds(30);
+
+struct Row {
+  enum class Kind {
+    kHeader,
+    kShell,
+    kAddShell,
+    kTerminal,
+    kBrowser,
+    kLaunch,
+    kWindow,
+    kTab,
+    // EXO-SETTINGS: the settings pages, in the top list.
+    kQuickSettings,
+    kNetwork,
+    kBluetooth,
+    kSound,
+    kPower,
+    kNotifications,
+    kDisplays,
+  };
+  Kind kind = Kind::kHeader;
+  // Which list: the shells' (top) or the windows' (bottom).
+  bool windows_list = false;
+  std::string shell_id;
+  int32_t id = 0;
+  std::u16string title;
+  std::u16string detail;
+  // The state dot's color, or 0 for none.
+  SkColor dot = 0;
+  bool dim = false;
+  // The app's icon, if it has one (PlutoniumAppIcons); with |icon_column|, its
+  // place is kept without one.
+  gfx::ImageSkia icon;
+  bool icon_column = false;
+
+  bool selectable() const { return kind != Kind::kHeader; }
+  // What a selection is remembered by across rebuilds.
+  std::string key() const {
+    return base::NumberToString(static_cast<int>(kind)) + "/" + shell_id +
+           "/" + base::NumberToString(id);
+  }
+};
+
+bool Matches(const std::u16string& query,
+             std::initializer_list<std::u16string_view> fields) {
+  if (query.empty()) {
+    return true;
+  }
+  for (std::u16string_view field : fields) {
+    if (base::ToLowerASCII(field).find(query) != std::u16string::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Runs |action| from a fresh task: buttons and rows rebuild the views they
+// are in, which must not happen inside their own event handling.
+base::RepeatingClosure Deferred(base::RepeatingClosure action) {
+  return base::BindRepeating(
+      [](base::RepeatingClosure action) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                                    action);
+      },
+      std::move(action));
+}
+
+views::Label* AddLabel(views::View* parent,
+                       std::u16string_view text,
+                       SkColor color,
+                       int size_delta = 0,
+                       bool bold = false,
+                       bool multi_line = false) {
+  auto* label = parent->AddChildView(std::make_unique<views::Label>(text));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetAutoColorReadabilityEnabled(false);
+  label->SetEnabledColor(color);
+  gfx::FontList font = gfx::FontList().DeriveWithSizeDelta(size_delta);
+  if (bold) {
+    font = font.DeriveWithWeight(gfx::Font::Weight::BOLD);
+  }
+  label->SetFontList(font);
+  if (multi_line) {
+    label->SetMultiLine(true);
+  } else {
+    label->SetElideBehavior(gfx::ELIDE_TAIL);
+  }
+  return label;
+}
+
+views::View* AddBox(views::View* parent,
+                    views::BoxLayout::Orientation orientation,
+                    int spacing,
+                    const gfx::Insets& insets = gfx::Insets()) {
+  auto* box = parent->AddChildView(std::make_unique<views::View>());
+  auto* layout = box->SetLayoutManager(
+      std::make_unique<views::BoxLayout>(orientation, insets, spacing));
+  if (orientation == views::BoxLayout::Orientation::kHorizontal) {
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+  }
+  return box;
+}
