+ private:
+  // Lists.
+
+  void OnIconLoaded() {
+    RebuildSoon();
+    if (icons_pending_) {
+      return;
+    }
+    icons_pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<PlutoniumOverlayView> view) {
+                         if (view) {
+                           view->icons_pending_ = false;
+                           view->UpdateAppList();
+                         }
+                       },
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
+
+  void RebuildSoon() {
+    if (rebuild_pending_) {
+      return;
+    }
+    rebuild_pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&PlutoniumOverlayView::Rebuild,
+                                  weak_ptr_factory_.GetWeakPtr()));
+  }
+
+  std::u16string ShellStates() const {
+    std::u16string states;
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      SkColor color;
+      states += ShellState(shell, &color);
+    }
+    return states;
+  }
+
+  void Poll() {
+    std::u16string states = ShellStates();
+    if (states != shell_states_) {
+      shell_states_ = std::move(states);
+      RebuildSoon();
+    }
+    LoadPackages();
+    // EXO-SETTINGS: the services' states, the displays, the countdown.
+    LoadServices();
+    std::string displays = StructureJson(base::Value(DisplayConfig()));
+    if (displays != display_structure_) {
+      display_structure_ = std::move(displays);
+      RebuildSoon();
+    }
+    RefreshLive();
+  }
+
+  // The helper's installed shells (GET /v1/shells): their folders, servers
+  // and notices (a change that was rolled back).
+  void LoadPackages() {
+    if (packages_loading_ || !plutonium_helper::IsAvailable()) {
+      return;
+    }
+    packages_loading_ = true;
+    plutonium_helper::Get(
+        "/v1/shells", base::BindOnce(&PlutoniumOverlayView::OnPackages,
+                                     weak_ptr_factory_.GetWeakPtr()));
+  }
+
+  void OnPackages(std::optional<base::Value> value, const std::string& error) {
+    packages_loading_ = false;
+    if (!value || !value->is_list()) {
+      return;
+    }
+    std::string json = base::WriteJson(*value).value_or(std::string());
+    if (json == packages_json_) {
+      return;
+    }
+    packages_json_ = std::move(json);
+    packages_ = std::move(value->GetList());
+    for (const base::Value& package : packages_) {
+      const base::DictValue* dict = package.GetIfDict();
+      // Added on the helper's shells page: on, in the browser's list too.
+      const std::string* url = dict ? dict->FindString("url") : nullptr;
+      const std::string* title = dict ? dict->FindString("title") : nullptr;
+      if (dict && dict->FindBool("add").value_or(false) && url && title) {
+        const GURL page(*url);
+        const bool listed = std::ranges::any_of(
+            shells_->GetShells(), [&](const PlutoniumShells::Shell& shell) {
+              return shell.origin.IsSameOriginWith(url::Origin::Create(page));
+            });
+        if (!listed && plutonium_shell::IsAcceptableShellUrl(page) &&
+            shells_->AddShell(*title, page)) {
+          SetStatus(u"Added " + base::UTF8ToUTF16(*title) +
+                        u" from the shells page. Its page is loading.",
+                    /*error=*/false);
+        }
+      }
+      const std::string* notice = dict ? dict->FindString("notice") : nullptr;
+      if (notice && !notice->empty() &&
+          !std::ranges::contains(notices_shown_, *notice)) {
+        notices_shown_.push_back(*notice);
+        SetStatus(base::UTF8ToUTF16(*notice));
+      }
+    }
+    UpdatePage(/*force=*/false);
+  }
+
+  // The installed shell a shell of the browser's list is (by origin).
+  const base::DictValue* PackageFor(const PlutoniumShells::Shell& shell) const {
+    const std::string origin = shell.origin.Serialize();
+    for (const base::Value& package : packages_) {
+      const base::DictValue* dict = package.GetIfDict();
+      const std::string* package_origin =
+          dict ? dict->FindString("origin") : nullptr;
+      if (package_origin && *package_origin == origin) {
+        return dict;
+      }
+    }
+    return nullptr;
+  }
+
+  std::u16string Query() const {
+    return base::ToLowerASCII(
+        base::TrimWhitespace(search_->GetText(), base::TRIM_ALL));
+  }
+
+  std::optional<PlutoniumShells::Shell> FindShell(const std::string& id) const {
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      if (shell.id == id) {
+        return shell;
+      }
+    }
+    return std::nullopt;
+  }
+
+  std::string ShellName(const std::string& id) const {
+    std::optional<PlutoniumShells::Shell> shell = FindShell(id);
+    return shell ? shell->name : std::string();
+  }
+
+  // A shell's state in a word, and its color.
+  std::u16string ShellState(const PlutoniumShells::Shell& shell,
+                            SkColor* color) const {
+    content::WebContents* contents = shells_->GetContents(shell.id);
+    if (!shell.enabled) {
+      *color = kDim;
+      return u"Off";
+    }
+    if (!shell.running || !contents) {
+      *color = kWarn;
+      return u"Starting";
+    }
+    if (contents->IsCrashed()) {
+      *color = kError;
+      return u"Crashed";
+    }
+    if (contents->IsLoading()) {
+      *color = kWarn;
+      return u"Loading";
+    }
+    *color = shell.visible ? kAccent : kOk;
+    if (!shell.visible && !shell.visible_on.empty()) {
+      // EXO-DISPLAYS.
+      return u"Visible on another display";
+    }
+    return shell.visible ? u"Visible" : u"Running";
+  }
+
+  // The tag an item is listed under: its first tag a shell has labelled,
+  // else its first tag, else none.
+  static std::string GroupTagOf(const std::vector<std::string>& tags) {
+    for (const std::string& tag : tags) {
+      if (PlutoniumGroups::Get()->Find(tag)) {
+        return tag;
+      }
+    }
+    return tags.empty() ? std::string() : tags.front();
+  }
+
+  // A tag's label, with its shell's name.
+  std::u16string TagLabel(const std::string& tag) const {
+    if (tag.empty()) {
+      return u"Not in any group";
+    }
+    if (tag == PlutoniumOverlay::kLaunchThread) {
+      return u"Started from the switcher";
+    }
+    if (tag == PlutoniumOverlay::kTerminalThread) {
+      return u"Started in the backup terminal";
+    }
+    std::optional<PlutoniumGroups::Group> group =
+        PlutoniumGroups::Get()->Find(tag);
+    if (!group) {
+      return base::UTF8ToUTF16(tag);
+    }
+    std::string header = group->label.empty() ? tag : group->label;
+    std::string shell = ShellName(group->shell_id);
+    if (!shell.empty()) {
+      header += "  ·  " + shell;
+    }
+    return base::UTF8ToUTF16(header);
+  }
+
+  // The shells whose pages have an element showing window |id|.
+  std::vector<std::string> ShellsShowing(int32_t id) const {
+    std::vector<std::string> ids;
+    ExoEmbedder* embedder = ExoEmbedder::Get();
+    if (!embedder) {
+      return ids;
+    }
+    for (content::WebContents* page : embedder->GetEmbedders(id)) {
+      if (std::optional<PlutoniumShells::Shell> shell =
+              shells_->GetShellFor(page)) {
+        ids.push_back(shell->id);
+      }
+    }
+    return ids;
+  }
+
+  // Where a window is, for its row and page.
+  std::u16string WindowPlace(int32_t id) const {
+    std::optional<exo::EmbeddedWindows::Info> info =
+        exo::EmbeddedWindows::Get()->GetInfo(id);
+    if (info && info->presented) {
+      return u"fullscreen";
+    }
+    std::vector<std::u16string> names;
+    for (const std::string& shell : ShellsShowing(id)) {
+      names.push_back(base::UTF8ToUTF16(ShellName(shell)));
+    }
+    if (!names.empty()) {
+      return u"in " + base::JoinString(names, u", ");
+    }
+    if (info && info->on_desktop) {
+      return u"on the desktop";
+    }
+    return u"not shown";
+  }
+
+  void BuildShellRows() {
+    const std::u16string query = Query();
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      std::u16string name = base::UTF8ToUTF16(shell.name);
+      std::u16string url = base::UTF8ToUTF16(shell.url.spec());
+      if (!Matches(query, {name, url})) {
+        continue;
+      }
+      Row row;
+      row.kind = Row::Kind::kShell;
+      row.shell_id = shell.id;
+      row.title = name;
+      std::u16string state = ShellState(shell, &row.dot);
+      row.detail = state + u"  ·  " + base::UTF8ToUTF16(shell.url.host()) +
+                   (shell.url.has_port()
+                        ? u":" + base::UTF8ToUTF16(shell.url.port())
+                        : u"");
+      row.dim = !shell.enabled;
+      rows_.push_back(row);
+    }
+    struct BuiltIn {
+      Row::Kind kind;
+      std::u16string title;
+      std::u16string detail;
+      bool open;
+    };
+    const BuiltIn built_ins[] = {
+        {Row::Kind::kAddShell, u"Add a shell…", u"A web page as your desktop",
+         false},
+        {Row::Kind::kTerminal, u"Backup terminal",
+         shells_->IsBackupOpen(PlutoniumShells::Backup::kTerminal)
+             ? u"Open  ·  tabs of shells on this machine"
+             : u"Tabs of shells on this machine",
+         shells_->IsBackupOpen(PlutoniumShells::Backup::kTerminal)},
+        {Row::Kind::kBrowser, u"Backup browser",
+         shells_->IsBackupOpen(PlutoniumShells::Backup::kBrowser)
+             ? u"Open  ·  Chrome's own, with tabs"
+             : u"Chrome's own, with tabs",
+         shells_->IsBackupOpen(PlutoniumShells::Backup::kBrowser)},
+        {Row::Kind::kLaunch, u"Launch an app…",
+         overlay_->IsLaunching() ? u"Waiting for its window…"
+                                 : u"Fullscreen, above every shell",
+         overlay_->IsLaunching()},
+    };
+    if (rows_.empty()) {
+      Row none;
+      none.title = u"No shell matches";
+      rows_.push_back(none);
+    }
+    bool header = false;
+    for (const BuiltIn& built_in : built_ins) {
+      if (!Matches(query, {built_in.title, built_in.detail, u"built in"})) {
+        continue;
+      }
+      if (!header) {
+        Row heading;
+        heading.title = u"BUILT IN";
+        rows_.push_back(heading);
+        header = true;
+      }
+      Row row;
+      row.kind = built_in.kind;
+      row.title = built_in.title;
+      row.detail = built_in.detail;
+      row.dot = built_in.open ? kOk : 0;
+      rows_.push_back(row);
+    }
+    BuildSettingsRows();
+  }
+
+  void BuildWindowRows() {
+    const std::u16string query = Query();
+    std::map<std::string, std::vector<Row>> items;
+    if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+      for (const ExoWindowBroker::WindowInfo& window : broker->GetWindows()) {
+        Row row;
+        row.kind = Row::Kind::kWindow;
+        row.windows_list = true;
+        row.id = window.id;
+        row.title = window.title.empty() ? base::UTF8ToUTF16(window.app_id)
+                                         : window.title;
+        const std::u16string place = WindowPlace(window.id);
+        row.detail = base::UTF8ToUTF16(window.app_id) + u"  ·  " + place;
+        row.dot = place == u"fullscreen" ? kAccent
+                  : place == u"not shown" ? kDim
+                                          : kOk;
+        // PLUTONIUM: the icon the app named (xdg_toplevel_icon_v1) first.
+        if (!window.icon_name.empty()) {
+          row.icon = PlutoniumAppIcons::Get()->GetIcon(window.icon_name);
+        }
+        if (row.icon.isNull()) {
+          row.icon = PlutoniumAppIcons::Get()->GetIcon(window.app_id);
+        }
+        const std::string group = GroupTagOf(window.tags);
+        if (!Matches(query, {row.title, row.detail, JoinTags(window.tags),
+                             TagLabel(group)})) {
+          continue;
+        }
+        items[group].push_back(row);
+      }
+    }
+    for (const PlutoniumTabs::TabInfo& tab : PlutoniumTabs::Get()->GetTabs()) {
+      Row row;
+      row.kind = Row::Kind::kTab;
+      row.windows_list = true;
+      row.id = tab.id;
+      row.title = tab.title.empty() ? base::UTF8ToUTF16(tab.url.spec())
+                                    : tab.title;
+      row.detail = u"tab  ·  " + base::UTF8ToUTF16(tab.url.host()) +
+                   (tab.presented  ? u"  ·  fullscreen"
+                    : tab.embedded ? u"  ·  shown"
+                                   : u"");
+      row.dot = tab.presented ? kAccent : tab.embedded ? kOk : kDim;
+      const std::string group = GroupTagOf(tab.tags);
+      if (!Matches(query, {row.title, base::UTF8ToUTF16(tab.url.spec()),
+                           JoinTags(tab.tags), TagLabel(group)})) {
+        continue;
+      }
+      items[group].push_back(row);
+    }
+    // Labelled groups by label, then unlabelled tags, then the ungrouped.
+    std::vector<std::string> order;
+    for (const auto& [tag, rows] : items) {
+      order.push_back(tag);
+    }
+    std::ranges::sort(order, [&](const std::string& a, const std::string& b) {
+      auto rank = [](const std::string& tag) {
+        return tag.empty() ? 2 : PlutoniumGroups::Get()->Find(tag) ? 0 : 1;
+      };
+      if (rank(a) != rank(b)) {
+        return rank(a) < rank(b);
+      }
+      return TagLabel(a) < TagLabel(b);
+    });
+    for (const std::string& tag : order) {
+      Row group_header;
+      group_header.windows_list = true;
+      group_header.title = TagLabel(tag);
+      rows_.push_back(group_header);
+      for (Row& row : items[tag]) {
+        rows_.push_back(std::move(row));
+      }
+    }
+    if (items.empty()) {
+      Row none;
+      none.windows_list = true;
+      none.title = query.empty() ? u"No windows or tabs yet" : u"No matches";
+      rows_.push_back(none);
+    }
+  }
+
+  void Rebuild() {
+    rebuild_pending_ = false;
+    rows_.clear();
+    BuildShellRows();
+    BuildWindowRows();
+    // Keep the selection, else take the first selectable row.
+    selected_ = -1;
+    for (size_t i = 0; i < rows_.size(); ++i) {
+      if (rows_[i].selectable() && rows_[i].key() == selected_key_) {
+        selected_ = static_cast<int>(i);
+      }
+    }
+    if (selected_ < 0) {
+      for (size_t i = 0; i < rows_.size(); ++i) {
+        if (rows_[i].selectable()) {
+          selected_ = static_cast<int>(i);
+          break;
+        }
+      }
+    }
+    if (selected_ >= 0) {
+      selected_key_ = rows_[selected_].key();
+    }
+    shells_scroll_->contents()->RemoveAllChildViews();
+    windows_scroll_->contents()->RemoveAllChildViews();
+    views::View* selected_view = nullptr;
+    int window_items = 0;
+    for (size_t i = 0; i < rows_.size(); ++i) {
+      const int index = static_cast<int>(i);
+      const Row& row = rows_[i];
+      views::View* list = row.windows_list ? windows_scroll_->contents()
+                                           : shells_scroll_->contents();
+      if (row.windows_list && row.selectable()) {
+        ++window_items;
+      }
+      auto* view = list->AddChildView(std::make_unique<RowView>(
+          row, index == selected_,
+          row.selectable()
+              ? base::BindRepeating(&PlutoniumOverlayView::ClickKey,
+                                    weak_ptr_factory_.GetWeakPtr(), row.key(),
+                                    /*act=*/true)
+              : base::RepeatingClosure(),
+          row.selectable()
+              ? base::BindRepeating(&PlutoniumOverlayView::ClickKey,
+                                    weak_ptr_factory_.GetWeakPtr(), row.key(),
+                                    /*act=*/false)
+              : base::RepeatingClosure()));
+      if (index == selected_) {
+        selected_view = view;
+      }
+    }
+    windows_heading_->SetText(
+        window_items ? u"WINDOWS AND TABS  ·  " +
+                           base::NumberToString16(window_items)
+                     : u"WINDOWS AND TABS");
+    UpdatePage(/*force=*/false);
+    UpdateFooter();
+    InvalidateLayout();
+    if (views::Widget* widget = GetWidget()) {
+      widget->LayoutRootViewIfNecessary();
+    }
+    if (selected_view) {
+      selected_view->ScrollViewToVisible();
+    }
+  }
+
+  const Row* Selected() const {
+    return selected_ >= 0 && selected_ < static_cast<int>(rows_.size())
+               ? &rows_[selected_]
+               : nullptr;
+  }
+
+  void Move(int step) {
+    if (rows_.empty()) {
+      return;
+    }
+    const int count = static_cast<int>(rows_.size());
+    int index = selected_ < 0 ? 0 : selected_;
+    for (int tries = 0; tries < count; ++tries) {
+      index = ((index + (step > 0 ? 1 : -1)) % count + count) % count;
+      if (rows_[index].selectable()) {
+        break;
+      }
+    }
+    if (!rows_[index].selectable()) {
+      return;
+    }
+    selected_key_ = rows_[index].key();
+    SetStatus(std::u16string());
+    Rebuild();
+  }
+
+  // A row was clicked: select it (right click), and act (left click).
+  void ClickKey(const std::string& key, bool act) {
+    if (key != selected_key_) {
+      SetStatus(std::u16string());
+    }
+    selected_key_ = key;
+    Rebuild();
+    if (act) {
+      Activate();
+    }
+  }
+
+  void SetStatus(const std::u16string& text, bool error = true) {
+    status_->SetText(text);
+    status_->SetEnabledColor(error ? kError : kOk);
+    status_->SetVisible(!text.empty());
+    InvalidateLayout();
+  }
+
+  void UpdateFooter() {
+    const Row* row = Selected();
+    std::u16string keys = u"↑↓ / Super+Tab move   Tab into the page   Esc close";
+    if (row) {
+      switch (row->kind) {
+        case Row::Kind::kShell:
+          keys = u"Enter switch to it (or start it)   Ctrl+O start/stop   "
+                 u"Ctrl+R reload   " +
+                 keys;
+          break;
+        case Row::Kind::kAddShell:
+        case Row::Kind::kLaunch:
+          keys = u"Enter fill it in   " + keys;
+          break;
+        case Row::Kind::kTerminal:
+        case Row::Kind::kBrowser:
+          keys = u"Enter open it   " + keys;
+          break;
+        case Row::Kind::kWindow:
+          keys = u"Enter show maximized   Ctrl+W close   Ctrl+P pop out   " +
+                 keys;
+          break;
+        case Row::Kind::kTab:
+          keys = u"Enter show maximized   Ctrl+W close   " + keys;
+          break;
+        case Row::Kind::kQuickSettings:
+        case Row::Kind::kNetwork:
+        case Row::Kind::kBluetooth:
+        case Row::Kind::kSound:
+        case Row::Kind::kPower:
+        case Row::Kind::kNotifications:
+        case Row::Kind::kDisplays:
+          keys = u"Enter into the page   " + keys;
+          break;
+        case Row::Kind::kHeader:
+          break;
+      }
+    }
+    footer_->SetText(keys + u"   Right click: the page only");
+  }
+
+  // Keys.
+
+  bool HandleListKey(const ui::KeyEvent& event) {
+    const int modifiers = event.flags() & kModifiers;
+    if (modifiers == 0) {
+      switch (event.key_code()) {
+        case ui::VKEY_UP:
+          Move(-1);
+          return true;
+        case ui::VKEY_DOWN:
+          Move(1);
+          return true;
+        case ui::VKEY_RETURN:
+          Activate();
+          return true;
+        case ui::VKEY_ESCAPE:
+          overlay_->Close();
+          return true;
+        default:
+          return false;
+      }
+    }
+    if (modifiers != ui::EF_CONTROL_DOWN) {
+      return false;
+    }
+    const Row* row = Selected();
+    if (!row) {
+      return false;
+    }
+    switch (event.key_code()) {
+      case ui::VKEY_O:
+        if (row->kind == Row::Kind::kShell) {
+          ToggleShell(row->shell_id);
+        }
+        return true;
+      case ui::VKEY_R:
+        if (row->kind == Row::Kind::kShell) {
+          shells_->Reload(row->shell_id, /*bypass_cache=*/false);
+        }
+        return true;
+      case ui::VKEY_N:
+        SelectBuiltIn(Row::Kind::kAddShell);
+        return true;
+      case ui::VKEY_P:
+        if (row->kind == Row::Kind::kWindow) {
+          PopOut(row->id);
+        }
+        return true;
+      case ui::VKEY_W:
+        if (row->kind == Row::Kind::kWindow) {
+          exo::EmbeddedWindows::Get()->Close(row->id);
+        } else if (row->kind == Row::Kind::kTab) {
+          PlutoniumTabs::Get()->RunCommand(row->id,
+                                           PlutoniumTabs::Command::kClose);
+        }
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  // Actions.
+
+  // A left click, or Enter.
+  void Activate() {
+    const Row* row = Selected();
+    if (!row) {
+      return;
+    }
+    switch (row->kind) {
+      case Row::Kind::kShell:
+        SwitchTo(row->shell_id);
+        return;
+      case Row::Kind::kAddShell:
+      case Row::Kind::kLaunch:
+        // Into the page's first field.
+        if (name_field_) {
+          name_field_->RequestFocus();
+        } else if (app_filter_) {
+          app_filter_->RequestFocus();
+        }
+        return;
+      case Row::Kind::kTerminal:
+        OpenBackup(PlutoniumShells::Backup::kTerminal);
+        return;
+      case Row::Kind::kBrowser:
+        OpenBackup(PlutoniumShells::Backup::kBrowser);
+        return;
+      // EXO-MAXIMIZE: in its shell, maximized the shell's way. "Open
+      // fullscreen" (Present()) is on the item's page.
+      case Row::Kind::kWindow:
+        ShowMaximized(Row::Kind::kWindow, row->id);
+        return;
+      case Row::Kind::kTab:
+        ShowMaximized(Row::Kind::kTab, row->id);
+        return;
+      case Row::Kind::kQuickSettings:
+      case Row::Kind::kNetwork:
+      case Row::Kind::kBluetooth:
+      case Row::Kind::kSound:
+      case Row::Kind::kPower:
+      case Row::Kind::kNotifications:
+      case Row::Kind::kDisplays:
+        FocusPage();
+        return;
+      case Row::Kind::kHeader:
+        return;
+    }
+  }
+
+  void SelectBuiltIn(Row::Kind kind) {
+    Row row;
+    row.kind = kind;
+    search_->SetText(std::u16string());
+    ClickKey(row.key(), /*act=*/false);
+    if (name_field_) {
+      name_field_->RequestFocus();
+    }
+  }
+
+  void ShowShellOn(const std::string& id, int64_t display_id) {
+    if (shells_->ShowOn(id, display_id)) {
+      overlay_->Close(/*acted=*/true);
+    }
+  }
+
+  void SwitchTo(const std::string& id) {
+    std::optional<PlutoniumShells::Shell> shell = FindShell(id);
+    if (!shell) {
+      return;
+    }
+    if (!shell->enabled) {
+      shells_->SetEnabled(id, true);
+      SetStatus(u"Starting " + base::UTF8ToUTF16(shell->name) +
+                    u"… Its window opens hidden; switch to it once it's "
+                    u"running.",
+                /*error=*/false);
+    } else if (shell->running && shells_->Show(id)) {
+      overlay_->Close(/*acted=*/true);
+    }
+  }
+
+  void ToggleShell(const std::string& id) {
+    std::optional<PlutoniumShells::Shell> shell = FindShell(id);
+    if (shell && !shells_->SetEnabled(id, !shell->enabled)) {
+      SetStatus(u"The last running shell can't be stopped.");
+    }
+  }
+
+  void RemoveShell(const std::string& id) {
+    std::optional<PlutoniumShells::Shell> shell = FindShell(id);
+    if (!shell) {
+      return;
+    }
+    if (shell->enabled) {
+      SetStatus(u"Stop it first, then remove it.");
+      return;
+    }
+    if (confirm_remove_id_ != id) {
+      confirm_remove_id_ = id;
+      UpdatePage(/*force=*/true);
+      return;
+    }
+    confirm_remove_id_.clear();
+    shells_->RemoveShell(id);
+    SetStatus(base::UTF8ToUTF16(shell->name) + u" is gone.", /*error=*/false);
+  }
+
+  void OpenDevTools(content::WebContents* contents) {
+    if (!contents) {
+      return;
+    }
+    DevToolsWindow::OpenDevToolsWindow(contents,
+                                       DevToolsOpenedByAction::kUnknown);
+    overlay_->Close(/*acted=*/true);
+  }
+
+  void OpenBackup(PlutoniumShells::Backup backup) {
+    if (shells_->OpenBackup(backup, GURL())) {
+      overlay_->Close(/*acted=*/true);
+      return;
+    }
+    SetStatus(backup == PlutoniumShells::Backup::kTerminal
+                  ? u"The backup terminal needs the helper's address "
+                    u"(--plutonium-helper-url), which this session wasn't "
+                    u"started with."
+                  : u"Couldn't open the backup browser.");
+  }
+
+  void Present(int32_t id) {
+    PlutoniumTabs::Get()->EndPresentation();
+    exo::EmbeddedWindows::Get()->Present(id);
+    overlay_->Close(/*acted=*/true);
+  }
+
+  // EXO-PRESENT: the tab's own page, on its own (plutonium_tab_presenter.h).
+  void PresentTab(int32_t id) {
+    exo::EmbeddedWindows::Get()->EndPresentation();
+    if (!PlutoniumTabs::Get()->Present(id)) {
+      SetStatus(u"That tab is gone.");
+      return;
+    }
+    overlay_->Close(/*acted=*/true);
+  }
+
+  // Back to the shells.
+  void EndPresentation() {
+    exo::EmbeddedWindows::Get()->EndPresentation();
+    PlutoniumTabs::Get()->EndPresentation();
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      if (shell.visible) {
+        shells_->Show(shell.id);
+      }
+    }
+    UpdatePage(/*force=*/true);
+  }
+
+  void PopOut(int32_t id) {
+    exo::EmbeddedWindows::Get()->ShowOnDesktop(id);
+    if (exo::EmbeddedWindows::Get()->IsAttached(id)) {
+      SetStatus(u"A shell shows it: it pops out once no shell does.",
+                /*error=*/false);
+      return;
+    }
+    overlay_->Close(/*acted=*/true);
+  }
+
+  // Shows the item in the shell that owns its group (else the visible one)
+  // and asks that shell's page to bring it up.
+  void ShowItem(Row::Kind kind, int32_t id) {
+    std::string owner;
+    for (const std::string& tag : TagsOf(kind, id)) {
+      std::optional<PlutoniumGroups::Group> group =
+          PlutoniumGroups::Get()->Find(tag);
+      if (group && shells_->GetContents(group->shell_id)) {
+        owner = group->shell_id;
+        break;
+      }
+    }
+    if (owner.empty()) {
+      for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+        if (shell.visible) {
+          owner = shell.id;
+        }
+      }
+    }
+    FocusIn(kind, id, owner);
+  }
+
+  // EXO-MAXIMIZE: shows the item in its shell (ShowItem()) and asks that
+  // shell to maximize it, as Super+F does.
+  void ShowMaximized(Row::Kind kind, int32_t id) {
+    ShowItem(kind, id);
+    if (kind == Row::Kind::kWindow) {
+      if (ExoEmbedder* embedder = ExoEmbedder::Get()) {
+        embedder->RequestMaximize(id);
+      }
+    } else {
+      PlutoniumTabs::Get()->RequestMaximize(id);
+    }
+  }
+  void ShowWindowMaximized(int32_t id) {
+    ShowMaximized(Row::Kind::kWindow, id);
+  }
+  void ShowTabMaximized(int32_t id) { ShowMaximized(Row::Kind::kTab, id); }
+
+  // Shows shell |shell_id| and asks its page to bring the item up.
+  void FocusIn(Row::Kind kind, int32_t id, const std::string& shell_id) {
+    exo::EmbeddedWindows::Get()->EndPresentation();
+    PlutoniumTabs::Get()->EndPresentation();
+    if (!shell_id.empty()) {
+      shells_->Show(shell_id);
+    }
+    content::WebContents* shell = shells_->GetContents(shell_id);
+    const bool asked =
+        shell && (kind == Row::Kind::kWindow
+                      ? plutonium_shell::RequestShowWindow(shell, id)
+                      : plutonium_shell::RequestShowTab(shell, id));
+    if (!asked && kind == Row::Kind::kWindow) {
+      // The shell doesn't take requests: the desktop it is.
+      exo::EmbeddedWindows::Get()->ShowOnDesktop(id);
+    }
+    overlay_->Close(/*acted=*/true);
+  }
+
+  static std::vector<std::string> TagsOf(Row::Kind kind, int32_t id) {
+    if (kind == Row::Kind::kWindow) {
+      ExoWindowBroker* broker = ExoWindowBroker::Get();
+      std::optional<ExoWindowBroker::WindowInfo> window =
+          broker ? broker->GetWindow(id) : std::nullopt;
+      return window ? window->tags : std::vector<std::string>();
+    }
+    std::optional<PlutoniumTabs::TabInfo> tab = PlutoniumTabs::Get()->GetTab(id);
+    return tab ? tab->tags : std::vector<std::string>();
+  }
+
+  static bool HasOriginTag(Row::Kind kind, int32_t id) {
+    if (kind == Row::Kind::kWindow) {
+      ExoWindowBroker* broker = ExoWindowBroker::Get();
+      std::optional<ExoWindowBroker::WindowInfo> window =
+          broker ? broker->GetWindow(id) : std::nullopt;
+      return window && !window->tag.empty();
+    }
+    std::optional<PlutoniumTabs::TabInfo> tab = PlutoniumTabs::Get()->GetTab(id);
+    return tab && !tab->tag.empty();
+  }
+
+  void ToggleGroup(Row::Kind kind, int32_t id, const std::string& tag) {
+    std::vector<std::string> tags = TagsOf(kind, id);
+    if (!tags.empty() && tags.front() == tag && HasOriginTag(kind, id)) {
+      SetStatus(u"That's where it came from: it stays in that group.");
+      return;
+    }
+    const bool has = std::ranges::find(tags, tag) != tags.end();
+    std::vector<std::string> add, remove;
+    (has ? remove : add).push_back(tag);
+    if (kind == Row::Kind::kWindow) {
+      if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+        broker->UpdateTags(id, add, remove);
+      }
+    } else {
+      PlutoniumTabs::Get()->UpdateTags(id, add, remove);
+    }
+  }
+
+  // Pages.
+
+  // What the page shows, so it is only rebuilt when that changes (a rebuild
+  // would lose the text fields' focus).
+  std::string PageSignature(const Row& row) const {
+    std::string signature = row.key() + "|" + confirm_remove_id_ + "|" +
+                            base::NumberToString(snapshot_generation_);
+    switch (row.kind) {
+      case Row::Kind::kShell: {
+        signature += packages_json_;
+        for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+          SkColor color;
+          signature += shell.id + shell.name + shell.url.spec() +
+                       base::UTF16ToUTF8(ShellState(shell, &color));
+          if (content::WebContents* contents =
+                  shells_->GetContents(shell.id)) {
+            signature += base::UTF16ToUTF8(contents->GetTitle()) +
+                         contents->GetLastCommittedURL().spec();
+          }
+        }
+        signature += base::NumberToString(PlutoniumGroups::Get()->groups().size());
+        break;
+      }
+      case Row::Kind::kWindow: {
+        ExoWindowBroker* broker = ExoWindowBroker::Get();
+        std::optional<ExoWindowBroker::WindowInfo> window =
+            broker ? broker->GetWindow(row.id) : std::nullopt;
+        if (window) {
+          signature += base::UTF16ToUTF8(window->title) + window->app_id +
+                       window->size.ToString() +
+                       (window->focused ? "f" : "") +
+                       base::JoinString(window->tags, " ") +
+                       base::UTF16ToUTF8(WindowPlace(row.id));
+        }
+        for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+          signature += shell.id + (shell.running ? "r" : "") + shell.name;
+        }
+        signature +=
+            base::NumberToString(PlutoniumGroups::Get()->groups().size());
+        break;
+      }
+      case Row::Kind::kTab: {
+        std::optional<PlutoniumTabs::TabInfo> tab =
+            PlutoniumTabs::Get()->GetTab(row.id);
+        if (tab) {
+          signature += base::UTF16ToUTF8(tab->title) + tab->url.spec() +
+                       (tab->loading ? "l" : "") + (tab->embedded ? "e" : "") +
+                       (tab->presented ? "p" : "") +
+                       base::JoinString(tab->tags, " ") + tab->dialog_type;
+        }
+        signature +=
+            base::NumberToString(PlutoniumGroups::Get()->groups().size());
+        break;
+      }
+      case Row::Kind::kTerminal:
+      case Row::Kind::kBrowser:
+        signature +=
+            shells_->IsBackupOpen(PlutoniumShells::Backup::kTerminal) ? "t" : "";
+        signature +=
+            shells_->IsBackupOpen(PlutoniumShells::Backup::kBrowser) ? "b" : "";
+        break;
+      case Row::Kind::kLaunch:
+        // Not the apps: their list updates by itself (UpdateAppList()).
+        signature += overlay_->IsLaunching() ? "w" : "";
+        break;
+      case Row::Kind::kQuickSettings:
+      case Row::Kind::kNetwork:
+      case Row::Kind::kBluetooth:
+      case Row::Kind::kSound:
+      case Row::Kind::kPower:
+      case Row::Kind::kNotifications:
+      case Row::Kind::kDisplays:
+        signature += SettingsSignature(row.kind);
+        break;
+      case Row::Kind::kAddShell:
+      case Row::Kind::kHeader:
+        break;
+    }
+    return signature;
+  }
+
+  void UpdatePage(bool force) {
+    const Row* row = Selected();
+    const std::string key = row ? row->key() : std::string();
+    const std::string signature = row ? PageSignature(*row) : std::string();
+    if (!force && key == page_key_ && signature == page_signature_) {
+      return;
+    }
+    // The same page again keeps what was typed in it.
+    const bool same = key == page_key_;
+    const std::u16string name(same && name_field_ ? name_field_->GetText()
+                                                  : u"");
+    const std::u16string url(same && url_field_ ? url_field_->GetText() : u"");
+    const std::u16string filter(
+        same && app_filter_ ? app_filter_->GetText() : u"");
+    const bool focus_name = same && name_field_ && name_field_->HasFocus();
+    const bool focus_url = same && url_field_ && url_field_->HasFocus();
+    const bool focus_filter = same && app_filter_ && app_filter_->HasFocus();
+    // EXO-SETTINGS: a Wi-Fi password being typed.
+    const std::u16string password(
+        same && password_field_ ? password_field_->GetText() : u"");
+    const bool focus_password =
+        same && password_field_ && password_field_->HasFocus();
+    if (!same) {
+      confirm_remove_id_.clear();
+      snapshot_ = SkBitmap();
+      confirm_action_.clear();
+      password_ssid_.clear();
+    }
+    password_field_ = nullptr;
+    pending_label_ = nullptr;
+    sliders_.clear();
+    page_key_ = key;
+    page_signature_ = signature;
+    name_field_ = nullptr;
+    url_field_ = nullptr;
+    app_filter_ = nullptr;
+    app_list_ = nullptr;
+    snapshot_view_ = nullptr;
+    page_->RemoveAllChildViews();
+    if (row) {
+      switch (row->kind) {
+        case Row::Kind::kShell:
+          BuildShellPage(row->shell_id);
+          break;
+        case Row::Kind::kAddShell:
+          BuildAddShellPage();
+          break;
+        case Row::Kind::kTerminal:
+          BuildBackupPage(PlutoniumShells::Backup::kTerminal);
+          break;
+        case Row::Kind::kBrowser:
+          BuildBackupPage(PlutoniumShells::Backup::kBrowser);
+          break;
+        case Row::Kind::kLaunch:
+          BuildLaunchPage();
+          break;
+        case Row::Kind::kWindow:
+          BuildWindowPage(row->id, !same);
+          break;
+        case Row::Kind::kTab:
+          BuildTabPage(row->id, !same);
+          break;
+        case Row::Kind::kQuickSettings:
+          BuildQuickSettingsPage();
+          break;
+        case Row::Kind::kNetwork:
+          BuildNetworkPage();
+          break;
+        case Row::Kind::kBluetooth:
+          BuildBluetoothPage();
+          break;
+        case Row::Kind::kSound:
+          BuildSoundPage();
+          break;
+        case Row::Kind::kPower:
+          BuildPowerPage();
+          break;
+        case Row::Kind::kNotifications:
+          BuildNotificationsPage();
+          break;
+        case Row::Kind::kDisplays:
+          BuildDisplaysPage();
+          break;
+        case Row::Kind::kHeader:
+          break;
+      }
+    }
+    if (same) {
+      if (name_field_ && !name.empty()) {
+        name_field_->SetText(name);
+      }
+      if (url_field_ && !url.empty()) {
+        url_field_->SetText(url);
+      }
+      if (app_filter_ && !filter.empty()) {
+        app_filter_->SetText(filter);
+        UpdateAppList();
+      }
+      if (focus_name && name_field_) {
+        name_field_->RequestFocus();
+      } else if (focus_url && url_field_) {
+        url_field_->RequestFocus();
+      } else if (focus_filter && app_filter_) {
+        app_filter_->RequestFocus();
+      }
+      if (password_field_ && !password.empty()) {
+        password_field_->SetText(password);
+      }
+      if (focus_password && password_field_) {
+        password_field_->RequestFocus();
+      }
+    }
+    SizeContents(page_scroll_, 600);
+    if (!same) {
+      page_scroll_->ScrollToOffset(gfx::PointF());
+    }
+  }
+
+  // Page parts.
+
+  void AddTitle(const std::u16string& title,
+                const std::u16string& state = std::u16string(),
+                SkColor state_color = 0,
+                const std::u16string& subtitle = std::u16string()) {
+    auto* head = AddBox(page_, views::BoxLayout::Orientation::kVertical, 4);
+    AddLabel(head, title, kTitle, 10, /*bold=*/true);
+    auto* line = AddBox(head, views::BoxLayout::Orientation::kHorizontal, 8);
+    if (!state.empty()) {
+      auto* dot = line->AddChildView(std::make_unique<views::View>());
+      dot->SetPreferredSize(gfx::Size(8, 8));
+      dot->SetBackground(views::CreateRoundedRectBackground(state_color, 4));
+      AddLabel(line, state, state_color, 1, /*bold=*/true);
+    }
+    if (!subtitle.empty()) {
+      AddLabel(line, subtitle, kDim, 1);
+    }
+  }
+
+  views::View* AddSection(const std::u16string& title) {
+    auto* section =
+        AddBox(page_, views::BoxLayout::Orientation::kVertical, 8,
+               gfx::Insets::TLBR(6, 0, 0, 0));
+    AddLabel(section, base::ToUpperASCII(title), kDim, -1, /*bold=*/true);
+    return section;
+  }
+
+  void AddParagraph(views::View* parent,
+                    const std::u16string& text,
+                    SkColor color = kTitle) {
+    AddLabel(parent, text, color, 0, false, /*multi_line=*/true);
+  }
+
+  views::View* AddButtons(views::View* parent) {
+    return AddBox(parent, views::BoxLayout::Orientation::kHorizontal, 8);
+  }
+
+  ActionButton* AddButton(
+      views::View* row,
+      const std::u16string& text,
+      base::RepeatingClosure action,
+      ActionButton::Style style = ActionButton::Style::kNormal,
+      bool enabled = true) {
+    auto* button = row->AddChildView(
+        std::make_unique<ActionButton>(std::move(action), text, style));
+    button->SetEnabled(enabled);
+    return button;
+  }
+
+  // A closure that calls |method| on this view if it's still there.
+  template <typename Method, typename... Args>
+  base::RepeatingClosure Bind(Method method, Args... args) {
+    return base::BindRepeating(method, weak_ptr_factory_.GetWeakPtr(),
+                               std::move(args)...);
+  }
+
+  void AddField(views::View* parent,
+                const std::u16string& key,
+                const std::u16string& value) {
+    auto* row = AddBox(parent, views::BoxLayout::Orientation::kHorizontal, 12);
+    views::Label* key_label = AddLabel(row, key, kDim);
+    key_label->SetPreferredSize(gfx::Size(150, key_label->GetPreferredSize(
+                                                   views::SizeBounds())
+                                                   .height()));
+    views::Label* value_label =
+        AddLabel(row, value.empty() ? u"—" : value, kTitle);
+    value_label->SetElideBehavior(gfx::ELIDE_MIDDLE);
+    value_label->SetSelectable(true);
+    value_label->SetTooltipText(value);
+    static_cast<views::BoxLayout*>(row->GetLayoutManager())
+        ->SetFlexForView(value_label, 1);
