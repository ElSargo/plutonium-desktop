+  views::Textfield* AddTextfield(views::View* parent,
+                                 const std::u16string& label,
+                                 const std::u16string& placeholder,
+                                 const std::u16string& text) {
+    auto* box = AddBox(parent, views::BoxLayout::Orientation::kVertical, 4);
+    AddLabel(box, label, kDim);
+    auto* field = box->AddChildView(std::make_unique<views::Textfield>());
