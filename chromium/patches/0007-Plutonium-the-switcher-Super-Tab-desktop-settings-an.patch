+  // Launching.
+
+  enum class AppsState { kNotLoaded, kLoading, kLoaded, kFailed };
+  struct App {
+    std::string id;
+    std::u16string name;
+    std::u16string detail;
+    std::u16string keywords;
+  };
+
+  void BuildLaunchPage() {
+    AddTitle(u"Launch an app");
+    AddParagraph(
+        page_,
+        u"Starts a desktop app and shows it fullscreen, on its own, above "
+        u"every shell. It runs whether or not any shell works. Super+Tab "
+        u"comes back here; pick a shell to go back to it, or Super+F to "
+        u"leave fullscreen. Its window is in the group \"Started from the "
+        u"switcher\", where any shell can show it later.");
+    if (!plutonium_helper::IsAvailable()) {
+      AddParagraph(page_,
+                   u"This session wasn't told where its helper is "
+                   u"(--plutonium-helper-socket), so apps can't be listed.",
+                   kError);
+      return;
+    }
+    if (overlay_->IsLaunching()) {
+      AddParagraph(page_, u"Waiting for the app's window…", kWarn);
+    }
+    app_filter_ = AddTextfield(page_, u"Find an app", u"Type to filter, Enter "
+                                                      u"starts the first",
+                               u"");
+    app_list_ = AddBox(page_, views::BoxLayout::Orientation::kVertical, 0);
+    if (apps_state_ == AppsState::kNotLoaded) {
+      LoadApps();
+    }
+    UpdateAppList();
+  }
+
+  void LoadApps() {
+    apps_state_ = AppsState::kLoading;
+    plutonium_helper::Get(
+        "/v1/apps", base::BindOnce(&PlutoniumOverlayView::OnApps,
+                                   weak_ptr_factory_.GetWeakPtr()));
+  }
+
+  void OnApps(std::optional<base::Value> value, const std::string& error) {
+    apps_.clear();
+    if (!value || !value->is_list()) {
+      apps_state_ = AppsState::kFailed;
+      apps_error_ = base::UTF8ToUTF16(error);
+    } else {
+      apps_state_ = AppsState::kLoaded;
+      for (const base::Value& item : value->GetList()) {
+        const base::DictValue* dict = item.GetIfDict();
+        const std::string* id = dict ? dict->FindString("id") : nullptr;
+        const std::string* name = dict ? dict->FindString("name") : nullptr;
+        if (!id || !name) {
+          continue;
+        }
+        App app;
+        app.id = *id;
+        app.name = base::UTF8ToUTF16(*name);
+        const std::string* generic = dict->FindString("genericName");
+        const std::string* comment = dict->FindString("comment");
+        app.detail = base::UTF8ToUTF16(
+            generic && !generic->empty() ? *generic
+            : comment                    ? *comment
+                                         : std::string());
+        if (dict->FindBool("terminal").value_or(false)) {
+          app.detail += app.detail.empty() ? u"in a terminal"
+                                           : u"  ·  in a terminal";
+        }
+        std::string keywords;
+        if (const base::ListValue* list = dict->FindList("keywords")) {
+          for (const base::Value& keyword : *list) {
+            if (keyword.is_string()) {
+              keywords += keyword.GetString() + " ";
+            }
+          }
+        }
+        app.keywords = base::UTF8ToUTF16(keywords + (comment ? *comment : ""));
+        apps_.push_back(std::move(app));
+      }
+    }
+    UpdateAppList();
+  }
+
+  std::vector<const App*> FilteredApps() const {
+    std::vector<const App*> apps;
+    const std::u16string query =
+        app_filter_ ? base::ToLowerASCII(base::TrimWhitespace(
+                          app_filter_->GetText(), base::TRIM_ALL))
+                    : std::u16string();
+    for (const App& app : apps_) {
+      if (Matches(query, {app.name, app.detail, app.keywords,
+                          base::UTF8ToUTF16(app.id)})) {
+        apps.push_back(&app);
+      }
+    }
+    return apps;
+  }
+
+  void UpdateAppList() {
+    if (!app_list_) {
+      return;
+    }
+    app_list_->RemoveAllChildViews();
+    switch (apps_state_) {
+      case AppsState::kNotLoaded:
+      case AppsState::kLoading:
+        AddLabel(app_list_, u"Asking the helper for its apps…", kDim);
+        break;
+      case AppsState::kFailed:
+        AddParagraph(app_list_,
+                     u"Couldn't list the apps: " + apps_error_ + u".", kError);
+        break;
+      case AppsState::kLoaded: {
+        std::vector<const App*> apps = FilteredApps();
+        if (apps.empty()) {
+          AddLabel(app_list_, u"No app matches.", kDim);
+        }
+        for (const App* app : apps) {
+          Row row;
+          row.kind = Row::Kind::kLaunch;
+          row.title = app->name;
+          row.detail = app->detail.empty() ? base::UTF8ToUTF16(app->id)
+                                           : app->detail;
+          row.icon = PlutoniumAppIcons::Get()->GetIcon(app->id);
+          row.icon_column = true;
+          app_list_->AddChildView(std::make_unique<RowView>(
+              row, false,
+              base::BindRepeating(&PlutoniumOverlayView::Launch,
+                                  weak_ptr_factory_.GetWeakPtr(), app->id,
+                                  app->name),
+              base::RepeatingClosure()));
+        }
+        break;
+      }
+    }
+    SizeContents(page_scroll_, 600);
+  }
+
+  void LaunchFirstApp() {
+    std::vector<const App*> apps = FilteredApps();
+    if (!apps.empty()) {
+      Launch(apps.front()->id, apps.front()->name);
+    }
+  }
+
+  void Launch(const std::string& id, const std::u16string& name) {
+    SetStatus(u"Starting " + name + u"… It shows fullscreen once its window "
+                                    u"opens.",
+              /*error=*/false);
+    overlay_->LaunchApp(
+        id, base::BindOnce(
+                [](base::WeakPtr<PlutoniumOverlayView> view,
+                   std::u16string name, const std::string& error) {
+                  if (!view) {
+                    return;
+                  }
+                  if (!error.empty()) {
+                    view->SetStatus(u"Couldn't start " + name + u": " +
+                                    base::UTF8ToUTF16(error));
+                    return;
+                  }
+                  view->UpdatePage(/*force=*/false);
+                },
+                weak_ptr_factory_.GetWeakPtr(), name));
+  }
