+// EXO-TAB-FEATURES: a download's "open" and "show" go to the helper, which
+// opens the file (or its folder) in the download's thread, as the user.
+void OpenDownloadWithHelper(const base::FilePath& path,
+                            const std::string& thread,
+                            bool show,
+                            PlutoniumDownloads::CommandCallback done) {
+  plutonium_helper::Post(
+      "/v1/downloads/open",
+      base::DictValue()
+          .Set("path", path.AsUTF8Unsafe())
+          .Set("thread", thread)
+          .Set("show", show),
+      base::BindOnce(
+          [](PlutoniumDownloads::CommandCallback done,
+             std::optional<base::Value> value, const std::string& error) {
+            std::move(done).Run(value.has_value(), error);
+          },
+          std::move(done)));
+}
+
+// EXO-SERVICES: the hardware keys (volume, brightness, media) go to the
+// helper's desktop services. Ash's own action runs if the helper did nothing
+// with the key (no player but a tab's media session), or can't be reached.
+void SendSystemKeyToHelper(const std::string& key,
+                           base::OnceClosure own_action) {
+  plutonium_helper::Post(
+      "/v1/system/key", base::DictValue().Set("key", key),
+      base::BindOnce(
+          [](base::OnceClosure own_action, std::optional<base::Value> value,
+             const std::string& error) {
+            const bool handled = value && value->is_dict() &&
+                                 value->GetDict().FindBool("handled").value_or(
+                                     false);
+            if (!handled) {
+              std::move(own_action).Run();
+            }
+          },
+          std::move(own_action)));
+}
+
+// PLUTONIUM: touchpad swipes with three fingers or more go to the focused
+// display's visible shell page (navigator.windowBroker's "touchpadswipe").
+void SendSwipeToShell(const ui::ScrollEvent& event) {
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  if (!shells) {
+    return;
+  }
+  const char* phase = event.type() == ui::EventType::kScrollFlingCancel
+                          ? "begin"
+                      : event.type() == ui::EventType::kScrollFlingStart
+                          ? "end"
+                          : "update";
+  std::optional<std::string> json = base::WriteJson(
+      base::DictValue()
+          .Set("phase", phase)
+          .Set("fingers", event.finger_count())
+          .Set("dx", event.x_offset())
+          .Set("dy", event.y_offset())
+          .Set("x", event.root_location_f().x())
+          .Set("y", event.root_location_f().y()));
+  if (json) {
+    shells->NotifyTouchpadSwipe(*json);
+  }
+}
