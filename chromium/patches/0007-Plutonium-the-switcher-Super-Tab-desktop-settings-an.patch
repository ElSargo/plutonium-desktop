+  // Windows and tabs.
+
+  void AddSnapshot(views::View* parent,
+                   bool request,
+                   bool is_window,
+                   int32_t id) {
+    auto* box = AddBox(parent, views::BoxLayout::Orientation::kVertical, 6);
+    if (snapshot_.drawsNothing()) {
+      AddLabel(box, request ? u"Taking a snapshot…" : u"No snapshot", kDim);
+    } else {
+      // Fit into 560×320.
+      const float scale = std::min(
+          {1.f, 560.f / snapshot_.width(), 320.f / snapshot_.height()});
+      auto* image = box->AddChildView(std::make_unique<views::ImageView>());
+      image->SetImage(ui::ImageModel::FromImageSkia(
+          gfx::ImageSkia::CreateFrom1xBitmap(snapshot_)));
+      image->SetImageSize(gfx::Size(snapshot_.width() * scale,
+                                    snapshot_.height() * scale));
+      image->SetHorizontalAlignment(views::ImageView::Alignment::kLeading);
+      snapshot_view_ = image;
+    }
+    if (request) {
+      TakeSnapshot(is_window, id);
+    }
+  }
+
+  void TakeSnapshot(bool is_window, int32_t id) {
+    auto callback = base::BindOnce(&PlutoniumOverlayView::OnSnapshot,
+                                   weak_ptr_factory_.GetWeakPtr(), page_key_);
+    if (is_window) {
+      exo::EmbeddedWindows::Get()->Snapshot(id, std::move(callback));
+    } else {
+      PlutoniumTabs::Get()->Snapshot(id, std::move(callback));
+    }
+  }
+
+  void OnSnapshot(const std::string& key, const SkBitmap& bitmap) {
+    if (key != page_key_) {
+      return;
+    }
+    snapshot_ = bitmap;
+    ++snapshot_generation_;
+    UpdatePage(/*force=*/false);
+  }
+
+  void RefreshSnapshot(bool is_window, int32_t id) {
+    TakeSnapshot(is_window, id);
+  }
+
+  void AddGroupToggles(Row::Kind kind, int32_t id) {
+    auto* groups = AddSection(u"Groups");
+    const std::vector<std::string> tags = TagsOf(kind, id);
+    const bool origin = HasOriginTag(kind, id);
+    if (PlutoniumGroups::Get()->groups().empty()) {
+      AddParagraph(groups, u"No shell has described any groups yet.", kDim);
+      return;
+    }
+    AddParagraph(groups,
+                 u"Adding it to a group (a shell's thread or workspace) "
+                 u"shows it there, and gives that thread's agent access.",
+                 kDim);
+    views::View* row = nullptr;
+    int in_row = 0;
+    for (const PlutoniumGroups::Group& group :
+         PlutoniumGroups::Get()->groups()) {
+      if (!row || in_row == 2) {
+        row = AddButtons(groups);
+        in_row = 0;
+      }
+      ++in_row;
+      const bool has = std::ranges::contains(tags, group.tag);
+      const bool fixed = origin && !tags.empty() && tags.front() == group.tag;
+      std::u16string label =
+          base::UTF8ToUTF16(group.label.empty() ? group.tag : group.label);
+      // Thread titles can be whole prompts.
+      if (label.size() > 32) {
+        label = label.substr(0, 31) + u"…";
+      }
+      const std::string shell = ShellName(group.shell_id);
+      if (!shell.empty()) {
+        label += u"  ·  " + base::UTF8ToUTF16(shell);
+      }
+      AddButton(row, (has ? u"✓ " : u"+ ") + label,
+                Bind(&PlutoniumOverlayView::ToggleGroup, kind, id, group.tag),
+                has ? ActionButton::Style::kPrimary
+                    : ActionButton::Style::kNormal,
+                !fixed);
+    }
+  }
+
+  std::u16string DescribeTags(const std::vector<std::string>& tags) const {
+    std::vector<std::u16string> parts;
+    for (const std::string& tag : tags) {
+      std::u16string label = TagLabel(tag);
+      parts.push_back(label == base::UTF8ToUTF16(tag)
+                          ? label
+                          : base::UTF8ToUTF16(tag) + u" (" + label + u")");
+    }
+    return base::JoinString(parts, u",  ");
+  }
+
+  void BuildWindowPage(int32_t id, bool request_snapshot) {
+    ExoWindowBroker* broker = ExoWindowBroker::Get();
+    std::optional<ExoWindowBroker::WindowInfo> window =
+        broker ? broker->GetWindow(id) : std::nullopt;
+    std::optional<exo::EmbeddedWindows::Info> info =
+        exo::EmbeddedWindows::Get()->GetInfo(id);
+    if (!window) {
+      AddTitle(u"Window closed");
+      return;
+    }
+    const bool presented = info && info->presented;
+    const std::u16string place = WindowPlace(id);
+    AddTitle(window->title.empty() ? base::UTF8ToUTF16(window->app_id)
+                                   : window->title,
+             base::ToUpperASCII(place.substr(0, 1)) + place.substr(1),
+             presented ? kAccent : place == u"not shown" ? kDim : kOk,
+             u"App window  ·  " + base::UTF8ToUTF16(window->app_id));
+
+    auto* actions = AddButtons(page_);
+    if (presented) {
+      AddButton(actions, u"Leave fullscreen",
+                Bind(&PlutoniumOverlayView::EndPresentation),
+                ActionButton::Style::kPrimary);
+    } else {
+      AddButton(actions, u"Show maximized",
+                Bind(&PlutoniumOverlayView::ShowWindowMaximized, id),
+                ActionButton::Style::kPrimary);
+      AddButton(actions, u"Open fullscreen",
+                Bind(&PlutoniumOverlayView::Present, id));
+    }
+    AddButton(actions, u"Pop out to the desktop",
+              Bind(&PlutoniumOverlayView::PopOut, id),
+              ActionButton::Style::kNormal, !(info && info->on_desktop));
+    AddButton(actions, u"Close", Bind(&PlutoniumOverlayView::CloseWindow, id),
+              ActionButton::Style::kDanger);
+    AddDisplayButtons(Row::Kind::kWindow, id);
+
+    // The shells that show it, and the others.
+    auto* shells = AddSection(u"In the shells");
+    const std::vector<std::string> showing = ShellsShowing(id);
+    std::string owner;
+    for (const std::string& tag : window->tags) {
+      if (std::optional<PlutoniumGroups::Group> group =
+              PlutoniumGroups::Get()->Find(tag)) {
+        owner = group->shell_id;
+        break;
+      }
+    }
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      if (!shell.running) {
+        continue;
+      }
+      const bool shows = std::ranges::contains(showing, shell.id);
+      auto* row = AddButtons(shells);
+      std::u16string what = shows ? u"shows it"
+                            : shell.id == owner
+                                ? u"its group's shell; doesn't show it now"
+                                : u"doesn't show it";
+      views::Label* name = AddLabel(
+          row, base::UTF8ToUTF16(shell.name) + u"  —  " + what,
+          shows ? kTitle : kDim, 1);
+      name->SetPreferredSize(
+          gfx::Size(360, name->GetPreferredSize(views::SizeBounds()).height()));
+      AddButton(row, u"Focus it in " + base::UTF8ToUTF16(shell.name),
+                Bind(&PlutoniumOverlayView::FocusWindowIn, id, shell.id),
+                shows ? ActionButton::Style::kPrimary
+                      : ActionButton::Style::kNormal);
+    }
+    if (showing.empty()) {
+      AddParagraph(shells,
+                   u"No shell shows it right now. Focusing it in one asks "
+                   u"that shell to show it; one that can't pops it out.",
+                   kDim);
+    }
+
+    auto* inspect = AddSection(u"Inspect");
+    AddSnapshot(inspect, request_snapshot, /*is_window=*/true, id);
+    auto* refresh = AddButtons(inspect);
+    AddButton(refresh, u"New snapshot",
+              Bind(&PlutoniumOverlayView::RefreshSnapshot, true, id));
+    AddField(inspect, u"Window id", base::NumberToString16(window->id));
+    AddField(inspect, u"App id", base::UTF8ToUTF16(window->app_id));
+    AddField(inspect, u"Process",
+             window->pid > 0 ? base::NumberToString16(window->pid)
+                             : u"unknown");
+    AddField(inspect, u"Size",
+             base::NumberToString16(window->size.width()) + u" × " +
+                 base::NumberToString16(window->size.height()) + u" at " +
+                 base::UTF8ToUTF16(
+                     base::NumberToString(window->device_scale_factor)) +
+                 u"×");
+    AddField(inspect, u"Keyboard focus", window->focused ? u"yes" : u"no");
+    AddField(inspect, u"Started in",
+             window->tag.empty() ? u"unknown" : TagLabel(window->tag));
+    AddField(inspect, u"Tags", DescribeTags(window->tags));
+    AddGroupToggles(Row::Kind::kWindow, id);
+  }
