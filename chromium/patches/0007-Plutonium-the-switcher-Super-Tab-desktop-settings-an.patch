+
+PlutoniumOverlay::PlutoniumOverlay(PlutoniumShells* shells) : shells_(shells) {}
+
+PlutoniumOverlay::~PlutoniumOverlay() {
+  widget_observation_.Reset();
+  view_ = nullptr;
+  widget_.reset();
+}
+
+void PlutoniumOverlay::OnSwitchKey(int step) {
+  if (IsOpen()) {
+    view_->Step(step);
+  } else {
+    Open(step);
+  }
+}
+
+bool PlutoniumOverlay::OpenPage(const std::string& page) {
+  if (!SettingsKind(page)) {
+    return false;
+  }
+  if (!IsOpen()) {
+    Open(0);
+  }
+  if (view_) {
+    view_->SelectSettingsPage(page);
+  }
+  return true;
+}
+
+// static
+gfx::Rect PlutoniumOverlay::BoundsIn(const gfx::Rect& work_area) {
+  gfx::Rect bounds(std::min(1320, work_area.width() * 94 / 100),
+                   std::min(860, work_area.height() * 90 / 100));
+  bounds.set_origin(
+      gfx::Point(work_area.x() + (work_area.width() - bounds.width()) / 2,
+                 work_area.y() + (work_area.height() - bounds.height()) / 2));
+  return bounds;
+}
+
+void PlutoniumOverlay::Recenter() {
+  if (!widget_ || !widget_->GetNativeWindow()) {
+    return;
+  }
+  widget_->SetBounds(
+      BoundsIn(display::Screen::Get()
+                   ->GetDisplayNearestWindow(widget_->GetNativeWindow())
+                   .work_area()));
+}
+
+void PlutoniumOverlay::Open(int step) {
+  aura::Window* root = ash::Shell::GetRootWindowForNewWindows();
+  if (!root) {
+    return;
+  }
+  const gfx::Rect bounds = BoundsIn(
+      display::Screen::Get()->GetDisplayNearestWindow(root).work_area());
+
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.name = "PlutoniumShellsOverlay";
+  params.parent =
+      ash::Shell::GetContainer(root, ash::kShellWindowId_OverlayContainer);
+  params.bounds = bounds;
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  widget_ = std::make_unique<views::Widget>(std::move(params));
+  // The overlay is dark: text fields and other controls take the dark
+  // theme's colors (light text), whatever Ash's own mode is.
+  widget_->SetColorModeOverride(ui::ColorProviderKey::ColorMode::kDark);
+  view_ = widget_->SetContentsView(
+      std::make_unique<PlutoniumOverlayView>(shells_, this, step));
+  widget_observation_.Observe(widget_.get());
+  widget_->Show();
+  widget_->Activate();
+  view_->FocusSearch();
+  VLOG(1) << "EXO-SHELLS overlay opened";
+}
+
+void PlutoniumOverlay::Close(bool acted) {
+  if (!widget_) {
+    return;
+  }
+  widget_observation_.Reset();
+  view_ = nullptr;
+  // Not from inside one of the widget's own calls (a key or a click).
+  base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(widget_));
+  if (!acted) {
+    // Back to the visible shell's page, unless something else is in front
+    // (a presented window, a backup window): Ash gives that its focus back.
+    if (content::WebContents* shell = shells_->GetVisibleContents();
+        shell && !exo::EmbeddedWindows::Get()->presented_window_id() &&
+        !PlutoniumTabs::Get()->presented_tab_id()) {
+      if (aura::Window* window = shell->GetTopLevelNativeWindow();
+          window && window->IsVisible()) {
+        wm::ActivateWindow(window);
+      }
+    }
+  }
+  VLOG(1) << "EXO-SHELLS overlay closed";
+}
+
+void PlutoniumOverlay::LaunchApp(
+    const std::string& app_id,
+    base::OnceCallback<void(const std::string& error)> callback) {
+  // Watch for its window from now: a quick app's may come before the answer.
+  launch_deadline_ = base::TimeTicks::Now() + kLaunchTimeout;
+  if (ExoWindowBroker* broker = ExoWindowBroker::Get();
+      broker && !broker_observation_.IsObserving()) {
+    broker_observation_.Observe(broker);
+  }
+  plutonium_helper::Post(
+      "/v1/apps/launch",
+      base::DictValue()
+          .Set("thread", kLaunchThread)
+          .Set("id", app_id)
+          // Not PLUTONIUM_SHOW: this presents it, the shells needn't.
+          .Set("show", false),
+      base::BindOnce(
+          [](base::WeakPtr<PlutoniumOverlay> overlay,
+             base::OnceCallback<void(const std::string&)> callback,
+             std::optional<base::Value> value, const std::string& error) {
+            if (overlay && !value) {
+              overlay->launch_deadline_ = base::TimeTicks();
+              overlay->broker_observation_.Reset();
+            }
+            std::move(callback).Run(value ? std::string() : error);
+          },
+          weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+bool PlutoniumOverlay::IsLaunching() const {
+  return !launch_deadline_.is_null() &&
+         base::TimeTicks::Now() < launch_deadline_;
+}
+
+void PlutoniumOverlay::OnWindowAdded(const ExoWindowBroker::WindowInfo& window) {
+  if (!IsLaunching()) {
+    broker_observation_.Reset();
+    launch_deadline_ = base::TimeTicks();
+    return;
+  }
+  if (std::ranges::contains(window.tags, kLaunchThread)) {
+    MaybePresentLaunched(window.id, kLaunchThread);
+    return;
+  }
+  if (!window.tags.empty() || window.pid <= 0) {
+    return;
+  }
+  // The browser couldn't read its client's environment (Ash in a
+  // container): the helper can.
+  plutonium_helper::Get(
+      "/v1/window-threads?pids=" + base::NumberToString(window.pid),
+      base::BindOnce(
+          [](base::WeakPtr<PlutoniumOverlay> overlay, int32_t window_id,
+             int32_t pid, std::optional<base::Value> value,
+             const std::string& error) {
+            const std::string* thread =
+                value && value->is_dict()
+                    ? value->GetDict().FindString(base::NumberToString(pid))
+                    : nullptr;
+            if (overlay && thread) {
+              overlay->MaybePresentLaunched(window_id, *thread);
+            }
+          },
+          weak_ptr_factory_.GetWeakPtr(), window.id, window.pid));
+}
+
+void PlutoniumOverlay::MaybePresentLaunched(int32_t window_id,
+                                            const std::string& thread) {
+  if (thread != kLaunchThread || !IsLaunching()) {
+    return;
+  }
+  launch_deadline_ = base::TimeTicks();
+  broker_observation_.Reset();
+  if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+    // Name its origin for every shell, if the browser couldn't.
+    broker->SetOriginTag(window_id, thread);
+  }
+  Close(/*acted=*/true);
+  exo::EmbeddedWindows::Get()->Present(window_id);
+  VLOG(1) << "EXO-SHELLS presenting launched window #" << window_id;
+}
+
+void PlutoniumOverlay::Reactivate() {
+  if (widget_) {
+    widget_->Activate();
+  }
+}
+
+void PlutoniumOverlay::OnWidgetActivationChanged(views::Widget* widget,
+                                                 bool active) {
+  if (!active) {
+    // Clicked away, or something else took over (unless it was given back
+    // meanwhile, see Reactivate()).
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<PlutoniumOverlay> overlay) {
+                         if (overlay && overlay->widget_ &&
+                             !overlay->widget_->IsActive()) {
+                           overlay->Close(/*acted=*/true);
+                         }
+                       },
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
+}
+
+void PlutoniumOverlay::OnWidgetDestroying(views::Widget* widget) {
+  widget_observation_.Reset();
+  view_ = nullptr;
+}
