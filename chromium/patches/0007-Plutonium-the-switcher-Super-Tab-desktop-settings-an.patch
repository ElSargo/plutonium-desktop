+  // Enter in a shell's fields, or their button: add or save.
+  void SubmitForm() {
+    const Row* row = Selected();
+    if (!row || !url_field_ || !name_field_ ||
+        (row->kind != Row::Kind::kShell && row->kind != Row::Kind::kAddShell)) {
+      return;
+    }
+    const std::string name = base::UTF16ToUTF8(
+        base::TrimWhitespace(name_field_->GetText(), base::TRIM_ALL));
+    const GURL url(base::UTF16ToUTF8(
+        base::TrimWhitespace(url_field_->GetText(), base::TRIM_ALL)));
+    if (!plutonium_shell::IsAcceptableShellUrl(url)) {
+      SetStatus(
+          u"A shell needs an http(s) address, https unless it's on this "
+          u"machine (127.0.0.1, localhost).");
+      return;
+    }
+    if (row->kind == Row::Kind::kAddShell) {
+      std::optional<std::string> id = shells_->AddShell(name, url);
+      if (!id) {
+        SetStatus(u"Couldn't add that shell.");
+        return;
+      }
+      Row added;
+      added.kind = Row::Kind::kShell;
+      added.shell_id = *id;
+      selected_key_ = added.key();
+      SetStatus(u"Added. Its page is loading in a hidden window.",
+                /*error=*/false);
+      Rebuild();
+      FocusSearch();
+      return;
+    }
+    if (!shells_->UpdateShell(row->shell_id, name, url)) {
+      SetStatus(u"Couldn't change that shell.");
+      return;
+    }
+    SetStatus(u"Saved.", /*error=*/false);
+    UpdatePage(/*force=*/true);
+  }
