+
+    windows_heading_ =
+        AddLabel(sidebar, u"WINDOWS AND TABS", kDim, -1, /*bold=*/true);
+    windows_heading_->SetBorder(
+        views::CreateEmptyBorder(gfx::Insets::TLBR(4, 10, 0, 10)));
+    windows_scroll_ = AddScrollList(sidebar, kSidebar);
+    sidebar_layout->SetFlexForView(windows_scroll_, 1);
+
+    // The main area: the selected item's page, a status line and the keys.
+    auto* main = AddChildView(std::make_unique<views::View>());
+    auto* main_layout = main->SetLayoutManager(
+        std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kVertical,
+            gfx::Insets::TLBR(20, 28, 14, 20), 10));
+    layout->SetFlexForView(main, 1);
+    page_scroll_ = main->AddChildView(std::make_unique<views::ScrollView>());
+    page_scroll_->SetBackgroundColor(kPanel);
+    page_scroll_->SetDrawOverflowIndicator(false);
+    page_scroll_->SetHorizontalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kDisabled);
+    page_ = page_scroll_->SetContents(std::make_unique<views::View>());
+    page_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical,
+        gfx::Insets::TLBR(0, 0, 0, 10), 14));
+    main_layout->SetFlexForView(page_scroll_, 1);
+
+    status_ = AddLabel(main, u"", kError, 0, false, /*multi_line=*/true);
+    status_->SetVisible(false);
+    footer_ = AddLabel(main, u"", kDim, -1, false, /*multi_line=*/true);
+
+    AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+
+    if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+      broker->AddObserver(this);
+    }
+    PlutoniumTabs::Get()->AddObserver(this);
+    PlutoniumGroups::Get()->AddObserver(this);
+    shells_->AddObserver(this);
+
+    // Start on the shell |step| away from the visible one.
+    std::vector<std::string> running;
+    std::string visible;
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      if (shell.running) {
+        running.push_back(shell.id);
+      }
+      if (shell.visible) {
+        visible = shell.id;
+      }
+    }
+    if (!running.empty()) {
+      auto it = std::ranges::find(running, visible);
+      const int count = static_cast<int>(running.size());
+      const int current =
+          it == running.end() ? -step : static_cast<int>(it - running.begin());
+      Row target;
+      target.kind = Row::Kind::kShell;
+      target.shell_id = running[((current + step) % count + count) % count];
+      selected_key_ = target.key();
+    }
+    Rebuild();
+    // Pages load and crash without telling anyone: look every second.
+    shell_states_ = ShellStates();
+    LoadPackages();
+    // EXO-SETTINGS
+    LoadServices();
+    display_structure_ = StructureJson(base::Value(DisplayConfig()));
+    poll_.Start(FROM_HERE, base::Seconds(1),
+                base::BindRepeating(&PlutoniumOverlayView::Poll,
+                                    base::Unretained(this)));
+  }
+
+  ~PlutoniumOverlayView() override {
+    shells_->RemoveObserver(this);
+    PlutoniumGroups::Get()->RemoveObserver(this);
+    PlutoniumTabs::Get()->RemoveObserver(this);
+    if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+      broker->RemoveObserver(this);
+    }
+  }
+
+  void Step(int step) { Move(step); }
+
+  void FocusSearch() { search_->RequestFocus(); }
+
+  // views::View:
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override {
+    if (accelerator.key_code() != ui::VKEY_ESCAPE) {
+      return false;
+    }
+    // From the page, back to the list; from the list, away.
+    if (search_->HasFocus()) {
+      overlay_->Close();
+    } else {
+      FocusSearch();
+    }
+    return true;
+  }
+
+  void Layout(PassKey) override {
+    LayoutSuperclass<views::View>(this);
+    SizeContents(shells_scroll_, kSidebarWidth - 24);
+    SizeContents(windows_scroll_, kSidebarWidth - 24);
+    SizeContents(page_scroll_, 600);
+  }
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override {
+    if (sender == search_) {
+      Rebuild();
+    } else if (sender == app_filter_) {
+      UpdateAppList();
+    }
+  }
+
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override {
+    if (event.type() != ui::EventType::kKeyPressed) {
+      return false;
+    }
+    if (sender == search_) {
+      return HandleListKey(event);
+    }
+    if ((event.flags() & kModifiers) == 0 &&
+        event.key_code() == ui::VKEY_RETURN) {
+      if (sender == app_filter_) {
+        LaunchFirstApp();
+      } else if (sender == password_field_) {
+        SubmitPassword();
+      } else {
+        SubmitForm();
+      }
+      return true;
+    }
+    return false;
+  }
+
