+Response PlutoniumHandler::GetWindowPopups(
+    int id,
+    std::unique_ptr<protocol::Array<Plutonium::Popup>>* popups) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    return NoWindow();
+  }
+  *popups = std::make_unique<protocol::Array<Plutonium::Popup>>();
+  for (const gfx::Rect& rect :
+       exo::EmbeddedWindows::Get()->GetPopupBounds(id)) {
+    (*popups)->push_back(Plutonium::Popup::Create()
+                             .SetX(rect.x())
+                             .SetY(rect.y())
+                             .SetWidth(rect.width())
+                             .SetHeight(rect.height())
+                             .Build());
+  }
+  return Response::Success();
+}
