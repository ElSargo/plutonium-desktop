+std::vector<std::pair<ShellSurfaceBase*, gfx::Vector2d>>
+ShellSurfaceBase::GetAgentPopups() const {
+  std::vector<std::pair<ShellSurfaceBase*, gfx::Vector2d>> popups;
+  if (!host_window()) {
+    return popups;
+  }
+  // Up to the root through the windows' bounds, leaving out the transform a
+  // shown popup is scaled with.
+  auto origin_in_root = [](const aura::Window* window) {
+    gfx::Point origin;
+    for (; window && window->parent(); window = window->parent()) {
+      origin += window->bounds().OffsetFromOrigin();
+    }
+    return std::make_pair(window, origin);
+  };
+  const auto [root, origin] = origin_in_root(host_window());
+  for (ShellSurfaceBase* popup : GetEmbedPopups()) {
+    if (!popup->widget_ || !popup->widget_->IsVisible() ||
+        !popup->host_window()) {
+      continue;
+    }
+    const auto [popup_root, popup_origin] =
+        origin_in_root(popup->host_window());
+    if (popup_root == root) {
+      popups.emplace_back(popup, popup_origin - origin);
+    }
+  }
+  return popups;
+}
+
+bool ShellSurfaceBase::DismissAgentPopups() {
+  // As OnCaptureChanged(): those with a grab and their descendants, leaf to
+  // root.
+  std::vector<ShellSurfaceBase*> to_close;
+  for (ShellSurfaceBase* popup : GetEmbedPopups()) {
+    aura::Window* parent_window =
+        popup->widget_
+            ? wm::GetTransientParent(popup->widget_->GetNativeWindow())
+            : nullptr;
+    ShellSurfaceBase* parent =
+        parent_window ? GetShellSurfaceBaseForWindow(parent_window) : nullptr;
+    if (popup->has_grab_ || std::ranges::contains(to_close, parent)) {
+      to_close.push_back(popup);
+    }
+  }
+  for (auto it = to_close.rbegin(); it != to_close.rend(); ++it) {
+    if ((*it)->widget_) {
+      (*it)->widget_->Close();
+    }
+  }
+  return !to_close.empty();
+}
