+std::vector<gfx::Rect> EmbeddedWindows::GetPopupBounds(
+    int32_t window_id) const {
+  std::vector<gfx::Rect> bounds;
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  if (!shell_surface) {
+    return bounds;
+  }
+  const gfx::Vector2d origin =
+      shell_surface->GetEmbedGeometry().OffsetFromOrigin();
+  for (const auto& [popup, offset] : shell_surface->GetAgentPopups()) {
+    gfx::Rect rect = popup->GetEmbedGeometry();
+    if (rect.IsEmpty()) {
+      continue;
+    }
+    rect.Offset(offset - origin);
+    bounds.push_back(rect);
+  }
+  return bounds;
 }
 
