new file mode 100644
index 0000000000..523e72a924
--- /dev/null
+++ b/chrome/browser/ui/ash/main_extra_parts/plutonium_app_icons.cc
@@ -0,0 +1,179 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/ash/main_extra_parts/plutonium_app_icons.h"
+
+#include <utility>
+
+#include "base/base64.h"
+#include "base/strings/escape.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/plutonium_tabs.h"
+#include "chrome/browser/ui/ash/main_extra_parts/plutonium_helper_client.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/gfx/geometry/size.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace {
+
+// Rasterized at this many pixels, drawn smaller.
+constexpr int kIconPixels = 64;
+// The decoder goes once it has been idle this long.
+constexpr base::TimeDelta kDecoderIdle = base::Seconds(30);
+
+// The image type of an icon file's bytes, or empty for none we decode.
+std::string MimeTypeOf(const std::string& bytes) {
+  if (base::StartsWith(bytes, "\x89PNG", base::CompareCase::SENSITIVE)) {
+    return "image/png";
+  }
+  if (bytes.find("<svg") != std::string::npos) {
+    return "image/svg+xml";
+  }
+  return std::string();
+}
+
+}  // namespace
+
+// static
+PlutoniumAppIcons* PlutoniumAppIcons::Get() {
+  static base::NoDestructor<PlutoniumAppIcons> instance;
+  return instance.get();
+}
+
+PlutoniumAppIcons::PlutoniumAppIcons() = default;
+PlutoniumAppIcons::~PlutoniumAppIcons() = default;
+
+gfx::ImageSkia PlutoniumAppIcons::GetIcon(const std::string& id) {
+  if (id.empty() || !plutonium_helper::IsAvailable()) {
+    return gfx::ImageSkia();
+  }
+  auto it = icons_.find(id);
+  if (it != icons_.end()) {
+    return it->second.image;
+  }
+  icons_[id] = Entry();
+  plutonium_helper::GetBytes(
+      "/v1/apps/" + base::EscapeAllExceptUnreserved(id) + "/icon",
+      base::BindOnce(&PlutoniumAppIcons::OnBytes, weak_factory_.GetWeakPtr(),
+                     id));
+  return gfx::ImageSkia();
+}
+
+base::CallbackListSubscription PlutoniumAppIcons::AddLoadedCallback(
+    base::RepeatingClosure loaded) {
+  return loaded_callbacks_.Add(std::move(loaded));
+}
+
+void PlutoniumAppIcons::OnBytes(const std::string& id,
+                                std::optional<std::string> body,
+                                const std::string& error) {
+  const std::string type = body ? MimeTypeOf(*body) : std::string();
+  if (type.empty()) {
+    Done(id, gfx::ImageSkia());
+    return;
+  }
+  Decode(id, "data:" + type + ";base64," + base::Base64Encode(*body));
+}
+
+void PlutoniumAppIcons::Decode(const std::string& id,
+                               const std::string& data_url) {
+  drop_timer_.Stop();
+  decoding_++;
+  if (!decoder_) {
+    content::WebContents* shell = PlutoniumTabs::Get()->shell();
+    if (!shell) {
+      decoding_--;
+      Done(id, gfx::ImageSkia());
+      return;
+    }
+    decoder_ = content::WebContents::Create(
+        content::WebContents::CreateParams(shell->GetBrowserContext()));
+    decoder_ready_ = false;
+    Observe(decoder_.get());
+    content::NavigationController::LoadURLParams params{
+        GURL(url::kAboutBlankURL)};
+    params.transition_type = ui::PAGE_TRANSITION_GENERATED;
+    decoder_->GetController().LoadURLWithParams(params);
+  }
+  base::OnceClosure decode = base::BindOnce(
+      [](base::WeakPtr<PlutoniumAppIcons> icons, std::string id,
+         std::string data_url) {
+        if (!icons || !icons->decoder_) {
+          return;
+        }
+        icons->decoder_->DownloadImage(
+            GURL(data_url), /*is_favicon=*/false,
+            gfx::Size(kIconPixels, kIconPixels), kIconPixels,
+            /*bypass_cache=*/false,
+            base::BindOnce(
+                [](base::WeakPtr<PlutoniumAppIcons> icons, std::string id,
+                   int, int, const GURL&, const std::vector<SkBitmap>& bitmaps,
+                   const std::vector<gfx::Size>&) {
+                  if (icons) {
+                    icons->OnDecoded(id, bitmaps);
+                  }
+                },
+                icons, id));
+      },
+      weak_factory_.GetWeakPtr(), id, data_url);
+  if (decoder_ready_) {
+    std::move(decode).Run();
+  } else {
+    waiting_.push_back(std::move(decode));
+  }
+}
+
+void PlutoniumAppIcons::DidStopLoading() {
+  if (decoder_ready_) {
+    return;
+  }
+  decoder_ready_ = true;
+  std::vector<base::OnceClosure> waiting = std::move(waiting_);
+  for (base::OnceClosure& decode : waiting) {
+    std::move(decode).Run();
+  }
+}
+
+void PlutoniumAppIcons::OnDecoded(const std::string& id,
+                                  const std::vector<SkBitmap>& bitmaps) {
+  decoding_--;
+  if (decoding_ <= 0) {
+    decoding_ = 0;
+    drop_timer_.Start(FROM_HERE, kDecoderIdle,
+                      base::BindOnce(&PlutoniumAppIcons::DropDecoder,
+                                     base::Unretained(this)));
+  }
+  // The largest (PNGs come at their own size, up to kIconPixels).
+  const SkBitmap* best = nullptr;
+  for (const SkBitmap& bitmap : bitmaps) {
+    if (!bitmap.drawsNothing() &&
+        (!best || bitmap.width() > best->width())) {
+      best = &bitmap;
+    }
+  }
+  Done(id, best ? gfx::ImageSkia::CreateFrom1xBitmap(*best)
+                : gfx::ImageSkia());
+}
+
+void PlutoniumAppIcons::Done(const std::string& id, gfx::ImageSkia image) {
+  Entry& entry = icons_[id];
+  entry.state = image.isNull() ? State::kNone : State::kLoaded;
+  entry.image = std::move(image);
+  if (entry.state == State::kLoaded) {
+    loaded_callbacks_.Notify();
+  }
+}
+
+void PlutoniumAppIcons::DropDecoder() {
+  if (decoding_ > 0) {
+    return;
+  }
+  Observe(nullptr);
+  decoder_.reset();
+  decoder_ready_ = false;
+}
