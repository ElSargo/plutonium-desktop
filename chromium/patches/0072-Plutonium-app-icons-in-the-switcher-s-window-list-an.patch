+namespace content {
+class WebContents;
+}
+
+// PLUTONIUM (EXO-SHELLS): the apps' icons for the switcher's window list and
+// launcher, from the helper (GET /v1/apps/<id>/icon, a PNG or an SVG; an id
+// that isn't a desktop entry's is looked up as a window's app id). An SVG
+// needs a renderer, so a background WebContents decodes them all, as
+// Chrome's Almanac icon loader does; it goes once nothing has needed it for a
+// while.
+class PlutoniumAppIcons : public content::WebContentsObserver {
+ public:
+  static PlutoniumAppIcons* Get();
+
+  PlutoniumAppIcons(const PlutoniumAppIcons&) = delete;
+  PlutoniumAppIcons& operator=(const PlutoniumAppIcons&) = delete;
+
+  // The icon for app (or window app id) |id|: empty while it loads (then the
+  // callbacks run) or when there's none.
+  gfx::ImageSkia GetIcon(const std::string& id);
+
+  // |loaded| runs each time an icon arrives.
+  base::CallbackListSubscription AddLoadedCallback(
+      base::RepeatingClosure loaded);
+
+  // content::WebContentsObserver:
+  void DidStopLoading() override;
+
+ private:
+  friend class base::NoDestructor<PlutoniumAppIcons>;
+
+  enum class State { kLoading, kLoaded, kNone };
+  struct Entry {
+    State state = State::kLoading;
+    gfx::ImageSkia image;
+  };
+
+  PlutoniumAppIcons();
+  ~PlutoniumAppIcons() override;
+
+  void OnBytes(const std::string& id,
+               std::optional<std::string> body,
+               const std::string& error);
+  void Decode(const std::string& id, const std::string& data_url);
+  void OnDecoded(const std::string& id, const std::vector<SkBitmap>& bitmaps);
+  void Done(const std::string& id, gfx::ImageSkia image);
+  void DropDecoder();
+
+  std::map<std::string, Entry> icons_;
+  base::RepeatingClosureList loaded_callbacks_;
+  // The decoder (about:blank), and what waits for it to load.
+  std::unique_ptr<content::WebContents> decoder_;
+  bool decoder_ready_ = false;
+  std::vector<base::OnceClosure> waiting_;
+  int decoding_ = 0;
+  base::OneShotTimer drop_timer_;
+  base::WeakPtrFactory<PlutoniumAppIcons> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_APP_ICONS_H_
diff --git a/chrome/browser/ui/ash/main_extra_parts/plutonium_helper_client.cc b/chrome/browser/ui/ash/main_extra_parts/plutonium_helper_client.cc
index d6ad263c48..57fc8e8909 100644
--- a/chrome/browser/ui/ash/main_extra_parts/plutonium_helper_client.cc
+++ b/chrome/browser/ui/ash/main_extra_parts/plutonium_helper_client.cc
@@ -177,4 +177,29 @@ void Post(const std::string& path, base::DictValue body, Callback callback) {
   Send("POST", path, json, std::move(callback));
 }
 
+void GetBytes(const std::string& path, BytesCallback callback) {
+  std::string request = "GET " + path +
+                        " HTTP/1.0\r\nHost: helper\r\nConnection: close\r\n\r\n";
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&Request, SocketPath(), std::move(request)),
+      base::BindOnce(
+          [](BytesCallback callback, Response response) {
+            if (!response.error.empty()) {
+              std::move(callback).Run(std::nullopt, response.error);
+            } else if (response.status < 200 || response.status >= 300) {
+              std::move(callback).Run(
+                  std::nullopt,
+                  "the helper answered " +
+                      base::NumberToString(response.status));
+            } else {
+              std::move(callback).Run(std::move(response.body),
+                                      std::string());
+            }
+          },
+          std::move(callback)));
+}
+
 }  // namespace plutonium_helper
