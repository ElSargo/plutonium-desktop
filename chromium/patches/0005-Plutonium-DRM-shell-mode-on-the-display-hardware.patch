@@ -12,6 +19,58 @@
 
 namespace gpu {
 
+namespace {
+
+// A hex number in a sysfs file ("0x1002\n"), or 0.
+uint32_t ReadSysfsHex(const base::FilePath& path) {
+  std::string text;
+  uint32_t value = 0;
+  if (!base::ReadFileToString(path, &text)) {
+    return 0;
+  }
+  std::string_view trimmed =
+      base::TrimWhitespaceASCII(text, base::TRIM_ALL);
+  if (base::StartsWith(trimmed, "0x")) {
+    trimmed.remove_prefix(2);
+  }
+  return base::HexStringToUInt(trimmed, &value) ? value : 0;
+}
+
+// Plutonium: the GPUs' PCI ids from sysfs, where ANGLE found none. ANGLE
+// reads them with libpci, which it dlopen()s, and a host without it (NixOS)
+// left the ids 0: the GPU blocklist's exceptions (ChromeOS's allows GPU
+// rasterization on AMD and Intel by vendor id) then never matched, and pages
+// were rastered on the CPU. The DRM devices' PCI functions have the same ids,
+// with no library. The active GPU is the one the firmware booted on
+// (boot_vga), else the first.
+void CollectPCIDevicesFromSysfs(angle::SystemInfo* info) {
+  // card0, card1, ...: links to the devices (not their connectors, card0-DP-1).
+  for (int index = 0; index < 16; ++index) {
+    const base::FilePath device(
+        base::StringPrintf("/sys/class/drm/card%d/device", index));
+    // Display controllers only (PCI class 0x03).
+    if ((ReadSysfsHex(device.Append("class")) >> 16) != 0x03) {
+      continue;
+    }
+    angle::GPUDeviceInfo gpu;
+    gpu.vendorId = ReadSysfsHex(device.Append("vendor"));
+    gpu.deviceId = ReadSysfsHex(device.Append("device"));
+    gpu.revisionId = ReadSysfsHex(device.Append("revision"));
+    if (!gpu.vendorId) {
+      continue;
+    }
+    if (ReadSysfsHex(device.Append("boot_vga")) == 1) {
+      info->activeGPUIndex = static_cast<int>(info->gpus.size());
+    }
+    info->gpus.push_back(std::move(gpu));
+  }
+  if (!info->gpus.empty() && info->activeGPUIndex < 0) {
+    info->activeGPUIndex = 0;
+  }
+}
+
+}  // namespace
+
 bool CollectContextGraphicsInfo(GPUInfo* gpu_info) {
   DCHECK(gpu_info);
 
@@ -32,6 +91,15 @@ bool CollectBasicGraphicsInfo(GPUInfo* gpu_info) {
 
   angle::SystemInfo system_info;
   bool success = angle::GetSystemInfo(&system_info);
+  if (system_info.gpus.empty() || !system_info.gpus[0].vendorId) {
+    angle::SystemInfo from_sysfs;
+    CollectPCIDevicesFromSysfs(&from_sysfs);
+    if (!from_sysfs.gpus.empty()) {
+      system_info.gpus = std::move(from_sysfs.gpus);
+      system_info.activeGPUIndex = from_sysfs.activeGPUIndex;
+      success = true;
+    }
+  }
   FillGPUInfoFromSystemInfo(gpu_info, &system_info);
   return success;
 }
