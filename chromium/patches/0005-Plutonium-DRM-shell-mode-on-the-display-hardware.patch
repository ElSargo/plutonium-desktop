+bool EventFactoryEvdev::HandleSessionKey(const KeyEventParams& params) {
+  LogindSession* session = LogindSession::Get();
+  if (!session) {
+    return false;
+  }
+  if (!params.down) {
+    return session_keys_down_.erase(params.code) > 0;
+  }
+  constexpr int kCtrlAlt = EF_CONTROL_DOWN | EF_ALT_DOWN;
+  if ((modifiers_.GetModifierFlags() & (kCtrlAlt | EF_SHIFT_DOWN |
+                                        EF_COMMAND_DOWN)) != kCtrlAlt) {
+    return false;
+  }
+  uint32_t vt = 0;
+  if (params.code >= KEY_F1 && params.code <= KEY_F10) {
+    vt = params.code - KEY_F1 + 1;
+  } else if (params.code == KEY_F11 || params.code == KEY_F12) {
+    vt = params.code - KEY_F11 + 11;
+  } else if (params.code != KEY_BACKSPACE) {
+    return false;
+  }
+  if (!session_keys_down_.insert(params.code).second) {
+    return true;  // Repeat.
+  }
+  if (vt) {
+    session->SwitchTo(vt);
+  } else {
+    // A clean exit, as from `plutonium stop`. logind restores the VT.
+    LOG(WARNING) << "Ctrl+Alt+Backspace: ending the session";
+    kill(getpid(), SIGTERM);
+  }
+  return true;
+}
