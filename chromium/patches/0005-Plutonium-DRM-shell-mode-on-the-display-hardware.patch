+// found in the LICENSE file.
+
+#ifndef UI_EVENTS_OZONE_DEVICE_LOGIND_SESSION_H_
+#define UI_EVENTS_OZONE_DEVICE_LOGIND_SESSION_H_
+
+#include <sys/types.h>
+
+#include <atomic>
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+
+#include "base/component_export.h"
+#include "base/files/file_path.h"
+#include "base/files/scoped_file.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/observer_list_threadsafe.h"
+#include "base/synchronization/waitable_event.h"
+#include "base/threading/thread.h"
+#include "dbus/object_path.h"
+
+namespace dbus {
+class Bus;
+class ObjectProxy;
+class Signal;
+}  // namespace dbus
+
+namespace ui {
+
+// --plutonium-logind-session[=<id>]: run as the controller of that logind
+// session (the caller's own without an id).
+COMPONENT_EXPORT(EVENTS_OZONE) extern const char kLogindSessionSwitch[];
+
+// Seat access through systemd-logind, for Ash on DRM on a VT, the way other
+// compositors do it: Chrome takes control of its session and opens the DRM
+// and input devices through logind (TakeDevice). logind does the rest of the
+// VT handling. It puts the VT in graphics mode with the kernel keyboard off,
+// switches VTs on request (SwitchTo), drops DRM master and revokes the input
+// devices when the session is switched away from, gives them back when it is
+// in front again, and restores the VT when Chrome exits, crashes included.
+//
+// All D-Bus traffic is on a thread of its own. OpenDevice() blocks the
+// calling thread until logind answers.
+class COMPONENT_EXPORT(EVENTS_OZONE) LogindSession {
+ public:
+  class Observer {
+   public:
+    // The session was switched away from: DRM master is gone and the input
+    // devices are revoked.
+    virtual void OnSessionPaused() {}
+    // The session is in front again and has DRM master back. Input devices
+    // must be opened again.
+    virtual void OnSessionResumed() {}
+
+   protected:
+    virtual ~Observer() = default;
+  };
+
+  // With --plutonium-logind-session, takes control of the session and returns
+  // it; null without the switch. A session that was asked for but can't be
+  // had is fatal: the VT would stay in text mode, taking every key typed.
+  static std::unique_ptr<LogindSession> CreateFromCommandLine();
+
+  // The session controller, if Chrome is one.
+  static LogindSession* Get();
+
+  LogindSession(const LogindSession&) = delete;
+  LogindSession& operator=(const LogindSession&) = delete;
+  ~LogindSession();
+
+  // Whether the session is in front (its devices work).
+  bool is_active() const { return active_; }
+
+  // Opens a DRM or input device through logind. Blocks; not on the UI thread
+  // after startup. An input device can't be opened while the session is
+  // inactive.
+  base::ScopedFD OpenDevice(const base::FilePath& path);
+
+  // Switches to VT |vt|. Logind pauses this session first if it is leaving.
+  void SwitchTo(uint32_t vt);
+
+  // Observers are called on the sequence they were added on.
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  LogindSession();
+
+  bool Start(const std::string& session_id);
+
+  // On |thread_|.
+  void StartOnThread(const std::string& session_id,
+                     bool* result,
+                     base::WaitableEvent* done);
+  bool TakeControl(const std::string& session_id);
+  void OpenDeviceOnThread(dev_t device,
