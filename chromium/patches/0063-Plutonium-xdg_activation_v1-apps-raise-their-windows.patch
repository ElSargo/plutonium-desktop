+bool RequestActivateWindow(int32_t window_id) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  std::optional<ExoWindowBroker::WindowInfo> window =
+      broker ? broker->GetWindow(window_id) : std::nullopt;
+  if (!window || !shells) {
+    return false;
+  }
+  content::WebContents* shell = nullptr;
+  for (const std::string& tag : window->tags) {
+    std::optional<PlutoniumGroups::Group> group =
+        PlutoniumGroups::Get()->Find(tag);
+    shell = group ? shells->GetContents(group->shell_id) : nullptr;
+    if (shell) {
+      break;
+    }
+  }
+  if (!shell) {
+    shell = shells->GetVisibleContents();
+  }
+  const bool requested = shell && RequestShowWindow(shell, window_id);
+  VLOG(1) << "EXO-ACTIVATION window #" << window_id
+          << (requested ? " asked of its shell" : ": no shell takes it");
+  return requested;
+}
