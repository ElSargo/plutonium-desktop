From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Mon, 26 Oct 2026 13:00:51 +1300
Subject: [PATCH 62/62] Plutonium: the switcher turns on shells added on the
 helper's shells page

GET /v1/shells marks a shell the helper's page just added ("add"); the
switcher, when it's open, adds it to the browser's list if no shell is on
its origin yet.
---
 .../ui/ash/main_extra_parts/plutonium_overlay.cc | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc b/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc
index 60b9dd41ec..c27c961ce6 100644
--- a/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc
+++ b/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc
@@ -602,6 +602,22 @@ class PlutoniumOverlayView : public views::View,
     packages_ = std::move(value->GetList());
     for (const base::Value& package : packages_) {
       const base::DictValue* dict = package.GetIfDict();
+      // Added on the helper's shells page: on, in the browser's list too.
+      const std::string* url = dict ? dict->FindString("url") : nullptr;
+      const std::string* title = dict ? dict->FindString("title") : nullptr;
+      if (dict && dict->FindBool("add").value_or(false) && url && title) {
+        const GURL page(*url);
+        const bool listed = std::ranges::any_of(
+            shells_->GetShells(), [&](const PlutoniumShells::Shell& shell) {
+              return shell.origin.IsSameOriginWith(url::Origin::Create(page));
+            });
+        if (!listed && plutonium_shell::IsAcceptableShellUrl(page) &&
+            shells_->AddShell(*title, page)) {
+          SetStatus(u"Added " + base::UTF8ToUTF16(*title) +
+                        u" from the shells page. Its page is loading.",
+                    /*error=*/false);
+        }
+      }
       const std::string* notice = dict ? dict->FindString("notice") : nullptr;
       if (notice && !notice->empty() &&
           !std::ranges::contains(notices_shown_, *notice)) {
