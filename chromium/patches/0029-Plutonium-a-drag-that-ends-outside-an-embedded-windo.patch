From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sarol263@student.otago.ac.nz>
Date: Tue, 20 Oct 2026 20:17:34 +1300
Subject: [PATCH 29/56] Plutonium: a drag that ends outside an embedded window
 leaves it

EXO-EMBED: when a press in an embedded window ends with the pointer over
something else, the window gets wl_pointer.leave with the release, as on
other compositors, not at the next move.
---
 .../render_widget_host_input_event_router.cc  | 25 ++++++++++++++++++-
 .../render_widget_host_input_event_router.h   |  3 +++
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/components/input/render_widget_host_input_event_router.cc b/components/input/render_widget_host_input_event_router.cc
index 83587d8053..3a03aca461 100644
--- a/components/input/render_widget_host_input_event_router.cc
+++ b/components/input/render_widget_host_input_event_router.cc
@@ -853,13 +853,36 @@ bool RenderWidgetHostInputEventRouter::RouteToForeignCapture(
     return false;
   }
   viz::FrameSinkId sink = foreign_capture_sink_;
-  if (!ButtonsDownAfter(event)) {
+  const bool ends = !ButtonsDownAfter(event);
+  if (ends) {
     foreign_capture_sink_ = viz::FrameSinkId();
   }
   RouteToForeignSink(root_view, sink, event);
+  // A drag that ends outside the window leaves it now (wl_pointer.leave), as
+  // on other compositors, rather than at the next move.
+  if (ends && HitTestFrameSink(root_view, event) != sink) {
+    ForeignHoverLeave();
+  }
   return true;
 }
 
+viz::FrameSinkId RenderWidgetHostInputEventRouter::HitTestFrameSink(
+    RenderWidgetHostViewInput* root_view,
+    const blink::WebMouseEvent& event) {
+  viz::HitTestQuery* query =
+      GetHitTestQuery(hit_test_provider_, root_view->GetRootFrameSinkId());
+  if (!query) {
+    return viz::FrameSinkId();
+  }
+  return query
+      ->FindTargetForLocationStartingFrom(
+          viz::EventSource::MOUSE,
+          gfx::ConvertPointToPixels(event.PositionInWidget(),
+                                    root_view->GetDeviceScaleFactor()),
+          root_view->GetFrameSinkId())
+      .frame_sink_id;
+}
+
 // EXO-EMBED: the rest of a wheel sequence (phases changed/ended, momentum)
 // goes where its first event went. The targeter only hit-tests the first one
 // and sends the others to |wheel_target_|, a view; a native window has none,
diff --git a/components/input/render_widget_host_input_event_router.h b/components/input/render_widget_host_input_event_router.h
index 24dee7f137..560c51bae5 100644
--- a/components/input/render_widget_host_input_event_router.h
+++ b/components/input/render_widget_host_input_event_router.h
@@ -308,6 +308,9 @@ class COMPONENT_EXPORT(INPUT) RenderWidgetHostInputEventRouter final
   // any. Returns true if routed (or dropped because the sink is gone).
   bool RouteToForeignCapture(RenderWidgetHostViewInput* root_view,
                              const blink::WebMouseEvent& event);
+  // The frame sink viz hit-tests |event| to in |root_view|, or an invalid id.
+  viz::FrameSinkId HitTestFrameSink(RenderWidgetHostViewInput* root_view,
+                                    const blink::WebMouseEvent& event);
   // Routes the rest of a wheel sequence to the native window it started on.
   bool RouteWheelToForeignLatch(RenderWidgetHostViewInput* root_view,
                                 const blink::WebMouseWheelEvent& event);
