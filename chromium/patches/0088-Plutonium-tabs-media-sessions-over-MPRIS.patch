From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Wed, 28 Oct 2026 08:39:51 +1300
Subject: [PATCH 88/90] Plutonium: tabs' media sessions over MPRIS

Linux Chromium puts the active media session on the session bus as an
org.mpris.MediaPlayer2 player, for media keys, playerctl and desktop
widgets; a ChromeOS build doesn't build it (use_mpris is is_linux) and
turns MediaKeysListenerManager off, as Ash has its own media controls.
Ash runs on a Linux desktop session here: build use_mpris for ChromeOS
too (with dbus_thread_linux's shared session bus), and run the manager
with SystemMediaControlsLinux as on Linux. Ash still handles the
hardware media keys itself.
---
 components/dbus/BUILD.gn                                   | 3 +++
 components/dbus/thread_linux/dbus_thread_linux.h           | 5 ++---
 .../system_media_controls/linux/buildflags/buildflags.gni  | 3 ++-
 content/browser/media/media_keys_listener_manager_impl.cc  | 2 +-
 content/public/browser/BUILD.gn                            | 1 +
 content/public/browser/media_keys_listener_manager.cc      | 7 ++++---
 6 files changed, 13 insertions(+), 8 deletions(-)

diff --git a/components/dbus/BUILD.gn b/components/dbus/BUILD.gn
index 20c0538f64..3119059bf2 100644
--- a/components/dbus/BUILD.gn
+++ b/components/dbus/BUILD.gn
@@ -12,6 +12,9 @@ component("dbus") {
       "//components/dbus/thread_linux",
       "//components/dbus/xdg",
     ]
+  } else if (is_chromeos) {
+    # Plutonium: the desktop session's bus, for MPRIS.
+    public_deps += [ "//components/dbus/thread_linux" ]
   }
 }
 
diff --git a/components/dbus/thread_linux/dbus_thread_linux.h b/components/dbus/thread_linux/dbus_thread_linux.h
index 99b78bba6f..99e8165a76 100644
--- a/components/dbus/thread_linux/dbus_thread_linux.h
+++ b/components/dbus/thread_linux/dbus_thread_linux.h
@@ -10,9 +10,8 @@
 #include "base/memory/scoped_refptr.h"
 #include "build/build_config.h"
 
-#if BUILDFLAG(IS_CHROMEOS)
-#error On ChromeOS, use DBusThreadManager instead.
-#endif
+// Plutonium: ChromeOS uses it too, for the desktop session's bus (MPRIS),
+// which DBusThreadManager (the system bus) doesn't have.
 
 namespace dbus {
 class Bus;
diff --git a/components/system_media_controls/linux/buildflags/buildflags.gni b/components/system_media_controls/linux/buildflags/buildflags.gni
index 539eea3c1f..d2e0774f8e 100644
--- a/components/system_media_controls/linux/buildflags/buildflags.gni
+++ b/components/system_media_controls/linux/buildflags/buildflags.gni
@@ -7,5 +7,6 @@ import("//build/config/features.gni")
 declare_args() {
   # Enables Chromium implementation of the MPRIS D-Bus interface for controlling
   # media playback. See ../README.md for details.
-  use_mpris = is_linux && use_dbus
+  # Plutonium: also ChromeOS, whose Ash runs on a Linux desktop session.
+  use_mpris = (is_linux || is_chromeos) && use_dbus
 }
diff --git a/content/browser/media/media_keys_listener_manager_impl.cc b/content/browser/media/media_keys_listener_manager_impl.cc
index 609e46ffd0..a4516351b2 100644
--- a/content/browser/media/media_keys_listener_manager_impl.cc
+++ b/content/browser/media/media_keys_listener_manager_impl.cc
@@ -331,7 +331,7 @@ void MediaKeysListenerManagerImpl::StartListeningForMediaKeysIfNecessary() {
     return;
   }
 
-#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_WIN)
   // Create SystemMediaControls with the SingletonHwnd.
   browser_system_media_controls_ =
       system_media_controls::SystemMediaControls::Create(
diff --git a/content/public/browser/BUILD.gn b/content/public/browser/BUILD.gn
index 4ff52ee455..9b5c5d9ca2 100644
--- a/content/public/browser/BUILD.gn
+++ b/content/public/browser/BUILD.gn
@@ -638,6 +638,7 @@ source_set("browser_sources") {
     "//components/language_detection/content/common",
     "//components/language_detection/core/browser:language_detection_model_service",
     "//components/services/storage/public/cpp",
+    "//components/system_media_controls/linux/buildflags",
     "//components/variations",
     "//components/viz/host",
     "//content/browser",  # Must not be public_deps!
diff --git a/content/public/browser/media_keys_listener_manager.cc b/content/public/browser/media_keys_listener_manager.cc
index 1be210f320..31a5f4f35b 100644
--- a/content/public/browser/media_keys_listener_manager.cc
+++ b/content/public/browser/media_keys_listener_manager.cc
@@ -6,16 +6,17 @@
 
 #include "build/build_config.h"
 
-#if !BUILDFLAG(IS_CHROMEOS)
 #include "base/feature_list.h"
+#include "components/system_media_controls/linux/buildflags/buildflags.h"
 #include "media/base/media_switches.h"
-#endif
 
 namespace content {
 
 // static
 bool MediaKeysListenerManager::IsMediaKeysListenerManagerEnabled() {
-#if BUILDFLAG(IS_CHROMEOS)
+// Plutonium: with MPRIS, ChromeOS has it too: the active media session on the
+// desktop session's bus (its media keys are still Ash's).
+#if BUILDFLAG(IS_CHROMEOS) && !BUILDFLAG(USE_MPRIS)
   return false;
 #else
   return base::FeatureList::IsEnabled(media::kHardwareMediaKeyHandling);
