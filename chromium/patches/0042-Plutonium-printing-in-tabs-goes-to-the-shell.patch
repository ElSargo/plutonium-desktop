+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PLUTONIUM_PRINT_H_
+#define CHROME_BROWSER_PLUTONIUM_PRINT_H_
+
+#include "base/values.h"
+#include "chrome/browser/plutonium_tabs.h"
+
+namespace content {
+class WebContents;
+}
+
+// EXO-TAB-FEATURES (docs/features/TAB_FEATURES.md, "Printing"): printing in
+// the registry's tabs, which have no Browser.
+//
+// Ctrl+P, tabCommand(id, "print") and the page's window.print() all reach
+// PrintViewManager, which would open Chrome's print preview. For a registry
+// tab it asks the shell instead: a tab request of kind "print", with detail
+// {title, url, thread, hasSelection, scripted, pdf}. The shell builds its
+// preview with the "print-to-pdf" command, prints or saves the PDF through
+// the helper, and answers "done" or "cancel" (agents may answer too). Until
+// then the page's window.print() doesn't return.
+//
+// If no shell takes it, Chrome's print preview opens over the shell's window
+// (the tab's WebContentsModalDialogManager hosts it there). If the shell that
+// took it goes away, printing is cancelled.
+namespace plutonium_print {
+
+// Attaches printing to tab |contents| (Tab::AttachHelpers()).
+void AttachHelpers(content::WebContents* contents);
+
+// The "print" command (Ctrl+P): starts printing the tab, as Chrome's Print
+// command does. Resolves with whether it started (false while printing).
+void RunPrintCommand(content::WebContents* contents,
+                     const base::DictValue& args,
+                     PlutoniumTabs::CommandCallback done);
+
+// The "print-to-pdf" command: the tab (or, while it waits on a print request,
+// the frame that asked) as a PDF, {"data": <base64>}. |args| are those of the
+// DevTools protocol's Page.printToPDF, in inches: landscape,
+// displayHeaderFooter, printBackground, scale, paperWidth, paperHeight,
+// marginTop, marginBottom, marginLeft, marginRight, pageRanges,
+// headerTemplate, footerTemplate, preferCSSPageSize.
+void RunPrintToPdfCommand(content::WebContents* contents,
+                          const base::DictValue& args,
+                          PlutoniumTabs::CommandCallback done);
+
+}  // namespace plutonium_print
+
+#endif  // CHROME_BROWSER_PLUTONIUM_PRINT_H_
