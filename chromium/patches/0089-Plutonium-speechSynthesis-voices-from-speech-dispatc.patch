From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Wed, 28 Oct 2026 08:40:48 +1300
Subject: [PATCH 89/95] Plutonium: speechSynthesis voices from
 speech-dispatcher

A ChromeOS build's platform TTS is ARC's (TtsPlatformImplChromeOs), and
its other voices are TTS extensions, so with neither speechSynthesis
has no voices. Linux Chromium speaks through speech-dispatcher
(tts_linux.cc, libspeechd dlopen()ed, behind --enable-speech-dispatcher).
Build tts_linux.cc for ChromeOS too, and use it when ARC's TTS isn't
there: content's TtsPlatform falls back to it instead of NOTREACHED().
TTS extensions' voices are listed as before. Off a real ChromeOS device,
TtsExtensionEngineChromeOS waited for its built-in eSpeak extension,
which this build doesn't have, before speaking anything; it doesn't now.
---
 chrome/browser/chrome_content_browser_client.cc      |  7 ++++++-
 .../tts_engine_extension_api_chromeos.cc             |  7 ++++---
 content/browser/BUILD.gn                             |  4 ++++
 content/browser/speech/tts_platform_impl.cc          | 12 +-----------
 content/browser/speech/tts_platform_impl.h           |  2 +-
 content/public/common/content_switches.cc            |  2 +-
 content/public/common/content_switches.h             |  3 ++-
 7 files changed, 19 insertions(+), 18 deletions(-)

diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index a988f740ac..802a2d3e2b 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -4700,7 +4700,12 @@ content::TtsPlatform* ChromeContentBrowserClient::GetTtsPlatform() {
       TtsExtensionEngine::GetInstance());
 #endif
 #if BUILDFLAG(IS_CHROMEOS)
-  return TtsPlatformImplChromeOs::GetInstance();
+  // Plutonium: ARC's voices only when ARC is there to speak them; else the
+  // desktop session's speech-dispatcher (content's tts_linux.cc).
+  if (TtsPlatformImplChromeOs::GetInstance()->PlatformImplSupported()) {
+    return TtsPlatformImplChromeOs::GetInstance();
+  }
+  return nullptr;
 #else
   return nullptr;
 #endif
diff --git a/chrome/browser/speech/extension_api/tts_engine_extension_api_chromeos.cc b/chrome/browser/speech/extension_api/tts_engine_extension_api_chromeos.cc
index dc740e5987..e3657a2a50 100644
--- a/chrome/browser/speech/extension_api/tts_engine_extension_api_chromeos.cc
+++ b/chrome/browser/speech/extension_api/tts_engine_extension_api_chromeos.cc
@@ -141,10 +141,11 @@ bool TtsExtensionEngineChromeOS::IsBuiltInTtsEngineInitialized(
   }
 
   // When running on a real Chrome OS environment, require both Google tts and
-  // Espeak to be initialized; otherwise, only check for Espeak (i.e. on a
-  // non-Chrome OS linux system running the Chrome OS variant of Chrome).
+  // Espeak to be initialized. Plutonium: otherwise none; its build has no
+  // built-in engines, and pages speak through speech-dispatcher (tts_linux.cc)
+  // instead of waiting for an Espeak that never comes.
   return base::SysInfo::IsRunningOnChromeOS() ? (saw_google_tts && saw_espeak)
-                                              : saw_espeak;
+                                              : true;
 }
 
 void TtsExtensionEngineChromeOS::OnStart() {
diff --git a/content/browser/BUILD.gn b/content/browser/BUILD.gn
index 7e121dff72..c6a07d132f 100644
--- a/content/browser/BUILD.gn
+++ b/content/browser/BUILD.gn
@@ -2577,6 +2577,10 @@ source_set("browser") {
       "//third_party/speech-dispatcher",
       "//ui/linux:linux_ui",
     ]
+  } else if (is_chromeos) {
+    # Plutonium: speech-dispatcher's voices, from the desktop session's.
+    sources += [ "speech/tts_linux.cc" ]
+    deps += [ "//third_party/speech-dispatcher" ]
   }
 
   # ChromeOS also defines linux but their memory-monitors conflict.
diff --git a/content/browser/speech/tts_platform_impl.cc b/content/browser/speech/tts_platform_impl.cc
index 2a2c89228d..4839b3bc1a 100644
--- a/content/browser/speech/tts_platform_impl.cc
+++ b/content/browser/speech/tts_platform_impl.cc
@@ -21,18 +21,8 @@ TtsPlatform* TtsPlatform::GetInstance() {
     return result;
 #endif
 
-#if BUILDFLAG(IS_CHROMEOS)
-  // On Chrome OS, the platform TTS definition is provided by the content
-  // client.
-  //
-  // If this code is reached in production it implies that somebody is
-  // trying to do TTS on a platform where the content client implementation
-  // is not provided, that's probably not intended. It's not important
-  // if this is hit in something like a content-only unit test.
-  NOTREACHED();
-#else
+  // Plutonium: on ChromeOS too, speech-dispatcher's (tts_linux.cc).
   return TtsPlatformImpl::GetInstance();
-#endif
 }
 
 void TtsPlatformImpl::LoadBuiltInTtsEngine(BrowserContext* browser_context) {}
diff --git a/content/browser/speech/tts_platform_impl.h b/content/browser/speech/tts_platform_impl.h
index e5e686ad50..f36bf1e6ce 100644
--- a/content/browser/speech/tts_platform_impl.h
+++ b/content/browser/speech/tts_platform_impl.h
@@ -15,7 +15,7 @@
 
 namespace content {
 
-#if BUILDFLAG(IS_LINUX)
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
 // Overrides the library path captured when the Linux TTS singleton is created.
 // Must be called before TtsPlatform::GetInstance().
 CONTENT_EXPORT base::AutoReset<std::string>
diff --git a/content/public/common/content_switches.cc b/content/public/common/content_switches.cc
index c5dbb4130b..fa01bf91e9 100644
--- a/content/public/common/content_switches.cc
+++ b/content/public/common/content_switches.cc
@@ -942,7 +942,7 @@ const char kPreventResizingContentsForTesting[] =
     "prevent-resizing-contents-for-testing";
 #endif
 
-#if BUILDFLAG(IS_LINUX)
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
 // Allows sending text-to-speech requests to speech-dispatcher, a common
 // Linux speech service. Because it's buggy, the user must explicitly
 // enable it so that visiting a random webpage can't cause instability.
diff --git a/content/public/common/content_switches.h b/content/public/common/content_switches.h
index d3bc2ede84..8ce47279b9 100644
--- a/content/public/common/content_switches.h
+++ b/content/public/common/content_switches.h
@@ -257,7 +257,8 @@ CONTENT_EXPORT extern const char kJavalessRenderers[];
 CONTENT_EXPORT extern const char kPreventResizingContentsForTesting[];
 #endif
 
-#if BUILDFLAG(IS_LINUX)
+// Plutonium: and ChromeOS (tts_linux.cc).
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
 CONTENT_EXPORT extern const char kEnableSpeechDispatcher[];
 #endif
 
