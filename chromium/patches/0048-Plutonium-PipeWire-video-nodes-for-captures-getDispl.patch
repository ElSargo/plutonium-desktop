+// PLUTONIUM (EXO-CAPTURE): in shell mode a page's getDisplayMedia() asks the
+// focused shell (a "capturerequest", as an app's portal request does), else
+// Ash's own picker (docs/features/CAPTURE.md, "Tabs"). The stream stays in
+// Chromium: the answer is a DesktopMediaID of the same sources.
+class PlutoniumDesktopMediaPicker : public DesktopMediaPicker {
+ public:
+  PlutoniumDesktopMediaPicker() = default;
+  PlutoniumDesktopMediaPicker(const PlutoniumDesktopMediaPicker&) = delete;
+  PlutoniumDesktopMediaPicker& operator=(const PlutoniumDesktopMediaPicker&) =
+      delete;
+  ~PlutoniumDesktopMediaPicker() override {
+    if (request_id_) {
+      PlutoniumCapture::Get()->CancelRequest(request_id_);
+    }
+  }
+
+  // DesktopMediaPicker:
+  void Show(const Params& params,
+            std::vector<std::unique_ptr<DesktopMediaList>> source_lists,
+            DoneCallback done_callback) override {
+    PlutoniumCapture* capture = PlutoniumCapture::Get();
+    if (!capture->recording_allowed()) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              std::move(done_callback),
+              DoneCallbackArgumentType(base::unexpected(
+                  blink::mojom::MediaStreamRequestResult::PERMISSION_DENIED))));
+      return;
+    }
+    consumer_ = capture->ConsumerFor(params.web_contents, params.app_name);
+    base::ListValue types;
+    types.Append("output");
+    types.Append("window");
+    types.Append("tab");
+    request_id_ = capture->Request(
+        base::DictValue()
+            .Set("kind", "screencast")
+            .Set("consumer", consumer_.Clone())
+            .Set("types", std::move(types))
+            .Set("multiple", false),
+        base::BindOnce(&PlutoniumDesktopMediaPicker::OnAnswer,
+                       weak_factory_.GetWeakPtr(), std::move(done_callback)));
+  }
+
+ private:
+  void OnAnswer(DoneCallback done_callback, std::optional<base::Value> answer) {
+    request_id_ = 0;
+    const content::DesktopMediaID media_id =
+        answer ? PlutoniumCapture::Get()->PrepareDisplay(*answer,
+                                                         consumer_.Clone())
+               : content::DesktopMediaID();
+    if (media_id.is_null()) {
+      std::move(done_callback)
+          .Run(base::unexpected(
+              blink::mojom::MediaStreamRequestResult::PERMISSION_DENIED));
+      return;
+    }
+    std::move(done_callback).Run(media_id);
+  }
+
+  int32_t request_id_ = 0;
+  base::DictValue consumer_;
+  base::WeakPtrFactory<PlutoniumDesktopMediaPicker> weak_factory_{this};
+};
+
+}  // namespace
+#endif  // BUILDFLAG(IS_CHROMEOS)
