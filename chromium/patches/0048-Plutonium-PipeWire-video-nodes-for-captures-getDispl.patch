+// libpipewire, loaded at run time (the container image may not have it).
+struct PipeWire {
+  decltype(&pw_init) init = nullptr;
+  decltype(&pw_thread_loop_new) thread_loop_new = nullptr;
+  decltype(&pw_thread_loop_get_loop) thread_loop_get_loop = nullptr;
+  decltype(&pw_thread_loop_start) thread_loop_start = nullptr;
+  decltype(&pw_thread_loop_stop) thread_loop_stop = nullptr;
+  decltype(&pw_thread_loop_destroy) thread_loop_destroy = nullptr;
+  decltype(&pw_thread_loop_lock) thread_loop_lock = nullptr;
+  decltype(&pw_thread_loop_unlock) thread_loop_unlock = nullptr;
+  decltype(&pw_context_new) context_new = nullptr;
+  decltype(&pw_context_destroy) context_destroy = nullptr;
+  decltype(&pw_context_connect) context_connect = nullptr;
+  decltype(&pw_core_disconnect) core_disconnect = nullptr;
+  decltype(&pw_properties_new) properties_new = nullptr;
+  decltype(&pw_stream_new) stream_new = nullptr;
+  decltype(&pw_stream_add_listener) stream_add_listener = nullptr;
+  decltype(&pw_stream_connect) stream_connect = nullptr;
+  decltype(&pw_stream_update_params) stream_update_params = nullptr;
+  decltype(&pw_stream_dequeue_buffer) stream_dequeue_buffer = nullptr;
+  decltype(&pw_stream_queue_buffer) stream_queue_buffer = nullptr;
+  decltype(&pw_stream_destroy) stream_destroy = nullptr;
+  decltype(&pw_stream_get_node_id) stream_get_node_id = nullptr;
+  decltype(&pw_stream_trigger_process) stream_trigger_process = nullptr;
+  decltype(&pw_stream_state_as_string) stream_state_as_string = nullptr;
+
+  // Null if there's no libpipewire.
+  static const PipeWire* Get() {
+    static const std::optional<PipeWire> instance = Load();
+    return instance ? &instance.value() : nullptr;
+  }
+
+ private:
+  static std::optional<PipeWire> Load() {
+    void* library = dlopen("libpipewire-0.3.so.0", RTLD_NOW | RTLD_LOCAL);
+    if (!library) {
+      LOG(WARNING) << "EXO-CAPTURE no libpipewire: " << dlerror();
+      return std::nullopt;
+    }
+    PipeWire lib;
+    bool ok = true;
+    auto load = [&](auto& function, const char* name) {
+      function = reinterpret_cast<std::remove_reference_t<decltype(function)>>(
+          dlsym(library, name));
+      ok &= !!function;
+    };
+    load(lib.init, "pw_init");
+    load(lib.thread_loop_new, "pw_thread_loop_new");
+    load(lib.thread_loop_get_loop, "pw_thread_loop_get_loop");
+    load(lib.thread_loop_start, "pw_thread_loop_start");
+    load(lib.thread_loop_stop, "pw_thread_loop_stop");
+    load(lib.thread_loop_destroy, "pw_thread_loop_destroy");
+    load(lib.thread_loop_lock, "pw_thread_loop_lock");
+    load(lib.thread_loop_unlock, "pw_thread_loop_unlock");
+    load(lib.context_new, "pw_context_new");
+    load(lib.context_destroy, "pw_context_destroy");
+    load(lib.context_connect, "pw_context_connect");
+    load(lib.core_disconnect, "pw_core_disconnect");
+    load(lib.properties_new, "pw_properties_new");
+    load(lib.stream_new, "pw_stream_new");
+    load(lib.stream_add_listener, "pw_stream_add_listener");
+    load(lib.stream_connect, "pw_stream_connect");
+    load(lib.stream_update_params, "pw_stream_update_params");
+    load(lib.stream_dequeue_buffer, "pw_stream_dequeue_buffer");
+    load(lib.stream_queue_buffer, "pw_stream_queue_buffer");
+    load(lib.stream_destroy, "pw_stream_destroy");
+    load(lib.stream_get_node_id, "pw_stream_get_node_id");
+    load(lib.stream_trigger_process, "pw_stream_trigger_process");
+    load(lib.stream_state_as_string, "pw_stream_state_as_string");
+    if (!ok) {
+      LOG(WARNING) << "EXO-CAPTURE libpipewire lacks a function we use";
+      return std::nullopt;
+    }
+    lib.init(nullptr, nullptr);
+    return lib;
+  }
+};
+
+// The cursor beside a frame (metadata mode), in the frame's pixels.
+struct CursorMeta {
+  bool visible = false;
+  gfx::Point position;
+  gfx::Point hotspot;
+  // Set when it changed since the last frame that carried it.
+  SkBitmap bitmap;
+};
+
+// The largest cursor image metadata carries.
+constexpr int kMaxCursorSize = 64;
+constexpr size_t kCursorMetaSize = sizeof(spa_meta_cursor) +
+                                   sizeof(spa_meta_bitmap) +
+                                   kMaxCursorSize * kMaxCursorSize * 4;
+
+// One PipeWire video source node. Its callbacks run on PipeWire's own
+// thread; Push() on the UI thread copies a frame in and starts a graph
+// cycle, whose process() fills the next buffer from it.
+class PipeWireStream {
+ public:
+  PipeWireStream(const PipeWire* pw,
+                 const gfx::Size& size,
+                 bool cursor_metadata,
+                 base::RepeatingCallback<void(uint32_t node_id)> on_ready,
+                 base::RepeatingClosure on_error)
+      : pw_(pw),
+        size_(size),
+        stride_(size.width() * 4),
+        cursor_metadata_(cursor_metadata),
+        runner_(base::SequencedTaskRunner::GetCurrentDefault()),
+        on_ready_(std::move(on_ready)),
+        on_error_(std::move(on_error)) {}
+
+  PipeWireStream(const PipeWireStream&) = delete;
+  PipeWireStream& operator=(const PipeWireStream&) = delete;
+
+  ~PipeWireStream() {
+    if (loop_) {
+      // Joins PipeWire's thread: no callback runs after this.
+      pw_->thread_loop_stop(loop_);
+    }
+    if (stream_) {
+      pw_->stream_destroy(stream_);
+    }
+    if (core_) {
+      pw_->core_disconnect(core_);
+    }
+    if (context_) {
+      pw_->context_destroy(context_);
+    }
+    if (loop_) {
+      pw_->thread_loop_destroy(loop_);
+    }
+  }
+
+  bool Connect(const std::string& name) {
+    loop_ = pw_->thread_loop_new("plutonium-screencast", nullptr);
+    if (!loop_) {
+      return false;
+    }
+    context_ = pw_->context_new(pw_->thread_loop_get_loop(loop_), nullptr, 0);
+    if (!context_ || pw_->thread_loop_start(loop_) < 0) {
+      return false;
+    }
+    pw_->thread_loop_lock(loop_);
+    core_ = pw_->context_connect(context_, nullptr, 0);
+    if (!core_) {
+      pw_->thread_loop_unlock(loop_);
+      LOG(WARNING) << "EXO-CAPTURE can't reach PipeWire";
+      return false;
+    }
+    stream_ = pw_->stream_new(
+        core_, name.c_str(),
+        pw_->properties_new(PW_KEY_MEDIA_CLASS, "Video/Source",
+                            PW_KEY_MEDIA_ROLE, "Screen", PW_KEY_NODE_NAME,
+                            "plutonium-screencast", PW_KEY_NODE_DESCRIPTION,
+                            name.c_str(), nullptr));
+    if (!stream_) {
+      pw_->thread_loop_unlock(loop_);
+      return false;
+    }
+    events_.version = PW_VERSION_STREAM_EVENTS;
+    events_.state_changed = &PipeWireStream::OnStateChanged;
+    events_.param_changed = &PipeWireStream::OnParamChanged;
+    events_.add_buffer = &PipeWireStream::OnAddBuffer;
+    events_.remove_buffer = &PipeWireStream::OnRemoveBuffer;
+    events_.process = &PipeWireStream::OnProcess;
+    pw_->stream_add_listener(stream_, &listener_, &events_, this);
+
+    uint8_t buffer[1024];
+    spa_pod_builder builder = {};
+    builder.data = buffer;
+    builder.size = sizeof(buffer);
+    const spa_pod* params[2] = {
+        BuildFormat(&builder, SPA_VIDEO_FORMAT_BGRx),
+        BuildFormat(&builder, SPA_VIDEO_FORMAT_BGRA),
+    };
+    const int result = pw_->stream_connect(
+        stream_, PW_DIRECTION_OUTPUT, PW_ID_ANY,
+        static_cast<pw_stream_flags>(PW_STREAM_FLAG_DRIVER |
+                                     PW_STREAM_FLAG_ALLOC_BUFFERS),
+        params, 2);
+    pw_->thread_loop_unlock(loop_);
+    return result >= 0;
+  }
+
+  // A frame: |size_| pixels from |pixels|, BGRA rows |stride| bytes apart.
+  void Push(const uint8_t* pixels,
+            size_t stride,
+            const gfx::Size& size,
+            const CursorMeta& cursor) {
+    {
+      base::AutoLock lock(lock_);
+      staging_.resize(stride_ * size_.height());
+      const int rows = std::min(size.height(), size_.height());
+      const size_t row_bytes =
+          std::min<size_t>(size.width(), size_.width()) * 4;
+      for (int y = 0; y < rows; ++y) {
+        memcpy(staging_.data() + y * stride_, pixels + y * stride, row_bytes);
+      }
+      has_frame_ = true;
+      cursor_.visible = cursor.visible;
+      cursor_.position = cursor.position;
+      cursor_.hotspot = cursor.hotspot;
+      if (!cursor.bitmap.drawsNothing()) {
+        cursor_.bitmap = cursor.bitmap;
+      }
+    }
+    pw_->thread_loop_lock(loop_);
+    if (streaming_) {
+      pw_->stream_trigger_process(stream_);
+    }
+    pw_->thread_loop_unlock(loop_);
+  }
+
+ private:
+  const spa_pod* BuildFormat(spa_pod_builder* builder, spa_video_format format) {
+    spa_rectangle size = {static_cast<uint32_t>(size_.width()),
+                          static_cast<uint32_t>(size_.height())};
+    spa_fraction rate = {0, 1};
+    spa_fraction max_rate = {60, 1};
+    spa_fraction min_rate = {1, 1};
+    return static_cast<const spa_pod*>(spa_pod_builder_add_object(
+        builder, SPA_TYPE_OBJECT_Format, SPA_PARAM_EnumFormat,
+        SPA_FORMAT_mediaType, SPA_POD_Id(SPA_MEDIA_TYPE_video),
+        SPA_FORMAT_mediaSubtype, SPA_POD_Id(SPA_MEDIA_SUBTYPE_raw),
+        SPA_FORMAT_VIDEO_format, SPA_POD_Id(format), SPA_FORMAT_VIDEO_size,
+        SPA_POD_Rectangle(&size), SPA_FORMAT_VIDEO_framerate,
+        SPA_POD_Fraction(&rate), SPA_FORMAT_VIDEO_maxFramerate,
+        SPA_POD_CHOICE_RANGE_Fraction(&max_rate, &min_rate, &max_rate)));
+  }
+
+  static void OnStateChanged(void* data,
+                             pw_stream_state old,
+                             pw_stream_state state,
+                             const char* error) {
+    auto* self = static_cast<PipeWireStream*>(data);
+    VLOG(1) << "EXO-CAPTURE PipeWire stream "
+            << self->pw_->stream_state_as_string(state)
+            << (error ? std::string(": ") + error : std::string());
+    self->streaming_ = state == PW_STREAM_STATE_STREAMING;
+    if (state == PW_STREAM_STATE_PAUSED && !self->ready_) {
+      self->ready_ = true;
+      self->runner_->PostTask(
+          FROM_HERE, base::BindOnce(self->on_ready_,
+                                    self->pw_->stream_get_node_id(
+                                        self->stream_)));
+    }
+    if (state == PW_STREAM_STATE_ERROR ||
+        (state == PW_STREAM_STATE_UNCONNECTED && self->ready_)) {
+      self->runner_->PostTask(FROM_HERE, self->on_error_);
+    }
+    // A consumer came: show it what there is now.
+    if (state == PW_STREAM_STATE_STREAMING) {
+      self->pw_->stream_trigger_process(self->stream_);
+    }
+  }
+
+  static void OnParamChanged(void* data, uint32_t id, const spa_pod* param) {
+    auto* self = static_cast<PipeWireStream*>(data);
+    if (!param || id != SPA_PARAM_Format) {
+      return;
+    }
+    spa_video_info_raw format = {};
+    if (spa_format_video_raw_parse(param, &format) < 0) {
+      return;
+    }
+    uint8_t buffer[1024];
+    spa_pod_builder builder = {};
+    builder.data = buffer;
+    builder.size = sizeof(buffer);
+    const int size = self->stride_ * self->size_.height();
+    const spa_pod* params[3];
+    uint32_t count = 0;
+    params[count++] = static_cast<const spa_pod*>(spa_pod_builder_add_object(
+        &builder, SPA_TYPE_OBJECT_ParamBuffers, SPA_PARAM_Buffers,
+        SPA_PARAM_BUFFERS_buffers, SPA_POD_CHOICE_RANGE_Int(4, 2, 16),
+        SPA_PARAM_BUFFERS_blocks, SPA_POD_Int(1), SPA_PARAM_BUFFERS_size,
+        SPA_POD_Int(size), SPA_PARAM_BUFFERS_stride, SPA_POD_Int(self->stride_),
+        SPA_PARAM_BUFFERS_dataType,
+        SPA_POD_CHOICE_FLAGS_Int((1 << SPA_DATA_MemFd) |
+                                 (1 << SPA_DATA_MemPtr))));
+    params[count++] = static_cast<const spa_pod*>(spa_pod_builder_add_object(
+        &builder, SPA_TYPE_OBJECT_ParamMeta, SPA_PARAM_Meta,
+        SPA_PARAM_META_type, SPA_POD_Id(SPA_META_Header), SPA_PARAM_META_size,
+        SPA_POD_Int(static_cast<int>(sizeof(spa_meta_header)))));
+    if (self->cursor_metadata_) {
+      params[count++] = static_cast<const spa_pod*>(spa_pod_builder_add_object(
+          &builder, SPA_TYPE_OBJECT_ParamMeta, SPA_PARAM_Meta,
+          SPA_PARAM_META_type, SPA_POD_Id(SPA_META_Cursor),
+          SPA_PARAM_META_size, SPA_POD_Int(static_cast<int>(kCursorMetaSize))));
+    }
+    self->pw_->stream_update_params(self->stream_, params, count);
+  }
+
+  static void OnAddBuffer(void* data, pw_buffer* buffer) {
+    auto* self = static_cast<PipeWireStream*>(data);
+    spa_data* plane = &buffer->buffer->datas[0];
+    const size_t size = self->stride_ * self->size_.height();
+    if (plane->type & (1 << SPA_DATA_MemFd)) {
+      const int fd = static_cast<int>(
+          syscall(__NR_memfd_create, "plutonium-screencast", MFD_CLOEXEC));
+      if (fd >= 0 && ftruncate(fd, size) == 0) {
+        void* memory =
+            mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        if (memory != MAP_FAILED) {
+          plane->type = SPA_DATA_MemFd;
+          plane->flags = SPA_DATA_FLAG_READWRITE;
+          plane->fd = fd;
+          plane->mapoffset = 0;
+          plane->maxsize = size;
+          plane->data = memory;
+          return;
+        }
+      }
+      if (fd >= 0) {
+        close(fd);
+      }
+    }
+    plane->type = SPA_DATA_MemPtr;
+    plane->flags = SPA_DATA_FLAG_READWRITE;
+    plane->fd = -1;
+    plane->maxsize = size;
+    plane->data = calloc(1, size);
+  }
+
+  static void OnRemoveBuffer(void* data, pw_buffer* buffer) {
+    spa_data* plane = &buffer->buffer->datas[0];
+    if (plane->type == SPA_DATA_MemFd) {
+      munmap(plane->data, plane->maxsize);
+      close(static_cast<int>(plane->fd));
+    } else if (plane->type == SPA_DATA_MemPtr) {
+      free(plane->data);
+    }
+    plane->data = nullptr;
+  }
+
+  static void OnProcess(void* data) {
+    auto* self = static_cast<PipeWireStream*>(data);
+    pw_buffer* buffer = self->pw_->stream_dequeue_buffer(self->stream_);
+    if (!buffer) {
+      return;
+    }
+    spa_buffer* spa = buffer->buffer;
+    spa_data* plane = &spa->datas[0];
+    const size_t size = self->stride_ * self->size_.height();
+    {
+      base::AutoLock lock(self->lock_);
+      if (plane->data && self->has_frame_ && plane->maxsize >= size) {
+        memcpy(plane->data, self->staging_.data(), size);
+      }
+      plane->chunk->offset = 0;
+      plane->chunk->size = self->has_frame_ ? size : 0;
+      plane->chunk->stride = self->stride_;
+      plane->chunk->flags = 0;
+      if (auto* header = static_cast<spa_meta_header*>(spa_buffer_find_meta_data(
+              spa, SPA_META_Header, sizeof(spa_meta_header)))) {
+        header->flags = 0;
+        header->offset = 0;
+        header->pts = (base::TimeTicks::Now() - base::TimeTicks()).InNanoseconds();
+        header->dts_offset = 0;
+        header->seq = self->sequence_++;
+      }
+      if (auto* cursor = static_cast<spa_meta_cursor*>(spa_buffer_find_meta_data(
+              spa, SPA_META_Cursor, sizeof(spa_meta_cursor)))) {
+        self->FillCursor(cursor);
+      }
+    }
+    self->pw_->stream_queue_buffer(self->stream_, buffer);
+  }
+
+  void FillCursor(spa_meta_cursor* meta) EXCLUSIVE_LOCKS_REQUIRED(lock_) {
+    if (!cursor_.visible) {
+      meta->id = 0;
+      return;
+    }
+    meta->id = 1;
+    meta->flags = 0;
+    meta->position.x = cursor_.position.x();
+    meta->position.y = cursor_.position.y();
+    meta->hotspot.x = cursor_.hotspot.x();
+    meta->hotspot.y = cursor_.hotspot.y();
+    meta->bitmap_offset = 0;
+    const SkBitmap& image = cursor_.bitmap;
+    if (image.drawsNothing() || image.width() > kMaxCursorSize ||
+        image.height() > kMaxCursorSize) {
+      return;
+    }
+    meta->bitmap_offset = sizeof(spa_meta_cursor);
+    auto* bitmap = SPA_PTROFF(meta, meta->bitmap_offset, spa_meta_bitmap);
+    bitmap->format = SPA_VIDEO_FORMAT_BGRA;
+    bitmap->size.width = image.width();
+    bitmap->size.height = image.height();
+    bitmap->stride = image.width() * 4;
+    bitmap->offset = sizeof(spa_meta_bitmap);
+    auto* pixels = SPA_PTROFF(bitmap, bitmap->offset, uint8_t);
+    for (int y = 0; y < image.height(); ++y) {
+      memcpy(pixels + y * bitmap->stride, image.getAddr32(0, y),
+             bitmap->stride);
+    }
+    // Sent once; later frames have the position only.
+    cursor_.bitmap.reset();
+  }
+
+  const raw_ptr<const PipeWire> pw_;
+  const gfx::Size size_;
+  const int stride_;
+  const bool cursor_metadata_;
+  scoped_refptr<base::SequencedTaskRunner> runner_;
+  base::RepeatingCallback<void(uint32_t)> on_ready_;
+  base::RepeatingClosure on_error_;
+
+  raw_ptr<pw_thread_loop> loop_ = nullptr;
+  raw_ptr<pw_context> context_ = nullptr;
+  raw_ptr<pw_core> core_ = nullptr;
+  raw_ptr<pw_stream> stream_ = nullptr;
+  spa_hook listener_ = {};
+  pw_stream_events events_ = {};
+  // PipeWire's thread's.
+  bool ready_ = false;
+  bool streaming_ = false;
+  uint32_t sequence_ = 0;
+
+  base::Lock lock_;
+  std::vector<uint8_t> staging_ GUARDED_BY(lock_);
+  bool has_frame_ GUARDED_BY(lock_) = false;
+  CursorMeta cursor_ GUARDED_BY(lock_);
+};
+
+class ScreencastImpl : public PlutoniumScreencast,
+                       public viz::mojom::FrameSinkVideoConsumer,
+                       public aura::WindowObserver,
+                       public ui::EventObserver,
+                       public content::WebContentsObserver {
+ public:
+  ScreencastImpl(const Target& target,
+                 const gfx::Size& size,
+                 const std::string& cursor,
+                 base::OnceCallback<void(uint32_t, const gfx::Size&)> ready,
+                 base::OnceClosure ended)
+      : window_(target.window),
+        size_(size),
+        cursor_(cursor),
+        ready_(std::move(ready)),
+        ended_(std::move(ended)) {}
+
+  ~ScreencastImpl() override {
+    if (capturer_) {
+      capturer_->StopAndResetConsumer();
+    }
+    if (observing_events_) {
+      aura::Env::GetInstance()->RemoveEventObserver(this);
+    }
+    if (window_) {
+      window_->RemoveObserver(this);
+    }
+  }
+
+  bool Init(const Target& target, const std::string& name) {
+    const PipeWire* pw = PipeWire::Get();
+    if (!pw || size_.IsEmpty()) {
+      return false;
+    }
+    if (target.contents) {
+      content::RenderWidgetHostView* view =
+          target.contents->GetRenderWidgetHostView();
+      if (!view) {
+        return false;
+      }
+      Observe(target.contents);
+      capture_handle_ = target.contents->IncrementCapturerCount(
+          size_, /*stay_hidden=*/true, /*stay_awake=*/true,
+          /*is_activity=*/true);
+      capturer_ = view->CreateVideoCapturer();
+      // A tab's cursor isn't Ash's.
+      cursor_ = "hidden";
+    } else {
+      aura::Window* root = window_ ? window_->GetRootWindow() : nullptr;
+      if (!root || !root->GetFrameSinkId().is_valid()) {
+        return false;
+      }
+      window_->AddObserver(this);
+      viz::VideoCaptureTarget capture_target(root->GetFrameSinkId());
+      if (!window_->IsRootWindow()) {
+        // Drawn into a render pass of its own, also while it's parked
+        // (hidden, or at zero opacity).
+        capture_request_ = window_->MakeWindowCapturable();
+        capture_target =
+            viz::VideoCaptureTarget(root->GetFrameSinkId(),
+                                    capture_request_.GetCaptureId());
+        force_visible_.emplace(window_);
+      }
+      video_capture_lock_ = root->GetHost()->CreateVideoCaptureLock();
+      capturer_ = aura::Env::GetInstance()
+                      ->context_factory()
+                      ->GetHostFrameSinkManager()
+                      ->CreateVideoCapturer();
+      capturer_->ChangeTarget(capture_target);
+    }
+    stream_ = std::make_unique<PipeWireStream>(
+        pw, size_, cursor_ == "metadata",
+        base::BindRepeating(&ScreencastImpl::OnReady,
+                            weak_factory_.GetWeakPtr()),
+        base::BindRepeating(&ScreencastImpl::End,
+                            weak_factory_.GetWeakPtr()));
+    if (!stream_->Connect(name)) {
+      stream_.reset();
+      return false;
+    }
+    capturer_->SetFormat(media::PIXEL_FORMAT_ARGB);
+    capturer_->SetMinCapturePeriod(base::Seconds(1) / 60);
+    capturer_->SetResolutionConstraints(size_, size_,
+                                        /*use_fixed_aspect_ratio=*/true);
+    capturer_->SetAutoThrottlingEnabled(false);
+    if (cursor_ == "embedded") {
+      overlay_ = capturer_->CreateOverlay(/*stacking_index=*/0);
+    }
+    if (cursor_ != "hidden") {
+      aura::Env::GetInstance()->AddEventObserver(
+          this, aura::Env::GetInstance(),
+          {ui::EventType::kMouseMoved, ui::EventType::kMouseDragged,
+           ui::EventType::kMousePressed, ui::EventType::kMouseReleased,
+           ui::EventType::kMouseEntered, ui::EventType::kMouseExited});
+      observing_events_ = true;
+      UpdateCursor();
+    }
+    capturer_->Start(this, viz::mojom::BufferFormatPreference::kDefault);
+    return true;
+  }
+
+  // viz::mojom::FrameSinkVideoConsumer:
+  void OnFrameCaptured(
+      media::mojom::VideoBufferHandlePtr data,
+      media::mojom::VideoFrameInfoPtr info,
+      const gfx::Rect& content_rect,
+      mojo::PendingRemote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>
+          callbacks) override {
+    mojo::Remote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks> done(
+        std::move(callbacks));
+    if (!stream_ || !data->is_read_only_shmem_region()) {
+      return;
+    }
+    base::ReadOnlySharedMemoryMapping mapping =
+        data->get_read_only_shmem_region().Map();
+    if (!mapping.IsValid() ||
+        mapping.size() < media::VideoFrame::AllocationSize(
+                             info->pixel_format, info->coded_size)) {
+      return;
+    }
+    const size_t row_bytes = media::VideoFrame::RowBytes(
+        media::VideoFrame::Plane::kARGB, info->pixel_format,
+        info->coded_size.width());
+    const gfx::Rect& visible = info->visible_rect;
+    const uint8_t* pixels =
+        mapping.data() + visible.y() * row_bytes + visible.x() * 4;
+    CursorMeta cursor;
+    if (cursor_ == "metadata" && cursor_bounds_) {
+      cursor.visible = true;
+      // Relative to the content, which the frame letterboxes.
+      cursor.position = gfx::Point(
+          content_rect.x() +
+              base::ClampRound(cursor_location_.x() * content_rect.width()),
+          content_rect.y() +
+              base::ClampRound(cursor_location_.y() * content_rect.height()));
+      cursor.hotspot = cursor_hotspot_;
+      if (cursor_changed_) {
+        cursor.bitmap = cursor_bitmap_;
+        cursor_changed_ = false;
+      }
+    }
+    stream_->Push(pixels, row_bytes, visible.size(), cursor);
+  }
+  void OnNewCaptureVersion(const media::CaptureVersion&) override {}
+  void OnFrameWithEmptyRegionCapture() override {}
+  void OnStopped() override { End(); }
+  void OnLog(const std::string&) override {}
+
+  // Couldn't start: |ready| gets 0.
+  void Fail() { End(); }
+
+  // aura::WindowObserver:
+  void OnWindowDestroying(aura::Window* window) override {
+    window_->RemoveObserver(this);
+    window_ = nullptr;
+    force_visible_.reset();
+    End();
+  }
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override { UpdateCursor(); }
+
+  // content::WebContentsObserver:
+  void WebContentsDestroyed() override { End(); }
+
+ private:
+  void OnReady(uint32_t node_id) {
+    VLOG(1) << "EXO-CAPTURE PipeWire node " << node_id << " at "
+            << size_.ToString();
+    if (ready_) {
+      std::move(ready_).Run(node_id, size_);
+    }
+  }
+
+  void End() {
+    if (ready_) {
+      std::move(ready_).Run(0, gfx::Size());
+      return;
+    }
+    if (ended_) {
+      std::move(ended_).Run();
+    }
+  }
+
+  // Where the pointer is (0..1 of the captured area) and what it looks
+  // like, for the overlay or the metadata.
+  void UpdateCursor() {
+    if (!window_) {
+      return;
+    }
+    aura::Window* root = window_->GetRootWindow();
+    if (!root || !root->GetHost()) {
+      return;
+    }
+    const gfx::Rect area = window_->GetBoundsInScreen();
+    const gfx::Point location =
+        aura::Env::GetInstance()->last_mouse_location();
+    gfx::NativeCursor native = root->GetHost()->last_cursor();
+    if (native == ui::mojom::CursorType::kNull) {
+      native = ui::mojom::CursorType::kPointer;
+    }
+    std::optional<ui::CursorData> data =
+        aura::client::GetCursorShapeClient().GetCursorData(native);
+    if (area.IsEmpty() || !area.Contains(location) || !data ||
+        data->bitmaps.empty() || native == ui::mojom::CursorType::kNone) {
+      cursor_bounds_ = false;
+      if (overlay_) {
+        overlay_->SetBounds(gfx::RectF());
+      }
+      return;
+    }
+    const SkBitmap& bitmap = data->bitmaps[0];
+    const float scale = data->scale_factor;
+    cursor_location_ =
+        gfx::PointF(static_cast<float>(location.x() - area.x()) / area.width(),
+                    static_cast<float>(location.y() - area.y()) / area.height());
+    cursor_bounds_ = true;
+    if (overlay_) {
+      const gfx::SizeF size(bitmap.width() / scale, bitmap.height() / scale);
+      const gfx::PointF hotspot(data->hotspot.x() / scale,
+                                data->hotspot.y() / scale);
+      const gfx::RectF bounds(
+          (location.x() - area.x() - hotspot.x()) / area.width(),
+          (location.y() - area.y() - hotspot.y()) / area.height(),
+          size.width() / area.width(), size.height() / area.height());
+      if (bitmap.getGenerationID() != cursor_generation_) {
+        cursor_generation_ = bitmap.getGenerationID();
+        overlay_->SetImageAndBounds(bitmap, bounds);
+      } else {
+        overlay_->SetBounds(bounds);
+      }
+      return;
+    }
+    // Metadata: at the frame's scale.
+    if (bitmap.getGenerationID() != cursor_generation_) {
+      cursor_generation_ = bitmap.getGenerationID();
+      cursor_bitmap_ = bitmap;
+      cursor_changed_ = true;
+    }
+    cursor_hotspot_ = data->hotspot;
+    // A move without a new frame: ask for one, to carry the position.
+    capturer_->RequestRefreshFrame();
+  }
+
+  raw_ptr<aura::Window> window_;
+  const gfx::Size size_;
+  std::string cursor_;
+  base::OnceCallback<void(uint32_t, const gfx::Size&)> ready_;
+  base::OnceClosure ended_;
+
+  std::unique_ptr<PipeWireStream> stream_;
+  std::unique_ptr<viz::ClientFrameSinkVideoCapturer> capturer_;
+  std::unique_ptr<viz::ClientFrameSinkVideoCapturer::Overlay> overlay_;
+  aura::ScopedWindowCaptureRequest capture_request_;
+  std::optional<aura::WindowOcclusionTracker::ScopedForceVisible>
+      force_visible_;
+  std::unique_ptr<aura::WindowTreeHost::VideoCaptureLock> video_capture_lock_;
+  base::ScopedClosureRunner capture_handle_;
+  bool observing_events_ = false;
+
+  bool cursor_bounds_ = false;
+  gfx::PointF cursor_location_;
+  gfx::Point cursor_hotspot_;
+  SkBitmap cursor_bitmap_;
+  bool cursor_changed_ = false;
+  uint32_t cursor_generation_ = 0;
+  base::WeakPtrFactory<ScreencastImpl> weak_factory_{this};
+};
+
+}  // namespace
+
+// static
+std::unique_ptr<PlutoniumScreencast> PlutoniumScreencast::Start(
+    const Target& target,
+    const gfx::Size& size,
+    const std::string& cursor,
+    const std::string& name,
+    base::OnceCallback<void(uint32_t node_id, const gfx::Size& size)> ready,
+    base::OnceClosure ended) {
+  auto screencast = std::make_unique<ScreencastImpl>(
+      target, size, cursor, std::move(ready), std::move(ended));
+  if (!screencast->Init(target, name)) {
+    screencast->Fail();
+    return nullptr;
+  }
+  return screencast;
+}
+
+// static
+bool PlutoniumScreencast::IsAvailable() {
+  return !!PipeWire::Get();
+}
