+#ifndef CHROME_BROWSER_PLUTONIUM_PIPEWIRE_H_
+#define CHROME_BROWSER_PLUTONIUM_PIPEWIRE_H_
+
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace aura {
+class Window;
+}
+
+namespace content {
+class WebContents;
+}
+
+// EXO-CAPTURE (docs/features/CAPTURE.md, "Where PipeWire lives"): a capture
+// published as a PipeWire video source, for apps that capture through the
+// desktop portal (OBS, Firefox, Discord). WebRTC's PipeWire code is
+// consumer-only (and off for target_os = "chromeos"), so this is our own
+// producer: a viz frame sink video capturer on the source, each frame copied
+// into a shared-memory buffer (MemFd, or MemPtr), BGRx or BGRA, at a fixed
+// size (the source's at the start, letterboxed after). libpipewire is loaded
+// at run time; without it, or without a PipeWire daemon, Start() fails.
+//
+// Cursor modes, as the portal's: "hidden"; "embedded" (drawn into the
+// frames); "metadata" (SPA_META_Cursor: its position and, when it changes,
+// its image, beside the frames).
+class PlutoniumScreencast {
+ public:
+  // What it captures: a root window (an output), a window (its subtree of
+  // the root's frame), or a tab's page.
+  struct Target {
+    raw_ptr<aura::Window> window = nullptr;
+    raw_ptr<content::WebContents> contents = nullptr;
+  };
+
+  // |ready| gets the node's id once PipeWire has it, with the frame size,
+  // or 0 if it failed (also when this returns null: it can't start). |ended|
+  // runs if the stream ends on its own (the source went away, PipeWire went
+  // away). Neither runs after the screencast is destroyed. Either may run
+  // from inside its calls: post them.
+  static std::unique_ptr<PlutoniumScreencast> Start(
+      const Target& target,
+      const gfx::Size& size,
+      const std::string& cursor,
+      const std::string& name,
+      base::OnceCallback<void(uint32_t node_id, const gfx::Size& size)> ready,
+      base::OnceClosure ended);
+
+  // Whether libpipewire could be loaded.
+  static bool IsAvailable();
+
+  virtual ~PlutoniumScreencast() = default;
+};
+
+#endif  // CHROME_BROWSER_PLUTONIUM_PIPEWIRE_H_
