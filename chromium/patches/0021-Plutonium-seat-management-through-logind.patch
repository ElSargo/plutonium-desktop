+#include "dbus/bus.h"
+#include "dbus/message.h"
+#include "dbus/object_proxy.h"
+
+namespace ui {
+
+const char kLogindSessionSwitch[] = "plutonium-logind-session";
+
+namespace {
+
+constexpr char kLogindService[] = "org.freedesktop.login1";
+constexpr char kManagerPath[] = "/org/freedesktop/login1";
+constexpr char kManagerInterface[] = "org.freedesktop.login1.Manager";
+constexpr char kSessionInterface[] = "org.freedesktop.login1.Session";
+constexpr char kSeatInterface[] = "org.freedesktop.login1.Seat";
+constexpr char kPropertiesInterface[] = "org.freedesktop.DBus.Properties";
+
+constexpr unsigned int kDrmMajor = 226;
+
+LogindSession* g_instance = nullptr;
+
+bool IsDrm(dev_t device) {
+  return major(device) == kDrmMajor;
+}
+
+std::string DeviceName(dev_t device) {
+  return std::to_string(major(device)) + ":" + std::to_string(minor(device));
+}
+
+std::string ErrorText(const dbus::Error& error) {
+  return error.name() + ": " + error.message();
+}
+
+void LogIfError(const std::string& what,
+                dbus::Response* response,
+                dbus::ErrorResponse* error) {
+  if (error) {
+    std::string message;
+    dbus::MessageReader(error).PopString(&message);
+    LOG(ERROR) << "logind " << what << ": " << error->GetErrorName() << ": "
+               << message;
+  }
+}
+
+// org.freedesktop.DBus.Properties.Get on |proxy|, returning a reader of the
+// value inside the variant (which must outlive the reader, so it is kept in
+// |response|).
+bool GetProperty(dbus::ObjectProxy* proxy,
+                 const std::string& interface,
+                 const std::string& name,
+                 std::unique_ptr<dbus::Response>* response,
+                 dbus::MessageReader* value) {
+  dbus::MethodCall call(kPropertiesInterface, "Get");
+  dbus::MessageWriter writer(&call);
+  writer.AppendString(interface);
+  writer.AppendString(name);
+  auto result =
+      proxy->CallMethodAndBlock(&call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT);
+  if (!result.has_value()) {
+    LOG(ERROR) << "logind: can't read " << name << ": "
+               << ErrorText(result.error());
+    return false;
+  }
+  *response = std::move(result.value());
+  dbus::MessageReader reader(response->get());
+  return reader.PopVariant(value);
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<LogindSession> LogindSession::CreateFromCommandLine() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kLogindSessionSwitch)) {
+    return nullptr;
+  }
+  std::string session_id =
+      command_line->GetSwitchValueASCII(kLogindSessionSwitch);
+  if (session_id.empty()) {
+    session_id = base::Environment::Create()
+                     ->GetVar("XDG_SESSION_ID")
+                     .value_or("auto");
+  }
+  auto session = base::WrapUnique(new LogindSession());
+  if (!session->Start(session_id)) {
+    LOG(FATAL) << "Could not take control of logind session " << session_id
+               << " (--" << kLogindSessionSwitch << ")";
+  }
+  return session;
+}
+
+// static
+LogindSession* LogindSession::Get() {
+  return g_instance;
+}
+
+LogindSession::LogindSession()
+    : thread_("logind"),
+      observers_(base::MakeRefCounted<base::ObserverListThreadSafe<Observer>>()) {
+}
+
+LogindSession::~LogindSession() {
+  if (g_instance == this) {
+    g_instance = nullptr;
+  }
+  if (thread_.IsRunning()) {
+    thread_.task_runner()->PostTask(
+        FROM_HERE, base::BindOnce(&LogindSession::ShutdownOnThread,
+                                  base::Unretained(this)));
+    thread_.Stop();
+  }
+}
+
+bool LogindSession::Start(const std::string& session_id) {
+  if (!thread_.StartWithOptions(
+          base::Thread::Options(base::MessagePumpType::IO, 0))) {
+    return false;
+  }
+  bool result = false;
+  base::WaitableEvent done;
+  thread_.task_runner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&LogindSession::StartOnThread, base::Unretained(this),
+                     session_id, &result, &done));
+  done.Wait();
+  if (result) {
+    g_instance = this;
+  }
+  return result;
+}
+
+void LogindSession::StartOnThread(const std::string& session_id,
+                                  bool* result,
+                                  base::WaitableEvent* done) {
+  *result = TakeControl(session_id);
+  done->Signal();
+}
+
+bool LogindSession::TakeControl(const std::string& session_id) {
+  dbus::Bus::Options options;
+  options.bus_type = dbus::Bus::SYSTEM;
+  options.connection_type = dbus::Bus::PRIVATE;
+  options.dbus_task_runner = thread_.task_runner();
+  bus_ = base::MakeRefCounted<dbus::Bus>(std::move(options));
+
+  dbus::ObjectProxy* manager = bus_->GetObjectProxy(
+      kLogindService, dbus::ObjectPath(kManagerPath));
+  {
+    dbus::MethodCall call(kManagerInterface, "GetSession");
+    dbus::MessageWriter(&call).AppendString(session_id);
+    auto response = manager->CallMethodAndBlock(
+        &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT);
+    if (!response.has_value()) {
+      LOG(ERROR) << "logind: no session " << session_id << ": "
+                 << ErrorText(response.error());
+      return false;
+    }
+    if (!dbus::MessageReader(response->get()).PopObjectPath(&session_path_)) {
+      return false;
+    }
+  }
+  session_proxy_ = bus_->GetObjectProxy(kLogindService, session_path_);
+
+  // Signals first, so that none sent once Chrome is the controller is lost.
+  if (!session_proxy_->ConnectToSignalAndBlock(
+          kSessionInterface, "PauseDevice",
+          base::BindRepeating(&LogindSession::OnPauseDevice,
+                              base::Unretained(this))) ||
+      !session_proxy_->ConnectToSignalAndBlock(
+          kSessionInterface, "ResumeDevice",
+          base::BindRepeating(&LogindSession::OnResumeDevice,
+                              base::Unretained(this)))) {
+    LOG(ERROR) << "logind: can't listen to session " << session_id;
+    return false;
+  }
+
+  {
+    dbus::MethodCall call(kSessionInterface, "TakeControl");
+    dbus::MessageWriter(&call).AppendBool(false);
+    auto response = session_proxy_->CallMethodAndBlock(
+        &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT);
+    if (!response.has_value()) {
+      LOG(ERROR) << "logind: can't take control of session " << session_id
+                 << ": " << ErrorText(response.error());
+      return false;
+    }
+  }
+
+  std::unique_ptr<dbus::Response> response;
+  dbus::MessageReader value(nullptr);
+  bool active = false;
+  if (!GetProperty(session_proxy_, kSessionInterface, "Active", &response,
+                   &value) ||
+      !value.PopBool(&active)) {
+    return false;
+  }
+  active_ = active;
+
+  dbus::MessageReader seat(nullptr);
+  std::string seat_id;
+  dbus::ObjectPath seat_path;
+  if (GetProperty(session_proxy_, kSessionInterface, "Seat", &response,
+                  &value) &&
+      value.PopStruct(&seat) && seat.PopString(&seat_id) &&
+      seat.PopObjectPath(&seat_path) && seat_path.IsValid()) {
+    seat_proxy_ = bus_->GetObjectProxy(kLogindService, seat_path);
+  } else {
+    LOG(WARNING) << "logind: session " << session_id
+                 << " has no seat; can't switch VTs";
+  }
+
+  LOG(INFO) << "logind: controlling session " << session_id << " ("
+               << session_path_.value() << ") on seat " << seat_id << ", "
+               << (active ? "active" : "inactive");
+  return true;
+}
+
+base::ScopedFD LogindSession::OpenDevice(const base::FilePath& path) {
+  struct stat st;
+  if (stat(path.value().c_str(), &st) != 0) {
+    PLOG(ERROR) << "logind: can't open " << path.value();
+    return base::ScopedFD();
+  }
+  if (!S_ISCHR(st.st_mode)) {
+    LOG(ERROR) << "logind: not a device: " << path.value();
+    return base::ScopedFD();
+  }
+  base::ScopedFD fd;
+  base::WaitableEvent done;
+  thread_.task_runner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&LogindSession::OpenDeviceOnThread,
+                     base::Unretained(this), st.st_rdev, &fd, &done));
+  done.Wait();
+  if (!fd.is_valid()) {
+    LOG(ERROR) << "logind: can't open " << path.value();
+  }
+  return fd;
+}
+
+void LogindSession::OpenDeviceOnThread(dev_t device,
+                                       base::ScopedFD* result,
+                                       base::WaitableEvent* done) {
+  auto it = devices_.find(device);
+  if (it != devices_.end() && !IsDrm(device)) {
+    // An input device that was unplugged since: logind dropped it.
+    int version;
+    if (ioctl(it->second.get(), EVIOCGVERSION, &version) < 0) {
+      ReleaseDevice(device);
+      it = devices_.end();
+    }
+  }
+  if (it == devices_.end()) {
+    bool inactive = false;
+    base::ScopedFD fd = TakeDevice(device, &inactive);
+    if (fd.is_valid() && inactive && !IsDrm(device)) {
+      // Taken revoked: useless until the session is back, when it's opened
+      // again.
+      VLOG(1) << "logind: session inactive, not opening " << DeviceName(device);
+      ReleaseDevice(device);
+      fd.reset();
+    }
+    if (fd.is_valid()) {
+      if (IsDrm(device) && inactive) {
+        paused_drm_devices_.insert(device);
+      }
+      it = devices_.emplace(device, std::move(fd)).first;
+    }
+  }
+  if (it != devices_.end()) {
+    result->reset(HANDLE_EINTR(fcntl(it->second.get(), F_DUPFD_CLOEXEC, 0)));
+  }
+  done->Signal();
+}
+
+base::ScopedFD LogindSession::TakeDevice(dev_t device, bool* inactive) {
+  dbus::MethodCall call(kSessionInterface, "TakeDevice");
+  dbus::MessageWriter writer(&call);
+  writer.AppendUint32(major(device));
+  writer.AppendUint32(minor(device));
+  auto response = session_proxy_->CallMethodAndBlock(
+      &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT);
+  if (!response.has_value()) {
+    LOG(ERROR) << "logind: TakeDevice " << DeviceName(device) << ": "
+               << ErrorText(response.error());
+    return base::ScopedFD();
+  }
+  base::ScopedFD fd;
+  dbus::MessageReader reader(response->get());
+  if (!reader.PopFileDescriptor(&fd) || !reader.PopBool(inactive)) {
+    LOG(ERROR) << "logind: bad TakeDevice reply for " << DeviceName(device);
+    return base::ScopedFD();
+  }
+  return fd;
+}
+
+void LogindSession::ReleaseDevice(dev_t device) {
+  devices_.erase(device);
+  paused_drm_devices_.erase(device);
+  dbus::MethodCall call(kSessionInterface, "ReleaseDevice");
+  dbus::MessageWriter writer(&call);
+  writer.AppendUint32(major(device));
+  writer.AppendUint32(minor(device));
+  session_proxy_->CallMethodWithErrorResponse(
+      &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&LogIfError, "ReleaseDevice " + DeviceName(device)));
+}
+
+void LogindSession::SwitchTo(uint32_t vt) {
+  thread_.task_runner()->PostTask(
+      FROM_HERE, base::BindOnce(&LogindSession::SwitchToOnThread,
+                                base::Unretained(this), vt));
+}
+
+void LogindSession::SwitchToOnThread(uint32_t vt) {
+  if (!seat_proxy_) {
+    return;
+  }
+  VLOG(1) << "logind: switching to VT " << vt;
+  dbus::MethodCall call(kSeatInterface, "SwitchTo");
+  dbus::MessageWriter(&call).AppendUint32(vt);
+  seat_proxy_->CallMethodWithErrorResponse(
+      &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+      base::BindOnce(&LogIfError, "SwitchTo " + std::to_string(vt)));
+}
+
+void LogindSession::AddObserver(Observer* observer) {
+  observers_->AddObserver(observer);
+}
+
+void LogindSession::RemoveObserver(Observer* observer) {
+  observers_->RemoveObserver(observer);
+}
+
+void LogindSession::OnPauseDevice(dbus::Signal* signal) {
+  dbus::MessageReader reader(signal);
+  uint32_t major_number, minor_number;
+  std::string type;
+  if (!reader.PopUint32(&major_number) || !reader.PopUint32(&minor_number) ||
+      !reader.PopString(&type)) {
+    LOG(ERROR) << "logind: bad PauseDevice signal";
+    return;
+  }
+  const dev_t device = makedev(major_number, minor_number);
+  VLOG(1) << "logind: PauseDevice " << DeviceName(device) << " " << type;
+
+  if (type == "gone") {
+    // Unplugged; logind has forgotten it already.
+    devices_.erase(device);
+    paused_drm_devices_.erase(device);
+    return;
+  }
+
+  if (IsDrm(device)) {
+    // logind dropped DRM master already. "pause" waits for an answer (or a
+    // timeout); there's nothing to finish first.
+    paused_drm_devices_.insert(device);
+    if (type == "pause") {
+      dbus::MethodCall call(kSessionInterface, "PauseDeviceComplete");
+      dbus::MessageWriter writer(&call);
+      writer.AppendUint32(major_number);
+      writer.AppendUint32(minor_number);
+      session_proxy_->CallMethodWithErrorResponse(
+          &call, dbus::ObjectProxy::TIMEOUT_USE_DEFAULT,
+          base::BindOnce(&LogIfError,
+                         "PauseDeviceComplete " + DeviceName(device)));
+    }
+  } else {
+    // Revoked for good: give it back, and take it again on the way back.
+    ReleaseDevice(device);
+  }
+
+  if (active_.exchange(false)) {
+    LOG(INFO) << "logind: session paused";
+    observers_->Notify(FROM_HERE, &Observer::OnSessionPaused);
+  }
+}
+
+void LogindSession::OnResumeDevice(dbus::Signal* signal) {
+  dbus::MessageReader reader(signal);
+  uint32_t major_number, minor_number;
+  base::ScopedFD fd;
+  if (!reader.PopUint32(&major_number) || !reader.PopUint32(&minor_number) ||
+      !reader.PopFileDescriptor(&fd)) {
+    LOG(ERROR) << "logind: bad ResumeDevice signal";
+    return;
+  }
+  const dev_t device = makedev(major_number, minor_number);
+  VLOG(1) << "logind: ResumeDevice " << DeviceName(device);
+
+  // For DRM it's the same open file as before, with master again. An input
+  // device is a new one.
+  devices_[device] = std::move(fd);
+  if (!IsDrm(device)) {
+    return;
+  }
+  paused_drm_devices_.erase(device);
+  if (paused_drm_devices_.empty() && !active_.exchange(true)) {
+    LOG(INFO) << "logind: session resumed";
+    observers_->Notify(FROM_HERE, &Observer::OnSessionResumed);
+  }
+}
+
+void LogindSession::ShutdownOnThread() {
+  devices_.clear();
+  if (bus_) {
+    bus_->ShutdownAndBlock();
+  }
+}
