+
+void DisplayConfigurator::ApplyPlatformDisplayControl() {
+  if (display_control_changing_ || !pending_platform_display_control_) {
+    return;
+  }
+  const bool control = *pending_platform_display_control_;
+  pending_platform_display_control_.reset();
+  if (control) {
+    // TakeControl() forces the next configuration, which may find other
+    // displays than before.
+    TakeControl(base::BindOnce(
+        [](base::WeakPtr<DisplayConfigurator> configurator, bool success) {
+          if (configurator && success) {
+            configurator->ConfigureDisplays();
+          }
+        },
+        weak_ptr_factory_.GetWeakPtr()));
+    return;
+  }
+  if (display_externally_controlled_) {
+    return;
+  }
+  // Like RelinquishControl(), but the displays can't be turned off first:
+  // DRM master is gone already.
+  display_externally_controlled_ = true;
+  display_control_changing_ = true;
+  native_display_delegate_->RelinquishDisplayControl(
+      base::BindOnce(&DisplayConfigurator::OnDisplayControlRelinquished,
+                     weak_ptr_factory_.GetWeakPtr(), base::DoNothing()));
+}
