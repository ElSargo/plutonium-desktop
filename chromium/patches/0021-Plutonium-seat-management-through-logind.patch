+void EventFactoryEvdev::OnSessionPaused() {
+  // The devices are revoked: close them, which releases what was held down.
+  session_keys_down_.clear();
+  if (input_device_factory_proxy_) {
+    input_device_factory_proxy_->RemoveAllInputDevices();
+  }
+}
