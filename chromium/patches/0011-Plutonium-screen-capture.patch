+base::DictValue PlutoniumCapture::GetSources() const {
+  base::ListValue outputs;
+  const std::vector<display::Display> displays = OrderedDisplays();
+  const int64_t primary = display::Screen::Get()->GetPrimaryDisplay().id();
+  for (size_t i = 0; i < displays.size(); ++i) {
+    const display::Display& display = displays[i];
+    outputs.Append(
+        base::DictValue()
+            .Set("id", base::NumberToString(display.id()))
+            .Set("name", DisplayName(display, i))
+            .Set("width", display.GetSizeInPixel().width())
+            .Set("height", display.GetSizeInPixel().height())
+            .Set("scaleFactor", display.device_scale_factor())
+            .Set("primary", display.id() == primary));
+  }
+  base::ListValue windows;
+  if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+    for (const ExoWindowBroker::WindowInfo& window : broker->GetWindows()) {
+      base::ListValue tags;
+      for (const std::string& tag : window.tags) {
+        tags.Append(tag);
+      }
+      windows.Append(base::DictValue()
+                         .Set("id", window.id)
+                         .Set("title", base::UTF16ToUTF8(window.title))
+                         .Set("appId", window.app_id)
+                         .Set("width", window.size.width())
+                         .Set("height", window.size.height())
+                         .Set("tags", std::move(tags)));
+    }
+  }
+  base::ListValue tabs;
+  for (const PlutoniumTabs::TabInfo& tab : PlutoniumTabs::Get()->GetTabs()) {
+    base::ListValue tags;
+    for (const std::string& tag : tab.tags) {
+      tags.Append(tag);
+    }
+    tabs.Append(base::DictValue()
+                    .Set("id", tab.id)
+                    .Set("title", base::UTF16ToUTF8(tab.title))
+                    .Set("url", tab.url.spec())
+                    .Set("tags", std::move(tags)));
+  }
+  return base::DictValue()
+      .Set("outputs", std::move(outputs))
+      .Set("windows", std::move(windows))
+      .Set("tabs", std::move(tabs));
+}
+
+std::string PlutoniumCapture::LabelOf(const Source& source) const {
+  switch (source.type) {
+    case Source::Type::kOutput: {
+      const std::vector<display::Display> displays = OrderedDisplays();
+      for (size_t i = 0; i < displays.size(); ++i) {
+        if (displays[i].id() == source.id) {
+          return DisplayName(displays[i], i);
+        }
+      }
+      return "Display";
+    }
+    case Source::Type::kWindow: {
+      ExoWindowBroker* broker = ExoWindowBroker::Get();
+      std::optional<ExoWindowBroker::WindowInfo> window =
+          broker ? broker->GetWindow(static_cast<int32_t>(source.id))
+                 : std::nullopt;
+      if (!window) {
+        return "Window";
+      }
+      return window->title.empty() ? window->app_id
+                                   : base::UTF16ToUTF8(window->title);
+    }
+    case Source::Type::kTab: {
+      std::optional<PlutoniumTabs::TabInfo> tab =
+          PlutoniumTabs::Get()->GetTab(static_cast<int32_t>(source.id));
+      if (!tab) {
+        return "Tab";
+      }
+      return tab->title.empty() ? tab->url.spec()
+                                : base::UTF16ToUTF8(tab->title);
+    }
+  }
+  NOTREACHED();
+}
+
+content::DesktopMediaID PlutoniumCapture::ToMediaId(
+    const Source& source) const {
+  switch (source.type) {
+    case Source::Type::kOutput: {
+      aura::Window* root = ash::Shell::HasInstance()
+                               ? ash::Shell::GetRootWindowForDisplayId(
+                                     source.id)
+                               : nullptr;
+      if (!root) {
+        return content::DesktopMediaID();
+      }
+      return content::DesktopMediaID::RegisterNativeWindow(
+          content::DesktopMediaID::TYPE_SCREEN, root);
+    }
+    case Source::Type::kWindow: {
+      // Its surface tree's own frame sink: all of it, also where it's off
+      // the screen or bigger than it (but no frames while it's parked).
+      aura::Window* window = exo::EmbeddedWindows::Get()->GetSurfaceWindow(
+          static_cast<int32_t>(source.id));
+      if (!window) {
+        return content::DesktopMediaID();
+      }
+      return content::DesktopMediaID::RegisterNativeWindow(
+          content::DesktopMediaID::TYPE_WINDOW, window);
+    }
+    case Source::Type::kTab: {
+      content::WebContents* contents =
+          PlutoniumTabs::Get()->GetContents(static_cast<int32_t>(source.id));
+      content::RenderFrameHost* frame =
+          contents ? contents->GetPrimaryMainFrame() : nullptr;
+      if (!frame) {
+        return content::DesktopMediaID();
+      }
+      return content::DesktopMediaID(
+          content::DesktopMediaID::TYPE_WEB_CONTENTS,
+          content::DesktopMediaID::kNullId,
+          content::WebContentsMediaCaptureId(
+              frame->GetProcess()->GetDeprecatedID(), frame->GetRoutingID()));
+    }
+  }
+  NOTREACHED();
+}
+
+void PlutoniumCapture::Screenshot(const Source& source,
+                                  ScreenshotCallback callback) {
+  if (!screenshots_allowed()) {
+    std::move(callback).Run(SkBitmap(), kScreenshotsOff);
+    return;
+  }
+  if (source.type == Source::Type::kOutput) {
+    std::optional<display::Display> display = FindDisplay(source.id);
+    aura::Window* root = display && ash::Shell::HasInstance()
+                             ? ash::Shell::GetRootWindowForDisplayId(source.id)
+                             : nullptr;
+    if (!root) {
+      std::move(callback).Run(SkBitmap(), kNoSource);
+      return;
+    }
+    // The region is in pixels; the copy is asked for in DIPs, and comes in
+    // pixels, cropped.
+    gfx::Rect area(root->bounds().size());
+    if (!source.region.IsEmpty()) {
+      area = gfx::ToEnclosingRect(gfx::ScaleRect(
+          gfx::RectF(source.region), 1.f / display->device_scale_factor()));
+      area.Intersect(gfx::Rect(root->bounds().size()));
+    }
+    ui::GrabWindowSnapshot(
+        root, area,
+        base::BindOnce(
+            [](ScreenshotCallback callback, gfx::Image image) {
+              SkBitmap bitmap =
+                  image.IsEmpty() ? SkBitmap() : image.AsBitmap();
+              std::move(callback).Run(
+                  bitmap, bitmap.drawsNothing() ? "The copy failed" : "");
+            },
+            std::move(callback)));
+    return;
+  }
+  const int32_t id = static_cast<int32_t>(source.id);
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (source.type == Source::Type::kWindow
+          ? !broker || !broker->GetWindow(id)
+          : !PlutoniumTabs::Get()->GetTab(id)) {
+    std::move(callback).Run(SkBitmap(), kNoSource);
+    return;
+  }
+  auto crop = base::BindOnce(
+      [](const gfx::Rect& region, ScreenshotCallback callback,
+         const SkBitmap& bitmap) {
+        SkBitmap cropped = Crop(bitmap, region);
+        std::move(callback).Run(
+            cropped, cropped.drawsNothing() ? "The copy failed" : "");
+      },
+      source.region, std::move(callback));
+  if (source.type == Source::Type::kWindow) {
+    exo::EmbeddedWindows::Get()->Snapshot(id, std::move(crop));
+    return;
+  }
+  PlutoniumTabs::Get()->Snapshot(id, std::move(crop));
+}
+
+std::vector<base::DictValue> PlutoniumCapture::GetCaptures() const {
+  std::vector<base::DictValue> result;
+  for (const auto& [id, capture] : captures_) {
+    if (capture->started) {
+      result.push_back(ToValue(*capture));
+    }
+  }
+  return result;
+}
+
+base::DictValue PlutoniumCapture::ToValue(const Capture& capture) const {
+  base::DictValue value;
+  value.Set("id", capture.id);
+  value.Set("kind", capture.kind);
+  value.Set("source", capture.source.ToValue());
+  value.Set("label", LabelOf(capture.source));
+  value.Set("consumer", capture.consumer.Clone());
+  value.Set("cursor", capture.cursor);
+  value.Set("startTime", capture.start_time.InMillisecondsFSinceUnixEpochIgnoringNull());
+  value.Set("acknowledged", IsAcknowledged(capture));
+  if (!capture.size.IsEmpty()) {
+    value.Set("size", base::DictValue()
+                          .Set("width", capture.size.width())
+                          .Set("height", capture.size.height()));
+  }
+  if (capture.node_id) {
+    value.Set("nodeId", static_cast<int>(capture.node_id));
+  }
+  return value;
+}
+
+bool PlutoniumCapture::IsAcknowledged(const Capture& capture) const {
+  content::WebContents* shell = FocusedShell();
+  return shell && capture.acknowledged_by.contains(
+                      shell->GetPrimaryMainFrame()->GetGlobalId());
+}
+
+void PlutoniumCapture::Notify(const Capture& capture,
+                              bool started,
+                              bool stopped) {
+  const base::DictValue value = ToValue(capture);
+  for (Observer& observer : observers_) {
+    if (started) {
+      observer.OnCaptureStarted(capture.id, value);
+    } else if (stopped) {
+      observer.OnCaptureStopped(capture.id, value);
+    } else {
+      observer.OnCaptureChanged(capture.id, value);
+    }
+  }
+}
+
+void PlutoniumCapture::RunCommand(const std::string& command,
+                                  const std::string& args_json,
+                                  content::RenderFrameHost* frame,
+                                  int32_t taker,
+                                  CommandCallback callback) {
+  base::DictValue args;
+  if (!args_json.empty()) {
+    std::optional<base::Value> parsed = base::JSONReader::Read(
+        args_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (!parsed || !parsed->is_dict()) {
+      std::move(callback).Run(false, "The arguments must be a JSON object");
+      return;
+    }
+    args = std::move(parsed->GetDict());
+  }
+  // The helper's (the portal's): a capture request, answered later.
+  if (command == "request") {
+    if (frame) {
+      std::move(callback).Run(false, "Only for the helper");
+      return;
+    }
+    const std::string* kind = args.FindString("kind");
+    const bool screenshot = kind && *kind == "screenshot";
+    if (screenshot ? !screenshots_allowed() : !recording_allowed()) {
+      std::move(callback).Run(false,
+                              screenshot ? kScreenshotsOff : kRecordingOff);
+      return;
+    }
+    if (!kind) {
+      args.Set("kind", "screencast");
+    }
+    Request(std::move(args),
+            base::BindOnce(
+                [](CommandCallback callback, std::optional<base::Value> answer) {
+                  std::move(callback).Run(
+                      true, answer ? ToJson(*answer) : std::string("null"));
+                },
+                std::move(callback)));
+    return;
+  }
+  // The helper's (the portal's): a PipeWire node, ready later.
+  if (command == "start") {
+    if (frame) {
+      std::move(callback).Run(false, "Only for the helper");
+      return;
+    }
+    if (!recording_allowed()) {
+      std::move(callback).Run(false, kRecordingOff);
+      return;
+    }
+    StartScreencast(args, std::move(callback));
+    return;
+  }
+  // The helper's: a capture something else records (T3 Code's preview
+  // recordings encode a tab's screencast themselves). No node: it's only
+  // registered, so shells see it and can stop it, and the switch refuses it.
+  if (command == "register") {
+    if (frame) {
+      std::move(callback).Run(false, "Only for the helper");
+      return;
+    }
+    if (!recording_allowed()) {
+      std::move(callback).Run(false, kRecordingOff);
+      return;
+    }
+    base::expected<base::Value, std::string> registered = Register(args);
+    if (!registered.has_value()) {
+      std::move(callback).Run(false, registered.error());
+      return;
+    }
+    std::move(callback).Run(true, ToJson(registered.value()));
+    return;
+  }
+  base::expected<base::Value, std::string> result =
+      RunShellCommand(command, args, frame, taker);
+  if (!result.has_value()) {
+    std::move(callback).Run(false, result.error());
+    return;
+  }
+  std::move(callback).Run(true, ToJson(result.value()));
+}
+
+base::expected<base::Value, std::string> PlutoniumCapture::RunShellCommand(
+    const std::string& command,
+    const base::DictValue& args,
+    content::RenderFrameHost* frame,
+    int32_t taker) {
+  if (command == "sources") {
+    return base::Value(GetSources());
+  }
+  if (command == "settings") {
+    return base::Value(GetSettings());
+  }
+  if (command == "list") {
+    base::ListValue list;
+    for (base::DictValue& capture : GetCaptures()) {
+      list.Append(std::move(capture));
+    }
+    return base::Value(std::move(list));
+  }
+  if (command == "stop") {
+    std::optional<int> id = args.FindInt("id");
+    if (!id || !Stop(*id)) {
+      return base::unexpected("No such capture");
+    }
+    return base::Value();
+  }
+  if (command == "setSize") {
+    std::optional<int> id = args.FindInt("id");
+    if (!id) {
+      return base::unexpected("Which capture?");
+    }
+    return SetSize(*id, args);
+  }
+  if (command == "cancelRequest") {
+    const std::string* handle = args.FindString("handle");
+    if (frame || !handle) {
+      return base::unexpected("Which request?");
+    }
+    std::vector<int32_t> ids;
+    for (const auto& [id, request] : requests_) {
+      const std::string* request_handle = request->detail.FindString("handle");
+      if (request_handle && *request_handle == *handle) {
+        ids.push_back(id);
+      }
+    }
+    for (int32_t id : ids) {
+      Finish(id, std::nullopt);
+    }
+    return base::Value(!ids.empty());
+  }
+  // The rest are a shell document's.
+  if (!frame) {
+    return base::unexpected("Only for shells");
+  }
+  if (command == "setSettings") {
+    return SetSettings(args);
+  }
+  if (command == "stream") {
+    base::expected<base::DictValue, std::string> stream =
+        RegisterStream(args, frame);
+    if (!stream.has_value()) {
+      return base::unexpected(stream.error());
+    }
+    return base::Value(std::move(stream.value()));
+  }
+  if (command == "acknowledge") {
+    std::optional<int> id = args.FindInt("id");
+    if (!id || !Find(*id)) {
+      return base::unexpected("No such capture");
+    }
+    Acknowledge(*id, frame);
+    return base::Value();
+  }
+  if (command == "answer") {
+    std::optional<int> request_id = args.FindInt("requestId");
+    const base::Value* answer = args.Find("answer");
+    if (!request_id) {
+      return base::unexpected("Which request?");
+    }
+    const base::Value null_answer;
+    return base::Value(
+        Answer(*request_id, taker, answer ? *answer : null_answer));
+  }
+  return base::unexpected("No such command: " + command);
+}
+
+base::expected<base::Value, std::string> PlutoniumCapture::Register(
+    const base::DictValue& args) {
+  const base::Value* source_value = args.Find("source");
+  std::optional<Source> source =
+      source_value ? Source::FromValue(*source_value) : std::nullopt;
+  if (!source) {
+    return base::unexpected("Which source?");
+  }
+  if (ToMediaId(*source).is_null()) {
+    return base::unexpected(kNoSource);
+  }
+  auto capture = std::make_unique<Capture>();
+  capture->kind = "external";
+  capture->source = *source;
+  if (const base::DictValue* consumer = args.FindDict("consumer")) {
+    capture->consumer = consumer->Clone();
+  }
+  if (!capture->consumer.FindString("kind")) {
+    capture->consumer.Set("kind", "app");
+  }
+  if (!capture->consumer.FindString("name")) {
+    capture->consumer.Set("name", "An app");
+  }
+  const std::string* cursor = args.FindString("cursor");
+  capture->cursor = cursor ? *cursor : "embedded";
+  const int32_t id = Add(std::move(capture));
+  // Its "stop" only tells the helper, through capturestop.
+  OnStreamStarted(id, base::RepeatingClosure());
+  return base::Value(base::DictValue().Set("captureId", id));
+}
+
+base::expected<base::DictValue, std::string> PlutoniumCapture::RegisterStream(
+    const base::DictValue& args,
+    content::RenderFrameHost* frame) {
+  if (!recording_allowed()) {
+    return base::unexpected(kRecordingOff);
+  }
+  const base::Value* source_value = args.Find("source");
+  std::optional<Source> source =
+      source_value ? Source::FromValue(*source_value) : std::nullopt;
+  if (!source) {
+    return base::unexpected("Which source?");
+  }
+  const content::DesktopMediaID media_id = ToMediaId(*source);
+  if (media_id.is_null()) {
+    return base::unexpected(kNoSource);
+  }
+  auto capture = std::make_unique<Capture>();
+  capture->kind = "stream";
+  capture->source = *source;
+  base::DictValue consumer;
+  consumer.Set("kind", "shell");
+  std::string name = "Shell";
+  content::WebContents* contents =
+      content::WebContents::FromRenderFrameHost(frame);
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    if (std::optional<PlutoniumShells::Shell> shell =
+            shells->GetShellFor(contents)) {
+      consumer.Set("shellId", shell->id);
+      name = shell->name;
+    }
+  }
+  consumer.Set("name", name);
+  capture->consumer = std::move(consumer);
+  if (const base::DictValue* size = args.FindDict("size")) {
+    capture->size = gfx::Size(size->FindInt("width").value_or(0),
+                              size->FindInt("height").value_or(0));
+    if (capture->size.IsEmpty() || source->type != Source::Type::kWindow) {
+      capture->size = gfx::Size();
+    }
+  }
+  if (const std::string* cursor = args.FindString("cursor")) {
+    capture->cursor = *cursor;
+  }
+  capture->stream_id =
+      content::DesktopStreamsRegistry::GetInstance()->RegisterStream(
+          frame->GetProcess()->GetDeprecatedID(), frame->GetRoutingID(),
+          frame->GetLastCommittedOrigin(), media_id,
+          content::kRegistryStreamTypeDesktop);
+  const std::string stream_id = capture->stream_id;
+  const int32_t id = Add(std::move(capture));
+  // Forgotten unless getUserMedia() uses it soon.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PlutoniumCapture::DropUnusedStream,
+                     base::Unretained(this), id),
+      kStreamIdLifetime);
+  VLOG(1) << "EXO-CAPTURE stream #" << id << " of "
+          << ToJson(base::Value(source->ToValue())) << " for a shell";
+  return base::DictValue().Set("streamId", stream_id).Set("captureId", id);
+}
+
+void PlutoniumCapture::StartScreencast(const base::DictValue& args,
+                                       CommandCallback callback) {
+  const base::Value* source_value = args.Find("source");
+  std::optional<Source> source =
+      source_value ? Source::FromValue(*source_value) : std::nullopt;
+  if (!source) {
+    std::move(callback).Run(false, "Which source?");
+    return;
+  }
+  PlutoniumScreencast::Target target;
+  gfx::Size size;
+  gfx::Size held;
+  if (const base::DictValue* asked = args.FindDict("size");
+      asked && source->type == Source::Type::kWindow) {
+    held = gfx::Size(asked->FindInt("width").value_or(0),
+                     asked->FindInt("height").value_or(0));
+    if (held.IsEmpty()) {
+      held = gfx::Size();
+    }
+  }
+  switch (source->type) {
+    case Source::Type::kOutput: {
+      std::optional<display::Display> display = FindDisplay(source->id);
+      target.window = display && ash::Shell::HasInstance()
+                          ? ash::Shell::GetRootWindowForDisplayId(source->id)
+                          : nullptr;
+      if (display) {
+        size = display->GetSizeInPixel();
+      }
+      break;
+    }
+    case Source::Type::kWindow: {
+      // From its copies as it draws: also while it's parked off the screen,
+      // and at a size bigger than the screen.
+      target.pushed_frames = true;
+      target.window = exo::EmbeddedWindows::Get()->GetCaptureWindow(
+          static_cast<int32_t>(source->id));
+      if (target.window) {
+        const float scale = target.window->layer()->device_scale_factor();
+        size = gfx::ScaleToCeiledSize(
+            held.IsEmpty() ? target.window->bounds().size() : held, scale);
+      }
+      break;
+    }
+    case Source::Type::kTab: {
+      target.contents =
+          PlutoniumTabs::Get()->GetContents(static_cast<int32_t>(source->id));
+      content::RenderWidgetHostView* view =
+          target.contents ? target.contents->GetRenderWidgetHostView()
+                          : nullptr;
+      if (view) {
+        size = gfx::ScaleToCeiledSize(view->GetViewBounds().size(),
+                                      view->GetDeviceScaleFactor());
+      }
+      break;
+    }
+  }
+  if ((!target.window && !target.contents) || size.IsEmpty()) {
+    std::move(callback).Run(false, kNoSource);
+    return;
+  }
+  auto capture = std::make_unique<Capture>();
+  capture->kind = "pipewire";
+  capture->source = *source;
+  capture->size = held;
+  if (const base::DictValue* consumer = args.FindDict("consumer")) {
+    capture->consumer = consumer->Clone();
+  }
+  if (!capture->consumer.FindString("kind")) {
+    capture->consumer.Set("kind", "app");
+  }
+  if (!capture->consumer.FindString("name")) {
+    capture->consumer.Set("name", "An app");
+  }
+  const std::string* cursor = args.FindString("cursor");
+  capture->cursor = cursor ? *cursor : "hidden";
+  const std::string label = LabelOf(*source);
+  const std::string cursor_mode = capture->cursor;
+  const int32_t id = Add(std::move(capture));
+  // Its callbacks come from inside it: they must not destroy it there.
+  std::unique_ptr<PlutoniumScreencast> screencast = PlutoniumScreencast::Start(
+      target, size, cursor_mode, "Plutonium: " + label,
+      base::BindPostTaskToCurrentDefault(
+          base::BindOnce(&PlutoniumCapture::OnScreencastReady,
+                         base::Unretained(this), id, std::move(callback))),
+      base::BindPostTaskToCurrentDefault(base::BindOnce(
+          &PlutoniumCapture::Remove, base::Unretained(this), id)));
+  if (!screencast) {
+    // The ready callback says so.
+    captures_.erase(id);
+    return;
+  }
+  Capture* added = Find(id);
+  if (target.pushed_frames) {
+    PlutoniumScreencast* frames_to = screencast.get();
+    added->window_frames = plutonium_agent::WindowScreencast::Start(
+        static_cast<int32_t>(source->id), size,
+        base::BindRepeating(
+            [](PlutoniumScreencast* screencast, const SkBitmap& frame) {
+              screencast->PushFrame(frame);
+            },
+            base::Unretained(frames_to)));
+  }
+  added->screencast = std::move(screencast);
+}
+
+void PlutoniumCapture::OnScreencastReady(int32_t id,
+                                         CommandCallback callback,
+                                         uint32_t node_id,
+                                         const gfx::Size& size) {
+  Capture* capture = Find(id);
+  if (!capture || !node_id) {
+    captures_.erase(id);
+    std::move(callback).Run(false, "No PipeWire node (is PipeWire running?)");
+    return;
+  }
+  capture->node_id = node_id;
+  OnStreamStarted(id, base::RepeatingClosure());
+  std::move(callback).Run(true, ToJson(base::Value(base::DictValue()
+                                                       .Set("captureId", id)
+                                                       .Set("nodeId", static_cast<int>(node_id))
+                                                       .Set("width", size.width())
+                                                       .Set("height", size.height()))));
+}
+
+// static
+bool PlutoniumCapture::PicksInShell() {
+  return plutonium_shell::IsShellMode();
+}
+
+base::DictValue PlutoniumCapture::ConsumerFor(
+    content::WebContents* contents,
+    const std::u16string& app_name) const {
+  base::DictValue consumer;
+  consumer.Set("kind", "tab");
+  consumer.Set("name", app_name.empty() ? std::string("A page")
+                                        : base::UTF16ToUTF8(app_name));
+  if (std::optional<PlutoniumTabs::TabInfo> tab =
+          PlutoniumTabs::Get()->GetTabFor(contents)) {
+    consumer.Set("tabId", tab->id);
+    if (!tab->tags.empty()) {
+      consumer.Set("thread", tab->tags.front());
+    }
+  } else if (contents &&
+             plutonium_shell::IsShellDocument(contents->GetPrimaryMainFrame())) {
+    consumer.Set("kind", "shell");
+  }
+  return consumer;
+}
+
+content::DesktopMediaID PlutoniumCapture::PrepareDisplay(
+    const base::Value& answer,
+    base::DictValue consumer) {
+  const base::ListValue* sources =
+      answer.is_dict() ? answer.GetDict().FindList("sources") : nullptr;
+  std::optional<Source> source = sources && !sources->empty()
+                                     ? Source::FromValue(sources->front())
+                                     : std::nullopt;
+  if (!source) {
+    return content::DesktopMediaID();
+  }
+  const content::DesktopMediaID media_id = ToMediaId(*source);
+  if (media_id.is_null()) {
+    return media_id;
+  }
+  auto capture = std::make_unique<Capture>();
+  capture->kind = "display";
+  capture->source = *source;
+  capture->consumer = std::move(consumer);
+  capture->stream_id = media_id.ToString();
+  const int32_t id = Add(std::move(capture));
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PlutoniumCapture::DropUnusedStream,
+                     base::Unretained(this), id),
+      kStreamIdLifetime);
+  return media_id;
+}
+
+int32_t PlutoniumCapture::TakeDisplay(const content::DesktopMediaID& media_id) {
+  const std::string stream_id = media_id.ToString();
+  for (auto& [id, capture] : captures_) {
+    if (capture->kind == "display" && !capture->started &&
+        capture->stream_id == stream_id) {
+      capture->stream_id.clear();
+      return id;
+    }
+  }
+  return 0;
+}
+
+void PlutoniumCapture::DropUnusedStream(int32_t id) {
+  auto it = captures_.find(id);
+  if (it != captures_.end() && !it->second->started) {
+    captures_.erase(it);
+  }
+}
+
+int32_t PlutoniumCapture::TakeStream(
+    const content::MediaStreamRequest& request) {
+  if (request.requested_video_device_ids.empty()) {
+    return 0;
+  }
+  const std::string& stream_id = request.requested_video_device_ids.front();
+  if (stream_id.empty()) {
+    return 0;
+  }
+  for (auto& [id, capture] : captures_) {
+    if (capture->stream_id == stream_id) {
+      capture->stream_id.clear();
+      return id;
+    }
+  }
+  return 0;
+}
+
+std::unique_ptr<content::MediaStreamUI> PlutoniumCapture::WrapStreamUI(
+    int32_t id,
+    std::unique_ptr<content::MediaStreamUI> ui) {
+  if (!Find(id)) {
+    return ui;
+  }
+  return std::make_unique<StreamUI>(id, std::move(ui));
+}
+
+PlutoniumCapture::Capture* PlutoniumCapture::Find(int32_t id) {
+  auto it = captures_.find(id);
+  return it == captures_.end() ? nullptr : it->second.get();
+}
+
+int32_t PlutoniumCapture::Add(std::unique_ptr<Capture> capture) {
+  const int32_t id = next_id_++;
+  capture->id = id;
+  captures_[id] = std::move(capture);
+  return id;
+}
+
+void PlutoniumCapture::OnStreamStarted(int32_t id,
+                                       base::RepeatingClosure stop) {
+  Capture* capture = Find(id);
+  if (!capture || capture->started) {
+    return;
+  }
+  capture->started = true;
+  capture->start_time = base::Time::Now();
+  capture->started_at = base::TimeTicks::Now();
+  capture->stop = std::move(stop);
+  if (capture->source.type == Source::Type::kWindow) {
+    capture->keep_drawing = exo::EmbeddedWindows::Get()->KeepDrawing(
+        static_cast<int32_t>(capture->source.id));
+    UpdateCaptureSize(capture->source.id);
+  }
+  VLOG(1) << "EXO-CAPTURE #" << id << " (" << capture->kind << ") started: "
+          << LabelOf(capture->source);
+  Notify(*capture, /*started=*/true, /*stopped=*/false);
+  UpdateIndicator();
+}
+
+void PlutoniumCapture::Remove(int32_t id) {
+  auto it = captures_.find(id);
+  if (it == captures_.end()) {
+    return;
+  }
+  std::unique_ptr<Capture> capture = std::move(it->second);
+  captures_.erase(it);
+  if (!capture->started) {
+    return;
+  }
+  VLOG(1) << "EXO-CAPTURE #" << id << " stopped";
+  if (capture->source.type == Source::Type::kWindow) {
+    UpdateCaptureSize(capture->source.id);
+  }
+  Notify(*capture, /*started=*/false, /*stopped=*/true);
+  UpdateIndicator();
+}
+
+bool PlutoniumCapture::Stop(int32_t id) {
+  Capture* capture = Find(id);
+  if (!capture) {
+    return false;
+  }
+  base::RepeatingClosure stop = capture->stop;
+  if (stop) {
+    stop.Run();
+  }
+  // Whether or not the stream told us yet.
+  Remove(id);
+  return true;
+}
+
+base::expected<base::Value, std::string> PlutoniumCapture::SetSize(
+    int32_t id,
+    const base::DictValue& args) {
+  Capture* capture = Find(id);
+  if (!capture) {
+    return base::unexpected("No such capture");
+  }
+  if (capture->source.type != Source::Type::kWindow) {
+    return base::unexpected("Only a window can be held at a size");
+  }
+  gfx::Size size(args.FindInt("width").value_or(0),
+                 args.FindInt("height").value_or(0));
+  capture->size = size.IsEmpty() ? gfx::Size() : size;
+  UpdateCaptureSize(capture->source.id);
+  if (capture->started) {
+    Notify(*capture, /*started=*/false, /*stopped=*/false);
+  }
+  return base::Value();
+}
+
+void PlutoniumCapture::UpdateCaptureSize(int64_t window_id) {
+  gfx::Size size;
+  // The newest capture's.
+  for (const auto& [id, capture] : captures_) {
+    if (capture->started && capture->source.type == Source::Type::kWindow &&
+        capture->source.id == window_id && !capture->size.IsEmpty()) {
+      size = capture->size;
+    }
+  }
+  exo::EmbeddedWindows::Get()->SetCaptureSize(static_cast<int32_t>(window_id),
+                                              size);
+}
+
+void PlutoniumCapture::Acknowledge(int32_t id,
+                                   content::RenderFrameHost* frame) {
+  Capture* capture = Find(id);
+  if (!capture ||
+      !capture->acknowledged_by.insert(frame->GetGlobalId()).second) {
+    return;
+  }
+  if (capture->started) {
+    Notify(*capture, /*started=*/false, /*stopped=*/false);
+  }
+  UpdateIndicator();
+}
+
+void PlutoniumCapture::UpdateIndicator() {
+  indicator_timer_.Stop();
+  std::vector<base::DictValue> unshown;
+  base::TimeDelta next = base::TimeDelta::Max();
+  const base::TimeTicks now = base::TimeTicks::Now();
+  for (const auto& [id, capture] : captures_) {
+    if (!capture->started || IsAcknowledged(*capture)) {
+      continue;
+    }
+    const base::TimeDelta age = now - capture->started_at;
+    if (age >= kAcknowledgeDelay) {
+      unshown.push_back(ToValue(*capture));
+    } else {
+      next = std::min(next, kAcknowledgeDelay - age);
+    }
+  }
+  if (ui_) {
+    ui_->ShowIndicator(unshown);
+  }
+  if (!next.is_max()) {
+    indicator_timer_.Start(FROM_HERE, next,
+                           base::BindOnce(&PlutoniumCapture::UpdateIndicator,
+                                          base::Unretained(this)));
+  }
+}
+
+void PlutoniumCapture::OnVisibleShellChanged(content::WebContents* previous,
+                                             content::WebContents* visible) {
+  // Acknowledged or not depends on which shell is in front.
+  for (const auto& [id, capture] : captures_) {
+    if (capture->started) {
+      Notify(*capture, /*started=*/false, /*stopped=*/false);
+    }
+  }
+  UpdateIndicator();
+}
+
+void PlutoniumCapture::OnShellsDestroying() {
+  shells_observation_.Reset();
+}
+
+int32_t PlutoniumCapture::Request(base::DictValue detail, AnswerCallback done) {
+  auto request = std::make_unique<PendingRequest>();
+  const int32_t id = next_request_id_++;
+  request->id = id;
+  detail.Set("requestId", id);
+  request->detail = std::move(detail);
+  request->done = std::move(done);
+  const std::string json = ToJson(base::Value(request->detail.Clone()));
+  requests_[id] = std::move(request);
+  VLOG(1) << "EXO-CAPTURE request #" << id << ": " << json;
+
+  content::WebContents* shell = FocusedShell();
+  const bool asked =
+      shell && plutonium_shell::SendCaptureRequest(
+                   shell, id, json,
+                   base::BindOnce(&PlutoniumCapture::OnTaken,
+                                  base::Unretained(this), id));
+  if (!asked) {
+    VLOG(1) << "EXO-CAPTURE request #" << id
+            << ": no shell listens, Ash's picker asks";
+    // Callbacks never run from inside Request().
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PlutoniumCapture::Pick, base::Unretained(this), id));
+  }
+  return id;
+}
+
+void PlutoniumCapture::OnTaken(int32_t request_id, int32_t taker) {
+  auto it = requests_.find(request_id);
+  if (it == requests_.end()) {
+    // Over already.
+    if (taker) {
+      plutonium_shell::EndCaptureRequest(taker, request_id);
+    }
+    return;
+  }
+  if (taker) {
+    it->second->taker = taker;
+    return;
+  }
+  VLOG(1) << "EXO-CAPTURE request #" << request_id
+          << ": the shell didn't take it, Ash's picker asks";
+  Pick(request_id);
+}
+
+void PlutoniumCapture::Pick(int32_t request_id) {
+  auto it = requests_.find(request_id);
+  if (it == requests_.end()) {
+    return;
+  }
+  PendingRequest& request = *it->second;
+  request.taker = 0;
+  if (!ui_) {
+    Finish(request_id, std::nullopt);
+    return;
+  }
+  request.picking = true;
+  ui_->Pick(request.detail,
+            base::BindOnce(&PlutoniumCapture::OnPicked, base::Unretained(this),
+                           request_id));
+}
+
+void PlutoniumCapture::OnPicked(int32_t request_id,
+                                std::optional<base::Value> answer) {
+  auto it = requests_.find(request_id);
+  if (it == requests_.end() || !it->second->picking) {
+    return;
+  }
+  it->second->picking = false;
+  if (!answer) {
+    Finish(request_id, std::nullopt);
+    return;
+  }
+  base::expected<base::Value, std::string> checked =
+      CheckAnswer(*it->second, *answer);
+  Finish(request_id, checked.has_value()
+                         ? std::make_optional(std::move(checked.value()))
+                         : std::nullopt);
+}
+
+base::expected<base::Value, std::string> PlutoniumCapture::CheckAnswer(
+    const PendingRequest& request,
+    const base::Value& answer) const {
+  if (!answer.is_dict()) {
+    return base::unexpected("The answer must be an object");
+  }
+  const base::ListValue* sources = answer.GetDict().FindList("sources");
+  if (!sources || sources->empty()) {
+    return base::unexpected("The answer names no source");
+  }
+  const base::ListValue* types = request.detail.FindList("types");
+  const bool multiple = request.detail.FindBool("multiple").value_or(false);
+  base::ListValue checked;
+  for (const base::Value& value : *sources) {
+    std::optional<Source> source = Source::FromValue(value);
+    if (!source || ToMediaId(*source).is_null()) {
+      return base::unexpected(kNoSource);
+    }
+    if (types && !types->empty() &&
+        !std::ranges::contains(*types, base::Value(TypeName(source->type)))) {
+      return base::unexpected("Not a type the consumer asked for");
+    }
+    checked.Append(source->ToValue());
+    if (!multiple) {
+      break;
+    }
+  }
+  base::DictValue result;
+  result.Set("sources", std::move(checked));
+  if (const base::DictValue* size = answer.GetDict().FindDict("size")) {
+    result.Set("size", size->Clone());
+  }
+  if (const std::string* cursor = answer.GetDict().FindString("cursor")) {
+    result.Set("cursor", *cursor);
+  }
+  if (std::optional<bool> persist = answer.GetDict().FindBool("persist")) {
+    result.Set("persist", *persist);
+  }
+  return base::Value(std::move(result));
+}
+
+bool PlutoniumCapture::Answer(int32_t request_id,
+                              int32_t taker,
+                              const base::Value& answer) {
+  auto it = requests_.find(request_id);
+  if (it == requests_.end() || !taker || it->second->taker != taker) {
+    return false;
+  }
+  // The answerer needs no "capturerequestend".
+  it->second->taker = 0;
+  // null, or {refused: true}: the user said no.
+  if (answer.is_none() ||
+      (answer.is_dict() &&
+       answer.GetDict().FindBool("refused").value_or(false))) {
+    Finish(request_id, std::nullopt);
+    return true;
+  }
+  base::expected<base::Value, std::string> checked =
+      CheckAnswer(*it->second, answer);
+  if (!checked.has_value()) {
+    VLOG(1) << "EXO-CAPTURE request #" << request_id
+            << ": answer refused: " << checked.error();
+    it->second->taker = taker;
+    return false;
+  }
+  Finish(request_id, std::move(checked.value()));
+  return true;
+}
+
+void PlutoniumCapture::Finish(int32_t request_id,
+                              std::optional<base::Value> answer) {
+  auto it = requests_.find(request_id);
+  if (it == requests_.end()) {
+    return;
+  }
+  std::unique_ptr<PendingRequest> request = std::move(it->second);
+  requests_.erase(it);
+  if (request->picking && ui_) {
+    ui_->CancelPick(request_id);
+  }
+  // A shell that took it and didn't answer it puts its UI away.
+  if (request->taker && !answer) {
+    plutonium_shell::EndCaptureRequest(request->taker, request_id);
+  }
+  VLOG(1) << "EXO-CAPTURE request #" << request_id << " "
+          << (answer ? "answered: " + ToJson(*answer) : "refused");
+  std::move(request->done).Run(std::move(answer));
+}
+
+void PlutoniumCapture::CancelRequest(int32_t request_id) {
+  auto it = requests_.find(request_id);
+  if (it == requests_.end()) {
+    return;
+  }
+  std::unique_ptr<PendingRequest> request = std::move(it->second);
+  requests_.erase(it);
+  if (request->picking && ui_) {
+    ui_->CancelPick(request_id);
+  }
+  if (request->taker) {
+    plutonium_shell::EndCaptureRequest(request->taker, request_id);
+  }
+}
+
+void PlutoniumCapture::OnShellGone(int32_t taker) {
+  std::vector<int32_t> ids;
+  for (const auto& [id, request] : requests_) {
+    if (request->taker == taker) {
+      request->taker = 0;
+      ids.push_back(id);
+    }
+  }
+  for (int32_t id : ids) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PlutoniumCapture::Pick, base::Unretained(this), id));
+  }
+}
+
+int32_t PlutoniumCapture::RequestOutputCapture(
+    int32_t pid,
+    int64_t display_id,
+    base::OnceCallback<void(bool)> done) {
+  if (!recording_allowed() || !screenshots_allowed()) {
+    std::move(done).Run(false);
+    return 0;
+  }
+  const int32_t token = next_wayland_token_++;
+  wayland_requests_[token] = 0;
+  // Who asks: its process's name and thread, from /proc (off this thread).
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](int32_t pid) {
+            std::string name;
+            base::ReadFileToString(
+                base::FilePath("/proc/" + base::NumberToString(pid) + "/comm"),
+                &name);
+            base::TrimWhitespaceASCII(name, base::TRIM_ALL, &name);
+            base::DictValue consumer;
+            consumer.Set("kind", "app");
+            consumer.Set("name", name.empty() ? std::string("A Wayland app")
+                                              : name);
+            consumer.Set("pid", pid);
+            if (std::optional<std::string> thread =
+                    plutonium_tags::ReadThreadTag(pid)) {
+              consumer.Set("thread", *thread);
+            }
+            return consumer;
+          },
+          pid),
+      base::BindOnce(
+          [](PlutoniumCapture* self, int32_t token, int64_t display_id,
+             base::OnceCallback<void(bool)> done, base::DictValue consumer) {
+            auto pending = self->wayland_requests_.find(token);
+            if (pending == self->wayland_requests_.end()) {
+              return;  // The client went away.
+            }
+            // For OnCaptureStarted().
+            self->wayland_consumers_[consumer.FindInt("pid").value_or(0)] =
+                consumer.Clone();
+            base::ListValue types;
+            types.Append("output");
+            pending->second = self->Request(
+                base::DictValue()
+                    .Set("kind", "screencast")
+                    .Set("consumer", std::move(consumer))
+                    .Set("types", std::move(types))
+                    .Set("multiple", false),
+                base::BindOnce(
+                    [](PlutoniumCapture* self, int32_t token,
+                       base::OnceCallback<void(bool)> done,
+                       std::optional<base::Value> answer) {
+                      self->wayland_requests_.erase(token);
+                      std::move(done).Run(answer.has_value());
+                    },
+                    base::Unretained(self), token, std::move(done)));
+          },
+          base::Unretained(this), token, display_id, std::move(done)));
+  return token;
+}
+
+void PlutoniumCapture::CancelOutputCapture(int32_t token) {
+  auto pending = wayland_requests_.find(token);
+  if (pending == wayland_requests_.end()) {
+    return;
+  }
+  const int32_t request_id = pending->second;
+  wayland_requests_.erase(pending);
+  if (request_id) {
+    CancelRequest(request_id);
+  }
+}
+
+int32_t PlutoniumCapture::OnCaptureStarted(int32_t pid,
+                                           int64_t display_id,
+                                           base::RepeatingClosure stop) {
+  auto capture = std::make_unique<Capture>();
+  capture->kind = "wayland";
+  capture->source.type = Source::Type::kOutput;
+  capture->source.id = display_id;
+  auto known = wayland_consumers_.find(pid);
+  if (known != wayland_consumers_.end()) {
+    capture->consumer = std::move(known->second);
+    wayland_consumers_.erase(known);
+  } else {
+    capture->consumer.Set("kind", "app");
+    capture->consumer.Set("pid", pid);
+    capture->consumer.Set("name", "A Wayland app");
+  }
+  capture->cursor = "hidden";
+  const int32_t id = Add(std::move(capture));
+  OnStreamStarted(id, std::move(stop));
+  return id;
+}
+
+void PlutoniumCapture::OnCaptureStopped(int32_t id) {
+  Remove(id);
+}
