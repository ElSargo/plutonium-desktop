+// A shell has this long to call getUserMedia() with a stream id.
+constexpr base::TimeDelta kStreamIdLifetime = base::Seconds(10);
+
+constexpr char kRecordingOff[] =
+    "Recording is switched off (Plutonium's capture settings)";
+constexpr char kScreenshotsOff[] =
+    "Screenshots are switched off (Plutonium's capture settings)";
+constexpr char kNoSource[] = "No such source";
+
+std::optional<int64_t> IdOf(const base::Value* value) {
+  if (!value) {
+    return std::nullopt;
+  }
+  if (value->is_int()) {
+    return value->GetInt();
+  }
+  if (value->is_double()) {
+    return static_cast<int64_t>(value->GetDouble());
+  }
+  int64_t id = 0;
+  if (value->is_string() && base::StringToInt64(value->GetString(), &id)) {
+    return id;
+  }
+  return std::nullopt;
+}
+
+const char* TypeName(PlutoniumCapture::Source::Type type) {
+  switch (type) {
+    case PlutoniumCapture::Source::Type::kOutput:
+      return "output";
+    case PlutoniumCapture::Source::Type::kWindow:
+      return "window";
+    case PlutoniumCapture::Source::Type::kTab:
+      return "tab";
+  }
+  NOTREACHED();
+}
+
+std::optional<display::Display> FindDisplay(int64_t id) {
+  for (const display::Display& display :
+       display::Screen::Get()->GetAllDisplays()) {
+    if (display.id() == id) {
+      return display;
+    }
+  }
+  return std::nullopt;
+}
+
+// EXO-DISPLAYS: the displays in the shells' order (left to right), so that
+// "Screen 2" here is display 2 everywhere else.
+std::vector<display::Display> OrderedDisplays() {
+  std::vector<display::Display> displays =
+      display::Screen::Get()->GetAllDisplays();
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    std::vector<display::Display> ordered;
+    for (const PlutoniumShells::Display& entry : shells->GetDisplays()) {
+      if (std::optional<display::Display> display = FindDisplay(entry.id)) {
+        ordered.push_back(*display);
+      }
+    }
+    if (ordered.size() == displays.size()) {
+      return ordered;
+    }
+  }
+  return displays;
+}
+
+std::string DisplayName(const display::Display& display, size_t index) {
+  // A monitor's own name (from its EDID); an X11 host window's is made up.
+  if (!display.label().empty() &&
+      !display.label().starts_with("Display-")) {
+    return display.label();
+  }
+  return "Screen " + base::NumberToString(index + 1);
+}
+
+// |bitmap| cropped to |region| (its pixels; empty: all of it). Empty if
+// |region| is outside it.
+SkBitmap Crop(const SkBitmap& bitmap, const gfx::Rect& region) {
+  if (region.IsEmpty() || bitmap.drawsNothing()) {
+    return bitmap;
+  }
+  gfx::Rect crop = region;
+  crop.Intersect(gfx::Rect(bitmap.width(), bitmap.height()));
+  SkBitmap cropped;
+  if (crop.IsEmpty() ||
+      !bitmap.extractSubset(&cropped, SkIRect::MakeXYWH(crop.x(), crop.y(),
+                                                         crop.width(),
+                                                         crop.height()))) {
+    return SkBitmap();
+  }
+  return cropped;
+}
+
+std::string ToJson(const base::Value& value) {
+  std::string json;
+  base::JSONWriter::Write(value, &json);
+  return json;
+}
+
+}  // namespace
+
+PlutoniumCapture::Source::Source() = default;
+PlutoniumCapture::Source::Source(const Source&) = default;
+PlutoniumCapture::Source& PlutoniumCapture::Source::operator=(const Source&) =
+    default;
+PlutoniumCapture::Source::~Source() = default;
+bool PlutoniumCapture::Source::operator==(const Source&) const = default;
+
+// static
+std::optional<PlutoniumCapture::Source> PlutoniumCapture::Source::FromValue(
+    const base::Value& value) {
+  if (!value.is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = value.GetDict();
+  const std::string* type = dict.FindString("type");
+  std::optional<int64_t> id = IdOf(dict.Find("id"));
+  if (!type || !id) {
+    return std::nullopt;
+  }
+  Source source;
+  if (*type == "output") {
+    source.type = Type::kOutput;
+  } else if (*type == "window") {
+    source.type = Type::kWindow;
+  } else if (*type == "tab") {
+    source.type = Type::kTab;
+  } else {
+    return std::nullopt;
+  }
+  source.id = *id;
+  if (const base::DictValue* region = dict.FindDict("region")) {
+    std::optional<int> x = region->FindInt("x");
+    std::optional<int> y = region->FindInt("y");
+    std::optional<int> width = region->FindInt("width");
+    std::optional<int> height = region->FindInt("height");
+    if (!x || !y || !width || !height || *width <= 0 || *height <= 0) {
+      return std::nullopt;
+    }
+    source.region = gfx::Rect(*x, *y, *width, *height);
+  }
+  return source;
+}
+
+base::DictValue PlutoniumCapture::Source::ToValue() const {
+  base::DictValue value;
+  value.Set("type", TypeName(type));
+  // Display ids don't fit in a JSON number.
+  if (type == Type::kOutput) {
+    value.Set("id", base::NumberToString(id));
+  } else {
+    value.Set("id", static_cast<int>(id));
+  }
+  if (!region.IsEmpty()) {
+    value.Set("region", base::DictValue()
+                            .Set("x", region.x())
+                            .Set("y", region.y())
+                            .Set("width", region.width())
+                            .Set("height", region.height()));
+  }
+  return value;
+}
