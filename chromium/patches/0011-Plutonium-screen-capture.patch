+  using AnswerCallback = base::OnceCallback<void(std::optional<base::Value>)>;
+  int32_t Request(base::DictValue detail, AnswerCallback done);
+  // The consumer went away: the request ends without |done|.
+  void CancelRequest(int32_t request_id);
+  // Broker connection |taker| went away: the requests it took go to Ash's
+  // picker.
+  void OnShellGone(int32_t taker);
+
+  // Stops capture |id|. False if there is no such capture.
+  bool Stop(int32_t id);
+
+  // EXO-CAPTURE: hooks for chrome/browser/media/webrtc's access handlers.
+  //
+  // Whether |request| (a getUserMedia() for a desktop stream) is for a
+  // stream a shell asked for with "stream": then its capture id, else 0.
+  // The stream id is used up.
+  int32_t TakeStream(const content::MediaStreamRequest& request);
+  // Wraps capture |id|'s stream UI so that it starts and stops with the
+  // stream (and Stop() stops it).
+  std::unique_ptr<content::MediaStreamUI> WrapStreamUI(
+      int32_t id,
+      std::unique_ptr<content::MediaStreamUI> ui);
+
+  // EXO-CAPTURE: getDisplayMedia() from a page (chrome/browser/media/webrtc's
+  // picker in shell mode).
+  //
+  // Whether pages' getDisplayMedia() asks the shells (shell mode).
+  static bool PicksInShell();
+  // Who asks, as a request's consumer.
