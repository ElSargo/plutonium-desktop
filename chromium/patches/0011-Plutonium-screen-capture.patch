+  // The global switches.
+  bool recording_allowed() const;
+  bool screenshots_allowed() const;
+  base::DictValue GetSettings() const;
+
+  // The sources there are now: {outputs: [{id, name, width, height (pixels),
+  // scaleFactor, primary}], windows: [{id, title, appId, width, height,
