+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/scroll_view.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+#include "ui/wm/core/window_util.h"
+
+namespace {
+
+// The shells overlay's colors.
+constexpr SkColor kPanel = SkColorSetRGB(0x20, 0x21, 0x24);
+constexpr SkColor kSelected = SkColorSetRGB(0x3c, 0x40, 0x43);
+constexpr SkColor kButton = SkColorSetRGB(0x30, 0x31, 0x34);
+constexpr SkColor kTitle = SkColorSetRGB(0xe8, 0xea, 0xed);
+constexpr SkColor kDim = SkColorSetRGB(0x9a, 0xa0, 0xa6);
+constexpr SkColor kAccent = SkColorSetRGB(0x8a, 0xb4, 0xf8);
+constexpr SkColor kOnAccent = SkColorSetRGB(0x20, 0x21, 0x24);
+constexpr SkColor kRecording = SkColorSetRGB(0xf2, 0x8b, 0x82);
+
+constexpr int kPickerWidth = 520;
+constexpr int kListHeight = 420;
+
+// Runs |action| from a fresh task: a button must not go away inside its own
+// event handling.
+base::RepeatingClosure Deferred(base::RepeatingClosure action) {
+  return base::BindRepeating(
+      [](base::RepeatingClosure action) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                                    action);
+      },
+      std::move(action));
+}
+
+views::Label* AddLabel(views::View* parent,
+                       std::u16string_view text,
+                       SkColor color,
+                       int size_delta = 0,
+                       bool bold = false) {
+  auto* label = parent->AddChildView(std::make_unique<views::Label>(text));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetAutoColorReadabilityEnabled(false);
+  label->SetEnabledColor(color);
+  gfx::FontList font = gfx::FontList().DeriveWithSizeDelta(size_delta);
+  if (bold) {
+    font = font.DeriveWithWeight(gfx::Font::Weight::BOLD);
+  }
+  label->SetFontList(font);
+  label->SetElideBehavior(gfx::ELIDE_TAIL);
+  return label;
+}
+
+views::LabelButton* AddButton(views::View* parent,
+                              std::u16string_view text,
+                              base::RepeatingClosure action,
+                              SkColor background,
+                              SkColor color) {
+  auto* button = parent->AddChildView(std::make_unique<views::LabelButton>(
+      base::BindRepeating(
+          [](base::RepeatingClosure action, const ui::Event&) {
+            action.Run();
+          },
+          Deferred(std::move(action))),
+      text));
+  button->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(7, 14)));
+  button->SetEnabledTextColors(color);
+  button->SetTextColor(views::Button::STATE_DISABLED, kDim);
+  button->SetBackground(views::CreateRoundedRectBackground(background, 6));
+  return button;
+}
+
+views::View* AddBox(views::View* parent,
+                    views::BoxLayout::Orientation orientation,
+                    int spacing,
+                    const gfx::Insets& insets = gfx::Insets()) {
+  auto* box = parent->AddChildView(std::make_unique<views::View>());
+  auto* layout = box->SetLayoutManager(
+      std::make_unique<views::BoxLayout>(orientation, insets, spacing));
+  if (orientation == views::BoxLayout::Orientation::kHorizontal) {
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+  }
+  return box;
+}
+
+// Gives the focused shell its focus back.
+void FocusShell() {
+  content::WebContents* shell = PlutoniumCapture::FocusedShell();
+  aura::Window* window = shell ? shell->GetTopLevelNativeWindow() : nullptr;
+  if (window && window->IsVisible()) {
+    wm::ActivateWindow(window);
+  }
+}
+
+// The picker's contents: who asks, then the sources it can have, by type,
+// then Cancel and Share.
+class PickerView : public views::View {
+  METADATA_HEADER(PickerView, views::View)
+
+ public:
+  using Done = base::RepeatingCallback<void(std::optional<base::Value>)>;
+
+  PickerView(const base::DictValue& request, Done done)
+      : done_(std::move(done)) {
+    multiple_ = request.FindBool("multiple").value_or(false);
+    const base::ListValue* types = request.FindList("types");
+    auto wants = [types](const char* type) {
+      return !types || types->empty() ||
+             std::ranges::contains(*types, base::Value(type));
+    };
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(20), 10));
+    SetBackground(views::CreateRoundedRectBackground(kPanel, 12));
+
+    const base::DictValue* consumer = request.FindDict("consumer");
+    const std::string* name =
+        consumer ? consumer->FindString("name") : nullptr;
+    const std::string* kind = request.FindString("kind");
+    const bool screenshot = kind && *kind == "screenshot";
+    const std::u16string who =
+        name && !name->empty() ? base::UTF8ToUTF16(*name) : u"An app";
+    AddLabel(this,
+             who + (screenshot ? u" wants a screenshot"
+                               : u" wants to share your screen"),
+             kTitle, 4, /*bold=*/true);
+    AddLabel(this,
+             multiple_ ? u"Choose what to share (one or more)."
+                       : u"Choose what to share.",
+             kDim);
+
+    auto* scroll = AddChildView(std::make_unique<views::ScrollView>());
+    scroll->SetBackgroundColor(kPanel);
+    scroll->ClipHeightTo(0, kListHeight);
+    auto* list = scroll->SetContents(std::make_unique<views::View>());
+    list->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 4));
+    const base::DictValue sources = PlutoniumCapture::Get()->GetSources();
+    if (wants("output")) {
+      AddSection(list, u"Screens", sources.FindList("outputs"), "output",
+                 "name");
+    }
+    if (wants("window")) {
+      AddSection(list, u"Windows", sources.FindList("windows"), "window",
+                 "title");
+    }
+    if (wants("tab")) {
+      AddSection(list, u"Tabs", sources.FindList("tabs"), "tab", "title");
+    }
+    if (items_.empty()) {
+      AddLabel(list, u"There's nothing to share.", kDim);
+    }
+
+    auto* buttons =
+        AddBox(this, views::BoxLayout::Orientation::kHorizontal, 8);
+    static_cast<views::BoxLayout*>(buttons->GetLayoutManager())
+        ->set_main_axis_alignment(views::BoxLayout::MainAxisAlignment::kEnd);
+    AddButton(buttons, u"Cancel",
+              base::BindRepeating(&PickerView::Cancel,
+                                  weak_factory_.GetWeakPtr()),
+              kButton, kTitle);
+    share_ = AddButton(buttons, screenshot ? u"Take" : u"Share",
+                       base::BindRepeating(&PickerView::Share,
+                                           weak_factory_.GetWeakPtr()),
+                       kAccent, kOnAccent);
+    share_->SetEnabled(false);
+
+    AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+    AddAccelerator(ui::Accelerator(ui::VKEY_RETURN, ui::EF_NONE));
+  }
+
+  // views::View:
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override {
+    if (accelerator.key_code() == ui::VKEY_ESCAPE) {
+      Cancel();
+    } else if (share_->GetEnabled()) {
+      Share();
+    }
+    return true;
+  }
+
+ private:
+  struct Item {
+    base::DictValue source;
+    raw_ptr<views::LabelButton> button = nullptr;
+    bool selected = false;
+  };
+
+  void AddSection(views::View* parent,
+                  std::u16string_view heading,
+                  const base::ListValue* entries,
+                  const char* type,
+                  const char* label_key) {
+    if (!entries || entries->empty()) {
+      return;
+    }
+    AddLabel(parent, heading, kDim, -1, /*bold=*/true);
+    for (const base::Value& entry : *entries) {
+      if (!entry.is_dict()) {
+        continue;
+      }
+      const base::DictValue& dict = entry.GetDict();
+      const base::Value* id = dict.Find("id");
+      if (!id) {
+        continue;
+      }
+      const std::string* label = dict.FindString(label_key);
+      Item item;
+      item.source = base::DictValue().Set("type", type).Set("id", id->Clone());
+      item.button = AddButton(
+          parent,
+          label && !label->empty() ? base::UTF8ToUTF16(*label)
+                                   : std::u16string(u"(untitled)"),
+          base::BindRepeating(&PickerView::Toggle, weak_factory_.GetWeakPtr(),
+                              items_.size()),
+          kButton, kTitle);
+      item.button->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      items_.push_back(std::move(item));
+    }
+  }
+
+  void Toggle(size_t index) {
+    for (size_t i = 0; i < items_.size(); ++i) {
+      if (i == index) {
+        items_[i].selected = !multiple_ || !items_[i].selected;
+      } else if (!multiple_) {
+        items_[i].selected = false;
+      }
+      items_[i].button->SetBackground(views::CreateRoundedRectBackground(
+          items_[i].selected ? kSelected : kButton, 6));
+    }
+    share_->SetEnabled(std::ranges::any_of(
+        items_, [](const Item& item) { return item.selected; }));
+  }
+
+  void Share() {
+    base::ListValue chosen;
+    for (const Item& item : items_) {
+      if (item.selected) {
+        chosen.Append(item.source.Clone());
+      }
+    }
+    done_.Run(base::Value(base::DictValue().Set("sources", std::move(chosen))));
+  }
+
+  void Cancel() { done_.Run(std::nullopt); }
+
+  bool multiple_ = false;
+  std::vector<Item> items_;
+  raw_ptr<views::LabelButton> share_ = nullptr;
+  Done done_;
+  base::WeakPtrFactory<PickerView> weak_factory_{this};
+};
+
+BEGIN_METADATA(PickerView)
+END_METADATA
+
+// The indicator's contents: a line per capture, with a Stop button.
+std::unique_ptr<views::View> BuildIndicator(
+    const std::vector<base::DictValue>& captures) {
+  auto view = std::make_unique<views::View>();
+  view->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(8, 12), 6));
+  view->SetBackground(views::CreateRoundedRectBackground(kPanel, 10));
+  for (const base::DictValue& capture : captures) {
+    auto* row = AddBox(view.get(), views::BoxLayout::Orientation::kHorizontal,
+                       10);
+    auto* dot = row->AddChildView(std::make_unique<views::View>());
+    dot->SetPreferredSize(gfx::Size(10, 10));
+    dot->SetBackground(views::CreateRoundedRectBackground(kRecording, 5));
+    const base::DictValue* consumer = capture.FindDict("consumer");
+    const std::string* name =
+        consumer ? consumer->FindString("name") : nullptr;
+    const std::string* label = capture.FindString("label");
+    AddLabel(row,
+             base::UTF8ToUTF16((name && !name->empty() ? *name : "An app") +
+                               " is capturing " +
+                               (label ? *label : std::string("the screen"))),
+             kTitle);
+    const int id = capture.FindInt("id").value_or(0);
+    AddButton(row, u"Stop", base::BindRepeating([](int id) {
+                PlutoniumCapture::Get()->Stop(id);
+              }, id),
+              kButton, kTitle);
+  }
+  return view;
+}
+
+}  // namespace
+
+PlutoniumCaptureUi::PlutoniumCaptureUi() {
+  PlutoniumCapture::Get()->SetUi(this);
+}
+
+PlutoniumCaptureUi::~PlutoniumCaptureUi() {
+  PlutoniumCapture::Get()->SetUi(nullptr);
+}
+
+void PlutoniumCaptureUi::Pick(
+    const base::DictValue& request,
+    base::OnceCallback<void(std::optional<base::Value>)> done) {
+  // One at a time: the one open is refused.
+  if (done_) {
+    std::move(done_).Run(std::nullopt);
+  }
+  ClosePicker();
+  aura::Window* root = ash::Shell::HasInstance()
+                           ? ash::Shell::GetRootWindowForNewWindows()
+                           : nullptr;
+  if (!root) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  picking_ = request.FindInt("requestId").value_or(0);
+  done_ = std::move(done);
+
+  auto view = std::make_unique<PickerView>(
+      request, base::BindRepeating(&PlutoniumCaptureUi::OnPicked,
+                                   weak_factory_.GetWeakPtr(), picking_));
+  const gfx::Rect work_area =
+      display::Screen::Get()->GetDisplayNearestWindow(root).work_area();
+  const int width = std::min(kPickerWidth, work_area.width() * 9 / 10);
+  const int height =
+      std::min(view->GetHeightForWidth(width), work_area.height() * 9 / 10);
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.name = "PlutoniumCapturePicker";
+  params.parent =
+      ash::Shell::GetContainer(root, ash::kShellWindowId_OverlayContainer);
+  params.bounds = gfx::Rect(work_area.x() + (work_area.width() - width) / 2,
+                            work_area.y() + (work_area.height() - height) / 2,
+                            width, height);
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  picker_ = std::make_unique<views::Widget>(std::move(params));
+  picker_->SetContentsView(std::move(view));
+  picker_->Show();
+  picker_->Activate();
+  VLOG(1) << "EXO-CAPTURE Ash's picker asks (request #" << picking_ << ")";
+}
+
+void PlutoniumCaptureUi::CancelPick(int32_t request_id) {
+  if (picking_ != request_id) {
+    return;
+  }
+  done_.Reset();
+  ClosePicker();
+}
+
+void PlutoniumCaptureUi::OnPicked(int32_t request_id,
+                                  std::optional<base::Value> answer) {
+  if (picking_ != request_id || !done_) {
+    return;
+  }
+  ClosePicker();
+  std::move(done_).Run(std::move(answer));
+}
+
+void PlutoniumCaptureUi::ClosePicker() {
+  picking_ = 0;
+  if (!picker_) {
+    return;
+  }
+  // Not from inside one of the widget's own calls (a key or a click).
+  base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(picker_));
+  FocusShell();
+}
+
+void PlutoniumCaptureUi::ShowIndicator(
+    const std::vector<base::DictValue>& captures) {
+  if (captures.empty()) {
+    if (indicator_) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+          FROM_HERE, std::move(indicator_));
+    }
+    return;
+  }
+  aura::Window* root = ash::Shell::HasInstance()
+                           ? ash::Shell::GetPrimaryRootWindow()
+                           : nullptr;
+  if (!root) {
+    return;
+  }
+  if (!indicator_) {
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.name = "PlutoniumCaptureIndicator";
+    params.parent =
+        ash::Shell::GetContainer(root, ash::kShellWindowId_OverlayContainer);
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.activatable = views::Widget::InitParams::Activatable::kNo;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    indicator_ = std::make_unique<views::Widget>(std::move(params));
+  }
+  views::View* view = indicator_->SetContentsView(BuildIndicator(captures));
+  const gfx::Size size = view->GetPreferredSize();
+  const gfx::Rect work_area =
+      display::Screen::Get()->GetDisplayNearestWindow(root).work_area();
+  indicator_->SetBounds(gfx::Rect(work_area.right() - size.width() - 16,
+                                  work_area.y() + 16, size.width(),
+                                  size.height()));
+  indicator_->ShowInactive();
+}
