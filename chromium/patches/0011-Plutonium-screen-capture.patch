+// found in the LICENSE file.
+
+#ifndef COMPONENTS_EXO_WAYLAND_EXT_IMAGE_COPY_CAPTURE_H_
+#define COMPONENTS_EXO_WAYLAND_EXT_IMAGE_COPY_CAPTURE_H_
+
+#include <stdint.h>
+
+#include "base/functional/callback.h"
+
+struct wl_client;
+
+namespace exo::wayland {
+
+// PLUTONIUM (EXO-CAPTURE, docs/features/CAPTURE.md): ext-image-copy-capture-v1
+// with ext-image-capture-source-v1's output sources, for Wayland clients that
+// capture the screen themselves (grim). Each frame is a copy of the output's
+// root layer into the client's shared-memory buffer (XRGB8888 or ARGB8888).
+// No toplevel sources (Exo has no foreign toplevel
+// list) and no cursor: a cursor session's capture session stops at once.
+//
+// A session starts only once the embedder allows it: the same switches and
+// the same request to the user as other captures (ImageCaptureDelegate).
+// Without a delegate, sessions stop at once.
+class ImageCaptureDelegate {
+ public:
+  virtual ~ImageCaptureDelegate() = default;
+  // Whether client |pid| may capture display |display_id|: |done| gets the
+  // answer, maybe after asking the user. Returns a token for
+  // CancelOutputCapture().
+  virtual int32_t RequestOutputCapture(int32_t pid,
+                                       int64_t display_id,
+                                       base::OnceCallback<void(bool)> done) = 0;
+  // The client went away before the answer: stop asking (|done| isn't run).
+  virtual void CancelOutputCapture(int32_t token) = 0;
+  // A session runs; |stop| ends it (the user stopped it). Returns its id.
+  virtual int32_t OnCaptureStarted(int32_t pid,
+                                   int64_t display_id,
+                                   base::RepeatingClosure stop) = 0;
+  // The session |id| ended (the client destroyed it, or went away).
+  virtual void OnCaptureStopped(int32_t id) = 0;
+};
+
+// The embedder's (null: none). It must outlive the server, or be unset.
+void SetImageCaptureDelegate(ImageCaptureDelegate* delegate);
+
+void bind_output_image_capture_source_manager(wl_client* client,
+                                              void* data,
+                                              uint32_t version,
+                                              uint32_t id);
+void bind_image_copy_capture_manager(wl_client* client,
+                                     void* data,
+                                     uint32_t version,
+                                     uint32_t id);
+
+}  // namespace exo::wayland
+
+#endif  // COMPONENTS_EXO_WAYLAND_EXT_IMAGE_COPY_CAPTURE_H_
