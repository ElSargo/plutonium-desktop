+// EXO-CAPTURE (docs/features/CAPTURE.md): screenshots, screen sharing and
+// recording. One capture primitive in Ash, for three kinds of consumer:
+// shell pages (navigator.windowBroker), native apps through the desktop
+// portal (the helper, over the DevTools Plutonium domain) and tabs
+// (getDisplayMedia).
+//
+// Sources: an output (a display, by id, from the display list), a window
+// (exo::EmbeddedWindows' id; also while it's parked), a tab (PlutoniumTabs'
+// id), each with an optional region (in the source's pixels). A source is a
+// JSON object {type: "output" | "window" | "tab", id, region?: {x, y, width,
+// height}}.
+//
+// Requests: a consumer that needs the user to choose (the portal, a tab's
+// getDisplayMedia) asks the focused shell (FocusedShell()) with a cancelable
+// "capturerequest" event. If it doesn't take it, or goes away before
+// answering, Ash's own picker (Ui) asks. A request never hangs.
+//
+// Captures: every running capture goes to every shell ("capturestart",
+// "capturechange", "capturestop"), whatever started it, and any shell can
+// stop any of them. The focused shell is expected to show that something is
+// captured and to say so ("acknowledge"); if it hasn't within
+// kAcknowledgeDelay, Ash shows its own indicator (Ui::ShowIndicator()).
+//
+// Settings: two global switches, in local state (kSettingsPref), refuse
+// recording and screenshots to everyone: shells, the portal, tabs and
+// agents. Ash checks them here.
+class PlutoniumCapture : public PlutoniumShells::Observer,
+                         public exo::wayland::ImageCaptureDelegate {
+ public:
+  inline static constexpr char kSettingsPref[] = "plutonium.capture";
+  // How long the focused shell has to acknowledge a capture before Ash
+  // shows its own indicator.
+  static constexpr base::TimeDelta kAcknowledgeDelay = base::Seconds(2);
+
+  struct Source {
+    enum class Type { kOutput, kWindow, kTab };
+
+    Source();
+    Source(const Source&);
+    Source& operator=(const Source&);
+    ~Source();
+    bool operator==(const Source&) const;
+
+    // Null if |value| isn't a source.
+    static std::optional<Source> FromValue(const base::Value& value);
+    base::DictValue ToValue() const;
+
+    Type type = Type::kOutput;
+    // A display id, a window id or a tab id.
+    int64_t id = 0;
+    // In the source's pixels; empty: all of it.
+    gfx::Rect region;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnCaptureStarted(int32_t id, const base::DictValue& capture) {}
+    virtual void OnCaptureChanged(int32_t id, const base::DictValue& capture) {}
+    virtual void OnCaptureStopped(int32_t id, const base::DictValue& capture) {}
+    virtual void OnCaptureSettingsChanged(const base::DictValue& settings) {}
+  };
+
+  // Ash's own UI, for when the focused shell doesn't do it
+  // (chrome/browser/ui/ash/main_extra_parts/plutonium_capture_ui.h).
+  class Ui {
+   public:
+    virtual ~Ui() = default;
+    // Asks the user to choose for |request| (a "capturerequest" detail).
+    // |done| gets an answer, as a shell's ({sources: [...]}), or null if the
+    // user refused. One at a time: a new Pick() refuses the one open.
+    virtual void Pick(const base::DictValue& request,
+                      base::OnceCallback<void(std::optional<base::Value>)>
+                          done) = 0;
+    // Request |request_id| is over: put its picker away (|done| isn't run).
+    virtual void CancelPick(int32_t request_id) = 0;
+    // The captures no shell shows (empty: none), each time they change.
+    // Each gets a way to stop it (Stop()).
+    virtual void ShowIndicator(const std::vector<base::DictValue>& captures) = 0;
+  };
+
+  using CommandCallback =
+      base::OnceCallback<void(bool ok, const std::string& result_json)>;
+  using ScreenshotCallback =
+      base::OnceCallback<void(const SkBitmap& bitmap, const std::string& error)>;
+
+  static PlutoniumCapture* Get();
+  static void RegisterLocalStatePrefs(PrefRegistrySimple* registry);
+
