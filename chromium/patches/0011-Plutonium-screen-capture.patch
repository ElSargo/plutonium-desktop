+base::DictValue PlutoniumCapture::GetSettings() const {
+  bool recording = true;
+  bool screenshots = true;
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    const base::DictValue& settings = local_state->GetDict(kSettingsPref);
+    recording = settings.FindBool("recording").value_or(true);
+    screenshots = settings.FindBool("screenshots").value_or(true);
+  }
+  return base::DictValue()
+      .Set("recording", recording)
+      .Set("screenshots", screenshots);
+}
+
+base::expected<base::Value, std::string> PlutoniumCapture::SetSettings(
+    const base::DictValue& args) {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state) {
+    return base::unexpected("No settings");
+  }
+  base::DictValue settings = GetSettings();
+  for (const char* key : {"recording", "screenshots"}) {
+    if (std::optional<bool> value = args.FindBool(key)) {
+      settings.Set(key, *value);
+    }
+  }
+  local_state->SetDict(kSettingsPref, settings.Clone());
+  VLOG(1) << "EXO-CAPTURE settings " << settings.DebugString();
+  NotifySettings();
+  // Switching recording off ends what records now.
+  if (!recording_allowed()) {
+    std::vector<int32_t> ids;
+    for (const auto& [id, capture] : captures_) {
+      ids.push_back(id);
+    }
+    for (int32_t id : ids) {
+      Stop(id);
+    }
+  }
+  return base::Value(std::move(settings));
+}
+
+void PlutoniumCapture::NotifySettings() {
+  const base::DictValue settings = GetSettings();
+  for (Observer& observer : observers_) {
+    observer.OnCaptureSettingsChanged(settings);
+  }
+}
