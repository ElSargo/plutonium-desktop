+
+namespace exo::wayland {
+namespace {
+
+ImageCaptureDelegate* g_delegate = nullptr;
+
+// An output capture source: which display.
+struct CaptureSource {
+  int64_t display_id = 0;
+};
+
+class CaptureSession;
+
+////////////////////////////////////////////////////////////////////////////////
+// ext_image_copy_capture_frame_v1:
+
+// A frame the client asked for: its buffer, filled and announced once the
+// output's copy comes.
+class CaptureFrame {
+ public:
+  CaptureFrame(wl_resource* resource, base::WeakPtr<CaptureSession> session)
+      : resource_(resource), session_(std::move(session)) {}
+  CaptureFrame(const CaptureFrame&) = delete;
+  CaptureFrame& operator=(const CaptureFrame&) = delete;
+  ~CaptureFrame() { ForgetBuffer(); }
+
+  void AttachBuffer(wl_resource* buffer) {
+    ForgetBuffer();
+    buffer_ = buffer;
+    buffer_destroyed_.listener.notify = &CaptureFrame::OnBufferDestroyed;
+    buffer_destroyed_.frame = this;
+    wl_resource_add_destroy_listener(buffer, &buffer_destroyed_.listener);
+  }
+
+  void Capture();
+
+  void Fail(uint32_t reason) {
+    ext_image_copy_capture_frame_v1_send_failed(resource_, reason);
+    wl_client_flush(wl_resource_get_client(resource_));
+  }
+
+  // Writes |bitmap| into the buffer and says it's ready.
+  void OnCopied(const SkBitmap& bitmap);
+
+  base::WeakPtr<CaptureFrame> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  // The buffer went away before its copy: the listener comes first, so the
+  // listener's address is its struct's.
+  struct BufferListener {
+    wl_listener listener = {};
+    raw_ptr<CaptureFrame> frame = nullptr;
+  };
+
+  static void OnBufferDestroyed(wl_listener* listener, void* data) {
+    CaptureFrame* frame = reinterpret_cast<BufferListener*>(listener)->frame;
+    wl_list_remove(&frame->buffer_destroyed_.listener.link);
+    frame->buffer_ = nullptr;
+  }
+
+  void ForgetBuffer() {
+    if (buffer_) {
+      wl_list_remove(&buffer_destroyed_.listener.link);
+      buffer_ = nullptr;
+    }
+  }
+
+  const raw_ptr<wl_resource> resource_;
+  base::WeakPtr<CaptureSession> session_;
+  raw_ptr<wl_resource> buffer_ = nullptr;
+  BufferListener buffer_destroyed_;
+  bool captured_ = false;
+  base::WeakPtrFactory<CaptureFrame> weak_factory_{this};
+};
+
+////////////////////////////////////////////////////////////////////////////////
+// ext_image_copy_capture_session_v1:
+
+class CaptureSession {
+ public:
+  // |display_id| 0: a session that only stops (a cursor session's).
+  CaptureSession(wl_resource* resource, int64_t display_id)
+      : resource_(resource), display_id_(display_id) {}
+  CaptureSession(const CaptureSession&) = delete;
+  CaptureSession& operator=(const CaptureSession&) = delete;
+  ~CaptureSession() {
+    if (request_token_ && g_delegate) {
+      g_delegate->CancelOutputCapture(request_token_);
+    }
+    if (capture_id_ && g_delegate) {
+      g_delegate->OnCaptureStopped(capture_id_);
+    }
+  }
+
+  // Asks the embedder, then sends the buffer constraints, or stops.
+  void Start() {
+    if (!display_id_ || !g_delegate) {
+      // Not from inside the request that made it.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(&CaptureSession::Stop, weak_factory_.GetWeakPtr()));
+      return;
+    }
+    pid_t pid = 0;
+    wl_client_get_credentials(wl_resource_get_client(resource_), &pid, nullptr,
+                              nullptr);
+    pid_ = pid;
+    request_token_ = g_delegate->RequestOutputCapture(
+        pid_, display_id_,
+        base::BindOnce(&CaptureSession::OnAnswered,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void Stop() {
+    if (stopped_) {
+      return;
+    }
+    stopped_ = true;
+    active_ = false;
+    ext_image_copy_capture_session_v1_send_stopped(resource_);
+    wl_client_flush(wl_resource_get_client(resource_));
+  }
+
+  bool active() const { return active_; }
+  bool stopped() const { return stopped_; }
+  int64_t display_id() const { return display_id_; }
+  const gfx::Size& size() const { return size_; }
+
+  base::WeakPtr<CaptureSession> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  void OnAnswered(bool allowed) {
+    request_token_ = 0;
+    if (stopped_) {
+      return;
+    }
+    std::optional<display::Display> display;
+    for (const display::Display& candidate :
+         display::Screen::Get()->GetAllDisplays()) {
+      if (candidate.id() == display_id_) {
+        display = candidate;
+      }
+    }
+    if (!allowed || !display || !g_delegate) {
+      VLOG(1) << "EXO-CAPTURE ext-image-copy-capture refused for pid " << pid_;
+      Stop();
+      return;
+    }
+    size_ = display->GetSizeInPixel();
+    capture_id_ = g_delegate->OnCaptureStarted(
+        pid_, display_id_,
+        base::BindRepeating(&CaptureSession::Stop,
+                            weak_factory_.GetWeakPtr()));
+    active_ = true;
+    ext_image_copy_capture_session_v1_send_buffer_size(resource_, size_.width(),
+                                                       size_.height());
+    ext_image_copy_capture_session_v1_send_shm_format(resource_,
+                                                      WL_SHM_FORMAT_XRGB8888);
+    ext_image_copy_capture_session_v1_send_shm_format(resource_,
+                                                      WL_SHM_FORMAT_ARGB8888);
+    ext_image_copy_capture_session_v1_send_done(resource_);
+    wl_client_flush(wl_resource_get_client(resource_));
+  }
+
+  const raw_ptr<wl_resource> resource_;
+  const int64_t display_id_;
+  int32_t pid_ = 0;
+  // While the embedder asks.
+  int32_t request_token_ = 0;
+  int32_t capture_id_ = 0;
+  gfx::Size size_;
+  bool active_ = false;
+  bool stopped_ = false;
+  base::WeakPtrFactory<CaptureSession> weak_factory_{this};
+};
+
+void CaptureFrame::Capture() {
+  if (captured_) {
+    wl_resource_post_error(resource_,
+                           EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_ALREADY_CAPTURED,
+                           "capture sent twice");
+    return;
+  }
+  if (!buffer_) {
+    wl_resource_post_error(resource_,
+                           EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_NO_BUFFER,
+                           "no buffer attached");
+    return;
+  }
+  captured_ = true;
+  CaptureSession* session = session_.get();
+  if (!session || session->stopped()) {
+    Fail(EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_STOPPED);
+    return;
+  }
+  if (!session->active()) {
+    // Before the constraints: the client can't know the buffer is right.
+    Fail(EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_BUFFER_CONSTRAINTS);
+    return;
+  }
+  aura::Window* root =
+      ash::Shell::HasInstance()
+          ? ash::Shell::GetRootWindowForDisplayId(session->display_id())
+          : nullptr;
+  if (!root) {
+    Fail(EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_STOPPED);
+    return;
+  }
+  auto request = std::make_unique<viz::CopyOutputRequest>(
+      viz::CopyOutputRequest::ResultFormat::RGBA,
+      viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+      base::BindOnce(
+          [](base::WeakPtr<CaptureFrame> frame,
+             std::unique_ptr<viz::CopyOutputResult> result) {
+            if (!frame) {
+              return;
+            }
+            if (result->IsEmpty()) {
+              frame->Fail(
+                  EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_UNKNOWN);
+              return;
+            }
+            auto scoped = result->ScopedAccessSkBitmap();
+            frame->OnCopied(scoped.GetOutScopedBitmap());
+          },
+          GetWeakPtr()));
+  request->set_result_task_runner(
+      base::SequencedTaskRunner::GetCurrentDefault());
+  root->layer()->RequestCopyOfOutput(std::move(request));
+}
+
+void CaptureFrame::OnCopied(const SkBitmap& bitmap) {
+  Buffer* buffer = buffer_ ? GetUserDataAs<Buffer>(buffer_) : nullptr;
+  const gfx::GpuMemoryBufferHandle* handle =
+      buffer ? &buffer->gpu_memory_buffer_handle() : nullptr;
+  if (!handle || handle->type != gfx::SHARED_MEMORY_BUFFER ||
+      !handle->region().IsValid() || buffer->GetSize() !=
+                                         gfx::Size(bitmap.width(),
+                                                   bitmap.height())) {
+    Fail(EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_BUFFER_CONSTRAINTS);
+    return;
+  }
+  base::WritableSharedMemoryMapping mapping = handle->region().Map();
+  const size_t row_bytes = static_cast<size_t>(bitmap.width()) * 4;
+  const size_t needed =
+      handle->offset + static_cast<size_t>(handle->stride) *
+                           (bitmap.height() - 1) +
+      row_bytes;
+  if (!mapping.IsValid() || mapping.size() < needed ||
+      handle->stride < row_bytes) {
+    Fail(EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_BUFFER_CONSTRAINTS);
+    return;
+  }
+  // N32 is BGRA in memory: wl_shm's (A|X)RGB8888 little-endian.
+  uint8_t* pixels = mapping.GetMemoryAsSpan<uint8_t>().data() + handle->offset;
+  for (int y = 0; y < bitmap.height(); ++y) {
+    memcpy(pixels + static_cast<size_t>(handle->stride) * y,
+           bitmap.getAddr32(0, y), row_bytes);
+  }
+  const base::TimeDelta now = base::TimeTicks::Now() - base::TimeTicks();
+  const int64_t seconds = now.InSeconds();
+  const uint32_t nanoseconds =
+      static_cast<uint32_t>((now - base::Seconds(seconds)).InNanoseconds());
+  ext_image_copy_capture_frame_v1_send_transform(resource_,
+                                                 WL_OUTPUT_TRANSFORM_NORMAL);
+  ext_image_copy_capture_frame_v1_send_damage(resource_, 0, 0, bitmap.width(),
+                                              bitmap.height());
+  ext_image_copy_capture_frame_v1_send_presentation_time(
+      resource_, static_cast<uint32_t>(seconds >> 32),
+      static_cast<uint32_t>(seconds & 0xffffffff), nanoseconds);
+  ext_image_copy_capture_frame_v1_send_ready(resource_);
+  wl_client_flush(wl_resource_get_client(resource_));
+}
+
+void frame_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void frame_attach_buffer(wl_client* client,
+                         wl_resource* resource,
+                         wl_resource* buffer) {
+  GetUserDataAs<CaptureFrame>(resource)->AttachBuffer(buffer);
+}
+
+void frame_damage_buffer(wl_client* client,
+                         wl_resource* resource,
+                         int32_t x,
+                         int32_t y,
+                         int32_t width,
+                         int32_t height) {
+  // Every frame is copied whole.
+  if (x < 0 || y < 0 || width <= 0 || height <= 0) {
+    wl_resource_post_error(
+        resource, EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_INVALID_BUFFER_DAMAGE,
+        "invalid damage");
+  }
+}
+
+void frame_capture(wl_client* client, wl_resource* resource) {
+  GetUserDataAs<CaptureFrame>(resource)->Capture();
+}
+
+const struct ext_image_copy_capture_frame_v1_interface frame_implementation =
+    {frame_destroy, frame_attach_buffer, frame_damage_buffer, frame_capture};
+
+////////////////////////////////////////////////////////////////////////////////
+// ext_image_copy_capture_session_v1 requests:
+
+void session_create_frame(wl_client* client,
+                          wl_resource* resource,
+                          uint32_t id) {
+  wl_resource* frame_resource =
+      wl_resource_create(client, &ext_image_copy_capture_frame_v1_interface,
+                         wl_resource_get_version(resource), id);
+  SetImplementation(frame_resource, &frame_implementation,
+                    std::make_unique<CaptureFrame>(
+                        frame_resource,
+                        GetUserDataAs<CaptureSession>(resource)->GetWeakPtr()));
+}
+
+void session_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+const struct ext_image_copy_capture_session_v1_interface
+    session_implementation = {session_create_frame, session_destroy};
+
+wl_resource* CreateSession(wl_client* client,
+                           uint32_t version,
+                           uint32_t id,
+                           int64_t display_id) {
+  wl_resource* resource = wl_resource_create(
+      client, &ext_image_copy_capture_session_v1_interface, version, id);
+  SetImplementation(resource, &session_implementation,
+                    std::make_unique<CaptureSession>(resource, display_id));
+  GetUserDataAs<CaptureSession>(resource)->Start();
+  return resource;
+}
+
+////////////////////////////////////////////////////////////////////////////////
+// ext_image_copy_capture_cursor_session_v1 (no cursor: its session stops):
+
+void cursor_session_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void cursor_session_get_capture_session(wl_client* client,
+                                        wl_resource* resource,
+                                        uint32_t id) {
+  CreateSession(client, wl_resource_get_version(resource), id,
+                /*display_id=*/0);
+}
+
+const struct ext_image_copy_capture_cursor_session_v1_interface
+    cursor_session_implementation = {cursor_session_destroy,
+                                     cursor_session_get_capture_session};
+
+////////////////////////////////////////////////////////////////////////////////
+// ext_image_copy_capture_manager_v1:
+
+void manager_create_session(wl_client* client,
+                            wl_resource* resource,
+                            uint32_t id,
+                            wl_resource* source,
+                            uint32_t options) {
+  if (options & ~EXT_IMAGE_COPY_CAPTURE_MANAGER_V1_OPTIONS_PAINT_CURSORS) {
+    wl_resource_post_error(resource,
+                           EXT_IMAGE_COPY_CAPTURE_MANAGER_V1_ERROR_INVALID_OPTION,
+                           "invalid options 0x%x", options);
+    return;
+  }
+  CreateSession(client, wl_resource_get_version(resource), id,
+                GetUserDataAs<CaptureSource>(source)->display_id);
+}
+
+void manager_create_pointer_cursor_session(wl_client* client,
+                                           wl_resource* resource,
+                                           uint32_t id,
+                                           wl_resource* source,
+                                           wl_resource* pointer) {
+  wl_resource* cursor_resource = wl_resource_create(
+      client, &ext_image_copy_capture_cursor_session_v1_interface,
+      wl_resource_get_version(resource), id);
+  SetImplementation(cursor_resource, &cursor_session_implementation);
+}
+
+void manager_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+const struct ext_image_copy_capture_manager_v1_interface manager_implementation =
+    {manager_create_session, manager_create_pointer_cursor_session,
+     manager_destroy};
+
+////////////////////////////////////////////////////////////////////////////////
+// ext_output_image_capture_source_manager_v1:
+
+void source_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+const struct ext_image_capture_source_v1_interface source_implementation = {
+    source_destroy};
+
+void source_manager_create_source(wl_client* client,
+                                  wl_resource* resource,
+                                  uint32_t id,
+                                  wl_resource* output) {
+  auto source = std::make_unique<CaptureSource>();
+  if (auto* handler = GetUserDataAs<WaylandDisplayHandler>(output)) {
+    source->display_id = handler->id();
+  }
+  wl_resource* source_resource =
+      wl_resource_create(client, &ext_image_capture_source_v1_interface,
+                         wl_resource_get_version(resource), id);
+  SetImplementation(source_resource, &source_implementation,
+                    std::move(source));
+}
+
+void source_manager_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+const struct ext_output_image_capture_source_manager_v1_interface
+    source_manager_implementation = {source_manager_create_source,
+                                     source_manager_destroy};
+
+}  // namespace
+
+void SetImageCaptureDelegate(ImageCaptureDelegate* delegate) {
+  g_delegate = delegate;
+}
+
+void bind_output_image_capture_source_manager(wl_client* client,
+                                              void* data,
+                                              uint32_t version,
+                                              uint32_t id) {
+  wl_resource* resource = wl_resource_create(
+      client, &ext_output_image_capture_source_manager_v1_interface,
+      std::min(version, 1u), id);
+  SetImplementation(resource, &source_manager_implementation);
+}
+
+void bind_image_copy_capture_manager(wl_client* client,
+                                     void* data,
+                                     uint32_t version,
+                                     uint32_t id) {
+  wl_resource* resource = wl_resource_create(
+      client, &ext_image_copy_capture_manager_v1_interface,
+      std::min(version, 1u), id);
+  SetImplementation(resource, &manager_implementation);
+}
+
+}  // namespace exo::wayland
