+#ifdef UNSAFE_BUFFERS_BUILD
+// PLUTONIUM: rows copied into a client's shared-memory buffer.
+#pragma allow_unsafe_buffers
+#endif
+
+#include "components/exo/wayland/ext_image_copy_capture.h"
+
+#include <ext-image-capture-source-v1-server-protocol.h>
+#include <ext-image-copy-capture-v1-server-protocol.h>
+#include <wayland-server-core.h>
+#include <wayland-server-protocol-core.h>
+
+#include <algorithm>
+#include <cstring>
+#include <memory>
+#include <utility>
+
