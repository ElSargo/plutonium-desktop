+  }
   content::WebContents::CreateParams params(browser_context);
   params.initially_hidden = true;
   std::unique_ptr<content::WebContents> contents =
@@ -1078,7 +1093,8 @@ std::optional<PlutoniumTabs::TabInfo> PlutoniumTabs::CreateTab(
 
 std::optional<PlutoniumTabs::TabInfo> PlutoniumTabs::CreateAgentTab(
     const std::string& url,
-    const std::vector<std::string>& tags) {
+    const std::vector<std::string>& tags,
+    bool incognito) {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
   content::WebContents* shell = this->shell();
   if (!shell) {
@@ -1091,7 +1107,7 @@ std::optional<PlutoniumTabs::TabInfo> PlutoniumTabs::CreateAgentTab(
   }
   std::optional<TabInfo> tab =
       CreateTab(shell, url, tags.empty() ? std::string() : tags.front(),
-                "agent");
+                "agent", incognito);
   if (tab && tags.size() > 1) {
     UpdateTags(tab->id, std::vector<std::string>(tags.begin() + 1, tags.end()),
                {});
@@ -1508,6 +1524,34 @@ void PlutoniumTabs::RemoveTab(int32_t tab_id) {
   // (CloseContents): destroy it once that has returned.
   base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
                                                             std::move(tab));
+  // EXO-INCOGNITO: and then its profile, if it was the last incognito tab
+  // in it.
+  if (!incognito_profiles_.empty()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PlutoniumTabs::DestroyUnusedIncognitoProfiles,
+                       base::Unretained(this)));
+  }
+}
+
+void PlutoniumTabs::DestroyUnusedIncognitoProfiles() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::vector<base::WeakPtr<Profile>> kept;
+  for (base::WeakPtr<Profile>& profile : incognito_profiles_) {
+    if (!profile) {
+      continue;
+    }
+    bool used = false;
+    for (const auto& [id, tab] : tabs_) {
+      used = used || tab->contents()->GetBrowserContext() == profile.get();
+    }
+    if (used) {
+      kept.push_back(std::move(profile));
+    } else {
+      ProfileDestroyer::DestroyOTRProfileWhenAppropriate(profile.get());
+    }
+  }
+  incognito_profiles_ = std::move(kept);
 }
 
 void PlutoniumTabs::TabChanged(Tab* tab) {
