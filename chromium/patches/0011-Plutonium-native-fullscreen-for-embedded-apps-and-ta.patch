+namespace plutonium_keys {
+
+namespace {
+
+// The modifiers shortcuts are made of, as ui::EventFlags.
+constexpr int kModifiers = ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+                           ui::EF_SHIFT_DOWN | ui::EF_COMMAND_DOWN;
+
+struct Shortcut {
+  ui::DomCode code;
+  int modifiers;
+  auto operator<=>(const Shortcut&) const = default;
+};
+
+std::set<Shortcut>& ShellShortcuts() {
+  static base::NoDestructor<std::set<Shortcut>> shortcuts;
+  return *shortcuts;
+}
+
+std::optional<Shortcut> ParseShortcut(const std::string& text) {
+  std::vector<std::string> parts = base::SplitString(
+      text, "+", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (parts.empty()) {
+    return std::nullopt;
+  }
+  Shortcut shortcut{ui::DomCode::NONE, 0};
+  for (size_t i = 0; i + 1 < parts.size(); ++i) {
+    const std::string& part = parts[i];
+    if (part == "Ctrl" || part == "Control") {
+      shortcut.modifiers |= ui::EF_CONTROL_DOWN;
+    } else if (part == "Alt") {
+      shortcut.modifiers |= ui::EF_ALT_DOWN;
+    } else if (part == "Shift") {
+      shortcut.modifiers |= ui::EF_SHIFT_DOWN;
+    } else if (part == "Super" || part == "Meta") {
+      shortcut.modifiers |= ui::EF_COMMAND_DOWN;
+    } else {
+      return std::nullopt;
+    }
+  }
+  shortcut.code = ui::KeycodeConverter::CodeStringToDomCode(parts.back());
+  if (shortcut.code == ui::DomCode::NONE) {
+    return std::nullopt;
+  }
+  return shortcut;
+}
+
+bool IsShellShortcut(ui::DomCode code, int flags) {
+  return ShellShortcuts().contains(Shortcut{code, flags & kModifiers});
+}
+
+bool IsToggleFullscreen(const ui::KeyEvent& event) {
+  return event.key_code() == ui::VKEY_F &&
+         (event.flags() & kModifiers) == ui::EF_COMMAND_DOWN;
+}
+
+class HandlerImpl : public Handler, public ui::EventHandler {
+ public:
+  HandlerImpl() {
+    ash::Shell::Get()->AddPreTargetHandler(this,
+                                           ui::EventTarget::Priority::kSystem);
+  }
+  ~HandlerImpl() override {
+    if (ash::Shell::HasInstance()) {
+      ash::Shell::Get()->RemovePreTargetHandler(this);
+    }
+  }
+
+  // ui::EventHandler:
+  void OnKeyEvent(ui::KeyEvent* event) override {
+    const ui::DomCode code = event->code();
+    const bool pressed = event->type() == ui::EventType::kKeyPressed;
+    if (!pressed) {
+      // A release goes where its press went.
+      if (consumed_.erase(code)) {
+        event->StopPropagation();
+      } else if (to_shell_.erase(code)) {
+        MarkForShell(event);
+      }
+      return;
+    }
+    if (IsToggleFullscreen(*event)) {
+      consumed_.insert(code);
+      event->StopPropagation();
+      if (!event->is_repeat()) {
+        ToggleFullscreen();
+      }
+      return;
+    }
+    // Keys for an embedded window: its keyboard sends them to the app
+    // unless they are the shell's. (Keys for a tab go through
+    // PlutoniumTabs.)
+    if (exo::EmbeddedWindows::Get()->focused_window_id() &&
+        IsShellShortcut(code, event->flags())) {
+      to_shell_.insert(code);
+      MarkForShell(event);
+    }
+  }
+
+ private:
+  static void MarkForShell(ui::KeyEvent* event) {
+    ui::Event::Properties properties =
+        event->properties() ? *event->properties() : ui::Event::Properties();
+    properties.emplace(exo::kShellKeyEventKey, std::vector<uint8_t>());
+    event->SetProperties(properties);
+  }
+
+  // Keys whose press was taken here, or sent to the shell.
+  std::set<ui::DomCode> consumed_;
+  std::set<ui::DomCode> to_shell_;
+};
+
+}  // namespace
+
+std::unique_ptr<Handler> Install() {
+  return std::make_unique<HandlerImpl>();
+}
+
+void SetShellShortcuts(const std::vector<std::string>& shortcuts) {
+  std::set<Shortcut>& set = ShellShortcuts();
+  set.clear();
+  for (const std::string& text : shortcuts) {
+    if (std::optional<Shortcut> shortcut = ParseShortcut(text)) {
+      set.insert(*shortcut);
+    } else {
+      VLOG(1) << "EXO-KEYS ignoring shell shortcut \"" << text << "\"";
+    }
+  }
+  VLOG(1) << "EXO-KEYS the shell handles " << set.size() << " shortcuts";
+}
+
+bool IsShellShortcut(const input::NativeWebKeyboardEvent& event) {
+  int flags = 0;
+  const int modifiers = event.GetModifiers();
+  if (modifiers & blink::WebInputEvent::kControlKey) {
+    flags |= ui::EF_CONTROL_DOWN;
+  }
+  if (modifiers & blink::WebInputEvent::kAltKey) {
+    flags |= ui::EF_ALT_DOWN;
+  }
+  if (modifiers & blink::WebInputEvent::kShiftKey) {
+    flags |= ui::EF_SHIFT_DOWN;
+  }
+  if (modifiers & blink::WebInputEvent::kMetaKey) {
+    flags |= ui::EF_COMMAND_DOWN;
+  }
+  return IsShellShortcut(static_cast<ui::DomCode>(event.dom_code), flags);
+}
+
+void ToggleFullscreen() {
+  ExoEmbedder* embedder = ExoEmbedder::Get();
+  if (int32_t window_id = exo::EmbeddedWindows::Get()->focused_window_id();
+      window_id && embedder && embedder->ToggleFullscreen(window_id)) {
+    VLOG(1) << "EXO-FULLSCREEN toggled window #" << window_id;
+    return;
+  }
+  if (PlutoniumTabs::Get()->ToggleFocusedTabFullscreen()) {
+    return;
+  }
+  // Neither has focus (e.g. the shell page has): only leaving fullscreen
+  // makes sense.
+  if (!(embedder && embedder->ExitFullscreen())) {
+    PlutoniumTabs::Get()->ExitFullscreen();
+  }
+}
