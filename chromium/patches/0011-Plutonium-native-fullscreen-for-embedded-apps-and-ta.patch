+#ifndef CHROME_BROWSER_PLUTONIUM_KEYS_H_
+#define CHROME_BROWSER_PLUTONIUM_KEYS_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace input {
+struct NativeWebKeyboardEvent;
+}
+
+// EXO-KEYS: keys the Plutonium browser handles, whatever has keyboard focus
+// (the shell page, an embedded window or a tab).
+//
+//   Super+F  toggles fullscreen for the focused embedded window or tab
+//            (EXO-FULLSCREEN): the element showing it becomes the shell
+//            document's fullscreen element, so the app or page is resized
+//            to the whole screen. With neither focused, it leaves
+//            fullscreen if an element is fullscreen.
+//
+// And the shell's own shortcuts (WindowBroker.SetShellShortcuts): while an
+// embedded window or a tab has keyboard focus, a matching key press goes to
+// the shell page as an ordinary key event instead of the app or page. For
+// windows that happens in the handler installed here (the keyboard then
+// leaves the event to the page, see exo::kShellKeyEventKey); for tabs, in
+// the tab's WebContentsDelegate (PlutoniumTabs), which gets their keys
+// first.
+namespace plutonium_keys {
+
+// Installs the key handler on Ash's shell (ExoParts owns the result).
+class Handler {
+ public:
+  virtual ~Handler() = default;
+};
+std::unique_ptr<Handler> Install();
+
+// Replaces the shell's shortcuts. Each is "[Ctrl+][Alt+][Shift+][Super+]
+// <code>", <code> a KeyboardEvent.code value; invalid entries are dropped.
+void SetShellShortcuts(const std::vector<std::string>& shortcuts);
+
+// Whether |event| (a key press or release) is one of the shell's shortcuts.
+bool IsShellShortcut(const input::NativeWebKeyboardEvent& event);
+
+// What Super+F does.
+void ToggleFullscreen();
+
+}  // namespace plutonium_keys
+
+#endif  // CHROME_BROWSER_PLUTONIUM_KEYS_H_
