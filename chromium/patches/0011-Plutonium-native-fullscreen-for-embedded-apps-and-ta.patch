+bool ExoEmbedder::ToggleFullscreen(int32_t window_id) {
+  NativeWindowHostImpl* target = nullptr;
+  for (NativeWindowHostImpl* host : base::Reversed(Hosts())) {
+    if (host->window_id() != window_id) {
+      continue;
+    }
+    if (host->fullscreen()) {
+      host->SetElementFullscreen(false);
+      return true;
+    }
+    if (!target) {
+      target = host;
+    }
+  }
+  if (!target) {
+    return false;
+  }
+  target->SetElementFullscreen(true);
+  return true;
+}
+
+bool ExoEmbedder::ExitFullscreen() {
+  bool any = false;
+  for (NativeWindowHostImpl* host : Hosts()) {
+    if (host->fullscreen()) {
+      host->SetElementFullscreen(false);
+      any = true;
+    }
+  }
+  return any;
+}
