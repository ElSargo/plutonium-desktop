   if (IsDragDropInProgress() && event->key_code() == ui::VKEY_ESCAPE) {
     DragCancel();
     event->StopPropagation();
+    return;
+  }
+  if (!IsDragDropInProgress() || !sticky_) {
+    return;
+  }
+  // The keyboard is the drag's while it rides on the pointer.
+  event->StopPropagation();
+  if (event->type() != ui::EventType::kKeyPressed) {
+    return;
+  }
+  const int step = event->IsShiftDown() ? kStickyBigStep : kStickyStep;
+  gfx::Vector2d delta;
+  switch (event->key_code()) {
+    case ui::VKEY_H:
+    case ui::VKEY_LEFT:
+      delta.set_x(-step);
+      break;
+    case ui::VKEY_L:
+    case ui::VKEY_RIGHT:
+      delta.set_x(step);
+      break;
+    case ui::VKEY_K:
+    case ui::VKEY_UP:
+      delta.set_y(-step);
+      break;
+    case ui::VKEY_J:
+    case ui::VKEY_DOWN:
+      delta.set_y(step);
+      break;
+    case ui::VKEY_RETURN:
+    case ui::VKEY_SPACE:
+      // Not from inside this event's dispatch.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&DragDropController::StickyDrop,
+                                    weak_factory_.GetWeakPtr()));
+      return;
+    default:
+      return;
   }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&DragDropController::StickyMove,
+                                weak_factory_.GetWeakPtr(), delta));
+}
+
+void DragDropController::StickyMove(gfx::Vector2d delta) {
+  if (!IsDragDropInProgress() || !sticky_) {
+    return;
+  }
+  const gfx::Point point =
+      display::Screen::Get()->GetCursorScreenPoint() + delta;
+  aura::Window* root = window_util::GetRootWindowAt(point);
+  gfx::Point in_root = point;
+  wm::ConvertPointFromScreen(root, &in_root);
+  root->MoveCursorTo(in_root);
+  SendStickyMouseEvent(ui::EventType::kMouseMoved, ui::EF_NONE);
+}
+
+void DragDropController::StickyDrop() {
+  if (!IsDragDropInProgress() || !sticky_) {
+    return;
+  }
+  SendStickyMouseEvent(ui::EventType::kMousePressed, ui::EF_LEFT_MOUSE_BUTTON);
+}
+
+void DragDropController::SendStickyMouseEvent(ui::EventType type, int flags) {
+  const gfx::Point point = display::Screen::Get()->GetCursorScreenPoint();
+  aura::Window* root = window_util::GetRootWindowAt(point);
+  gfx::Point in_root = point;
+  wm::ConvertPointFromScreen(root, &in_root);
+  // An event from the source is in the host's pixels.
+  gfx::Point in_host = root->GetHost()->GetRootTransform().MapPoint(in_root);
+  ui::MouseEvent event(type, in_host, in_host, ui::EventTimeForNow(), flags,
+                       flags);
+  // The controller is a pre-target handler: it sees this as any mouse event.
+  std::ignore = root->GetHost()->GetEventSink()->OnEventFromSource(&event);
 }
 
