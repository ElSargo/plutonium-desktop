     return;
   }
   // Surface id and geometry origin churn every frame or resize; only report
@@ -341,7 +349,28 @@ void ExoWindowBroker::UpdateWindow(int32_t window_id) {
   }
   it->second = window;
   VLOG(1) << "EXO-BROKER window changed: " << Describe(window);
-  for (Observer& observer : observers_) {
-    observer.OnWindowChanged(window);
+  Notify(base::BindRepeating(
+      [](const WindowInfo& window, Observer& observer) {
+        observer.OnWindowChanged(window);
+      },
+      window));
+}
+
+void ExoWindowBroker::Notify(base::RepeatingCallback<void(Observer&)> event) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  pending_events_.push_back(std::move(event));
+  // An event an observer causes (an element detaching from a revoked grant
+  // changes the window) waits until the current one has reached everyone.
+  if (notifying_) {
+    return;
+  }
+  base::AutoReset<bool> notifying(&notifying_, true);
+  while (!pending_events_.empty()) {
+    base::RepeatingCallback<void(Observer&)> next =
+        std::move(pending_events_.front());
+    pending_events_.pop_front();
+    for (Observer& observer : observers_) {
+      next.Run(observer);
+    }
   }
 }
