+#include "base/values.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "ui/aura/window_tracker.h"
+#include "url/gurl.h"
+
+class Profile;
+class SkBitmap;
+struct NavigateParams;
+
+namespace input {
+struct NativeWebKeyboardEvent;
+}
+
+namespace content {
+class BrowserContext;
+class NavigationHandle;
+class WebContents;
+}  // namespace content
+
+// EXO-TABS: the shell's browser tabs.
+//
+// A tab is a real web page: its own WebContents in the shell's profile,
+// shown in the shell page through SurfaceEmbed
+// (<embed type="application/x-chromium-surface-embed" data-content-id=…>).
+// The registry owns the tabs. They don't belong to any shell document: they
+// survive a shell reload and close when the page closes itself, the shell
+// closes them, or their profile goes away.
+//
+// The shell creates tabs (CreateTab) and drives them (Navigate, Command).
+// A tab's page can open more tabs (window.open, target=_blank, a middle
+// click); those are registered here too, with the opener's tag, and reported
+// to observers like any other. What to show, and where, is up to the shell.
+class PlutoniumTabs : public ProfileObserver {
+ public:
+  // What the registry knows about a tab. Changes to anything here are
+  // reported through Observer::OnTabChanged().
+  struct TabInfo {
+    TabInfo();
+    TabInfo(const TabInfo&);
+    TabInfo& operator=(const TabInfo&);
+    ~TabInfo();
+    bool operator==(const TabInfo&) const;
+
+    // Stable for the tab's lifetime and never reused. Not a capability.
+    int32_t id = 0;
+    // The SurfaceEmbedHandle id an <embed> attaches with.
+    base::UnguessableToken content_id;
+    GURL url;
+    std::u16string title;
+    bool loading = false;
+    bool can_go_back = false;
+    bool can_go_forward = false;
+    bool embedded = false;
+    bool focused = false;
+    // EXO-PRESENT: shown on its own, outside every shell (Present()).
+    bool presented = false;
+    // EXO-TAGS: the tag it was created with (its opener's, for tabs a page
+    // opened), or empty. Never changes.
+    std::string tag;
+    // |tag| (if any) first, then the tags shells and the browser added (a
+    // page's new tabs start with its opener's).
+    std::vector<std::string> tags;
+    int32_t opener_id = 0;
+    // "shell", "shell:<shell id>" (a link a shell page opened), "page",
+    // "devtools" (EXO-CHROME: the DevTools of tab |opener_id|) or "agent"
+    // (EXO-AGENT: CreateAgentTab()).
+    std::string opened_by;
+    // EXO-INCOGNITO: in a throwaway off-the-record profile of its own
+    // (CreateTab(..., incognito)), shared only with the tabs its page opens.
+    bool incognito = false;
+    // The dialog the page waits on ("alert", "confirm", "prompt",
+    // "beforeunload"), or empty.
+    std::string dialog_type;
+    std::u16string dialog_message;
+    std::u16string dialog_default_prompt;
+    // EXO-TAB-FEATURES: what the tab's features report (SetTabState()), a
+    // JSON object, e.g. {"zoom": 110, "zoomDefault": false, "pending": {…}}.
+    std::string state_json = "{}";
+  };
+
+  enum class Command { kBack, kForward, kReload, kStop, kClose };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnTabAdded(const TabInfo& tab) {}
+    virtual void OnTabChanged(const TabInfo& tab) {}
+    virtual void OnTabRemoved(int32_t tab_id) {}
+  };
+
+  // Created on first use; lives until the browser exits.
+  static PlutoniumTabs* Get();
+
+  PlutoniumTabs(const PlutoniumTabs&) = delete;
+  PlutoniumTabs& operator=(const PlutoniumTabs&) = delete;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  std::vector<TabInfo> GetTabs() const;
+  // Whether |contents| is one of the tabs. A tab is never the shell, even
+  // if it shows the shell's URL.
+  bool IsTab(const content::WebContents* contents) const;
+  std::optional<TabInfo> GetTab(int32_t tab_id) const;
+  // Tab |tab_id|'s page (the shells overlay opens its DevTools), or null.
+  content::WebContents* GetContents(int32_t tab_id) const;
+  // The tab |contents| is, if it is one.
+  std::optional<TabInfo> GetTabFor(const content::WebContents* contents) const;
+
+  // EXO-CHROME: |devtools| (owned by its DevToolsWindow) is the DevTools of
+  // tab |inspected|: it becomes a tab too, with |inspected|'s tags, opened by
+  // "devtools", so the shell shows it beside it. It goes when DevTools closes;
+  // closing the tab closes DevTools. It can't be navigated or automated.
+  void AddDevToolsTab(content::WebContents* devtools,
+                      content::WebContents* inspected);
+  // Asks the visible shell to show the tab |contents| is
+  // ("tabfocusrequest").
+  void RequestShow(content::WebContents* contents);
+  // EXO-KEYS: sends |event| to the visible shell's page if it is one of its
+  // shortcuts (plutonium_keys.h); true if it did.
+  bool ForwardShellShortcut(const input::NativeWebKeyboardEvent& event);
+
+  // The URL CreateTab() and Navigate() would load for |text|, or an invalid
+  // GURL if they would refuse it.
+  static GURL ToLoadableUrl(const std::string& text);
+
+  // Opens a tab at |url| in |shell|'s profile, or with |incognito| in a new
+  // off-the-record profile that goes when its last tab does. Nullopt if the
+  // URL isn't loadable.
+  std::optional<TabInfo> CreateTab(content::WebContents* shell,
+                                   const std::string& url,
+                                   const std::string& tag,
+                                   const std::string& opened_by = "shell",
+                                   bool incognito = false);
+  // EXO-AGENT: opens a tab for the helper (the DevTools Plutonium domain), in
+  // the shells' profile, opened by "agent". |tags| starts with its origin
+  // tag. Nullopt if the URL isn't loadable or there is no shell yet.
+  std::optional<TabInfo> CreateAgentTab(const std::string& url,
+                                        const std::vector<std::string>& tags,
+                                        bool incognito = false);
+  bool Navigate(int32_t tab_id, const std::string& url);
+  // PLUTONIUM: in shell mode, a shell page's new tab or window (Ctrl+click,
+  // middle click, target=_blank, window.open) becomes one of these tabs
+  // instead of a Chrome window. It starts untagged, opened by
+  // "shell:<shell id>": that shell puts it in its current thread. False if
+  // |params| isn't such a navigation (chrome::Navigate() goes on).
+  static bool MaybeOpenFromShell(
+      NavigateParams* params,
+      base::WeakPtr<content::NavigationHandle>* handle);
+  // EXO-TAGS: adds |add| to and takes |remove| out of the tab's tags (not
+  // its origin tag). False if there is no such tab.
+  bool UpdateTags(int32_t tab_id,
+                  const std::vector<std::string>& add,
+                  const std::vector<std::string>& remove);
+  void RunCommand(int32_t tab_id, Command command);
+
+  // EXO-TAB-FEATURES (TAB_FEATURES.md): the features the registry's tabs get
+  // in place of a Browser's: find, zoom, printing, permissions, file pickers,
+  // downloads. Each attaches its WebContents helpers in Tab::AttachHelpers()
+  // and adds its commands in the constructor, one line each.
+  //
+  // A command beyond back, forward, reload, stop and close, which shells
+  // (tabCommand()), agents (Plutonium.tabCommand) and keys
+  // (plutonium_keys::GetTabCommandKey()) run, such as "zoom-in" or "find".
+  // |done| gets the result (base::Value() for none), or nullopt if it failed.
+  using CommandCallback =
+      base::OnceCallback<void(std::optional<base::Value> result)>;
+  using CommandHandler =
+      base::RepeatingCallback<void(content::WebContents* contents,
+                                   const base::DictValue& args,
+                                   CommandCallback done)>;
+  // Adds (or replaces) command |name|. Not for borrowed pages (DevTools').
+  void AddCommand(const std::string& name, CommandHandler handler);
+  bool HasCommand(const std::string& name) const;
+  // Runs command |name| (a built-in one or a feature's) with |args_json| (a
+  // JSON object, or empty) on |tab_id|. |done| gets (true, the result as
+  // JSON) or (false, why not).
+  void RunNamedCommand(int32_t tab_id,
+                       const std::string& name,
+                       const std::string& args_json,
+                       base::OnceCallback<void(bool, const std::string&)> done);
+  // Sets the tab's state |key| (a feature's, such as "zoom") to |value|, or
+  // removes it if |value| is none. Every shell and agent gets the change
+  // (OnTabChanged(), TabInfo::state_json). Ignored if |contents| isn't a tab.
+  void SetTabState(content::WebContents* contents,
+                   const std::string& key,
+                   base::Value value);
+  // Answers the tab's pending dialog, if any.
+  void AnswerDialog(int32_t tab_id,
+                    bool accept,
+                    const std::u16string& prompt_text);
+  // (success, result as JSON or an error message).
+  using DevToolsCallback =
+      base::OnceCallback<void(bool, const std::string&)>;
+  // Sends DevTools protocol command |method| with |params_json| (a JSON
+  // object, or empty) to |tab_id|. Only page domains (Runtime, Input, Page,
+  // DOM, Accessibility, Emulation, Log, Network) are allowed.
+  void SendDevToolsCommand(int32_t tab_id,
+                           const std::string& method,
+                           const std::string& params_json,
+                           DevToolsCallback callback);
+  // What |tab_id| shows, even while hidden. Empty bitmap on failure.
+  void Snapshot(int32_t tab_id,
+                base::OnceCallback<void(const SkBitmap&)> callback);
+
+  // EXO-PRESENT: a tab shown on its own, fullscreen, outside every shell
+  // (the switcher's "Open fullscreen"): the same page, not a copy of it. No
+  // <embed> shows it meanwhile; afterwards the ones that want it take it back.
+  // Ash shows it (SetPresenter()).
+  class Presenter {
+   public:
+    virtual ~Presenter() = default;
+    // Shows |contents|, which no <embed> has.
+    virtual void Present(content::WebContents* contents) = 0;
+    // Lets go of what it shows.
+    virtual void EndPresentation() = 0;
+  };
+  void SetPresenter(Presenter* presenter);
+  // False if there is no such tab or no presenter.
+  bool Present(int32_t tab_id);
+  void EndPresentation();
+  int32_t presented_tab_id() const { return presented_tab_id_; }
+
+  // EXO-FULLSCREEN: toggles fullscreen for the <embed> showing the focused
+  // tab (see plutonium_keys.h). False if no shown tab has focus.
+  bool ToggleFocusedTabFullscreen();
+  // Takes every tab's <embed> out of fullscreen; false if none was.
+  bool ExitFullscreen();
+
+  // The shell page tabs were last created from, or in shell mode the
+  // visible shell's (where EXO-KEYS sends the shell's shortcuts), or null.
+  content::WebContents* shell() const;
+  // EXO-SHELLS: |shell| is the visible shell now. Tabs no <embed> shows
+  // move to its window.
+  void SetShell(content::WebContents* shell);
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+ private:
+  class Tab;
+  class ShellObserver;
+  friend class Tab;
+  friend class base::NoDestructor<PlutoniumTabs>;
+
+  PlutoniumTabs();
+  ~PlutoniumTabs() override;
+
+  // Registers |contents| as a new tab and tells observers.
+  Tab* AddTab(std::unique_ptr<content::WebContents> contents,
+              const std::string& tag,
+              const std::vector<std::string>& tags,
+              int32_t opener_id,
+              const std::string& opened_by);
+  // The same for a page someone else owns (|owned| null) or the tab owns.
+  Tab* AddTab(std::unique_ptr<content::WebContents> owned,
+              content::WebContents* borrowed,
+              const std::string& tag,
+              const std::vector<std::string>& tags,
+              int32_t opener_id,
+              const std::string& opened_by);
+  // Destroys tab |tab_id| (later, if a call into it is on the stack).
+  void RemoveTab(int32_t tab_id);
+  void TabChanged(Tab* tab);
+  void RefreshAll();
+  Tab* FindTab(int32_t tab_id) const;
+  Tab* FindTab(const content::WebContents* contents) const;
+  // EXO-FULLSCREEN: an <embed> showing |contents| entered or left
+  // fullscreen.
+  void OnEmbedFullscreenChanged(content::WebContents* contents,
+                                bool fullscreen);
+
+  // Where tabs that no <embed> shows keep their (hidden) view: the shell's
+  // top-level window. A view outside any window tree has no compositor, so
+  // its page never paints, not even for a snapshot.
+  aura::Window* parking() const;
+
+  aura::WindowTracker parking_;
+  raw_ptr<Presenter> presenter_ = nullptr;
+  int32_t presented_tab_id_ = 0;
+  std::unique_ptr<ShellObserver> shell_observer_;
+  int32_t next_id_ = 1;
+  std::map<int32_t, std::unique_ptr<Tab>> tabs_;
+  // EXO-TAB-FEATURES: the features' commands, by name.
+  std::map<std::string, CommandHandler> commands_;
+  base::ObserverList<Observer> observers_;
+  base::ScopedMultiSourceObservation<Profile, ProfileObserver>
+      profile_observations_{this};
+  // EXO-INCOGNITO: the profiles incognito tabs were opened in; each is
+  // destroyed once no tab uses it (DestroyUnusedIncognitoProfiles()).
+  std::vector<base::WeakPtr<Profile>> incognito_profiles_;
+  void DestroyUnusedIncognitoProfiles();
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+#endif  // CHROME_BROWSER_PLUTONIUM_TABS_H_
