@@ -0,0 +1,298 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/plutonium_tab_requests.h"
+
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/plutonium_shell.h"
+#include "chrome/browser/plutonium_shells.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/mojom/native_window/window_broker.mojom.h"
+#include "ui/aura/window.h"
+
+PlutoniumTabRequests::Params::Params() = default;
+PlutoniumTabRequests::Params::Params(Params&&) = default;
+PlutoniumTabRequests::Params& PlutoniumTabRequests::Params::operator=(
+    Params&&) = default;
+PlutoniumTabRequests::Params::~Params() = default;
+
+PlutoniumTabRequests::Request::Request() = default;
+PlutoniumTabRequests::Request::~Request() = default;
+
+PlutoniumTabRequests::Handle::Handle(int32_t id) : id_(id) {}
+
+PlutoniumTabRequests::Handle::~Handle() {
+  PlutoniumTabRequests::Get()->Cancel(id_);
+}
+
+bool PlutoniumTabRequests::Handle::is_open() const {
+  return PlutoniumTabRequests::Get()->requests_.contains(id_);
+}
+
+PlutoniumTabRequests::PlutoniumTabRequests() {
+  tabs_observation_.Observe(PlutoniumTabs::Get());
+}
+
+PlutoniumTabRequests::~PlutoniumTabRequests() = default;
+
+// static
+PlutoniumTabRequests* PlutoniumTabRequests::Get() {
+  static base::NoDestructor<PlutoniumTabRequests> instance;
+  return instance.get();
+}
+
+// static
+content::WebContents* PlutoniumTabRequests::ShellFor(
+    content::WebContents* contents) {
+  PlutoniumTabs* tabs = PlutoniumTabs::Get();
+  // An attached tab's view is in its embedder's window. (Only the visible
+  // shell's <embed>s attach today; with a visible shell per display, this
+  // is the one on the tab's display.)
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  if (shells && contents && contents->GetSurfaceEmbedConnector()) {
+    aura::Window* window = contents->GetTopLevelNativeWindow();
+    for (const PlutoniumShells::Shell& shell : shells->GetShells()) {
+      content::WebContents* page = shells->GetContents(shell.id);
+      if (window && page && page->GetTopLevelNativeWindow() == window) {
+        return page;
+      }
+    }
+  }
+  // Hidden or presented: the visible (focused) shell.
+  return tabs->shell();
+}
+
+std::unique_ptr<PlutoniumTabRequests::Handle> PlutoniumTabRequests::Start(
+    content::WebContents* contents,
+    Params params) {
+  std::optional<PlutoniumTabs::TabInfo> tab =
+      PlutoniumTabs::Get()->GetTabFor(contents);
+  if (!tab) {
+    return nullptr;
+  }
+  auto request = std::make_unique<Request>();
+  const int32_t id = next_id_++;
+  request->id = id;
+  request->tab_id = tab->id;
+  request->kind = std::move(params.kind);
+  request->detail = std::move(params.detail);
+  request->on_answer = std::move(params.on_answer);
+  request->on_fallback = std::move(params.on_fallback);
+
+  auto mojo_request = blink::mojom::TabRequest::New();
+  mojo_request->id = id;
+  mojo_request->tab_id = tab->id;
+  mojo_request->kind = request->kind;
+  base::JSONWriter::Write(request->detail, &mojo_request->detail_json);
+  VLOG(1) << "EXO-TAB-FEATURES request #" << id << " (" << request->kind
+          << ") for tab #" << tab->id;
+  requests_[id] = std::move(request);
+  UpdatePending(tab->id);
+
+  content::WebContents* shell = ShellFor(contents);
+  const bool asked =
+      shell && plutonium_shell::SendTabRequest(
+                   shell, std::move(mojo_request),
+                   base::BindOnce(&PlutoniumTabRequests::OnTaken,
+                                  base::Unretained(this), id));
+  if (!asked) {
+    VLOG(1) << "EXO-TAB-FEATURES request #" << id
+            << ": no shell listens, falling back";
+    FallBack(id, FallbackReason::kNotTaken);
+  }
+  return std::make_unique<Handle>(id);
+}
+
+void PlutoniumTabRequests::OnTaken(int32_t id, int32_t taker) {
+  auto it = requests_.find(id);
+  if (it == requests_.end()) {
+    // Over already (cancelled meanwhile): the shell may show it now.
+    if (taker) {
+      plutonium_shell::EndTabRequest(taker, id);
+    }
+    return;
+  }
+  if (!taker) {
+    VLOG(1) << "EXO-TAB-FEATURES request #" << id
+            << ": the shell didn't take it, falling back";
+    FallBack(id, FallbackReason::kNotTaken);
+    return;
+  }
+  it->second->taker = taker;
+  UpdatePending(it->second->tab_id);
+}
+
+bool PlutoniumTabRequests::Answer(int32_t id,
+                                  From from,
+                                  int32_t taker,
+                                  const std::string& answer_json) {
+  auto it = requests_.find(id);
+  if (it == requests_.end()) {
+    return false;
+  }
+  Request& request = *it->second;
+  if (from == From::kShell && (!taker || request.taker != taker)) {
+    return false;
+  }
+  std::optional<base::Value> answer =
+      answer_json.empty()
+          ? base::Value()
+          : base::JSONReader::Read(answer_json, base::JSON_PARSE_RFC);
+  if (!answer || !request.on_answer) {
+    return false;
+  }
+  // The callback may end the request's owner (and so Cancel() it): keep
+  // the callback alive across the call, and look the request up again.
+  auto on_answer = request.on_answer;
+  request.answering = from == From::kShell;
+  const bool accepted = on_answer.Run(from, *answer);
+  it = requests_.find(id);
+  if (it != requests_.end()) {
+    it->second->answering = false;
+  }
+  if (!accepted) {
+    return false;
+  }
+  VLOG(1) << "EXO-TAB-FEATURES request #" << id << " answered by the "
+          << (from == From::kShell ? "shell" : "agent");
+  // An agent's answer: the shell that took it puts its UI away.
+  End(id, /*tell_taker=*/from != From::kShell);
+  return true;
+}
+
+void PlutoniumTabRequests::OnShellGone(int32_t taker) {
+  std::vector<int32_t> ids;
+  for (const auto& [id, request] : requests_) {
+    if (request->taker == taker) {
+      ids.push_back(id);
+    }
+  }
+  for (int32_t id : ids) {
+    VLOG(1) << "EXO-TAB-FEATURES request #" << id
+            << ": the shell that took it went away, falling back";
+    requests_[id]->taker = 0;
+    FallBack(id, FallbackReason::kShellGone);
+  }
+}
+
+void PlutoniumTabRequests::OnTabRemoved(int32_t tab_id) {
+  std::vector<int32_t> ids;
+  for (const auto& [id, request] : requests_) {
+    if (request->tab_id == tab_id) {
+      ids.push_back(id);
+    }
+  }
+  // Its page and its features go with it; nothing runs.
+  for (int32_t id : ids) {
+    End(id, /*tell_taker=*/true);
+  }
+}
+
+std::unique_ptr<PlutoniumTabRequests::Request> PlutoniumTabRequests::End(
+    int32_t id,
+    bool tell_taker) {
+  auto it = requests_.find(id);
+  if (it == requests_.end()) {
+    return nullptr;
+  }
+  std::unique_ptr<Request> request = std::move(it->second);
+  requests_.erase(it);
+  if (tell_taker && request->taker) {
+    plutonium_shell::EndTabRequest(request->taker, id);
+  }
+  UpdatePending(request->tab_id);
+  return request;
+}
+
+void PlutoniumTabRequests::FallBack(int32_t id, FallbackReason reason) {
+  std::unique_ptr<Request> request = End(id, /*tell_taker=*/true);
+  if (!request || !request->on_fallback) {
+    return;
+  }
+  // Never from inside Start() or a broker call.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(request->on_fallback), reason));
+}
+
+void PlutoniumTabRequests::Cancel(int32_t id) {
+  auto it = requests_.find(id);
+  if (it != requests_.end()) {
+    VLOG(1) << "EXO-TAB-FEATURES request #" << id << " cancelled";
+    End(id, /*tell_taker=*/!it->second->answering);
+  }
+}
+
+// static
+void PlutoniumTabRequests::RunTestRequest(content::WebContents* contents,
+                                          const base::DictValue& args,
+                                          PlutoniumTabs::CommandCallback done) {
+  struct State {
+    std::unique_ptr<Handle> handle;
+    PlutoniumTabs::CommandCallback done;
+  };
+  // Lives as long as the request (its fallback holds it).
+  auto state = std::make_shared<State>();
+  state->done = std::move(done);
+  Params params;
+  params.kind = "test";
+  params.detail = args.Clone();
+  params.on_answer = base::BindRepeating(
+      [](std::weak_ptr<State> weak, From from, const base::Value& answer) {
+        std::shared_ptr<State> state = weak.lock();
+        if (!state || !state->done) {
+          return false;
+        }
+        std::move(state->done)
+            .Run(base::Value(
+                base::DictValue()
+                    .Set("answeredBy", from == From::kShell ? "shell" : "agent")
+                    .Set("answer", answer.Clone())));
+        return true;
+      },
+      std::weak_ptr<State>(state));
+  params.on_fallback = base::BindOnce(
+      [](std::shared_ptr<State> state, FallbackReason reason) {
+        if (state->done) {
+          std::move(state->done)
+              .Run(base::Value(base::DictValue().Set(
+                  "fallback", reason == FallbackReason::kNotTaken
+                                  ? "notTaken"
+                                  : "shellGone")));
+        }
+      },
+      state);
+  state->handle = Get()->Start(contents, std::move(params));
+  if (!state->handle && state->done) {
+    std::move(state->done).Run(std::nullopt);
+  }
+}
+
+void PlutoniumTabRequests::UpdatePending(int32_t tab_id) {
+  content::WebContents* contents = PlutoniumTabs::Get()->GetContents(tab_id);
+  if (!contents) {
+    return;
+  }
+  base::DictValue pending;
+  for (const auto& [id, request] : requests_) {
+    if (request->tab_id != tab_id) {
+      continue;
+    }
+    // The latest of a kind (ids only grow).
+    pending.Set(request->kind, base::DictValue()
+                                   .Set("requestId", id)
+                                   .Set("taken", request->taker != 0)
+                                   .Set("detail", request->detail.Clone()));
+  }
+  PlutoniumTabs::Get()->SetTabState(
+      contents, "pending",
+      pending.empty() ? base::Value() : base::Value(std::move(pending)));
+}
