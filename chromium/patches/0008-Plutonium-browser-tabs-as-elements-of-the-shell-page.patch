+PlutoniumTabs::PlutoniumTabs() {
+  surface_embed::SurfaceEmbedHost::SetFullscreenChangedCallback(
+      base::BindRepeating(&PlutoniumTabs::OnEmbedFullscreenChanged,
+                          base::Unretained(this)));
+  // EXO-SHELLS: a hidden shell's <embed>s get their tabs when it's shown.
+  surface_embed::SurfaceEmbedHost::SetAttachFilter(
+      base::BindRepeating([](content::RenderFrameHost* parent) {
+        return !plutonium_shell::IsShellDocument(parent) ||
+               plutonium_shell::IsVisibleShellDocument(parent);
+      }));
+  // EXO-PRESENT: the presented tab is the presenter's alone.
+  surface_embed::SurfaceEmbedHost::SetChildFilter(
+      base::BindRepeating([](content::WebContents* child) {
+        PlutoniumTabs* tabs = PlutoniumTabs::Get();
+        return !tabs->presented_tab_id_ ||
+               tabs->GetContents(tabs->presented_tab_id_) != child;
+      }));
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    SetShell(shells->GetVisibleContents());
+  }
+  // EXO-TAB-FEATURES: their commands (AddCommand()), one line per feature.
+  plutonium_zoom::AddCommands(this);
+  PlutoniumFind::AddCommands(this);
+  // Permission prompts (plutonium_permissions.h).
+  AddCommand("permission-request",
+             base::BindRepeating(&plutonium_permissions::RunRequestCommand));
+  AddCommand("permissions",
+             base::BindRepeating(&plutonium_permissions::RunListCommand));
+  AddCommand("permission-revoke",
+             base::BindRepeating(&plutonium_permissions::RunRevokeCommand));
+  AddCommand("print", base::BindRepeating(&plutonium_print::RunPrintCommand));
+  AddCommand("print-to-pdf",
+             base::BindRepeating(&plutonium_print::RunPrintToPdfCommand));
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "plutonium-test-tab-requests")) {
+    AddCommand("test-request",
+               base::BindRepeating(&PlutoniumTabRequests::RunTestRequest));
+  }
+}
