+
+// Sends DevTools protocol commands to one tab, for the shell's automation
+// (snapshots, synthetic input, evaluating script). An untrusted client: it
+// can't reach the browser target, other targets or local files, and only page
+// domains are passed through.
+class TabDevTools : public content::DevToolsAgentHostClient {
+ public:
+  explicit TabDevTools(content::WebContents* contents) : contents_(contents) {}
+
+  ~TabDevTools() override {
+    if (host_) {
+      host_->DetachClient(this);
+    }
+    FailAll("The tab closed");
+  }
+
+  void Send(const std::string& method,
+            const std::string& params_json,
+            PlutoniumTabs::DevToolsCallback callback) {
+    static constexpr const char* kDomains[] = {
+        "Runtime.", "Input.",   "Page.", "DOM.",
+        "Accessibility.", "Emulation.", "Log.", "Network."};
+    bool allowed = false;
+    for (const char* domain : kDomains) {
+      allowed |= base::StartsWith(method, domain);
+    }
+    if (!allowed) {
+      std::move(callback).Run(false, "Not allowed: " + method);
+      return;
+    }
+    base::DictValue params;
+    if (!params_json.empty()) {
+      std::optional<base::DictValue> parsed =
+          base::JSONReader::ReadDict(params_json, base::JSON_PARSE_RFC);
+      if (!parsed) {
+        std::move(callback).Run(false, "params must be a JSON object");
+        return;
+      }
+      params = std::move(*parsed);
+    }
+    if (!host_) {
+      host_ = content::DevToolsAgentHost::GetOrCreateFor(contents_);
+      if (!host_->AttachClient(this)) {
+        host_ = nullptr;
+        std::move(callback).Run(false, "Could not attach to the tab");
+        return;
+      }
+    }
+    const int id = next_id_++;
+    pending_[id] = std::move(callback);
+    std::string message;
+    base::JSONWriter::Write(base::DictValue()
+                                .Set("id", id)
+                                .Set("method", method)
+                                .Set("params", std::move(params)),
+                            &message);
+    host_->DispatchProtocolMessage(this, base::as_byte_span(message));
+  }
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                               base::span<const uint8_t> message) override {
+    std::optional<base::DictValue> parsed = base::JSONReader::ReadDict(
+        base::as_string_view(message), base::JSON_PARSE_RFC);
+    if (!parsed) {
+      return;
+    }
+    const base::DictValue& dict = *parsed;
+    std::optional<int> id = dict.FindInt("id");
+    if (!id) {
+      return;  // An event; not forwarded.
+    }
+    auto it = pending_.find(*id);
+    if (it == pending_.end()) {
+      return;
+    }
+    PlutoniumTabs::DevToolsCallback callback = std::move(it->second);
+    pending_.erase(it);
+    if (const base::DictValue* error = dict.FindDict("error")) {
+      const std::string* text = error->FindString("message");
+      std::move(callback).Run(false, text ? *text : "DevTools error");
+      return;
+    }
+    std::string result = "{}";
+    if (const base::Value* value = dict.Find("result")) {
+      base::JSONWriter::Write(*value, &result);
+    }
+    std::move(callback).Run(true, result);
+  }
+
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override {
+    host_ = nullptr;
+    FailAll("DevTools detached");
+  }
+
+  bool MayAttachToURL(const GURL& url, bool is_webui) override {
+    return !is_webui;
+  }
+  bool IsTrusted() override { return false; }
+  bool MayReadLocalFiles() override { return false; }
+  bool MayWriteLocalFiles() override { return false; }
+
+ private:
+  void FailAll(const std::string& error) {
+    auto pending = std::move(pending_);
+    pending_.clear();
+    for (auto& [id, callback] : pending) {
+      std::move(callback).Run(false, error);
+    }
+  }
+
+  const raw_ptr<content::WebContents> contents_;
+  scoped_refptr<content::DevToolsAgentHost> host_;
+  int next_id_ = 1;
+  base::flat_map<int, PlutoniumTabs::DevToolsCallback> pending_;
+};
+
+// One tab: owns its WebContents and is its delegate.
+class PlutoniumTabs::Tab : public content::WebContentsDelegate,
+                           public content::WebContentsObserver,
+                           public content::JavaScriptDialogManager {
+ public:
+  // A tab owns its page (|owned|), unless it's someone else's (|borrowed|,
+  // EXO-CHROME: DevTools'), which keeps its own delegate.
+  Tab(PlutoniumTabs* tabs,
+      int32_t id,
+      std::unique_ptr<content::WebContents> owned,
+      content::WebContents* borrowed,
+      std::string tag,
+      std::vector<std::string> tags,
+      int32_t opener_id,
+      const std::string& opened_by)
+      : content::WebContentsObserver(owned ? owned.get() : borrowed),
+        tabs_(tabs),
+        owned_contents_(std::move(owned)),
+        contents_(owned_contents_ ? owned_contents_.get() : borrowed) {
+    info_.id = id;
+    info_.tag = std::move(tag);
+    info_.tags = std::move(tags);
+    info_.opener_id = opener_id;
+    info_.opened_by = opened_by;
+    info_.incognito = contents_->GetBrowserContext()->IsOffTheRecord();
+    if (owned_contents_) {
+      contents_->SetDelegate(this);
+    }
+    info_.content_id =
+        surface_embed::SurfaceEmbedHandle::CreateForWebContents(contents_.get())
+            ->id();
+    Refresh();
+  }
+
+  ~Tab() override {
+    CancelDialog();
+    Observe(nullptr);
+    if (owned_contents_) {
+      contents_->SetDelegate(nullptr);
+    }
+  }
+
+  content::WebContents* contents() const { return contents_; }
+  // EXO-CHROME: a page this tab doesn't own (DevTools').
+  bool borrowed() const { return !owned_contents_; }
+  void Changed() { tabs_->TabChanged(this); }
+
+  TabDevTools* devtools() {
+    if (!devtools_) {
+      devtools_ = std::make_unique<TabDevTools>(contents_.get());
+    }
+    return devtools_.get();
+  }
+  const TabInfo& info() const { return info_; }
+  // EXO-TAGS: Refresh() leaves tags alone.
+  void set_tags(std::vector<std::string> tags) { info_.tags = std::move(tags); }
+
+  // EXO-TAB-FEATURES: a feature's state; true if it changed.
+  bool SetState(const std::string& key, base::Value value) {
+    const base::Value* old = state_.Find(key);
+    if (value.is_none() ? !old : (old && *old == value)) {
+      return false;
+    }
+    if (value.is_none()) {
+      state_.Remove(key);
+    } else {
+      state_.Set(key, std::move(value));
+    }
+    return true;
+  }
+
+  // Re-reads the tab's state; true if it changed.
+  bool Refresh() {
+    const bool embedded = !!contents_->GetSurfaceEmbedConnector();
+    content::RenderWidgetHostView* view = contents_->GetRenderWidgetHostView();
+    if (embedded && view && !view->GetViewBounds().IsEmpty()) {
+      size_ = view->GetViewBounds().size();
+    } else if (!embedded && info_.embedded) {
+      // Detaching gives the tab a fresh, unsized view: keep the page laid
+      // out at the size it was shown at (and snapshots of it meaningful).
+      contents_->Resize(gfx::Rect(size_));
+    }
+    if (!embedded) {
+      Park();
+    }
+    TabInfo info = info_;
+    info.url = contents_->GetVisibleURL();
+    info.title = contents_->GetTitle();
+    info.loading = contents_->IsLoading();
+    info.can_go_back = contents_->GetController().CanGoBack();
+    info.can_go_forward = contents_->GetController().CanGoForward();
+    info.embedded = embedded;
+    info.focused = embedded && view && view->HasFocus() &&
+                   contents_->ContainsOrIsFocusedWebContents();
+    info.presented = tabs_->presented_tab_id() == info_.id;
+    info.dialog_type = dialog_type_;
+    info.dialog_message = dialog_message_;
+    info.dialog_default_prompt = dialog_default_prompt_;
+    base::JSONWriter::Write(state_, &info.state_json);
+    if (info == info_) {
+      return false;
+    }
+    info_ = std::move(info);
+    return true;
+  }
+
+  // content::WebContentsDelegate:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override {
+    content::WebContents* target = nullptr;
+    switch (params.disposition) {
+      case WindowOpenDisposition::CURRENT_TAB:
+        target = source;
+        break;
+      case WindowOpenDisposition::NEW_FOREGROUND_TAB:
+      case WindowOpenDisposition::NEW_BACKGROUND_TAB:
+      case WindowOpenDisposition::NEW_POPUP:
+      case WindowOpenDisposition::NEW_WINDOW:
+      case WindowOpenDisposition::SINGLETON_TAB:
+      case WindowOpenDisposition::SWITCH_TO_TAB: {
+        content::WebContents::CreateParams create_params(
+            source->GetBrowserContext());
+        create_params.initially_hidden = true;
+        std::unique_ptr<content::WebContents> contents =
+            content::WebContents::Create(create_params);
+        contents->Resize(gfx::Rect(size_));
+        target = tabs_->AddTab(std::move(contents), info_.tag, info_.tags,
+                               info_.id, "page")
+                     ->contents();
+        break;
+      }
+      default:
+        // Downloads, "save link as" and the like aren't tabs.
+        return nullptr;
+    }
+    base::WeakPtr<content::NavigationHandle> handle =
+        target->GetController().LoadURLWithParams(
+            content::NavigationController::LoadURLParams(params));
+    if (handle && navigation_handle_callback) {
+      std::move(navigation_handle_callback).Run(*handle);
+    }
+    return target;
+  }
+
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override {
+    // window.open() and the like. Every new window is a tab; the shell
+    // decides whether and where to show it. Without a user gesture it's a
+    // popup Chrome would block (its popup blocker lives in tab helpers these
+    // tabs don't have): drop it.
+    if (!user_gesture) {
+      VLOG(1) << "EXO-TABS tab #" << info_.id << ": blocked a popup to "
+              << target_url.spec() << " (no user gesture)";
+      if (was_blocked) {
+        *was_blocked = true;
+      }
+      return nullptr;
+    }
+    if (new_contents->GetContainerBounds().IsEmpty()) {
+      new_contents->Resize(gfx::Rect(size_));
+    }
+    return tabs_
+        ->AddTab(std::move(new_contents), info_.tag, info_.tags, info_.id,
+                 "page")
+        ->contents();
+  }
+
+  void CloseContents(content::WebContents* source) override {
+    tabs_->RemoveTab(info_.id);
+  }
+
+  void NavigationStateChanged(content::WebContents* source,
+                              content::InvalidateTypes changed_flags) override {
+    tabs_->TabChanged(this);
+  }
+
+  void LoadingStateChanged(content::WebContents* source,
+                           bool should_show_loading_ui) override {
+    tabs_->TabChanged(this);
+  }
+
+  bool ShouldFocusPageAfterCrash(content::WebContents* source) override {
+    return false;
+  }
+
+  // EXO-KEYS: the shell's shortcuts go to the shell page, and Escape leaves
+  // the page's own fullscreen, as in a browser window.
+  content::KeyboardEventProcessingResult PreHandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override {
+    // EXO-PRESENT: presented, it's in front of every shell.
+    if (tabs_->presented_tab_id() != info_.id &&
+        tabs_->ForwardShellShortcut(event)) {
+      return content::KeyboardEventProcessingResult::HANDLED;
+    }
+    if (page_fullscreen_ &&
+        event.GetType() == blink::WebInputEvent::Type::kRawKeyDown &&
+        event.windows_key_code == ui::VKEY_ESCAPE) {
+      contents_->ExitFullscreen(/*will_cause_resize=*/true);
+      return content::KeyboardEventProcessingResult::HANDLED;
+    }
+    return content::KeyboardEventProcessingResult::NOT_HANDLED;
+  }
+
+  // EXO-CHROME: the browser keys a page has without a browser window, once
+  // the page has let them through: DevTools, and back, forward and reload.
+  // EXO-TAB-FEATURES: Ctrl+wheel the page let through.
+  void ContentsZoomChange(bool zoom_in) override {
+    plutonium_zoom::ZoomChange(contents_, zoom_in);
+  }
+
+  bool HandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override {
+    if (event.GetType() != blink::WebInputEvent::Type::kRawKeyDown) {
+      return false;
+    }
+    switch (plutonium_keys::GetDevToolsKey(event)) {
+      case plutonium_keys::DevToolsKey::kToggle:
+        DevToolsWindow::OpenDevToolsWindow(
+            contents_, DevToolsToggleAction::Show(),
+            DevToolsOpenedByAction::kToggleShortcut);
+        return true;
+      case plutonium_keys::DevToolsKey::kConsole:
+        DevToolsWindow::OpenDevToolsWindow(
+            contents_, DevToolsToggleAction::ShowConsolePanel(),
+            DevToolsOpenedByAction::kConsoleShortcut);
+        return true;
+      case plutonium_keys::DevToolsKey::kInspect:
+        DevToolsWindow::OpenDevToolsWindow(
+            contents_, DevToolsToggleAction::Inspect(),
+            DevToolsOpenedByAction::kInspectorModeShortcut);
+        return true;
+      case plutonium_keys::DevToolsKey::kNone:
+        break;
+    }
+    constexpr int kModifiers =
+        blink::WebInputEvent::kControlKey | blink::WebInputEvent::kAltKey |
+        blink::WebInputEvent::kShiftKey | blink::WebInputEvent::kMetaKey;
+    const int modifiers = event.GetModifiers() & kModifiers;
+    const int key = event.windows_key_code;
+    content::NavigationController& controller = contents_->GetController();
+    if (key == ui::VKEY_BROWSER_BACK ||
+        (key == ui::VKEY_LEFT && modifiers == blink::WebInputEvent::kAltKey)) {
+      if (controller.CanGoBack()) {
+        controller.GoBack();
+      }
+      return true;
+    }
+    if (key == ui::VKEY_BROWSER_FORWARD ||
+        (key == ui::VKEY_RIGHT && modifiers == blink::WebInputEvent::kAltKey)) {
+      if (controller.CanGoForward()) {
+        controller.GoForward();
+      }
+      return true;
+    }
+    const bool reload =
+        key == ui::VKEY_BROWSER_REFRESH ||
+        (key == ui::VKEY_F5 && (modifiers & ~blink::WebInputEvent::kShiftKey) ==
+                                   0) ||
+        (key == ui::VKEY_R && (modifiers & ~blink::WebInputEvent::kShiftKey) ==
+                                  blink::WebInputEvent::kControlKey);
+    if (reload) {
+      controller.Reload(modifiers & blink::WebInputEvent::kShiftKey
+                            ? content::ReloadType::BYPASSING_CACHE
+                            : content::ReloadType::NORMAL,
+                        /*check_for_repost=*/true);
+      return true;
+    }
+    // EXO-TAB-FEATURES: find, print and zoom, once a feature has them.
+    const std::string command = plutonium_keys::GetTabCommandKey(event);
+    if (!command.empty() && !borrowed() && tabs_->HasCommand(command)) {
+      tabs_->RunNamedCommand(info_.id, command, std::string(),
+                             base::DoNothing());
+      return true;
+    }
+    return false;
+  }
+
+  // EXO-FULLSCREEN: the page's own fullscreen (e.g. a video's) makes the
+  // <embed> fullscreen, so the page gets the whole screen.
+  bool CanEnterFullscreenModeForTab(
+      content::RenderFrameHost* requesting_frame) override {
+    return !!contents_->GetSurfaceEmbedConnector();
+  }
+
+  void EnterFullscreenModeForTab(
+      content::RenderFrameHost* requesting_frame,
+      const blink::mojom::FullscreenOptions& options) override {
+    page_fullscreen_ = true;
+    if (!embed_fullscreen_) {
+      embed_fullscreen_for_page_ = true;
+      SetEmbedFullscreen(true);
+    }
+  }
+
+  void ExitFullscreenModeForTab(content::WebContents* source) override {
+    page_fullscreen_ = false;
+    if (embed_fullscreen_for_page_) {
+      embed_fullscreen_for_page_ = false;
+      SetEmbedFullscreen(false);
+    }
+  }
+
+  bool IsFullscreenForTabOrPending(
+      const content::WebContents* source) override {
+    return page_fullscreen_;
+  }
+
+  // Asks the <embed> showing the tab to enter or leave fullscreen; false if
+  // no <embed> shows it.
+  bool SetEmbedFullscreen(bool fullscreen) {
+    content::SurfaceEmbedConnector* connector =
+        contents_->GetSurfaceEmbedConnector();
+    if (!connector || !connector->GetDelegate()) {
+      return false;
+    }
+    connector->GetDelegate()->SetEmbedElementFullscreen(fullscreen);
+    return true;
+  }
+
+  bool embed_fullscreen() const { return embed_fullscreen_; }
+
+  void OnEmbedFullscreenChanged(bool fullscreen) {
+    VLOG(1) << "EXO-FULLSCREEN tab #" << info_.id << "'s <embed> "
+            << (fullscreen ? "entered" : "left") << " fullscreen";
+    embed_fullscreen_ = fullscreen;
+    if (!fullscreen) {
+      embed_fullscreen_for_page_ = false;
+      // Leaving the <embed>'s fullscreen (Super+F, the shell) ends the
+      // page's too.
+      if (page_fullscreen_) {
+        contents_->ExitFullscreen(/*will_cause_resize=*/true);
+      }
+    }
+  }
+
+  // EXO-TAB-PERMISSIONS: getUserMedia(), as BrowserWebContentsDelegate.
+  void RequestMediaAccessPermission(
+      content::WebContents* web_contents,
+      const content::MediaStreamRequest& request,
+      content::MediaResponseCallback callback) override {
+    plutonium_permissions::RequestMediaAccessPermission(
+        web_contents, request, std::move(callback));
+  }
+
+  bool CheckMediaAccessPermission(content::RenderFrameHost* render_frame_host,
+                                  const url::Origin& security_origin,
+                                  blink::mojom::MediaStreamType type) override {
+    return plutonium_permissions::CheckMediaAccessPermission(
+        render_frame_host, security_origin, type);
+  }
+
+  content::JavaScriptDialogManager* GetJavaScriptDialogManager(
+      content::WebContents* source) override {
+    return this;
+  }
+
+  // EXO-TAB-FEATURES: file pickers, as in a Browser. The picker itself asks
+  // the shell (PlutoniumSelectFileDialogFactory).
+  void RunFileChooser(content::RenderFrameHost* render_frame_host,
+                      scoped_refptr<content::FileSelectListener> listener,
+                      const blink::mojom::FileChooserParams& params) override {
+    FileSelectHelper::RunFileChooser(render_frame_host, std::move(listener),
+                                     params);
+  }
+
+  void EnumerateDirectory(content::WebContents* web_contents,
+                          scoped_refptr<content::FileSelectListener> listener,
+                          const base::FilePath& path) override {
+    FileSelectHelper::EnumerateDirectory(web_contents, std::move(listener),
+                                         path);
+  }
+
+  // content::JavaScriptDialogManager: the shell shows the dialog (it sees
+  // it in the tab's state) and answers through AnswerDialog().
+  void RunJavaScriptDialog(content::WebContents* web_contents,
+                           content::RenderFrameHost* render_frame_host,
+                           content::JavaScriptDialogType dialog_type,
+                           const std::u16string& message_text,
+                           const std::u16string& default_prompt_text,
+                           DialogClosedCallback callback,
+                           bool* did_suppress_message) override {
+    if (dialog_callback_) {
+      *did_suppress_message = true;
+      return;
+    }
+    switch (dialog_type) {
+      case content::JAVASCRIPT_DIALOG_TYPE_ALERT:
+        dialog_type_ = "alert";
+        break;
+      case content::JAVASCRIPT_DIALOG_TYPE_CONFIRM:
+        dialog_type_ = "confirm";
+        break;
+      case content::JAVASCRIPT_DIALOG_TYPE_PROMPT:
+        dialog_type_ = "prompt";
+        break;
+    }
+    ShowDialog(message_text, default_prompt_text, std::move(callback));
+  }
+
+  void RunBeforeUnloadDialog(content::WebContents* web_contents,
+                             content::RenderFrameHost* render_frame_host,
+                             bool is_reload,
+                             DialogClosedCallback callback) override {
+    if (dialog_callback_) {
+      // Stay on the page.
+      std::move(callback).Run(false, std::u16string());
+      return;
+    }
+    dialog_type_ = "beforeunload";
+    ShowDialog(is_reload ? u"Reload this page? Changes you made may not be "
+                           u"saved."
+                         : u"Leave this page? Changes you made may not be "
+                           u"saved.",
+               std::u16string(), std::move(callback));
+  }
+
+  bool HandleJavaScriptDialog(content::WebContents* web_contents,
+                              bool accept,
+                              const std::u16string* prompt_override) override {
+    if (!dialog_callback_) {
+      return false;
+    }
+    Answer(accept, prompt_override ? *prompt_override : dialog_default_prompt_);
+    return true;
+  }
+
+  void CancelDialogs(content::WebContents* web_contents,
+                     bool reset_state) override {
+    CancelDialog();
+  }
+
+  void Answer(bool accept, const std::u16string& prompt_text) {
+    if (!dialog_callback_) {
+      return;
+    }
+    DialogClosedCallback callback = std::move(dialog_callback_);
+    dialog_type_.clear();
+    dialog_message_.clear();
+    dialog_default_prompt_.clear();
+    std::move(callback).Run(accept, prompt_text);
+    tabs_->TabChanged(this);
+  }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    tabs_->TabChanged(this);
+  }
+
+  // Only a borrowed page goes before its tab (its owner closed it).
+  void WebContentsDestroyed() override {
+    Observe(nullptr);
+    contents_ = nullptr;
+    tabs_->RemoveTab(info_.id);
+  }
+
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    // An <embed> attaching or detaching the tab changes its visibility. On
+    // detach that happens before the connector goes: look once it's done.
+    tabs_->TabChanged(this);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&Tab::Changed, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnFocusChangedInPage(const content::FocusedNodeDetails& details) override {
+    tabs_->TabChanged(this);
+  }
+
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override {
+    LOG(WARNING) << "EXO-TABS tab #" << info_.id << " renderer gone ("
+                 << status << ")";
+    tabs_->TabChanged(this);
+  }
+
+  // EXO-TAB-FEATURES: the WebContents-only helpers Chrome's TabFeatures
+  // would attach (chrome/browser/ui/tabs/tab_features.cc), for the features
+  // in TAB_FEATURES.md. One line per feature; what a feature needs from the
+  // delegate, Tab implements below, as BrowserWebContentsDelegate does.
+  // Called once the tab is registered (so a helper may SetTabState()), for
+  // the tab's own page only.
+  void AttachHelpers() {
+    plutonium_zoom::AttachHelpers(contents_);
+    PlutoniumFind::Attach(contents_);
+    // Permission prompts (plutonium_permissions.h).
+    plutonium_permissions::AttachHelpers(contents_);
+    // Downloads: the profile's manager saves them; this lists them.
+    PlutoniumDownloads::Get()->ObserveContext(contents_->GetBrowserContext());
+    // Printing (plutonium_print.h).
+    plutonium_print::AttachHelpers(contents_);
+  }
+
+ private:
+
+  // Keeps the tab's own (hidden) view in the shell's window tree while no
+  // <embed> shows it (and, while presented, the presenter doesn't).
+  void Park() {
+    aura::Window* window = contents_->GetNativeView();
+    aura::Window* parking = tabs_->parking();
+    if (!window || !parking || window->parent()) {
+      return;
+    }
+    window->Hide();
+    parking->AddChild(window);
+    parking->StackChildAtBottom(window);
+  }
+
+  void ShowDialog(const std::u16string& message,
+                  const std::u16string& default_prompt,
+                  DialogClosedCallback callback) {
+    dialog_message_ = message;
+    dialog_default_prompt_ = default_prompt;
+    dialog_callback_ = std::move(callback);
+    tabs_->TabChanged(this);
+  }
+
+  void CancelDialog() {
+    if (dialog_callback_) {
+      Answer(false, std::u16string());
+    }
+  }
+
+  const raw_ptr<PlutoniumTabs> tabs_;
+  std::unique_ptr<content::WebContents> owned_contents_;
+  raw_ptr<content::WebContents> contents_;
+  TabInfo info_;
+  // The size the page is laid out at while no <embed> shows it.
+  gfx::Size size_ = kDefaultTabSize;
+  std::string dialog_type_;
+  std::u16string dialog_message_;
+  std::u16string dialog_default_prompt_;
+  DialogClosedCallback dialog_callback_;
+  // EXO-TAB-FEATURES: SetState(); TabInfo::state_json.
+  base::DictValue state_;
+  // EXO-FULLSCREEN: whether the <embed> showing the tab is fullscreen,
+  // whether the page asked to be, and whether the <embed> went fullscreen
+  // for the page (so leaves it with the page).
+  bool embed_fullscreen_ = false;
+  bool page_fullscreen_ = false;
+  bool embed_fullscreen_for_page_ = false;
+  // Destroyed before |contents_|.
+  std::unique_ptr<TabDevTools> devtools_;
+  base::WeakPtrFactory<Tab> weak_factory_{this};
+};
