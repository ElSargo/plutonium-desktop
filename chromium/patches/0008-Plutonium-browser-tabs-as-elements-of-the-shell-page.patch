+bool PlutoniumTabs::Navigate(int32_t tab_id, const std::string& url_text) {
+  Tab* tab = FindTab(tab_id);
+  GURL url = ToLoadableUrl(url_text);
+  if (!tab || tab->borrowed() || !url.is_valid()) {
+    return false;
+  }
+  content::NavigationController::LoadURLParams load(url);
+  load.transition_type = ui::PageTransitionFromInt(
+      ui::PAGE_TRANSITION_TYPED | ui::PAGE_TRANSITION_FROM_ADDRESS_BAR);
+  tab->contents()->GetController().LoadURLWithParams(load);
+  return true;
+}
+
+void PlutoniumTabs::RunCommand(int32_t tab_id, Command command) {
+  Tab* tab = FindTab(tab_id);
+  if (!tab) {
+    return;
+  }
+  // EXO-CHROME: DevTools closes as DevTools; its page stays its own.
+  if (tab->borrowed()) {
+    if (command == Command::kClose) {
+      if (DevToolsWindow* devtools =
+              DevToolsWindow::AsDevToolsWindow(tab->contents())) {
+        devtools->CloseShellTab();
+      }
+    } else if (command == Command::kReload) {
+      tab->contents()->GetController().Reload(content::ReloadType::NORMAL,
+                                              /*check_for_repost=*/false);
+    }
+    return;
+  }
+  content::NavigationController& controller = tab->contents()->GetController();
+  switch (command) {
+    case Command::kBack:
+      if (controller.CanGoBack()) {
+        controller.GoBack();
+      }
+      break;
+    case Command::kForward:
+      if (controller.CanGoForward()) {
+        controller.GoForward();
+      }
+      break;
+    case Command::kReload:
+      controller.Reload(content::ReloadType::NORMAL, /*check_for_repost=*/false);
+      break;
+    case Command::kStop:
+      tab->contents()->Stop();
+      break;
+    case Command::kClose:
+      RemoveTab(tab_id);
+      break;
+  }
+}
+
+void PlutoniumTabs::AddCommand(const std::string& name,
+                               CommandHandler handler) {
+  commands_[name] = std::move(handler);
+}
+
+bool PlutoniumTabs::HasCommand(const std::string& name) const {
+  return commands_.contains(name);
+}
+
+void PlutoniumTabs::RunNamedCommand(
+    int32_t tab_id,
+    const std::string& name,
+    const std::string& args_json,
+    base::OnceCallback<void(bool, const std::string&)> done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // A feature that drops its CommandCallback (its tab closed while it
+  // waited on the user) still answers.
+  done = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      std::move(done), false, std::string("The command ended unanswered"));
+  Tab* tab = FindTab(tab_id);
+  if (!tab) {
+    std::move(done).Run(false, "No such tab");
+    return;
+  }
+  static constexpr std::pair<const char*, Command> kBuiltIn[] = {
+      {"back", Command::kBack},     {"forward", Command::kForward},
+      {"reload", Command::kReload}, {"stop", Command::kStop},
+      {"close", Command::kClose}};
+  for (const auto& [built_in, command] : kBuiltIn) {
+    if (name == built_in) {
+      RunCommand(tab_id, command);
+      std::move(done).Run(true, "null");
+      return;
+    }
+  }
+  auto it = commands_.find(name);
+  if (it == commands_.end()) {
+    std::move(done).Run(false, "Unknown command: " + name);
+    return;
+  }
+  // EXO-CHROME: DevTools' page has none of the features.
+  if (tab->borrowed()) {
+    std::move(done).Run(false, "DevTools has no " + name);
+    return;
+  }
+  base::DictValue args;
+  if (!args_json.empty()) {
+    std::optional<base::DictValue> parsed =
+        base::JSONReader::ReadDict(args_json, base::JSON_PARSE_RFC);
+    if (!parsed) {
+      std::move(done).Run(false, "args must be a JSON object");
+      return;
+    }
+    args = std::move(*parsed);
+  }
+  VLOG(1) << "EXO-TAB-FEATURES tab #" << tab_id << ": " << name;
+  it->second.Run(
+      tab->contents(), args,
+      base::BindOnce(
+          [](base::OnceCallback<void(bool, const std::string&)> done,
+             const std::string& name, std::optional<base::Value> result) {
+            if (!result) {
+              std::move(done).Run(false, name + " failed");
+              return;
+            }
+            std::string json;
+            base::JSONWriter::Write(*result, &json);
+            std::move(done).Run(true, json);
+          },
+          std::move(done), name));
+}
+
+void PlutoniumTabs::SetTabState(content::WebContents* contents,
+                                const std::string& key,
+                                base::Value value) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Tab* tab = FindTab(contents);
+  if (tab && tab->SetState(key, std::move(value))) {
+    TabChanged(tab);
+  }
+}
+
+void PlutoniumTabs::AnswerDialog(int32_t tab_id,
+                                 bool accept,
+                                 const std::u16string& prompt_text) {
+  if (Tab* tab = FindTab(tab_id)) {
+    tab->Answer(accept, prompt_text);
+  }
+}
+
+void PlutoniumTabs::SendDevToolsCommand(int32_t tab_id,
+                                        const std::string& method,
+                                        const std::string& params_json,
+                                        DevToolsCallback callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Tab* tab = FindTab(tab_id);
+  if (!tab) {
+    std::move(callback).Run(false, "No such tab");
+    return;
+  }
+  // EXO-CHROME: DevTools' own page is privileged: not for automation.
+  if (tab->borrowed()) {
+    std::move(callback).Run(false, "DevTools can't be automated");
+    return;
+  }
+  tab->devtools()->Send(method, params_json, std::move(callback));
+}
+
+void PlutoniumTabs::Snapshot(
+    int32_t tab_id,
+    base::OnceCallback<void(const SkBitmap&)> callback) {
+  Tab* tab = FindTab(tab_id);
+  content::RenderWidgetHostView* view =
+      tab ? tab->contents()->GetRenderWidgetHostView() : nullptr;
+  if (!view) {
+    std::move(callback).Run(SkBitmap());
+    return;
+  }
+  if (tab->contents()->GetVisibility() != content::Visibility::VISIBLE) {
+    HiddenTabFrameGrabber::Start(tab->contents(), std::move(callback));
+    return;
+  }
+  view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), base::Seconds(2),
+      base::BindOnce(
+          [](base::OnceCallback<void(const SkBitmap&)> callback,
+             const content::CopyFromSurfaceResult& result) {
+            std::move(callback).Run(result.has_value() ? result->bitmap
+                                                       : SkBitmap());
+          },
+          std::move(callback)));
+}
+
+void PlutoniumTabs::OnProfileWillBeDestroyed(Profile* profile) {
+  // A WebContents must not outlive its profile.
+  std::vector<int32_t> doomed;
+  for (const auto& [id, tab] : tabs_) {
+    if (tab->contents()->GetBrowserContext() == profile) {
+      doomed.push_back(id);
+    }
+  }
+  for (int32_t id : doomed) {
+    if (id == presented_tab_id_) {
+      presented_tab_id_ = 0;
+      presenter_->EndPresentation();
+    }
+    auto it = tabs_.find(id);
+    std::unique_ptr<Tab> tab = std::move(it->second);
+    tabs_.erase(it);
+    for (Observer& observer : observers_) {
+      observer.OnTabRemoved(id);
+    }
+  }
+  profile_observations_.RemoveObservation(profile);
+}
+
+PlutoniumTabs::Tab* PlutoniumTabs::AddTab(
+    std::unique_ptr<content::WebContents> contents,
+    const std::string& tag_text,
+    const std::vector<std::string>& inherited_tags,
+    int32_t opener_id,
+    const std::string& opened_by) {
+  return AddTab(std::move(contents), nullptr, tag_text, inherited_tags,
+                opener_id, opened_by);
+}
+
+PlutoniumTabs::Tab* PlutoniumTabs::AddTab(
+    std::unique_ptr<content::WebContents> owned,
+    content::WebContents* borrowed,
+    const std::string& tag_text,
+    const std::vector<std::string>& inherited_tags,
+    int32_t opener_id,
+    const std::string& opened_by) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  content::WebContents* contents = owned ? owned.get() : borrowed;
+  // EXO-TAGS: the origin tag first, then (for a page's new tab) the
+  // opener's other tags.
+  const std::string tag =
+      plutonium_tags::IsValidTag(tag_text) ? tag_text : std::string();
+  std::vector<std::string> tags = plutonium_tags::Update(
+      tag.empty() ? std::vector<std::string>()
+                  : std::vector<std::string>{tag},
+      !tag.empty(), inherited_tags, {});
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (!profile_observations_.IsObservingSource(profile)) {
+    profile_observations_.AddObservation(profile);
+  }
+  int32_t id = next_id_++;
+  auto new_tab =
+      std::make_unique<Tab>(this, id, std::move(owned), borrowed, tag,
+                            std::move(tags), opener_id, opened_by);
+  Tab* tab = new_tab.get();
+  tabs_[id] = std::move(new_tab);
+  VLOG(1) << "EXO-TABS tab #" << id << " added (opened by " << opened_by
+          << (opener_id ? " #" + base::NumberToString(opener_id) : "")
+          << ", tag \"" << tag << "\")";
+  for (Observer& observer : observers_) {
+    observer.OnTabAdded(tab->info());
+  }
+  // EXO-TAB-FEATURES: not DevTools' page.
+  if (!tab->borrowed()) {
+    tab->AttachHelpers();
+  }
+  return tab;
+}
+
+void PlutoniumTabs::SetPresenter(Presenter* presenter) {
+  if (presenter_ && presenter != presenter_) {
+    EndPresentation();
+  }
+  presenter_ = presenter;
+}
+
+bool PlutoniumTabs::Present(int32_t tab_id) {
+  Tab* tab = FindTab(tab_id);
+  if (!tab || !presenter_) {
+    return false;
+  }
+  if (presented_tab_id_ == tab_id) {
+    presenter_->Present(tab->contents());
+    return true;
+  }
+  EndPresentation();
+  ExitFullscreen();
+  presented_tab_id_ = tab_id;
+  // Its <embed> keeps wanting it, for afterwards. Detached, the page gets a
+  // view of its own, which Refresh() parks and the presenter takes.
+  surface_embed::SurfaceEmbedHost::DetachFromHost(tab->contents());
+  TabChanged(tab);
+  presenter_->Present(tab->contents());
+  VLOG(1) << "EXO-PRESENT tab #" << tab_id;
+  return true;
+}
+
+void PlutoniumTabs::EndPresentation() {
+  const int32_t tab_id = presented_tab_id_;
+  if (!tab_id) {
+    return;
+  }
+  presented_tab_id_ = 0;
+  if (presenter_) {
+    presenter_->EndPresentation();
+  }
+  Tab* tab = FindTab(tab_id);
+  if (!tab) {
+    return;
+  }
+  // Parked again, until the visible shell's <embed> takes it back.
+  TabChanged(tab);
+  surface_embed::SurfaceEmbedHost::ReattachHosts(
+      base::BindRepeating([](content::RenderFrameHost* parent) {
+        return !plutonium_shell::IsShellDocument(parent) ||
+               plutonium_shell::IsVisibleShellDocument(parent);
+      }));
+  VLOG(1) << "EXO-PRESENT ended for tab #" << tab_id;
+}
+
+void PlutoniumTabs::RemoveTab(int32_t tab_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = tabs_.find(tab_id);
+  if (it == tabs_.end()) {
+    return;
+  }
+  if (tab_id == presented_tab_id_) {
+    presented_tab_id_ = 0;
+    presenter_->EndPresentation();
+  }
+  std::unique_ptr<Tab> tab = std::move(it->second);
+  tabs_.erase(it);
+  VLOG(1) << "EXO-TABS tab #" << tab_id << " removed";
+  for (Observer& observer : observers_) {
+    observer.OnTabRemoved(tab_id);
+  }
+  // This may run inside one of the tab's own WebContents calls
+  // (CloseContents): destroy it once that has returned.
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                            std::move(tab));
+  // EXO-INCOGNITO: and then its profile, if it was the last incognito tab
+  // in it.
+  if (!incognito_profiles_.empty()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PlutoniumTabs::DestroyUnusedIncognitoProfiles,
+                       base::Unretained(this)));
+  }
+}
+
+void PlutoniumTabs::DestroyUnusedIncognitoProfiles() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::vector<base::WeakPtr<Profile>> kept;
+  for (base::WeakPtr<Profile>& profile : incognito_profiles_) {
+    if (!profile) {
+      continue;
+    }
+    bool used = false;
+    for (const auto& [id, tab] : tabs_) {
+      used = used || tab->contents()->GetBrowserContext() == profile.get();
+    }
+    if (used) {
+      kept.push_back(std::move(profile));
+    } else {
+      ProfileDestroyer::DestroyOTRProfileWhenAppropriate(profile.get());
+    }
+  }
+  incognito_profiles_ = std::move(kept);
+}
+
+void PlutoniumTabs::TabChanged(Tab* tab) {
+  // Not registered yet (called from Tab's constructor) or already removed.
+  if (FindTab(tab->info().id) != tab || !tab->Refresh()) {
+    return;
+  }
+  for (Observer& observer : observers_) {
+    observer.OnTabChanged(tab->info());
+  }
+}
+
+aura::Window* PlutoniumTabs::parking() const {
+  return parking_.windows().empty() ? nullptr : parking_.windows().front();
+}
+
+bool PlutoniumTabs::ToggleFocusedTabFullscreen() {
+  for (const auto& [id, tab] : tabs_) {
+    if (tab->info().focused) {
+      VLOG(1) << "EXO-FULLSCREEN toggling tab #" << id;
+      return tab->SetEmbedFullscreen(!tab->embed_fullscreen());
+    }
+  }
+  return false;
+}
+
+bool PlutoniumTabs::ExitFullscreen() {
+  bool any = false;
+  for (const auto& [id, tab] : tabs_) {
+    if (tab->embed_fullscreen()) {
+      any |= tab->SetEmbedFullscreen(false);
+    }
+  }
+  return any;
+}
+
+content::WebContents* PlutoniumTabs::shell() const {
+  return shell_observer_ ? shell_observer_->web_contents() : nullptr;
+}
+
+void PlutoniumTabs::SetShell(content::WebContents* shell) {
+  if (!shell) {
+    return;
+  }
+  aura::Window* window = shell->GetTopLevelNativeWindow();
+  aura::Window* old_parking = parking();
+  if (window && window != old_parking) {
+    parking_.RemoveAll();
+    parking_.Add(window);
+    // Hidden tabs keep painting (for snapshots) only in a shown window.
+    // An attached tab's native view is its embedder's (and it gets a fresh
+    // view, parked by Refresh(), when it's detached): leave those alone.
+    for (const auto& [id, tab] : tabs_) {
+      if (tab->contents()->GetSurfaceEmbedConnector()) {
+        continue;
+      }
+      aura::Window* view = tab->contents()->GetNativeView();
+      if (view && old_parking && view->parent() == old_parking) {
+        old_parking->RemoveChild(view);
+        window->AddChild(view);
+        window->StackChildAtBottom(view);
+      }
+    }
+  }
+  if (!shell_observer_ || shell_observer_->web_contents() != shell) {
+    shell_observer_ = std::make_unique<ShellObserver>(this, shell);
+  }
+}
+
+void PlutoniumTabs::OnEmbedFullscreenChanged(content::WebContents* contents,
+                                             bool fullscreen) {
+  if (Tab* tab = FindTab(contents)) {
+    tab->OnEmbedFullscreenChanged(fullscreen);
+  }
+}
+
+PlutoniumTabs::Tab* PlutoniumTabs::FindTab(
+    const content::WebContents* contents) const {
+  for (const auto& [id, tab] : tabs_) {
+    if (tab->contents() == contents) {
+      return tab.get();
+    }
+  }
+  return nullptr;
+}
+
+PlutoniumTabs::Tab* PlutoniumTabs::FindTab(int32_t tab_id) const {
+  auto it = tabs_.find(tab_id);
+  return it == tabs_.end() ? nullptr : it->second.get();
+}
