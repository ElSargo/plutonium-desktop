+bool PlutoniumTabs::UpdateTags(int32_t tab_id,
+                               const std::vector<std::string>& add,
+                               const std::vector<std::string>& remove) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Tab* tab = FindTab(tab_id);
+  if (!tab) {
+    return false;
+  }
+  std::vector<std::string> tags = plutonium_tags::Update(
+      tab->info().tags, !tab->info().tag.empty(), add, remove);
+  if (tags == tab->info().tags) {
+    return true;
+  }
+  tab->set_tags(std::move(tags));
+  VLOG(1) << "EXO-TAGS tab #" << tab_id << " tags ["
+          << base::JoinString(tab->info().tags, " ") << "]";
+  for (Observer& observer : observers_) {
+    observer.OnTabChanged(tab->info());
+  }
+  return true;
+}
