+std::optional<PlutoniumTabs::TabInfo> PlutoniumTabs::CreateTab(
+    content::WebContents* shell,
+    const std::string& url_text,
+    const std::string& tag,
+    const std::string& opened_by,
+    bool incognito) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  content::BrowserContext* browser_context = shell->GetBrowserContext();
+  // In shell mode PlutoniumShells says which shell is visible.
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    if (!this->shell()) {
+      SetShell(shells->GetVisibleContents());
+    }
+  } else {
+    SetShell(shell);
+  }
+  GURL url = ToLoadableUrl(url_text);
+  if (!url.is_valid()) {
+    VLOG(1) << "EXO-TABS refusing to open \"" << url_text << "\"";
+    return std::nullopt;
+  }
+  if (incognito) {
+    // EXO-INCOGNITO: a profile of its own, as DevTools makes for
+    // Target.createBrowserContext (which may open windows, unlike other
+    // non-primary off-the-record profiles).
+    Profile* otr =
+        Profile::FromBrowserContext(browser_context)
+            ->GetOffTheRecordProfile(
+                Profile::OTRProfileID::CreateUniqueForDevTools(),
+                /*create_if_needed=*/true);
+    incognito_profiles_.push_back(otr->GetWeakPtr());
+    browser_context = otr;
+  }
+  content::WebContents::CreateParams params(browser_context);
+  params.initially_hidden = true;
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(params);
+  contents->Resize(gfx::Rect(kDefaultTabSize));
+  Tab* tab = AddTab(std::move(contents), tag, {}, 0, opened_by);
+  content::NavigationController::LoadURLParams load(url);
+  load.transition_type = ui::PageTransitionFromInt(
+      ui::PAGE_TRANSITION_TYPED | ui::PAGE_TRANSITION_FROM_ADDRESS_BAR);
+  tab->contents()->GetController().LoadURLWithParams(load);
+  tab->Refresh();
+  return tab->info();
+}
+
+std::optional<PlutoniumTabs::TabInfo> PlutoniumTabs::CreateAgentTab(
+    const std::string& url,
+    const std::vector<std::string>& tags,
+    bool incognito) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  content::WebContents* shell = this->shell();
+  if (!shell) {
+    if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+      shell = shells->GetVisibleContents();
+    }
+  }
+  if (!shell) {
+    return std::nullopt;
+  }
+  std::optional<TabInfo> tab =
+      CreateTab(shell, url, tags.empty() ? std::string() : tags.front(),
+                "agent", incognito);
+  if (tab && tags.size() > 1) {
+    UpdateTags(tab->id, std::vector<std::string>(tags.begin() + 1, tags.end()),
+               {});
+    tab = GetTab(tab->id);
+  }
+  return tab;
+}
