+// Watches the shell page: focus moving within it (e.g. to its own controls)
+// is how an embedded tab loses keyboard focus.
+class PlutoniumTabs::ShellObserver : public content::WebContentsObserver {
+ public:
+  ShellObserver(PlutoniumTabs* tabs, content::WebContents* shell)
+      : content::WebContentsObserver(shell), tabs_(tabs) {}
+
+  void OnFocusChangedInPage(const content::FocusedNodeDetails&) override {
+    tabs_->RefreshAll();
+  }
+  void OnWebContentsFocused(content::RenderWidgetHost*) override {
+    tabs_->RefreshAll();
+  }
+  void OnWebContentsLostFocus(content::RenderWidgetHost*) override {
+    tabs_->RefreshAll();
+  }
+
+ private:
+  const raw_ptr<PlutoniumTabs> tabs_;
+};
