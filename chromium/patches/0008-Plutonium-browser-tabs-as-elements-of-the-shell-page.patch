+// The size a tab lays out at before an <embed> first shows it.
+constexpr gfx::Size kDefaultTabSize(1280, 800);
+
+// How long a hidden tab gets to produce a frame for a snapshot.
+constexpr base::TimeDelta kHiddenSnapshotTimeout = base::Seconds(3);
+
+// Takes one frame of a hidden tab. A hidden tab's view isn't in any
+// compositor tree, so CopyFromSurface() has nothing to copy; a frame sink
+// video capturer reads the renderer's own frames instead (as tab hover-card
+// thumbnails do), while a capturer count keeps the hidden page painting.
+// Deletes itself after the first frame or the timeout.
+class HiddenTabFrameGrabber : public viz::mojom::FrameSinkVideoConsumer {
+ public:
+  ~HiddenTabFrameGrabber() override = default;
+
+  static void Start(content::WebContents* contents,
+                    base::OnceCallback<void(const SkBitmap&)> callback) {
+    content::RenderWidgetHostView* view = contents->GetRenderWidgetHostView();
+    if (!view) {
+      std::move(callback).Run(SkBitmap());
+      return;
+    }
+    gfx::Size size = gfx::ScaleToCeiledSize(view->GetViewBounds().size(),
+                                            view->GetDeviceScaleFactor());
+    if (size.IsEmpty()) {
+      std::move(callback).Run(SkBitmap());
+      return;
+    }
+    auto* grabber = new HiddenTabFrameGrabber(std::move(callback));
+    grabber->capture_ = contents->IncrementCapturerCount(
+        gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/true,
+        /*is_activity=*/false);
+    grabber->capturer_ = view->CreateVideoCapturer();
+    grabber->capturer_->SetIsSecure(true);
+    grabber->capturer_->SetResolutionConstraints(size, size, false);
+    grabber->capturer_->SetAutoThrottlingEnabled(false);
+    grabber->capturer_->SetMinSizeChangePeriod(base::TimeDelta());
+    grabber->capturer_->SetFormat(media::PIXEL_FORMAT_ARGB);
+    grabber->capturer_->Start(grabber,
+                              viz::mojom::BufferFormatPreference::kDefault);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&HiddenTabFrameGrabber::Finish,
+                       grabber->weak_factory_.GetWeakPtr(), SkBitmap()),
+        kHiddenSnapshotTimeout);
+  }
+
+  // viz::mojom::FrameSinkVideoConsumer:
+  void OnFrameCaptured(
+      media::mojom::VideoBufferHandlePtr data,
+      media::mojom::VideoFrameInfoPtr info,
+      const gfx::Rect& content_rect,
+      mojo::PendingRemote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>
+          callbacks) override {
+    mojo::Remote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks> done(
+        std::move(callbacks));
+    if (!data->is_read_only_shmem_region()) {
+      return;
+    }
+    base::ReadOnlySharedMemoryMapping mapping =
+        data->get_read_only_shmem_region().Map();
+    if (!mapping.IsValid() ||
+        mapping.size() < media::VideoFrame::AllocationSize(
+                             info->pixel_format, info->coded_size)) {
+      return;
+    }
+    const SkImageInfo image_info = SkImageInfo::MakeN32(
+        content_rect.right(), content_rect.bottom(), kPremul_SkAlphaType,
+        info->color_space.ToSkColorSpace());
+    const size_t row_bytes = media::VideoFrame::RowBytes(
+        media::VideoFrame::Plane::kARGB, info->pixel_format,
+        info->coded_size.width());
+    if (mapping.size() < image_info.computeByteSize(row_bytes)) {
+      return;
+    }
+    SkBitmap frame;
+    frame.installPixels(image_info,
+                        const_cast<uint8_t*>(mapping.data()), row_bytes);
+    SkBitmap subset;
+    SkBitmap copy;
+    if (!frame.extractSubset(&subset, gfx::RectToSkIRect(content_rect)) ||
+        !copy.tryAllocPixels(subset.info().makeAlphaType(kPremul_SkAlphaType)) ||
+        !subset.readPixels(copy.pixmap())) {
+      return;
+    }
+    Finish(std::move(copy));
+  }
+  void OnNewCaptureVersion(const media::CaptureVersion&) override {}
+  void OnFrameWithEmptyRegionCapture() override {}
+  void OnStopped() override {}
+  void OnLog(const std::string&) override {}
+
+ private:
+  explicit HiddenTabFrameGrabber(
+      base::OnceCallback<void(const SkBitmap&)> callback)
+      : callback_(std::move(callback)) {}
+
+  void Finish(SkBitmap bitmap) {
+    if (!callback_) {
+      return;
+    }
+    capturer_->Stop();
+    std::move(callback_).Run(bitmap);
+    // Not from inside the capturer's own call.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                              this);
+  }
+
+  base::OnceCallback<void(const SkBitmap&)> callback_;
+  base::ScopedClosureRunner capture_;
+  std::unique_ptr<viz::ClientFrameSinkVideoCapturer> capturer_;
+  base::WeakPtrFactory<HiddenTabFrameGrabber> weak_factory_{this};
+};
