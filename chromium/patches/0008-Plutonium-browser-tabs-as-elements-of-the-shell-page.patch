@@ -0,0 +1,101 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/ash/main_extra_parts/plutonium_tab_presenter.h"
+
+#include <utility>
+
+#include "ash/shell.h"
+#include "base/logging.h"
+#include "base/task/sequenced_task_runner.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/aura/window.h"
+#include "ui/base/mojom/window_show_state.mojom.h"
+#include "ui/views/background.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+
+PlutoniumTabPresenter::PlutoniumTabPresenter() {
+  PlutoniumTabs::Get()->SetPresenter(this);
+  PlutoniumTabs::Get()->AddObserver(this);
+}
+
+PlutoniumTabPresenter::~PlutoniumTabPresenter() {
+  PlutoniumTabs::Get()->RemoveObserver(this);
+  PlutoniumTabs::Get()->SetPresenter(nullptr);
+  CloseWidget();
+}
+
+void PlutoniumTabPresenter::Present(content::WebContents* contents) {
+  if (!widget_) {
+    aura::Window* root = ash::Shell::GetRootWindowForNewWindows();
+    if (!root) {
+      return;
+    }
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.name = "PlutoniumTabPresentation";
+    // A normal window, in front of the shells' (the switcher stays above).
+    params.context = root;
+    params.show_state = ui::mojom::WindowShowState::kFullscreen;
+    params.activatable = views::Widget::InitParams::Activatable::kYes;
+    delegate_ = std::make_unique<views::WidgetDelegate>();
+    params.delegate = delegate_.get();
+    widget_ = std::make_unique<views::Widget>(std::move(params));
+    auto web_view =
+        std::make_unique<views::WebView>(contents->GetBrowserContext());
+    web_view->SetBackground(views::CreateSolidBackground(SK_ColorBLACK));
+    web_view_ = widget_->SetContentsView(std::move(web_view));
+    widget_observation_.Observe(widget_.get());
+  }
+  if (web_view_->web_contents() != contents) {
+    web_view_->SetWebContents(contents);
+  }
+  widget_->widget_delegate()->SetTitle(contents->GetTitle());
+  widget_->SetFullscreen(true);
+  widget_->Show();
+  widget_->Activate();
+  web_view_->RequestFocus();
+  contents->Focus();
+}
+
+void PlutoniumTabPresenter::EndPresentation() {
+  CloseWidget();
+}
+
+void PlutoniumTabPresenter::OnTabChanged(const PlutoniumTabs::TabInfo& tab) {
+  if (widget_ && tab.presented) {
+    widget_->widget_delegate()->SetTitle(tab.title);
+  }
+}
+
+void PlutoniumTabPresenter::OnWidgetDestroying(views::Widget* widget) {
+  // Closed by something else than EndPresentation().
+  widget_observation_.Reset();
+  if (web_view_) {
+    web_view_->SetWebContents(nullptr);
+    web_view_ = nullptr;
+  }
+  // It's going: not closed again by EndPresentation().
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(widget_));
+  PlutoniumTabs::Get()->EndPresentation();
+}
+
+void PlutoniumTabPresenter::CloseWidget() {
+  if (!widget_) {
+    return;
+  }
+  widget_observation_.Reset();
+  // The page goes back to the tab registry, which parks it.
+  if (web_view_) {
+    web_view_->SetWebContents(nullptr);
+    web_view_ = nullptr;
+  }
+  widget_->CloseNow();
+  widget_.reset();
+}
