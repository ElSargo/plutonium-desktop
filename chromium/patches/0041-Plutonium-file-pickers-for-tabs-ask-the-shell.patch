diff --git a/chrome/browser/plutonium_file_chooser.cc b/chrome/browser/plutonium_file_chooser.cc
new file mode 100644
index 0000000000..5311930678
--- /dev/null
+++ b/chrome/browser/plutonium_file_chooser.cc
@@ -0,0 +1,343 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/plutonium_file_chooser.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/values.h"
+#include "chrome/browser/plutonium_tab_requests.h"
+#include "chrome/browser/plutonium_tabs.h"
+#include "chrome/browser/ui/select_file_policy/chrome_select_file_policy.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tracker.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+#include "ui/shell_dialogs/select_file_policy.h"
+#include "ui/shell_dialogs/selected_file_info.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace {
+
+using From = PlutoniumTabRequests::From;
+using FallbackReason = PlutoniumTabRequests::FallbackReason;
+
+const char* ModeName(ui::SelectFileDialog::Type type) {
+  switch (type) {
+    case ui::SelectFileDialog::SELECT_OPEN_MULTI_FILE:
+      return "open-multiple";
+    case ui::SelectFileDialog::SELECT_FOLDER:
+    case ui::SelectFileDialog::SELECT_UPLOAD_FOLDER:
+    case ui::SelectFileDialog::SELECT_EXISTING_FOLDER:
+      return "folder";
+    case ui::SelectFileDialog::SELECT_SAVEAS_FILE:
+      return "save";
+    case ui::SelectFileDialog::SELECT_NONE:
+    case ui::SelectFileDialog::SELECT_OPEN_FILE:
+      return "open";
+  }
+  return "open";
+}
+
+// A tab's picker: asks the shell (a "fileChooser" tab request), and opens
+// the fallback factory's picker if no shell takes it.
+class PlutoniumSelectFileDialog : public ui::SelectFileDialog {
+ public:
+  PlutoniumSelectFileDialog(Listener* listener,
+                            std::unique_ptr<ui::SelectFilePolicy> policy,
+                            content::WebContents* contents,
+                            ui::SelectFileDialogFactory* fallback)
+      : SelectFileDialog(listener, std::move(policy)),
+        contents_(contents->GetWeakPtr()),
+        fallback_factory_(fallback) {}
+
+  PlutoniumSelectFileDialog(const PlutoniumSelectFileDialog&) = delete;
+  PlutoniumSelectFileDialog& operator=(const PlutoniumSelectFileDialog&) =
+      delete;
+
+  // ui::BaseShellDialog:
+  bool IsRunning(gfx::NativeWindow owning_window) const override {
+    if (fallback_dialog_) {
+      return fallback_dialog_->IsRunning(owning_window);
+    }
+    return handle_ && handle_->is_open() &&
+           owning_window_.Contains(owning_window);
+  }
+
+  void ListenerDestroyed() override {
+    listener_ = nullptr;
+    handle_.reset();
+    if (fallback_dialog_) {
+      fallback_dialog_->ListenerDestroyed();
+    }
+  }
+
+ protected:
+  ~PlutoniumSelectFileDialog() override = default;
+
+  // ui::SelectFileDialog:
+  void SelectFileImpl(Type type,
+                      const std::u16string& title,
+                      const base::FilePath& default_path,
+                      const FileTypeInfo* file_types,
+                      int file_type_index,
+                      const base::FilePath::StringType& default_extension,
+                      gfx::NativeWindow owning_window,
+                      const GURL* caller) override {
+    type_ = type;
+    title_ = title;
+    default_path_ = default_path;
+    file_types_.reset();
+    if (file_types) {
+      file_types_.emplace(*file_types);
+    }
+    file_type_index_ = file_type_index;
+    default_extension_ = default_extension;
+    owning_window_.RemoveAll();
+    if (owning_window) {
+      owning_window_.Add(owning_window);
+    }
+    if (caller) {
+      caller_ = *caller;
+    }
+
+    PlutoniumTabRequests::Params params;
+    params.kind = "fileChooser";
+    params.detail = Detail();
+    params.on_answer = base::BindRepeating(
+        &PlutoniumSelectFileDialog::OnAnswer, base::Unretained(this));
+    // The fallback is posted, and may arrive after the handle is gone.
+    params.on_fallback = base::BindOnce(&PlutoniumSelectFileDialog::OnFallback,
+                                        weak_factory_.GetWeakPtr());
+    // on_answer only runs while the request (our handle) is open.
+    handle_ = PlutoniumTabRequests::Get()->Start(contents_.get(),
+                                                 std::move(params));
+    if (!handle_) {
+      // Not a tab after all (it closed meanwhile).
+      PostCancel();
+    }
+  }
+
+  bool HasMultipleFileTypeChoicesImpl() override {
+    return filters_count_ > 1;
+  }
+
+ private:
+  // The request's detail (see plutonium_file_chooser.h).
+  base::DictValue Detail() {
+    base::DictValue detail;
+    detail.Set("mode", ModeName(type_));
+    detail.Set("upload", type_ == SELECT_UPLOAD_FOLDER);
+    detail.Set("title", title_);
+    if (caller_.is_valid()) {
+      detail.Set("origin", url::Origin::Create(caller_).Serialize());
+    }
+    base::ListValue filters;
+    if (file_types_) {
+      const std::vector<std::vector<base::FilePath::StringType>>& extensions =
+          file_types_->extensions;
+      for (size_t i = 0; i < extensions.size(); ++i) {
+        base::ListValue patterns;
+        for (const base::FilePath::StringType& extension : extensions[i]) {
+          patterns.Append("*." + extension);
+        }
+        std::string name;
+        if (i < file_types_->extension_description_overrides.size()) {
+          name = base::UTF16ToUTF8(
+              file_types_->extension_description_overrides[i]);
+        }
+        filters.Append(base::DictValue()
+                           .Set("name", name)
+                           .Set("patterns", std::move(patterns)));
+      }
+      if (file_types_->include_all_files && !extensions.empty()) {
+        filters.Append(
+            base::DictValue()
+                .Set("name", "")
+                .Set("patterns", base::ListValue().Append("*")));
+      }
+    }
+    filters_count_ = filters.size();
+    detail.Set("currentFilter",
+               file_type_index_ > 0 &&
+                       static_cast<size_t>(file_type_index_) <= filters_count_
+                   ? file_type_index_ - 1
+                   : 0);
+    detail.Set("filters", std::move(filters));
+    // A folder and a name, either of which may be missing: the default path
+    // is a folder, a file in one, or (Chrome's default) just a name.
+    std::string name;
+    std::string folder;
+    if (!default_path_.empty()) {
+      if (type_ == SELECT_FOLDER || type_ == SELECT_UPLOAD_FOLDER ||
+          type_ == SELECT_EXISTING_FOLDER) {
+        folder = default_path_.value();
+      } else if (default_path_.IsAbsolute()) {
+        folder = default_path_.DirName().value();
+        name = default_path_.BaseName().value();
+      } else {
+        name = default_path_.BaseName().value();
+      }
+    }
+    detail.Set("currentName", type_ == SELECT_SAVEAS_FILE ? name : "");
+    detail.Set("currentFolder", folder);
+    detail.Set("defaultExtension", default_extension_);
+    return detail;
+  }
+
+  // {paths: [...], filter?}, or null (or no paths) to cancel. False if it
+  // isn't an answer this picker takes.
+  bool OnAnswer(From from, const base::Value& answer) {
+    std::vector<ui::SelectedFileInfo> files;
+    int filter = file_type_index_;
+    if (answer.is_dict()) {
+      const base::DictValue& dict = answer.GetDict();
+      const base::ListValue* paths = dict.FindList("paths");
+      if (!paths && dict.Find("paths")) {
+        return false;
+      }
+      if (paths) {
+        for (const base::Value& value : *paths) {
+          if (!value.is_string()) {
+            return false;
+          }
+          base::FilePath path(value.GetString());
+          if (!path.IsAbsolute() || path.ReferencesParent()) {
+            return false;
+          }
+          path = path.StripTrailingSeparators();
+          if (type_ == SELECT_SAVEAS_FILE && !default_extension_.empty() &&
+              path.Extension().empty()) {
+            path = path.AddExtension(default_extension_);
+          }
+          files.emplace_back(path);
+        }
+      }
+      if (files.size() > 1 && type_ != SELECT_OPEN_MULTI_FILE) {
+        return false;
+      }
+      if (std::optional<int> index = dict.FindInt("filter")) {
+        if (*index < 0 || static_cast<size_t>(*index) >= filters_count_) {
+          return false;
+        }
+        filter = *index + 1;
+      }
+    } else if (!answer.is_none()) {
+      return false;
+    }
+    VLOG(1) << "EXO-TAB-FEATURES fileChooser answered by the "
+            << (from == From::kShell ? "shell" : "agent") << ": "
+            << files.size() << " path(s)";
+    // The listener may let go of us: tell it later, keeping us alive.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&PlutoniumSelectFileDialog::Notify,
+                                  base::WrapRefCounted(this), std::move(files),
+                                  filter));
+    return true;
+  }
+
+  void Notify(std::vector<ui::SelectedFileInfo> files, int filter) {
+    if (!listener_) {
+      return;
+    }
+    if (files.empty()) {
+      listener_->FileSelectionCanceled();
+    } else if (type_ == SELECT_OPEN_MULTI_FILE) {
+      listener_->MultiFilesSelected(files);
+    } else {
+      listener_->FileSelected(files.front(), filter);
+    }
+  }
+
+  // No shell took it: the fallback factory's picker (the Files app's).
+  void OnFallback(FallbackReason reason) {
+    if (!listener_) {
+      return;
+    }
+    if (!fallback_factory_ || !contents_) {
+      Notify({}, 0);
+      return;
+    }
+    VLOG(1) << "EXO-TAB-FEATURES fileChooser: no shell took it, opening the "
+               "fallback picker";
+    fallback_dialog_ = fallback_factory_->Create(
+        listener_, std::make_unique<ChromeSelectFilePolicy>(contents_.get()));
+    if (!fallback_dialog_) {
+      Notify({}, 0);
+      return;
+    }
+    gfx::NativeWindow owning_window = gfx::NativeWindow();
+    if (!owning_window_.windows().empty()) {
+      owning_window = owning_window_.windows().front().get();
+    }
+    fallback_dialog_->SelectFile(
+        type_, title_, default_path_,
+        file_types_ ? &file_types_.value() : nullptr, file_type_index_,
+        default_extension_, owning_window,
+        caller_.is_valid() ? &caller_ : nullptr);
+  }
+
+  void PostCancel() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PlutoniumSelectFileDialog::Notify,
+                       base::WrapRefCounted(this),
+                       std::vector<ui::SelectedFileInfo>(), 0));
+  }
+
+  base::WeakPtr<content::WebContents> contents_;
+  raw_ptr<ui::SelectFileDialogFactory, LeakedDanglingUntriaged>
+      fallback_factory_;
+  std::unique_ptr<PlutoniumTabRequests::Handle> handle_;
+  scoped_refptr<ui::SelectFileDialog> fallback_dialog_;
+
+  // What SelectFile() got, for the request and the fallback.
+  Type type_ = SELECT_NONE;
+  std::u16string title_;
+  base::FilePath default_path_;
+  std::optional<FileTypeInfo> file_types_;
+  int file_type_index_ = 0;
+  base::FilePath::StringType default_extension_;
+  aura::WindowTracker owning_window_;
+  GURL caller_;
+  size_t filters_count_ = 0;
+  base::WeakPtrFactory<PlutoniumSelectFileDialog> weak_factory_{this};
+};
+
+}  // namespace
+
+PlutoniumSelectFileDialogFactory::PlutoniumSelectFileDialogFactory(
+    std::unique_ptr<ui::SelectFileDialogFactory> fallback)
+    : fallback_(std::move(fallback)) {}
+
+PlutoniumSelectFileDialogFactory::~PlutoniumSelectFileDialogFactory() =
+    default;
+
+ui::SelectFileDialog* PlutoniumSelectFileDialogFactory::Create(
+    ui::SelectFileDialog::Listener* listener,
+    std::unique_ptr<ui::SelectFilePolicy> policy) {
+  content::WebContents* contents =
+      ChromeSelectFilePolicy::GetSourceContents(policy.get());
+  if (contents && PlutoniumTabs::Get()->IsTab(contents)) {
+    return new PlutoniumSelectFileDialog(listener, std::move(policy), contents,
+                                         fallback_.get());
+  }
+  if (fallback_) {
+    return fallback_->Create(listener, std::move(policy));
+  }
+  return nullptr;
+}
