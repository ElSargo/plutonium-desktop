@@ -127,6 +127,8 @@ class CORE_EXPORT FocusController final
   bool IsFocused() const { return is_focused_ || is_emulating_focus_; }
 
   void SetFocusEmulationEnabled(bool);
+  // Plutonium: for WebViewImpl::UpdateMayThrottleIfUndrawnFrames().
+  bool IsFocusEmulationEnabled() const { return is_emulating_focus_; }
 
   void UpdateFocusOnNavigationCommit(Frame*, bool was_focused);
 
