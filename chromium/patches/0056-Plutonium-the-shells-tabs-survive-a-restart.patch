+#ifndef CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_TAB_SESSION_H_
+#define CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_TAB_SESSION_H_
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/important_file_writer.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/plutonium_tabs.h"
+
+class Profile;
+
+namespace content {
+class WebContents;
+}
+
+// EXO-SESSION: the shells' tabs survive a restart of the browser, or a
+// crash. Every tab (its address and tags) is written to "Plutonium Tabs" in
+// the profile, a second after any change, and opened again at the next
+// start, in the threads it was in. Not saved: incognito tabs, DevTools, and
+// tabs of shells that reopen their own (T3 Code's server reopens its browser
+// panel's tabs). Each restored tab starts afresh at its address (no
+// back/forward history).
+class PlutoniumTabSession : public PlutoniumTabs::Observer,
+                            public base::ImportantFileWriter::DataSerializer {
+ public:
+  explicit PlutoniumTabSession(Profile* profile);
+  PlutoniumTabSession(const PlutoniumTabSession&) = delete;
+  PlutoniumTabSession& operator=(const PlutoniumTabSession&) = delete;
+  ~PlutoniumTabSession() override;
+
+  // Opens the saved tabs in |shell|'s profile, then keeps the file up to
+  // date. Once.
+  void Restore(content::WebContents* shell);
+
+  // PlutoniumTabs::Observer:
+  void OnTabAdded(const PlutoniumTabs::TabInfo& tab) override;
+  void OnTabChanged(const PlutoniumTabs::TabInfo& tab) override;
+  void OnTabRemoved(int32_t tab_id) override;
+
+  // base::ImportantFileWriter::DataSerializer:
+  std::optional<std::string> SerializeData() override;
+
+ private:
+  void OnRead(base::WeakPtr<content::WebContents> shell,
+              std::optional<std::string> json);
+  // Schedules writing the tabs as they are now.
+  void Schedule();
+
+  base::FilePath path_;
+  base::ImportantFileWriter writer_;
+  bool restoring_ = false;
+  // What the next write writes (taken when it's scheduled: by the time it
+  // runs, the browser may be closing its tabs).
+  std::string pending_;
+  base::ScopedObservation<PlutoniumTabs, PlutoniumTabs::Observer>
+      observation_{this};
+  base::WeakPtrFactory<PlutoniumTabSession> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_TAB_SESSION_H_
