diff --git a/chrome/browser/ui/ash/main_extra_parts/plutonium_tab_session.cc b/chrome/browser/ui/ash/main_extra_parts/plutonium_tab_session.cc
new file mode 100644
index 0000000000..fe55d3ae09
--- /dev/null
+++ b/chrome/browser/ui/ash/main_extra_parts/plutonium_tab_session.cc
@@ -0,0 +1,173 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/ash/main_extra_parts/plutonium_tab_session.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/lifetime/browser_shutdown.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/web_contents.h"
+#include "url/url_constants.h"
+
+namespace {
+
+constexpr base::FilePath::CharType kFileName[] =
+    FILE_PATH_LITERAL("Plutonium Tabs");
+constexpr char kTabsKey[] = "tabs";
+constexpr char kUrlKey[] = "url";
+constexpr char kTagsKey[] = "tags";
+constexpr char kOpenedByKey[] = "openedBy";
+
+// Origin tags of shells that reopen their own tabs: T3 Code's server
+// reopens its browser panel's.
+constexpr const char* kSelfRestoringTagPrefixes[] = {"t3:"};
+
+bool ShouldSave(const PlutoniumTabs::TabInfo& tab) {
+  if (tab.incognito || tab.opened_by == "devtools" || !tab.url.is_valid() ||
+      tab.url.IsAboutBlank()) {
+    return false;
+  }
+  for (const char* prefix : kSelfRestoringTagPrefixes) {
+    if (!tab.tags.empty() && tab.tags.front().starts_with(prefix)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::optional<std::string> ReadFile(const base::FilePath& path) {
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return std::nullopt;
+  }
+  return json;
+}
+
+}  // namespace
+
+PlutoniumTabSession::PlutoniumTabSession(Profile* profile)
+    : path_(profile->GetPath().Append(kFileName)),
+      writer_(path_,
+              base::ThreadPool::CreateSequencedTaskRunner(
+                  {base::MayBlock(),
+                   base::TaskShutdownBehavior::BLOCK_SHUTDOWN}),
+              base::Seconds(1)) {}
+
+PlutoniumTabSession::~PlutoniumTabSession() {
+  if (writer_.HasPendingWrite()) {
+    writer_.DoScheduledWrite();
+  }
+}
+
+void PlutoniumTabSession::Restore(content::WebContents* shell) {
+  if (restoring_ || observation_.IsObserving() || !shell) {
+    return;
+  }
+  restoring_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadFile, path_),
+      base::BindOnce(&PlutoniumTabSession::OnRead,
+                     weak_ptr_factory_.GetWeakPtr(), shell->GetWeakPtr()));
+}
+
+void PlutoniumTabSession::OnRead(base::WeakPtr<content::WebContents> shell,
+                                 std::optional<std::string> json) {
+  restoring_ = false;
+  PlutoniumTabs* tabs = PlutoniumTabs::Get();
+  std::optional<base::DictValue> saved =
+      json ? base::JSONReader::ReadDict(*json, base::JSON_PARSE_RFC)
+           : std::nullopt;
+  const base::ListValue* list = saved ? saved->FindList(kTabsKey) : nullptr;
+  int restored = 0;
+  if (list && shell && !browser_shutdown::HasShutdownStarted()) {
+    for (const base::Value& value : *list) {
+      const base::DictValue* entry = value.GetIfDict();
+      const std::string* url = entry ? entry->FindString(kUrlKey) : nullptr;
+      if (!url) {
+        continue;
+      }
+      std::vector<std::string> tags;
+      if (const base::ListValue* saved_tags = entry->FindList(kTagsKey)) {
+        for (const base::Value& tag : *saved_tags) {
+          if (tag.is_string()) {
+            tags.push_back(tag.GetString());
+          }
+        }
+      }
+      const std::string* opened_by = entry->FindString(kOpenedByKey);
+      std::optional<PlutoniumTabs::TabInfo> tab = tabs->CreateTab(
+          shell.get(), *url, tags.empty() ? std::string() : tags.front(),
+          opened_by ? *opened_by : std::string("shell"));
+      if (!tab) {
+        continue;
+      }
+      if (tags.size() > 1) {
+        tabs->UpdateTags(
+            tab->id, std::vector<std::string>(tags.begin() + 1, tags.end()),
+            {});
+      }
+      ++restored;
+    }
+  }
+  LOG(WARNING) << "EXO-SESSION restored " << restored << " tab(s)";
+  // From now on the file follows the tabs.
+  observation_.Observe(tabs);
+  Schedule();
+}
+
+void PlutoniumTabSession::OnTabAdded(const PlutoniumTabs::TabInfo& tab) {
+  Schedule();
+}
+
+void PlutoniumTabSession::OnTabChanged(const PlutoniumTabs::TabInfo& tab) {
+  Schedule();
+}
+
+void PlutoniumTabSession::OnTabRemoved(int32_t tab_id) {
+  Schedule();
+}
+
+void PlutoniumTabSession::Schedule() {
+  // Closing the browser closes its tabs: they're still the session.
+  if (browser_shutdown::HasShutdownStarted()) {
+    return;
+  }
+  base::ListValue list;
+  for (const PlutoniumTabs::TabInfo& tab : PlutoniumTabs::Get()->GetTabs()) {
+    if (!ShouldSave(tab)) {
+      continue;
+    }
+    base::ListValue tags;
+    for (const std::string& tag : tab.tags) {
+      tags.Append(tag);
+    }
+    list.Append(base::DictValue()
+                    .Set(kUrlKey, tab.url.spec())
+                    .Set(kTagsKey, std::move(tags))
+                    .Set(kOpenedByKey, tab.opened_by));
+  }
+  std::string json;
+  base::JSONWriter::Write(base::DictValue().Set(kTabsKey, std::move(list)),
+                          &json);
+  if (json == pending_ && !writer_.HasPendingWrite()) {
+    return;
+  }
+  pending_ = std::move(json);
+  writer_.ScheduleWrite(this);
+}
+
+std::optional<std::string> PlutoniumTabSession::SerializeData() {
+  return pending_;
+}
