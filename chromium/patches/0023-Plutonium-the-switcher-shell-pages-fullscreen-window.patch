+  void AddGroupToggles(Row::Kind kind, int32_t id) {
+    auto* groups = AddSection(u"Groups");
+    const std::vector<std::string> tags = TagsOf(kind, id);
+    const bool origin = HasOriginTag(kind, id);
+    if (PlutoniumGroups::Get()->groups().empty()) {
+      AddParagraph(groups, u"No shell has described any groups yet.", kDim);
+      return;
+    }
+    AddParagraph(groups,
+                 u"Adding it to a group (a shell's thread or workspace) "
+                 u"shows it there, and gives that thread's agent access.",
+                 kDim);
+    views::View* row = nullptr;
+    int in_row = 0;
+    for (const PlutoniumGroups::Group& group :
+         PlutoniumGroups::Get()->groups()) {
+      if (!row || in_row == 2) {
+        row = AddButtons(groups);
+        in_row = 0;
+      }
+      ++in_row;
+      const bool has = std::ranges::contains(tags, group.tag);
+      const bool fixed = origin && !tags.empty() && tags.front() == group.tag;
+      std::u16string label =
+          base::UTF8ToUTF16(group.label.empty() ? group.tag : group.label);
+      // Thread titles can be whole prompts.
+      if (label.size() > 32) {
+        label = label.substr(0, 31) + u"…";
+      }
+      const std::string shell = ShellName(group.shell_id);
+      if (!shell.empty()) {
+        label += u"  ·  " + base::UTF8ToUTF16(shell);
+      }
+      AddButton(row, (has ? u"✓ " : u"+ ") + label,
+                Bind(&PlutoniumOverlayView::ToggleGroup, kind, id, group.tag),
+                has ? ActionButton::Style::kPrimary
+                    : ActionButton::Style::kNormal,
+                !fixed);
+    }
+  }
+
+  std::u16string DescribeTags(const std::vector<std::string>& tags) const {
+    std::vector<std::u16string> parts;
+    for (const std::string& tag : tags) {
+      std::u16string label = TagLabel(tag);
+      parts.push_back(label == base::UTF8ToUTF16(tag)
+                          ? label
+                          : base::UTF8ToUTF16(tag) + u" (" + label + u")");
+    }
+    return base::JoinString(parts, u",  ");
+  }
