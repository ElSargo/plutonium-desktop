+    // Not shells' windows: OnBrowserCreated() leaves them alone.
+    opening_backup_ = true;
+    if (backup == Backup::kTerminal) {
+      content::WebContents* contents =
+          OpenAppShortcutWindow(profile_, terminal);
+      tabs::TabInterface* tab =
+          contents ? tabs::TabInterface::MaybeGetFromContents(contents)
+                   : nullptr;
+      browser = tab ? tab->GetBrowserWindowInterface() : nullptr;
+    } else {
+      browser = chrome::OpenEmptyWindow(profile_,
+                                        /*should_trigger_session_restore=*/
+                                        false);
+    }
+    opening_backup_ = false;
+    if (!browser) {
+      LOG(ERROR) << "EXO-SHELLS could not open the backup "
+                 << (backup == Backup::kTerminal ? "terminal" : "browser");
+      return false;
+    }
+    LOG(WARNING) << "EXO-SHELLS opened the backup "
+                 << (backup == Backup::kTerminal ? "terminal" : "browser");
+    if (backup == Backup::kBrowser && url.is_empty() &&
+        !browser->GetActiveTabInterface()) {
+      chrome::AddTabAt(browser, GURL(), -1, /*foreground=*/true);
+    }
+  }
+  if (backup == Backup::kBrowser && url.is_valid()) {
+    chrome::AddTabAt(browser, url, -1, /*foreground=*/true);
