+
+void PlutoniumOverlay::MaybePresentLaunched(int32_t window_id,
+                                            const std::string& thread) {
+  if (thread != kLaunchThread || !IsLaunching()) {
+    return;
+  }
+  launch_deadline_ = base::TimeTicks();
+  broker_observation_.Reset();
+  if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+    // Name its origin for every shell, if the browser couldn't.
+    broker->SetOriginTag(window_id, thread);
+  }
+  Close(/*acted=*/true);
+  exo::EmbeddedWindows::Get()->Present(window_id);
+  VLOG(1) << "EXO-SHELLS presenting launched window #" << window_id;
+}
