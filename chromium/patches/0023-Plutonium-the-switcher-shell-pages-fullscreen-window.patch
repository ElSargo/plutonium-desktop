+views::Label* AddLabel(views::View* parent,
+                       std::u16string_view text,
+                       SkColor color,
+                       int size_delta = 0,
+                       bool bold = false,
+                       bool multi_line = false) {
+  auto* label = parent->AddChildView(std::make_unique<views::Label>(text));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetAutoColorReadabilityEnabled(false);
+  label->SetEnabledColor(color);
+  gfx::FontList font = gfx::FontList().DeriveWithSizeDelta(size_delta);
+  if (bold) {
+    font = font.DeriveWithWeight(gfx::Font::Weight::BOLD);
+  }
+  label->SetFontList(font);
+  if (multi_line) {
+    label->SetMultiLine(true);
+  } else {
+    label->SetElideBehavior(gfx::ELIDE_TAIL);
+  }
+  return label;
+}
