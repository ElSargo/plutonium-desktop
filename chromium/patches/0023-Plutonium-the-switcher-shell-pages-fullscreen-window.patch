+  void AddSnapshot(views::View* parent,
+                   bool request,
+                   bool is_window,
+                   int32_t id) {
+    auto* box = AddBox(parent, views::BoxLayout::Orientation::kVertical, 6);
+    if (snapshot_.drawsNothing()) {
+      AddLabel(box, request ? u"Taking a snapshot…" : u"No snapshot", kDim);
+    } else {
+      // Fit into 560×320.
+      const float scale = std::min(
+          {1.f, 560.f / snapshot_.width(), 320.f / snapshot_.height()});
+      auto* image = box->AddChildView(std::make_unique<views::ImageView>());
+      image->SetImage(ui::ImageModel::FromImageSkia(
+          gfx::ImageSkia::CreateFrom1xBitmap(snapshot_)));
+      image->SetImageSize(gfx::Size(snapshot_.width() * scale,
+                                    snapshot_.height() * scale));
+      image->SetHorizontalAlignment(views::ImageView::Alignment::kLeading);
+      snapshot_view_ = image;
+    }
+    if (request) {
+      TakeSnapshot(is_window, id);
+    }
+  }
+
+  void TakeSnapshot(bool is_window, int32_t id) {
+    auto callback = base::BindOnce(&PlutoniumOverlayView::OnSnapshot,
+                                   weak_ptr_factory_.GetWeakPtr(), page_key_);
+    if (is_window) {
+      exo::EmbeddedWindows::Get()->Snapshot(id, std::move(callback));
+    } else {
+      PlutoniumTabs::Get()->Snapshot(id, std::move(callback));
+    }
+  }
+
+  void OnSnapshot(const std::string& key, const SkBitmap& bitmap) {
+    if (key != page_key_) {
+      return;
+    }
+    snapshot_ = bitmap;
+    ++snapshot_generation_;
+    UpdatePage(/*force=*/false);
+  }
+
+  void RefreshSnapshot(bool is_window, int32_t id) {
+    TakeSnapshot(is_window, id);
+  }
