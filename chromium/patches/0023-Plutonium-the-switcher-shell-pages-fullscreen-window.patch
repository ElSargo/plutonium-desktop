+}
+
+void PlutoniumOverlay::OnWindowAdded(const ExoWindowBroker::WindowInfo& window) {
+  if (!IsLaunching()) {
+    broker_observation_.Reset();
+    launch_deadline_ = base::TimeTicks();
+    return;
+  }
+  if (std::ranges::contains(window.tags, kLaunchThread)) {
+    MaybePresentLaunched(window.id, kLaunchThread);
+    return;
+  }
+  if (!window.tags.empty() || window.pid <= 0) {
+    return;
+  }
+  // The browser couldn't read its client's environment (Ash in a
+  // container): the helper can.
+  plutonium_helper::Get(
+      "/v1/window-threads?pids=" + base::NumberToString(window.pid),
+      base::BindOnce(
+          [](base::WeakPtr<PlutoniumOverlay> overlay, int32_t window_id,
+             int32_t pid, std::optional<base::Value> value,
+             const std::string& error) {
+            const std::string* thread =
+                value && value->is_dict()
+                    ? value->GetDict().FindString(base::NumberToString(pid))
+                    : nullptr;
+            if (overlay && thread) {
+              overlay->MaybePresentLaunched(window_id, *thread);
+            }
+          },
+          weak_ptr_factory_.GetWeakPtr(), window.id, window.pid));
