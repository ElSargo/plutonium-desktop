+      return;
+    }
+    if (!shell->enabled) {
+      shells_->SetEnabled(id, true);
+      SetStatus(u"Starting " + base::UTF8ToUTF16(shell->name) +
+                    u"… Its window opens hidden; switch to it once it's "
+                    u"running.",
+                /*error=*/false);
+    } else if (shell->running && shells_->Show(id)) {
+      overlay_->Close(/*acted=*/true);
+    }
+  }
+
+  void ToggleShell(const std::string& id) {
+    std::optional<PlutoniumShells::Shell> shell = FindShell(id);
+    if (shell && !shells_->SetEnabled(id, !shell->enabled)) {
+      SetStatus(u"The last running shell can't be stopped.");
+    }
+  }
+
+  void RemoveShell(const std::string& id) {
+    std::optional<PlutoniumShells::Shell> shell = FindShell(id);
+    if (!shell) {
+      return;
+    }
+    if (shell->enabled) {
+      SetStatus(u"Stop it first, then remove it.");
+      return;
+    }
+    if (confirm_remove_id_ != id) {
+      confirm_remove_id_ = id;
+      UpdatePage(/*force=*/true);
+      return;
+    }
+    confirm_remove_id_.clear();
+    shells_->RemoveShell(id);
+    SetStatus(base::UTF8ToUTF16(shell->name) + u" is gone.", /*error=*/false);
+  }
