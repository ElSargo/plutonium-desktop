+      AddButton(actions, u"Open fullscreen",
+                Bind(&PlutoniumOverlayView::Present, id),
+                ActionButton::Style::kPrimary);
+    }
+    AddButton(actions, u"Pop out to the desktop",
+              Bind(&PlutoniumOverlayView::PopOut, id),
+              ActionButton::Style::kNormal, !(info && info->on_desktop));
+    AddButton(actions, u"Close", Bind(&PlutoniumOverlayView::CloseWindow, id),
+              ActionButton::Style::kDanger);
+
+    // The shells that show it, and the others.
+    auto* shells = AddSection(u"In the shells");
+    const std::vector<std::string> showing = ShellsShowing(id);
+    std::string owner;
+    for (const std::string& tag : window->tags) {
+      if (std::optional<PlutoniumGroups::Group> group =
+              PlutoniumGroups::Get()->Find(tag)) {
+        owner = group->shell_id;
+        break;
+      }
+    }
+    for (const PlutoniumShells::Shell& shell : shells_->GetShells()) {
+      if (!shell.running) {
+        continue;
+      }
+      const bool shows = std::ranges::contains(showing, shell.id);
+      auto* row = AddButtons(shells);
+      std::u16string what = shows ? u"shows it"
+                            : shell.id == owner
+                                ? u"its group's shell; doesn't show it now"
+                                : u"doesn't show it";
+      views::Label* name = AddLabel(
+          row, base::UTF8ToUTF16(shell.name) + u"  —  " + what,
+          shows ? kTitle : kDim, 1);
+      name->SetPreferredSize(
+          gfx::Size(360, name->GetPreferredSize(views::SizeBounds()).height()));
+      AddButton(row, u"Focus it in " + base::UTF8ToUTF16(shell.name),
+                Bind(&PlutoniumOverlayView::FocusWindowIn, id, shell.id),
+                shows ? ActionButton::Style::kPrimary
+                      : ActionButton::Style::kNormal);
+    }
+    if (showing.empty()) {
+      AddParagraph(shells,
+                   u"No shell shows it right now. Focusing it in one asks "
+                   u"that shell to show it; one that can't pops it out.",
+                   kDim);
+    }
+
+    auto* inspect = AddSection(u"Inspect");
+    AddSnapshot(inspect, request_snapshot, /*is_window=*/true, id);
+    auto* refresh = AddButtons(inspect);
+    AddButton(refresh, u"New snapshot",
+              Bind(&PlutoniumOverlayView::RefreshSnapshot, true, id));
+    AddField(inspect, u"Window id", base::NumberToString16(window->id));
+    AddField(inspect, u"App id", base::UTF8ToUTF16(window->app_id));
+    AddField(inspect, u"Process",
+             window->pid > 0 ? base::NumberToString16(window->pid)
+                             : u"unknown");
+    AddField(inspect, u"Size",
+             base::NumberToString16(window->size.width()) + u" × " +
+                 base::NumberToString16(window->size.height()) + u" at " +
+                 base::UTF8ToUTF16(
+                     base::NumberToString(window->device_scale_factor)) +
+                 u"×");
+    AddField(inspect, u"Keyboard focus", window->focused ? u"yes" : u"no");
+    AddField(inspect, u"Started in",
+             window->tag.empty() ? u"unknown" : TagLabel(window->tag));
+    AddField(inspect, u"Tags", DescribeTags(window->tags));
+    AddGroupToggles(Row::Kind::kWindow, id);
+  }
