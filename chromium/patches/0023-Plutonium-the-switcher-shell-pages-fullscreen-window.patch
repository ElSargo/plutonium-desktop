+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_HELPER_CLIENT_H_
+#define CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_HELPER_CLIENT_H_
+
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/values.h"
+
+// EXO-SHELLS: the shells overlay's line to the session's helper (plutoniumd),
+// over its Unix socket (--plutonium-helper-socket, mode 0600: this user's
+// processes have the helper's whole local API). The overlay lists desktop
+// apps and starts them through it, which works whether or not any shell
+// does.
+namespace plutonium_helper {
+
+// Whether the command line names the helper's socket.
+bool IsAvailable();
+
+// The JSON answer to a request, or nullopt if the helper couldn't be reached,
+// answered with an error, or sent something else. |error| says why.
+using Callback = base::OnceCallback<void(std::optional<base::Value> value,
+                                         const std::string& error)>;
+
+void Get(const std::string& path, Callback callback);
+void Post(const std::string& path, base::DictValue body, Callback callback);
+
+}  // namespace plutonium_helper
+
+#endif  // CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_HELPER_CLIENT_H_
