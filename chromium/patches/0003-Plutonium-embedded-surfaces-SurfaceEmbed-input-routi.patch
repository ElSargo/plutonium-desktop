+TEST_F(RenderWidgetHostInputEventRouterTest, NoForeignSinksWithoutDelegate) {
+  EXPECT_FALSE(IsForeignFrameSinkEmbeddedHere(kNativeWindowSink));
+}
+
+TEST_F(RenderWidgetHostInputEventRouterTest, ForeignSinkLinkedToThisPage) {
+  FakeForeignFrameSinkDelegate delegate;
+  EXPECT_FALSE(IsForeignFrameSinkEmbeddedHere(kNativeWindowSink));
+  delegate.Link(kNativeWindowSink, view_root_->GetFrameSinkId());
+  EXPECT_TRUE(IsForeignFrameSinkEmbeddedHere(kNativeWindowSink));
+  // Only that window.
+  EXPECT_FALSE(IsForeignFrameSinkEmbeddedHere(kOtherNativeWindowSink));
+  EXPECT_FALSE(IsForeignFrameSinkEmbeddedHere(viz::FrameSinkId()));
+  delegate.Unlink(kNativeWindowSink, view_root_->GetFrameSinkId());
+  EXPECT_FALSE(IsForeignFrameSinkEmbeddedHere(kNativeWindowSink));
+}
+
+TEST_F(RenderWidgetHostInputEventRouterTest, ForeignSinkLinkedToAChildView) {
+  FakeForeignFrameSinkDelegate delegate;
+  ChildViewState child = MakeChildView(view_root_.get());
+  delegate.Link(kNativeWindowSink, child.view->GetFrameSinkId());
+  EXPECT_TRUE(IsForeignFrameSinkEmbeddedHere(kNativeWindowSink));
+  rwhier()->OnRenderWidgetHostViewInputDestroyed(child.view.get());
+  EXPECT_FALSE(IsForeignFrameSinkEmbeddedHere(kNativeWindowSink));
+}
+
+TEST_F(RenderWidgetHostInputEventRouterTest, ForeignSinkLinkedToAnotherPage) {
+  FakeForeignFrameSinkDelegate delegate;
+  // A view this router doesn't have (another tab's).
+  delegate.Link(kNativeWindowSink, viz::FrameSinkId(77, 1));
+  EXPECT_FALSE(IsForeignFrameSinkEmbeddedHere(kNativeWindowSink));
+}
+
+TEST_F(RenderWidgetHostInputEventRouterTest, OwnViewsAreNeverForeign) {
+  FakeForeignFrameSinkDelegate delegate;
+  ChildViewState child = MakeChildView(view_root_.get());
+  delegate.Link(child.view->GetFrameSinkId(), view_root_->GetFrameSinkId());
+  EXPECT_FALSE(IsForeignFrameSinkEmbeddedHere(child.view->GetFrameSinkId()));
+  rwhier()->OnRenderWidgetHostViewInputDestroyed(child.view.get());
+}
+
+TEST_F(RenderWidgetHostInputEventRouterTest, RouteToForeignChecksTheLink) {
+  FakeForeignFrameSinkDelegate delegate;
+  blink::WebMouseEvent down =
+      blink::SyntheticWebMouseEventBuilder::Build(
+          blink::WebInputEvent::Type::kMouseDown, 5, 5, 0);
+  down.button = blink::WebPointerProperties::Button::kLeft;
+  RouteToForeign(kNativeWindowSink, down);
+  EXPECT_TRUE(delegate.routed.empty());
+
+  delegate.Link(kNativeWindowSink, view_root_->GetFrameSinkId());
+  RouteToForeign(kNativeWindowSink, down);
+  ASSERT_EQ(1u, delegate.routed.size());
+  EXPECT_EQ(kNativeWindowSink, delegate.routed[0]);
+}
+
+// A drag that started on a window loses its capture when the link goes (the
+// grant was revoked mid-drag).
+TEST_F(RenderWidgetHostInputEventRouterTest, ForeignCaptureEndsWithTheLink) {
+  FakeForeignFrameSinkDelegate delegate;
+  delegate.Link(kNativeWindowSink, view_root_->GetFrameSinkId());
+  foreign_capture_sink() = kNativeWindowSink;
+  delegate.Unlink(kNativeWindowSink, view_root_->GetFrameSinkId());
+  blink::WebMouseEvent move = blink::SyntheticWebMouseEventBuilder::Build(
+      blink::WebInputEvent::Type::kMouseMove, 6, 6,
+      blink::WebInputEvent::kLeftButtonDown);
+  RouteToForeign(kNativeWindowSink, move);
+  EXPECT_TRUE(delegate.routed.empty());
+  EXPECT_FALSE(foreign_capture_sink().is_valid());
+}
+
+// Just outside a floating window (its client-side resize edges), the page's
+// renderer is asked whether the press is the window's; elsewhere on the page
+// it isn't, and touch never is.
+TEST_F(RenderWidgetHostInputEventRouterTest, ForeignResizeEdgeQueriesRenderer) {
+  FakeForeignFrameSinkDelegate delegate;
+  view_root_->SetHittestResult(view_root_.get(), false);
+  const gfx::PointF edge(100, 50);
+  EXPECT_FALSE(QueriesRendererAt(edge, viz::EventSource::MOUSE));
+
+  delegate.edge_parent = view_root_->GetFrameSinkId();
+  delegate.edge_point = edge;
+  EXPECT_TRUE(QueriesRendererAt(edge, viz::EventSource::MOUSE));
+  EXPECT_FALSE(QueriesRendererAt(gfx::PointF(10, 10), viz::EventSource::MOUSE));
+  EXPECT_FALSE(QueriesRendererAt(edge, viz::EventSource::TOUCH));
+}
