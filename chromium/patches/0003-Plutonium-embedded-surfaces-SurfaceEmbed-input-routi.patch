+constexpr int kMouseButtonModifiers = blink::WebInputEvent::kLeftButtonDown |
+                                      blink::WebInputEvent::kMiddleButtonDown |
+                                      blink::WebInputEvent::kRightButtonDown;
+
+int ButtonToModifier(blink::WebPointerProperties::Button button) {
+  switch (button) {
+    case blink::WebPointerProperties::Button::kLeft:
+      return blink::WebInputEvent::kLeftButtonDown;
+    case blink::WebPointerProperties::Button::kMiddle:
+      return blink::WebInputEvent::kMiddleButtonDown;
+    case blink::WebPointerProperties::Button::kRight:
+      return blink::WebInputEvent::kRightButtonDown;
+    default:
+      return 0;
+  }
+}
+
+// Whether any of left/middle/right stays pressed after |event|.
+bool ButtonsDownAfter(const blink::WebMouseEvent& event) {
+  int buttons = event.GetModifiers() & kMouseButtonModifiers;
+  if (event.GetType() == blink::WebInputEvent::Type::kMouseUp) {
+    buttons &= ~ButtonToModifier(event.button);
+  } else if (event.GetType() == blink::WebInputEvent::Type::kMouseDown) {
+    buttons |= ButtonToModifier(event.button);
+  }
+  return buttons;
+}
