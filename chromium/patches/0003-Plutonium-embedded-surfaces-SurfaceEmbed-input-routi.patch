+// static
+void RenderWidgetHostInputEventRouter::SetForeignFrameSinkDelegate(
+    ForeignFrameSinkDelegate* delegate) {
+  ForeignDelegate() = delegate;
+}
+
+// static
+bool RenderWidgetHostInputEventRouter::HandForeignDragToPage(
+    const viz::FrameSinkId& frame_sink_id) {
+  // A drag on the sink made it the hover sink of the router that routes it.
+  auto it = ForeignHoverRouters().find(frame_sink_id);
+  if (it == ForeignHoverRouters().end() ||
+      it->second->foreign_capture_sink_ != frame_sink_id) {
+    return false;
+  }
+  RenderWidgetHostInputEventRouter* router = it->second;
+  VLOG(1) << "EXO-EMBED drag on " << frame_sink_id.ToString()
+          << " handed to the page";
+  router->foreign_capture_sink_ = viz::FrameSinkId();
+  // As a drag that started on page content: foreign sinks get nothing until
+  // the buttons are released (OnPageMouseEvent() clears it), and the page
+  // has the mouse captured, so neither a tab nor the window under the pointer
+  // gets the moves or the release.
+  router->page_mouse_down_ = true;
+  router->mouse_capture_target_ = router->foreign_hover_root_view_;
+  router->ForeignHoverLeave();
+  return true;
+}
+
+// static
+void RenderWidgetHostInputEventRouter::SetForeignFrameSinkCursor(
+    const viz::FrameSinkId& frame_sink_id,
+    const ui::Cursor& cursor) {
+  auto it = ForeignHoverRouters().find(frame_sink_id);
+  if (it == ForeignHoverRouters().end()) {
+    return;
+  }
+  RenderWidgetHostViewInput* root_view = it->second->foreign_hover_root_view_;
+  if (root_view && root_view->GetCursorManager()) {
+    root_view->GetCursorManager()->SetForeignCursor(cursor);
+  }
+}
+
+bool RenderWidgetHostInputEventRouter::MaybeRouteToForeignFrameSink(
+    RenderWidgetHostViewInput* root_view,
+    const blink::WebMouseEvent& event) {
+  if (!ForeignDelegate()) {
+    return false;
+  }
+  const auto type = event.GetType();
+  if (type == blink::WebInputEvent::Type::kMouseLeave) {
+    ForeignHoverLeave();
+    return false;
+  }
+  if (type != blink::WebInputEvent::Type::kMouseMove &&
+      type != blink::WebInputEvent::Type::kMouseDown &&
+      type != blink::WebInputEvent::Type::kMouseUp &&
+      type != blink::WebInputEvent::Type::kMouseWheel) {
+    return false;
+  }
+  // Keep event order: while the targeter is resolving earlier events
+  // asynchronously, later ones queue behind them (see FindViewAtLocation()).
+  if (event_targeter_->HasEventsPendingDispatch()) {
+    return false;
+  }
+  if (RouteToForeignCapture(root_view, event)) {
+    return true;
+  }
+  // A drag that started on page content stays with the page.
+  if (page_mouse_down_) {
+    return false;
+  }
+
+  viz::HitTestQuery* query =
+      GetHitTestQuery(hit_test_provider_, root_view->GetRootFrameSinkId());
+  if (!query) {
+    return false;
+  }
+  float device_scale_factor = root_view->GetDeviceScaleFactor();
+  viz::Target target = query->FindTargetForLocationStartingFrom(
+      viz::EventSource::MOUSE,
+      gfx::ConvertPointToPixels(event.PositionInWidget(), device_scale_factor),
+      root_view->GetFrameSinkId());
+  // Foreign sinks are those without a view. Regions that viz marks "ask"
+  // (page content may overlap the sink) go through the targeter, which asks
+  // the renderer; see RouteToForeignFrameSink(). EXO-BROKER: only sinks the
+  // browser linked to one of this page's widgets (after checking a grant)
+  // take input.
+  if (type == blink::WebInputEvent::Type::kMouseDown) {
+    VLOG(1) << "EXO-EMBED down hit " << target.frame_sink_id.ToString()
+            << " flags " << target.flags << " foreign "
+            << IsForeignFrameSink(target.frame_sink_id) << " here "
+            << IsForeignFrameSinkEmbeddedHere(target.frame_sink_id);
+    // EXO-EMBED: the aggregated hit-test tree this press was targeted with.
+    VLOG(2) << "EXO-EMBED hit-test data at "
+            << gfx::ConvertPointToPixels(event.PositionInWidget(),
+                                         device_scale_factor)
+                   .ToString()
+            << ":\n"
+            << query->PrintHitTestData();
+  }
+  if (!IsForeignFrameSinkEmbeddedHere(target.frame_sink_id) ||
+      (target.flags & viz::HitTestRegionFlags::kHitTestAsk)) {
+    return false;
+  }
+  if (type == blink::WebInputEvent::Type::kMouseDown) {
+    foreign_capture_sink_ = target.frame_sink_id;
+  }
+  RouteToForeign(
+      root_view, target.frame_sink_id,
+      gfx::ConvertPointToDips(target.location_in_target, device_scale_factor),
+      event);
+  return true;
+}
+
+bool RenderWidgetHostInputEventRouter::IsForeignFrameSink(
+    const viz::FrameSinkId& frame_sink_id) const {
+  return ForeignDelegate() && frame_sink_id.is_valid() &&
+         !owner_map_.contains(frame_sink_id);
+}
+
+bool RenderWidgetHostInputEventRouter::IsForeignFrameSinkEmbeddedHere(
+    const viz::FrameSinkId& frame_sink_id) const {
+  if (!IsForeignFrameSink(frame_sink_id)) {
+    return false;
+  }
+  for (const auto& [view_frame_sink_id, view] : owner_map_) {
+    if (ForeignDelegate()->IsEmbeddedIn(frame_sink_id, view_frame_sink_id)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool RenderWidgetHostInputEventRouter::RouteToForeignCapture(
+    RenderWidgetHostViewInput* root_view,
+    const blink::WebMouseEvent& event) {
+  if (!foreign_capture_sink_.is_valid() ||
+      event.GetType() == blink::WebInputEvent::Type::kMouseDown ||
+      event.GetType() == blink::WebInputEvent::Type::kMouseLeave) {
+    return false;
+  }
+  viz::FrameSinkId sink = foreign_capture_sink_;
+  const bool ends = !ButtonsDownAfter(event);
+  if (ends) {
+    foreign_capture_sink_ = viz::FrameSinkId();
+  }
+  RouteToForeignSink(root_view, sink, event);
+  // A drag that ends outside the window leaves it now (wl_pointer.leave), as
+  // on other compositors, rather than at the next move.
+  if (ends && HitTestFrameSink(root_view, event) != sink) {
+    ForeignHoverLeave();
+  }
+  return true;
+}
+
+viz::FrameSinkId RenderWidgetHostInputEventRouter::HitTestFrameSink(
+    RenderWidgetHostViewInput* root_view,
+    const blink::WebMouseEvent& event) {
+  viz::HitTestQuery* query =
+      GetHitTestQuery(hit_test_provider_, root_view->GetRootFrameSinkId());
+  if (!query) {
+    return viz::FrameSinkId();
+  }
+  return query
+      ->FindTargetForLocationStartingFrom(
+          viz::EventSource::MOUSE,
+          gfx::ConvertPointToPixels(event.PositionInWidget(),
+                                    root_view->GetDeviceScaleFactor()),
+          root_view->GetFrameSinkId())
+      .frame_sink_id;
+}
+
+// EXO-EMBED: the rest of a wheel sequence (phases changed/ended, momentum)
+// goes where its first event went. The targeter only hit-tests the first one
+// and sends the others to |wheel_target_|, a view; a native window has none,
+// so they were dropped, and an app only saw the first event of each scroll.
+bool RenderWidgetHostInputEventRouter::RouteWheelToForeignLatch(
+    RenderWidgetHostViewInput* root_view,
+    const blink::WebMouseWheelEvent& event) {
+  if (!foreign_wheel_sink_.is_valid()) {
+    return false;
+  }
+  const bool starts =
+      event.phase == blink::WebMouseWheelEvent::kPhaseBegan ||
+      event.phase == blink::WebMouseWheelEvent::kPhaseMayBegin;
+  const bool unlatched =
+      event.phase == blink::WebMouseWheelEvent::kPhaseNone &&
+      event.momentum_phase == blink::WebMouseWheelEvent::kPhaseNone;
+  if (starts || unlatched) {
+    foreign_wheel_sink_ = viz::FrameSinkId();
+    return false;
+  }
+  RouteToForeignSink(root_view, foreign_wheel_sink_, event);
+  return true;
+}
+
+void RenderWidgetHostInputEventRouter::RouteToForeignSink(
+    RenderWidgetHostViewInput* root_view,
+    const viz::FrameSinkId& sink,
+    const blink::WebMouseEvent& event) {
+  // Map the point through the page's view: the sink may also be embedded
+  // elsewhere (e.g. by Ash, for the parked window), and the point may be
+  // outside the sink.
+  viz::HitTestQuery* query =
+      GetHitTestQuery(hit_test_provider_, root_view->GetRootFrameSinkId());
+  gfx::Transform to_view;
+  if (!query ||
+      !query->GetTransformToTarget(root_view->GetFrameSinkId(), &to_view)) {
+    return;  // The page went away; drop the rest of the drag.
+  }
+  float device_scale_factor = root_view->GetDeviceScaleFactor();
+  gfx::PointF point = gfx::ConvertPointToPixels(event.PositionInWidget(),
+                                                device_scale_factor);
+  gfx::PointF in_root = to_view.InverseMapPoint(point).value_or(point);
+  gfx::PointF in_sink;
+  if (!query->TransformLocationForTarget(
+          {sink, root_view->GetFrameSinkId(), root_view->GetRootFrameSinkId()},
+          in_root, &in_sink)) {
+    return;  // The sink went away; drop the rest of the drag.
+  }
+  RouteToForeign(root_view, sink,
+                 gfx::ConvertPointToDips(in_sink, device_scale_factor), event);
+}
+
+bool RenderWidgetHostInputEventRouter::RouteToForeignFrameSink(
+    RenderWidgetHostViewInput* root_view,
+    RenderWidgetHostViewInput* queried_view,
+    const viz::FrameSinkId& frame_sink_id,
+    const gfx::PointF& location,
+    const blink::WebInputEvent& event) {
+  if (!blink::WebInputEvent::IsMouseEventType(event.GetType()) &&
+      event.GetType() != blink::WebInputEvent::Type::kMouseWheel) {
+    return false;
+  }
+  const auto& mouse_event = static_cast<const blink::WebMouseEvent&>(event);
+  if (RouteToForeignCapture(root_view, mouse_event)) {
+    return true;
+  }
+  // As in RouteMouseEvent(): a drag that started on page content, or that a
+  // window handed to the page (HandForeignDragToPage()), stays with the page.
+  if (page_mouse_down_) {
+    return false;
+  }
+  if (event.GetType() == blink::WebInputEvent::Type::kMouseDown) {
+    VLOG(1) << "EXO-EMBED queried down " << frame_sink_id.ToString()
+            << " foreign " << IsForeignFrameSink(frame_sink_id);
+  }
+  if (!IsForeignFrameSink(frame_sink_id) ||
+      !ForeignDelegate()->IsEmbeddedIn(frame_sink_id,
+                                       queried_view->GetFrameSinkId())) {
+    return false;
+  }
+  if (event.GetType() == blink::WebInputEvent::Type::kMouseDown) {
+    foreign_capture_sink_ = frame_sink_id;
+  }
+  RouteToForeign(root_view, frame_sink_id, location, mouse_event);
+  return true;
+}
+
+void RenderWidgetHostInputEventRouter::RouteToForeign(
+    RenderWidgetHostViewInput* root_view,
+    const viz::FrameSinkId& frame_sink_id,
+    const gfx::PointF& location,
+    const blink::WebMouseEvent& event) {
+  // EXO-BROKER: the last check before input reaches a native window. Every
+  // caller has checked already; this also covers a capture or hover that
+  // outlived the link (grant revoked mid-drag).
+  if (!IsForeignFrameSinkEmbeddedHere(frame_sink_id)) {
+    if (foreign_capture_sink_ == frame_sink_id) {
+      foreign_capture_sink_ = viz::FrameSinkId();
+    }
+    return;
+  }
+  page_mouse_down_ = false;
+  if (event.GetType() == blink::WebInputEvent::Type::kMouseWheel) {
+    const auto& wheel = static_cast<const blink::WebMouseWheelEvent&>(event);
+    if (wheel.phase == blink::WebMouseWheelEvent::kPhaseBegan ||
+        wheel.phase == blink::WebMouseWheelEvent::kPhaseMayBegin) {
+      foreign_wheel_sink_ = frame_sink_id;
+      wheel_target_ = nullptr;
+    }
+  }
+  if (foreign_hover_sink_ != frame_sink_id) {
+    ForeignHoverLeave();
+    foreign_hover_sink_ = frame_sink_id;
+    foreign_hover_root_view_ = root_view;
+    ForeignHoverRouters()[frame_sink_id] = this;
+  }
+  ForeignDelegate()->RouteMouseEvent(frame_sink_id, location, event);
+}
+
+void RenderWidgetHostInputEventRouter::OnPageMouseEvent(
+    const blink::WebMouseEvent& event) {
+  if (!ForeignDelegate()) {
+    return;
+  }
+  ForeignHoverLeave();
