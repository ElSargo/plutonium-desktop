+////////////////////////////////////////////////////////////////////////////////
+// xdg_wm_dialog_v1_interface:
+
+// EXO-MODAL: a toplevel's dialog object, which says whether it is modal to its
+// parent. Destroying it undoes that.
+class WaylandXdgDialog {
+ public:
+  explicit WaylandXdgDialog(WaylandToplevel* toplevel)
+      : toplevel_(toplevel->GetWeakPtr()) {
+    toplevel->set_has_dialog(true);
+  }
+  WaylandXdgDialog(const WaylandXdgDialog&) = delete;
+  WaylandXdgDialog& operator=(const WaylandXdgDialog&) = delete;
+  ~WaylandXdgDialog() {
+    if (toplevel_) {
+      toplevel_->SetModalToParent(false);
+      toplevel_->set_has_dialog(false);
+    }
+  }
+
+  void SetModal(bool modal) {
+    if (toplevel_) {
+      toplevel_->SetModalToParent(modal);
+    }
+  }
+
+ private:
+  base::WeakPtr<WaylandToplevel> toplevel_;
+};
+
+void xdg_dialog_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void xdg_dialog_set_modal(wl_client* client, wl_resource* resource) {
+  GetUserDataAs<WaylandXdgDialog>(resource)->SetModal(true);
+}
+
+void xdg_dialog_unset_modal(wl_client* client, wl_resource* resource) {
+  GetUserDataAs<WaylandXdgDialog>(resource)->SetModal(false);
+}
+
+const struct xdg_dialog_v1_interface xdg_dialog_implementation = {
+    .destroy = xdg_dialog_destroy,
+    .set_modal = xdg_dialog_set_modal,
+    .unset_modal = xdg_dialog_unset_modal,
+};
+
+void xdg_wm_dialog_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void xdg_wm_dialog_get_xdg_dialog(wl_client* client,
+                                  wl_resource* resource,
+                                  uint32_t id,
+                                  wl_resource* toplevel_resource) {
+  auto* toplevel = GetUserDataAs<WaylandToplevel>(toplevel_resource);
+  if (toplevel->has_dialog()) {
+    wl_resource_post_error(resource, XDG_WM_DIALOG_V1_ERROR_ALREADY_USED,
+                           "the toplevel already has a dialog object");
+    return;
+  }
+  wl_resource* dialog_resource = wl_resource_create(
+      client, &xdg_dialog_v1_interface, wl_resource_get_version(resource), id);
+  if (!dialog_resource) {
+    wl_client_post_no_memory(client);
+    return;
+  }
+  SetImplementation(dialog_resource, &xdg_dialog_implementation,
+                    std::make_unique<WaylandXdgDialog>(toplevel));
+}
+
+const struct xdg_wm_dialog_v1_interface xdg_wm_dialog_implementation = {
+    .destroy = xdg_wm_dialog_destroy,
+    .get_xdg_dialog = xdg_wm_dialog_get_xdg_dialog,
+};
+
 }  // namespace
 
