+int32_t EmbeddedWindows::FindModalChild(int32_t window_id) const {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  if (!shell_surface || !shell_surface->GetWidget()) {
+    return 0;
+  }
+  aura::Window* window = shell_surface->GetWidget()->GetNativeWindow();
+  int32_t child = 0;
+  for (const auto& [id, entry] : windows_) {
+    if (entry.shell_surface->modal_parent() == window &&
+        entry.shell_surface->GetWidget() &&
+        entry.shell_surface->GetSurfaceId().is_valid()) {
+      child = id;
+    }
+  }
+  return child;
+}
+
+int32_t EmbeddedWindows::FindModalParent(int32_t window_id) const {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  aura::Window* parent =
+      shell_surface ? shell_surface->modal_parent() : nullptr;
+  if (!parent) {
+    return 0;
+  }
+  for (const auto& [id, entry] : windows_) {
+    if (entry.shell_surface->GetWidget() &&
+        entry.shell_surface->GetWidget()->GetNativeWindow() == parent) {
+      return id;
+    }
+  }
+  return 0;
+}
+
+int32_t EmbeddedWindows::ModalFocusTarget(int32_t window_id) const {
+  // Exo refuses parent cycles; the bound is only a guard.
+  for (int depth = 0; depth < 8; ++depth) {
+    int32_t child = FindModalChild(window_id);
+    if (!child || !IsAttached(child)) {
+      break;
+    }
+    window_id = child;
+  }
+  return window_id;
+}
+
+void EmbeddedWindows::UpdateModalFocus() {
+  if (!focused_window_id_ || !focus_owner_) {
+    return;
+  }
+  int32_t target = ModalFocusTarget(focused_window_id_);
+  if (target != focused_window_id_) {
+    Focus(target, focus_owner_);
+  }
+}
+
+void EmbeddedWindows::ClearFocusToModalParent(int32_t window_id) {
+  int32_t modal_parent = FindModalParent(window_id);
+  aura::Window* owner = focus_owner_;
+  ClearFocus();
+  if (modal_parent && owner) {
+    Focus(modal_parent, owner);
+  }
+}
+
 bool EmbeddedWindows::IsAttached(int32_t window_id) const {
   auto it = windows_.find(window_id);
   return it != windows_.end() && it->second.attach_count > 0;
