From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <datzeesix@gmail.com>
Date: Sun, 25 Oct 2026 20:01:48 +1300
Subject: [PATCH 57/91] Plutonium: an app's interactive move or resize hands
 the drag to the page

EXO-EMBED: when the app on an embedded window asks for a move or resize
(its title bar, its edges) during the drag it has, the input router stops
routing that drag to the window: the page gets the rest of it, until the
buttons are released, and does the move or resize (windowrequest), and the
app gets a pointer leave.
---
 chrome/browser/exo_embedder.cc                |  7 +++++
 .../render_widget_host_input_event_router.cc  | 28 +++++++++++++++++++
 .../render_widget_host_input_event_router.h   |  6 ++++
 3 files changed, 41 insertions(+)

diff --git a/chrome/browser/exo_embedder.cc b/chrome/browser/exo_embedder.cc
index 6dd9163ab1..131061e8ca 100644
--- a/chrome/browser/exo_embedder.cc
+++ b/chrome/browser/exo_embedder.cc
@@ -563,6 +563,13 @@ class NativeWindowHostImpl
         Driver(window_id) != this) {
       return;
     }
+    // EXO-EMBED: an interactive move or resize is the page's to do: it gets
+    // the pointer for the rest of the drag.
+    if (request == exo::EmbeddedWindows::Request::kMove ||
+        request == exo::EmbeddedWindows::Request::kResize) {
+      input::RenderWidgetHostInputEventRouter::HandForeignDragToPage(
+          frame_sink_id_);
+    }
     client_->OnRequest(ToMojo(request), ToEdges(component));
   }
 
diff --git a/components/input/render_widget_host_input_event_router.cc b/components/input/render_widget_host_input_event_router.cc
index 3a03aca461..2c949a5132 100644
--- a/components/input/render_widget_host_input_event_router.cc
+++ b/components/input/render_widget_host_input_event_router.cc
@@ -739,6 +739,29 @@ void RenderWidgetHostInputEventRouter::SetForeignFrameSinkDelegate(
   ForeignDelegate() = delegate;
 }
 
+// static
+bool RenderWidgetHostInputEventRouter::HandForeignDragToPage(
+    const viz::FrameSinkId& frame_sink_id) {
+  // A drag on the sink made it the hover sink of the router that routes it.
+  auto it = ForeignHoverRouters().find(frame_sink_id);
+  if (it == ForeignHoverRouters().end() ||
+      it->second->foreign_capture_sink_ != frame_sink_id) {
+    return false;
+  }
+  RenderWidgetHostInputEventRouter* router = it->second;
+  VLOG(1) << "EXO-EMBED drag on " << frame_sink_id.ToString()
+          << " handed to the page";
+  router->foreign_capture_sink_ = viz::FrameSinkId();
+  // As a drag that started on page content: foreign sinks get nothing until
+  // the buttons are released (OnPageMouseEvent() clears it), and the page
+  // has the mouse captured, so neither a tab nor the window under the pointer
+  // gets the moves or the release.
+  router->page_mouse_down_ = true;
+  router->mouse_capture_target_ = router->foreign_hover_root_view_;
+  router->ForeignHoverLeave();
+  return true;
+}
+
 // static
 void RenderWidgetHostInputEventRouter::SetForeignFrameSinkCursor(
     const viz::FrameSinkId& frame_sink_id,
@@ -949,6 +972,11 @@ bool RenderWidgetHostInputEventRouter::RouteToForeignFrameSink(
   if (RouteToForeignCapture(root_view, mouse_event)) {
     return true;
   }
+  // As in RouteMouseEvent(): a drag that started on page content, or that a
+  // window handed to the page (HandForeignDragToPage()), stays with the page.
+  if (page_mouse_down_) {
+    return false;
+  }
   if (event.GetType() == blink::WebInputEvent::Type::kMouseDown) {
     VLOG(1) << "EXO-EMBED queried down " << frame_sink_id.ToString()
             << " foreign " << IsForeignFrameSink(frame_sink_id);
diff --git a/components/input/render_widget_host_input_event_router.h b/components/input/render_widget_host_input_event_router.h
index 560c51bae5..c6948312f0 100644
--- a/components/input/render_widget_host_input_event_router.h
+++ b/components/input/render_widget_host_input_event_router.h
@@ -158,6 +158,12 @@ class COMPONENT_EXPORT(INPUT) RenderWidgetHostInputEventRouter final
   // Shows |cursor| while the pointer is over the foreign |frame_sink_id|.
   static void SetForeignFrameSinkCursor(const viz::FrameSinkId& frame_sink_id,
                                         const ui::Cursor& cursor);
+  // EXO-EMBED: the app on the foreign |frame_sink_id| asked for an
+  // interactive move or resize during the drag it has: the rest of that drag
+  // goes to the page instead (until the buttons are released), which does
+  // the move or resize, and the app gets a pointer leave. False if no drag
+  // started on it.
+  static bool HandForeignDragToPage(const viz::FrameSinkId& frame_sink_id);
 
   void RouteMouseEvent(RenderWidgetHostViewInput* root_view,
                        const blink::WebMouseEvent* event,
