+
   if (changed_metrics & (DisplayMetric::DISPLAY_METRIC_BOUNDS |
                          DisplayMetric::DISPLAY_METRIC_ROTATION |
                          DisplayMetric::DISPLAY_METRIC_REFRESH_RATE)) {
