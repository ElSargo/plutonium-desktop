index f5d830293b..5e557a50d7 100644
--- a/components/exo/embedded_windows.h
+++ b/components/exo/embedded_windows.h
@@ -38,6 +38,10 @@ class Surface;
 inline constexpr char kEmbeddedEventKey[] = "exo-embedded";
 inline constexpr char kEmbeddedLeaveEventKey[] = "exo-embedded-leave";
 
+// EXO-BROKER: keep windows off the desktop (parked) unless a page element
+// shows them or ShowOnDesktop() popped them out.
+inline constexpr char kPlutoniumHideWindowsSwitch[] = "plutonium-hide-windows";
+
 // EXO-EMBED: shows Exo toplevels as elements in web pages.
 //
 // Every toplevel gets a stable window id. While at least one page element is
@@ -107,8 +111,11 @@ class EmbeddedWindows : public aura::WindowObserver {
   void Attach(int32_t window_id);
   void Detach(int32_t window_id);
   // EXO-BROKER: shows the window on the desktop and activates it, now if no
-  // element is attached, else as soon as the last one detaches.
+  // element is attached, else as soon as the last one detaches. With
+  // --plutonium-hide-windows this is the only way onto the desktop, and the
+  // window leaves it again when an element next shows it.
   void ShowOnDesktop(int32_t window_id);
+  static bool HideWindows();
   // Asks the app to resize its window geometry to |size| (DIPs).
   void SetSize(int32_t window_id, const gfx::Size& size);
 
diff --git a/components/exo/shell_surface_base.cc b/components/exo/shell_surface_base.cc
index 263f26c882..5cc75f5c0d 100644
--- a/components/exo/shell_surface_base.cc
+++ b/components/exo/shell_surface_base.cc
@@ -2538,6 +2538,13 @@ void ShellSurfaceBase::CommitWidget() {
     }
 
     ShowWidget(initially_activated_);
+    // EXO-BROKER: a window parked before its first show (see
+    // EmbeddedWindows::HideWindows()) must stay invisible through the show
+    // animation, and comes back where it was placed on first show.
+    if (embed_parked_) {
+      widget_->GetNativeWindow()->layer()->SetOpacity(0.f);
+      embed_saved_origin_ = widget_->GetWindowBoundsInScreen().origin();
+    }
 
     if (has_grab_)
