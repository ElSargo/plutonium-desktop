From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sarol263@student.otago.ac.nz>
Date: Fri, 16 Oct 2026 09:10:39 +1300
Subject: [PATCH 04/52] Plutonium: keep windows off the desktop, wl_output v4,
 embed input logs

--plutonium-hide-windows parks every toplevel from creation and again on its last detach unless popped out with ShowOnDesktop. wl_output v4 sends name/description (xwayland-satellite needs it). VLOG(1) traces of where pointer presses into embedded windows go.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 components/exo/embedded_windows.cc            | 31 ++++++++++++++++++-
 components/exo/embedded_windows.h             |  9 +++++-
 components/exo/shell_surface_base.cc          |  7 +++++
 .../exo/wayland/wayland_display_observer.cc   | 11 +++++++
 .../exo/wayland/wayland_display_observer.h    |  2 ++
 components/exo/wayland/wl_output.h            |  3 +-
 .../render_widget_host_input_event_router.cc  | 16 ++++++++++
 7 files changed, 76 insertions(+), 3 deletions(-)

diff --git a/components/exo/embedded_windows.cc b/components/exo/embedded_windows.cc
index 4e833b005f..1f3178413b 100644
--- a/components/exo/embedded_windows.cc
+++ b/components/exo/embedded_windows.cc
@@ -7,6 +7,7 @@
 #include <algorithm>
 #include <utility>
 
+#include "base/command_line.h"
 #include "base/functional/bind.h"
 #include "base/no_destructor.h"
 #include "base/task/sequenced_task_runner.h"
@@ -15,6 +16,7 @@
 #include "components/exo/shell_surface_util.h"
 #include "components/exo/surface.h"
 #include "components/exo/wm_helper.h"
+#include "ui/aura/client/capture_client.h"
 #include "ui/aura/window.h"
 #include "ui/views/widget/widget.h"
 #include "ui/compositor/layer.h"
@@ -128,10 +130,11 @@ void EmbeddedWindows::Detach(int32_t window_id) {
     if (focused_window_id_ == window_id) {
       ClearFocus();
     }
-    it->second.shell_surface->SetEmbedParked(false);
     if (it->second.show_on_detach) {
       it->second.show_on_detach = false;
       ActivateOnDesktop(it->second.shell_surface);
+    } else if (!HideWindows()) {
+      it->second.shell_surface->SetEmbedParked(false);
     }
     NotifyIfChanged(window_id);
   }
@@ -150,6 +153,7 @@ void EmbeddedWindows::ShowOnDesktop(int32_t window_id) {
 }
 
 void EmbeddedWindows::ActivateOnDesktop(ShellSurfaceBase* shell_surface) {
+  shell_surface->SetEmbedParked(false);
   views::Widget* widget = shell_surface->GetWidget();
   if (!widget) {
     return;
@@ -225,6 +229,10 @@ void EmbeddedWindows::DispatchMouseEvent(const viz::FrameSinkId& frame_sink_id,
                                          const gfx::PointF& screen_location,
                                          std::unique_ptr<ui::MouseEvent> event) {
   int32_t window_id = GetWindowIdForFrameSink(frame_sink_id);
+  if (event->type() == ui::EventType::kMousePressed) {
+    VLOG(1) << "EXO-EMBED press for sink " << frame_sink_id.ToString()
+            << " -> window #" << window_id << " at " << location.ToString();
+  }
   // EXO-BROKER: input is only injected into attached windows.
   if (!window_id || !IsAttached(window_id)) {
     return;
@@ -281,7 +289,16 @@ void EmbeddedWindows::DoDispatchMouseEvent(
   event->set_root_location_f(root);
   event->SetProperties(
       {{kEmbeddedEventKey, {}}, {wm::kSkipCursorUpdateEventKey, {}}});
+  const bool pressed = event->type() == ui::EventType::kMousePressed ||
+                       event->type() == ui::EventType::kMouseReleased;
   Dispatch(target, event.get());
+  if (pressed) {
+    aura::Window* capture = aura::client::GetCaptureWindow(
+        host_window->GetRootWindow());
+    VLOG(1) << "EXO-EMBED dispatched press/release; capture="
+            << (capture ? capture->GetName() : std::string("none"))
+            << " parked_capture=" << (capture && capture == target);
+  }
 }
 
 void EmbeddedWindows::PointerLeave(const viz::FrameSinkId& frame_sink_id) {
@@ -320,6 +337,18 @@ void EmbeddedWindows::OnToplevelCreated(ShellSurfaceBase* shell_surface) {
     return;
   }
   windows_[next_window_id_++].shell_surface = shell_surface;
+  // EXO-BROKER: in the Plutonium shell, windows live in the page. They stay
+  // off the desktop from the start until ShowOnDesktop().
+  if (HideWindows()) {
+    shell_surface->SetEmbedParked(true);
+  }
+}
+
+// static
+bool EmbeddedWindows::HideWindows() {
+  static const bool hide = base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kPlutoniumHideWindowsSwitch);
+  return hide;
 }
 
 void EmbeddedWindows::OnToplevelChanged(ShellSurfaceBase* shell_surface) {
