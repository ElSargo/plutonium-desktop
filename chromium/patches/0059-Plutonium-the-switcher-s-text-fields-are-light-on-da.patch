From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Mon, 26 Oct 2026 08:18:18 +1300
Subject: [PATCH 59/84] Plutonium: the switcher's text fields are light on
 dark, its rows hover steadily, the backup window is in front

EXO-SHELLS: the overlay's widget takes the dark theme's colors, so its
search and form fields have light text. A row stays hovered while the
pointer is over its labels, and a row rebuilt under a still pointer is
hovered. The active backup window (terminal or browser) goes above
floating windows, such as the popups of a window a shell behind it shows,
and back to the normal level once something else is active.
---
 .../ash/main_extra_parts/plutonium_overlay.cc | 15 ++++++++++++
 .../main_extra_parts/plutonium_shells_impl.cc | 24 +++++++++++++++++++
 .../main_extra_parts/plutonium_shells_impl.h  |  3 +++
 3 files changed, 42 insertions(+)

diff --git a/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc b/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc
index 3e5535decd..5bbdf69744 100644
--- a/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc
+++ b/chrome/browser/ui/ash/main_extra_parts/plutonium_overlay.cc
@@ -37,6 +37,7 @@
 #include "ui/base/metadata/metadata_header_macros.h"
 #include "ui/base/metadata/metadata_impl_macros.h"
 #include "ui/base/models/image_model.h"
+#include "ui/color/color_provider_key.h"
 #include "ui/display/display.h"
 #include "ui/display/screen.h"
 #include "ui/events/event.h"
@@ -242,6 +243,9 @@ class RowView : public views::View {
         on_context_click_(on_context_click
                               ? Deferred(std::move(on_context_click))
                               : base::RepeatingClosure()) {
+    // Hover stays on while the pointer is over the row's labels, which would
+    // otherwise take the enter/exit events from it.
+    SetNotifyEnterExitOnChild(true);
     const bool header = row.kind == Row::Kind::kHeader;
     auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
         views::BoxLayout::Orientation::kHorizontal,
@@ -291,6 +295,14 @@ class RowView : public views::View {
     hovered_ = false;
     UpdateBackground();
   }
+  // Lists are rebuilt as windows and tabs change: a new row under a pointer
+  // that doesn't move gets no enter event.
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override {
+    if (hovered_ != IsMouseHovered()) {
+      hovered_ = !hovered_;
+      UpdateBackground();
+    }
+  }
 
  private:
   void UpdateBackground() {
@@ -2399,6 +2411,9 @@ void PlutoniumOverlay::Open(int step) {
   params.activatable = views::Widget::InitParams::Activatable::kYes;
   params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
   widget_ = std::make_unique<views::Widget>(std::move(params));
+  // The overlay is dark: text fields and other controls take the dark
+  // theme's colors (light text), whatever Ash's own mode is.
+  widget_->SetColorModeOverride(ui::ColorProviderKey::ColorMode::kDark);
   view_ = widget_->SetContentsView(
       std::make_unique<PlutoniumOverlayView>(shells_, this, step));
   widget_observation_.Observe(widget_.get());
diff --git a/chrome/browser/ui/ash/main_extra_parts/plutonium_shells_impl.cc b/chrome/browser/ui/ash/main_extra_parts/plutonium_shells_impl.cc
index b53f4849be..c5fe07c99e 100644
--- a/chrome/browser/ui/ash/main_extra_parts/plutonium_shells_impl.cc
+++ b/chrome/browser/ui/ash/main_extra_parts/plutonium_shells_impl.cc
@@ -42,12 +42,14 @@
 #include "ui/aura/window.h"
 #include "ui/base/page_transition_types.h"
 #include "ui/base/base_window.h"
+#include "ui/base/ui_base_types.h"
 #include "ui/display/display.h"
 #include "ui/display/manager/display_manager.h"
 #include "ui/display/manager/managed_display_info.h"
 #include "ui/display/scoped_display_for_new_windows.h"
 #include "ui/display/screen.h"
 #include "ui/display/types/display_constants.h"
+#include "ui/views/widget/widget.h"
 #include "url/url_constants.h"
 
 namespace {
@@ -695,6 +697,27 @@ bool PlutoniumShellsImpl::OpenBackup(Backup backup, const GURL& url) {
   return true;
 }
 
+// EXO-SHELLS: the backup window in front covers everything below the
+// switcher, including what floats above normal windows (the popups of a
+// window a shell behind it shows); once something else is active (a
+// presented window or tab, a shell), it's an ordinary window again.
+void PlutoniumShellsImpl::RaiseActiveBackup(aura::Window* active) {
+  for (BrowserWindowInterface* browser :
+       {backup_terminal_.get(), backup_browser_.get()}) {
+    if (!browser || !browser->GetWindow()) {
+      continue;
+    }
+    aura::Window* window = browser->GetWindow()->GetNativeWindow();
+    views::Widget* widget = views::Widget::GetWidgetForNativeWindow(window);
+    if (!widget) {
+      continue;
+    }
+    const bool front = active && window->Contains(active);
+    widget->SetZOrderLevel(front ? ui::ZOrderLevel::kFloatingUIElement
+                                 : ui::ZOrderLevel::kNormal);
+  }
+}
+
 bool PlutoniumShellsImpl::IsBackupOpen(Backup backup) const {
   return !!(backup == Backup::kTerminal ? backup_terminal_ : backup_browser_);
 }
@@ -1005,6 +1028,7 @@ void PlutoniumShellsImpl::OnDisplayMetricsChanged(
 void PlutoniumShellsImpl::OnWindowActivated(ActivationReason reason,
                                             aura::Window* gained_active,
                                             aura::Window* lost_active) {
+  RaiseActiveBackup(gained_active);
   if (!gained_active) {
     return;
   }
diff --git a/chrome/browser/ui/ash/main_extra_parts/plutonium_shells_impl.h b/chrome/browser/ui/ash/main_extra_parts/plutonium_shells_impl.h
index 7540d76184..433bd57d1a 100644
--- a/chrome/browser/ui/ash/main_extra_parts/plutonium_shells_impl.h
+++ b/chrome/browser/ui/ash/main_extra_parts/plutonium_shells_impl.h
@@ -90,6 +90,9 @@ class PlutoniumShellsImpl : public PlutoniumShells,
                          aura::Window* lost_active) override;
 
  private:
+  // EXO-SHELLS: the active backup window goes above floating windows.
+  void RaiseActiveBackup(aura::Window* active);
+
   struct Entry {
     Entry();
     Entry(const Entry&);
