+void bind_xdg_toplevel_icon_manager(wl_client* client,
+                                    void* data,
+                                    uint32_t version,
+                                    uint32_t id) {
+  wl_resource* resource = wl_resource_create(
+      client, &xdg_toplevel_icon_manager_v1_interface, 1, id);
+  if (!resource) {
+    wl_client_post_no_memory(client);
+    return;
+  }
+  wl_resource_set_implementation(
+      resource, &toplevel_icon_manager_implementation, data, nullptr);
+  xdg_toplevel_icon_manager_v1_send_icon_size(resource, kToplevelIconSize);
+  xdg_toplevel_icon_manager_v1_send_done(resource);
+}
