+Response PlutoniumHandler::SetWindowAgentFocus(int id, bool focused) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    return NoWindow();
+  }
+  if (!focused) {
+    agent_focus_windows_.erase(id);
+  } else if (!agent_focus_windows_.contains(id)) {
+    agent_focus_windows_.emplace(
+        id, exo::EmbeddedWindows::Get()->HoldAgentFocus(id));
+  }
+  return Response::Success();
+}
