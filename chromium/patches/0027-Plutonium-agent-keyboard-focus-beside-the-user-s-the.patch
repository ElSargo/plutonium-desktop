 }
 
+void Seat::AddAgentFocus(Surface* surface) {
+  if (was_shutdown_ || !surface) {
+    return;
+  }
+  auto it = std::ranges::find(agent_focus_, surface);
+  if (it == agent_focus_.begin() && it != agent_focus_.end()) {
+    return;
+  }
+  if (it != agent_focus_.end()) {
+    agent_focus_.erase(it);
+  } else {
+    surface->AddSurfaceObserver(this);
+  }
+  agent_focus_.insert(agent_focus_.begin(), surface);
+  for (auto& observer_list : priority_observer_list_) {
+    for (auto& observer : observer_list) {
+      observer.OnAgentFocusChanged();
+    }
+  }
+}
+
+void Seat::RemoveAgentFocus(Surface* surface) {
+  auto it = std::ranges::find(agent_focus_, surface);
+  if (it == agent_focus_.end()) {
+    return;
+  }
+  agent_focus_.erase(it);
+  surface->RemoveSurfaceObserver(this);
+  for (auto& observer_list : priority_observer_list_) {
+    for (auto& observer : observer_list) {
+      observer.OnAgentFocusChanged();
+    }
+  }
+}
+
+bool Seat::IsKeyboardFocusedOn(const Surface* surface) {
+  for (auto& observer_list : priority_observer_list_) {
+    for (auto& observer : observer_list) {
+      if (observer.HasKeyboardFocus(surface)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+bool SeatObserver::HasKeyboardFocus(const Surface* surface) const {
+  return false;
+}
+
+void Seat::OnSurfaceDestroying(Surface* surface) {
+  // A keyboard focusing it lets go itself (Keyboard::OnSurfaceDestroying()).
+  surface->RemoveSurfaceObserver(this);
+  std::erase(agent_focus_, surface);
+}
