+base::ScopedClosureRunner EmbeddedWindows::HoldAgentFocus(int32_t window_id) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  Surface* surface = shell_surface ? shell_surface->root_surface() : nullptr;
+  if (!surface) {
+    return base::ScopedClosureRunner();
+  }
+  if (agent_focus_holds_[window_id]++ == 0) {
+    for (Seat* seat : seats_) {
+      seat->AddAgentFocus(surface);
+    }
+  }
+  return base::ScopedClosureRunner(base::BindOnce(
+      // The instance lives as long as the process.
+      [](EmbeddedWindows* self, int32_t window_id) {
+        auto it = self->agent_focus_holds_.find(window_id);
+        if (it == self->agent_focus_holds_.end() || --it->second > 0) {
+          return;
+        }
+        self->agent_focus_holds_.erase(it);
+        ShellSurfaceBase* shell_surface = self->FindShellSurface(window_id);
+        if (shell_surface && shell_surface->root_surface()) {
+          self->ReleaseAgentFocus(window_id, shell_surface->root_surface());
+        }
+      },
+      base::Unretained(this), window_id));
+}
+
+void EmbeddedWindows::ReleaseAgentFocus(int32_t window_id, Surface* surface) {
+  if (agent_focus_holds_.contains(window_id)) {
+    return;
+  }
+  for (Seat* seat : seats_) {
+    seat->RemoveAgentFocus(surface);
+  }
+}
