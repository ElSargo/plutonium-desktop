+base::TimeDelta HTMLNativeWindowElement::CrossfadeDuration() const {
+  int value = 0;
+  if (!ParseHTMLInteger(FastGetAttribute(html_names::kCrossfadeAttr), value) ||
+      value <= 0) {
+    return base::TimeDelta();
+  }
+  return base::Milliseconds(std::min(value, 10000));
+}
+
+void HTMLNativeWindowElement::HoldFadeFrame() {
+  if (CrossfadeDuration().is_zero() || !info_ ||
+      !info_->surface_id.is_valid()) {
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (fade_) {
+    // Resized again before the app caught up, or while fading: keep the
+    // frame from before the first resize, where its fade had got to.
+    fade_->from_opacity = FadeOpacity();
+    fade_->fade_start = base::TimeTicks();
+    fade_->hold_start = now;
+    InvalidateFadePaint();
+    return;
+  }
+  // The window's current surface: its last frame at the old size. Embedding
+  // that exact surface keeps it alive in viz after the app moves on to a
+  // surface of the new size.
+  auto layer = cc::SurfaceLayer::Create();
+  layer->SetSurfaceId(info_->surface_id,
+                      cc::DeadlinePolicy::UseSpecifiedDeadline(0));
+  layer->SetOldestAcceptableFallback(info_->surface_id);
+  layer->SetStretchContentToFillBounds(true);
+  layer->SetSurfaceHitTestable(false);
+  layer->SetIsDrawable(true);
+  fade_.emplace();
+  fade_->frame.layer = std::move(layer);
+  fade_->frame.geometry_size = WindowSizeInPixels();
+  fade_->frame.geometry_offset = GeometryOffsetInPixels();
+  fade_->frame.surface_size = SurfaceSizeInPixels();
+  fade_->hold_start = now;
+  InvalidateFadePaint();
+}
+
+void HTMLNativeWindowElement::StartFading() {
+  if (!fade_ || !fade_->fade_start.is_null()) {
+    return;
+  }
+  fade_->fade_start = base::TimeTicks::Now();
+  InvalidateFadePaint();
+}
+
+void HTMLNativeWindowElement::EndFade() {
+  if (!fade_) {
+    return;
+  }
+  fade_.reset();
+  fade_effect_ = nullptr;
+  if (auto* view = GetDocument().View()) {
+    view->SetPaintArtifactCompositorNeedsUpdate();
+  }
+  if (auto* layout_object = GetLayoutObject()) {
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+}
+
+float HTMLNativeWindowElement::FadeOpacity() const {
+  if (!fade_) {
+    return 0.f;
+  }
+  if (fade_->fade_start.is_null()) {
+    return fade_->from_opacity;
+  }
+  const base::TimeDelta duration = CrossfadeDuration();
+  const double t =
+      duration.is_zero()
+          ? 1.0
+          : std::clamp((base::TimeTicks::Now() - fade_->fade_start) / duration,
+                       0.0, 1.0);
+  // Ease out (cubic).
+  const double eased = 1.0 - std::pow(1.0 - t, 3);
+  return fade_->from_opacity * static_cast<float>(1.0 - eased);
+}
+
+void HTMLNativeWindowElement::OnFadeFrame() {
+  fade_frame_requested_ = false;
+  if (!fade_) {
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (fade_->fade_start.is_null() && now - fade_->hold_start >= kMaxFadeHold) {
+    fade_->fade_start = now;
+  }
+  if (!fade_->fade_start.is_null() &&
+      now - fade_->fade_start >= CrossfadeDuration()) {
+    EndFade();
+    return;
+  }
+  InvalidateFadePaint();
+}
+
+void HTMLNativeWindowElement::InvalidateFadePaint() {
+  if (auto* layout_object = GetLayoutObject()) {
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+  if (!fade_ || fade_frame_requested_) {
+    return;
+  }
+  fade_frame_requested_ = true;
+  GetDocument().RequestAnimationFrame(
+      MakeGarbageCollected<FadeFrameCallback>(this),
+      FrameCallbackType::kInternal);
+}
+
+const EffectPaintPropertyNode& HTMLNativeWindowElement::UpdateFadeEffect(
+    const PropertyTreeState& parent) {
+  EffectPaintPropertyNode::State state;
+  state.local_transform_space = &parent.Transform();
+  state.opacity = FadeOpacity();
+  bool changed = true;
+  if (fade_effect_) {
+    changed = fade_effect_->Update(parent.Effect(), std::move(state)) !=
+              PaintPropertyChangeType::kUnchanged;
+  } else {
+    fade_effect_ =
+        EffectPaintPropertyNode::Create(parent.Effect(), std::move(state));
+  }
+  // A property change, not only new paint: the compositor's layers and
+  // property trees need updating (its fast path is for paint alone).
+  if (changed) {
+    if (auto* view = GetDocument().View()) {
+      view->SetPaintArtifactCompositorNeedsUpdate();
+    }
+  }
+  return *fade_effect_;
+}
