diff --git a/third_party/blink/renderer/core/html/native_window_broker.cc b/third_party/blink/renderer/core/html/native_window_broker.cc
index 6298556c56..8c899e9238 100644
--- a/third_party/blink/renderer/core/html/native_window_broker.cc
+++ b/third_party/blink/renderer/core/html/native_window_broker.cc
@@ -1190,6 +1190,24 @@ ScriptPromise<IDLBoolean> NativeWindowBroker::setWindowOriginTag(
   return promise;
 }
 
+ScriptPromise<IDLString> NativeWindowBroker::getHelperUrl(
+    ScriptState* script_state) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLString>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->GetHelperUrl(BindOnce(
+      [](NativeWindowBroker* self, ScriptPromiseResolver<IDLString>* resolver,
+         const String& url) {
+        self->pending_.erase(resolver);
+        resolver->Resolve(url);
+      },
+      WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
