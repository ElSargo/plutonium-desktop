From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Tue, 27 Oct 2026 22:09:54 +1300
Subject: [PATCH 81/94] Plutonium: windowBroker.getHelperUrl()

A shell page learned the helper's URL by convention (?helper= or port
3780). The browser has it from the launcher (--plutonium-helper-url):
hand it to shell documents.
---
 chrome/browser/plutonium_shell.cc              | 16 ++++++++++++++++
 .../mojom/native_window/window_broker.mojom    |  3 +++
 .../renderer/core/html/native_window_broker.cc | 18 ++++++++++++++++++
 .../renderer/core/html/native_window_broker.h  |  1 +
 .../core/html/native_window_broker.idl         |  3 +++
 5 files changed, 41 insertions(+)

diff --git a/chrome/browser/plutonium_shell.cc b/chrome/browser/plutonium_shell.cc
index 9ce0dd6395..4cc42e9060 100644
--- a/chrome/browser/plutonium_shell.cc
+++ b/chrome/browser/plutonium_shell.cc
@@ -588,6 +588,22 @@ class WindowBrokerImpl
                             broker->SetOriginTag(window_id, tag));
   }
 
+  void GetHelperUrl(GetHelperUrlCallback callback) override {
+    const GURL helper(
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            PlutoniumShells::kHelperUrlSwitch));
+    if (!StillShell() || !helper.is_valid() || !helper.SchemeIsHTTPOrHTTPS()) {
+      std::move(callback).Run(std::string());
+      return;
+    }
+    // Its origin, as the pages' ?helper= has it: no trailing slash.
+    std::string url = helper.GetWithEmptyPath().spec();
+    if (url.ends_with('/')) {
+      url.pop_back();
+    }
+    std::move(callback).Run(url);
+  }
+
   void UpdateTabTags(int32_t tab_id,
                      const std::vector<std::string>& add,
                      const std::vector<std::string>& remove,
