From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Mon, 26 Oct 2026 18:49:19 +1300
Subject: [PATCH 73/91] Plutonium: a shell page whose renderer crashes while it
 shows a tab no longer takes the browser down

PerformanceManagerTabHelper::SurfaceEmbedChildWebContentsDetached checked that
the inner page still had its embedder frame node. When the embedder's renderer
crashes, its frame node goes first, clearing that, and the <embed>'s host goes
after: the CHECK took the whole browser down with a crashed shell page. The
helper rolls back a shell edit that crashes its page (Target.targetCrashed),
so the browser has to outlive it.
---
 .../performance_manager/performance_manager_tab_helper.cc  | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/components/performance_manager/performance_manager_tab_helper.cc b/components/performance_manager/performance_manager_tab_helper.cc
index 1a4dd3431b..e36e210093 100644
--- a/components/performance_manager/performance_manager_tab_helper.cc
+++ b/components/performance_manager/performance_manager_tab_helper.cc
@@ -739,8 +739,11 @@ void PerformanceManagerTabHelper::SurfaceEmbedChildWebContentsDetached(
   auto* page = helper->page_node_.get();
   CHECK(page);
 
-  CHECK(page->embedder_frame_node());
-  page->ClearEmbedderFrameNode();
+  // EXO-TABS: an embedder whose renderer crashed has lost its frame node,
+  // and the page its embedder with it, before the <embed>'s host goes.
+  if (page->embedder_frame_node()) {
+    page->ClearEmbedderFrameNode();
+  }
 }
 
 void PerformanceManagerTabHelper::WebContentsDestroyed() {
