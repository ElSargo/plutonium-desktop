From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Wed, 28 Oct 2026 20:49:01 +1300
Subject: [PATCH 90/97] Plutonium: a tab's PipeWire capture asks for no size
 and follows navigations

EXO-CAPTURE, PlutoniumScreencast for a tab (the portal's tab captures, an
agent's start_recording):

- Start() held the WebContents as a hidden capturer with the node's size,
  which WebContentsImpl::IncrementCapturerCount() refuses (DCHECK: a hidden
  capture must not resize the page), so a DCHECK build crashed. It passes
  an empty size; the page keeps the size it has.
- The capturer was made on the page's view once. A navigation to another
  site gives the page a new view with a frame sink of its own, and the node
  kept repeating the old page's last frame. Now RenderFrameHostChanged() for
  the primary main frame makes a new capturer on the new view, set up as
  the first.
---
 chrome/browser/plutonium_pipewire.cc | 34 +++++++++++++++++++++++-----
 1 file changed, 28 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/plutonium_pipewire.cc b/chrome/browser/plutonium_pipewire.cc
index aab5130b10..c03d132f7c 100644
--- a/chrome/browser/plutonium_pipewire.cc
+++ b/chrome/browser/plutonium_pipewire.cc
@@ -47,6 +47,7 @@
 #include "components/viz/common/surfaces/video_capture_target.h"
 #include "components/viz/host/client_frame_sink_video_capturer.h"
 #include "components/viz/host/host_frame_sink_manager.h"
+#include "content/public/browser/render_frame_host.h"
 #include "content/public/browser/render_widget_host_view.h"
 #include "content/public/browser/web_contents.h"
 #include "content/public/browser/web_contents_observer.h"
@@ -697,8 +698,9 @@ class ScreencastImpl : public PlutoniumScreencast,
         return false;
       }
       Observe(target.contents);
+      // A hidden capture asks for no size: the page keeps the one it has.
       capture_handle_ = target.contents->IncrementCapturerCount(
-          size_, /*stay_hidden=*/true, /*stay_awake=*/true,
+          gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/true,
           /*is_activity=*/true);
       capturer_ = view->CreateVideoCapturer();
       // A tab's cursor isn't Ash's.
@@ -737,11 +739,7 @@ class ScreencastImpl : public PlutoniumScreencast,
       stream_.reset();
       return false;
     }
-    capturer_->SetFormat(media::PIXEL_FORMAT_ARGB);
-    capturer_->SetMinCapturePeriod(base::Seconds(1) / 60);
-    capturer_->SetResolutionConstraints(size_, size_,
-                                        /*use_fixed_aspect_ratio=*/true);
-    capturer_->SetAutoThrottlingEnabled(false);
+    ConfigureCapturer();
     if (cursor_ == "embedded") {
       overlay_ = capturer_->CreateOverlay(/*stacking_index=*/0);
     }
@@ -852,8 +850,32 @@ class ScreencastImpl : public PlutoniumScreencast,
 
   // content::WebContentsObserver:
   void WebContentsDestroyed() override { End(); }
+  // A navigation to another site gives the page a new view, with a frame
+  // sink of its own: a new capturer follows it (a tab's has no overlay).
+  void RenderFrameHostChanged(content::RenderFrameHost* old_host,
+                              content::RenderFrameHost* new_host) override {
+    if (!capturer_ || !new_host || !new_host->IsInPrimaryMainFrame()) {
+      return;
+    }
+    content::RenderWidgetHostView* view = new_host->GetView();
+    if (!view) {
+      return;
+    }
+    capturer_->StopAndResetConsumer();
+    capturer_ = view->CreateVideoCapturer();
+    ConfigureCapturer();
+    capturer_->Start(this, viz::mojom::BufferFormatPreference::kDefault);
+  }
 
  private:
+  void ConfigureCapturer() {
+    capturer_->SetFormat(media::PIXEL_FORMAT_ARGB);
+    capturer_->SetMinCapturePeriod(base::Seconds(1) / 60);
+    capturer_->SetResolutionConstraints(size_, size_,
+                                        /*use_fixed_aspect_ratio=*/true);
+    capturer_->SetAutoThrottlingEnabled(false);
+  }
+
   void OnReady(uint32_t node_id) {
     VLOG(1) << "EXO-CAPTURE PipeWire node " << node_id << " at "
             << size_.ToString();
