+// What the tabs capture now: their "inUse" state.
+class CaptureObserver : public MediaStreamCaptureIndicator::Observer {
+ public:
+  static void Ensure() { static base::NoDestructor<CaptureObserver> observer; }
+
+  CaptureObserver() {
+    indicator_ = MediaCaptureDevicesDispatcher::GetInstance()
+                     ->GetMediaStreamCaptureIndicator();
+    if (indicator_) {
+      observation_.Observe(indicator_.get());
+    }
+  }
+
+  // MediaStreamCaptureIndicator::Observer:
+  void OnIsCapturingVideoChanged(content::WebContents* contents,
+                                 bool) override {
+    Update(contents);
+  }
+  void OnIsCapturingAudioChanged(content::WebContents* contents,
+                                 bool) override {
+    Update(contents);
+  }
+  void OnIsCapturingTabChanged(content::WebContents* contents, bool) override {
+    Update(contents);
+  }
+  void OnIsCapturingWindowChanged(content::WebContents* contents,
+                                  bool) override {
+    Update(contents);
+  }
+  void OnIsCapturingDisplayChanged(content::WebContents* contents,
+                                   bool) override {
+    Update(contents);
+  }
+
+ private:
+  void Update(content::WebContents* contents) {
+    if (!contents || !PlutoniumTabs::Get()->IsTab(contents)) {
+      return;
+    }
+    const bool camera = indicator_->IsCapturingVideo(contents);
+    const bool microphone = indicator_->IsCapturingAudio(contents);
+    const bool screen = indicator_->IsCapturingTab(contents) ||
+                        indicator_->IsCapturingWindow(contents) ||
+                        indicator_->IsCapturingDisplay(contents);
+    PlutoniumTabs::Get()->SetTabState(
+        contents, "inUse",
+        camera || microphone || screen
+            ? base::Value(base::DictValue()
+                              .Set("camera", camera)
+                              .Set("microphone", microphone)
+                              .Set("screen", screen))
+            : base::Value());
+  }
+
+  scoped_refptr<MediaStreamCaptureIndicator> indicator_;
+  base::ScopedObservation<MediaStreamCaptureIndicator,
+                          MediaStreamCaptureIndicator::Observer>
+      observation_{this};
+};
+
+// The request manager's prompt for a registry tab: a "permission" request.
+class Prompt : public permissions::PermissionPrompt {
+ public:
+  Prompt(content::WebContents* contents, Delegate* delegate)
+      : contents_(contents), delegate_(delegate) {
+    origin_ = url::Origin::Create(delegate->GetRequestingOrigin());
+    bool once = true;
+    for (const auto& request : delegate->Requests()) {
+      const std::string type = TypeName(request->request_type());
+      if (!std::ranges::contains(types_, type)) {
+        types_.push_back(type);
+      }
+      once = once && permissions::PermissionUtil::DoesSupportTemporaryGrants(
+                         request->GetContentSettingsType());
+    }
+    if (once) {
+      scopes_.push_back("once");
+    }
+    scopes_.push_back("everywhere");
+
+    PlutoniumTabRequests::Params params;
+    params.kind = kKind;
+    params.detail = Detail(contents, origin_, types_, scopes_);
+    params.on_answer = base::BindRepeating(
+        [](base::WeakPtr<Prompt> prompt, From from, const base::Value& answer) {
+          return prompt && prompt->OnAnswer(from, answer);
+        },
+        weak_factory_.GetWeakPtr());
+    params.on_fallback = base::BindOnce(
+        [](base::WeakPtr<Prompt> prompt, FallbackReason reason) {
+          if (prompt) {
+            prompt->OnFallback(reason);
+          }
+        },
+        weak_factory_.GetWeakPtr());
+    handle_ = PlutoniumTabRequests::Get()->Start(contents, std::move(params));
+    VLOG(1) << "EXO-TAB-PERMISSIONS " << origin_.Serialize() << " asks for "
+            << types_.front() << (types_.size() > 1 ? " and more" : "")
+            << (handle_ ? "" : " (not a tab)");
+  }
+
+  ~Prompt() override = default;
+
+  // permissions::PermissionPrompt:
+  bool UpdateAnchor() override { return true; }
+  TabSwitchingBehavior GetTabSwitchingBehavior() override {
+    return TabSwitchingBehavior::kKeepPromptAlive;
+  }
+  permissions::PermissionPromptDisposition GetPromptDisposition()
+      const override {
+    return permissions::PermissionPromptDisposition::CUSTOM_MODAL_DIALOG;
+  }
+  bool IsAskPrompt() const override { return true; }
+  std::optional<gfx::Rect> GetViewBoundsInScreen() const override {
+    return std::nullopt;
+  }
+  std::vector<permissions::ElementAnchoredBubbleVariant> GetPromptVariants()
+      const override {
+    return {};
+  }
+  std::optional<permissions::feature_params::PermissionElementPromptPosition>
+  GetPromptPosition() const override {
+    return std::nullopt;
+  }
+
+ private:
+  PromptOptions Options() const {
+    const auto& requests = delegate_->Requests();
+    if (!requests.empty() &&
+        requests.front()->GetContentSettingsType() ==
+            ContentSettingsType::GEOLOCATION_WITH_OPTIONS) {
+      return GeolocationPromptOptions{.selected_accuracy =
+                                          GeolocationAccuracy::kPrecise};
+    }
+    return std::monostate();
+  }
+
+  // The delegate's calls end the requests and destroy |this|: nothing runs
+  // after them.
+  bool OnAnswer(From from, const base::Value& value) {
+    std::optional<Decision> decision = ParseDecision(value, scopes_);
+    if (!decision ||
+        (from == From::kAgent && decision->answer == Answer::kAllow)) {
+      return false;
+    }
+    VLOG(1) << "EXO-TAB-PERMISSIONS " << origin_.Serialize() << ": "
+            << (from == From::kAgent ? "agent" : "shell") << " answered "
+            << value.DebugString();
+    Unblock(contents_, origin_, types_);
+    Delegate* delegate = delegate_;
+    const PromptOptions options = Options();
+    switch (decision->answer) {
+      case Answer::kAllow:
+        if (decision->scope == "everywhere") {
+          delegate->Accept(options);
+        } else {
+          delegate->AcceptThisTime(options);
+        }
+        break;
+      case Answer::kDeny:
+        if (decision->scope == "everywhere") {
+          delegate->Deny(options);
+        } else {
+          delegate->Dismiss(options);
+        }
+        break;
+      case Answer::kDismiss:
+        delegate->Dismiss(options);
+        break;
+    }
+    return true;
+  }
+
+  // TAB_FEATURES.md, Decisions 2: dismiss, and record it on the tab.
+  void OnFallback(FallbackReason reason) {
+    VLOG(1) << "EXO-TAB-PERMISSIONS " << origin_.Serialize()
+            << ": no shell answered, dismissed";
+    Block(contents_, origin_, types_);
+    delegate_->Dismiss(Options());
+  }
+
+  const raw_ptr<content::WebContents> contents_;
+  const raw_ptr<Delegate> delegate_;
+  url::Origin origin_;
+  std::vector<std::string> types_;
+  std::vector<std::string> scopes_;
+  std::unique_ptr<PlutoniumTabRequests::Handle> handle_;
+  base::WeakPtrFactory<Prompt> weak_factory_{this};
+};
+
+}  // namespace
+
+void AttachHelpers(content::WebContents* contents) {
+  if (!content_settings::PageSpecificContentSettings::GetDelegateForWebContents(
+          contents)) {
+    content_settings::PageSpecificContentSettings::CreateForWebContents(
+        contents,
+        std::make_unique<PageSpecificContentSettingsDelegate>(contents));
+  }
+  permissions::PermissionRequestManager::CreateForWebContents(contents);
+  permissions::PermissionRequestManager::FromWebContents(contents)
+      ->set_prompt_while_hidden();
+  FileSystemAccessPermissionRequestManager::CreateForWebContents(contents);
+  TabPermissions::CreateForWebContents(contents);
+  CaptureObserver::Ensure();
+}
+
+void RequestMediaAccessPermission(content::WebContents* contents,
+                                  const content::MediaStreamRequest& request,
+                                  content::MediaResponseCallback callback) {
+  MediaCaptureDevicesDispatcher::GetInstance()->ProcessMediaAccessRequest(
+      contents, request, std::move(callback), /*extension=*/nullptr);
+}
+
+bool CheckMediaAccessPermission(content::RenderFrameHost* render_frame_host,
+                                const url::Origin& security_origin,
+                                blink::mojom::MediaStreamType type) {
+  return MediaCaptureDevicesDispatcher::GetInstance()
+      ->CheckMediaAccessPermission(render_frame_host, security_origin, type);
+}
+
+bool IsShellTab(content::WebContents* contents) {
+  return contents && plutonium_shell::IsShellMode() &&
+         PlutoniumTabs::Get()->IsTab(contents);
+}
+
+std::unique_ptr<permissions::PermissionPrompt> CreatePrompt(
+    content::WebContents* contents,
+    permissions::PermissionPrompt::Delegate* delegate) {
+  return std::make_unique<Prompt>(contents, delegate);
+}
+
+void AskFileSystemAccess(
+    const FileSystemAccessPermissionRequestManager::RequestData& request,
+    base::OnceCallback<void(permissions::PermissionAction result)> callback,
+    content::WebContents* contents) {
+  using Access = FileSystemAccessPermissionRequestManager::Access;
+  struct State {
+    std::unique_ptr<PlutoniumTabRequests::Handle> handle;
+    base::OnceCallback<void(permissions::PermissionAction)> callback;
+  };
+  // Lives as long as the request (its fallback holds it).
+  auto state = std::make_shared<State>();
+  state->callback = std::move(callback);
+
+  bool write = false;
+  bool directory = false;
+  base::ListValue files;
+  for (const auto& file : request.file_request_data) {
+    write = write || file.access != Access::kRead;
+    directory =
+        directory ||
+        file.handle_type ==
+            content::FileSystemAccessPermissionContext::HandleType::kDirectory;
+    files.Append(file.path_info.display_name);
+  }
+  const std::vector<std::string> types = {write ? "file-write" : "file-read"};
+  PlutoniumTabRequests::Params params;
+  params.kind = kKind;
+  params.detail = Detail(contents, request.origin, types, {"once"})
+                      .Set("files", std::move(files))
+                      .Set("directory", directory);
+  params.on_answer = base::BindRepeating(
+      [](std::weak_ptr<State> weak, base::WeakPtr<content::WebContents> tab,
+         url::Origin origin, std::vector<std::string> types, From from,
+         const base::Value& value) {
+        std::shared_ptr<State> state = weak.lock();
+        std::optional<Decision> decision = ParseDecision(value, {"once"});
+        if (!state || !state->callback || !decision ||
+            (from == From::kAgent && decision->answer == Answer::kAllow)) {
+          return false;
+        }
+        Unblock(tab.get(), origin, types);
+        std::move(state->callback)
+            .Run(decision->answer == Answer::kAllow
+                     ? permissions::PermissionAction::GRANTED
+                 : decision->answer == Answer::kDeny
+                     ? permissions::PermissionAction::DENIED
+                     : permissions::PermissionAction::DISMISSED);
+        return true;
+      },
+      std::weak_ptr<State>(state), contents->GetWeakPtr(), request.origin,
+      types);
+  params.on_fallback = base::BindOnce(
+      [](std::shared_ptr<State> state, base::WeakPtr<content::WebContents> tab,
+         url::Origin origin, std::vector<std::string> types,
+         FallbackReason reason) {
+        Block(tab.get(), origin, types);
+        if (state->callback) {
+          std::move(state->callback)
+              .Run(permissions::PermissionAction::DISMISSED);
+        }
+      },
+      state, contents->GetWeakPtr(), request.origin, types);
+  state->handle = PlutoniumTabRequests::Get()->Start(contents, std::move(params));
+  if (!state->handle && state->callback) {
+    std::move(state->callback).Run(permissions::PermissionAction::DISMISSED);
+  }
+}
+
+}  // namespace plutonium_permissions
