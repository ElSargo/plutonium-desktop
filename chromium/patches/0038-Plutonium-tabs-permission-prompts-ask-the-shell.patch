+// EXO-TAB-PERMISSIONS (docs/features/TAB_FEATURES.md, "Permission prompts"):
+// a registry tab's permission requests are asked of a shell, as a tab request
+// of kind "permission" (plutonium_tab_requests.h), instead of Chrome's bubble.
+//
+// The request's detail is {origin, embeddingOrigin, thread, types, scopes}:
+// |types| names what the page asks for ("camera", "microphone",
+// "geolocation", "notifications", "clipboard-read", "file-write", ...), and
+// |scopes| the ways it may be allowed ("once", "everywhere"). The answer is
+// {answer: "allow" | "deny" | "dismiss", scope}, or just the answer:
+// - allow once: Chrome's one-time grant (AcceptThisTime);
+// - allow everywhere: Chrome's content setting (Accept);
+// - deny everywhere: Chrome's content setting (Deny);
+// - deny once, or dismiss: nothing is stored (Dismiss).
+// An agent may deny or dismiss, never allow.
+//
+// If no shell takes the request (or the one that took it goes away), it is
+// dismissed, and the tab's state records it in "blocked": [{origin,
+// permission}], so a shell can show it and ask again. The list empties when
+// the page navigates to another document.
+//
+// The request manager asks even while no <embed> shows the tab (the shell
+// marks the tab from its pending.permission). What the tab captures now is
+// in its state as "inUse": {camera, microphone, screen}.
+namespace plutonium_permissions {
+
+// Attaches the permission helpers to registry tab |contents|
+// (PlutoniumTabs' Tab::AttachHelpers()).
+void AttachHelpers(content::WebContents* contents);
+
+// Tab's WebContentsDelegate methods for getUserMedia(), as
+// BrowserWebContentsDelegate's.
+void RequestMediaAccessPermission(content::WebContents* contents,
+                                  const content::MediaStreamRequest& request,
+                                  content::MediaResponseCallback callback);
+bool CheckMediaAccessPermission(content::RenderFrameHost* render_frame_host,
+                                const url::Origin& security_origin,
+                                blink::mojom::MediaStreamType type);
+
+// Whether |contents| is a registry tab in shell mode, whose prompts the
+// functions below show.
+bool IsShellTab(content::WebContents* contents);
+
+// From CreatePermissionPrompt(): the prompt for registry tab |contents|.
+std::unique_ptr<permissions::PermissionPrompt> CreatePrompt(
+    content::WebContents* contents,
+    permissions::PermissionPrompt::Delegate* delegate);
+
+// From ShowFileSystemAccessPermissionDialog(): asks about write (or read)
+// access to the files in |request|, for registry tab |contents|.
+void AskFileSystemAccess(
+    const FileSystemAccessPermissionRequestManager::RequestData& request,
+    base::OnceCallback<void(permissions::PermissionAction result)> callback,
+    content::WebContents* contents);
+
+}  // namespace plutonium_permissions
+
+#endif  // CHROME_BROWSER_PLUTONIUM_PERMISSIONS_H_
