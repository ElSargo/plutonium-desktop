diff --git a/chrome/browser/devtools/protocol/plutonium_notifications.cc b/chrome/browser/devtools/protocol/plutonium_notifications.cc
new file mode 100644
index 0000000000..aed0bbbde9
--- /dev/null
+++ b/chrome/browser/devtools/protocol/plutonium_notifications.cc
@@ -0,0 +1,153 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/devtools/protocol/plutonium_notifications.h"
+
+#include <utility>
+
+#include "base/base64.h"
+#include "base/memory/scoped_refptr.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/base/models/image_model.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/image/image.h"
+#include "ui/message_center/public/cpp/notification.h"
+#include "ui/message_center/public/cpp/notification_delegate.h"
+#include "ui/message_center/public/cpp/notifier_id.h"
+#include "url/origin.h"
+
+namespace {
+
+using message_center::MessageCenter;
+using message_center::Notification;
+
+// A web page's (a tab's, a service worker's): the rest are Ash's own.
+const Notification* FindWebNotification(const std::string& id) {
+  MessageCenter* center = MessageCenter::Get();
+  const Notification* notification =
+      center ? center->FindNotificationById(id) : nullptr;
+  if (!notification || notification->notifier_id().type !=
+                           message_center::NotifierType::WEB_PAGE) {
+    return nullptr;
+  }
+  return notification;
+}
+
+std::string PngDataUrl(const ui::ImageModel& model) {
+  if (!model.IsImage()) {
+    return std::string();
+  }
+  const gfx::Image image = model.GetImage();
+  const SkBitmap* bitmap = image.ToSkBitmap();
+  if (!bitmap || bitmap->drawsNothing()) {
+    return std::string();
+  }
+  std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(*bitmap, /*discard_transparency=*/false);
+  if (!png) {
+    return std::string();
+  }
+  return "data:image/png;base64," + base::Base64Encode(*png);
+}
+
+PlutoniumWebNotifications::Info ToInfo(const Notification& notification) {
+  PlutoniumWebNotifications::Info info;
+  info.id = notification.id();
+  info.origin = url::Origin::Create(notification.origin_url()).Serialize();
+  info.title = notification.title();
+  info.body = notification.message();
+  info.icon = PngDataUrl(notification.icon());
+  for (const message_center::ButtonInfo& button : notification.buttons()) {
+    info.buttons.push_back(button.title);
+  }
+  info.require_interaction = notification.never_timeout();
+  info.silent = notification.silent();
+  return info;
+}
+
+}  // namespace
+
+PlutoniumWebNotifications::Info::Info() = default;
+PlutoniumWebNotifications::Info::Info(const Info&) = default;
+PlutoniumWebNotifications::Info::~Info() = default;
+
+PlutoniumWebNotifications::PlutoniumWebNotifications(
+    base::RepeatingCallback<void(const Info&)> shown,
+    base::RepeatingCallback<void(const std::string& id)> closed)
+    : shown_(std::move(shown)), closed_(std::move(closed)) {
+  if (MessageCenter* center = MessageCenter::Get()) {
+    observation_.Observe(center);
+  }
+}
+
+PlutoniumWebNotifications::~PlutoniumWebNotifications() = default;
+
+std::vector<PlutoniumWebNotifications::Info>
+PlutoniumWebNotifications::GetNotifications() const {
+  std::vector<Info> result;
+  MessageCenter* center = MessageCenter::Get();
+  if (!center) {
+    return result;
+  }
+  for (const Notification* notification : center->GetNotifications()) {
+    if (notification->notifier_id().type ==
+        message_center::NotifierType::WEB_PAGE) {
+      result.push_back(ToInfo(*notification));
+    }
+  }
+  return result;
+}
+
+bool PlutoniumWebNotifications::Perform(const std::string& id,
+                                        const std::string& action,
+                                        std::optional<int> button) {
+  const Notification* notification = FindWebNotification(id);
+  if (!notification) {
+    return false;
+  }
+  if (action == "click") {
+    if (button && (*button < 0 || static_cast<size_t>(*button) >=
+                                      notification->buttons().size())) {
+      return false;
+    }
+    // Its delegate, as the message center's click does: that click ignores
+    // notifications its blockers hide, which in shell mode is all of them.
+    scoped_refptr<message_center::NotificationDelegate> delegate =
+        notification->delegate();
+    if (delegate) {
+      delegate->Click(button, std::nullopt);
+    }
+    return true;
+  }
+  if (action == "close") {
+    MessageCenter::Get()->RemoveNotification(id, /*by_user=*/true);
+    return true;
+  }
+  return false;
+}
+
+void PlutoniumWebNotifications::OnNotificationAdded(
+    const std::string& notification_id) {
+  Shown(notification_id);
+}
+
+void PlutoniumWebNotifications::OnNotificationUpdated(
+    const std::string& notification_id) {
+  Shown(notification_id);
+}
+
+void PlutoniumWebNotifications::OnNotificationRemoved(
+    const std::string& notification_id,
+    bool by_user) {
+  // Gone from the center, so its type isn't known: the helper ignores ids
+  // it never had.
+  closed_.Run(notification_id);
+}
+
+void PlutoniumWebNotifications::Shown(const std::string& notification_id) {
+  if (const Notification* notification =
+          FindWebNotification(notification_id)) {
+    shown_.Run(ToInfo(*notification));
+  }
+}
diff --git a/chrome/browser/devtools/protocol/plutonium_notifications.h b/chrome/browser/devtools/protocol/plutonium_notifications.h
new file mode 100644
index 0000000000..f498bf702c
--- /dev/null
+++ b/chrome/browser/devtools/protocol/plutonium_notifications.h
@@ -0,0 +1,77 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_DEVTOOLS_PROTOCOL_PLUTONIUM_NOTIFICATIONS_H_
+#define CHROME_BROWSER_DEVTOOLS_PROTOCOL_PLUTONIUM_NOTIFICATIONS_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/scoped_observation.h"
+#include "ui/message_center/message_center.h"
+#include "ui/message_center/message_center_observer.h"
+
+// PLUTONIUM (EXO-SERVICES): the tabs' web notifications (new Notification(),
+// a service worker's showNotification()), for the helper's notifications
+// service. Chrome puts them in Ash's message center, which shell mode never
+// shows: this watches it for web pages' notifications and acts on them as
+// its popups would (click, a button, close), so Chrome's own handling (the
+// page's onclick, the worker's notificationclick) runs.
+class PlutoniumWebNotifications
+    : public message_center::MessageCenterObserver {
+ public:
+  struct Info {
+    Info();
+    Info(const Info&);
+    ~Info();
+    std::string id;
+    // The site's origin.
+    std::string origin;
+    std::u16string title;
+    std::u16string body;
+    // A PNG data URL, or empty.
+    std::string icon;
+    std::vector<std::u16string> buttons;
+    bool require_interaction = false;
+    bool silent = false;
+  };
+
+  // |shown| runs for a new or updated notification, |closed| when one goes
+  // (the page closed it, or it was acted on).
+  PlutoniumWebNotifications(
+      base::RepeatingCallback<void(const Info&)> shown,
+      base::RepeatingCallback<void(const std::string& id)> closed);
+  PlutoniumWebNotifications(const PlutoniumWebNotifications&) = delete;
+  PlutoniumWebNotifications& operator=(const PlutoniumWebNotifications&) =
+      delete;
+  ~PlutoniumWebNotifications() override;
+
+  // The web notifications there are, in the message center's order.
+  std::vector<Info> GetNotifications() const;
+
+  // "click" (the notification, or with |button| one of its buttons) or
+  // "close" (dismissed by the user); false if there's no such notification.
+  bool Perform(const std::string& id,
+               const std::string& action,
+               std::optional<int> button);
+
+  // message_center::MessageCenterObserver:
+  void OnNotificationAdded(const std::string& notification_id) override;
+  void OnNotificationUpdated(const std::string& notification_id) override;
+  void OnNotificationRemoved(const std::string& notification_id,
+                             bool by_user) override;
+
+ private:
+  void Shown(const std::string& notification_id);
+
+  base::RepeatingCallback<void(const Info&)> shown_;
+  base::RepeatingCallback<void(const std::string& id)> closed_;
+  base::ScopedObservation<message_center::MessageCenter,
+                          message_center::MessageCenterObserver>
+      observation_{this};
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_PLUTONIUM_NOTIFICATIONS_H_
