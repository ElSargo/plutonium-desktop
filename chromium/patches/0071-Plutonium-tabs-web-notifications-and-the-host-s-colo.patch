diff --git a/chrome/browser/devtools/cros_protocol.pdl b/chrome/browser/devtools/cros_protocol.pdl
index 6d530a0914..ab392b29c6 100644
--- a/chrome/browser/devtools/cros_protocol.pdl
+++ b/chrome/browser/devtools/cros_protocol.pdl
@@ -449,3 +449,46 @@ experimental domain Plutonium
   event lockChanged
     parameters
       boolean locked
+
+  # EXO-SERVICES: a tab's web notification (new Notification(), a service
+  # worker's showNotification()), for the helper's notifications service.
+  # Ash's message center has them, and shell mode never shows it.
+  type WebNotification extends object
+    properties
+      string id
+      # The site's origin.
+      string origin
+      string title
+      string body
+      # A PNG data URL, or empty.
+      string icon
+      # Its action buttons' labels.
+      array of string buttons
+      boolean requireInteraction
+      boolean silent
+
+  # A new or updated one; on enable, each there is.
+  event notificationShown
+    parameters
+      WebNotification notification
+
+  # It went: the page closed it, or it was acted on.
+  event notificationClosed
+    parameters
+      string id
+
+  # click (the notification, or with button one of its buttons: the page's
+  # onclick, the worker's notificationclick), or close (dismissed by the
+  # user).
+  command notificationAction
+    parameters
+      string id
+      string action
+      optional integer button
+
+  # EXO-SERVICES: the host's color scheme (the settings portal's
+  # org.freedesktop.appearance color-scheme), which Ash's dark mode then
+  # follows: prefers-color-scheme in shells and tabs, and Ash's own views.
+  command setColorScheme
+    parameters
+      boolean dark
diff --git a/chrome/browser/devtools/protocol/plutonium_handler.cc b/chrome/browser/devtools/protocol/plutonium_handler.cc
index 67c9776560..358bce4d95 100644
--- a/chrome/browser/devtools/protocol/plutonium_handler.cc
+++ b/chrome/browser/devtools/protocol/plutonium_handler.cc
@@ -7,6 +7,9 @@
 #include <utility>
 #include <vector>
 
+#include "ash/constants/ash_pref_names.h"
+#include "ash/session/session_controller_impl.h"
+#include "ash/shell.h"
 #include "base/json/json_reader.h"
 #include "base/json/json_writer.h"
 #include "base/strings/utf_string_conversions.h"
@@ -14,6 +17,7 @@
 #include "chrome/browser/plutonium_shells.h"
 #include "chrome/browser/plutonium_tab_requests.h"
 #include "components/exo/embedded_windows.h"
+#include "components/prefs/pref_service.h"
 #include "content/public/browser/devtools_agent_host.h"
 #include "content/public/browser/web_contents.h"
 #include "third_party/skia/include/core/SkBitmap.h"
@@ -212,6 +216,16 @@ Response PlutoniumHandler::Enable() {
   if (PlutoniumLock* lock = PlutoniumLock::Get()) {
     lock_observation_.Observe(lock);
   }
+  // EXO-SERVICES: the web notifications there are, then the new ones.
+  notifications_ = std::make_unique<PlutoniumWebNotifications>(
+      base::BindRepeating(&PlutoniumHandler::OnNotificationShown,
+                          base::Unretained(this)),
+      base::BindRepeating(&PlutoniumHandler::OnNotificationClosed,
+                          base::Unretained(this)));
+  for (const PlutoniumWebNotifications::Info& info :
+       notifications_->GetNotifications()) {
+    OnNotificationShown(info);
+  }
   return Response::Success();
 }
 
@@ -223,6 +237,7 @@ Response PlutoniumHandler::Disable() {
   capture_observation_.Reset();
   lock_observation_.Reset();
   media_session_.reset();
+  notifications_.reset();
   screencasts_.clear();
   awake_tabs_.clear();
   awake_windows_.clear();
@@ -917,3 +932,55 @@ Response PlutoniumHandler::SetDisplaysOff(bool off, bool* applied) {
 void PlutoniumHandler::OnLockChanged(bool locked) {
   frontend_->LockChanged(locked);
 }
+
+void PlutoniumHandler::OnNotificationShown(
+    const PlutoniumWebNotifications::Info& info) {
+  auto buttons = std::make_unique<protocol::Array<std::string>>();
+  for (const std::u16string& button : info.buttons) {
+    buttons->push_back(base::UTF16ToUTF8(button));
+  }
+  frontend_->NotificationShown(Plutonium::WebNotification::Create()
+                                   .SetId(info.id)
+                                   .SetOrigin(info.origin)
+                                   .SetTitle(base::UTF16ToUTF8(info.title))
+                                   .SetBody(base::UTF16ToUTF8(info.body))
+                                   .SetIcon(info.icon)
+                                   .SetButtons(std::move(buttons))
+                                   .SetRequireInteraction(
+                                       info.require_interaction)
+                                   .SetSilent(info.silent)
+                                   .Build());
+}
+
+void PlutoniumHandler::OnNotificationClosed(const std::string& id) {
+  frontend_->NotificationClosed(id);
+}
+
+Response PlutoniumHandler::NotificationAction(const std::string& id,
+                                              const std::string& action,
+                                              std::optional<int> button) {
+  if (!notifications_) {
+    return Response::ServerError("Plutonium.enable first.");
+  }
+  if (action != "click" && action != "close") {
+    return Response::InvalidParams("action is click or close.");
+  }
+  if (!notifications_->Perform(id, action, button)) {
+    return Response::InvalidParams("No such notification or button.");
+  }
+  return Response::Success();
+}
+
+Response PlutoniumHandler::SetColorScheme(bool dark) {
+  // Ash's dark mode is the user's pref: its controller, then the color
+  // palette controller, carry it to the web's and Ash's native themes.
+  PrefService* prefs =
+      ash::Shell::HasInstance()
+          ? ash::Shell::Get()->session_controller()->GetActivePrefService()
+          : nullptr;
+  if (!prefs) {
+    return Response::ServerError("There's no user session yet.");
+  }
+  prefs->SetBoolean(ash::prefs::kDarkModeEnabled, dark);
+  return Response::Success();
+}
