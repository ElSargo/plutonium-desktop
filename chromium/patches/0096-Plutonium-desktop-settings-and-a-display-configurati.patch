+  // EXO-DISPLAYS: the display configuration tool.
+
+  void ConfigureDisplays(base::DictValue change) {
+    PlutoniumDisplayConfig* config = PlutoniumDisplayConfig::Get();
+    if (!config) {
+      SetStatus(u"There are no displays to configure yet.");
+      return;
+    }
+    const std::string error = config->Configure(change);
+    if (!error.empty()) {
+      SetStatus(U(error));
+    } else {
+      SetStatus(std::u16string());
+    }
+    UpdatePage(/*force=*/true);
+    RebuildSoon();
+  }
+
+  void SelectDisplay(const std::string& id) {
+    display_selected_ = id;
+    UpdatePage(/*force=*/true);
+  }
+
+  void MoveDisplay(const std::string& id, const gfx::Point& origin) {
+    display_selected_ = id;
+    base::ListValue layout;
+    layout.Append(base::DictValue()
+                      .Set("display", id)
+                      .Set("x", origin.x())
+                      .Set("y", origin.y()));
+    ConfigureDisplays(base::DictValue().Set("layout", std::move(layout)));
+  }
+
+  void ChangeDisplay(const std::string& id,
+                     const std::string& key,
+                     base::Value value,
+                     bool confirm) {
+    base::DictValue change;
+    change.Set("display", id);
+    change.Set(key, std::move(value));
+    if (confirm) {
+      change.Set("confirm", true);
+    }
+    ConfigureDisplays(std::move(change));
+  }
+
+  void SetMode(const std::string& id, int width, int height, double rate) {
+    ChangeDisplay(id, "mode",
+                  base::Value(base::DictValue()
+                                  .Set("width", width)
+                                  .Set("height", height)
+                                  .Set("refreshRate", rate)),
+                  /*confirm=*/true);
+  }
+
+  void SetZoom(const std::string& id, double zoom) {
+    ChangeDisplay(id, "zoom", base::Value(zoom), /*confirm=*/true);
+  }
+
+  void SetRotation(const std::string& id, int rotation) {
+    ChangeDisplay(id, "rotation", base::Value(rotation), /*confirm=*/true);
+  }
+
+  void MakePrimary(const std::string& id) {
+    ChangeDisplay(id, "primary", base::Value(true), /*confirm=*/false);
+  }
+
+  void SetDisplayEnabled(const std::string& id, bool enabled) {
+    ChangeDisplay(id, "enabled", base::Value(enabled), /*confirm=*/!enabled);
+  }
+
+  void SetMirror(bool on) {
+    ConfigureDisplays(base::DictValue().Set("mirror", on).Set("confirm", true));
+  }
+
+  void KeepDisplays() {
+    ConfigureDisplays(base::DictValue().Set("keep", true));
+  }
+
+  void RevertDisplays() {
+    ConfigureDisplays(base::DictValue().Set("revert", true));
+  }
+
+  // Puts display |id| beside display |other| (its left, right, top or
+  // bottom), as a drag there would.
+  void PlaceDisplay(const std::string& id,
+                    gfx::Rect bounds,
+                    gfx::Rect other,
+                    int side) {
+    gfx::Point origin;
+    switch (side) {
+      case 0:  // Left.
+        origin = gfx::Point(other.x() - bounds.width(), other.y());
+        break;
+      case 1:  // Right.
+        origin = gfx::Point(other.right(), other.y());
+        break;
+      case 2:  // Above.
+        origin = gfx::Point(other.x(), other.y() - bounds.height());
+        break;
+      default:  // Below.
+        origin = gfx::Point(other.x(), other.bottom());
+        break;
+    }
+    MoveDisplay(id, origin);
+  }
+
+  static gfx::Rect RectOf(const base::DictValue* rect) {
+    return gfx::Rect(static_cast<int>(Num(rect, "x")),
+                     static_cast<int>(Num(rect, "y")),
+                     static_cast<int>(Num(rect, "width")),
+                     static_cast<int>(Num(rect, "height")));
+  }
+
+  static std::u16string ModeText(const base::DictValue* mode) {
+    if (!mode) {
+      return u"—";
+    }
+    const double rate = Num(mode, "refreshRate");
+    // Without a rate (an X11 host window), just the size.
+    return base::NumberToString16(static_cast<int>(Num(mode, "width"))) +
+           u" × " +
+           base::NumberToString16(static_cast<int>(Num(mode, "height"))) +
+           (rate > 0 ? u" at " + U(base::NumberToString(rate)) + u" Hz"
+                     : std::u16string());
+  }
+
+  void BuildDisplaysPage() {
+    const base::DictValue config = DisplayConfig();
+    const base::ListValue* displays = config.FindList("displays");
+    AddTitle(u"Displays",
+             displays ? (displays->size() == 1
+                             ? u"1 display"
+                             : base::NumberToString16(displays->size()) +
+                                   u" displays")
+                      : u"",
+             kOk, Bool(&config, "mirror") ? u"Mirrored" : u"");
+    if (!displays || displays->empty()) {
+      AddParagraph(page_, u"Ash hasn't set up its displays yet.", kDim);
+      return;
+    }
+
+    // A change waiting for Keep.
+    if (const base::DictValue* pending = config.FindDict("pending")) {
+      auto* banner = AddBox(page_, views::BoxLayout::Orientation::kHorizontal,
+                            10, gfx::Insets::VH(10, 14));
+      banner->SetBackground(views::CreateRoundedRectBackground(kSelected, 8));
+      pending_label_ = AddLabel(
+          banner,
+          u"Keep this?  " + U(Str(pending, "what")) + u" goes back in " +
+              base::NumberToString16(
+                  static_cast<int>(Num(pending, "secondsLeft"))) +
+              u" s.",
+          kWarn, 1, /*bold=*/true);
+      static_cast<views::BoxLayout*>(banner->GetLayoutManager())
+          ->SetFlexForView(pending_label_, 1);
+      AddButton(banner, u"Keep", Bind(&PlutoniumOverlayView::KeepDisplays),
+                ActionButton::Style::kPrimary);
+      AddButton(banner, u"Go back",
+                Bind(&PlutoniumOverlayView::RevertDisplays));
+    }
+
+    // Which display the controls below are for.
+    const base::DictValue* selected = nullptr;
+    const base::DictValue* primary = nullptr;
+    for (const base::Value& item : *displays) {
+      const base::DictValue* display = item.GetIfDict();
+      if (Bool(display, "primary")) {
+        primary = display;
+      }
+      if (display && Str(display, "id") == display_selected_) {
+        selected = display;
+      }
+    }
+    if (!selected) {
+      selected = primary ? primary : (*displays)[0].GetIfDict();
+    }
+    if (!selected) {
+      return;
+    }
+    const std::string id = Str(selected, "id");
+
+    // The arrangement.
+    std::vector<ArrangementView::Item> items;
+    for (const base::Value& item : *displays) {
+      const base::DictValue* display = item.GetIfDict();
+      if (!display || !Bool(display, "enabled") ||
+          display->FindString("mirrorOf")) {
+        continue;
+      }
+      ArrangementView::Item entry;
+      entry.id = Str(display, "id");
+      entry.index = display->FindInt("index").value_or(0);
+      entry.name = U(Str(display, "name"));
+      entry.detail = ModeText(display->FindDict("mode"));
+      entry.bounds = RectOf(display->FindDict("bounds"));
+      entry.primary = Bool(display, "primary");
+      items.push_back(std::move(entry));
+    }
+    auto* arrange = AddSection(u"Arrangement");
+    if (items.size() > 1) {
+      AddParagraph(arrange,
+                   u"Drag a display to where it is on your desk; it goes "
+                   u"against the nearest edge of another. Click one to change "
+                   u"it below.",
+                   kDim);
+      arrange->AddChildView(std::make_unique<ArrangementView>(
+          std::move(items), id,
+          base::BindRepeating(&PlutoniumOverlayView::SelectDisplay,
+                              weak_ptr_factory_.GetWeakPtr()),
+          base::BindRepeating(&PlutoniumOverlayView::MoveDisplay,
+                              weak_ptr_factory_.GetWeakPtr())));
+    }
+    // A button per display (the keyboard's way to pick one).
+    auto* pick = AddButtons(arrange);
+    for (const base::Value& item : *displays) {
+      const base::DictValue* display = item.GetIfDict();
+      if (!display) {
+        continue;
+      }
+      const std::string other = Str(display, "id");
+      const int index = display->FindInt("index").value_or(0);
+      AddButton(pick,
+                (index ? base::NumberToString16(index) + u"  " : u"") +
+                    U(Str(display, "name")) +
+                    (Bool(display, "enabled") ? u"" : u"  (off)") +
+                    (display->FindString("mirrorOf") ? u"  (mirror)" : u""),
+                Bind(&PlutoniumOverlayView::SelectDisplay, other),
+                other == id ? ActionButton::Style::kPrimary
+                            : ActionButton::Style::kNormal);
+    }
+    if (Bool(&config, "canMirror")) {
+      const bool mirror = Bool(&config, "mirror");
+      auto* row = AddButtons(arrange);
+      AddButton(row, mirror ? u"Mirroring: on" : u"Mirroring: off",
+                Bind(&PlutoniumOverlayView::SetMirror, !mirror),
+                mirror ? ActionButton::Style::kPrimary
+                       : ActionButton::Style::kNormal);
+      AddLabel(row,
+               mirror ? u"Every display shows the same picture."
+                      : u"Each display is its own part of the desktop.",
+               kDim);
+    }
+
+    BuildDisplaySettings(*selected, primary, config);
+  }
+
+  void BuildDisplaySettings(const base::DictValue& display,
+                            const base::DictValue* primary,
+                            const base::DictValue& config) {
+    const std::string id = Str(&display, "id");
+    const bool enabled = Bool(&display, "enabled");
+    const bool mirrored = !!display.FindString("mirrorOf");
+    const bool is_primary = Bool(&display, "primary");
+    const int index = display.FindInt("index").value_or(0);
+    auto* section =
+        AddSection((index ? u"Display " + base::NumberToString16(index) + u":  "
+                          : std::u16string()) +
+                   U(Str(&display, "name")));
+    const base::DictValue* mode = display.FindDict("mode");
+    const gfx::Rect bounds = RectOf(display.FindDict("bounds"));
+    AddField(section, u"Mode", ModeText(mode));
+    AddField(section, u"Desktop size",
+             base::NumberToString16(bounds.width()) + u" × " +
+                 base::NumberToString16(bounds.height()) + u" at " +
+                 base::NumberToString16(bounds.x()) + u", " +
+                 base::NumberToString16(bounds.y()) + u"  ·  scale " +
+                 U(base::NumberToString(Num(&display, "scale"))));
+    AddField(
+        section, u"Kind",
+        std::u16string(Bool(&display, "internal") ? u"Built-in" : u"Monitor") +
+            (is_primary ? u", primary (the shells' startup display)" : u""));
+
+    // On or off: only the built-in panel, while a monitor is on.
+    if (Bool(&display, "internal") &&
+        (!enabled || Bool(&config, "canTurnOffPanel"))) {
+      auto* power = AddButtons(section);
+      AddButton(power,
+                enabled ? u"Turn the built-in display off"
+                        : u"Turn the built-in display on",
+                Bind(&PlutoniumOverlayView::SetDisplayEnabled, id, !enabled),
+                enabled ? ActionButton::Style::kNormal
+                        : ActionButton::Style::kPrimary);
+      if (enabled) {
+        AddLabel(power, u"While a monitor is on: like closing the lid.", kDim);
+      }
+    }
+    if (!enabled) {
+      AddParagraph(section, u"It's off: turn it on to change it.", kDim);
+      return;
+    }
+    if (mirrored) {
+      AddParagraph(section,
+                   u"It shows another display's picture: turn mirroring off "
+                   u"to change it.",
+                   kDim);
+      return;
+    }
+
+    auto* actions = AddButtons(section);
+    AddButton(actions, is_primary ? u"Primary" : u"Make it primary",
+              Bind(&PlutoniumOverlayView::MakePrimary, id),
+              is_primary ? ActionButton::Style::kPrimary
+                         : ActionButton::Style::kNormal,
+              !is_primary);
+    if (primary && !is_primary) {
+      const gfx::Rect other = RectOf(primary->FindDict("bounds"));
+      const std::pair<int, std::u16string> sides[] = {
+          {0, u"Left of"}, {1, u"Right of"}, {2, u"Above"}, {3, u"Below"}};
+      for (const auto& [side, label] : sides) {
+        AddButton(
+            actions,
+            label + u" " +
+                base::NumberToString16(primary->FindInt("index").value_or(1)),
+            Bind(&PlutoniumOverlayView::PlaceDisplay, id, bounds, other, side));
+      }
+    }
+
+    // Resolutions: each size once, biggest first, then its rates.
+    const base::ListValue* modes = display.FindList("modes");
+    const int width = static_cast<int>(Num(mode, "width"));
+    const int height = static_cast<int>(Num(mode, "height"));
+    const double rate = Num(mode, "refreshRate");
+    std::vector<std::pair<int, int>> sizes;
+    std::vector<double> rates;
+    static const base::NoDestructor<base::ListValue> kNone;
+    for (const base::Value& item : modes ? *modes : *kNone) {
+      const base::DictValue* candidate = item.GetIfDict();
+      const std::pair<int, int> size(
+          static_cast<int>(Num(candidate, "width")),
+          static_cast<int>(Num(candidate, "height")));
+      if (!std::ranges::contains(sizes, size)) {
+        sizes.push_back(size);
+      }
+      if (size == std::make_pair(width, height) &&
+          !std::ranges::contains(rates, Num(candidate, "refreshRate"))) {
+        rates.push_back(Num(candidate, "refreshRate"));
+      }
+    }
+    std::ranges::sort(sizes, [](const auto& a, const auto& b) {
+      return a.first * a.second > b.first * b.second;
+    });
+    std::ranges::sort(rates, std::greater<>());
+    if (sizes.size() > 1) {
+      AddChoiceLabel(section, u"Resolution");
+      views::View* row = nullptr;
+      int in_row = 0;
+      for (const auto& [w, h] : sizes) {
+        if (!row || in_row == 5) {
+          row = AddButtons(section);
+          in_row = 0;
+        }
+        ++in_row;
+        const bool current = w == width && h == height;
+        AddButton(
+            row, base::NumberToString16(w) + u" × " + base::NumberToString16(h),
+            Bind(&PlutoniumOverlayView::SetMode, id, w, h, rate),
+            current ? ActionButton::Style::kPrimary
+                    : ActionButton::Style::kNormal);
+      }
+    }
+    if (rates.size() > 1) {
+      AddChoiceLabel(section, u"Refresh rate");
+      auto* row = AddButtons(section);
+      for (double candidate : rates) {
+        AddButton(
+            row, U(base::NumberToString(candidate)) + u" Hz",
+            Bind(&PlutoniumOverlayView::SetMode, id, width, height, candidate),
+            std::abs(candidate - rate) < 0.01 ? ActionButton::Style::kPrimary
+                                              : ActionButton::Style::kNormal);
+      }
+    }
+
+    // Size: Ash's zoom levels, as percentages (more is bigger).
+    const base::ListValue* zooms = display.FindList("zooms");
+    const double zoom = Num(&display, "zoom", 1);
+    if (zooms && zooms->size() > 1) {
+      AddChoiceLabel(section, u"Size (how big things are)");
+      views::View* row = nullptr;
+      int in_row = 0;
+      for (const base::Value& item : *zooms) {
+        if (!item.is_double() && !item.is_int()) {
+          continue;
+        }
+        if (!row || in_row == 7) {
+          row = AddButtons(section);
+          in_row = 0;
+        }
+        ++in_row;
+        const double candidate = item.GetDouble();
+        AddButton(row, Percent(candidate),
+                  Bind(&PlutoniumOverlayView::SetZoom, id, candidate),
+                  std::abs(candidate - zoom) < 0.01
+                      ? ActionButton::Style::kPrimary
+                      : ActionButton::Style::kNormal);
+      }
+    }
+
+    AddChoiceLabel(section, u"Rotation");
+    auto* rotations = AddButtons(section);
+    const int rotation = display.FindInt("rotation").value_or(0);
+    const std::pair<int, std::u16string> choices[] = {
+        {0, u"Normal"},
+        {90, u"90° clockwise"},
+        {180, u"Upside down"},
+        {270, u"90° anticlockwise"},
+    };
+    for (const auto& [degrees, label] : choices) {
+      AddButton(rotations, label,
+                Bind(&PlutoniumOverlayView::SetRotation, id, degrees),
+                degrees == rotation ? ActionButton::Style::kPrimary
+                                    : ActionButton::Style::kNormal);
+    }
+    AddParagraph(section,
+                 u"A new resolution, size, rotation or mirroring goes back "
+                 u"after 15 s unless you keep it. Settings are remembered "
+                 u"for this set of displays.",
+                 kDim);
+  }
+
+  void AddChoiceLabel(views::View* parent, const std::u16string& text) {
+    views::Label* label = AddLabel(parent, text, kDim);
+    label->SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(6, 0, 0, 0)));
+  }
+
+  raw_ptr<PlutoniumShells> shells_;
+  raw_ptr<PlutoniumOverlay> overlay_;
+  raw_ptr<views::Textfield> search_ = nullptr;
+  raw_ptr<views::Label> shells_heading_ = nullptr;
+  raw_ptr<views::Label> windows_heading_ = nullptr;
+  raw_ptr<views::ScrollView> shells_scroll_ = nullptr;
+  raw_ptr<views::ScrollView> windows_scroll_ = nullptr;
+  raw_ptr<views::ScrollView> page_scroll_ = nullptr;
+  raw_ptr<views::View> page_ = nullptr;
+  raw_ptr<views::Label> status_ = nullptr;
+  raw_ptr<views::Label> footer_ = nullptr;
+
+  std::vector<Row> rows_;
+  int selected_ = -1;
+  std::string selected_key_;
+  bool rebuild_pending_ = false;
+  bool icons_pending_ = false;
+  base::CallbackListSubscription icons_subscription_;
+  std::u16string shell_states_;
+  base::RepeatingTimer poll_;
+
+  // The page shown, and what was on it.
+  std::string page_key_;
+  std::string page_signature_;
+  raw_ptr<views::Textfield> name_field_ = nullptr;
+  raw_ptr<views::Textfield> url_field_ = nullptr;
+  raw_ptr<views::Textfield> app_filter_ = nullptr;
+  raw_ptr<views::View> app_list_ = nullptr;
+  raw_ptr<views::ImageView> snapshot_view_ = nullptr;
+  SkBitmap snapshot_;
+  int snapshot_generation_ = 0;
+  // A shell's Remove was clicked once.
+  std::string confirm_remove_id_;
+
+  AppsState apps_state_ = AppsState::kNotLoaded;
+  std::u16string apps_error_;
+  // The helper's installed shells, as it last sent them.
+  base::ListValue packages_;
+  std::string packages_json_;
+  bool packages_loading_ = false;
+  // Notices already put in the status line while the switcher is open.
+  std::vector<std::string> notices_shown_;
+  std::vector<App> apps_;
+
+  // EXO-SETTINGS: the helper's services' states (/v1/system/services).
+  base::DictValue services_;
+  std::string services_json_;
+  bool services_loading_ = false;
+  bool services_loaded_ = false;
+  std::u16string services_error_;
+  // The page's sliders, by id.
+  std::map<int, SliderBinding> sliders_;
+  int next_slider_ = 1;
+  // A button that was clicked once and wants a second (power, forget).
+  std::string confirm_action_;
+  // The network whose password is being asked, and its field.
+  std::string password_ssid_;
+  raw_ptr<views::Textfield> password_field_ = nullptr;
+  // EXO-DISPLAYS: the display the Displays page's controls are for, what
+  // the configuration was (without its countdown), and the countdown.
+  std::string display_selected_;
+  std::string display_structure_;
+  raw_ptr<views::Label> pending_label_ = nullptr;
+
+  base::WeakPtrFactory<PlutoniumOverlayView> weak_ptr_factory_{this};
+};
