+  void BuildNotificationsPage() {
+    SkColor dot;
+    AddTitle(u"Notifications", NotificationsSummary(&dot), dot);
+    const base::DictValue* notifications = ServiceState("notifications");
+    if (!notifications) {
+      AddNotAvailable(u"");
+      return;
+    }
+    const bool quiet = Bool(notifications, "doNotDisturb");
+    const base::ListValue* list = notifications->FindList("notifications");
+    auto* actions = AddButtons(page_);
+    AddButton(
+        actions, quiet ? u"Do not disturb: on" : u"Do not disturb: off",
+        Bind(&PlutoniumOverlayView::CallService, std::string("notifications"),
+             std::string("set-do-not-disturb"),
+             base::DictValue().Set("on", !quiet), std::u16string()),
+        quiet ? ActionButton::Style::kPrimary : ActionButton::Style::kNormal);
+    AddButton(
+        actions, u"Clear all",
+        Bind(&PlutoniumOverlayView::CallService, std::string("notifications"),
+             std::string("clear"), base::DictValue(), std::u16string()),
+        ActionButton::Style::kNormal, list && !list->empty());
+    if (quiet) {
+      AddParagraph(
+          page_, u"New notifications don't pop up, except urgent ones.", kDim);
+    }
+    auto* section = AddSection(u"Recent");
+    if (!list || list->empty()) {
+      AddParagraph(section, u"No notifications.", kDim);
+      return;
+    }
+    int shown = 0;
+    for (const base::Value& item : *list) {
+      const base::DictValue* note = item.GetIfDict();
+      const base::Value* id = note ? note->Find("id") : nullptr;
+      if (!id || ++shown > 30) {
+        continue;
+      }
+      auto* row = AddButtons(section);
+      auto* text = AddBox(row, views::BoxLayout::Orientation::kVertical, 1);
+      AddLabel(text, U(Str(note, "summary")), kTitle, 1, /*bold=*/true);
+      const std::string body = Str(note, "body");
+      AddLabel(text,
+               U(Str(note, "app")) +
+                   (body.empty() ? std::u16string() : u"  ·  " + U(body)),
+               kDim, -1);
+      text->SetPreferredSize(
+          gfx::Size(380, text->GetPreferredSize(views::SizeBounds()).height()));
+      AddButton(
+          row, u"Open",
+          Bind(
+              &PlutoniumOverlayView::CallService, std::string("notifications"),
+              std::string("invoke"),
+              base::DictValue().Set("id", id->Clone()).Set("action", "default"),
+              std::u16string()));
+      AddButton(
+          row, u"Dismiss",
+          Bind(&PlutoniumOverlayView::CallService, std::string("notifications"),
+               std::string("dismiss"), base::DictValue().Set("id", id->Clone()),
+               std::u16string()));
+    }
+  }
