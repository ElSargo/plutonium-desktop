+display::DisplayManager* Manager() {
+  return ash::Shell::Get()->display_manager();
+}
+
+// How far (DIPs) an edge may be from lining up with another's and still be
+// taken as lined up.
+constexpr int kSnap = 48;
+
+bool IsDrm() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+             "ozone-platform") == "drm";
+}
+
+std::string IdString(int64_t id) {
+  return base::NumberToString(id);
+}
+
+// A display id: a string (they don't fit in a double), or a small number.
+std::optional<int64_t> IdOf(const base::Value* value) {
+  if (!value) {
+    return std::nullopt;
+  }
+  int64_t id = 0;
+  if (value->is_string() && base::StringToInt64(value->GetString(), &id)) {
+    return id;
+  }
+  if (value->is_int()) {
+    return value->GetInt();
+  }
+  return std::nullopt;
+}
+
+std::optional<display::Display> FindDisplay(int64_t id) {
+  display::Display display;
+  if (display::Screen::Get()->GetDisplayWithDisplayId(id, &display)) {
+    return display;
+  }
+  return std::nullopt;
+}
+
+// Two decimals (59.94 Hz, scale 1.25).
+double Rounded(double value) {
+  return std::round(value * 100) / 100;
+}
+
+base::DictValue RectValue(const gfx::Rect& rect) {
+  return base::DictValue()
+      .Set("x", rect.x())
+      .Set("y", rect.y())
+      .Set("width", rect.width())
+      .Set("height", rect.height());
+}
+
+base::DictValue ModeValue(const display::ManagedDisplayMode& mode) {
+  return base::DictValue()
+      .Set("width", mode.size().width())
+      .Set("height", mode.size().height())
+      .Set("refreshRate", Rounded(mode.refresh_rate()))
+      .Set("scale", Rounded(mode.device_scale_factor()))
+      .Set("native", mode.native())
+      .Set("interlaced", mode.is_interlaced());
+}
+
+std::string ResultText(ash::DisplayConfigResult result) {
+  switch (result) {
+    case ash::DisplayConfigResult::kSuccess:
+      return std::string();
+    case ash::DisplayConfigResult::kInvalidDisplayIdError:
+      return "No such display.";
+    case ash::DisplayConfigResult::kPropertyValueOutOfRangeError:
+      return "That value is out of range for this display.";
+    case ash::DisplayConfigResult::kNotSupportedOnInternalDisplayError:
+      return "The primary display stays where it is: move the others.";
+    case ash::DisplayConfigResult::kSetDisplayModeError:
+      return "The display didn't take that mode.";
+    case ash::DisplayConfigResult::kInvalidDisplayLayoutError:
+      return "Those places don't make a layout.";
+    case ash::DisplayConfigResult::kSingleDisplayError:
+      return "That needs two displays.";
+    default:
+      return "The display configuration refused that (error " +
+             base::NumberToString(static_cast<int>(result)) + ").";
+  }
+}
+
+// How far apart two rectangles are (0 if they touch or overlap).
+int Gap(const gfx::Rect& a, const gfx::Rect& b) {
+  const int dx = std::max({0, a.x() - b.right(), b.x() - a.right()});
+  const int dy = std::max({0, a.y() - b.bottom(), b.y() - a.bottom()});
+  return dx + dy;
+}
+
+// One display's entry. |display| is null for a display that isn't on the
+// desktop (mirrored onto another, or the panel turned off).
+base::DictValue Entry(int64_t id,
+                      const display::Display* display,
+                      bool enabled,
+                      const gfx::Rect& bounds) {
+  display::DisplayManager* manager = Manager();
+  std::map<int64_t, int> indices;
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    for (const PlutoniumShells::Display& entry : shells->GetDisplays()) {
+      indices[entry.id] = entry.index;
+    }
+  }
+  const display::ManagedDisplayInfo& info = manager->GetDisplayInfo(id);
+  base::DictValue entry;
+  entry.Set("id", IdString(id));
+  entry.Set("index", indices.contains(id) ? indices[id] : 0);
+  entry.Set("name", manager->GetDisplayNameForId(id));
+  entry.Set("internal",
+            display ? display->IsInternal() : display::IsInternalDisplayId(id));
+  entry.Set("primary",
+            display && id == display::Screen::Get()->GetPrimaryDisplay().id());
+  entry.Set("enabled", enabled);
+  entry.Set("bounds", RectValue(bounds));
+  entry.Set("workArea", RectValue(display ? display->work_area() : bounds));
+  entry.Set("rotation", display ? display->RotationAsDegree() : 0);
+  entry.Set("scale", Rounded(display ? display->device_scale_factor()
+                                     : info.GetEffectiveDeviceScaleFactor()));
+  entry.Set("zoom", Rounded(info.zoom_factor()));
+  base::ListValue zooms;
+  display::ManagedDisplayMode active;
+  const bool has_active = manager->GetActiveModeForDisplayId(id, &active);
+  if (has_active) {
+    for (float zoom : display::GetDisplayZoomFactors(active)) {
+      zooms.Append(Rounded(zoom));
+    }
+    entry.Set("mode", ModeValue(active));
+  } else {
+    zooms.Append(Rounded(info.zoom_factor()));
+    entry.Set("mode", base::Value());
+  }
+  entry.Set("zooms", std::move(zooms));
+  base::ListValue modes;
+  for (const display::ManagedDisplayMode& mode : info.display_modes()) {
+    modes.Append(ModeValue(mode));
+  }
+  entry.Set("modes", std::move(modes));
+  return entry;
+}
