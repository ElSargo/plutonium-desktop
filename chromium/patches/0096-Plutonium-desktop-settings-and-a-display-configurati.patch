+      const base::DictValue* input = audio->FindDict("input");
+      const bool muted = Bool(input, "muted");
+      AddButton(
+          toggles, muted ? u"Microphone  ·  Muted" : u"Microphone",
+          Bind(&PlutoniumOverlayView::CallService, std::string("audio"),
+               std::string("set-mute"),
+               base::DictValue().Set("device", "input"), std::u16string()),
+          muted ? ActionButton::Style::kNormal : ActionButton::Style::kPrimary);
+    }
+
+    auto* levels = AddSection(u"Levels");
+    AddVolume(levels);
+    AddBrightness(levels);
+    AddNowPlaying(page_);
+
+    auto* power = AddSection(u"Power");
+    SkColor dot;
+    AddParagraph(power, PowerSummary(&dot), kDim);
+    AddPowerButtons(power);
+
+    auto* more = AddSection(u"More settings");
+    auto* row = AddButtons(more);
+    const std::pair<Row::Kind, std::u16string> pages[] = {
+        {Row::Kind::kNetwork, u"Wi-Fi and network…"},
+        {Row::Kind::kBluetooth, u"Bluetooth…"},
+        {Row::Kind::kSound, u"Sound…"},
+        {Row::Kind::kDisplays, u"Displays…"},
+        {Row::Kind::kPower, u"Power…"},
+        {Row::Kind::kNotifications, u"Notifications…"},
+    };
+    int in_row = 0;
+    for (const auto& [kind, label] : pages) {
+      if (in_row == 3) {
+        row = AddButtons(more);
+        in_row = 0;
+      }
+      ++in_row;
+      AddButton(row, label, Bind(&PlutoniumOverlayView::GoTo, kind));
+    }
+  }
