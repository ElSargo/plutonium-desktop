+  void BuildSettingsRows() {
+    const std::u16string query = Query();
+    struct Setting {
+      Row::Kind kind;
+      std::u16string title;
+      std::u16string detail;
+      SkColor dot;
+      std::u16string keywords;
+    };
+    SkColor network_dot, bluetooth_dot, sound_dot, power_dot, notes_dot,
+        displays_dot;
+    const std::u16string network = NetworkSummary(&network_dot);
+    const std::u16string bluetooth = BluetoothSummary(&bluetooth_dot);
+    const std::u16string sound = SoundSummary(&sound_dot);
+    const std::u16string power = PowerSummary(&power_dot);
+    const std::u16string notes = NotificationsSummary(&notes_dot);
+    const std::u16string displays = DisplaysSummary(&displays_dot);
+    const Setting settings[] = {
+        {Row::Kind::kQuickSettings, u"Quick settings",
+         u"Volume, brightness, Wi-Fi, Bluetooth, power", kAccent,
+         u"settings volume brightness wifi wi-fi bluetooth do not disturb "
+         u"battery lock suspend"},
+        {Row::Kind::kNetwork, u"Wi-Fi and network", network, network_dot,
+         u"wifi wi-fi wireless network internet ethernet vpn"},
+        {Row::Kind::kBluetooth, u"Bluetooth", bluetooth, bluetooth_dot,
+         u"bluetooth devices pair headphones mouse keyboard"},
+        {Row::Kind::kSound, u"Sound", sound, sound_dot,
+         u"sound volume audio speakers headphones microphone mute media"},
+        {Row::Kind::kDisplays, u"Displays", displays, displays_dot,
+         u"displays monitors screens resolution refresh rate scale size "
+         u"rotation primary mirror arrange"},
+        {Row::Kind::kPower, u"Power", power, power_dot,
+         u"power battery brightness suspend sleep restart reboot shut down "
+         u"power off log out lock idle screen off"},
+        {Row::Kind::kNotifications, u"Notifications", notes, notes_dot,
+         u"notifications do not disturb"},
+    };
+    bool header = false;
+    for (const Setting& setting : settings) {
+      if (!Matches(query, {setting.title, setting.detail, setting.keywords})) {
+        continue;
+      }
+      if (!header) {
+        Row heading;
+        heading.title = u"SETTINGS";
+        rows_.push_back(heading);
+        header = true;
+      }
+      Row row;
+      row.kind = setting.kind;
+      row.title = setting.title;
+      row.detail = setting.detail;
+      row.dot = setting.dot;
+      rows_.push_back(row);
+    }
+  }
