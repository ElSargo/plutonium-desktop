+// EXO-SETTINGS: the switcher's settings pages, and the names a shell opens
+// them by (the helper's display service, "open-settings").
+struct SettingsPage {
+  const char* name;
+  Row::Kind kind;
+};
+constexpr SettingsPage kSettingsPages[] = {
+    {"settings", Row::Kind::kQuickSettings},
+    {"network", Row::Kind::kNetwork},
+    {"bluetooth", Row::Kind::kBluetooth},
+    {"sound", Row::Kind::kSound},
+    {"power", Row::Kind::kPower},
+    {"notifications", Row::Kind::kNotifications},
+    {"displays", Row::Kind::kDisplays},
+};
+
+std::optional<Row::Kind> SettingsKind(std::string_view name) {
+  for (const SettingsPage& page : kSettingsPages) {
+    if (name == page.name) {
+      return page.kind;
+    }
+  }
+  return std::nullopt;
+}
+
+std::u16string U(std::string_view text) {
+  return base::UTF8ToUTF16(text);
+}
+
+std::string Str(const base::DictValue* dict, std::string_view key) {
+  const std::string* value = dict ? dict->FindString(key) : nullptr;
+  return value ? *value : std::string();
+}
+
+bool Bool(const base::DictValue* dict,
+          std::string_view key,
+          bool fallback = false) {
+  return dict ? dict->FindBool(key).value_or(fallback) : fallback;
+}
+
+double Num(const base::DictValue* dict,
+           std::string_view key,
+           double fallback = 0) {
+  return dict ? dict->FindDouble(key).value_or(fallback) : fallback;
+}
+
+std::u16string Percent(double value) {
+  return base::NumberToString16(static_cast<int>(std::lround(value * 100))) +
+         u"%";
+}
+
+// "1 h 20 min", "5 min".
+std::u16string Duration(double seconds) {
+  const int minutes = static_cast<int>(seconds / 60);
+  if (minutes >= 60) {
+    return base::NumberToString16(minutes / 60) + u" h " +
+           base::NumberToString16(minutes % 60) + u" min";
+  }
+  return base::NumberToString16(std::max(1, minutes)) + u" min";
+}
+
+// A state without what changes all the time (levels, signal strength, idle
+// time, the countdown): what a settings page's layout depends on.
+base::Value Structure(const base::Value& value) {
+  if (value.is_dict()) {
+    base::DictValue out;
+    for (const auto entry : value.GetDict()) {
+      const std::string& key = entry.first;
+      if (key == "volume" || key == "strength" || key == "idleSeconds" ||
+          key == "value" || key == "timeLeft" || key == "secondsLeft") {
+        continue;
+      }
+      out.Set(key, Structure(entry.second));
+    }
+    return base::Value(std::move(out));
+  }
+  if (value.is_list()) {
+    base::ListValue out;
+    for (const base::Value& item : value.GetList()) {
+      out.Append(Structure(item));
+    }
+    return base::Value(std::move(out));
+  }
+  return value.Clone();
+}
+
+std::string StructureJson(const base::Value& value) {
+  return base::WriteJson(Structure(value)).value_or(std::string());
+}
+
+cc::PaintFlags Fill(SkColor color) {
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(color);
+  return flags;
+}
