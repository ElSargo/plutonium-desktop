+  void BuildPowerPage() {
+    SkColor dot;
+    AddTitle(u"Power", PowerSummary(&dot), dot);
+    const base::DictValue* power = ServiceState("power");
+    if (!power) {
+      AddNotAvailable(u"");
+      return;
+    }
+    if (const base::DictValue* battery = power->FindDict("battery")) {
+      auto* section = AddSection(u"Battery");
+      AddField(
+          section, u"Charge",
+          base::NumberToString16(std::lround(Num(battery, "percent"))) + u"%");
+      AddField(section, u"State", U(Str(battery, "state")));
+      if (const std::optional<double> left = battery->FindDouble("timeLeft");
+          left && *left > 0) {
+        AddField(section,
+                 Bool(battery, "charging") ? u"Until full" : u"Time left",
+                 Duration(*left));
+      }
+    }
+    auto* screen = AddSection(u"Screen");
+    AddBrightness(screen);
+    const base::DictValue* session = ServiceState("session");
+    if (session) {
+      AddIdleChoice(screen, u"Screen off after", "screenOffAfter",
+                    static_cast<int>(Num(session, "screenOffAfter")));
+      AddIdleChoice(screen, u"Lock after", "lockAfter",
+                    static_cast<int>(Num(session, "lockAfter")));
+      if (const base::ListValue* inhibitors = session->FindList("inhibitors");
+          inhibitors && !inhibitors->empty()) {
+        std::vector<std::u16string> why;
+        for (const base::Value& item : *inhibitors) {
+          why.push_back(U(Str(item.GetIfDict(), "why")));
+        }
+        AddField(screen, u"Kept on by", base::JoinString(why, u",  "));
+      }
+    }
+    auto* actions = AddSection(u"Power");
+    AddPowerButtons(actions);
+    AddParagraph(actions,
+                 u"Restart, Power off and Log out ask for a second click. Log "
+                 u"out ends this Plutonium session.",
+                 kDim);
+  }
