+  void ForgetNetwork(const std::string& ssid) {
+    if (!Confirmed("forget/" + ssid)) {
+      return;
+    }
+    CallService("network", "forget", base::DictValue().Set("ssid", ssid),
+                u"Forgetting " + U(ssid) + u"…");
