+  std::string SettingsSignature(Row::Kind kind) const {
+    std::string signature =
+        confirm_action_ + "|" + password_ssid_ + "|" + display_selected_ + "|" +
+        base::UTF16ToUTF8(services_error_) + (services_loaded_ ? "l" : "");
+    auto add = [&](std::string_view name) {
+      if (const base::Value* state = services_.Find(name)) {
+        signature += StructureJson(*state);
+      }
+    };
+    switch (kind) {
+      case Row::Kind::kQuickSettings:
+        for (const char* name : {"network", "bluetooth", "audio", "power",
+                                 "media", "notifications", "session"}) {
+          add(name);
+        }
+        break;
+      case Row::Kind::kNetwork:
+        add("network");
+        break;
+      case Row::Kind::kBluetooth:
+        add("bluetooth");
+        break;
+      case Row::Kind::kSound:
+        add("audio");
+        add("media");
+        break;
+      case Row::Kind::kPower:
+        add("power");
+        add("session");
+        break;
+      case Row::Kind::kNotifications:
+        add("notifications");
+        break;
+      case Row::Kind::kDisplays:
+        signature += StructureJson(base::Value(DisplayConfig()));
+        break;
+      default:
+        break;
+    }
+    return signature;
+  }
