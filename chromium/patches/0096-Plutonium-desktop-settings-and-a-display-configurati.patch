+base::DictValue PlutoniumDisplayConfig::GetConfig() const {
+  base::DictValue config;
+  base::ListValue displays;
+  if (!ash::Shell::HasInstance() || !display::Screen::Get()) {
+    config.Set("displays", std::move(displays));
+    return config;
+  }
+  display::DisplayManager* manager = Manager();
+  const display::DisplayIdList connected = manager->GetConnectedDisplayIdList();
+  std::set<int64_t> listed;
+  std::vector<display::Display> all = display::Screen::Get()->GetAllDisplays();
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    // In the shells' order ("display 1" first).
+    std::vector<display::Display> sorted;
+    for (const PlutoniumShells::Display& entry : shells->GetDisplays()) {
+      if (std::optional<display::Display> display = FindDisplay(entry.id)) {
+        sorted.push_back(*display);
+      }
+    }
+    if (sorted.size() == all.size()) {
+      all = std::move(sorted);
+    }
+  }
+  for (const display::Display& display : all) {
+    displays.Append(Entry(display.id(), &display, true, display.bounds()));
+    listed.insert(display.id());
+  }
+  // Mirroring: the displays that show another's picture.
+  if (manager->IsInMirrorMode()) {
+    std::optional<display::Display> source =
+        FindDisplay(manager->mirroring_source_id());
+    for (int64_t id : manager->GetMirroringDestinationDisplayIdList()) {
+      if (!listed.contains(id) && std::ranges::contains(connected, id)) {
+        displays.Append(
+            Entry(id, nullptr, true, source ? source->bounds() : gfx::Rect())
+                .Set("mirrorOf", IdString(manager->mirroring_source_id())));
+        listed.insert(id);
+      }
+    }
+  }
+  // The panel, turned off.
+  if (internal_off_ && !listed.contains(internal_id_)) {
+    displays.Append(internal_entry_.Clone());
+  }
+  config.Set("displays", std::move(displays));
+  config.Set("mirror", manager->IsInMirrorMode());
+  config.Set("canMirror", connected.size() > 1);
+  config.Set("canTurnOffPanel", IsDrm());
+  if (pending_) {
+    config.Set("pending", base::DictValue()
+                              .Set("what", base::UTF16ToUTF8(pending_->what))
+                              .Set("secondsLeft", PendingSecondsLeft()));
+  } else {
+    config.Set("pending", base::Value());
+  }
+  return config;
+}
+
+std::string PlutoniumDisplayConfig::Configure(const base::DictValue& change) {
+  if (!ash::Shell::HasInstance() || !display::Screen::Get()) {
+    return "There are no displays yet.";
+  }
+  const bool confirm = change.FindBool("confirm").value_or(false);
+  if (change.FindBool("keep").value_or(false)) {
+    if (!pending_) {
+      return "Nothing is waiting to be kept.";
+    }
+    VLOG(1) << "EXO-DISPLAYS kept: " << pending_->what;
+    pending_.reset();
+    revert_timer_.Stop();
+    return std::string();
+  }
+  if (change.FindBool("revert").value_or(false)) {
+    if (!pending_) {
+      return "Nothing is waiting to be put back.";
+    }
+    RevertPending();
+    return std::string();
+  }
+  if (const base::ListValue* layout = change.FindList("layout")) {
+    return Arrange(*layout);
+  }
+  if (std::optional<bool> mirror = change.FindBool("mirror")) {
+    return SetMirror(*mirror, confirm);
+  }
+  if (change.Find("display")) {
+    return ConfigureDisplay(change, confirm);
+  }
+  return "A change names a display, a layout, or mirroring.";
+}
+
+std::string PlutoniumDisplayConfig::ConfigureDisplay(
+    const base::DictValue& change,
+    bool confirm) {
+  std::optional<int64_t> id = IdOf(change.Find("display"));
+  if (!id) {
+    return "display is a display's id.";
+  }
+  if (std::optional<bool> enabled = change.FindBool("enabled")) {
+    return SetInternalEnabled(*id, *enabled, confirm);
+  }
+  std::optional<display::Display> display = FindDisplay(*id);
+  if (!display) {
+    return "No display " + IdString(*id) +
+           " on the desktop (it may be off, or mirrored).";
+  }
+  display::DisplayManager* manager = Manager();
+  ash::DisplayConfigProperties properties;
+  base::DictValue undo;
+  undo.Set("display", IdString(*id));
+  std::vector<std::u16string> what;
+
+  if (change.FindBool("primary").value_or(false)) {
+    properties.set_primary = true;
+  }
+  if (std::optional<int> rotation = change.FindInt("rotation")) {
+    switch (*rotation) {
+      case 0:
+        properties.rotation = ash::DisplayRotationOptions::kZeroDegrees;
+        break;
+      case 90:
+        properties.rotation = ash::DisplayRotationOptions::k90Degrees;
+        break;
+      case 180:
+        properties.rotation = ash::DisplayRotationOptions::k180Degrees;
+        break;
+      case 270:
+        properties.rotation = ash::DisplayRotationOptions::k270Degrees;
+        break;
+      default:
+        return "rotation is 0, 90, 180 or 270.";
+    }
+    if (*rotation != display->RotationAsDegree()) {
+      undo.Set("rotation", display->RotationAsDegree());
+      what.push_back(u"rotation");
+    }
+  }
+  if (const base::DictValue* position = change.FindDict("position")) {
+    std::optional<int> x = position->FindInt("x");
+    std::optional<int> y = position->FindInt("y");
+    if (!x || !y) {
+      return "position is {x, y}, whole DIPs.";
+    }
+    properties.bounds_origin = gfx::Point(*x, *y);
+  }
+  if (std::optional<double> zoom = change.FindDouble("zoom")) {
+    if (*zoom <= 0) {
+      return "zoom is above 0.";
+    }
+    properties.display_zoom_factor = *zoom;
+    const double current = manager->GetDisplayInfo(*id).zoom_factor();
+    if (std::abs(*zoom - current) > 0.001) {
+      undo.Set("zoom", current);
+      what.push_back(u"size");
+    }
+  }
+  if (const base::DictValue* mode = change.FindDict("mode")) {
+    std::optional<int> width = mode->FindInt("width");
+    std::optional<int> height = mode->FindInt("height");
+    std::optional<double> refresh = mode->FindDouble("refreshRate");
+    if (!width || !height) {
+      return "mode is {width, height, refreshRate?}.";
+    }
+    // The mode of that size whose rate is nearest; without a rate, the
+    // highest (or the native one's).
+    const display::ManagedDisplayMode* best = nullptr;
+    for (const display::ManagedDisplayMode& candidate :
+         manager->GetDisplayInfo(*id).display_modes()) {
+      if (candidate.size() != gfx::Size(*width, *height)) {
+        continue;
+      }
+      if (!best) {
+        best = &candidate;
+        continue;
+      }
+      const bool closer = refresh
+                              ? std::abs(candidate.refresh_rate() - *refresh) <
+                                    std::abs(best->refresh_rate() - *refresh)
+                              : candidate.refresh_rate() > best->refresh_rate();
+      if (closer) {
+        best = &candidate;
+      }
+    }
+    if (!best) {
+      return "This display has no " + base::NumberToString(*width) + "×" +
+             base::NumberToString(*height) + " mode.";
+    }
+    properties.display_mode = *best;
+    display::ManagedDisplayMode current;
+    if (manager->GetActiveModeForDisplayId(*id, &current) &&
+        !current.IsEquivalent(*best)) {
+      undo.Set("mode", base::DictValue()
+                           .Set("width", current.size().width())
+                           .Set("height", current.size().height())
+                           .Set("refreshRate", current.refresh_rate()));
+      what.push_back(u"resolution");
+    }
+  }
+  // kPolicy: no notification to confirm the mode (shell mode never shows
+  // Ash's); |confirm| is this class's own.
+  ash::DisplayConfigResult result =
+      ash::Shell::Get()->cros_display_config()->SetDisplayProperties(
+          *id, properties, ash::DisplayConfigSource::kPolicy);
+  // DisplayManager::SetDisplayMode() says no when the mode it was given
+  // matches the display's native bounds, though it took it: an X11 host
+  // window, whose size never follows its mode, going back to that size.
+  if (result == ash::DisplayConfigResult::kSetDisplayModeError &&
+      properties.display_mode) {
+    display::ManagedDisplayMode active;
+    if (manager->GetActiveModeForDisplayId(*id, &active) &&
+        active.IsEquivalent(*properties.display_mode)) {
+      result = ash::DisplayConfigResult::kSuccess;
+    }
+  }
+  if (result != ash::DisplayConfigResult::kSuccess) {
+    return ResultText(result);
+  }
+  LOG(WARNING) << "EXO-DISPLAYS configured display " << *id;
+  if (confirm && !what.empty()) {
+    std::u16string name = base::UTF8ToUTF16(manager->GetDisplayNameForId(*id));
+    SetPending(base::JoinString(what, u", ") + u" of " + name, std::move(undo));
+  }
+  return std::string();
+}
+
+std::string PlutoniumDisplayConfig::Arrange(const base::ListValue& layout) {
+  display::DisplayManager* manager = Manager();
+  if (manager->IsInMirrorMode()) {
+    return "Turn mirroring off first.";
+  }
+  std::map<int64_t, gfx::Rect> rects;
+  for (const display::Display& display :
+       display::Screen::Get()->GetAllDisplays()) {
+    rects[display.id()] = display.bounds();
+  }
+  if (rects.size() < 2) {
+    return "There's only one display.";
+  }
+  for (const base::Value& item : layout) {
+    const base::DictValue* entry = item.GetIfDict();
+    std::optional<int64_t> id =
+        entry ? IdOf(entry->Find("display")) : std::nullopt;
+    std::optional<int> x = entry ? entry->FindInt("x") : std::nullopt;
+    std::optional<int> y = entry ? entry->FindInt("y") : std::nullopt;
+    if (!id || !x || !y) {
+      return "layout is [{display, x, y}, …].";
+    }
+    if (!rects.contains(*id)) {
+      return "No display " + IdString(*id) + " on the desktop.";
+    }
+    rects[*id].set_origin(gfx::Point(*x, *y));
+  }
+  // Each display is placed against the nearest one already placed, starting
+  // from the primary: a row of three stays a row.
+  const int64_t primary = display::Screen::Get()->GetPrimaryDisplay().id();
+  display::DisplayLayoutBuilder builder(primary);
+  std::set<int64_t> placed = {primary};
+  while (placed.size() < rects.size()) {
+    int64_t best = display::kInvalidDisplayId;
+    int64_t parent = display::kInvalidDisplayId;
+    int best_gap = INT_MAX;
+    for (const auto& [id, rect] : rects) {
+      if (placed.contains(id)) {
+        continue;
+      }
+      for (int64_t other : placed) {
+        const int gap = Gap(rects[other], rect);
+        if (gap < best_gap) {
+          best_gap = gap;
+          best = id;
+          parent = other;
+        }
+      }
+    }
+    display::DisplayPlacement placement =
+        display::DisplayLayout::CreatePlacementForRectangles(rects[parent],
+                                                             rects[best]);
+    // A drag's few pixels off an edge line up: the start edges, or the end
+    // edges (a display moved by hand is rarely exact).
+    const bool beside = placement.position == display::DisplayPlacement::LEFT ||
+                        placement.position == display::DisplayPlacement::RIGHT;
+    const int end_aligned = beside
+                                ? rects[parent].height() - rects[best].height()
+                                : rects[parent].width() - rects[best].width();
+    if (std::abs(placement.offset) <= kSnap) {
+      placement.offset = 0;
+    } else if (std::abs(placement.offset - end_aligned) <= kSnap) {
+      placement.offset = end_aligned;
+    }
+    builder.AddDisplayPlacement(best, parent, placement.position,
+                                placement.offset);
+    // The rest are placed against where this one ends up.
+    gfx::Rect placed_rect = rects[best];
+    switch (placement.position) {
+      case display::DisplayPlacement::LEFT:
+        placed_rect.set_origin(
+            gfx::Point(rects[parent].x() - placed_rect.width(),
+                       rects[parent].y() + placement.offset));
+        break;
+      case display::DisplayPlacement::RIGHT:
+        placed_rect.set_origin(gfx::Point(
+            rects[parent].right(), rects[parent].y() + placement.offset));
+        break;
+      case display::DisplayPlacement::TOP:
+        placed_rect.set_origin(
+            gfx::Point(rects[parent].x() + placement.offset,
+                       rects[parent].y() - placed_rect.height()));
+        break;
+      case display::DisplayPlacement::BOTTOM:
+        placed_rect.set_origin(gfx::Point(rects[parent].x() + placement.offset,
+                                          rects[parent].bottom()));
+        break;
+    }
+    rects[best] = placed_rect;
+    placed.insert(best);
+  }
+  std::unique_ptr<display::DisplayLayout> built = builder.Build();
+  if (!display::DisplayLayout::Validate(manager->GetConnectedDisplayIdList(),
+                                        *built)) {
+    return "Those places don't make a layout.";
+  }
+  LOG(WARNING) << "EXO-DISPLAYS layout " << built->ToString();
+  ash::Shell::Get()->display_configuration_controller()->SetDisplayLayout(
+      std::move(built));
+  return std::string();
+}
+
+std::string PlutoniumDisplayConfig::SetMirror(bool on, bool confirm) {
+  display::DisplayManager* manager = Manager();
+  if (manager->num_connected_displays() < 2) {
+    return "Mirroring needs two displays.";
+  }
+  if (on == manager->IsInMirrorMode()) {
+    return std::string();
+  }
+  if (on && internal_off_) {
+    return "Turn the built-in display on first.";
+  }
+  ash::DisplayLayoutInfo info;
+  info.layout_mode =
+      on ? ash::DisplayLayoutMode::kMirrored : ash::DisplayLayoutMode::kNormal;
+  const ash::DisplayConfigResult result =
+      ash::Shell::Get()->cros_display_config()->SetDisplayLayoutInfo(info);
+  if (result != ash::DisplayConfigResult::kSuccess) {
+    return ResultText(result);
+  }
+  LOG(WARNING) << "EXO-DISPLAYS mirroring " << (on ? "on" : "off");
+  if (confirm) {
+    SetPending(on ? u"Mirroring" : u"Extending",
+               base::DictValue().Set("mirror", !on));
+  }
+  return std::string();
+}
+
+std::string PlutoniumDisplayConfig::SetInternalEnabled(int64_t id,
+                                                       bool enabled,
+                                                       bool confirm) {
+  if (enabled) {
+    if (!internal_off_ || id != internal_id_) {
+      return FindDisplay(id) ? std::string()
+                             : "No display " + IdString(id) + ".";
+    }
+    internal_off_ = false;
+    LOG(WARNING) << "EXO-DISPLAYS built-in display on";
+    ui::UserActivityDetector::Get()->OnDisplayPowerChanging();
+    ash::Shell::Get()->display_configurator()->SetDisplayPower(
+        chromeos::DISPLAY_POWER_ALL_ON,
+        display::DisplayConfigurator::kSetDisplayPowerNoFlags,
+        base::DoNothing());
+    return std::string();
+  }
+  std::optional<display::Display> display = FindDisplay(id);
+  if (!display) {
+    return "No display " + IdString(id) + ".";
+  }
+  if (!display->IsInternal()) {
+    return "Only the built-in display can be turned off, while a monitor is "
+           "on. Unplug a monitor to stop using it.";
+  }
+  if (!IsDrm()) {
+    return "In an X11 session the displays are the host's windows: they "
+           "can't be turned off here.";
+  }
+  if (display::Screen::Get()->GetNumDisplays() < 2) {
+    return "The built-in display can be turned off only while a monitor is "
+           "on.";
+  }
+  if (Manager()->IsInMirrorMode()) {
+    return "Turn mirroring off first.";
+  }
+  internal_entry_ = Entry(id, nullptr, false, gfx::Rect());
+  internal_entry_.Set("internal", true);
+  internal_off_ = true;
+  internal_id_ = id;
+  LOG(WARNING) << "EXO-DISPLAYS built-in display off";
+  ui::UserActivityDetector::Get()->OnDisplayPowerChanging();
+  ash::Shell::Get()->display_configurator()->SetDisplayPower(
+      chromeos::DISPLAY_POWER_INTERNAL_OFF_EXTERNAL_ON,
+      display::DisplayConfigurator::kSetDisplayPowerNoFlags, base::DoNothing());
+  if (confirm) {
+    SetPending(
+        u"The built-in display off",
+        base::DictValue().Set("display", IdString(id)).Set("enabled", true));
+  }
+  return std::string();
+}
+
+std::u16string PlutoniumDisplayConfig::PendingWhat() const {
+  return pending_ ? pending_->what : std::u16string();
+}
+
+int PlutoniumDisplayConfig::PendingSecondsLeft() const {
+  if (!pending_) {
+    return 0;
+  }
+  return std::max(
+      0, static_cast<int>(std::ceil(
+             (pending_->deadline - base::TimeTicks::Now()).InSecondsF())));
+}
+
+chromeos::DisplayPowerState PlutoniumDisplayConfig::PowerStateForOn() const {
+  return internal_off_ ? chromeos::DISPLAY_POWER_INTERNAL_OFF_EXTERNAL_ON
+                       : chromeos::DISPLAY_POWER_ALL_ON;
+}
+
+void PlutoniumDisplayConfig::OnDisplaysRemoved(
+    const display::Displays& removed_displays) {
+  if (!internal_off_) {
+    return;
+  }
+  // The panel is off and the last monitor went: the panel comes back (not
+  // from inside the display change).
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce([]() {
+        PlutoniumDisplayConfig* config = PlutoniumDisplayConfig::Get();
+        if (!config || !config->internal_off_ || !ash::Shell::HasInstance()) {
+          return;
+        }
+        for (const display::Display& display :
+             display::Screen::Get()->GetAllDisplays()) {
+          if (!display.IsInternal()) {
+            return;
+          }
+        }
+        config->SetInternalEnabled(config->internal_id_, true, false);
+      }));
+}
+
+void PlutoniumDisplayConfig::SetPending(std::u16string what,
+                                        base::DictValue undo) {
+  // A change that came while another waited keeps the other.
+  pending_.emplace();
+  pending_->what = std::move(what);
+  pending_->undo = std::move(undo);
+  pending_->deadline = base::TimeTicks::Now() + kConfirmTime;
+  revert_timer_.Start(FROM_HERE, kConfirmTime,
+                      base::BindOnce(&PlutoniumDisplayConfig::RevertPending,
+                                     base::Unretained(this)));
+}
+
+void PlutoniumDisplayConfig::RevertPending() {
+  if (!pending_) {
+    return;
+  }
+  base::DictValue undo = std::move(pending_->undo);
+  LOG(WARNING) << "EXO-DISPLAYS putting back: " << pending_->what;
+  pending_.reset();
+  revert_timer_.Stop();
+  const std::string error = Configure(undo);
+  if (!error.empty()) {
+    LOG(ERROR) << "EXO-DISPLAYS couldn't put it back: " << error;
+  }
+}
