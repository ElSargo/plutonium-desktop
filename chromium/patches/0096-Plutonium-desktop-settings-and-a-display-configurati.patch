+Response PlutoniumHandler::OpenSwitcher(const std::string& page) {
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  if (!shells) {
+    return Response::ServerError("There's a switcher only in shell mode.");
+  }
+  if (!shells->OpenSwitcher(page)) {
+    return Response::InvalidParams("The switcher has no page \"" + page +
+                                   "\".");
+  }
+  return Response::Success();
+}
