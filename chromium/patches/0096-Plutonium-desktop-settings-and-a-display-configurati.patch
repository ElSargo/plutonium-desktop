+  }
+  *json = shells->GetDisplayConfigJson();
+  return Response::Success();
+}
+
+Response PlutoniumHandler::ConfigureDisplays(const std::string& change_json) {
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  if (!shells) {
+    return Response::ServerError(
+        "There are displays to configure only in "
+        "shell mode.");
+  }
+  const std::string error = shells->ConfigureDisplays(change_json);
+  return error.empty() ? Response::Success() : Response::InvalidParams(error);
