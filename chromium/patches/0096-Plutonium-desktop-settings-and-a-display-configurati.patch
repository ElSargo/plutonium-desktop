+  std::u16string NetworkSummary(SkColor* dot) const {
+    *dot = kDim;
+    const base::DictValue* net = ServiceState("network");
+    if (!net || !Has("network")) {
+      return services_loaded_ ? u"No NetworkManager" : u"…";
+    }
+    const base::DictValue* wifi = net->FindDict("wifi");
+    if (const base::DictValue* primary = net->FindDict("primary")) {
+      *dot = kOk;
+      std::u16string text = U(Str(primary, "name"));
+      const std::string connectivity = Str(net, "connectivity");
+      if (connectivity == "portal") {
+        *dot = kWarn;
+        text += u"  ·  sign-in needed";
+      } else if (connectivity == "limited" || connectivity == "none") {
+        *dot = kWarn;
+        text += u"  ·  no internet";
+      }
+      return text;
+    }
+    if (Str(net, "state") == "connecting") {
+      *dot = kWarn;
+      return u"Connecting…";
+    }
+    if (wifi && Bool(wifi, "available") && !Bool(wifi, "enabled")) {
+      return u"Wi-Fi off";
+    }
+    return u"Not connected";
+  }
+
+  std::u16string BluetoothSummary(SkColor* dot) const {
+    *dot = kDim;
+    const base::DictValue* bluetooth = ServiceState("bluetooth");
+    if (!bluetooth || !Has("bluetooth")) {
+      return services_loaded_ ? u"No Bluetooth" : u"…";
+    }
+    const base::DictValue* adapter = bluetooth->FindDict("adapter");
+    if (!adapter) {
+      return u"No adapter";
+    }
+    if (!Bool(adapter, "powered")) {
+      return u"Off";
+    }
+    *dot = kOk;
+    int connected = 0;
+    if (const base::ListValue* devices = bluetooth->FindList("devices")) {
+      for (const base::Value& device : *devices) {
+        connected += Bool(device.GetIfDict(), "connected") ? 1 : 0;
