+  // A choice of idle times, in seconds (0: never).
+  void AddIdleChoice(views::View* parent,
+                     const std::u16string& label,
+                     const std::string& key,
+                     int current) {
+    auto* row = AddButtons(parent);
+    views::Label* name = AddLabel(row, label, kDim);
+    name->SetPreferredSize(
+        gfx::Size(120, name->GetPreferredSize(views::SizeBounds()).height()));
+    const std::pair<int, std::u16string> choices[] = {
+        {60, u"1 min"},   {120, u"2 min"},   {300, u"5 min"},
+        {600, u"10 min"}, {1800, u"30 min"}, {0, u"Never"},
+    };
+    for (const auto& [seconds, text] : choices) {
+      AddButton(row, text,
+                Bind(&PlutoniumOverlayView::CallService, std::string("session"),
+                     std::string("set-idle"),
+                     base::DictValue().Set(key, seconds), std::u16string()),
+                seconds == current ? ActionButton::Style::kPrimary
+                                   : ActionButton::Style::kNormal);
+    }
+  }
