+  // Wi-Fi and the other connections.
+  void BuildNetworkPage() {
+    SkColor dot;
+    const std::u16string summary = NetworkSummary(&dot);
+    AddTitle(u"Wi-Fi and network", summary, dot);
+    const base::DictValue* net = ServiceState("network");
+    if (!net || !Has("network")) {
+      AddNotAvailable(
+          u"NetworkManager isn't running, so there's nothing to "
+          u"show or change.");
+      return;
+    }
+    const base::DictValue* wifi = net->FindDict("wifi");
+    auto* actions = AddButtons(page_);
+    if (Bool(wifi, "available")) {
+      const bool on = Bool(wifi, "enabled");
+      AddButton(
+          actions, on ? u"Turn Wi-Fi off" : u"Turn Wi-Fi on",
+          Bind(&PlutoniumOverlayView::CallService, std::string("network"),
+               std::string("set-wifi"), base::DictValue().Set("enabled", !on),
+               std::u16string(on ? u"Turning Wi-Fi off…"
+                                 : u"Turning Wi-Fi on…")),
+          on ? ActionButton::Style::kNormal : ActionButton::Style::kPrimary,
+          Bool(wifi, "hardwareEnabled", true));
+      AddButton(actions,
+                Bool(wifi, "scanning") ? u"Looking for networks…"
+                                       : u"Look for networks",
+                Bind(&PlutoniumOverlayView::CallService, std::string("network"),
+                     std::string("scan"), base::DictValue(), std::u16string()),
+                ActionButton::Style::kNormal, on && !Bool(wifi, "scanning"));
+      if (!Bool(wifi, "hardwareEnabled", true)) {
+        AddParagraph(page_, u"Wi-Fi is off by the computer's own switch.",
+                     kWarn);
+      }
+    } else {
+      AddParagraph(page_, u"This computer has no Wi-Fi.", kDim);
+    }
+
+    const base::ListValue* points = net->FindList("accessPoints");
+    if (Bool(wifi, "enabled") && points) {
+      auto* list = AddSection(u"Wi-Fi networks");
+      if (points->empty()) {
+        AddParagraph(list, u"None found yet.", kDim);
+      }
+      int shown = 0;
+      for (const base::Value& item : *points) {
+        const base::DictValue* point = item.GetIfDict();
+        if (!point || ++shown > 24) {
+          continue;
+        }
+        AddNetworkRow(list, *point);
+      }
+    }
+
+    // Wired, VPN and the other saved connections.
+    const base::ListValue* connections = net->FindList("connections");
+    bool header = false;
+    views::View* others = nullptr;
+    static const base::NoDestructor<base::ListValue> kNone;
+    for (const base::Value& item : connections ? *connections : *kNone) {
+      const base::DictValue* connection = item.GetIfDict();
+      if (!connection || Str(connection, "type") == "wifi") {
+        continue;
+      }
+      if (!header) {
+        others = AddSection(u"Other connections");
+        header = true;
+      }
+      auto* row = AddButtons(others);
+      const bool active = Bool(connection, "active");
+      views::Label* name = AddLabel(
+          row,
+          U(Str(connection, "name")) + u"  —  " + U(Str(connection, "type")) +
+              (active ? u", " + U(Str(connection, "state")) : u""),
+          active ? kTitle : kDim, 1);
+      name->SetPreferredSize(
+          gfx::Size(380, name->GetPreferredSize(views::SizeBounds()).height()));
+      const std::string id = Str(connection, "id");
+      AddButton(
+          row, active ? u"Disconnect" : u"Connect",
+          Bind(&PlutoniumOverlayView::CallService, std::string("network"),
+               std::string(active ? "disconnect" : "connect"),
+               base::DictValue().Set("id", id),
+               std::u16string(active ? u"Disconnecting…" : u"Connecting…")),
+          active ? ActionButton::Style::kNormal
+                 : ActionButton::Style::kPrimary);
+    }
+    AddParagraph(page_,
+                 u"A network that asks for a password later (a changed one, "
+                 u"or a company network) asks in the visible shell.",
+                 kDim);
+  }
+
+  void AddNetworkRow(views::View* parent, const base::DictValue& point) {
+    const std::string ssid = Str(&point, "ssid");
+    const std::string id = Str(&point, "id");
+    const bool active = Bool(&point, "active");
+    const bool known = Bool(&point, "known");
+    const bool secured = Bool(&point, "secured");
+    const std::string security = Str(&point, "security");
+    auto* row = AddButtons(parent);
+    std::u16string detail = Percent(Num(&point, "strength") / 100.0);
+    if (Num(&point, "strength") > 1) {
+      detail =
+          base::NumberToString16(static_cast<int>(Num(&point, "strength"))) +
+          u"%";
+    }
+    detail += secured ? u"  ·  " + U(security) : u"  ·  open";
+    if (active) {
+      detail = u"Connected  ·  " + detail;
+    } else if (known) {
+      detail = u"Saved  ·  " + detail;
+    }
+    auto* text = AddBox(row, views::BoxLayout::Orientation::kVertical, 1);
+    AddLabel(text, U(ssid), active ? kAccent : kTitle, 1, active);
+    AddLabel(text, detail, kDim, -1);
+    text->SetPreferredSize(
+        gfx::Size(340, text->GetPreferredSize(views::SizeBounds()).height()));
+    if (active) {
+      AddButton(row, u"Disconnect",
+                Bind(&PlutoniumOverlayView::CallService, std::string("network"),
+                     std::string("disconnect"), base::DictValue().Set("id", id),
+                     std::u16string(u"Disconnecting…")));
+    } else if (known || !secured) {
+      AddButton(row, u"Connect",
+                Bind(&PlutoniumOverlayView::ConnectNetwork, ssid),
+                ActionButton::Style::kPrimary);
+    } else {
+      AddButton(row, password_ssid_ == ssid ? u"Cancel" : u"Connect…",
+                Bind(&PlutoniumOverlayView::AskPassword, ssid));
+    }
+    if (known) {
+      const std::string action = "forget/" + ssid;
+      AddButton(row, ConfirmLabel(action, u"Forget"),
+                Bind(&PlutoniumOverlayView::ForgetNetwork, ssid),
+                ActionButton::Style::kDanger);
+    }
+    if (password_ssid_ == ssid && !known && secured) {
+      auto* ask = AddBox(parent, views::BoxLayout::Orientation::kHorizontal, 8,
+                         gfx::Insets::TLBR(0, 0, 6, 0));
+      password_field_ = ask->AddChildView(std::make_unique<views::Textfield>());
+      password_field_->SetTextInputType(ui::TEXT_INPUT_TYPE_PASSWORD);
+      password_field_->SetPlaceholderText(u"Password for " + U(ssid));
+      password_field_->SetController(this);
+      password_field_->SetBackgroundColor(kField);
+      password_field_->SetPreferredSize(gfx::Size(300, 30));
+      AddButton(ask, u"Connect", Bind(&PlutoniumOverlayView::SubmitPassword),
+                ActionButton::Style::kPrimary);
+    }
+  }
+
+  void ConnectNetwork(const std::string& ssid) {
+    password_ssid_.clear();
+    CallService("network", "connect", base::DictValue().Set("ssid", ssid),
+                u"Connecting to " + U(ssid) + u"…");
+  }
+
+  void AskPassword(const std::string& ssid) {
+    password_ssid_ = password_ssid_ == ssid ? std::string() : ssid;
+    UpdatePage(/*force=*/true);
+    if (password_field_) {
+      password_field_->RequestFocus();
+    }
+  }
+
+  void SubmitPassword() {
+    if (!password_field_ || password_ssid_.empty()) {
+      return;
+    }
+    const std::string ssid = password_ssid_;
+    const std::string password = base::UTF16ToUTF8(password_field_->GetText());
+    password_ssid_.clear();
+    CallService("network", "connect",
+                base::DictValue().Set("ssid", ssid).Set("password", password),
+                u"Connecting to " + U(ssid) + u"…");
+    UpdatePage(/*force=*/true);
+    FocusSearch();
+  }
