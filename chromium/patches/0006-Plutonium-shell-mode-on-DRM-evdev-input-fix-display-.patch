+void ShellSurfaceBase::UpdateEmbedCoversDisplay(const gfx::Size& size) {
+  if (!widget_ || !root_surface()) {
+    return;
+  }
+  const gfx::Size display_size =
+      display::Screen::Get()
+          ->GetDisplayNearestWindow(widget_->GetNativeWindow())
+          .size();
+  const bool covers = embed_parked_ && !display_size.IsEmpty() &&
+                      size.width() >= display_size.width() &&
+                      size.height() >= display_size.height();
