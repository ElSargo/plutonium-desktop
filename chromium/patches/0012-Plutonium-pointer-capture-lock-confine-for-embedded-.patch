+void Pointer::OnSurfaceFocused(Surface* gained_focus,
+                               Surface* lost_focus,
+                               bool has_focused_client) {
+  // The seat is notifying its observers, and changing the capture notifies
+  // them again: look once it's done.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&Pointer::UpdateEmbeddedConstraint,
+                                embedded_weak_ptr_factory_.GetWeakPtr()));
+}
+
+void Pointer::UpdateEmbeddedConstraint() {
+  if (seat_->was_shutdown()) {
+    return;
+  }
+  // EXO-CAPTURE: keyboard focus leaving an embedded window ends its
+  // constraint (as aura focus does for other windows), and coming back
+  // resumes it.
+  Surface* focused = seat_->GetFocusedSurface();
+  if (aura::Window* constrained =
+          capture_window_ ? capture_window_.get() : confine_window_.get()) {
+    ShellSurfaceBase* embedded = EmbeddedShellSurface(constrained);
+    if (embedded &&
+        (!focused || ShellSurfaceFor(focused->window()) != embedded)) {
+      if (pointer_constraint_delegate_) {
+        VLOG(1) << "Pointer constraint broken by embedded focus change";
+        UnconstrainPointer();
+      } else {
+        DisablePointerCapture();
+        DisablePointerConfinement();
+      }
+    }
+  }
+  if (focused && EmbeddedShellSurface(focused->window())) {
+    MaybeReactivatePointerConstraint(focused);
+  }
+}
