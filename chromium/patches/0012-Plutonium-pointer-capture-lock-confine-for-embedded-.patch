+
+bool Pointer::ConfineEvent(ui::MouseEvent* event) {
+  // Events the browser routes into an embedded window are already inside;
+  // synthesized moves (e.g. from a warp below) are never warped again. A
+  // lock (capture) takes all events anyway.
+  if (!confine_window_ || capture_window_ || IsEmbeddedEvent(*event) ||
+      event->IsSynthesized()) {
+    return false;
+  }
+  aura::Window* root = confine_window_->GetRootWindow();
+  if (!root) {
+    return false;
+  }
+  Surface* surface = Surface::AsSurface(confine_window_);
+  const gfx::RectF bounds(confine_window_->GetBoundsInRootWindow());
+  if (!surface || bounds.width() < 4.f || bounds.height() < 4.f) {
+    return false;
+  }
+  // Inside means where the surface takes input (its input region leaves out
+  // client-side shadows and borders, where the page would get the pointer).
+  const gfx::Vector2dF origin = bounds.OffsetFromOrigin();
+  // The outermost pixels don't count: the page may round them to itself.
+  gfx::RectF inner = bounds;
+  inner.Inset(2.f);
+  auto takes_input = [&](const gfx::PointF& point_in_root) {
+    return inner.Contains(point_in_root) &&
+           surface->HitTest(gfx::ToFlooredPoint(point_in_root - origin));
+  };
+  const gfx::PointF location = event->root_location_f();
+  if (takes_input(location)) {
+    return false;
+  }
+  // Back a few whole pixels in from the edge: the synthetic move the warp
+  // makes is rounded through device pixels, and must land well inside the
+  // element for the page to route it here, or it would leave (and be
+  // warped again). Then on towards the middle until the surface takes input.
+  constexpr float kMargin = 4.f;
+  gfx::PointF inside(
+      std::clamp(std::floor(location.x()), std::ceil(bounds.x()) + kMargin,
+                 std::floor(bounds.right()) - kMargin - 1.f),
+      std::clamp(std::floor(location.y()), std::ceil(bounds.y()) + kMargin,
+                 std::floor(bounds.bottom()) - kMargin - 1.f));
+  const gfx::PointF center = bounds.CenterPoint();
+  for (int step = 0; step < 32 && !takes_input(inside); ++step) {
+    gfx::Vector2dF to_center = center - inside;
+    if (to_center.Length() < 4.f) {
+      break;
+    }
+    to_center.Scale(4.f / to_center.Length());
+    inside = gfx::PointF(std::round(inside.x() + to_center.x()),
+                         std::round(inside.y() + to_center.y()));
+  }
+  root->MoveCursorTo(gfx::ToFlooredPoint(inside));
+  event->SetHandled();
+  event->StopPropagation();
+  return true;
+}
