+// EXO-EXTENSIONS: Plutonium's shell pages are restricted URLs to every
+// extension, as chrome:// pages are: no script access, no webRequest or
+// declarativeNetRequest redirects on them, no debugger, no captures. A shell
+// page has the window broker, which reaches every window and tab. The renderer
+// also refuses to inject into a shell document (ExtensionInjectionHost); this
+// covers the browser's own checks. The shells' origins are read on the UI
+// thread; a check from another thread uses the last list the UI thread saw.
+class PlutoniumShellPolicyDelegate : public PermissionsData::PolicyDelegate {
+ public:
+  bool IsRestrictedUrl(const GURL& document_url, std::string* error) override {
+    if (!plutonium_shell::IsShellMode()) {
+      return false;
+    }
+    url::Origin origin = url::Origin::Create(document_url);
+    bool restricted = false;
+    {
+      base::AutoLock lock(lock_);
+      if (content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+        origins_ = plutonium_shell::GetShellOrigins();
+      }
+      restricted = std::ranges::contains(origins_, origin);
+    }
+    if (restricted && error) {
+      *error = "Cannot access a Plutonium shell page.";
+    }
+    return restricted;
+  }
+
+ private:
+  base::Lock lock_;
+  std::vector<url::Origin> origins_ GUARDED_BY(lock_);
+};
+
 }  // namespace
 
