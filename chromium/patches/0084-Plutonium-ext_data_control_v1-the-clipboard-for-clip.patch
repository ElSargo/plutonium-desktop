diff --git a/components/exo/seat.cc b/components/exo/seat.cc
index 0b54951837..acf030bf54 100644
--- a/components/exo/seat.cc
+++ b/components/exo/seat.cc
@@ -350,16 +350,25 @@ void Seat::SetSelection(DataSource* source) {
       source->Cancelled();
     return;
   }
+  SetSelectionFrom(source,
+                   data_exchange_delegate_->GetDataTransferEndpointType(
+                       focused_surface->window()));
+}
+
+void Seat::SetSelectionFromDataControl(DataSource* source) {
+  // As an app in a VM would be (ChromeDataExchangeDelegate's endpoint for
+  // Wayland windows that aren't ARC's, Borealis' or Crostini's).
+  SetSelectionFrom(source, ui::EndpointType::kUnknownVm);
+}
 
+void Seat::SetSelectionFrom(DataSource* source,
+                            ui::EndpointType endpoint_type) {
   if (selection_source_) {
     if (selection_source_->get() == source)
       return;
     selection_source_->get()->Cancelled();
   }
   selection_source_ = std::make_unique<ScopedDataSource>(source, this);
-  ui::EndpointType endpoint_type =
-      data_exchange_delegate_->GetDataTransferEndpointType(
-          focused_surface->window());
   scoped_refptr<RefCountedScopedClipboardWriter> writer =
       base::MakeRefCounted<RefCountedScopedClipboardWriter>(endpoint_type);
 
