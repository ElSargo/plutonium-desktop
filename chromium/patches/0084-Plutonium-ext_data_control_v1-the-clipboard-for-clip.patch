+////////////////////////////////////////////////////////////////////////////////
+// ext_data_control_source_v1 interface:
+
+class DataControlSourceDelegate : public DataSourceDelegate {
+ public:
+  DataControlSourceDelegate(wl_client* client, wl_resource* resource)
+      : client_(client), resource_(resource) {}
+  DataControlSourceDelegate(const DataControlSourceDelegate&) = delete;
+  DataControlSourceDelegate& operator=(const DataControlSourceDelegate&) =
+      delete;
+
+  // DataSourceDelegate:
+  void OnDataSourceDestroying(DataSource* source) override { delete this; }
+  base::WeakPtr<DataSourceDelegate> GetWeakPtr() override {
+    return weak_ptr_factory_.GetWeakPtr();
+  }
+  void OnTarget(const std::optional<std::string>& mime_type) override {}
+  void OnSend(const std::string& mime_type, base::ScopedFD fd) override {
+    ext_data_control_source_v1_send_send(resource_, mime_type.c_str(),
+                                         fd.get());
+    wl_client_flush(client_);
+  }
+  void OnCancelled() override {
+    ext_data_control_source_v1_send_cancelled(resource_);
+    wl_client_flush(client_);
+  }
+  void OnDndDropPerformed() override {}
+  void OnDndFinished() override {}
+  void OnAction(DndAction dnd_action) override {}
+  // Not a surface's: wl_data_device can't take it.
+  bool CanAcceptDataEventsForSurface(Surface* surface) const override {
+    return false;
+  }
+  SecurityDelegate* GetSecurityDelegate() const override {
+    return ::exo::wayland::GetSecurityDelegate(client_);
+  }
+
+ private:
+  const raw_ptr<wl_client> client_;
+  const raw_ptr<wl_resource> resource_;
+  base::WeakPtrFactory<DataControlSourceDelegate> weak_ptr_factory_{this};
+};
+
+struct DataControlSource {
+  DataControlSource(wl_client* client, wl_resource* resource)
+      : source(new DataControlSourceDelegate(client, resource)) {}
+
+  DataSource source;
+  // Given to set_selection or set_primary_selection.
+  bool used = false;
+};
+
+void data_control_source_offer(wl_client* client,
+                               wl_resource* resource,
+                               const char* mime_type) {
+  auto* data = GetUserDataAs<DataControlSource>(resource);
+  if (data->used) {
+    wl_resource_post_error(resource,
+                           EXT_DATA_CONTROL_SOURCE_V1_ERROR_INVALID_OFFER,
+                           "offer sent after set_selection");
+    return;
+  }
+  data->source.Offer(mime_type);
+}
+
+void data_control_source_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct ext_data_control_source_v1_interface
+    data_control_source_implementation = {data_control_source_offer,
+                                          data_control_source_destroy};
+
+////////////////////////////////////////////////////////////////////////////////
+// ext_data_control_offer_v1 interface:
+
+class DataControlOfferDelegate : public DataOfferDelegate {
+ public:
+  DataControlOfferDelegate(wl_client* client, wl_resource* resource)
+      : client_(client), resource_(resource) {}
+  DataControlOfferDelegate(const DataControlOfferDelegate&) = delete;
+  DataControlOfferDelegate& operator=(const DataControlOfferDelegate&) =
+      delete;
+
+  // DataOfferDelegate:
+  void OnDataOfferDestroying(DataOffer* offer) override { delete this; }
+  base::WeakPtr<DataOfferDelegate> GetWeakPtr() override {
+    return weak_ptr_factory_.GetWeakPtr();
+  }
+  void OnOffer(const std::string& mime_type) override {
+    ext_data_control_offer_v1_send_offer(resource_, mime_type.c_str());
+  }
+  void OnSourceActions(
+      const base::flat_set<DndAction>& source_actions) override {}
+  void OnAction(DndAction action) override {}
+  SecurityDelegate* GetSecurityDelegate() const override {
+    return ::exo::wayland::GetSecurityDelegate(client_);
+  }
+
+ private:
+  const raw_ptr<wl_client> client_;
+  const raw_ptr<wl_resource> resource_;
+  base::WeakPtrFactory<DataControlOfferDelegate> weak_ptr_factory_{this};
+};
+
+void data_control_offer_receive(wl_client* client,
+                                wl_resource* resource,
+                                const char* mime_type,
+                                int fd) {
+  GetUserDataAs<DataOffer>(resource)->Receive(mime_type, base::ScopedFD(fd));
+}
+
+void data_control_offer_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct ext_data_control_offer_v1_interface
+    data_control_offer_implementation = {data_control_offer_receive,
+                                         data_control_offer_destroy};
+
+////////////////////////////////////////////////////////////////////////////////
+// ext_data_control_device_v1 interface:
+
+// Offers the clipboard when made and whenever it changes.
+class DataControlDevice : public ui::ClipboardObserver {
+ public:
+  DataControlDevice(wl_client* client, wl_resource* resource, Seat* seat)
+      : client_(client), resource_(resource), seat_(seat) {
+    ui::ClipboardMonitor::GetInstance()->AddObserver(this);
+    OnClipboardDataChanged();
+  }
+  DataControlDevice(const DataControlDevice&) = delete;
+  DataControlDevice& operator=(const DataControlDevice&) = delete;
+  ~DataControlDevice() override {
+    ui::ClipboardMonitor::GetInstance()->RemoveObserver(this);
+  }
+
+  Seat* seat() { return seat_; }
+
+  // ui::ClipboardObserver:
+  void OnClipboardDataChanged() override {
+    wl_resource* offer_resource =
+        wl_resource_create(client_, &ext_data_control_offer_v1_interface,
+                           wl_resource_get_version(resource_), 0);
+    if (!offer_resource) {
+      wl_client_post_no_memory(client_);
+      return;
+    }
+    auto data_offer = std::make_unique<DataOffer>(
+        new DataControlOfferDelegate(client_, offer_resource));
+    DataOffer* offer = data_offer.get();
+    SetImplementation(offer_resource, &data_control_offer_implementation,
+                      std::move(data_offer));
+    ext_data_control_device_v1_send_data_offer(resource_, offer_resource);
+    // As DataDevice offers it to a focused app (whose offer events also come
+    // before its selection event).
+    offer->SetClipboardData(seat_->data_exchange_delegate(),
+                            *ui::Clipboard::GetForCurrentThread(),
+                            ui::EndpointType::kUnknownVm);
+    ext_data_control_device_v1_send_selection(resource_, offer_resource);
+    wl_client_flush(client_);
+  }
+
+ private:
+  const raw_ptr<wl_client> client_;
+  const raw_ptr<wl_resource> resource_;
+  const raw_ptr<Seat> seat_;
+};
+
+// The source, if it may be given now; else posts used_source.
+DataControlSource* TakeSource(wl_resource* resource,
+                              wl_resource* source_resource) {
+  auto* data = GetUserDataAs<DataControlSource>(source_resource);
+  if (data->used) {
+    wl_resource_post_error(resource,
+                           EXT_DATA_CONTROL_DEVICE_V1_ERROR_USED_SOURCE,
+                           "the source was used before");
+    return nullptr;
+  }
+  data->used = true;
+  return data;
+}
+
+void data_control_device_set_selection(wl_client* client,
+                                       wl_resource* resource,
+                                       wl_resource* source_resource) {
+  Seat* seat = GetUserDataAs<DataControlDevice>(resource)->seat();
+  if (!source_resource) {
+    ui::Clipboard::GetForCurrentThread()->Clear(
+        ui::ClipboardBuffer::kCopyPaste);
+    return;
+  }
+  if (DataControlSource* data = TakeSource(resource, source_resource)) {
+    seat->SetSelectionFromDataControl(&data->source);
+  }
+}
+
+void data_control_device_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+void data_control_device_set_primary_selection(wl_client* client,
+                                               wl_resource* resource,
+                                               wl_resource* source_resource) {
+  // There's no primary selection: the source is let go, so that a client
+  // waiting to serve it (wl-copy --primary) doesn't wait for ever.
+  if (!source_resource) {
+    return;
+  }
+  if (DataControlSource* data = TakeSource(resource, source_resource)) {
+    data->source.Cancelled();
+  }
+}
+
+constexpr struct ext_data_control_device_v1_interface
+    data_control_device_implementation = {
+        data_control_device_set_selection, data_control_device_destroy,
+        data_control_device_set_primary_selection};
+
+////////////////////////////////////////////////////////////////////////////////
+// ext_data_control_manager_v1 interface:
+
+void data_control_manager_create_data_source(wl_client* client,
+                                             wl_resource* resource,
+                                             uint32_t id) {
+  wl_resource* source_resource =
+      wl_resource_create(client, &ext_data_control_source_v1_interface,
+                         wl_resource_get_version(resource), id);
+  if (!source_resource) {
+    wl_client_post_no_memory(client);
+    return;
+  }
+  SetImplementation(source_resource, &data_control_source_implementation,
+                    std::make_unique<DataControlSource>(client,
+                                                        source_resource));
+}
+
+void data_control_manager_get_data_device(wl_client* client,
+                                          wl_resource* resource,
+                                          uint32_t id,
+                                          wl_resource* seat_resource) {
+  wl_resource* device_resource =
+      wl_resource_create(client, &ext_data_control_device_v1_interface,
+                         wl_resource_get_version(resource), id);
+  if (!device_resource) {
+    wl_client_post_no_memory(client);
+    return;
+  }
+  // Exo has one seat.
+  Seat* seat = GetUserDataAs<Display>(resource)->seat();
+  SetImplementation(
+      device_resource, &data_control_device_implementation,
+      std::make_unique<DataControlDevice>(client, device_resource, seat));
+}
+
+void data_control_manager_destroy(wl_client* client, wl_resource* resource) {
+  wl_resource_destroy(resource);
+}
+
+constexpr struct ext_data_control_manager_v1_interface
+    data_control_manager_implementation = {
+        data_control_manager_create_data_source,
+        data_control_manager_get_data_device, data_control_manager_destroy};
+
+}  // namespace
+
+void bind_data_control_manager(wl_client* client,
+                               void* data,
+                               uint32_t version,
+                               uint32_t id) {
+  wl_resource* resource = wl_resource_create(
+      client, &ext_data_control_manager_v1_interface, 1, id);
+  if (!resource) {
+    wl_client_post_no_memory(client);
+    return;
+  }
+  wl_resource_set_implementation(resource, &data_control_manager_implementation,
+                                 data, nullptr);
+}
+
+}  // namespace wayland
+}  // namespace exo
