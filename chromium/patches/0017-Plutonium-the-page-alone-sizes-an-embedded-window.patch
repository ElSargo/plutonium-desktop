+void ShellSurfaceBase::ScheduleEmbedLayoutCheck() {
+  if (!embed_parked_ || embed_layout_check_pending_) {
+    return;
+  }
+  embed_layout_check_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ShellSurfaceBase::CheckEmbedLayout,
+                                embed_weak_factory_.GetWeakPtr()));
+}
+
+void ShellSurfaceBase::CheckEmbedLayout() {
+  embed_layout_check_pending_ = false;
+  if (!widget_ || !embed_parked_) {
+    return;
+  }
+  // Maximized, snapped, floated...: Ash places such windows itself, and the
+  // client would draw at a size the page never asked for.
+  auto* window_state = ash::WindowState::Get(widget_->GetNativeWindow());
+  if (window_state && !window_state->IsNormalStateType()) {
+    window_state->Restore();
+  }
+  if (embed_size_) {
+    SetEmbedSize(*embed_size_);
+  }
+}
