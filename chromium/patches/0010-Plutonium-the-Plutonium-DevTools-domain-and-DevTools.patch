+Response PlutoniumHandler::GetTabs(
+    std::unique_ptr<protocol::Array<Plutonium::Tab>>* tabs) {
+  *tabs = std::make_unique<protocol::Array<Plutonium::Tab>>();
+  for (const PlutoniumTabs::TabInfo& tab : PlutoniumTabs::Get()->GetTabs()) {
+    (*tabs)->push_back(ToProtocol(tab));
+  }
+  return Response::Success();
+}
+
+Response PlutoniumHandler::CreateTab(
+    const std::string& url,
+    std::unique_ptr<protocol::Array<std::string>> tags,
+    std::optional<bool> incognito,
+    std::unique_ptr<Plutonium::Tab>* tab) {
+  std::optional<PlutoniumTabs::TabInfo> created =
+      PlutoniumTabs::Get()->CreateAgentTab(
+          url, tags ? *tags : std::vector<std::string>(),
+          incognito.value_or(false));
+  if (!created) {
+    return Response::ServerError(
+        "Can't open that URL (or no shell page has started)");
+  }
+  *tab = ToProtocol(*created);
+  return Response::Success();
+}
+
+Response PlutoniumHandler::NavigateTab(int id, const std::string& url) {
+  if (!PlutoniumTabs::Get()->GetTab(id)) {
+    return NoTab();
+  }
+  return PlutoniumTabs::Get()->Navigate(id, url)
+             ? Response::Success()
+             : Response::InvalidParams("Can't open that URL");
+}
+
+void PlutoniumHandler::TabCommand(
+    int id,
+    const std::string& command,
+    std::optional<std::string> args_json,
+    std::unique_ptr<TabCommandCallback> callback) {
+  if (!PlutoniumTabs::Get()->GetTab(id)) {
+    callback->sendFailure(NoTab());
+    return;
+  }
+  PlutoniumTabs::Get()->RunNamedCommand(
+      id, command, args_json.value_or(std::string()),
+      base::BindOnce(
+          [](std::unique_ptr<TabCommandCallback> callback, bool ok,
+             const std::string& result) {
+            if (!ok) {
+              callback->sendFailure(Response::InvalidParams(result));
+              return;
+            }
+            callback->sendSuccess(result);
+          },
+          std::move(callback)));
+}
+
+Response PlutoniumHandler::AnswerTabRequest(int request_id,
+                                            const std::string& answer_json) {
+  return PlutoniumTabRequests::Get()->Answer(
+             request_id, PlutoniumTabRequests::From::kAgent, /*taker=*/0,
+             answer_json)
+             ? Response::Success()
+             : Response::InvalidParams(
+                   "No such open request, or it doesn't take that answer");
+}
+
+Response PlutoniumHandler::GetDownloads(
+    std::unique_ptr<protocol::Array<std::string>>* downloads_json) {
+  *downloads_json = std::make_unique<protocol::Array<std::string>>();
+  for (const base::DictValue& download :
+       PlutoniumDownloads::Get()->GetDownloads()) {
+    std::string json;
+    base::JSONWriter::Write(download, &json);
+    (*downloads_json)->push_back(std::move(json));
+  }
+  return Response::Success();
+}
+
+void PlutoniumHandler::DownloadCommand(
+    int id,
+    const std::string& command,
+    std::unique_ptr<DownloadCommandCallback> callback) {
+  PlutoniumDownloads::Get()->RunCommand(
+      id, command, /*from_agent=*/true,
+      base::BindOnce(
+          [](std::unique_ptr<DownloadCommandCallback> callback, bool ok,
+             const std::string& error) {
+            if (!ok) {
+              callback->sendFailure(Response::InvalidParams(error));
+              return;
+            }
+            callback->sendSuccess();
+          },
+          std::move(callback)));
+}
+
+Response PlutoniumHandler::AnswerTabDialog(
+    int id,
+    bool accept,
+    std::optional<std::string> prompt_text) {
+  std::optional<PlutoniumTabs::TabInfo> tab = PlutoniumTabs::Get()->GetTab(id);
+  if (!tab) {
+    return NoTab();
+  }
+  if (tab->dialog_type.empty()) {
+    return Response::InvalidParams("The tab has no dialog");
+  }
+  PlutoniumTabs::Get()->AnswerDialog(
+      id, accept, base::UTF8ToUTF16(prompt_text.value_or(std::string())));
+  return Response::Success();
+}
+
+Response PlutoniumHandler::GetWindows(
+    std::unique_ptr<protocol::Array<Plutonium::Window>>* windows) {
+  *windows = std::make_unique<protocol::Array<Plutonium::Window>>();
+  if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+    for (const ExoWindowBroker::WindowInfo& window : broker->GetWindows()) {
+      (*windows)->push_back(ToProtocol(window));
+    }
+  }
+  return Response::Success();
