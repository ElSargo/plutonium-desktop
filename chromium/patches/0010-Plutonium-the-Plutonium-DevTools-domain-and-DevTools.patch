+// Input.dispatch*Event's modifier bits.
+int EventFlagsForModifiers(int modifiers) {
+  int flags = 0;
+  if (modifiers & 1) {
+    flags |= ui::EF_ALT_DOWN;
+  }
+  if (modifiers & 2) {
+    flags |= ui::EF_CONTROL_DOWN;
+  }
+  if (modifiers & 4) {
+    flags |= ui::EF_COMMAND_DOWN;
+  }
+  if (modifiers & 8) {
+    flags |= ui::EF_SHIFT_DOWN;
+  }
+  if (modifiers & 16) {
+    flags |= ui::EF_ALTGR_DOWN;
+  }
+  return flags;
+}
+
+// Input.dispatchMouseEvent's |buttons| bits.
+int EventFlagsForButtons(int buttons) {
+  int flags = 0;
+  if (buttons & 1) {
+    flags |= ui::EF_LEFT_MOUSE_BUTTON;
+  }
+  if (buttons & 2) {
+    flags |= ui::EF_RIGHT_MOUSE_BUTTON;
+  }
+  if (buttons & 4) {
+    flags |= ui::EF_MIDDLE_MOUSE_BUTTON;
+  }
+  if (buttons & 8) {
+    flags |= ui::EF_BACK_MOUSE_BUTTON;
+  }
+  if (buttons & 16) {
+    flags |= ui::EF_FORWARD_MOUSE_BUTTON;
+  }
+  return flags;
+}
+
+std::optional<int> EventFlagForButton(const std::string& button) {
+  if (button == "none") {
+    return 0;
+  }
+  if (button == "left") {
+    return ui::EF_LEFT_MOUSE_BUTTON;
+  }
+  if (button == "middle") {
+    return ui::EF_MIDDLE_MOUSE_BUTTON;
+  }
+  if (button == "right") {
+    return ui::EF_RIGHT_MOUSE_BUTTON;
+  }
+  if (button == "back") {
+    return ui::EF_BACK_MOUSE_BUTTON;
+  }
+  if (button == "forward") {
+    return ui::EF_FORWARD_MOUSE_BUTTON;
+  }
+  return std::nullopt;
+}
