+void PlutoniumHandler::CaptureTab(int id,
+                                  std::optional<std::string> format,
+                                  std::optional<int> quality,
+                                  std::unique_ptr<CaptureTabCallback> callback) {
+  if (!PlutoniumTabs::Get()->GetTab(id)) {
+    callback->sendFailure(NoTab());
+    return;
+  }
+  const bool jpeg =
+      format.value_or("png") == Plutonium::CaptureTab::FormatEnum::Jpeg;
+  PlutoniumTabs::Get()->Snapshot(
+      id, base::BindOnce(
+              [](std::unique_ptr<CaptureTabCallback> callback, bool jpeg,
+                 int quality, const SkBitmap& bitmap) {
+                std::optional<std::vector<uint8_t>> data;
+                if (!bitmap.drawsNothing()) {
+                  data = Encode(bitmap, jpeg, quality);
+                }
+                if (!data) {
+                  callback->sendFailure(
+                      Response::ServerError("The tab has nothing to show"));
+                  return;
+                }
+                callback->sendSuccess(
+                    protocol::Binary::fromVector(std::move(*data)),
+                    bitmap.width(), bitmap.height());
+              },
+              std::move(callback), jpeg, quality.value_or(80)));
+}
