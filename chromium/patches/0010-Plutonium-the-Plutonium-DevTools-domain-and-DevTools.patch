--- a/chrome/browser/devtools/cros_protocol.pdl
+++ b/chrome/browser/devtools/cros_protocol.pdl
@@ -12,3 +12,549 @@ domain WindowManager
 
   # Exit the overview mode.
   command exitOverviewMode
+
+# PLUTONIUM (EXO-AGENT): the native windows and browser tabs shell pages show,
+# for the helper (plutoniumd) to drive without a shell page. Browser target,
+# trusted clients (--remote-debugging-port) only.
+experimental domain Plutonium
+  # One of the shells' browser tabs (a target of type "page").
+  type Tab extends object
+    properties
+      # The registry's id (the shell API's), stable for the tab's lifetime.
+      integer id
+      # Its DevTools target id.
+      string targetId
+      string url
+      string title
+      boolean loading
+      boolean canGoBack
+      boolean canGoForward
+      # Whether a shell page shows it.
+      boolean embedded
+      boolean focused
+      # Its origin tag (the thread it was opened for) first, then the rest.
+      array of string tags
+      # The tab whose page opened it, or 0.
+      integer openerId
+      # "shell", "shell:<id>", "page", "devtools" or "agent".
+      string openedBy
+      # In a throwaway off-the-record profile of its own (createTab incognito,
+      # or opened by such a tab's page).
+      boolean incognito
+      # The dialog the page waits on: alert, confirm, prompt or beforeunload.
+      optional string dialogType
+      optional string dialogMessage
+      optional string dialogDefaultPrompt
+      # EXO-TAB-FEATURES: what the tab's features report, a JSON object:
+      # "zoom", "pending" (the requests it waits on, by kind: {requestId,
+      # taken, detail}) and the like (docs/features/TAB_FEATURES.md).
+      string stateJson
+
+  # A native (Wayland or X11) toplevel window.
+  type Window extends object
+    properties
+      integer id
+      string appId
+      string title
+      # The window geometry's size, in DIPs.
+      integer width
+      integer height
+      number deviceScaleFactor
+      # Whether a shell page shows it.
+      boolean embedded
+      # Whether it has the keyboard through the page showing it.
+      boolean focused
+      # Whether it is on the Ash desktop (popped out or fullscreen), not
+      # parked.
+      boolean onDesktop
+      # The Wayland client's pid, or 0.
+      integer pid
+      # Its origin tag (the thread that started it) first, then the rest.
+      array of string tags
+
+  # A popup (menu, tooltip) open on a window, in the window geometry's
+  # coordinates (DIPs).
+  type Popup extends object
+    properties
+      integer x
+      integer y
+      integer width
+      integer height
+
+  type KeyEvent extends object
+    properties
+      enum type
+        keyDown
+        keyUp
+      # A DOM key code ("KeyA", "Enter", "ShiftLeft"), as KeyboardEvent.code.
+      string code
+      # Alt=1, Ctrl=2, Meta=4, Shift=8 (as Input.dispatchKeyEvent), and
+      # AltGr=16, held while this key goes.
+      optional integer modifiers
+
+  # A character the session's keymap types: its key, and the modifiers held
+  # for it (Shift=8, AltGr=16).
+  type TypedChar extends object
+    properties
+      string text
+      string code
+      integer modifiers
+
+  # Reports tabs and windows as they come, change and go; the current ones
+  # first.
+  command enable
+
+  command disable
+
+  command getTabs
+    returns
+      array of Tab tabs
+
+  # Opens a tab in the shells' profile. Like a tab a shell opens, it waits
+  # for a shell to show it.
+  command createTab
+    parameters
+      string url
+      # The first is its origin tag (its thread).
+      optional array of string tags
+      # In a throwaway off-the-record profile of its own, gone when it and
+      # the tabs its page opens close.
+      optional boolean incognito
+    returns
+      Tab tab
+
+  command navigateTab
+    parameters
+      integer id
+      string url
+
+  # Runs a command on the tab: back, forward, reload, stop, close, or a tab
+  # feature's ("zoom-in", "find", ...; TAB_FEATURES.md).
+  command tabCommand
+    parameters
+      integer id
+      string command
+      # Its arguments, a JSON object.
+      optional string argsJson
+    returns
+      # Its result, as JSON.
+      string resultJson
+
+  # EXO-TAB-FEATURES: answers a request the tab waits on (its state's
+  # "pending"), as the shell's prompt would. Each kind says which answers an
+  # agent may give.
+  command answerTabRequest
+    parameters
+      integer requestId
+      # The answer, as JSON (its form depends on the kind).
+      string answerJson
+
+  command answerTabDialog
+    parameters
+      integer id
+      boolean accept
+      optional string promptText
+
+  # EXO-TAB-FEATURES: the downloads, each a JSON object: {id, tabId, thread,
+  # url, filename, path, mime, receivedBytes, totalBytes, state, danger?,
+  # error?, canResume, startTime} (docs/features/TAB_FEATURES.md).
+  command getDownloads
+    returns
+      array of string downloadsJson
+
+  # Runs a command on a download: pause, resume, cancel, open, show, discard
+  # or remove. Not keep: whether to keep a dangerous file is the user's call.
+  command downloadCommand
+    parameters
+      integer id
+      string command
+
+  # Keeps a tab rendering at full rate (animation frames, timers) while no
+  # page shows it, for as long as this client wants: an agent driving it
+  # waits on frames. The tab stays hidden from the user.
+  command setTabAwake
+    parameters
+      integer id
+      boolean awake
+
+  # What the tab shows (its viewport), also while no page shows it.
+  command captureTab
+    parameters
+      integer id
+      optional enum format
+        png
+        jpeg
+      optional integer quality
+    returns
+      binary data
+      integer width
+      integer height
+
+  command getWindows
+    returns
+      array of Window windows
+
+  # What the window shows, cropped to its window geometry, at the window's
+  # scale (deviceScaleFactor pixels per DIP). Works while no page shows it.
+  command captureWindow
+    parameters
+      integer id
+      optional enum format
+        png
+        jpeg
+      # 0 to 100, for jpeg.
+      optional integer quality
+    returns
+      binary data
+      integer width
+      integer height
+
+  # The window's open popups (menus, tooltips), parents first. captureWindow
+  # draws them over the window, growing its image right and down to hold
+  # them, and dispatchWindowMouseEvent reaches them.
+  command getWindowPopups
+    parameters
+      integer id
+    returns
+      array of Popup popups
+
+  # Keeps a window drawing at full rate while no page shows it, for as long
+  # as this client wants: the app draws (and answers input visibly) at a
+  # frame a second otherwise. Window screencasts do this themselves.
+  command setWindowAwake
+    parameters
+      integer id
+      boolean awake
+
+  # Keeps the window's app keyboard focused for this client's keys
+  # (dispatchWindowKeyEvents), beside the user's focus in another app, until
+  # focused is false. Without it the app has focus only during each call: an
+  # app may move its own focus after a key (Enter in a toolbar box) only
+  # while it has focus.
+  command setWindowAgentFocus
+    parameters
+      integer id
+      boolean focused
+
+  # Asks the app to close the window, as its close button would.
+  command closeWindow
+    parameters
+      integer id
+
+  # Names window |id|'s origin tag (the thread that started it) when the
+  # browser couldn't read its client's environment, as a shell page's
+  # setWindowOriginTag does: once, for every shell.
+  command setWindowOriginTag
+    parameters
+      integer id
+      string tag
+    returns
+      # False if the browser read the origin itself, it was named already, or
+      # |tag| isn't a valid tag.
+      boolean ok
+
+  # Asks the app for this window geometry size (DIPs). Only while no page
+  # shows it: then the page decides.
+  command resizeWindow
+    parameters
+      integer id
+      integer width
+      integer height
+
+  # EXO-DISPLAYS: replaces the displays with host windows, for testing
+  # hotplug on X11; only with --plutonium-test-displays. Each spec is an
+  # --ash-host-window-bounds one ("1280+0-1280x800", "*2" for scale 2), and
+  # may start with "<id>:" to keep a display's id (else it is a new display).
+  command setDisplaysForTesting
+    parameters
+      array of string specs
+
+  # EXO-DISPLAYS: the displays' configuration, for the helper's display
+  # service (plutonium_display_config.h has the JSON): every display's place,
+  # mode, size, rotation, whether it's primary, and mirroring.
+  command getDisplayConfig
+    returns
+      string json
+
+  # Applies one change to the displays (plutonium_display_config.h); an
+  # error says why not.
+  command configureDisplays
+    parameters
+      string changeJson
+
+  # Opens the switcher (Super+Tab's overlay) on one of its settings pages:
+  # settings, displays, network, bluetooth, sound, power or notifications.
+  command openSwitcher
+    parameters
+      string page
+
+  # A display came, went or changed, or keyboard focus moved to another.
+  event displayConfigChanged
+
+  # A mouse event at (x, y), in DIPs from the window geometry's top left (a
+  # captureWindow image's pixels divided by deviceScaleFactor). Neither the
+  # user's pointer nor the keyboard focus moves.
+  command dispatchWindowMouseEvent
+    parameters
+      integer id
+      enum type
+        mousePressed
+        mouseReleased
+        mouseMoved
+        mouseWheel
+      number x
+      number y
+      optional enum button
+        none
+        left
+        middle
+        right
+        back
+        forward
+      # Buttons held: left=1, right=2, middle=4, back=8, forward=16.
+      optional integer buttons
+      optional integer clickCount
+      # mouseWheel: wheel notches to scroll, down and right positive.
+      optional number deltaX
+      optional number deltaY
+      optional integer modifiers
+
+  # Keys, in order. The window has the keyboard for them, and whatever had
+  # it gets it back.
+  command dispatchWindowKeyEvents
+    parameters
+      integer id
+      array of KeyEvent events
+
+  # The keymap Exo sends apps (XKB text, as wl_keyboard.keymap), and the
+  # characters its first layout types.
+  command getKeymap
+    returns
+      string keymap
+      array of TypedChar chars
+
+  # The window's app gets |keymap| (XKB text) in place of the session's,
+  # until this comes again without one: for characters the session's keymap
+  # lacks. Keys keep their codes, so the keymap should be the session's with
+  # symbols changed on spare keys.
+  command setWindowKeymap
+    parameters
+      integer id
+      optional string keymap
+
+  # Sends windowScreencastFrame events as the window draws, one at a time:
+  # the next waits for windowScreencastFrameAck.
+  command startWindowScreencast
+    parameters
+      integer id
+      optional enum format
+        png
+        jpeg
+      optional integer quality
+      optional integer maxWidth
+      optional integer maxHeight
+
+  command stopWindowScreencast
+    parameters
+      integer id
+
+  command windowScreencastFrameAck
+    parameters
+      integer id
+      integer sessionId
+
+  event windowScreencastFrame
+    parameters
+      integer id
+      binary data
+      integer width
+      integer height
+      integer sessionId
+
+  # The window's screencast stopped (the window closed).
+  event windowScreencastStopped
+    parameters
+      integer id
+
+  # EXO-CAPTURE (docs/features/CAPTURE.md): runs capture command |command|
+  # with |argsJson| (a JSON object), as a shell's captureCommand() does:
+  # "sources", "list", "settings", "stop", "setSize", and for the helper's
+  # portal backend "request" (asks the focused shell, else Ash's picker; the
+  # answer, or null if the user refused) and "cancelRequest" {handle}.
+  command captureCommand
+    parameters
+      string command
+      optional string argsJson
+    returns
+      # Its result, as JSON.
+      string resultJson
+
+  # EXO-CAPTURE: a PNG of a source ({type: "output" | "window" | "tab", id,
+  # region?}), refused while screenshots are switched off.
+  command screenshot
+    parameters
+      string sourceJson
+    returns
+      binary data
+      integer width
+      integer height
+
+  # EXO-CAPTURE: a capture started, changed or stopped (|json| is the
+  # capture), or the capture settings changed (|json| is them).
+  event captureEvent
+    parameters
+      # "start", "change", "stop" or "settings".
+      string type
+      string json
+
+  event tabAdded
+    parameters
+      Tab tab
+
+  event tabChanged
+    parameters
+      Tab tab
+
+  event tabRemoved
+    parameters
+      integer id
+
+  # EXO-TAB-FEATURES: a download started (or, on enable, was there).
+  event downloadAdded
+    parameters
+      string downloadJson
+
+  event downloadChanged
+    parameters
+      string downloadJson
+
+  event downloadRemoved
+    parameters
+      integer id
+
+  event windowAdded
+    parameters
+      Window window
+
+  event windowChanged
+    parameters
+      Window window
+
+  event windowRemoved
+    parameters
+      integer id
+
+  # EXO-SERVICES: the browser's active media session (a tab or a shell page
+  # playing), for the helper's media service.
+  type MediaSession extends object
+    properties
+      # False when nothing is playing or paused; the rest is then empty.
+      boolean active
+      boolean playing
+      string title
+      string artist
+      string album
+      # The site or app playing.
+      string source
+      # The Media Session actions it handles: play, pause, nexttrack,
+      # previoustrack, seekbackward, seekforward, stop.
+      array of string actions
+      # The shells' tab playing, if it's one.
+      optional integer tabId
+
+  command getMediaSession
+    returns
+      MediaSession session
+
+  # play, pause, play-pause, next, previous or stop.
+  command mediaSessionAction
+    parameters
+      string action
+
+  event mediaSessionChanged
+    parameters
+      MediaSession session
+
+  # EXO-LOCK: the lock screen and idle, for the helper's session service. The
+  # lock is Ash's own, over every display; only the password typed on it,
+  # checked by the helper, takes it down (there's no unlock command).
+  command lock
+    parameters
+      # The user's name, shown on it.
+      optional string user
+      # Why it locked, or what to say ("Locked before suspend").
+      optional string message
+
+  command getIdle
+    returns
+      boolean locked
+      # Since the user last did anything (a key, the pointer, a touch).
+      number idleSeconds
+      boolean displaysOff
+      # What keeps the screen on: the browser's wake locks ("Video Wake Lock",
+      # "Blink Wake Lock": the Screen Wake Lock API) and Wayland apps' idle
+      # inhibitors, by their descriptions.
+      array of string wakeLocks
+
+  # Turns the displays off until the user does something (on DRM), or on.
+  command setDisplaysOff
+    parameters
+      boolean off
+    returns
+      # False where it can't (an X11 session).
+      boolean applied
+
+  # Whether something holds idle off (any of the session service's
+  # inhibitors), for Wayland apps' ext_idle_notify_v1: while it does, they
+  # aren't told the user is idle, and idle counts again from when it stops.
+  # Taken back when the client that said so goes.
+  command setIdleInhibited
+    parameters
+      boolean inhibited
+
+  event lockChanged
+    parameters
+      boolean locked
+
+  # EXO-SERVICES: a tab's web notification (new Notification(), a service
+  # worker's showNotification()), for the helper's notifications service.
+  # Ash's message center has them, and shell mode never shows it.
+  type WebNotification extends object
+    properties
+      string id
+      # The site's origin.
+      string origin
+      string title
+      string body
+      # A PNG data URL, or empty.
+      string icon
+      # Its action buttons' labels.
+      array of string buttons
+      boolean requireInteraction
+      boolean silent
+
+  # A new or updated one; on enable, each there is.
+  event notificationShown
+    parameters
+      WebNotification notification
+
+  # It went: the page closed it, or it was acted on.
+  event notificationClosed
+    parameters
+      string id
+
+  # click (the notification, or with button one of its buttons: the page's
+  # onclick, the worker's notificationclick), or close (dismissed by the
+  # user).
+  command notificationAction
+    parameters
+      string id
+      string action
+      optional integer button
+
+  # EXO-SERVICES: the host's color scheme (the settings portal's
+  # org.freedesktop.appearance color-scheme), which Ash's dark mode then
+  # follows: prefers-color-scheme in shells and tabs, and Ash's own views.
+  command setColorScheme
+    parameters
+      boolean dark
