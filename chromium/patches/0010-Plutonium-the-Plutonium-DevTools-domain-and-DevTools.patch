+    // As tab capture does for a background tab: frames without showing it.
+    awake_tabs_.emplace(id, contents->IncrementCapturerCount(
+                                gfx::Size(), /*stay_hidden=*/true,
+                                /*stay_awake=*/true, /*is_activity=*/false));
+  }
+  return Response::Success();
