+Response PlutoniumHandler::GetKeymap(
+    std::string* keymap,
+    std::unique_ptr<protocol::Array<Plutonium::TypedChar>>* chars) {
+  exo::EmbeddedWindows* windows = exo::EmbeddedWindows::Get();
+  *keymap = windows->GetKeymap();
+  *chars = std::make_unique<protocol::Array<Plutonium::TypedChar>>();
+  for (const exo::EmbeddedWindows::TypedChar& typed :
+       windows->GetTypedChars()) {
+    std::string text;
+    base::WriteUnicodeCharacter(static_cast<base_icu::UChar32>(typed.character),
+                                &text);
+    (*chars)->push_back(
+        Plutonium::TypedChar::Create()
+            .SetText(std::move(text))
+            .SetCode(typed.code)
+            .SetModifiers(((typed.flags & ui::EF_SHIFT_DOWN) ? 8 : 0) |
+                          ((typed.flags & ui::EF_ALTGR_DOWN) ? 16 : 0))
+            .Build());
+  }
+  return Response::Success();
+}
