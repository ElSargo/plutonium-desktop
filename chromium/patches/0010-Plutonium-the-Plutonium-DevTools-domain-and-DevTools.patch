+  // protocol::Plutonium::Backend:
+  protocol::Response Enable() override;
+  protocol::Response Disable() override;
+  protocol::Response GetTabs(
+      std::unique_ptr<protocol::Array<protocol::Plutonium::Tab>>* tabs)
+      override;
+  protocol::Response CreateTab(
+      const std::string& url,
+      std::unique_ptr<protocol::Array<std::string>> tags,
+      std::optional<bool> incognito,
