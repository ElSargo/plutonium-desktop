+Response PlutoniumHandler::DispatchWindowMouseEvent(
+    int id,
+    const std::string& type,
+    double x,
+    double y,
+    std::optional<std::string> button,
+    std::optional<int> buttons,
+    std::optional<int> click_count,
+    std::optional<double> delta_x,
+    std::optional<double> delta_y,
+    std::optional<int> modifiers) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    return NoWindow();
+  }
+  std::optional<int> changed = EventFlagForButton(button.value_or("none"));
+  if (!changed) {
+    return Response::InvalidParams("Unknown button");
+  }
+  int flags = EventFlagsForModifiers(modifiers.value_or(0)) |
+              EventFlagsForButtons(buttons.value_or(0));
+  const gfx::PointF location(x, y);
+  std::unique_ptr<ui::MouseEvent> event;
+  if (type == Plutonium::DispatchWindowMouseEvent::TypeEnum::MouseWheel) {
+    // Down and right positive, as wheel notches; aura's offsets are the
+    // content's direction, 120 to a notch.
+    const gfx::Vector2d offset(
+        static_cast<int>(-delta_x.value_or(0) * ui::MouseWheelEvent::kWheelDelta),
+        static_cast<int>(-delta_y.value_or(0) *
+                         ui::MouseWheelEvent::kWheelDelta));
+    event = std::make_unique<ui::MouseWheelEvent>(
+        offset, location, location, ui::EventTimeForNow(), flags, 0);
+  } else {
+    ui::EventType event_type;
+    if (type == Plutonium::DispatchWindowMouseEvent::TypeEnum::MousePressed) {
+      event_type = ui::EventType::kMousePressed;
+      flags |= *changed;
+    } else if (type ==
+               Plutonium::DispatchWindowMouseEvent::TypeEnum::MouseReleased) {
+      event_type = ui::EventType::kMouseReleased;
+      flags |= *changed;
+    } else if (type ==
+               Plutonium::DispatchWindowMouseEvent::TypeEnum::MouseMoved) {
+      event_type = flags & (ui::EF_LEFT_MOUSE_BUTTON |
+                            ui::EF_MIDDLE_MOUSE_BUTTON |
+                            ui::EF_RIGHT_MOUSE_BUTTON)
+                       ? ui::EventType::kMouseDragged
+                       : ui::EventType::kMouseMoved;
+    } else {
+      return Response::InvalidParams("Unknown type");
+    }
+    if (event_type != ui::EventType::kMousePressed &&
+        event_type != ui::EventType::kMouseReleased && *changed) {
+      return Response::InvalidParams("Only presses and releases change a button");
+    }
+    if ((event_type == ui::EventType::kMousePressed ||
+         event_type == ui::EventType::kMouseReleased) &&
+        !*changed) {
+      return Response::InvalidParams("Which button?");
+    }
+    event = std::make_unique<ui::MouseEvent>(event_type, location, location,
+                                             ui::EventTimeForNow(), flags,
+                                             *changed);
+    if (click_count && *click_count > 0 &&
+        (event_type == ui::EventType::kMousePressed ||
+         event_type == ui::EventType::kMouseReleased)) {
+      event->SetClickCount(*click_count);
+    }
+  }
+  if (!exo::EmbeddedWindows::Get()->InjectMouseEvent(id, location,
+                                                     std::move(event))) {
+    return Response::ServerError("The window takes no input yet");
+  }
+  return Response::Success();
+}
+
+Response PlutoniumHandler::DispatchWindowKeyEvents(
+    int id,
+    std::unique_ptr<protocol::Array<Plutonium::KeyEvent>> events) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    return NoWindow();
+  }
+  std::vector<std::unique_ptr<ui::KeyEvent>> keys;
+  for (const std::unique_ptr<Plutonium::KeyEvent>& key : *events) {
+    const ui::DomCode code =
+        ui::KeycodeConverter::CodeStringToDomCode(key->GetCode());
+    if (code == ui::DomCode::NONE) {
+      return Response::InvalidParams("Unknown key code \"" + key->GetCode() +
+                                     "\"");
+    }
+    const ui::EventType type =
+        key->GetType() == Plutonium::KeyEvent::TypeEnum::KeyDown
+            ? ui::EventType::kKeyPressed
+            : ui::EventType::kKeyReleased;
+    keys.push_back(std::make_unique<ui::KeyEvent>(
+        type, ui::DomCodeToUsLayoutKeyboardCode(code), code,
+        EventFlagsForModifiers(key->GetModifiers(0)), ui::EventTimeForNow()));
+  }
+  if (!exo::EmbeddedWindows::Get()->InjectKeyEvents(id, std::move(keys))) {
+    return Response::ServerError(
+        "The window takes no keys yet (or nothing has focus to lend it)");
+  }
+  return Response::Success();
+}
