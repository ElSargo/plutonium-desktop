+  protocol::Response NavigateTab(int id, const std::string& url) override;
+  void TabCommand(int id,
+                  const std::string& command,
+                  std::optional<std::string> args_json,
+                  std::unique_ptr<TabCommandCallback> callback) override;
+  protocol::Response AnswerTabRequest(int request_id,
+                                      const std::string& answer_json) override;
+  protocol::Response AnswerTabDialog(
+      int id,
+      bool accept,
+      std::optional<std::string> prompt_text) override;
+  protocol::Response SetTabAwake(int id, bool awake) override;
+  protocol::Response GetDownloads(
+      std::unique_ptr<protocol::Array<std::string>>* downloads_json) override;
+  void DownloadCommand(
+      int id,
+      const std::string& command,
+      std::unique_ptr<DownloadCommandCallback> callback) override;
+  void CaptureTab(int id,
+                  std::optional<std::string> format,
+                  std::optional<int> quality,
+                  std::unique_ptr<CaptureTabCallback> callback) override;
+  protocol::Response GetWindows(
+      std::unique_ptr<protocol::Array<protocol::Plutonium::Window>>* windows)
+      override;
+  void CaptureWindow(int id,
+                     std::optional<std::string> format,
+                     std::optional<int> quality,
+                     std::unique_ptr<CaptureWindowCallback> callback) override;
+  protocol::Response GetWindowPopups(
+      int id,
+      std::unique_ptr<protocol::Array<protocol::Plutonium::Popup>>* popups)
+      override;
+  protocol::Response SetWindowAwake(int id, bool awake) override;
+  protocol::Response SetWindowAgentFocus(int id, bool focused) override;
+  protocol::Response CloseWindow(int id) override;
+  protocol::Response SetWindowOriginTag(int id,
+                                       const std::string& tag,
+                                       bool* ok) override;
+  protocol::Response ResizeWindow(int id, int width, int height) override;
+  protocol::Response SetDisplaysForTesting(
+      std::unique_ptr<protocol::Array<std::string>> specs) override;
+  protocol::Response DispatchWindowMouseEvent(
+      int id,
+      const std::string& type,
+      double x,
+      double y,
+      std::optional<std::string> button,
+      std::optional<int> buttons,
+      std::optional<int> click_count,
+      std::optional<double> delta_x,
+      std::optional<double> delta_y,
+      std::optional<int> modifiers) override;
+  protocol::Response DispatchWindowKeyEvents(
+      int id,
+      std::unique_ptr<protocol::Array<protocol::Plutonium::KeyEvent>> events)
+      override;
+  protocol::Response GetKeymap(
+      std::string* keymap,
+      std::unique_ptr<protocol::Array<protocol::Plutonium::TypedChar>>* chars)
+      override;
+  protocol::Response SetWindowKeymap(
+      int id,
+      std::optional<std::string> keymap) override;
+  protocol::Response StartWindowScreencast(
+      int id,
+      std::optional<std::string> format,
+      std::optional<int> quality,
+      std::optional<int> max_width,
+      std::optional<int> max_height) override;
+  protocol::Response StopWindowScreencast(int id) override;
+  protocol::Response WindowScreencastFrameAck(int id, int session_id) override;
+  void CaptureCommand(const std::string& command,
+                      std::optional<std::string> args_json,
+                      std::unique_ptr<CaptureCommandCallback> callback) override;
+  void Screenshot(const std::string& source_json,
+                  std::unique_ptr<ScreenshotCallback> callback) override;
+  protocol::Response GetMediaSession(
+      std::unique_ptr<protocol::Plutonium::MediaSession>* session) override;
+  protocol::Response MediaSessionAction(const std::string& action) override;
+  protocol::Response Lock(std::optional<std::string> user,
+                          std::optional<std::string> message) override;
+  protocol::Response GetIdle(
+      bool* locked,
+      double* idle_seconds,
+      bool* displays_off,
+      std::unique_ptr<protocol::Array<std::string>>* wake_locks) override;
+  protocol::Response SetDisplaysOff(bool off, bool* applied) override;
+  // EXO-DISPLAYS
+  protocol::Response GetDisplayConfig(std::string* json) override;
+  protocol::Response ConfigureDisplays(const std::string& change_json) override;
+  protocol::Response OpenSwitcher(const std::string& page) override;
+  protocol::Response SetIdleInhibited(bool inhibited) override;
+  protocol::Response NotificationAction(const std::string& id,
+                                        const std::string& action,
+                                        std::optional<int> button) override;
+  protocol::Response SetColorScheme(bool dark) override;
+
+  // PlutoniumLock::Observer:
+  void OnLockChanged(bool locked) override;
+
+  // PlutoniumShells::Observer:
+  void OnDisplaysChanged() override;
+  void OnShellsDestroying() override;
+
+  // ExoWindowBroker::Observer:
+  void OnWindowAdded(const ExoWindowBroker::WindowInfo& window) override;
+  void OnWindowChanged(const ExoWindowBroker::WindowInfo& window) override;
+  void OnWindowRemoved(int32_t window_id) override;
+
+  // PlutoniumTabs::Observer:
+  void OnTabAdded(const PlutoniumTabs::TabInfo& tab) override;
+  void OnTabChanged(const PlutoniumTabs::TabInfo& tab) override;
+  void OnTabRemoved(int32_t tab_id) override;
+
+  // PlutoniumDownloads::Observer:
+  void OnDownloadAdded(const base::DictValue& download) override;
+  void OnDownloadChanged(const base::DictValue& download) override;
+  void OnDownloadRemoved(int32_t id) override;
+
+  // PlutoniumCapture::Observer:
+  void OnCaptureStarted(int32_t id, const base::DictValue& capture) override;
+  void OnCaptureChanged(int32_t id, const base::DictValue& capture) override;
+  void OnCaptureStopped(int32_t id, const base::DictValue& capture) override;
+  void OnCaptureSettingsChanged(const base::DictValue& settings) override;
+
+ private:
+  struct Screencast {
+    Screencast();
+    ~Screencast();
+    std::unique_ptr<plutonium_agent::WindowScreencast> capture;
+    // At full rate while watched.
+    base::ScopedClosureRunner keep_drawing;
+    bool jpeg = true;
+    int quality = 80;
+    // The frame the client hasn't acknowledged yet, or 0.
+    int pending_session_id = 0;
+    // A frame that came while waiting for the ack; sent on the ack.
+    std::unique_ptr<SkBitmap> next;
+  };
+
+  void OnScreencastFrame(int32_t window_id, const SkBitmap& frame);
+  void SendScreencastFrame(int32_t window_id, const SkBitmap& frame);
+  void OnMediaSessionChanged();
+  void OnNotificationShown(const PlutoniumWebNotifications::Info& info);
+  void OnNotificationClosed(const std::string& id);
+
+  std::unique_ptr<protocol::Plutonium::Frontend> frontend_;
+  bool enabled_ = false;
+  // EXO-LOCK: whether this client said idle is inhibited (SetIdleInhibited()).
+  bool idle_inhibited_ = false;
+  base::ScopedObservation<ExoWindowBroker, ExoWindowBroker::Observer>
+      broker_observation_{this};
+  base::ScopedObservation<PlutoniumTabs, PlutoniumTabs::Observer>
+      tabs_observation_{this};
+  base::ScopedObservation<PlutoniumDownloads, PlutoniumDownloads::Observer>
+      downloads_observation_{this};
+  base::ScopedObservation<PlutoniumCapture, PlutoniumCapture::Observer>
+      capture_observation_{this};
+  base::ScopedObservation<PlutoniumLock, PlutoniumLock::Observer>
+      lock_observation_{this};
+  // EXO-DISPLAYS: for displayConfigChanged.
+  base::ScopedObservation<PlutoniumShells, PlutoniumShells::Observer>
+      shells_observation_{this};
+  std::map<int32_t, Screencast> screencasts_;
+  // Tabs kept awake (SetTabAwake): their capture handles.
+  std::map<int32_t, base::ScopedClosureRunner> awake_tabs_;
+  // Windows kept awake (SetWindowAwake).
+  std::map<int32_t, base::ScopedClosureRunner> awake_windows_;
+  // Windows kept focused for the agent (SetWindowAgentFocus).
+  std::map<int32_t, base::ScopedClosureRunner> agent_focus_windows_;
+  int next_session_id_ = 1;
+  // EXO-SERVICES: the browser's active media session, while enabled.
+  std::unique_ptr<PlutoniumMediaSession> media_session_;
+  // EXO-SERVICES: the tabs' web notifications, while enabled.
+  std::unique_ptr<PlutoniumWebNotifications> notifications_;
+  base::WeakPtrFactory<PlutoniumHandler> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_PLUTONIUM_HANDLER_H_
diff --git a/chrome/browser/devtools/protocol/plutonium_media.cc b/chrome/browser/devtools/protocol/plutonium_media.cc
new file mode 100644
index 0000000000..fb2607236a
--- /dev/null
+++ b/chrome/browser/devtools/protocol/plutonium_media.cc
@@ -0,0 +1,132 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/devtools/protocol/plutonium_media.h"
+
+#include <utility>
+
+#include "chrome/browser/plutonium_tabs.h"
+#include "content/public/browser/media_session.h"
+#include "content/public/browser/media_session_service.h"
+#include "services/media_session/public/cpp/media_metadata.h"
+#include "services/media_session/public/mojom/media_session.mojom.h"
+#include "services/media_session/public/cpp/media_session_service.h"
+
+namespace {
+
+using media_session::mojom::MediaSessionAction;
+
+// The Media Session API's names for them.
+const char* ActionName(MediaSessionAction action) {
+  switch (action) {
+    case MediaSessionAction::kPlay:
+      return "play";
+    case MediaSessionAction::kPause:
+      return "pause";
+    case MediaSessionAction::kPreviousTrack:
+      return "previoustrack";
+    case MediaSessionAction::kNextTrack:
+      return "nexttrack";
+    case MediaSessionAction::kSeekBackward:
+      return "seekbackward";
+    case MediaSessionAction::kSeekForward:
+      return "seekforward";
+    case MediaSessionAction::kStop:
+      return "stop";
+    default:
+      return nullptr;
+  }
+}
+
+}  // namespace
+
+PlutoniumMediaSession::Info::Info() = default;
+PlutoniumMediaSession::Info::Info(const Info&) = default;
+PlutoniumMediaSession::Info::~Info() = default;
+
+PlutoniumMediaSession::PlutoniumMediaSession(base::RepeatingClosure changed)
+    : changed_(std::move(changed)) {
+  mojo::Remote<media_session::mojom::MediaControllerManager> manager;
+  content::GetMediaSessionService().BindMediaControllerManager(
+      manager.BindNewPipeAndPassReceiver());
+  manager->CreateActiveMediaController(
+      controller_.BindNewPipeAndPassReceiver());
+  controller_->AddObserver(receiver_.BindNewPipeAndPassRemote());
+}
+
+PlutoniumMediaSession::~PlutoniumMediaSession() = default;
+
+std::optional<PlutoniumMediaSession::Info> PlutoniumMediaSession::GetInfo()
+    const {
+  if (!active_) {
+    return std::nullopt;
+  }
+  Info info = info_;
+  // Looked up now: tab ids come and go with the tabs.
+  if (request_id_) {
+    if (content::WebContents* contents =
+            content::MediaSession::GetWebContentsFromRequestId(
+                *request_id_)) {
+      if (std::optional<PlutoniumTabs::TabInfo> tab =
+              PlutoniumTabs::Get()->GetTabFor(contents)) {
+        info.tab_id = tab->id;
+      }
+    }
+  }
+  return info;
+}
+
+bool PlutoniumMediaSession::Perform(const std::string& action) {
+  if (action == "play") {
+    controller_->Resume();
+  } else if (action == "pause") {
+    controller_->Suspend();
+  } else if (action == "play-pause") {
+    controller_->ToggleSuspendResume();
+  } else if (action == "next") {
+    controller_->NextTrack();
+  } else if (action == "previous") {
+    controller_->PreviousTrack();
+  } else if (action == "stop") {
+    controller_->Stop();
+  } else {
+    return false;
+  }
+  return true;
+}
+
+void PlutoniumMediaSession::MediaSessionInfoChanged(
+    media_session::mojom::MediaSessionInfoPtr info) {
+  active_ = !info.is_null();
+  info_.playing =
+      active_ && info->playback_state ==
+                     media_session::mojom::MediaPlaybackState::kPlaying;
+  changed_.Run();
+}
+
+void PlutoniumMediaSession::MediaSessionMetadataChanged(
+    const std::optional<media_session::MediaMetadata>& metadata) {
+  info_.title = metadata ? metadata->title : std::u16string();
+  info_.artist = metadata ? metadata->artist : std::u16string();
+  info_.album = metadata ? metadata->album : std::u16string();
+  info_.source = metadata ? metadata->source_title : std::u16string();
+  changed_.Run();
+}
+
+void PlutoniumMediaSession::MediaSessionActionsChanged(
+    const std::vector<MediaSessionAction>& actions) {
+  info_.actions.clear();
+  for (MediaSessionAction action : actions) {
+    if (const char* name = ActionName(action)) {
+      info_.actions.push_back(name);
+    }
+  }
+  changed_.Run();
+}
+
+void PlutoniumMediaSession::MediaSessionChanged(
+    const std::optional<base::UnguessableToken>& request_id) {
+  request_id_ = request_id;
+  changed_.Run();
+}
