+Response PlutoniumHandler::Enable() {
+  if (enabled_) {
+    return Response::Success();
+  }
+  enabled_ = true;
+  // The current ones first, as the shell API's subscriptions do.
+  if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+    for (const ExoWindowBroker::WindowInfo& window : broker->GetWindows()) {
+      frontend_->WindowAdded(ToProtocol(window));
+    }
+    broker_observation_.Observe(broker);
+  }
+  for (const PlutoniumTabs::TabInfo& tab : PlutoniumTabs::Get()->GetTabs()) {
+    frontend_->TabAdded(ToProtocol(tab));
+  }
+  tabs_observation_.Observe(PlutoniumTabs::Get());
+  // EXO-TAB-FEATURES: downloads, the shells' profile's included.
+  PlutoniumDownloads* downloads = PlutoniumDownloads::Get();
+  if (content::WebContents* shell = PlutoniumTabs::Get()->shell()) {
+    downloads->ObserveContext(shell->GetBrowserContext());
+  }
+  for (const base::DictValue& download : downloads->GetDownloads()) {
+    OnDownloadAdded(download);
+  }
+  downloads_observation_.Observe(downloads);
+  // EXO-CAPTURE: the settings, then the captures there are.
+  OnCaptureSettingsChanged(PlutoniumCapture::Get()->GetSettings());
+  for (const base::DictValue& capture : PlutoniumCapture::Get()->GetCaptures()) {
+    OnCaptureStarted(capture.FindInt("id").value_or(0), capture);
+  }
+  capture_observation_.Observe(PlutoniumCapture::Get());
+  // EXO-SERVICES: the media session there is, then its changes.
+  media_session_ = std::make_unique<PlutoniumMediaSession>(base::BindRepeating(
+      &PlutoniumHandler::OnMediaSessionChanged, base::Unretained(this)));
+  // EXO-LOCK
+  if (PlutoniumLock* lock = PlutoniumLock::Get()) {
+    lock_observation_.Observe(lock);
+  }
+  // EXO-DISPLAYS
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    shells_observation_.Observe(shells);
+  }
+  // EXO-SERVICES: the web notifications there are, then the new ones.
+  notifications_ = std::make_unique<PlutoniumWebNotifications>(
+      base::BindRepeating(&PlutoniumHandler::OnNotificationShown,
+                          base::Unretained(this)),
+      base::BindRepeating(&PlutoniumHandler::OnNotificationClosed,
+                          base::Unretained(this)));
+  for (const PlutoniumWebNotifications::Info& info :
+       notifications_->GetNotifications()) {
+    OnNotificationShown(info);
+  }
+  return Response::Success();
+}
+
+Response PlutoniumHandler::Disable() {
+  enabled_ = false;
+  broker_observation_.Reset();
+  tabs_observation_.Reset();
+  downloads_observation_.Reset();
+  capture_observation_.Reset();
+  lock_observation_.Reset();
+  shells_observation_.Reset();
+  media_session_.reset();
+  notifications_.reset();
+  screencasts_.clear();
+  awake_tabs_.clear();
+  awake_windows_.clear();
+  agent_focus_windows_.clear();
+  return Response::Success();
+}
