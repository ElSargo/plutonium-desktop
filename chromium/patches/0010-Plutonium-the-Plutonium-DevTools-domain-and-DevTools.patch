+Response PlutoniumHandler::StartWindowScreencast(
+    int id,
+    std::optional<std::string> format,
+    std::optional<int> quality,
+    std::optional<int> max_width,
+    std::optional<int> max_height) {
+  ExoWindowBroker* broker = ExoWindowBroker::Get();
+  if (!broker || !broker->GetWindow(id)) {
+    return NoWindow();
+  }
+  screencasts_.erase(id);
+  gfx::Size max_size(max_width.value_or(0), max_height.value_or(0));
+  if (max_size.width() <= 0 || max_size.height() <= 0) {
+    max_size = gfx::Size();
+  }
+  Screencast& screencast = screencasts_[id];
+  screencast.jpeg =
+      format.value_or("jpeg") == Plutonium::StartWindowScreencast::FormatEnum::Jpeg;
+  screencast.quality = quality.value_or(80);
+  screencast.capture = plutonium_agent::WindowScreencast::Start(
+      id, max_size,
+      base::BindRepeating(&PlutoniumHandler::OnScreencastFrame,
+                          weak_factory_.GetWeakPtr(), id));
+  if (!screencast.capture) {
+    screencasts_.erase(id);
+    return Response::ServerError("The window has nothing to show yet");
+  }
+  screencast.keep_drawing = exo::EmbeddedWindows::Get()->KeepDrawing(id);
+  return Response::Success();
+}
+
+Response PlutoniumHandler::StopWindowScreencast(int id) {
+  screencasts_.erase(id);
+  return Response::Success();
+}
+
+Response PlutoniumHandler::WindowScreencastFrameAck(int id, int session_id) {
+  auto it = screencasts_.find(id);
+  if (it == screencasts_.end()) {
+    return Response::Success();
+  }
+  Screencast& screencast = it->second;
+  if (screencast.pending_session_id != session_id) {
+    return Response::Success();
+  }
+  screencast.pending_session_id = 0;
+  if (std::unique_ptr<SkBitmap> next = std::move(screencast.next)) {
+    SendScreencastFrame(id, *next);
+  }
+  return Response::Success();
+}
+
+void PlutoniumHandler::OnScreencastFrame(int32_t window_id,
+                                         const SkBitmap& frame) {
+  auto it = screencasts_.find(window_id);
+  if (it == screencasts_.end()) {
+    return;
+  }
+  if (it->second.pending_session_id) {
+    // Keep only the newest until the client catches up.
+    it->second.next = std::make_unique<SkBitmap>(frame);
+    return;
+  }
+  SendScreencastFrame(window_id, frame);
+}
+
+void PlutoniumHandler::SendScreencastFrame(int32_t window_id,
+                                           const SkBitmap& frame) {
+  Screencast& screencast = screencasts_[window_id];
+  std::optional<std::vector<uint8_t>> data =
+      Encode(frame, screencast.jpeg, screencast.quality);
+  if (!data) {
+    return;
+  }
+  screencast.pending_session_id = next_session_id_++;
+  frontend_->WindowScreencastFrame(
+      window_id, protocol::Binary::fromVector(std::move(*data)), frame.width(),
+      frame.height(), screencast.pending_session_id);
+}
