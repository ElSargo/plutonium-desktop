+// EXO-EMBED: the page showing a parked window floating, or no longer
+// floating, configures it again (the client is told whether it is tiled).
+TEST_F(ShellSurfaceTest, EmbedParkedFloatingConfigures) {
+  auto shell_surface =
+      test::ShellSurfaceBuilder({256, 256}).BuildShellSurface();
+  shell_surface->SetEmbedParked(true);
+  int configures = 0;
+  shell_surface->set_configure_callback(base::BindRepeating(
+      [](int* count, const gfx::Rect&, chromeos::WindowStateType, bool, bool,
+         const gfx::Vector2d&, float, aura::Window::OcclusionState,
+         std::optional<chromeos::WindowStateType>) {
+        ++*count;
+        return uint32_t(*count);
+      },
+      &configures));
+  EXPECT_FALSE(shell_surface->embed_floating());
+
+  shell_surface->SetEmbedFloating(true);
+  EXPECT_TRUE(shell_surface->embed_floating());
+  EXPECT_EQ(1, configures);
+  shell_surface->SetEmbedFloating(true);
+  EXPECT_EQ(1, configures);
+  shell_surface->SetEmbedFloating(false);
+  EXPECT_EQ(2, configures);
+
+  // Not parked: nothing to tell the client.
+  shell_surface->SetEmbedParked(false);
+  configures = 0;
+  shell_surface->SetEmbedFloating(true);
+  EXPECT_EQ(0, configures);
+}
