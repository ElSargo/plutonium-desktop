+std::optional<gfx::PointF> HTMLNativeWindowElement::ResizeEdgePoint(
+    const gfx::PointF& point_in_root_frame) const {
+  auto* box = DynamicTo<LayoutBox>(GetLayoutObject());
+  LocalFrameView* view = GetDocument().View();
+  if (!FastHasAttribute(html_names::kFloatingAttr) || !box || !view ||
+      !EmbeddedFrameSinkId().is_valid() ||
+      box->Style().Visibility() != EVisibility::kVisible ||
+      box->Style().UsedPointerEvents() == EPointerEvents::kNone) {
+    return std::nullopt;
+  }
+  // In the box's own space, through any transforms on the way.
+  const gfx::PointF local =
+      box->AbsoluteToLocalPoint(view->RootFrameToDocument(point_in_root_frame));
+  const gfx::RectF content_box(box->PhysicalContentBoxRect());
+  gfx::RectF edges = content_box;
+  edges.Outset(mojom::blink::kResizeEdgeMargin *
+               box->Style().EffectiveZoom());
+  if (content_box.IsEmpty() || !edges.Contains(local) ||
+      content_box.Contains(local)) {
+    return std::nullopt;
+  }
+  return local - content_box.OffsetFromOrigin() +
+         gfx::Vector2dF(GeometryOffsetInPixels());
+}
