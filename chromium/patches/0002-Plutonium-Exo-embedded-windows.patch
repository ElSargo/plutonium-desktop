@@ -0,0 +1,169 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_EXO_PLUTONIUM_VIM_H_
+#define COMPONENTS_EXO_PLUTONIUM_VIM_H_
+
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/timer/timer.h"
+#include "ui/events/keycodes/dom/dom_code.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace ui {
+class KeyEvent;
+}
+
+namespace exo {
+
+class Surface;
+
+// PLUTONIUM: Pluto Vim for native apps (docs/features/PLUTO_VIM.md,
+// "Native apps: text-input-v3"). The engine runs in Plutonium's helper, which
+// sees each text-input-v3 field (its surrounding text, cursor, content type)
+// and, while the field is in a mode that takes keys, each key: Exo holds the
+// key, and every key after it in order, until the helper answers whether the
+// engine took it. A key the engine didn't take goes on to the app as it was.
+// The helper edits the field with delete_surrounding_text and commit_string,
+// and moves its cursor with navigation keys (the agents' key path).
+//
+// Nothing is held without a helper listening, during an input method's
+// composition, in a field that's a password, PIN, sensitive, hidden or a
+// terminal, or for longer than kAnswerTimeout: then the key goes on.
+class PlutoniumVim {
+ public:
+  // A text-input-v3 field (WaylandTextInputV3Delegate).
+  class Field {
+   public:
+    virtual ~Field() = default;
+    // Replaces the |before| UTF-16 units before the cursor and |after| after
+    // it (the selection with them) by |text|, as one edit.
+    virtual void VimEdit(int before, int after, const std::u16string& text) = 0;
+    virtual Surface* VimSurface() = 0;
+  };
+
+  struct FieldState {
+    int id = 0;
+    int32_t window_id = 0;
+    std::u16string text;
+    int cursor = 0;  // UTF-16 offsets into text.
+    int anchor = 0;
+    uint32_t hint = 0;
+    uint32_t purpose = 0;
+    // The cursor rectangle in the window's geometry (what the shell shows).
+    std::optional<gfx::Rect> caret;
+  };
+
+  struct Key {
+    int id = 0;
+    int field_id = 0;
+    std::string key;   // DOM key ("a", "Escape", "ArrowLeft").
+    std::string code;  // DOM code ("KeyA").
+    int modifiers = 0;  // CDP's: Alt 1, Ctrl 2, Meta 4, Shift 8.
+    bool repeat = false;
+  };
+
+  // The helper's side (the Plutonium DevTools domain).
+  class Listener {
+   public:
+    virtual ~Listener() = default;
+    virtual void OnVimFieldChanged(const FieldState& field) = 0;
+    virtual void OnVimFieldGone(int field_id) = 0;
+    virtual void OnVimKey(const Key& key) = 0;
+  };
+
+  // A key the helper wants held in a field (in insert mode, only some are).
+  struct KeySpec {
+    std::string key;
+    int modifiers = 0;
+  };
+
+  static constexpr base::TimeDelta kAnswerTimeout = base::Milliseconds(100);
+
+  static PlutoniumVim* Get();
+
+  PlutoniumVim(const PlutoniumVim&) = delete;
+  PlutoniumVim& operator=(const PlutoniumVim&) = delete;
+
+  // The helper listens (or stops, with null): fields are announced, and
+  // keys are held, only while one does.
+  void SetListener(Listener* listener);
+
+  // From the helper: which keys to hold in |field_id|. |all|: every key but
+  // modifiers and Super's; otherwise only |keys|.
+  bool SetHold(int field_id, bool all, std::vector<KeySpec> keys);
+  // From the helper: the answer for key |key_id|.
+  void Answer(int key_id, bool consumed);
+  bool Edit(int field_id, int before, int after, const std::u16string& text);
+
+  // From WaylandTextInputV3Delegate, on each commit while enabled. |off|:
+  // vim stays out (a password, PIN, sensitive, hidden or terminal field).
+  void FieldChanged(Field* field,
+                    const std::u16string& text,
+                    int cursor,
+                    int anchor,
+                    uint32_t hint,
+                    uint32_t purpose,
+                    bool off,
+                    std::optional<gfx::Rect> caret);
+  void FieldComposing(Field* field, bool composing);
+  void FieldGone(Field* field);
+
+  // From Keyboard::OnKeyEvent(): true if Pluto Vim holds or took the key
+  // (the keyboard then stops it).
+  bool FilterKey(Surface* focus, ui::KeyEvent* event);
+
+ private:
+  friend class base::NoDestructor<PlutoniumVim>;
+
+  struct FieldEntry {
+    int id = 0;
+    bool composing = false;
+    bool off = false;  // Password, PIN, sensitive, hidden, terminal.
+    bool hold_all = false;
+    std::vector<KeySpec> hold;
+  };
+  struct Pending {
+    int key_id = 0;  // 0: queued behind the one being answered.
+    int field_id = 0;
+    int32_t window_id = 0;
+    std::unique_ptr<ui::KeyEvent> event;
+  };
+
+  PlutoniumVim();
+  ~PlutoniumVim();
+
+  FieldEntry* EntryFor(Surface* focus);
+  bool Wants(const FieldEntry& entry, const ui::KeyEvent& event) const;
+  void Send(Pending& pending);
+  void Resolve(bool consumed);
+  void Drain();
+  void Replay(Pending pending);
+
+  raw_ptr<Listener> listener_ = nullptr;
+  std::map<Field*, FieldEntry> fields_;
+  int next_field_id_ = 1;
+  int next_key_id_ = 1;
+  // The key being answered first, then the keys behind it, in order.
+  std::deque<Pending> queue_;
+  base::OneShotTimer answer_timer_;
+  // Keys the engine took whose releases and repeats go to it, not the app.
+  std::set<ui::DomCode> taken_;
+
+  base::WeakPtrFactory<PlutoniumVim> weak_factory_{this};
+};
+
+}  // namespace exo
+
+#endif  // COMPONENTS_EXO_PLUTONIUM_VIM_H_
