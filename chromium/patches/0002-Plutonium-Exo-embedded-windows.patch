+// EXO-EMBED: the page alone sizes a parked window. The client asking to be
+// maximized, minimized or restored is answered with the state as it is.
+TEST_F(ShellSurfaceTest, EmbedParkedIgnoresClientStateRequests) {
+  auto shell_surface =
+      test::ShellSurfaceBuilder({256, 256}).BuildShellSurface();
+  views::Widget* widget = shell_surface->GetWidget();
+  shell_surface->SetEmbedParked(true);
+  shell_surface->SetEmbedSize({300, 200});
+  EXPECT_EQ(gfx::Size(300, 200), widget->GetWindowBoundsInScreen().size());
+
+  shell_surface->Maximize();
+  shell_surface->root_surface()->Commit();
+  EXPECT_FALSE(widget->IsMaximized());
+  shell_surface->Minimize();
+  EXPECT_FALSE(widget->IsMinimized());
+  shell_surface->Restore();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(ash::WindowState::Get(widget->GetNativeWindow())
+                  ->IsNormalStateType());
+  EXPECT_EQ(gfx::Size(300, 200), widget->GetWindowBoundsInScreen().size());
+
+  aura::Env::GetInstance()->set_mouse_button_flags(ui::EF_LEFT_MOUSE_BUTTON);
+  EXPECT_FALSE(shell_surface->StartResize(HTBOTTOMRIGHT));
+  EXPECT_FALSE(shell_surface->StartMove());
+}
+
+// EXO-DISPLAYS: a parked window stays invisible when Ash hides and shows it,
+// as it does to demote floating windows when a window goes fullscreen on
+// their display (a shell's window opening there).
+TEST_F(ShellSurfaceTest, EmbedParkedStaysInvisibleWhenDemoted) {
+  auto shell_surface =
+      test::ShellSurfaceBuilder({256, 256}).BuildShellSurface();
+  aura::Window* window = shell_surface->GetWidget()->GetNativeWindow();
+  shell_surface->SetEmbedParked(true);
+  ASSERT_EQ(0.f, window->layer()->GetTargetOpacity());
+
+  ash::WindowState::Get(window)->DisableZOrdering(nullptr);
+  EXPECT_TRUE(window->IsVisible());
+  EXPECT_EQ(0.f, window->layer()->GetTargetOpacity());
+
+  shell_surface->SetEmbedParked(false);
+  EXPECT_EQ(1.f, window->layer()->GetTargetOpacity());
+  EXPECT_FALSE(window->GetProperty(aura::client::kAnimationsDisabledKey));
+}
+
+// EXO-EMBED: the page showing a parked window floating, or no longer
+// floating, configures it again (the client is told whether it is tiled).
+TEST_F(ShellSurfaceTest, EmbedParkedFloatingConfigures) {
+  auto shell_surface =
+      test::ShellSurfaceBuilder({256, 256}).BuildShellSurface();
+  shell_surface->SetEmbedParked(true);
+  int configures = 0;
+  shell_surface->set_configure_callback(base::BindRepeating(
+      [](int* count, const gfx::Rect&, chromeos::WindowStateType, bool, bool,
+         const gfx::Vector2d&, float, aura::Window::OcclusionState,
+         std::optional<chromeos::WindowStateType>) {
+        ++*count;
+        return uint32_t(*count);
+      },
+      &configures));
+  EXPECT_FALSE(shell_surface->embed_floating());
+
+  shell_surface->SetEmbedFloating(true);
+  EXPECT_TRUE(shell_surface->embed_floating());
+  EXPECT_EQ(1, configures);
+  shell_surface->SetEmbedFloating(true);
+  EXPECT_EQ(1, configures);
+  shell_surface->SetEmbedFloating(false);
+  EXPECT_EQ(2, configures);
+
+  // Not parked: nothing to tell the client.
+  shell_surface->SetEmbedParked(false);
+  configures = 0;
+  shell_surface->SetEmbedFloating(true);
+  EXPECT_EQ(0, configures);
+}
+
+// EXO-EMBED: a parked window that Ash maximizes anyway goes back to the
+// normal state at the page's size.
+TEST_F(ShellSurfaceTest, EmbedParkedUndoesServerStateChanges) {
+  auto shell_surface =
+      test::ShellSurfaceBuilder({256, 256}).BuildShellSurface();
+  views::Widget* widget = shell_surface->GetWidget();
+  shell_surface->SetEmbedParked(true);
+  shell_surface->SetEmbedSize({300, 200});
+
+  ash::WMEvent maximize_event(ash::WM_EVENT_TOGGLE_MAXIMIZE);
+  ash::WindowState::Get(widget->GetNativeWindow())->OnWMEvent(&maximize_event);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(widget->IsMaximized());
+  EXPECT_EQ(gfx::Size(300, 200), widget->GetWindowBoundsInScreen().size());
+
+  // So is a server-side resize.
+  widget->SetBounds(gfx::Rect(widget->GetWindowBoundsInScreen().origin(),
+                              gfx::Size(500, 400)));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(gfx::Size(300, 200), widget->GetWindowBoundsInScreen().size());
+
+  // Once unparked, Ash's window management applies again.
+  shell_surface->SetEmbedParked(false);
+  shell_surface->Maximize();
+  EXPECT_TRUE(widget->IsMaximized());
+}
+
+// EXO-EMBED: a parked window may be bigger than the work area when the page
+// shows it so.
+TEST_F(ShellSurfaceTest, EmbedParkedNotClampedToWorkArea) {
+  const gfx::Size display_size = GetContext()->bounds().size();
+  const gfx::Size size(display_size.width() + 100,
+                       display_size.height() + 100);
+  auto shell_surface =
+      test::ShellSurfaceBuilder({256, 256}).BuildShellSurface();
+  views::Widget* widget = shell_surface->GetWidget();
+  shell_surface->SetEmbedParked(true);
+  shell_surface->SetEmbedSize(size);
+
+  // The client commits at the size it was asked for.
+  auto buffer = test::ExoTestHelper::CreateBuffer(size);
+  shell_surface->root_surface()->Attach(buffer.get());
+  shell_surface->root_surface()->Commit();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(size, widget->GetWindowBoundsInScreen().size());
+}
+
+// EXO-EMBED: a parked window's popups show only while a page shows the
+// window: otherwise they're invisible, take no input and hold no grab.
+TEST_F(ShellSurfaceTest, EmbedParkedPopupsHiddenUnlessShown) {
+  auto shell_surface =
+      test::ShellSurfaceBuilder({256, 256}).BuildShellSurface();
+  shell_surface->SetEmbedParked(true);
+
+  // Opened while the window is shown nowhere.
+  auto popup = test::ShellSurfaceBuilder({100, 100})
+                   .SetAsPopup()
+                   .SetParent(shell_surface.get())
+                   .SetGrab()
+                   .BuildShellSurface();
+  aura::Window* popup_window = popup->GetWidget()->GetNativeWindow();
+  EXPECT_EQ(0.f, popup_window->layer()->GetTargetOpacity());
+  EXPECT_EQ(aura::EventTargetingPolicy::kNone,
+            popup_window->event_targeting_policy());
+  EXPECT_FALSE(popup->GetWidget()->HasCapture());
+
+  // A page shows it: the popup shows and grabs.
+  shell_surface->SetEmbedShown(true, 1.f);
+  EXPECT_EQ(1.f, popup_window->layer()->GetTargetOpacity());
+  EXPECT_EQ(aura::EventTargetingPolicy::kTargetAndDescendants,
+            popup_window->event_targeting_policy());
+  EXPECT_TRUE(popup->GetWidget()->HasCapture());
+
+  // It moves with its parent.
+  const gfx::Point origin =
+      popup->GetWidget()->GetWindowBoundsInScreen().origin();
+  const gfx::Point parent_origin =
+      shell_surface->host_window()->GetBoundsInScreen().origin();
+  shell_surface->MoveEmbedOrigin(
+      gfx::PointF(parent_origin + gfx::Vector2d(30, 20)));
+  EXPECT_EQ(origin + gfx::Vector2d(30, 20),
+            popup->GetWidget()->GetWindowBoundsInScreen().origin());
+
+  // Shown at half size: scaled about the window geometry's origin.
+  shell_surface->SetEmbedShown(true, 0.5f);
+  const gfx::Point anchor =
+      shell_surface->host_window()->GetBoundsInScreen().origin() +
+      shell_surface->GetEmbedGeometry().OffsetFromOrigin();
+  const gfx::Vector2d to_anchor =
+      anchor - popup->GetWidget()->GetWindowBoundsInScreen().origin();
+  const gfx::PointF local_anchor(to_anchor.x(), to_anchor.y());
+  EXPECT_EQ(local_anchor, popup_window->transform().MapPoint(local_anchor));
+  EXPECT_EQ(local_anchor + gfx::Vector2dF(5, 10),
+            popup_window->transform().MapPoint(local_anchor +
+                                               gfx::Vector2dF(10, 20)));
+  shell_surface->SetEmbedShown(true, 1.f);
+  EXPECT_TRUE(popup_window->transform().IsIdentity());
+
+  // Shown nowhere again (e.g. another thread): hidden, still open.
+  shell_surface->SetEmbedShown(false, 1.f);
+  EXPECT_EQ(0.f, popup_window->layer()->GetTargetOpacity());
+  EXPECT_FALSE(popup->GetWidget()->HasCapture());
+  EXPECT_FALSE(popup->GetWidget()->IsClosed());
+
+  // On the desktop, popups are as usual.
+  shell_surface->SetEmbedParked(false);
+  EXPECT_EQ(1.f, popup_window->layer()->GetTargetOpacity());
+}
+
 }  // namespace exo
