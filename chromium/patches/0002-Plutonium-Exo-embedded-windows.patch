+void DataOffer::AddSourceMimeTypes(DataSource* source) {
+  if (!delegate_ || !source) {
+    return;
+  }
+  for (const std::string& mime_type : source->mime_types()) {
+    if (data_callbacks_.contains(mime_type) ||
+        data_cache_.contains(mime_type)) {
+      continue;
+    }
+    auto callback = base::BindOnce(
+        [](base::WeakPtr<DataSource> source, const std::string& mime_type,
+           DataOffer::SendDataCallback callback) {
+          if (!source) {
+            std::move(callback).Run(nullptr);
+            return;
+          }
+          auto [on_data, on_failure] =
+              base::SplitOnceCallback(std::move(callback));
+          source->ReadRawData(
+              mime_type,
+              base::BindOnce(
+                  [](DataOffer::SendDataCallback callback, const std::string&,
+                     const std::vector<uint8_t>& data) {
+                    std::move(callback).Run(
+                        base::MakeRefCounted<base::RefCountedBytes>(data));
+                  },
+                  std::move(on_data)),
+              base::BindOnce(
+                  [](DataOffer::SendDataCallback callback) {
+                    std::move(callback).Run(nullptr);
+                  },
+                  std::move(on_failure)));
+        },
+        source->GetWeakPtr(), mime_type);
+    data_callbacks_.emplace(mime_type, std::move(callback));
+    delegate_->OnOffer(mime_type);
+  }
+}
