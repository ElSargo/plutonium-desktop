+void toplevel_icon_set_name(wl_client* client,
+                            wl_resource* resource,
+                            const char* icon_name) {
+  auto* icon = GetUserDataAs<WaylandToplevelIcon>(resource);
+  if (icon->immutable) {
+    wl_resource_post_error(resource, XDG_TOPLEVEL_ICON_V1_ERROR_IMMUTABLE,
+                           "the icon was set on a toplevel");
+    return;
+  }
+  icon->name = icon_name;
+}
+
+void toplevel_icon_add_buffer(wl_client* client,
+                              wl_resource* resource,
+                              wl_resource* buffer_resource,
+                              int32_t scale) {
+  auto* icon = GetUserDataAs<WaylandToplevelIcon>(resource);
+  if (icon->immutable) {
+    wl_resource_post_error(resource, XDG_TOPLEVEL_ICON_V1_ERROR_IMMUTABLE,
+                           "the icon was set on a toplevel");
+    return;
+  }
+  SkBitmap bitmap = ReadIconBuffer(GetUserDataAs<Buffer>(buffer_resource));
+  if (bitmap.drawsNothing()) {
+    wl_resource_post_error(resource, XDG_TOPLEVEL_ICON_V1_ERROR_INVALID_BUFFER,
+                           "not a square wl_shm buffer");
+    return;
+  }
+  icon->bitmaps[{bitmap.width(), scale}] = std::move(bitmap);
+}
