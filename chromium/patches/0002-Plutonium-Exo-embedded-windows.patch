+
+void ShellSurfaceBase::SetEmbedParked(bool parked) {
+  if (embed_parked_ == parked || !widget_) {
+    return;
+  }
+  embed_parked_ = parked;
+  aura::Window* window = widget_->GetNativeWindow();
+  if (parked) {
+    embed_saved_can_activate_ = CanActivate();
+    if (widget_->IsActive()) {
+      widget_->Deactivate();
+    }
+    SetCanActivate(false);
+    auto* window_state = ash::WindowState::Get(window);
+    // EXO-FULLSCREEN: a fullscreen window goes on asking for it; its element
+    // is made fullscreen once it shows the window.
+    if (window_state && window_state->IsFullscreen()) {
+      embed_fullscreen_requested_ = true;
+    }
+    if (window_state && (window_state->IsMaximizedOrFullscreenOrPinned() ||
+                         window_state->IsSnapped() ||
+                         window_state->IsMinimized())) {
+      window_state->Restore();
+    }
+    // The page places and sizes a parked window (its element may fill the
+    // screen): Ash must not fit it to the work area.
+    if (window_state) {
+      embed_saved_bounds_direct_ = window_state->allow_set_bounds_direct();
+      window_state->set_allow_set_bounds_direct(true);
+    }
+    embed_saved_origin_ = widget_->GetWindowBoundsInScreen().origin();
+    embed_saved_frame_type_ = frame_type_;
+    if (frame_type_ != SurfaceFrameType::NONE) {
+      OnSetFrame(SurfaceFrameType::NONE);
+    }
+    // EXO-DISPLAYS: opacity 0 is all that hides it, and a show animation
+    // ends at opacity 1. Ash hides and shows a floating window to demote it
+    // when a window goes fullscreen on its display (a shell's window opening
+    // there): it would then be drawn above the page, square and taking no
+    // input. No animations while parked.
+    embed_saved_animations_disabled_ =
+        window->GetProperty(aura::client::kAnimationsDisabledKey);
+    window->SetProperty(aura::client::kAnimationsDisabledKey, true);
+    // Popups go into their parent's container, so park above normal windows
+    // for them to show above the page.
+    embed_saved_z_order_ = widget_->GetZOrderLevel();
+    widget_->SetZOrderLevel(ui::ZOrderLevel::kFloatingWindow);
+    window->layer()->SetOpacity(0.f);
+    window->SetEventTargetingPolicy(aura::EventTargetingPolicy::kNone);
+    // An invisible window must not hide the page (e.g. a fullscreen game
+    // marking the shell's WebContents occluded, which stops its input).
+    window->SetOpaqueRegionsForOcclusion({});
+    UpdateHostWindowOpaqueRegion();
+  } else {
+    // Keep the size the page gave it (the size from before parking may
+    // predate the client's first full-size commit), read before the
+    // container change below can clamp it.
+    const gfx::Rect bounds(embed_saved_origin_,
+                           widget_->GetWindowBoundsInScreen().size());
+    window->layer()->SetOpacity(1.f);
+    window->SetProperty(aura::client::kAnimationsDisabledKey,
+                        embed_saved_animations_disabled_);
+    window->SetEventTargetingPolicy(
+        aura::EventTargetingPolicy::kTargetAndDescendants);
+    if (auto* window_state = ash::WindowState::Get(window)) {
+      window_state->set_allow_set_bounds_direct(embed_saved_bounds_direct_);
+    }
+    if (embed_saved_frame_type_ != frame_type_) {
+      OnSetFrame(embed_saved_frame_type_);
+    }
+    widget_->SetZOrderLevel(embed_saved_z_order_);
+    SetCanActivate(embed_saved_can_activate_);
+    widget_->SetBounds(bounds);
+    embed_size_.reset();
+    UpdateEmbedCoversDisplay(gfx::Size());
+    UpdateHostWindowOpaqueRegion();
+    UpdateShadow();
+    embed_fullscreen_ = false;
+    // EXO-FULLSCREEN: on the desktop, a window that wants fullscreen gets
+    // the real thing.
+    if (embed_fullscreen_requested_) {
+      embed_fullscreen_requested_ = false;
+      widget_->SetFullscreen(true);
+    }
+  }
+  UpdateEmbedPopups();
+  OnEmbedStateChanged();
+}
