+viz::FrameSinkId EmbeddedWindows::GetFrameSinkId(int32_t window_id) const {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  if (!shell_surface || !shell_surface->host_window()) {
+    return viz::FrameSinkId();
+  }
+  return shell_surface->host_window()->GetFrameSinkId();
+}
+
+int32_t EmbeddedWindows::GetWindowIdForFrameSink(
+    const viz::FrameSinkId& frame_sink_id) const {
+  if (!frame_sink_id.is_valid()) {
+    return 0;
+  }
+  for (const auto& [id, entry] : windows_) {
+    if (entry.shell_surface->host_window() &&
+        entry.shell_surface->host_window()->GetFrameSinkId() == frame_sink_id) {
+      return id;
+    }
+  }
+  return 0;
+}
