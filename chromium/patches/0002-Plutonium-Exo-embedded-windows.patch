+    gfx::Size min_size;
+    gfx::Size max_size;
+    float device_scale_factor = 1.f;
+    std::string app_id;
+    std::u16string title;
+    // PLUTONIUM: the app's icon (xdg_toplevel_icon_v1), see
+    // ShellSurfaceBase::SetToplevelIcon().
+    std::string icon_name;
+    std::string icon_url;
+    // Whether the window has embedded keyboard focus.
+    bool focused = false;
+    // EXO-BROKER: whether at least one page element is attached (the window
+    // is parked).
+    bool attached = false;
+    // EXO-BROKER: pid of the client (0 if unknown).
+    int32_t client_pid = 0;
+    // EXO-PRESENT: whether Present() shows it.
+    bool presented = false;
+    // EXO-PRESENT: whether it is on the desktop (not parked): popped out, or
+    // presented.
+    bool on_desktop = false;
+  };
+
+  // EXO-EMBED: what the app asked for while its window is shown in a page.
+  // The page decides (the app is answered with its state unchanged).
+  enum class Request { kMaximize, kUnmaximize, kMinimize, kMove, kResize };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // Title, app id, geometry, surface, focus or attachment changed. The
+    // first call for a window with a valid GetInfo() is when it becomes
+    // embeddable (it has a surface).
+    virtual void OnEmbeddedWindowChanged(int32_t window_id) {}
+    virtual void OnEmbeddedWindowDestroyed(int32_t window_id) {}
+    // EXO-AGENT: the app committed a frame (for those watching it draw).
+    virtual void OnEmbeddedWindowCommitted(int32_t window_id) {}
+    // EXO-FULLSCREEN: the app asked to enter or leave fullscreen while its
+    // window is parked (its elements decide).
+    virtual void OnEmbeddedWindowFullscreenRequested(int32_t window_id,
+                                                     bool fullscreen) {}
+    // |component| is the window edge or corner to resize from (a
+    // ui/base/hit_test.h value) for kResize, else HTNOWHERE.
+    virtual void OnEmbeddedWindowRequested(int32_t window_id,
+                                           Request request,
+                                           int component) {}
+    // EXO-ACTIVATION: the app asked, with a valid xdg_activation token, for
+    // the window to be shown and focused.
+    virtual void OnEmbeddedWindowActivationRequested(int32_t window_id) {}
+  };
+
+  // Receives the app's cursor while the pointer is over its embedded surface.
+  using CursorCallback =
