+void EmbeddedWindows::Snapshot(int32_t window_id, SnapshotCallback callback) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  aura::Window* host_window =
+      shell_surface ? shell_surface->host_window() : nullptr;
+  if (!host_window) {
+    std::move(callback).Run(SkBitmap());
+    return;
+  }
+  // The host window's layer shows the client's whole surface tree. A copy
+  // request makes the compositor draw it even under the parked window's zero
+  // opacity, and the copy is taken before that opacity applies.
+  const float scale = host_window->layer()->device_scale_factor();
+  const gfx::Rect geometry =
+      gfx::ScaleToEnclosingRect(shell_surface->GetEmbedGeometry(), scale);
+  // EXO-AGENT: and its popups' (menus), drawn over it where they are, so an
+  // agent sees an open menu. The image grows right and down to hold them.
+  // Each layer's bounds in the window's surface, physical pixels.
+  std::vector<aura::Window*> layers = {host_window};
+  std::vector<gfx::Rect> bounds = {gfx::Rect()};
+  for (const auto& [popup, offset] : shell_surface->GetAgentPopups()) {
+    layers.push_back(popup->host_window());
+    bounds.push_back(gfx::ScaleToEnclosingRect(
+        gfx::Rect(gfx::PointAtOffsetFromOrigin(offset),
+                  popup->host_window()->bounds().size()),
+        scale));
+  }
+  using Copy = std::pair<size_t, SkBitmap>;
+  auto barrier = base::BarrierCallback<Copy>(
+      layers.size(),
+      base::BindOnce(
+          [](const gfx::Rect& geometry, std::vector<gfx::Rect> bounds,
+             SnapshotCallback callback, std::vector<Copy> copies) {
+            std::ranges::sort(copies, {}, &Copy::first);
+            SkBitmap bitmap = copies[0].second;
+            if (bitmap.drawsNothing()) {
+              std::move(callback).Run(SkBitmap());
+              return;
+            }
+            // Without client-side shadows.
+            gfx::Rect crop = geometry;
+            crop.Intersect(gfx::Rect(bitmap.width(), bitmap.height()));
+            SkBitmap cropped;
+            if (!crop.IsEmpty() &&
+                bitmap.extractSubset(&cropped,
+                                     SkIRect::MakeXYWH(crop.x(), crop.y(),
+                                                       crop.width(),
+                                                       crop.height()))) {
+              bitmap = cropped;
+            } else {
+              crop = gfx::Rect(bitmap.width(), bitmap.height());
+            }
+            if (copies.size() == 1) {
+              std::move(callback).Run(bitmap);
+              return;
+            }
+            gfx::Rect extent(crop.size());
+            for (size_t i = 1; i < copies.size(); ++i) {
+              gfx::Rect popup = bounds[i] - crop.OffsetFromOrigin();
+              popup.Intersect(gfx::Rect(popup.right(), popup.bottom()));
+              extent.Union(popup);
+            }
+            SkBitmap composed;
+            if (!composed.tryAllocPixels(bitmap.info().makeWH(
+                    extent.width(), extent.height()))) {
+              std::move(callback).Run(bitmap);
+              return;
+            }
+            composed.eraseColor(SK_ColorTRANSPARENT);
+            SkCanvas canvas(composed);
+            canvas.drawImage(bitmap.asImage(), 0, 0);
+            for (size_t i = 1; i < copies.size(); ++i) {
+              if (copies[i].second.drawsNothing()) {
+                continue;
+              }
+              // A shown popup scaled with its window copies at that scale.
+              const gfx::Rect popup = bounds[i] - crop.OffsetFromOrigin();
+              canvas.drawImageRect(
+                  copies[i].second.asImage(),
+                  SkRect::MakeXYWH(popup.x(), popup.y(), popup.width(),
+                                   popup.height()),
+                  SkSamplingOptions(SkFilterMode::kLinear));
+            }
+            std::move(callback).Run(composed);
+          },
+          geometry, std::move(bounds), std::move(callback)));
+  for (size_t i = 0; i < layers.size(); ++i) {
+    auto request = std::make_unique<viz::CopyOutputRequest>(
+        viz::CopyOutputRequest::ResultFormat::RGBA,
+        viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+        base::BindOnce(
+            [](size_t index, base::RepeatingCallback<void(Copy)> done,
+               std::unique_ptr<viz::CopyOutputResult> result) {
+              SkBitmap bitmap;
+              if (!result->IsEmpty()) {
+                auto scoped = result->ScopedAccessSkBitmap();
+                bitmap = scoped.GetOutScopedBitmap();
+              }
+              done.Run(Copy(index, std::move(bitmap)));
+            },
+            i, barrier));
+    request->set_result_task_runner(
+        base::SequencedTaskRunner::GetCurrentDefault());
+    layers[i]->layer()->RequestCopyOfOutput(std::move(request));
+  }
+}
+
+std::vector<gfx::Rect> EmbeddedWindows::GetPopupBounds(
+    int32_t window_id) const {
+  std::vector<gfx::Rect> bounds;
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  if (!shell_surface) {
+    return bounds;
+  }
+  const gfx::Vector2d origin =
+      shell_surface->GetEmbedGeometry().OffsetFromOrigin();
+  for (const auto& [popup, offset] : shell_surface->GetAgentPopups()) {
+    gfx::Rect rect = popup->GetEmbedGeometry();
+    if (rect.IsEmpty()) {
+      continue;
+    }
+    rect.Offset(offset - origin);
+    bounds.push_back(rect);
+  }
+  return bounds;
+}
+
+void EmbeddedWindows::Focus(int32_t window_id, aura::Window* owner) {
+  // EXO-MODAL: focus on a window with a modal dialog goes to the dialog.
+  if (IsAttached(window_id)) {
+    window_id = ModalFocusTarget(window_id);
+  }
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  // EXO-BROKER: only windows a page element is attached to (which takes a
+  // grant) can get embedded keyboard focus.
+  if (!shell_surface || !owner || !shell_surface->root_surface() ||
+      !IsAttached(window_id) || window_id == presented_window_id_) {
+    return;
+  }
+  if (focused_window_id_ == window_id && focus_owner_ == owner) {
+    return;
+  }
+  int32_t old_window_id = focused_window_id_;
+  if (focus_owner_ && focus_owner_ != owner) {
+    focus_owner_->RemoveObserver(this);
+  }
+  if (focus_owner_ != owner) {
+    owner->AddObserver(this);
+  }
+  focused_window_id_ = window_id;
+  focus_owner_ = owner;
+  if (ShellSurfaceBase* old = FindShellSurface(old_window_id);
+      old && old_window_id != window_id) {
+    old->SetEmbedFocused(false);
+  }
+  shell_surface->SetEmbedFocused(true);
+  SetSeatsFocus(shell_surface->root_surface(), owner);
+  NotifyIfChanged(old_window_id);
+  NotifyIfChanged(window_id);
+}
+
+void EmbeddedWindows::Blur(int32_t window_id) {
+  if (window_id && window_id == focused_window_id_) {
+    ClearFocus();
+  }
+}
+
+void EmbeddedWindows::ClearFocus() {
+  if (!focused_window_id_) {
+    return;
+  }
+  int32_t old_window_id = focused_window_id_;
+  if (focus_owner_) {
+    focus_owner_->RemoveObserver(this);
+  }
+  focused_window_id_ = 0;
+  focus_owner_ = nullptr;
+  SetSeatsFocus(nullptr, nullptr);
+  if (ShellSurfaceBase* old = FindShellSurface(old_window_id)) {
+    old->SetEmbedFocused(false);
+  }
+  NotifyIfChanged(old_window_id);
+}
+
+void EmbeddedWindows::DispatchMouseEvent(const viz::FrameSinkId& frame_sink_id,
+                                         const gfx::PointF& location,
+                                         const gfx::PointF& screen_location,
+                                         std::unique_ptr<ui::MouseEvent> event) {
+  int32_t window_id = GetWindowIdForFrameSink(frame_sink_id);
+  if (event->type() == ui::EventType::kMousePressed) {
+    VLOG(1) << "EXO-EMBED press for sink " << frame_sink_id.ToString()
+            << " -> window #" << window_id << " at " << location.ToString();
+  }
+  // EXO-BROKER: input is only injected into attached windows (EXO-PRESENT:
+  // a presented one gets its own).
+  if (!window_id || !IsAttached(window_id) ||
+      window_id == presented_window_id_) {
+    return;
+  }
+  // Post so we don't re-enter the dispatcher that is delivering the original
+  // event to the browser window.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&EmbeddedWindows::DoDispatchMouseEvent,
+                     base::Unretained(this), window_id, location,
+                     screen_location, std::move(event),
+                     /*from_agent=*/false));
+}
+
+void EmbeddedWindows::DoDispatchMouseEvent(
+    int32_t window_id,
+    const gfx::PointF& location,
+    const gfx::PointF& screen_location,
+    std::unique_ptr<ui::MouseEvent> event,
+    bool from_agent) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  // Detached since the event was posted?
+  if (!shell_surface || (!from_agent && !IsAttached(window_id))) {
+    return;
+  }
+  aura::Window* host_window = shell_surface->host_window();
+  if (!host_window || !host_window->GetHost() ||
+      !shell_surface->root_surface()) {
+    return;
+  }
+
+  // Keep the parked window where the page shows it, so popups (positioned
+  // relative to their parent) open next to the element. Not while dragging,
+  // nor when the page shows it scaled (|location| is unscaled; SetShown()
+  // places it then).
+  if (!from_agent && shell_surface->embed_scale() == 1.f &&
+      (!(event->flags() & kMouseButtonFlags) ||
+       event->type() == ui::EventType::kMousePressed)) {
+    shell_surface->MoveEmbedOrigin(screen_location -
+                                   location.OffsetFromOrigin());
+  }
+
+  if (!from_agent && event->type() == ui::EventType::kMousePressed) {
+    Focus(window_id, WMHelper::GetInstance()->GetFocusedWindow());
+  }
+
+  // EXO-AGENT: the agent's pointer reaches the window's popups (menus) as
+  // the user's does.
+  Surface* root_surface = shell_surface->root_surface();
+  gfx::PointF location_in_host = location;
+  if (from_agent) {
+    if (agent_dismissed_.contains(window_id) &&
+        event->type() == ui::EventType::kMouseReleased) {
+      agent_dismissed_.erase(window_id);
+      return;
+    }
+    bool on_popup = false;
+    const auto popups = shell_surface->GetAgentPopups();
+    for (auto it = popups.rbegin(); it != popups.rend(); ++it) {
+      const auto& [popup, offset] = *it;
+      const gfx::PointF local = location - gfx::Vector2dF(offset);
+      aura::Window* hit = popup->host_window()->GetEventHandlerForPoint(
+          gfx::ToFlooredPoint(local));
+      if (hit && hit != popup->host_window() && Surface::AsSurface(hit) &&
+          popup->root_surface()) {
+        host_window = popup->host_window();
+        root_surface = popup->root_surface();
+        location_in_host = local;
+        on_popup = true;
+        break;
+      }
+    }
+    if (!on_popup && event->type() == ui::EventType::kMousePressed &&
+        shell_surface->DismissAgentPopups()) {
+      agent_dismissed_.insert(window_id);
+      return;
+    }
+  }
+
+  // Deepest window (sub-surface) under the point, else the root surface.
+  aura::Window* target = host_window->GetEventHandlerForPoint(
+      gfx::ToFlooredPoint(location_in_host));
+  if (!target || target == host_window) {
+    target = root_surface->window();
+  }
+  gfx::PointF local = location_in_host;
+  aura::Window::ConvertPointToTarget(host_window, target, &local);
+  gfx::PointF root = location_in_host;
+  aura::Window::ConvertPointToTarget(host_window, host_window->GetRootWindow(),
+                                     &root);
+  event->set_location_f(local);
+  event->set_root_location_f(root);
+  event->SetProperties(
+      {{kEmbeddedEventKey, {}}, {wm::kSkipCursorUpdateEventKey, {}}});
+  const bool pressed = event->type() == ui::EventType::kMousePressed ||
+                       event->type() == ui::EventType::kMouseReleased;
+  Dispatch(target, event.get());
+  if (pressed) {
+    aura::Window* capture = aura::client::GetCaptureWindow(
+        host_window->GetRootWindow());
+    VLOG(1) << "EXO-EMBED dispatched press/release; capture="
+            << (capture ? capture->GetName() : std::string("none"))
+            << " parked_capture=" << (capture && capture == target);
+  }
+}
+
+bool EmbeddedWindows::InjectMouseEvent(int32_t window_id,
+                                       const gfx::PointF& location,
+                                       std::unique_ptr<ui::MouseEvent> event) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  if (!shell_surface || !shell_surface->host_window() ||
+      !shell_surface->host_window()->GetHost() ||
+      !shell_surface->root_surface()) {
+    return false;
+  }
+  const gfx::PointF in_surface =
+      location + shell_surface->GetEmbedGeometry().OffsetFromOrigin();
+  DoDispatchMouseEvent(window_id, in_surface, gfx::PointF(), std::move(event),
+                       /*from_agent=*/true);
+  return true;
+}
+
+base::ScopedClosureRunner EmbeddedWindows::KeepDrawing(int32_t window_id) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  if (!shell_surface) {
+    return base::ScopedClosureRunner();
+  }
+  if (keep_drawing_[window_id]++ == 0) {
+    shell_surface->set_may_throttle_if_undrawn_frames(false);
+  }
+  return base::ScopedClosureRunner(base::BindOnce(
+      // The instance lives as long as the process.
+      [](EmbeddedWindows* self, int32_t window_id) {
+        auto it = self->keep_drawing_.find(window_id);
+        if (it == self->keep_drawing_.end() || --it->second > 0) {
+          return;
+        }
+        self->keep_drawing_.erase(it);
+        if (ShellSurfaceBase* shell_surface =
+                self->FindShellSurface(window_id)) {
+          shell_surface->set_may_throttle_if_undrawn_frames(true);
+        }
+      },
+      base::Unretained(this), window_id));
+}
+
+int32_t EmbeddedWindows::WindowIdForSurface(const Surface* surface) const {
+  if (!surface) {
+    return 0;
+  }
+  for (const auto& [window_id, entry] : windows_) {
+    if (entry.shell_surface && entry.shell_surface->root_surface() == surface) {
+      return window_id;
+    }
+  }
+  return 0;
+}
+
+bool EmbeddedWindows::InjectKeyEvents(
+    int32_t window_id,
+    std::vector<std::unique_ptr<ui::KeyEvent>> events) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  Surface* surface =
+      shell_surface ? shell_surface->root_surface() : nullptr;
+  if (!surface || seats_.empty()) {
+    return false;
+  }
+  // The window's client focuses it, beside the user's focus elsewhere
+  // (Seat::AddAgentFocus()): for these keys, or for as long as
+  // HoldAgentFocus() holds it.
+  for (Seat* seat : seats_) {
+    seat->AddAgentFocus(surface);
+  }
+  // The user's focus is in another of the client's windows: the window has
+  // the seat's focus for these keys instead, standing in for the focused aura
+  // window (as a page's view does for the window it shows), and whatever had
+  // it gets it back.
+  aura::Window* owner = WMHelper::GetInstance()->GetFocusedWindow();
+  const bool borrow = !seats_.front()->IsKeyboardFocusedOn(surface);
+  if (borrow) {
+    if (!owner) {
+      ReleaseAgentFocus(window_id, surface);
+      return false;
+    }
+    SetSeatsFocus(surface, owner);
+  }
+  for (std::unique_ptr<ui::KeyEvent>& event : events) {
+    for (Seat* seat : seats_) {
+      seat->DispatchAgentKeyEvent(event.get(), surface);
+    }
+  }
+  if (borrow) {
+    // Back to the page's embedded window, or to whatever aura focus means.
+    ShellSurfaceBase* focused = FindShellSurface(focused_window_id_);
+    SetSeatsFocus(focused && focus_owner_ ? focused->root_surface() : nullptr,
+                  focus_owner_);
+  }
+  ReleaseAgentFocus(window_id, surface);
+  return true;
+}
+
+std::vector<EmbeddedWindows::TypedChar> EmbeddedWindows::GetTypedChars()
+    const {
+  std::vector<TypedChar> chars;
+  if (seats_.empty()) {
+    return chars;
+  }
+  for (const XkbTracker::TypedChar& typed :
+       seats_.front()->xkb_tracker()->GetTypedChars()) {
+    const ui::DomCode code = ui::KeycodeConverter::NativeKeycodeToDomCode(
+        static_cast<int>(typed.xkb_keycode));
+    if (code == ui::DomCode::NONE) {
+      continue;
+    }
+    chars.push_back({typed.character,
+                     ui::KeycodeConverter::DomCodeToCodeString(code),
+                     typed.flags});
+  }
+  return chars;
+}
+
+std::string EmbeddedWindows::GetKeymap() const {
+  return seats_.empty() ? std::string()
+                        : seats_.front()->xkb_tracker()->GetKeymapText();
+}
+
+bool EmbeddedWindows::SetAgentKeymap(
+    int32_t window_id,
+    const std::optional<std::string>& keymap) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  Surface* surface = shell_surface ? shell_surface->root_surface() : nullptr;
+  if (!surface) {
+    return false;
+  }
+  for (Seat* seat : seats_) {
+    seat->SetAgentKeymap(surface, keymap ? &*keymap : nullptr);
+  }
+  return true;
+}
+
+base::ScopedClosureRunner EmbeddedWindows::HoldAgentFocus(int32_t window_id) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  Surface* surface = shell_surface ? shell_surface->root_surface() : nullptr;
+  if (!surface) {
+    return base::ScopedClosureRunner();
+  }
+  if (agent_focus_holds_[window_id]++ == 0) {
+    for (Seat* seat : seats_) {
+      seat->AddAgentFocus(surface);
+    }
+  }
+  return base::ScopedClosureRunner(base::BindOnce(
+      // The instance lives as long as the process.
+      [](EmbeddedWindows* self, int32_t window_id) {
+        auto it = self->agent_focus_holds_.find(window_id);
+        if (it == self->agent_focus_holds_.end() || --it->second > 0) {
+          return;
+        }
+        self->agent_focus_holds_.erase(it);
+        ShellSurfaceBase* shell_surface = self->FindShellSurface(window_id);
+        if (shell_surface && shell_surface->root_surface()) {
+          self->ReleaseAgentFocus(window_id, shell_surface->root_surface());
+        }
+      },
+      base::Unretained(this), window_id));
+}
+
+void EmbeddedWindows::ReleaseAgentFocus(int32_t window_id, Surface* surface) {
+  if (agent_focus_holds_.contains(window_id)) {
+    return;
+  }
+  for (Seat* seat : seats_) {
+    seat->RemoveAgentFocus(surface);
+  }
+}
+
+void EmbeddedWindows::PointerLeave(const viz::FrameSinkId& frame_sink_id) {
+  int32_t window_id = GetWindowIdForFrameSink(frame_sink_id);
+  if (!window_id) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](int32_t window_id) {
+                       ShellSurfaceBase* shell_surface =
+                           EmbeddedWindows::Get()->FindShellSurface(window_id);
+                       if (!shell_surface || !shell_surface->root_surface()) {
+                         return;
+                       }
+                       aura::Window* target =
+                           shell_surface->root_surface()->window();
+                       ui::MouseEvent exit(ui::EventType::kMouseExited,
+                                           gfx::PointF(), gfx::PointF(),
+                                           ui::EventTimeForNow(), 0, 0);
+                       exit.SetProperties(
+                           {{kEmbeddedEventKey, {}},
+                            {kEmbeddedLeaveEventKey, {}},
+                            {wm::kSkipCursorUpdateEventKey, {}}});
+                       Dispatch(target, &exit);
+                     },
+                     window_id));
+}
+
+void EmbeddedWindows::SetCursorCallback(CursorCallback callback) {
+  cursor_callback_ = std::move(callback);
+}
+
+void EmbeddedWindows::OnToplevelCreated(ShellSurfaceBase* shell_surface) {
+  if (FindWindowId(shell_surface)) {
+    return;
+  }
+  windows_[next_window_id_++].shell_surface = shell_surface;
+  // EXO-BROKER: in the Plutonium shell, windows live in the page. They stay
+  // off the desktop from the start until ShowOnDesktop().
+  if (HideWindows()) {
+    shell_surface->SetEmbedParked(true);
+  }
+}
+
+// static
+bool EmbeddedWindows::HideWindows() {
+  static const bool hide = base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kPlutoniumHideWindowsSwitch);
+  return hide;
+}
+
+void EmbeddedWindows::OnToplevelChanged(ShellSurfaceBase* shell_surface) {
+  if (int32_t window_id = FindWindowId(shell_surface)) {
+    NotifyIfChanged(window_id);
+    // EXO-MODAL: a dialog mapped (or made modal) over the focused window.
+    if (shell_surface->modal_to_parent()) {
+      UpdateModalFocus();
+    }
+    for (Observer& observer : observers_) {
+      observer.OnEmbeddedWindowCommitted(window_id);
+    }
+  }
+}
+
+void EmbeddedWindows::OnToplevelDestroying(ShellSurfaceBase* shell_surface) {
+  int32_t window_id = FindWindowId(shell_surface);
+  if (!window_id) {
+    return;
+  }
+  // EXO-MODAL: a dialog's focus goes back to its parent, once it's gone.
+  int32_t modal_parent = 0;
+  aura::Window* owner = nullptr;
+  if (focused_window_id_ == window_id) {
+    modal_parent = FindModalParent(window_id);
+    owner = focus_owner_;
+    ClearFocus();
+  }
+  if (presented_window_id_ == window_id) {
+    presented_window_id_ = 0;
+  }
+  windows_.erase(window_id);
+  keep_drawing_.erase(window_id);
+  agent_focus_holds_.erase(window_id);
+  for (Observer& observer : observers_) {
+    observer.OnEmbeddedWindowDestroyed(window_id);
+  }
+  if (modal_parent && owner) {
+    Focus(modal_parent, owner);
+  }
+}
+
+void EmbeddedWindows::OnToplevelFullscreenRequested(
+    ShellSurfaceBase* shell_surface,
+    bool fullscreen) {
+  if (int32_t window_id = FindWindowId(shell_surface)) {
+    for (Observer& observer : observers_) {
+      observer.OnEmbeddedWindowFullscreenRequested(window_id, fullscreen);
+    }
+  }
+}
+
+void EmbeddedWindows::OnToplevelRequested(ShellSurfaceBase* shell_surface,
+                                          Request request,
+                                          int component) {
+  if (int32_t window_id = FindWindowId(shell_surface)) {
+    for (Observer& observer : observers_) {
+      observer.OnEmbeddedWindowRequested(window_id, request, component);
+    }
+  }
+}
+
+void EmbeddedWindows::RequestActivation(Surface* surface) {
+  if (!surface || !surface->window()) {
+    return;
+  }
+  ShellSurfaceBase* shell_surface =
+      GetShellSurfaceBaseForWindow(surface->window()->GetToplevelWindow());
+  int32_t window_id = shell_surface ? FindWindowId(shell_surface) : 0;
+  if (!window_id) {
+    return;
+  }
+  VLOG(1) << "EXO-ACTIVATION window #" << window_id;
+  for (Observer& observer : observers_) {
+    observer.OnEmbeddedWindowActivationRequested(window_id);
+  }
+}
+
+void EmbeddedWindows::SetFullscreen(int32_t window_id, bool fullscreen) {
+  if (ShellSurfaceBase* shell_surface = FindShellSurface(window_id)) {
+    shell_surface->SetEmbedFullscreen(fullscreen);
+  }
+}
+
+void EmbeddedWindows::SetFloating(int32_t window_id, bool floating) {
+  if (ShellSurfaceBase* shell_surface = FindShellSurface(window_id)) {
+    shell_surface->SetEmbedFloating(floating);
+  }
+}
+
+void EmbeddedWindows::SetShown(
+    int32_t window_id,
+    std::optional<gfx::PointF> geometry_origin_in_screen,
+    float scale) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  if (!shell_surface) {
+    return;
+  }
+  if (!geometry_origin_in_screen) {
+    shell_surface->SetEmbedShown(false, 1.f);
+    return;
+  }
+  // Rounding in the page's layout.
+  if (std::abs(scale - 1.f) < 0.005f) {
+    scale = 1.f;
+  }
+  // Placed first, so popups that show again are where the page is.
+  shell_surface->MoveEmbedOrigin(
+      *geometry_origin_in_screen -
+      gfx::Vector2dF(shell_surface->GetEmbedGeometry().OffsetFromOrigin()));
+  shell_surface->SetEmbedShown(true, scale);
+}
+
+bool EmbeddedWindows::IsFullscreenRequested(int32_t window_id) const {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  return shell_surface && shell_surface->embed_fullscreen_requested();
+}
+
+void EmbeddedWindows::AddSeat(Seat* seat) {
+  seats_.push_back(seat);
+}
+
+void EmbeddedWindows::RemoveSeat(Seat* seat) {
+  std::erase(seats_, seat);
+}
+
+void EmbeddedWindows::OnEmbeddedCursorChanged(Surface* surface,
+                                              const ui::Cursor& cursor) {
+  if (!cursor_callback_ || !surface || !surface->window()) {
+    return;
+  }
+  ShellSurfaceBase* shell_surface =
+      GetShellSurfaceBaseForWindow(surface->window()->GetToplevelWindow());
+  if (!shell_surface || !shell_surface->host_window()) {
+    return;
+  }
+  cursor_callback_.Run(shell_surface->host_window()->GetFrameSinkId(), cursor);
+}
+
+void EmbeddedWindows::OnWindowDestroying(aura::Window* window) {
+  if (window == focus_owner_) {
+    ClearFocus();
+  }
+}
+
+int32_t EmbeddedWindows::FindWindowId(
+    const ShellSurfaceBase* shell_surface) const {
+  for (const auto& [id, entry] : windows_) {
+    if (entry.shell_surface == shell_surface) {
+      return id;
+    }
+  }
+  return 0;
+}
+
+int32_t EmbeddedWindows::FindModalChild(int32_t window_id) const {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  if (!shell_surface || !shell_surface->GetWidget()) {
+    return 0;
+  }
+  aura::Window* window = shell_surface->GetWidget()->GetNativeWindow();
+  int32_t child = 0;
+  for (const auto& [id, entry] : windows_) {
+    if (entry.shell_surface->modal_parent() == window &&
+        entry.shell_surface->GetWidget() &&
+        entry.shell_surface->GetSurfaceId().is_valid()) {
+      child = id;
+    }
+  }
+  return child;
+}
+
+int32_t EmbeddedWindows::FindModalParent(int32_t window_id) const {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  aura::Window* parent =
+      shell_surface ? shell_surface->modal_parent() : nullptr;
+  if (!parent) {
+    return 0;
+  }
+  for (const auto& [id, entry] : windows_) {
+    if (entry.shell_surface->GetWidget() &&
+        entry.shell_surface->GetWidget()->GetNativeWindow() == parent) {
+      return id;
+    }
+  }
+  return 0;
+}
+
+int32_t EmbeddedWindows::ModalFocusTarget(int32_t window_id) const {
+  // Exo refuses parent cycles; the bound is only a guard.
+  for (int depth = 0; depth < 8; ++depth) {
+    int32_t child = FindModalChild(window_id);
+    if (!child || !IsAttached(child)) {
+      break;
+    }
+    window_id = child;
+  }
+  return window_id;
+}
+
+void EmbeddedWindows::UpdateModalFocus() {
+  if (!focused_window_id_ || !focus_owner_) {
+    return;
+  }
+  int32_t target = ModalFocusTarget(focused_window_id_);
+  if (target != focused_window_id_) {
+    Focus(target, focus_owner_);
+  }
+}
+
+void EmbeddedWindows::ClearFocusToModalParent(int32_t window_id) {
+  int32_t modal_parent = FindModalParent(window_id);
+  aura::Window* owner = focus_owner_;
+  ClearFocus();
+  if (modal_parent && owner) {
+    Focus(modal_parent, owner);
+  }
+}
+
+bool EmbeddedWindows::IsAttached(int32_t window_id) const {
+  auto it = windows_.find(window_id);
+  return it != windows_.end() && it->second.attach_count > 0;
+}
+
+ShellSurfaceBase* EmbeddedWindows::FindShellSurface(int32_t window_id) const {
+  auto it = windows_.find(window_id);
+  return it == windows_.end() ? nullptr : it->second.shell_surface.get();
+}
+
+std::optional<EmbeddedWindows::Info> EmbeddedWindows::ComputeInfo(
+    int32_t window_id) const {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  if (!shell_surface || !shell_surface->GetWidget() ||
+      !shell_surface->host_window()) {
+    return std::nullopt;
+  }
+  viz::SurfaceId surface_id = shell_surface->GetSurfaceId();
+  if (!surface_id.is_valid()) {
+    return std::nullopt;
+  }
+  Info info;
+  info.surface_id = surface_id;
+  info.geometry = shell_surface->GetEmbedGeometry();
+  info.surface_size = shell_surface->host_window()->bounds().size();
+  info.min_size = shell_surface->requested_minimum_size();
+  info.max_size = shell_surface->requested_maximum_size();
+  info.device_scale_factor =
+      shell_surface->host_window()->layer()->device_scale_factor();
+  info.app_id = shell_surface->GetEmbedName();
+  info.title = shell_surface->GetWindowTitle();
+  info.icon_name = shell_surface->toplevel_icon_name();
+  info.icon_url = shell_surface->toplevel_icon_url();
+  info.focused = focused_window_id_ == window_id;
+  info.attached = windows_.at(window_id).attach_count > 0;
+  info.presented = window_id == presented_window_id_;
+  info.on_desktop = !shell_surface->embed_parked();
+  info.client_pid =
+      shell_surface->root_surface()
+          ? shell_surface->root_surface()->GetProperty(kClientPidKey)
+          : 0;
+  return info;
+}
+
+void EmbeddedWindows::NotifyIfChanged(int32_t window_id) {
+  auto it = windows_.find(window_id);
+  if (it == windows_.end()) {
+    return;
+  }
+  std::optional<Info> info = ComputeInfo(window_id);
+  if (info == it->second.last_info) {
+    return;
+  }
+  it->second.last_info = info;
+  for (Observer& observer : observers_) {
+    observer.OnEmbeddedWindowChanged(window_id);
+  }
+}
+
+void EmbeddedWindows::SetSeatsFocus(Surface* surface, aura::Window* owner) {
+  for (Seat* seat : seats_) {
+    seat->SetEmbeddedFocus(surface, owner);
+  }
+}
+
