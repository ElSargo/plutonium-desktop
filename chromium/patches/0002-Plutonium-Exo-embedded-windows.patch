+////////////////////////////////////////////////////////////////////////////////
+// xdg_toplevel_icon_manager_v1_interface:
+
+// PLUTONIUM: the icon size asked for, in pixels; the shells show app icons
+// up to about that. A bigger buffer is scaled down to it.
+constexpr int kToplevelIconSize = 128;
+
+// An icon: a name and/or pixels, copied from the client's buffers when they
+// are added (their contents mustn't change after), by size and scale.
+struct WaylandToplevelIcon {
+  std::string name;
+  std::map<std::pair<int, int32_t>, SkBitmap> bitmaps;
+  // Set on a toplevel: it can't change any more.
+  bool immutable = false;
+};
+
+// A copy of a square wl_shm buffer's pixels, or an empty bitmap if it isn't
+// one.
+SkBitmap ReadIconBuffer(Buffer* buffer) {
+  const gfx::GpuMemoryBufferHandle& handle = buffer->gpu_memory_buffer_handle();
+  const gfx::Size size = buffer->GetSize();
+  if (handle.type != gfx::SHARED_MEMORY_BUFFER || !handle.region().IsValid() ||
+      size.IsEmpty() || size.width() != size.height()) {
+    return SkBitmap();
+  }
+  const viz::SharedImageFormat format = buffer->GetFormat();
+  const bool bgra = format == viz::SinglePlaneFormat::kBGRA_8888 ||
+                    format == viz::SinglePlaneFormat::kBGRX_8888;
+  const bool rgba = format == viz::SinglePlaneFormat::kRGBA_8888 ||
+                    format == viz::SinglePlaneFormat::kRGBX_8888;
+  if (!bgra && !rgba) {
+    return SkBitmap();
+  }
+  const bool opaque = format == viz::SinglePlaneFormat::kBGRX_8888 ||
+                      format == viz::SinglePlaneFormat::kRGBX_8888 ||
+                      buffer->alpha_is_padding();
+  base::WritableSharedMemoryMapping mapping = handle.region().Map();
+  const size_t row_bytes = static_cast<size_t>(size.width()) * 4;
+  const size_t needed =
+      handle.offset +
+      static_cast<size_t>(handle.stride) * (size.height() - 1) + row_bytes;
+  if (!mapping.IsValid() || mapping.size() < needed ||
+      handle.stride < row_bytes) {
+    return SkBitmap();
+  }
+  // wl_shm's ARGB8888 is premultiplied BGRA in memory, as N32 is here.
+  const SkImageInfo info =
+      SkImageInfo::MakeN32Premul(size.width(), size.height());
+  std::vector<uint8_t> copy(row_bytes * size.height());
+  base::span<const uint8_t> pixels =
+      base::span<const uint8_t>(mapping.GetMemoryAsSpan<uint8_t>())
+          .subspan(handle.offset);
+  base::span<uint8_t> out_pixels(copy);
+  for (int y = 0; y < size.height(); ++y) {
+    base::span<const uint8_t> in =
+        pixels.subspan(static_cast<size_t>(handle.stride) * y, row_bytes);
+    base::span<uint8_t> out = out_pixels.subspan(row_bytes * y, row_bytes);
+    for (size_t x = 0; x < row_bytes; x += 4) {
+      out[x] = bgra ? in[x] : in[x + 2];
+      out[x + 1] = in[x + 1];
+      out[x + 2] = bgra ? in[x + 2] : in[x];
+      out[x + 3] = opaque ? 255 : in[x + 3];
+    }
+  }
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(info) ||
+      !bitmap.writePixels(SkPixmap(info, copy.data(), row_bytes))) {
+    return SkBitmap();
+  }
+  bitmap.setImmutable();
+  return bitmap;
+}
+
+// The icon's pixels as a PNG data URL: the smallest at least
+// kToplevelIconSize, else the biggest; scaled down to kToplevelIconSize.
+std::string EncodeIcon(const WaylandToplevelIcon& icon) {
+  const SkBitmap* best = nullptr;
+  for (const auto& [key, bitmap] : icon.bitmaps) {
+    if (!best ||
+        (best->width() < kToplevelIconSize
+             ? bitmap.width() > best->width()
+             : bitmap.width() >= kToplevelIconSize &&
+                   bitmap.width() < best->width())) {
+      best = &bitmap;
+    }
+  }
+  if (!best) {
+    return std::string();
+  }
+  SkBitmap bitmap = *best;
+  if (bitmap.width() > kToplevelIconSize) {
+    bitmap = skia::ImageOperations::Resize(
+        bitmap, skia::ImageOperations::RESIZE_BEST, kToplevelIconSize,
+        kToplevelIconSize);
+  }
+  std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(bitmap,
+                                        /*discard_transparency=*/false);
+  if (!png) {
+    return std::string();
+  }
+  return "data:image/png;base64," + base::Base64Encode(*png);
+}
