+
+aura::Window* EmbeddedWindows::FindDropTarget(aura::Window* window,
+                                              gfx::PointF* location) {
+  // Aura's hit test finds the window showing the page. Ask viz what is drawn
+  // there: the same hit-test data that routes the pointer into the windows.
+  aura::WindowTreeHost* host = window->GetHost();
+  if (!host || !host->compositor()->context_factory()) {
+    return nullptr;
+  }
+  ui::Compositor* compositor = host->compositor();
+  viz::HostFrameSinkManager* manager =
+      compositor->context_factory()->GetHostFrameSinkManager();
+  if (!manager) {
+    return nullptr;
+  }
+  const auto& queries = manager->GetDisplayHitTestQuery();
+  auto it = queries.find(compositor->frame_sink_id());
+  if (it == queries.end() || !it->second) {
+    return nullptr;
+  }
+  // Start from |window|'s own frame sink (the page), as the browser's input
+  // router does: from the display root, a native window's parked copy in
+  // Ash's window tree can be hit instead, with its own (stale) offset.
+  if (!window->GetFrameSinkId().is_valid()) {
+    return nullptr;
+  }
+  const float scale = compositor->device_scale_factor();
+  viz::Target target = it->second->FindTargetForLocationStartingFrom(
+      viz::EventSource::MOUSE, gfx::ScalePoint(*location, scale),
+      window->GetFrameSinkId());
+  const int32_t window_id = GetWindowIdForFrameSink(target.frame_sink_id);
+  if (!window_id || !IsAttached(window_id)) {
+    return nullptr;
+  }
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  aura::Window* host_window =
+      shell_surface ? shell_surface->host_window() : nullptr;
+  if (!host_window || host_window == window ||
+      !shell_surface->root_surface()) {
+    return nullptr;
+  }
+  // As in DoDispatchMouseEvent(): the deepest sub-surface under the point.
+  gfx::PointF point = gfx::ScalePoint(target.location_in_target, 1.f / scale);
+  aura::Window* drop =
+      host_window->GetEventHandlerForPoint(gfx::ToFlooredPoint(point));
+  if (!drop || drop == host_window) {
+    drop = shell_surface->root_surface()->window();
+  }
+  aura::Window::ConvertPointToTarget(host_window, drop, &point);
+  *location = point;
+  return drop;
+}
