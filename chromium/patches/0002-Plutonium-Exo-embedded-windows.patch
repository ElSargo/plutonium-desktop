+// EXO-IMPORT: |format| is one the GPU reports on for shared-memory buffers,
+// and it can't import it.
+bool IsUnimportableSharedMemoryFormat(gpu::SharedImageInterface* sii,
+                                      viz::SharedImageFormat format) {
+  if (format != viz::SinglePlaneFormat::kRGBA_8888 &&
+      format != viz::SinglePlaneFormat::kRGBX_8888 &&
+      format != viz::SinglePlaneFormat::kBGRA_8888 &&
+      format != viz::SinglePlaneFormat::kBGRX_8888) {
+    return false;
+  }
+  const std::vector<viz::SharedImageFormat>& formats =
+      sii->GetCapabilities().shared_memory_import_formats;
+  // An empty list is a GPU process that doesn't say.
+  return !formats.empty() && !std::ranges::contains(formats, format);
+}
