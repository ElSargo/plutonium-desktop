diff --git a/components/exo/plutonium_vim.cc b/components/exo/plutonium_vim.cc
new file mode 100644
index 0000000000..10c6b91ac1
--- /dev/null
+++ b/components/exo/plutonium_vim.cc
@@ -0,0 +1,316 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/exo/plutonium_vim.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "components/exo/embedded_windows.h"
+#include "components/exo/surface.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/dom/dom_key.h"
+#include "ui/events/keycodes/dom/keycode_converter.h"
+
+namespace exo {
+
+namespace {
+
+// CDP's modifiers (Input.dispatchKeyEvent): Alt 1, Ctrl 2, Meta 4, Shift 8.
+int ModifiersOf(const ui::KeyEvent& event) {
+  int modifiers = 0;
+  if (event.flags() & ui::EF_ALT_DOWN) {
+    modifiers |= 1;
+  }
+  if (event.flags() & ui::EF_CONTROL_DOWN) {
+    modifiers |= 2;
+  }
+  if (event.flags() & ui::EF_COMMAND_DOWN) {
+    modifiers |= 4;
+  }
+  if (event.flags() & ui::EF_SHIFT_DOWN) {
+    modifiers |= 8;
+  }
+  return modifiers;
+}
+
+bool IsModifierKey(ui::DomKey key) {
+  return key == ui::DomKey::CONTROL || key == ui::DomKey::SHIFT ||
+         key == ui::DomKey::ALT || key == ui::DomKey::ALT_GRAPH ||
+         key == ui::DomKey::META || key == ui::DomKey::SUPER ||
+         key == ui::DomKey::HYPER || key == ui::DomKey::CAPS_LOCK ||
+         key == ui::DomKey::NUM_LOCK;
+}
+
+}  // namespace
+
+// static
+PlutoniumVim* PlutoniumVim::Get() {
+  static base::NoDestructor<PlutoniumVim> instance;
+  return instance.get();
+}
+
+PlutoniumVim::PlutoniumVim() = default;
+PlutoniumVim::~PlutoniumVim() = default;
+
+void PlutoniumVim::SetListener(Listener* listener) {
+  listener_ = listener;
+  if (listener_) {
+    return;
+  }
+  // Nobody answers: whatever is held goes on, and nothing more is held.
+  while (!queue_.empty()) {
+    Resolve(false);
+  }
+  for (auto& [field, entry] : fields_) {
+    entry.hold_all = false;
+    entry.hold.clear();
+  }
+  taken_.clear();
+}
+
+bool PlutoniumVim::SetHold(int field_id, bool all, std::vector<KeySpec> keys) {
+  for (auto& [field, entry] : fields_) {
+    if (entry.id == field_id) {
+      entry.hold_all = all;
+      entry.hold = std::move(keys);
+      return true;
+    }
+  }
+  return false;
+}
+
+void PlutoniumVim::Answer(int key_id, bool consumed) {
+  if (queue_.empty() || queue_.front().key_id != key_id) {
+    return;
+  }
+  Resolve(consumed);
+}
+
+bool PlutoniumVim::Edit(int field_id,
+                        int before,
+                        int after,
+                        const std::u16string& text) {
+  for (auto& [field, entry] : fields_) {
+    if (entry.id == field_id) {
+      field->VimEdit(before, after, text);
+      return true;
+    }
+  }
+  return false;
+}
+
+void PlutoniumVim::FieldChanged(Field* field,
+                                const std::u16string& text,
+                                int cursor,
+                                int anchor,
+                                uint32_t hint,
+                                uint32_t purpose,
+                                bool off,
+                                std::optional<gfx::Rect> caret) {
+  auto [it, added] = fields_.try_emplace(field);
+  FieldEntry& entry = it->second;
+  if (added) {
+    entry.id = next_field_id_++;
+  }
+  const bool was_off = !added && entry.off;
+  entry.off = off;
+  if (!listener_) {
+    return;
+  }
+  if (off) {
+    if (!added && !was_off) {
+      listener_->OnVimFieldGone(entry.id);
+    }
+    return;
+  }
+  FieldState state;
+  state.id = entry.id;
+  state.text = text;
+  state.cursor = cursor;
+  state.anchor = anchor;
+  state.hint = hint;
+  state.purpose = purpose;
+  EmbeddedWindows* windows = EmbeddedWindows::Get();
+  state.window_id = windows->WindowIdForSurface(field->VimSurface());
+  if (caret && state.window_id) {
+    // Surface coordinates to the window's geometry, which the shell shows.
+    gfx::Rect rect = *caret;
+    if (std::optional<EmbeddedWindows::Info> info =
+            windows->GetInfo(state.window_id)) {
+      rect.Offset(-info->geometry.OffsetFromOrigin());
+    }
+    state.caret = rect;
+  }
+  listener_->OnVimFieldChanged(state);
+}
+
+void PlutoniumVim::FieldComposing(Field* field, bool composing) {
+  auto it = fields_.find(field);
+  if (it != fields_.end()) {
+    it->second.composing = composing;
+  }
+}
+
+void PlutoniumVim::FieldGone(Field* field) {
+  auto it = fields_.find(field);
+  if (it == fields_.end()) {
+    return;
+  }
+  const int id = it->second.id;
+  const bool announced = !it->second.off;
+  fields_.erase(it);
+  if (listener_ && announced) {
+    listener_->OnVimFieldGone(id);
+  }
+}
+
+PlutoniumVim::FieldEntry* PlutoniumVim::EntryFor(Surface* focus) {
+  if (!focus) {
+    return nullptr;
+  }
+  for (auto& [field, entry] : fields_) {
+    if (field->VimSurface() == focus) {
+      return entry.off || entry.composing ? nullptr : &entry;
+    }
+  }
+  return nullptr;
+}
+
+bool PlutoniumVim::Wants(const FieldEntry& entry,
+                         const ui::KeyEvent& event) const {
+  const ui::DomKey dom_key = event.GetDomKey();
+  // Super's keys are the desktop's; modifiers alone are nobody's key.
+  if ((event.flags() & ui::EF_COMMAND_DOWN) || IsModifierKey(dom_key)) {
+    return false;
+  }
+  if (entry.hold_all) {
+    return true;
+  }
+  const std::string key = ui::KeycodeConverter::DomKeyToKeyString(dom_key);
+  // Shift is in the key itself ("J"); Ctrl and Alt must match.
+  const int modifiers = ModifiersOf(event) & 3;
+  for (const KeySpec& spec : entry.hold) {
+    if (spec.key == key && (spec.modifiers & 3) == modifiers) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool PlutoniumVim::FilterKey(Surface* focus, ui::KeyEvent* event) {
+  if (!listener_ || (event->properties() &&
+                     event->properties()->contains(kShellKeyEventKey))) {
+    return false;
+  }
+  const ui::DomCode code = event->code();
+  const int32_t window_id =
+      focus ? EmbeddedWindows::Get()->WindowIdForSurface(focus) : 0;
+  if (event->type() == ui::EventType::kKeyReleased) {
+    // Behind a held key, in order; the release of a key the engine took is
+    // the engine's too.
+    if (!queue_.empty()) {
+      queue_.push_back(
+          {0, 0, window_id, std::make_unique<ui::KeyEvent>(*event)});
+      return true;
+    }
+    return taken_.erase(code) > 0;
+  }
+  if (event->type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  // Exo drops repeats (apps repeat keys themselves); a key the engine took
+  // repeats in the engine (holding j moves line after line).
+  if (event->is_repeat() && !taken_.contains(code) && queue_.empty()) {
+    return false;
+  }
+  FieldEntry* entry = EntryFor(focus);
+  if (!queue_.empty()) {
+    queue_.push_back({0, entry ? entry->id : 0, window_id,
+                      std::make_unique<ui::KeyEvent>(*event)});
+    return true;
+  }
+  // Only a window the agents' key path reaches can get a held key back.
+  if (!entry || !window_id || !Wants(*entry, *event)) {
+    return false;
+  }
+  queue_.push_back(
+      {0, entry->id, window_id, std::make_unique<ui::KeyEvent>(*event)});
+  Send(queue_.front());
+  return true;
+}
+
+void PlutoniumVim::Send(Pending& pending) {
+  pending.key_id = next_key_id_++;
+  Key key;
+  key.id = pending.key_id;
+  key.field_id = pending.field_id;
+  key.key =
+      ui::KeycodeConverter::DomKeyToKeyString(pending.event->GetDomKey());
+  key.code = ui::KeycodeConverter::DomCodeToCodeString(pending.event->code());
+  key.modifiers = ModifiersOf(*pending.event);
+  key.repeat = pending.event->is_repeat();
+  answer_timer_.Start(FROM_HERE, kAnswerTimeout,
+                      base::BindOnce(&PlutoniumVim::Resolve,
+                                     weak_factory_.GetWeakPtr(), false));
+  listener_->OnVimKey(key);
+}
+
+void PlutoniumVim::Resolve(bool consumed) {
+  answer_timer_.Stop();
+  if (queue_.empty()) {
+    return;
+  }
+  Pending pending = std::move(queue_.front());
+  queue_.pop_front();
+  if (consumed) {
+    taken_.insert(pending.event->code());
+  } else if (!pending.event->is_repeat()) {
+    taken_.erase(pending.event->code());
+    Replay(std::move(pending));
+  }
+  Drain();
+}
+
+void PlutoniumVim::Drain() {
+  while (!queue_.empty()) {
+    Pending& front = queue_.front();
+    if (front.event->type() == ui::EventType::kKeyPressed && listener_) {
+      FieldEntry* entry = nullptr;
+      for (auto& [field, candidate] : fields_) {
+        if (candidate.id == front.field_id && !candidate.off &&
+            !candidate.composing) {
+          entry = &candidate;
+        }
+      }
+      const bool repeat_of_taken =
+          front.event->is_repeat() && taken_.contains(front.event->code());
+      if (entry && (repeat_of_taken || (!front.event->is_repeat() &&
+                                        Wants(*entry, *front.event)))) {
+        Send(front);
+        return;
+      }
+    }
+    Pending pending = std::move(queue_.front());
+    queue_.pop_front();
+    if (pending.event->type() == ui::EventType::kKeyReleased &&
+        taken_.erase(pending.event->code())) {
+      continue;
+    }
+    if (!pending.event->is_repeat()) {
+      Replay(std::move(pending));
+    }
+  }
+}
+
+void PlutoniumVim::Replay(Pending pending) {
+  if (!pending.window_id) {
+    return;
+  }
+  std::vector<std::unique_ptr<ui::KeyEvent>> events;
+  events.push_back(std::move(pending.event));
+  EmbeddedWindows::Get()->InjectKeyEvents(pending.window_id, std::move(events));
+}
+
+}  // namespace exo
