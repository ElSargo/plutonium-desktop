+void EmbeddedWindows::Attach(int32_t window_id) {
+  auto it = windows_.find(window_id);
+  if (it == windows_.end()) {
+    return;
+  }
+  if (it->second.attach_count++ == 0) {
+    // EXO-PRESENT: a presented window stays on the desktop.
+    if (window_id != presented_window_id_) {
+      it->second.shell_surface->SetEmbedParked(true);
+    }
+    NotifyIfChanged(window_id);
+    // EXO-MODAL: a dialog shown over the focused window takes its focus.
+    UpdateModalFocus();
+  }
+}
+
+void EmbeddedWindows::Detach(int32_t window_id) {
+  auto it = windows_.find(window_id);
+  if (it == windows_.end() || it->second.attach_count == 0) {
+    return;
+  }
+  if (--it->second.attach_count == 0) {
+    if (focused_window_id_ == window_id) {
+      ClearFocusToModalParent(window_id);
+    }
+    // The next element to show the window chooses its size, or takes the
+    // window's own (EXO-CAPTURE: unless a capture holds one).
+    it->second.shell_surface->SetEmbedSize(it->second.capture_size);
+    it->second.embed_size = gfx::Size();
+    if (window_id == presented_window_id_) {
+      // EXO-PRESENT: it stays where it is until the presentation ends.
+      it->second.show_on_detach = false;
+    } else if (it->second.show_on_detach) {
+      it->second.show_on_detach = false;
+      ActivateOnDesktop(it->second.shell_surface);
+    } else if (!HideWindows()) {
+      it->second.shell_surface->SetEmbedParked(false);
+    }
+    NotifyIfChanged(window_id);
+  }
+}
+
+void EmbeddedWindows::ShowOnDesktop(int32_t window_id) {
+  auto it = windows_.find(window_id);
+  if (it == windows_.end()) {
+    return;
+  }
+  if (window_id == presented_window_id_) {
+    // EXO-PRESENT: on the desktop already.
+    return;
+  }
+  if (it->second.attach_count > 0) {
+    it->second.show_on_detach = true;
+    return;
+  }
+  ActivateOnDesktop(it->second.shell_surface);
+}
+
+void EmbeddedWindows::Present(int32_t window_id) {
+  auto it = windows_.find(window_id);
+  if (it == windows_.end()) {
+    return;
+  }
+  if (presented_window_id_ && presented_window_id_ != window_id) {
+    EndPresentation();
+  }
+  presented_window_id_ = window_id;
+  it->second.show_on_detach = false;
+  if (focused_window_id_ == window_id) {
+    ClearFocus();
+  }
+  ShellSurfaceBase* shell_surface = it->second.shell_surface;
+  shell_surface->SetEmbedParked(false);
+  if (views::Widget* widget = shell_surface->GetWidget()) {
+    if (widget->IsMinimized()) {
+      widget->Restore();
+    }
+    widget->SetFullscreen(true);
+    // Fullscreen is the window's own size, which an app with a fixed size
+    // (a dialog) keeps: the backdrop covers the rest of the display, so the
+    // shell's window behind it is neither seen nor clicked. A click there
+    // used to activate the shell, which then hid the window.
+    ash::WindowBackdrop::Get(widget->GetNativeWindow())
+        ->SetBackdropMode(ash::WindowBackdrop::BackdropMode::kEnabled);
+    widget->Show();
+    widget->Activate();
+  }
+  VLOG(1) << "EXO-PRESENT window #" << window_id;
+  NotifyIfChanged(window_id);
+}
+
+void EmbeddedWindows::EndPresentation() {
+  const int32_t window_id = presented_window_id_;
+  presented_window_id_ = 0;
+  auto it = windows_.find(window_id);
+  if (it == windows_.end()) {
+    return;
+  }
+  ShellSurfaceBase* shell_surface = it->second.shell_surface;
+  if (views::Widget* widget = shell_surface->GetWidget()) {
+    ash::WindowBackdrop::Get(widget->GetNativeWindow())
+        ->SetBackdropMode(ash::WindowBackdrop::BackdropMode::kAuto);
+    if (widget->IsFullscreen()) {
+      widget->SetFullscreen(false);
+    }
+  }
+  if (it->second.attach_count > 0) {
+    // Back to its elements, at the size they asked for.
+    shell_surface->SetEmbedParked(true);
+    if (!SizeFor(it->second).IsEmpty()) {
+      shell_surface->SetEmbedSize(SizeFor(it->second));
+    }
+  } else if (HideWindows()) {
+    shell_surface->SetEmbedParked(true);
+  }
+  VLOG(1) << "EXO-PRESENT ended for window #" << window_id;
+  NotifyIfChanged(window_id);
+}
+
+void EmbeddedWindows::ActivateOnDesktop(ShellSurfaceBase* shell_surface) {
+  shell_surface->SetEmbedParked(false);
+  views::Widget* widget = shell_surface->GetWidget();
+  if (!widget) {
+    return;
+  }
+  if (widget->IsMinimized()) {
+    widget->Restore();
+  }
+  // EXO-BOOT: the parked window kept wherever Ash first placed it, at the
+  // size the page gave it, which can reach off the screen. With no shelf or
+  // window management (shell mode) it couldn't be moved back: fit it into
+  // the work area.
+  if (!widget->IsMaximized() && !widget->IsFullscreen()) {
+    gfx::Rect bounds = widget->GetWindowBoundsInScreen();
+    gfx::Rect fitted = bounds;
+    fitted.AdjustToFit(widget->GetWorkAreaBoundsInScreen());
+    if (fitted != bounds) {
+      widget->SetBounds(fitted);
+    }
+  }
+  widget->Show();
+  widget->Activate();
+}
+
+void EmbeddedWindows::SetSize(int32_t window_id, const gfx::Size& size) {
+  auto it = windows_.find(window_id);
+  if (it == windows_.end()) {
+    return;
+  }
+  it->second.embed_size = size;
+  // EXO-PRESENT: fullscreen until the presentation ends.
+  if (window_id != presented_window_id_) {
+    it->second.shell_surface->SetEmbedSize(SizeFor(it->second));
+  }
+}
+
+void EmbeddedWindows::SetCaptureSize(int32_t window_id,
+                                     const gfx::Size& size) {
+  auto it = windows_.find(window_id);
+  if (it == windows_.end() || it->second.capture_size == size) {
+    return;
+  }
+  it->second.capture_size = size;
+  VLOG(1) << "EXO-CAPTURE window #" << window_id << " held at "
+          << (size.IsEmpty() ? std::string("its element's size")
+                             : size.ToString());
+  if (window_id != presented_window_id_) {
+    it->second.shell_surface->SetEmbedSize(SizeFor(it->second));
+  }
+}
