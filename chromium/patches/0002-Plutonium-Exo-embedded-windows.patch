+
+void ShellSurfaceBase::SetEmbedSize(const gfx::Size& size) {
+  if (size.IsEmpty()) {
+    embed_size_.reset();
+    return;
+  }
+  if (!widget_) {
+    return;
+  }
+  if (embed_parked_) {
+    embed_size_ = size;
+  }
+  UpdateEmbedCoversDisplay(size);
+  // The frame around the client view can change with the size (e.g. a
+  // caption appears once the window is as big as the display): resize, and
+  // once more if the client view didn't end up at |size|. A parked window
+  // may extend past the display (its bounds are set directly); only its
+  // client view's position matters, see MoveEmbedOrigin().
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    gfx::Rect bounds = widget_->GetWindowBoundsInScreen();
+    gfx::Rect client = GetClientViewBounds();
+    gfx::Size widget_size(
+        size.width() + bounds.width() - client.width(),
+        size.height() + bounds.height() - client.height());
+    if (widget_size == bounds.size()) {
+      return;
+    }
+    // EXO-DISPLAYS: on the display it is on. Bounds in screen coordinates
+    // (widget_->SetBounds()) of a bigger size could fall mostly on another
+    // display and move it there; only SetShown() moves a parked window.
+    aura::Window* window = widget_->GetNativeWindow();
+    window->SetBounds(gfx::Rect(window->bounds().origin(), widget_size));
+  }
+}
+
+void ShellSurfaceBase::ScheduleEmbedLayoutCheck() {
+  if (!embed_parked_ || embed_layout_check_pending_) {
+    return;
+  }
+  embed_layout_check_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ShellSurfaceBase::CheckEmbedLayout,
+                                embed_weak_factory_.GetWeakPtr()));
+}
+
+void ShellSurfaceBase::CheckEmbedLayout() {
+  embed_layout_check_pending_ = false;
+  if (!widget_ || !embed_parked_) {
+    return;
+  }
+  // Maximized, snapped, floated...: Ash places such windows itself, and the
+  // client would draw at a size the page never asked for.
+  auto* window_state = ash::WindowState::Get(widget_->GetNativeWindow());
+  if (window_state && !window_state->IsNormalStateType()) {
+    window_state->Restore();
+  }
+  if (embed_size_) {
+    SetEmbedSize(*embed_size_);
+  }
+}
+
+void ShellSurfaceBase::UpdateEmbedCoversDisplay(const gfx::Size& size) {
+  if (!widget_ || !root_surface()) {
+    return;
+  }
+  const gfx::Size display_size =
+      display::Screen::Get()
+          ->GetDisplayNearestWindow(widget_->GetNativeWindow())
+          .size();
+  const bool covers = embed_parked_ && !display_size.IsEmpty() &&
+                      size.width() >= display_size.width() &&
+                      size.height() >= display_size.height();
+  if (covers == embed_covers_display_) {
+    return;
+  }
+  embed_covers_display_ = covers;
+  root_surface()->OnFullscreenStateChanged(covers || widget_->IsFullscreen());
+}
+
+// static
+void ShellSurfaceBase::RestoreZOrderingBeforeMove(aura::Window* window,
+                                                  const gfx::Rect& bounds) {
+  // EXO-DISPLAYS: a parked window floats above normal windows, but Ash
+  // demotes it into the desk container while a fullscreen window (a shell's)
+  // is on its display. Moved to another display in that state, it would
+  // arrive in that display's desk container, and the fullscreen state change
+  // that can cause there promotes it back, re-parenting it from inside its
+  // own AddChild (a desk DCHECK). It moves in the always-on-top container
+  // instead, and the new display demotes it if it has to.
+  display::Screen* screen = display::Screen::Get();
+  auto* window_state = window ? ash::WindowState::Get(window) : nullptr;
+  if (!screen || !window_state ||
+      screen->GetDisplayMatching(bounds).id() ==
+          screen->GetDisplayNearestWindow(window).id()) {
+    return;
+  }
+  window_state->RestoreZOrdering();
+}
+
+void ShellSurfaceBase::MoveEmbedOrigin(const gfx::PointF& host_origin_in_screen) {
+  if (!widget_ || !embed_parked_ || !host_window()) {
+    return;
+  }
+  gfx::Vector2d delta = gfx::ToRoundedPoint(host_origin_in_screen) -
+                        host_window()->GetBoundsInScreen().origin();
+  if (delta.IsZero()) {
+    return;
+  }
+  gfx::Rect bounds = widget_->GetWindowBoundsInScreen();
+  bounds.Offset(delta);
+  RestoreZOrderingBeforeMove(widget_->GetNativeWindow(), bounds);
+  widget_->SetBounds(bounds);
+  // Popups are placed relative to their parent: they move with it.
+  for (ShellSurfaceBase* popup : GetEmbedPopups()) {
+    popup->origin_ += delta;
+    if (popup->widget_) {
+      gfx::Rect popup_bounds = popup->widget_->GetWindowBoundsInScreen();
+      popup_bounds.Offset(delta);
+      RestoreZOrderingBeforeMove(popup->widget_->GetNativeWindow(),
+                                 popup_bounds);
+      popup->widget_->SetBounds(popup_bounds);
+    }
+  }
+  UpdateEmbedPopups();
+}
