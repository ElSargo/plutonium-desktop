+void ShellSurfaceBase::SetEmbedFullscreen(bool fullscreen) {
+  // The element's state is the latest word on what the user wants.
+  embed_fullscreen_requested_ = fullscreen;
+  if (embed_fullscreen_ == fullscreen) {
+    return;
+  }
+  embed_fullscreen_ = fullscreen;
+  if (embed_parked_) {
+    OnEmbedStateChanged();
+  }
+}
+
+void ShellSurfaceBase::RequestEmbedFullscreen(bool fullscreen) {
+  embed_fullscreen_requested_ = fullscreen;
+  EmbeddedWindows::Get()->OnToplevelFullscreenRequested(this, fullscreen);
+  // Answer the request with the state as it is now; the element's change,
+  // if any, follows with another configure.
+  OnEmbedStateChanged();
+}
