+// The switcher's colors (plutonium_overlay.cc).
+constexpr SkColor kBackground = SkColorSetRGB(0x17, 0x18, 0x1a);
+constexpr SkColor kField = SkColorSetRGB(0x2a, 0x2b, 0x2e);
+constexpr SkColor kTitle = SkColorSetRGB(0xe8, 0xea, 0xed);
+constexpr SkColor kDim = SkColorSetRGB(0x9a, 0xa0, 0xa6);
+constexpr SkColor kError = SkColorSetRGB(0xf2, 0x8b, 0x82);
+constexpr int kModifiers = ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+                           ui::EF_SHIFT_DOWN | ui::EF_COMMAND_DOWN;
+
+bool IsDrm() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+             "ozone-platform") == "drm";
+}
+
+views::Label* AddLabel(views::View* parent,
+                       std::u16string_view text,
+                       SkColor color,
+                       int size_delta,
+                       gfx::Font::Weight weight = gfx::Font::Weight::NORMAL) {
+  auto* label = parent->AddChildView(std::make_unique<views::Label>(text));
+  label->SetAutoColorReadabilityEnabled(false);
+  label->SetEnabledColor(color);
+  label->SetFontList(
+      gfx::FontList().DeriveWithSizeDelta(size_delta).DeriveWithWeight(weight));
+  return label;
+}
