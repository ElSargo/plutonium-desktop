+#include "ui/wm/public/activation_change_observer.h"
+
+class PlutoniumLockView;
+
+namespace views {
+class Widget;
+}
+
+// EXO-LOCK: Ash's lock screen in shell mode (PlutoniumLock). A full-screen
+// widget on every display, above the shells, tabs and apps (Ash's overlay
+// container, where the switcher is): the clock, the user's name and a
+// password field on the primary display, the clock on the others. While it's
+// up, an event handler ahead of everything else (Ash's system priority) drops
+// every event that isn't for it, so no key, click or touch reaches a shell,
+// a tab or an app, and the Plutonium keys (Super+Tab, Super+F…) are off; the
+// hardware keys (volume, brightness) still work, and VT switching and
+// Ctrl+Alt+Backspace (taken in evdev, before Ash) too. The password goes to
+// the helper (POST /v1/session/unlock over its socket), which checks it;
+// only its yes takes the lock down.
+//
+// Super+L asks the helper to lock (POST /v1/session/lock), which refuses
+// when it has no way to check a password. The helper's session service
+// (idle, logind, suspend) locks through the Plutonium DevTools domain.
+class PlutoniumLockImpl : public PlutoniumLock,
+                          public ui::EventHandler,
+                          public wm::ActivationChangeObserver,
+                          public display::DisplayObserver,
+                          public ui::UserActivityObserver {
+ public:
+  // After Ash's shell is made.
+  PlutoniumLockImpl();
+  PlutoniumLockImpl(const PlutoniumLockImpl&) = delete;
+  PlutoniumLockImpl& operator=(const PlutoniumLockImpl&) = delete;
+  ~PlutoniumLockImpl() override;
+
+  // PlutoniumLock:
+  bool IsLocked() const override;
+  void Lock(const std::u16string& user, const std::u16string& message) override;
+  base::TimeDelta GetIdleTime() const override;
+  bool SetDisplaysOff(bool off) override;
+  bool AreDisplaysOff() const override;
+  std::vector<std::string> GetWakeLocks() const override;
+
+  // From the lock's view: the password typed, to check.
+  void Submit(const std::u16string& password);
+
+  // ui::EventHandler:
+  void OnEvent(ui::Event* event) override;
+
+  // wm::ActivationChangeObserver:
+  void OnWindowActivated(ActivationReason reason,
+                         aura::Window* gained_active,
+                         aura::Window* lost_active) override;
+
+  // display::DisplayObserver:
+  void OnDisplayAdded(const display::Display& new_display) override;
+  void OnDisplaysRemoved(const display::Displays& removed_displays) override;
+  void OnDisplayMetricsChanged(const display::Display& display,
+                               uint32_t changed_metrics) override;
+
+  // ui::UserActivityObserver:
+  void OnUserActivity(const ui::Event* event) override;
+
+ private:
+  // Super+L: true if |event| was it (a press or its release).
+  bool HandleLockKey(const ui::KeyEvent& event);
+  bool IsLockWindow(const aura::Window* window) const;
+  // One widget per display, the primary's with the password field.
+  void BuildWidgets();
+  void CloseWidgets();
+  // Again, after the displays changed (from a task: Ash makes its root
+  // windows in its own display observer).
+  void RebuildSoon();
+  void Unlock();
+  void OnUnlockAnswer(std::optional<base::Value> value,
+                      const std::string& error);
+  void Tick();
+
+  bool locked_ = false;
+  bool displays_off_ = false;
+  // Super+L's press was taken here: so is its release.
+  bool lock_key_down_ = false;
+  // An answer to the password is awaited.
+  bool checking_ = false;
+  std::u16string user_;
+  std::u16string message_;
+  // |message_| says what went wrong (a wrong password): in the error color.
+  bool message_error_ = false;
+  // Until then, the field takes no password (the helper's rate limit).
+  base::TimeTicks retry_at_;
+  const base::TimeTicks started_ = base::TimeTicks::Now();
+  std::vector<std::unique_ptr<views::Widget>> widgets_;
+  raw_ptr<PlutoniumLockView> view_ = nullptr;
+  // What had the focus before it locked, given it back after.
+  aura::WindowTracker previously_active_;
+  base::RepeatingTimer clock_;
+  base::WeakPtrFactory<PlutoniumLockImpl> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_LOCK_IMPL_H_
