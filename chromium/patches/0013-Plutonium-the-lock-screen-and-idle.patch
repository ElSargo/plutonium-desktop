+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PLUTONIUM_LOCK_H_
+#define CHROME_BROWSER_PLUTONIUM_LOCK_H_
+
+#include <string>
+#include <vector>
+
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/time/time.h"
+
+// EXO-LOCK (docs/features/DESKTOP_SERVICES.md, "session"): the lock screen
+// and idle, in shell mode. The helper's session service decides when to lock
+// (its action, Super+L, logind, before suspend, idle) and checks the
+// password; Ash draws the lock over every display, above every shell, page
+// and app, and keeps input from reaching them while it's up
+// (chrome/browser/ui/ash/main_extra_parts/plutonium_lock_impl.h). Only the
+// password typed on it, checked by the helper, takes it down: nothing here
+// unlocks. The Plutonium DevTools domain is the helper's way in.
+class PlutoniumLock {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnLockChanged(bool locked) {}
+  };
+
+  // Null outside shell mode.
+  static PlutoniumLock* Get();
+
+  PlutoniumLock(const PlutoniumLock&) = delete;
+  PlutoniumLock& operator=(const PlutoniumLock&) = delete;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  virtual bool IsLocked() const = 0;
+  // Puts the lock up on every display, with |user| (the user's name) and
+  // |message| on it; if it's up, shows |message|.
+  virtual void Lock(const std::u16string& user,
+                    const std::u16string& message) = 0;
+
+  // Since the user last did anything (a key, the pointer, a touch).
+  virtual base::TimeDelta GetIdleTime() const = 0;
+  // Turns the displays off (on DRM) until the user does something, or on
+  // again. False where it can't (an X11 session).
+  virtual bool SetDisplaysOff(bool off) = 0;
+  virtual bool AreDisplaysOff() const = 0;
+  // What keeps the screen on: the browser's wake locks (a tab playing video,
+  // the Screen Wake Lock API) and Wayland apps' idle inhibitors, each its
+  // description.
+  virtual std::vector<std::string> GetWakeLocks() const = 0;
+
+ protected:
+  PlutoniumLock();
+  virtual ~PlutoniumLock();
+
+  void NotifyLockChanged(bool locked);
+
+ private:
+  base::ObserverList<Observer> observers_;
+};
+
+#endif  // CHROME_BROWSER_PLUTONIUM_LOCK_H_
