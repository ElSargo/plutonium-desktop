+#ifndef CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_LOCK_IMPL_H_
+#define CHROME_BROWSER_UI_ASH_MAIN_EXTRA_PARTS_PLUTONIUM_LOCK_IMPL_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
