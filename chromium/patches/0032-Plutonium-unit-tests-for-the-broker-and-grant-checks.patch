+  EXPECT_FALSE(Attach(main_rfh(), *grant, kWindow));
+  EXPECT_TRUE(WasLogged("attach failed: window #7 not embeddable"));
+  EXPECT_FALSE(WasLogged("attach refused"));
+  // Without the window id too: the grant decides.
+  Logged().clear();
+  EXPECT_FALSE(Attach(main_rfh(), *grant, 0));
+  EXPECT_TRUE(WasLogged("attach failed: window #7 not embeddable"));
+}
