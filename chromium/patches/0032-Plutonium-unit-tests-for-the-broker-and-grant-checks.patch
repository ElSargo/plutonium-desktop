+TEST_F(PlutoniumShellTest, UnsubscribedObserverIsDropped) {
+  mojo::Remote<blink::mojom::WindowBroker> shell = BindBroker(main_rfh());
+  auto observer = std::make_unique<FakeObserver>();
+  base::test::TestFuture<std::vector<blink::mojom::NativeWindowEntryPtr>>
+      snapshot;
+  shell->AddObserver(observer->receiver.BindNewEndpointAndPassRemote(),
+                     snapshot.GetCallback());
+  ASSERT_TRUE(snapshot.Wait());
+  // The page stops listening (closes its end); events after that go nowhere,
+  // and the broker pipe stays up.
+  observer.reset();
+  shell.FlushForTesting();
+  broker()->AddWindowForTesting(MakeWindow(9));
+  shell.FlushForTesting();
+  EXPECT_TRUE(shell.is_connected());
+
+  // Listening again gives the current windows again.
+  FakeObserver again;
+  base::test::TestFuture<std::vector<blink::mojom::NativeWindowEntryPtr>>
+      snapshot2;
+  shell->AddObserver(again.receiver.BindNewEndpointAndPassRemote(),
+                     snapshot2.GetCallback());
+  EXPECT_EQ(3u, snapshot2.Get().size());
+  broker()->OnEmbeddedWindowDestroyed(9);
+  shell.FlushForTesting();
+  EXPECT_EQ((std::vector<std::string>{"removed 9"}), again.events);
+}
