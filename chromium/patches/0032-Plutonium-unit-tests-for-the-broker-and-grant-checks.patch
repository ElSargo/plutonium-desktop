+  EXPECT_TRUE(delegate.routed.empty());
+
+  delegate.Link(kNativeWindowSink, view_root_->GetFrameSinkId());
+  RouteToForeign(kNativeWindowSink, down);
+  ASSERT_EQ(1u, delegate.routed.size());
+  EXPECT_EQ(kNativeWindowSink, delegate.routed[0]);
+}
+
+// A drag that started on a window loses its capture when the link goes (the
+// grant was revoked mid-drag).
+TEST_F(RenderWidgetHostInputEventRouterTest, ForeignCaptureEndsWithTheLink) {
+  FakeForeignFrameSinkDelegate delegate;
+  delegate.Link(kNativeWindowSink, view_root_->GetFrameSinkId());
+  foreign_capture_sink() = kNativeWindowSink;
+  delegate.Unlink(kNativeWindowSink, view_root_->GetFrameSinkId());
+  blink::WebMouseEvent move = blink::SyntheticWebMouseEventBuilder::Build(
+      blink::WebInputEvent::Type::kMouseMove, 6, 6,
+      blink::WebInputEvent::kLeftButtonDown);
+  RouteToForeign(kNativeWindowSink, move);
+  EXPECT_TRUE(delegate.routed.empty());
+  EXPECT_FALSE(foreign_capture_sink().is_valid());
+}
