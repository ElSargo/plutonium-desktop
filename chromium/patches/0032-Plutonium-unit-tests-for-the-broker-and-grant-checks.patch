+// EXO-BROKER: which documents are the shell, what the shell API gives them,
+// and the checks <native-window> attaches go through.
+namespace {
+
+constexpr char kShellOrigin[] = "http://localhost:8765";
+constexpr char kShellUrl[] = "http://localhost:8765/shell.html";
+constexpr char kOtherSiteUrl[] = "http://127.0.0.1:8766/shell.html";
+
+constexpr int32_t kWindow = 7;
+constexpr int32_t kOtherWindow = 8;
+
+ExoWindowBroker::WindowInfo MakeWindow(int32_t id) {
+  ExoWindowBroker::WindowInfo window;
+  window.id = id;
+  window.app_id = "org.example.app";
+  window.title = u"App";
+  window.size = gfx::Size(400, 300);
+  return window;
+}
+
+// VLOG lines, for telling apart why an attach was refused.
+std::vector<std::string>& Logged() {
+  static base::NoDestructor<std::vector<std::string>> logged;
+  return *logged;
+}
+
+bool RecordLog(int severity,
+               const char* file,
+               int line,
+               size_t message_start,
+               const std::string& message) {
+  Logged().push_back(message.substr(message_start));
+  return false;
+}
+
+bool WasLogged(const std::string& part) {
+  for (const std::string& message : Logged()) {
+    if (message.find(part) != std::string::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The shell page's end of navigator.windowBroker's events.
+class FakeObserver : public blink::mojom::WindowBrokerObserver {
+ public:
+  void OnWindowAdded(blink::mojom::NativeWindowEntryPtr window) override {
+    events.push_back("added " + base::NumberToString(window->id));
+  }
+  void OnWindowChanged(blink::mojom::NativeWindowEntryPtr window) override {
+    events.push_back("changed " + base::NumberToString(window->id));
+  }
+  void OnWindowRemoved(int32_t window_id) override {
+    events.push_back("removed " + base::NumberToString(window_id));
+  }
+  void OnGrantRevoked(const base::UnguessableToken& grant,
+                      int32_t window_id) override {
+    events.push_back("revoked " + base::NumberToString(window_id));
+    revoked.push_back(grant);
+  }
+  void OnWindowFocusRequested(
+      blink::mojom::NativeWindowEntryPtr window) override {}
+
+  std::vector<std::string> events;
+  std::vector<base::UnguessableToken> revoked;
+  mojo::AssociatedReceiver<blink::mojom::WindowBrokerObserver> receiver{this};
+};
+
+class PlutoniumShellTest : public content::RenderViewHostTestHarness {
+ public:
+  void SetUp() override {
+    // Read once per process (GetShellOrigin() keeps it); every test here
+    // uses the same.
+    base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+    if (!command_line->HasSwitch(plutonium_shell::kShellOriginSwitch)) {
+      command_line->AppendSwitchASCII(plutonium_shell::kShellOriginSwitch,
+                                      kShellOrigin);
+    }
+    content::RenderViewHostTestHarness::SetUp();
+    broker_ = std::make_unique<ExoWindowBroker>();
+    embedder_ = std::make_unique<ExoEmbedder>();
+    broker_->AddWindowForTesting(MakeWindow(kWindow));
+    broker_->AddWindowForTesting(MakeWindow(kOtherWindow));
+    NavigateAndCommit(GURL(kShellUrl));
+  }
+
+  void TearDown() override {
+    DeleteContents();
+    embedder_.reset();
+    broker_.reset();
+    content::RenderViewHostTestHarness::TearDown();
+  }
+
+ protected:
+  ExoWindowBroker* broker() { return broker_.get(); }
+
+  // A frame in the shell page, committed at |url|.
+  content::RenderFrameHost* AddIframe(const std::string& url) {
+    content::RenderFrameHost* child =
+        content::RenderFrameHostTester::For(main_rfh())->AppendChild("child");
+    return content::NavigationSimulator::NavigateAndCommitFromDocument(
+        GURL(url), child);
+  }
+
+  mojo::Remote<blink::mojom::WindowBroker> BindBroker(
+      content::RenderFrameHost* rfh) {
+    mojo::Remote<blink::mojom::WindowBroker> remote;
+    plutonium_shell::BindWindowBroker(rfh, remote.BindNewPipeAndPassReceiver());
+    return remote;
+  }
+
+  std::unique_ptr<ExoWindowBroker> broker_;
+  std::unique_ptr<ExoEmbedder> embedder_;
+};
