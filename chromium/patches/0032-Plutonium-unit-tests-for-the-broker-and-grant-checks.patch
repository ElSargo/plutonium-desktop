+// EXO-BROKER: a native window's frame sink is linked to the page that embeds
+// it (with a grant) through ExoEmbedder, which is the router's
+// ForeignFrameSinkDelegate. The router only sends input to foreign sinks
+// linked to one of its own views.
+class FakeForeignFrameSinkDelegate : public input::ForeignFrameSinkDelegate {
+ public:
+  FakeForeignFrameSinkDelegate() {
+    input::RenderWidgetHostInputEventRouter::SetForeignFrameSinkDelegate(this);
+  }
+  ~FakeForeignFrameSinkDelegate() override {
+    input::RenderWidgetHostInputEventRouter::SetForeignFrameSinkDelegate(
+        nullptr);
+  }
+
+  void Link(const viz::FrameSinkId& sink, const viz::FrameSinkId& parent) {
+    links_.insert({sink, parent});
+  }
+  void Unlink(const viz::FrameSinkId& sink, const viz::FrameSinkId& parent) {
+    links_.erase({sink, parent});
+  }
+
+  // input::ForeignFrameSinkDelegate:
+  bool IsEmbeddedIn(const viz::FrameSinkId& sink,
+                    const viz::FrameSinkId& parent) override {
+    return links_.contains({sink, parent});
+  }
+  void RouteMouseEvent(const viz::FrameSinkId& sink,
+                       const gfx::PointF& location,
+                       const blink::WebMouseEvent& event) override {
+    routed.push_back(sink);
+  }
+  void PointerLeft(const viz::FrameSinkId& sink) override {}
+  void PageMouseDown() override {}
+
+  std::vector<viz::FrameSinkId> routed;
+
+ private:
+  std::set<std::pair<viz::FrameSinkId, viz::FrameSinkId>> links_;
+};
+
