new file mode 100644
index 0000000000..ca2e74bfeb
--- /dev/null
+++ b/chrome/browser/exo_window_broker.h
@@ -0,0 +1,141 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXO_WINDOW_BROKER_H_
+#define CHROME_BROWSER_EXO_WINDOW_BROKER_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/sequence_checker.h"
+#include "base/unguessable_token.h"
+#include "components/exo/embedded_windows.h"
+#include "content/public/browser/global_routing_id.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace content {
+class RenderFrameHost;
+}
+
+// EXO-BROKER: the browser's single source of truth for native windows.
+//
+// Owned by ExoParts (created before ExoEmbedder, destroyed after it). Keeps a
+// registry of embeddable Exo toplevels, mirrored from exo::EmbeddedWindows,
+// tells observers when windows are added, changed and removed, and issues
+// grants.
+//
+// A grant is an opaque, unguessable token that lets one document (a specific
+// RenderFrameHost's current document) embed one window. Grants are revoked
+// when the window closes, when the document goes away (navigation, frame
+// deletion), or explicitly. Holding a grant is meant to be the only way a
+// page can attach to a window or send it input; the broker itself doesn't
+// enforce that (ExoEmbedder does), nor does it decide who may receive grants
+// (the privileged shell API does).
+class ExoWindowBroker : public exo::EmbeddedWindows::Observer {
+ public:
+  // What the broker knows about a window. Changes to anything here are
+  // reported through Observer::OnWindowChanged().
+  struct WindowInfo {
+    WindowInfo();
+    WindowInfo(const WindowInfo&);
+    WindowInfo& operator=(const WindowInfo&);
+    ~WindowInfo();
+    bool operator==(const WindowInfo&) const;
+
+    // exo::EmbeddedWindows window id. Stable for the window's lifetime and
+    // never reused. Not a capability: knowing it grants nothing.
+    int32_t id = 0;
+    std::string app_id;
+    std::u16string title;
+    // Window geometry size in DIPs (without client-side shadows).
+    gfx::Size size;
+    float device_scale_factor = 1.f;
+    // State: whether a page element shows the window (it is then parked and
+    // not on the Ash desktop), and whether it has embedded keyboard focus.
+    bool embedded = false;
+    bool focused = false;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // A window became embeddable (it has a surface).
+    virtual void OnWindowAdded(const WindowInfo& window) {}
+    virtual void OnWindowChanged(const WindowInfo& window) {}
+    // The window closed. Its grants were revoked just before this.
+    virtual void OnWindowRemoved(int32_t window_id) {}
+    // |grant| for |window_id| held by |frame| is no longer valid.
+    virtual void OnGrantRevoked(const base::UnguessableToken& grant,
+                                int32_t window_id,
+                                content::GlobalRenderFrameHostId frame) {}
+  };
+
+  ExoWindowBroker();
+  ExoWindowBroker(const ExoWindowBroker&) = delete;
+  ExoWindowBroker& operator=(const ExoWindowBroker&) = delete;
+  ~ExoWindowBroker() override;
+
+  // Null unless the Wayland server is running.
+  static ExoWindowBroker* Get();
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Registry.
+  std::vector<WindowInfo> GetWindows() const;
+  std::optional<WindowInfo> GetWindow(int32_t window_id) const;
+
+  // Grants.
+  //
+  // Issues a grant for |window_id| to the current document of
+  // |render_frame_host|. Fails if the window isn't in the registry or the
+  // frame isn't live. Every call issues a new token.
+  std::optional<base::UnguessableToken> IssueGrant(
+      content::RenderFrameHost* render_frame_host,
+      int32_t window_id);
+  // Returns the window |grant| is for if it is valid and was issued to the
+  // current document of |render_frame_host|.
+  std::optional<int32_t> ResolveGrant(
+      const base::UnguessableToken& grant,
+      content::RenderFrameHost* render_frame_host) const;
+  // Whether |grant| lets the current document of |render_frame_host| embed
+  // |window_id|.
+  bool ValidateGrant(const base::UnguessableToken& grant,
+                     content::RenderFrameHost* render_frame_host,
+                     int32_t window_id) const;
+  void RevokeGrant(const base::UnguessableToken& grant);
+  void RevokeGrantsForWindow(int32_t window_id);
+  size_t grant_count() const { return grants_.size(); }
+
+  // exo::EmbeddedWindows::Observer:
+  void OnEmbeddedWindowChanged(int32_t window_id) override;
+  void OnEmbeddedWindowDestroyed(int32_t window_id) override;
+
+ private:
+  class DocumentGrants;
+
+  struct Grant {
+    int32_t window_id = 0;
+    content::GlobalRenderFrameHostId frame;
+    // Identifies the document the grant was issued to (see DocumentGrants).
+    base::UnguessableToken document_id;
+  };
+
+  // Called when the document |document_id| is destroyed.
+  void RevokeGrantsForDocument(const base::UnguessableToken& document_id);
+  // Erases the grants matching |pred| and notifies observers.
+  template <typename Pred>
+  void RevokeGrantsIf(Pred pred);
+  void UpdateWindow(int32_t window_id);
+
+  std::map<int32_t, WindowInfo> windows_;
+  std::map<base::UnguessableToken, Grant> grants_;
+  base::ObserverList<Observer> observers_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+#endif  // CHROME_BROWSER_EXO_WINDOW_BROKER_H_
