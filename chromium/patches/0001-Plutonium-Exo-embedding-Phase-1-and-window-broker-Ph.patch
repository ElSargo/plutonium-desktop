+}
+
+bool RenderWidgetHostInputEventRouter::IsForeignFrameSink(
+    const viz::FrameSinkId& frame_sink_id) const {
+  return ForeignDelegate() && frame_sink_id.is_valid() &&
+         !owner_map_.contains(frame_sink_id);
+}
+
+bool RenderWidgetHostInputEventRouter::IsForeignFrameSinkEmbeddedHere(
+    const viz::FrameSinkId& frame_sink_id) const {
+  if (!IsForeignFrameSink(frame_sink_id)) {
+    return false;
+  }
+  for (const auto& [view_frame_sink_id, view] : owner_map_) {
+    if (ForeignDelegate()->IsEmbeddedIn(frame_sink_id, view_frame_sink_id)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool RenderWidgetHostInputEventRouter::RouteToForeignCapture(
+    RenderWidgetHostViewInput* root_view,
+    const blink::WebMouseEvent& event) {
+  if (!foreign_capture_sink_.is_valid() ||
+      event.GetType() == blink::WebInputEvent::Type::kMouseDown ||
+      event.GetType() == blink::WebInputEvent::Type::kMouseLeave) {
+    return false;
+  }
+  viz::FrameSinkId sink = foreign_capture_sink_;
+  if (!ButtonsDownAfter(event)) {
+    foreign_capture_sink_ = viz::FrameSinkId();
+  }
+  // Map the point through the page's view: the sink may also be embedded
+  // elsewhere (e.g. by Ash, for the parked window), and the point may be
+  // outside the sink.
+  viz::HitTestQuery* query =
+      GetHitTestQuery(hit_test_provider_, root_view->GetRootFrameSinkId());
+  gfx::Transform to_view;
+  if (!query ||
+      !query->GetTransformToTarget(root_view->GetFrameSinkId(), &to_view)) {
+    return true;  // The page went away; drop the rest of the drag.
+  }
+  float device_scale_factor = root_view->GetDeviceScaleFactor();
+  gfx::PointF point = gfx::ConvertPointToPixels(event.PositionInWidget(),
+                                                device_scale_factor);
+  gfx::PointF in_root = to_view.InverseMapPoint(point).value_or(point);
+  gfx::PointF in_sink;
+  if (!query->TransformLocationForTarget(
+          {sink, root_view->GetFrameSinkId(), root_view->GetRootFrameSinkId()},
+          in_root, &in_sink)) {
+    return true;  // The sink went away; drop the rest of the drag.
+  }
+  RouteToForeign(root_view, sink,
+                 gfx::ConvertPointToDips(in_sink, device_scale_factor), event);
+  return true;
+}
+
+bool RenderWidgetHostInputEventRouter::RouteToForeignFrameSink(
+    RenderWidgetHostViewInput* root_view,
+    RenderWidgetHostViewInput* queried_view,
+    const viz::FrameSinkId& frame_sink_id,
+    const gfx::PointF& location,
+    const blink::WebInputEvent& event) {
+  if (!blink::WebInputEvent::IsMouseEventType(event.GetType()) &&
+      event.GetType() != blink::WebInputEvent::Type::kMouseWheel) {
+    return false;
+  }
+  const auto& mouse_event = static_cast<const blink::WebMouseEvent&>(event);
+  if (RouteToForeignCapture(root_view, mouse_event)) {
+    return true;
+  }
+  if (!IsForeignFrameSink(frame_sink_id) ||
+      !ForeignDelegate()->IsEmbeddedIn(frame_sink_id,
+                                       queried_view->GetFrameSinkId())) {
+    return false;
+  }
+  if (event.GetType() == blink::WebInputEvent::Type::kMouseDown) {
+    foreign_capture_sink_ = frame_sink_id;
+  }
+  RouteToForeign(root_view, frame_sink_id, location, mouse_event);
+  return true;
+}
+
+void RenderWidgetHostInputEventRouter::RouteToForeign(
+    RenderWidgetHostViewInput* root_view,
+    const viz::FrameSinkId& frame_sink_id,
+    const gfx::PointF& location,
+    const blink::WebMouseEvent& event) {
+  // EXO-BROKER: the last check before input reaches a native window. Every
+  // caller has checked already; this also covers a capture or hover that
+  // outlived the link (grant revoked mid-drag).
+  if (!IsForeignFrameSinkEmbeddedHere(frame_sink_id)) {
+    if (foreign_capture_sink_ == frame_sink_id) {
+      foreign_capture_sink_ = viz::FrameSinkId();
+    }
+    return;
+  }
+  page_mouse_down_ = false;
+  if (foreign_hover_sink_ != frame_sink_id) {
+    ForeignHoverLeave();
+    foreign_hover_sink_ = frame_sink_id;
+    foreign_hover_root_view_ = root_view;
+    ForeignHoverRouters()[frame_sink_id] = this;
+  }
+  ForeignDelegate()->RouteMouseEvent(frame_sink_id, location, event);
