+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// EXO-BROKER: a native window as NativeWindowBroker lists it.
+dictionary NativeWindowEntry {
+    // The broker's window id (not a capability).
+    required long id;
+    required DOMString appId;
+    required DOMString title;
+    // Window size in CSS pixels at zoom 1 (DIPs).
+    required unsigned long width;
+    required unsigned long height;
+    required double deviceScaleFactor;
+    // An element shows it / it has embedded keyboard focus.
+    required boolean embedded;
+    required boolean focused;
+};
