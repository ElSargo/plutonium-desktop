+#include "mojo/public/cpp/bindings/remote_set.h"
+#include "services/network/public/cpp/is_potentially_trustworthy.h"
+#include "third_party/blink/public/mojom/native_window/window_broker.mojom.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace plutonium_shell {
+
+namespace {
+
+std::optional<url::Origin> ParseShellOrigin() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kShellOriginSwitch)) {
+    return std::nullopt;
+  }
+  GURL url(command_line->GetSwitchValueASCII(kShellOriginSwitch));
+  url::Origin origin = url::Origin::Create(url);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || origin.opaque() ||
+      !network::IsOriginPotentiallyTrustworthy(origin)) {
+    LOG(ERROR) << "EXO-BROKER: ignoring --" << kShellOriginSwitch << "="
+               << url.possibly_invalid_spec()
+               << " (needs an http(s) origin that is https, localhost or "
+                  "loopback)";
+    return std::nullopt;
+  }
+  LOG(WARNING) << "EXO-BROKER: shell origin is " << origin;
+  return origin;
+}
+
+// Whether |url| (a document or navigation URL) is the shell origin's.
+bool IsShellUrl(const GURL& url) {
+  const std::optional<url::Origin>& shell = GetShellOrigin();
+  return shell && url.SchemeIsHTTPOrHTTPS() &&
+         url::Origin::Create(url) == *shell;
+}
+
+blink::mojom::NativeWindowEntryPtr ToMojo(
+    const ExoWindowBroker::WindowInfo& window) {
+  return blink::mojom::NativeWindowEntry::New(
+      window.id, window.app_id, base::UTF16ToUTF8(window.title),
+      window.size.width(), window.size.height(), window.device_scale_factor,
+      window.embedded, window.focused);
+}
+
+std::vector<blink::mojom::NativeWindowEntryPtr> CurrentWindows() {
+  std::vector<blink::mojom::NativeWindowEntryPtr> result;
+  if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+    for (const ExoWindowBroker::WindowInfo& window : broker->GetWindows()) {
+      result.push_back(ToMojo(window));
+    }
+  }
+  return result;
+}
+
+// Force-enables the shell origin trial (which exposes navigator.windowBroker)
+// for navigations that will commit a shell document. This only decides what
+// script sees; the binder re-checks the committed document.
+class ShellNavigationThrottle : public content::NavigationThrottle {
+ public:
+  using content::NavigationThrottle::NavigationThrottle;
+
+  ThrottleCheckResult WillProcessResponse() override {
+    content::NavigationHandle& handle = *navigation_handle();
+    if (!handle.IsSameDocument() && handle.IsInPrimaryMainFrame() &&
+        !handle.GetWebContents()->GetOuterWebContents() &&
+        IsShellUrl(handle.GetURL())) {
+      VLOG(1) << "EXO-BROKER exposing the shell API to "
+              << handle.GetURL().spec();
+      handle.ForceEnableOriginTrials({kShellOriginTrial});
+    }
+    return PROCEED;
+  }
+
+  const char* GetNameForLogging() override {
+    return "PlutoniumShellNavigationThrottle";
+  }
+};
+
+// The shell document's window broker API. One per binding; lives as long as
+// the document (or until the pipe closes).
+class WindowBrokerImpl
+    : public content::DocumentService<blink::mojom::WindowBroker>,
+      public ExoWindowBroker::Observer {
+ public:
+  WindowBrokerImpl(content::RenderFrameHost& render_frame_host,
+                   mojo::PendingReceiver<blink::mojom::WindowBroker> receiver)
+      : DocumentService(render_frame_host, std::move(receiver)) {
+    // Outlives this: BindWindowBroker() needs the broker, and documents go
+    // away before ExoParts does.
+    ExoWindowBroker::Get()->AddObserver(this);
+  }
+
+  ~WindowBrokerImpl() override {
+    if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+      broker->RemoveObserver(this);
+    }
+  }
+
+  // blink::mojom::WindowBroker:
+  void GetWindows(GetWindowsCallback callback) override {
+    std::move(callback).Run(StillShell() ? CurrentWindows()
+                                         : CurrentWindowsNone());
+  }
+
+  void AddObserver(
+      mojo::PendingAssociatedRemote<blink::mojom::WindowBrokerObserver>
+          observer,
+      AddObserverCallback callback) override {
+    if (!StillShell()) {
+      std::move(callback).Run(CurrentWindowsNone());
+      return;
+    }
+    observers_.Add(std::move(observer));
+    VLOG(1) << "EXO-BROKER shell observer added (" << observers_.size()
+            << " on this document)";
+    // Sent before any later event on the (associated) observer.
+    std::move(callback).Run(CurrentWindows());
+  }
+
+  void RequestGrant(int32_t window_id,
+                    RequestGrantCallback callback) override {
+    ExoWindowBroker* broker = ExoWindowBroker::Get();
+    if (!StillShell() || !broker) {
+      std::move(callback).Run(std::nullopt);
+      return;
+    }
+    std::optional<base::UnguessableToken> grant =
+        broker->IssueGrant(&render_frame_host(), window_id);
+    if (!grant) {
+      VLOG(1) << "EXO-BROKER shell grant refused: no window #" << window_id;
+    }
+    std::move(callback).Run(grant);
+  }
+
+  void RevokeGrant(const base::UnguessableToken& grant) override {
+    ExoWindowBroker* broker = ExoWindowBroker::Get();
+    // Only grants this document holds.
+    if (broker && broker->ResolveGrant(grant, &render_frame_host())) {
+      broker->RevokeGrant(grant);
+    }
+  }
+
+  // ExoWindowBroker::Observer:
+  void OnWindowAdded(const ExoWindowBroker::WindowInfo& window) override {
+    if (observers_.empty() || !StillShell()) {
+      return;
+    }
+    for (auto& observer : observers_) {
+      observer->OnWindowAdded(ToMojo(window));
+    }
+  }
+  void OnWindowChanged(const ExoWindowBroker::WindowInfo& window) override {
+    if (observers_.empty() || !StillShell()) {
+      return;
+    }
+    for (auto& observer : observers_) {
+      observer->OnWindowChanged(ToMojo(window));
+    }
+  }
+  void OnWindowRemoved(int32_t window_id) override {
+    if (observers_.empty() || !StillShell()) {
+      return;
+    }
+    for (auto& observer : observers_) {
+      observer->OnWindowRemoved(window_id);
+    }
+  }
+
+ private:
+  static std::vector<blink::mojom::NativeWindowEntryPtr> CurrentWindowsNone() {
+    return {};
+  }
+
+  // The document can't change under a DocumentService, but whether it is
+  // in the primary page can (e.g. it may be back/forward-cached). Checked
+  // again before every call, belt and braces.
+  bool StillShell() { return IsShellDocument(&render_frame_host()); }
+
+  mojo::AssociatedRemoteSet<blink::mojom::WindowBrokerObserver> observers_;
+};
+
+}  // namespace
+
+const std::optional<url::Origin>& GetShellOrigin() {
+  static const base::NoDestructor<std::optional<url::Origin>> origin(
+      ParseShellOrigin());
+  return *origin;
+}
+
+bool IsShellDocument(content::RenderFrameHost* render_frame_host) {
+  const std::optional<url::Origin>& shell = GetShellOrigin();
+  if (!shell || !render_frame_host ||
+      !render_frame_host->IsInPrimaryMainFrame() ||
+      !render_frame_host->IsRenderFrameLive() ||
+      render_frame_host->IsErrorDocument()) {
+    return false;
+  }
+  content::WebContents* web_contents =
+      content::WebContents::FromRenderFrameHost(render_frame_host);
+  if (!web_contents || web_contents->GetOuterWebContents()) {
+    return false;
+  }
+  return render_frame_host->GetLastCommittedOrigin() == *shell &&
+         IsShellUrl(render_frame_host->GetLastCommittedURL());
+}
+
+void MaybeAddNavigationThrottle(content::NavigationThrottleRegistry& registry) {
+  if (!GetShellOrigin() ||
+      !registry.GetNavigationHandle().IsInPrimaryMainFrame()) {
+    return;
+  }
+  registry.AddThrottle(std::make_unique<ShellNavigationThrottle>(registry));
+}
+
+void BindWindowBroker(
+    content::RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<blink::mojom::WindowBroker> receiver) {
+  if (!ExoWindowBroker::Get()) {
+    return;
+  }
+  if (!IsShellDocument(render_frame_host)) {
+    // A renderer only asks when script sees navigator.windowBroker, which
+    // the browser exposes to the shell document only (or to everything with
+    // --enable-blink-features=PlutoniumShell, for testing this check).
+    // Nothing is bound: the pipe just closes.
+    VLOG(1) << "EXO-BROKER shell API refused for frame "
+            << render_frame_host->GetGlobalId() << " ("
+            << render_frame_host->GetLastCommittedURL().spec() << ")";
+    return;
+  }
+  VLOG(1) << "EXO-BROKER shell API bound for frame "
+          << render_frame_host->GetGlobalId();
+  new WindowBrokerImpl(*render_frame_host, std::move(receiver));
+}
+
+}  // namespace plutonium_shell
