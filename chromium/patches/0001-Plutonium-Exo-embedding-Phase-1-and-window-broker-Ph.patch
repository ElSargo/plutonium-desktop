+bool RenderWidgetHostInputEventRouter::MaybeRouteToForeignFrameSink(
+    RenderWidgetHostViewInput* root_view,
+    const blink::WebMouseEvent& event) {
+  if (!ForeignDelegate()) {
+    return false;
+  }
+  const auto type = event.GetType();
+  if (type == blink::WebInputEvent::Type::kMouseLeave) {
+    ForeignHoverLeave();
+    return false;
+  }
+  if (type != blink::WebInputEvent::Type::kMouseMove &&
+      type != blink::WebInputEvent::Type::kMouseDown &&
+      type != blink::WebInputEvent::Type::kMouseUp &&
+      type != blink::WebInputEvent::Type::kMouseWheel) {
+    return false;
+  }
+  // Keep event order: while the targeter is resolving earlier events
+  // asynchronously, later ones queue behind them (see FindViewAtLocation()).
+  if (event_targeter_->HasEventsPendingDispatch()) {
+    return false;
+  }
+  if (RouteToForeignCapture(root_view, event)) {
+    return true;
+  }
+  // A drag that started on page content stays with the page.
+  if (page_mouse_down_) {
+    return false;
+  }
+
+  viz::HitTestQuery* query =
+      GetHitTestQuery(hit_test_provider_, root_view->GetRootFrameSinkId());
+  if (!query) {
+    return false;
+  }
+  float device_scale_factor = root_view->GetDeviceScaleFactor();
+  viz::Target target = query->FindTargetForLocationStartingFrom(
+      viz::EventSource::MOUSE,
+      gfx::ConvertPointToPixels(event.PositionInWidget(), device_scale_factor),
+      root_view->GetFrameSinkId());
+  // Foreign sinks are those without a view. Regions that viz marks "ask"
+  // (page content may overlap the sink) go through the targeter, which asks
+  // the renderer; see RouteToForeignFrameSink(). EXO-BROKER: only sinks the
+  // browser linked to one of this page's widgets (after checking a grant)
+  // take input.
