+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// EXO-BROKER: the Plutonium shell's window broker API (navigator.windowBroker).
+// Exposed only to the shell document: the browser force-enables the
+// PlutoniumShell origin trial for shell navigations, and refuses to bind the
+// broker for any other document regardless.
+[
+    Exposed=Window,
+    RuntimeEnabled=PlutoniumShell,
+    SecureContext
+] interface NativeWindowBroker : EventTarget {
+    // The current native windows.
+    [CallWith=ScriptState] Promise<sequence<NativeWindowEntry>> getWindows();
+    // A grant for window |windowId|, for <native-window grant=…> elements in
+    // this document. Rejects (NotAllowedError) if there is no such window.
+    [CallWith=ScriptState] Promise<DOMString> requestGrant(long windowId);
+    // Revokes a grant this document holds; elements using it detach and fire
+    // "windowclose".
+    undefined revokeGrant(DOMString grant);
+
+    // NativeWindowEvents. Adding the first listener for any of these
+    // subscribes; the current windows then arrive as "windowadded" events,
+    // followed by every later change, with no gap or overlap between the two.
+    attribute EventHandler onwindowadded;
+    attribute EventHandler onwindowchanged;
+    attribute EventHandler onwindowremoved;
+};
