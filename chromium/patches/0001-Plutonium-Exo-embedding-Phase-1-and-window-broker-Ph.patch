diff --git a/third_party/blink/renderer/core/html/native_window_broker.cc b/third_party/blink/renderer/core/html/native_window_broker.cc
new file mode 100644
index 0000000000..cd72eb426d
--- /dev/null
+++ b/third_party/blink/renderer/core/html/native_window_broker.cc
@@ -0,0 +1,232 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/html/native_window_broker.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/unguessable_token.h"
+#include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
+#include "third_party/blink/renderer/bindings/core/v8/script_promise_resolver.h"
+#include "third_party/blink/renderer/bindings/core/v8/v8_native_window_entry.h"
+#include "third_party/blink/renderer/core/dom/dom_exception.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/html/native_window_event.h"
+#include "third_party/blink/renderer/platform/wtf/functional.h"
+
+namespace blink {
+
+namespace {
+
+NativeWindowEntry* ToEntry(const mojom::blink::NativeWindowEntry& window) {
+  auto* entry = NativeWindowEntry::Create();
+  entry->setId(window.id);
+  entry->setAppId(window.app_id);
+  entry->setTitle(window.title);
+  entry->setWidth(window.width);
+  entry->setHeight(window.height);
+  entry->setDeviceScaleFactor(window.device_scale_factor);
+  entry->setEmbedded(window.embedded);
+  entry->setFocused(window.focused);
+  return entry;
+}
+
+}  // namespace
+
+NativeWindowBroker::NativeWindowBroker(ExecutionContext* context)
+    : ExecutionContextClient(context),
+      remote_(context),
+      observer_receiver_(this, context) {}
+
+bool NativeWindowBroker::BindRemote() {
+  ExecutionContext* context = GetExecutionContext();
+  if (!context || disconnected_) {
+    return false;
+  }
+  if (!remote_.is_bound()) {
+    context->GetBrowserInterfaceBroker().GetInterface(
+        remote_.BindNewPipeAndPassReceiver(
+            context->GetTaskRunner(TaskType::kInternalDefault)));
+    remote_.set_disconnect_handler(BindOnce(
+        &NativeWindowBroker::OnDisconnected, WrapWeakPersistent(this)));
+  }
+  return true;
+}
+
+bool NativeWindowBroker::EnsureBound(ScriptPromiseResolverBase* resolver) {
+  if (!BindRemote()) {
+    resolver->RejectWithDOMException(DOMExceptionCode::kNotAllowedError,
+                                     "The window broker is not available.");
+    return false;
+  }
+  pending_.insert(resolver);
+  return true;
+}
+
+void NativeWindowBroker::AddedEventListener(
+    const AtomicString& event_type,
+    RegisteredEventListener& registered_listener) {
+  EventTarget::AddedEventListener(event_type, registered_listener);
+  if (event_type == event_type_names::kWindowadded ||
+      event_type == event_type_names::kWindowchanged ||
+      event_type == event_type_names::kWindowremoved) {
+    Subscribe();
+  }
+}
+
+void NativeWindowBroker::Subscribe() {
+  if (observer_receiver_.is_bound() || !BindRemote()) {
+    return;
+  }
+  // Associated with |remote_|'s pipe: the snapshot reply is ordered before
+  // every event sent after it. A refused binding drops both.
+  remote_->AddObserver(
+      observer_receiver_.BindNewEndpointAndPassRemote(
+          GetExecutionContext()->GetTaskRunner(TaskType::kInternalDefault)),
+      BindOnce(&NativeWindowBroker::OnSnapshot, WrapWeakPersistent(this)));
+}
+
+void NativeWindowBroker::OnSnapshot(
+    Vector<mojom::blink::NativeWindowEntryPtr> windows) {
+  for (auto& window : windows) {
+    OnWindowAdded(std::move(window));
+  }
+}
+
+void NativeWindowBroker::OnWindowAdded(
+    mojom::blink::NativeWindowEntryPtr window) {
+  if (!GetExecutionContext()) {
+    return;
+  }
+  DispatchEvent(*MakeGarbageCollected<NativeWindowEvent>(
+      event_type_names::kWindowadded, window->id, ToEntry(*window)));
+}
+
+void NativeWindowBroker::OnWindowChanged(
+    mojom::blink::NativeWindowEntryPtr window) {
+  if (!GetExecutionContext()) {
+    return;
+  }
+  DispatchEvent(*MakeGarbageCollected<NativeWindowEvent>(
+      event_type_names::kWindowchanged, window->id, ToEntry(*window)));
+}
+
+void NativeWindowBroker::OnWindowRemoved(int32_t window_id) {
+  if (!GetExecutionContext()) {
+    return;
+  }
+  DispatchEvent(*MakeGarbageCollected<NativeWindowEvent>(
+      event_type_names::kWindowremoved, window_id, nullptr));
+}
+
+void NativeWindowBroker::OnDisconnected() {
+  disconnected_ = true;
+  remote_.reset();
+  observer_receiver_.reset();
+  HeapHashSet<Member<ScriptPromiseResolverBase>> pending;
+  pending.swap(pending_);
+  for (ScriptPromiseResolverBase* resolver : pending) {
+    resolver->RejectWithDOMException(DOMExceptionCode::kNotAllowedError,
+                                     "The window broker is not available.");
+  }
+}
+
+ScriptPromise<IDLSequence<NativeWindowEntry>> NativeWindowBroker::getWindows(
+    ScriptState* script_state) {
+  auto* resolver = MakeGarbageCollected<
+      ScriptPromiseResolver<IDLSequence<NativeWindowEntry>>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->GetWindows(BindOnce(
+      [](NativeWindowBroker* self,
+         ScriptPromiseResolver<IDLSequence<NativeWindowEntry>>* resolver,
+         Vector<mojom::blink::NativeWindowEntryPtr> windows) {
+        self->pending_.erase(resolver);
+        HeapVector<Member<NativeWindowEntry>> result;
+        for (const auto& window : windows) {
+          result.push_back(ToEntry(*window));
+        }
+        resolver->Resolve(result);
+      },
+      WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+ScriptPromise<IDLString> NativeWindowBroker::requestGrant(
+    ScriptState* script_state,
+    int32_t window_id) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLString>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->RequestGrant(
+      window_id,
+      BindOnce(
+          [](NativeWindowBroker* self,
+             ScriptPromiseResolver<IDLString>* resolver,
+             const std::optional<base::UnguessableToken>& grant) {
+            self->pending_.erase(resolver);
+            if (!grant) {
+              resolver->RejectWithDOMException(
+                  DOMExceptionCode::kNotAllowedError, "No such window.");
+              return;
+            }
+            resolver->Resolve(String(grant->ToString()));
+          },
+          WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+void NativeWindowBroker::revokeGrant(const String& grant) {
+  std::optional<base::UnguessableToken> token =
+      base::UnguessableToken::DeserializeFromString(grant.Utf8());
+  if (!token || disconnected_ || !GetExecutionContext()) {
+    return;
+  }
+  if (!remote_.is_bound()) {
+    // Nothing to revoke: this document never got a grant from us.
+    return;
+  }
+  remote_->RevokeGrant(*token);
+}
+
+void NativeWindowBroker::Trace(Visitor* visitor) const {
+  visitor->Trace(remote_);
+  visitor->Trace(observer_receiver_);
+  visitor->Trace(pending_);
+  EventTarget::Trace(visitor);
+  ExecutionContextClient::Trace(visitor);
+}
+
+const char NavigatorNativeWindowBroker::kSupplementName[] =
+    "NavigatorNativeWindowBroker";
+
+// static
+NativeWindowBroker* NavigatorNativeWindowBroker::windowBroker(
+    Navigator& navigator) {
+  auto* supplement =
+      Supplement<Navigator>::From<NavigatorNativeWindowBroker>(navigator);
+  if (!supplement) {
+    supplement = MakeGarbageCollected<NavigatorNativeWindowBroker>(navigator);
+    ProvideTo(navigator, supplement);
+  }
+  return supplement->broker_.Get();
+}
+
+NavigatorNativeWindowBroker::NavigatorNativeWindowBroker(Navigator& navigator)
+    : Supplement(navigator),
+      broker_(MakeGarbageCollected<NativeWindowBroker>(
+          navigator.GetExecutionContext())) {}
+
+void NavigatorNativeWindowBroker::Trace(Visitor* visitor) const {
+  visitor->Trace(broker_);
+  Supplement<Navigator>::Trace(visitor);
+}
+
+}  // namespace blink
