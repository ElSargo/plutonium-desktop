+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/html/html_native_window_element.h"
+
+#include <utility>
+
+#include "cc/layers/surface_layer.h"
+#include "third_party/blink/renderer/bindings/core/v8/script_promise_resolver.h"
+#include "components/viz/common/surfaces/local_surface_id.h"
+#include "components/viz/common/surfaces/surface_id.h"
+#include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/dom/events/event.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/html/parser/html_parser_idioms.h"
+#include "third_party/blink/renderer/core/html_names.h"
+#include "third_party/blink/renderer/core/layout/layout_native_window.h"
+#include "third_party/blink/renderer/platform/wtf/functional.h"
+#include "ui/gfx/geometry/size_conversions.h"
+#include "ui/gfx/geometry/vector2d_conversions.h"
+
+namespace blink {
+
+namespace {
+
+// The element embeds the window's surface range [current, current + this],
+// so viz keeps drawing the window's latest surface as it resizes without the
+// page having to follow every new surface id.
+constexpr uint32_t kSurfaceRangeSpan = 1u << 30;
+
+}  // namespace
+
+HTMLNativeWindowElement::HTMLNativeWindowElement(Document& document)
+    : HTMLElement(html_names::kNativeWindowTag, document),
+      host_(document.GetExecutionContext()),
+      client_receiver_(this, document.GetExecutionContext()) {}
+
+HTMLNativeWindowElement::~HTMLNativeWindowElement() = default;
+
+String HTMLNativeWindowElement::windowState() const {
+  if (!attach_requested_) {
+    return "none";
+  }
+  if (closed_) {
+    return "closed";
+  }
+  if (!client_receiver_.is_bound()) {
+    return "failed";
+  }
+  return info_ ? "attached" : "attaching";
+}
+
+String HTMLNativeWindowElement::windowTitle() const {
+  return info_ ? info_->title : g_empty_string;
+}
+
+String HTMLNativeWindowElement::appId() const {
+  return info_ ? info_->app_id : g_empty_string;
+}
+
+unsigned HTMLNativeWindowElement::windowWidth() const {
+  return info_ ? info_->geometry.width() : 0;
+}
+
+unsigned HTMLNativeWindowElement::windowHeight() const {
+  return info_ ? info_->geometry.height() : 0;
+}
+
+bool HTMLNativeWindowElement::windowFocused() const {
+  return info_ && info_->focused;
+}
+
+int32_t HTMLNativeWindowElement::windowId() const {
+  return info_ ? info_->window_id : 0;
+}
+
+void HTMLNativeWindowElement::focusWindow() {
+  if (info_ && host_.is_bound()) {
+    host_->Focus();
+  }
+}
+
+void HTMLNativeWindowElement::blurWindow() {
+  if (info_ && host_.is_bound()) {
+    host_->Blur();
+  }
+}
+
+cc::Layer* HTMLNativeWindowElement::ContentsCcLayer() const {
+  return surface_layer_.get();
+}
+
+gfx::Size HTMLNativeWindowElement::WindowSizeInPixels() const {
+  if (!info_) {
+    return gfx::Size();
+  }
+  return gfx::ToRoundedSize(gfx::ScaleSize(gfx::SizeF(info_->geometry.size()),
+                                           info_->device_scale_factor));
+}
+
+gfx::Vector2d HTMLNativeWindowElement::GeometryOffsetInPixels() const {
+  if (!info_) {
+    return gfx::Vector2d();
+  }
+  return gfx::ToRoundedVector2d(gfx::ScaleVector2d(
+      info_->geometry.OffsetFromOrigin(), info_->device_scale_factor));
+}
+
+void HTMLNativeWindowElement::ContentSizeChanged(
+    const gfx::Size& size_in_pixels) {
+  // Only ask the window to resize once it is known, and only to sizes the
+  // page chose: an element without a CSS size takes the window's size.
+  if (!info_ || !host_.is_bound() || size_in_pixels.IsEmpty() ||
+      size_in_pixels == last_sent_size_ ||
+      size_in_pixels == WindowSizeInPixels()) {
+    return;
+  }
+  last_sent_size_ = size_in_pixels;
+  host_->SetSize(size_in_pixels);
+}
+
+viz::FrameSinkId HTMLNativeWindowElement::EmbeddedFrameSinkId() const {
+  return info_ ? info_->surface_id.frame_sink_id() : viz::FrameSinkId();
+}
+
+void HTMLNativeWindowElement::Trace(Visitor* visitor) const {
+  visitor->Trace(host_);
+  visitor->Trace(client_receiver_);
+  HTMLElement::Trace(visitor);
+}
+
+void HTMLNativeWindowElement::ParseAttribute(
+    const AttributeModificationParams& params) {
+  if (params.name == html_names::kWindowAttr ||
+      params.name == html_names::kGrantAttr) {
+    UpdateAttachment();
+    return;
+  }
+  HTMLElement::ParseAttribute(params);
+}
+
+LayoutObject* HTMLNativeWindowElement::CreateLayoutObject(
+    const ComputedStyle&) {
+  return MakeGarbageCollected<LayoutNativeWindow>(this);
+}
+
+Node::InsertionNotificationRequest HTMLNativeWindowElement::InsertedInto(
+    ContainerNode& insertion_point) {
+  HTMLElement::InsertedInto(insertion_point);
+  UpdateAttachment();
+  return kInsertionDone;
+}
+
+void HTMLNativeWindowElement::RemovedFrom(ContainerNode& insertion_point) {
+  HTMLElement::RemovedFrom(insertion_point);
+  UpdateAttachment();
+}
+
+void HTMLNativeWindowElement::OnInfoChanged(
+    mojom::blink::NativeWindowInfoPtr info) {
+  const bool size_changed =
+      !info_ || info_->geometry.size() != info->geometry.size() ||
+      info_->device_scale_factor != info->device_scale_factor;
+  const bool focus_changed =
+      info_ ? info_->focused != info->focused : info->focused;
+  info_ = std::move(info);
+  UpdateSurfaceLayer();
+  if (auto* layout_object = DynamicTo<LayoutNativeWindow>(GetLayoutObject())) {
+    if (size_changed) {
+      layout_object->NaturalSizeChanged();
+    }
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+  DispatchSimpleEvent("windowchange");
+  if (focus_changed) {
+    DispatchSimpleEvent(info_->focused ? "windowfocus" : "windowblur");
+  }
+}
+
+void HTMLNativeWindowElement::OnClosed() {
+  closed_ = true;
+  client_receiver_.reset();
+  info_.reset();
+  UpdateSurfaceLayer();
+  if (auto* layout_object = DynamicTo<LayoutNativeWindow>(GetLayoutObject())) {
+    layout_object->NaturalSizeChanged();
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+  DispatchSimpleEvent("windowclose");
+}
+
+void HTMLNativeWindowElement::UpdateAttachment() {
+  bool attach_requested = false;
+  std::optional<base::UnguessableToken> grant;
+  int32_t window_id = 0;
+  if (isConnected() && GetExecutionContext()) {
+    const AtomicString& grant_attr = FastGetAttribute(html_names::kGrantAttr);
+    if (!grant_attr.empty()) {
+      attach_requested = true;
+      grant = base::UnguessableToken::DeserializeFromString(
+          grant_attr.GetString().Utf8());
+      int value = 0;
+      if (ParseHTMLInteger(FastGetAttribute(html_names::kWindowAttr), value) &&
+          value > 0) {
+        window_id = value;
+      }
+    }
+  }
+  if (attach_requested == attach_requested_ && grant == grant_ &&
+      window_id == window_id_) {
+    return;
+  }
+  DetachWindow();
+  if (!attach_requested) {
+    return;
+  }
+  attach_requested_ = true;
+  grant_ = grant;
+  window_id_ = window_id;
+  const uint64_t attach_id = ++attach_id_;
+  ExecutionContext* context = GetExecutionContext();
+  scoped_refptr<base::SingleThreadTaskRunner> task_runner =
+      context->GetTaskRunner(TaskType::kInternalDefault);
+  if (!grant) {
+    // Not a token at all: fail without asking the browser, but just as
+    // asynchronously.
+    task_runner->PostTask(
+        FROM_HERE, BindOnce(&HTMLNativeWindowElement::OnAttached,
+                            WrapWeakPersistent(this), attach_id, false));
+    return;
+  }
+  BindHost();
+  host_->Attach(*grant, window_id,
+                client_receiver_.BindNewPipeAndPassRemote(task_runner),
+                BindOnce(&HTMLNativeWindowElement::OnAttached,
+                         WrapWeakPersistent(this), attach_id));
+}
+
+void HTMLNativeWindowElement::BindHost() {
+  if (host_.is_bound()) {
+    return;
+  }
+  ExecutionContext* context = GetExecutionContext();
+  context->GetBrowserInterfaceBroker().GetInterface(
+      host_.BindNewPipeAndPassReceiver(
+          context->GetTaskRunner(TaskType::kInternalDefault)));
+}
+
+void HTMLNativeWindowElement::DetachWindow() {
+  if (!attach_requested_) {
+    return;
+  }
+  if (host_.is_bound() && client_receiver_.is_bound()) {
+    host_->Detach();
+  }
+  client_receiver_.reset();
+  attach_requested_ = false;
+  grant_.reset();
+  window_id_ = 0;
+  closed_ = false;
+  last_sent_size_ = gfx::Size();
+  const bool had_info = !!info_;
+  info_.reset();
+  UpdateSurfaceLayer();
+  if (auto* layout_object = DynamicTo<LayoutNativeWindow>(GetLayoutObject())) {
+    if (had_info) {
+      layout_object->NaturalSizeChanged();
+    }
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+}
+
+void HTMLNativeWindowElement::OnAttached(uint64_t attach_id, bool success) {
+  if (attach_id != attach_id_ || !attach_requested_ || success) {
+    return;
+  }
+  // EXO-BROKER: refused (no valid grant for this document, or the window
+  // can't be embedded).
+  client_receiver_.reset();
+  DispatchSimpleEvent("windowchange");
+  DispatchSimpleEvent("windowerror");
+}
+
+void HTMLNativeWindowElement::UpdateSurfaceLayer() {
+  if (!info_ || !info_->surface_id.is_valid()) {
+    surface_layer_ = nullptr;
+    return;
+  }
+  const viz::SurfaceId& current = info_->surface_id;
+  const viz::LocalSurfaceId& lsi = current.local_surface_id();
+  viz::SurfaceId range_end(
+      current.frame_sink_id(),
+      viz::LocalSurfaceId(lsi.parent_sequence_number() + kSurfaceRangeSpan,
+                          lsi.child_sequence_number() + kSurfaceRangeSpan,
+                          lsi.embed_token()));
+  if (!surface_layer_) {
+    surface_layer_ = cc::SurfaceLayer::Create();
+    surface_layer_->SetStretchContentToFillBounds(false);
+    surface_layer_->SetSurfaceHitTestable(true);
+    surface_layer_->SetIsDrawable(true);
+  }
+  surface_layer_->SetOldestAcceptableFallback(current);
+  surface_layer_->SetSurfaceId(range_end,
+                               cc::DeadlinePolicy::UseSpecifiedDeadline(0));
+}
+
+void HTMLNativeWindowElement::DispatchSimpleEvent(const char* type) {
+  DispatchEvent(*Event::Create(AtomicString(type)));
+}
+
+}  // namespace blink
