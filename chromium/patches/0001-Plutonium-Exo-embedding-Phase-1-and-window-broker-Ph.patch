+
+void RenderWidgetHostInputEventRouter::OnPageMouseEvent(
+    const blink::WebMouseEvent& event) {
+  if (!ForeignDelegate()) {
+    return;
+  }
+  ForeignHoverLeave();
+  if (event.GetType() == blink::WebInputEvent::Type::kMouseDown) {
+    ForeignDelegate()->PageMouseDown();
+  }
+  page_mouse_down_ = ButtonsDownAfter(event);
+}
+
+void RenderWidgetHostInputEventRouter::ForeignHoverLeave() {
+  if (!foreign_hover_sink_.is_valid()) {
+    return;
+  }
+  viz::FrameSinkId sink = foreign_hover_sink_;
+  auto it = ForeignHoverRouters().find(sink);
+  if (it != ForeignHoverRouters().end() && it->second == this) {
+    ForeignHoverRouters().erase(it);
