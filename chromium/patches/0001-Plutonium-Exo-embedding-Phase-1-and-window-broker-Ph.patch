+
+// Runs the target's handler chain (including Exo's Pointer, a pre-target
+// handler) without WindowEventDispatcher's bookkeeping. Dispatching injected
+// events through the real dispatcher made it record the Exo window as the
+// implicit press-capture target, stealing the real mouse release from the
+// page.
+class EmbeddedEventDispatcher : public ui::EventDispatcherDelegate {
+ public:
+  bool CanDispatchToTarget(ui::EventTarget* target) override { return true; }
+};
+
+void Dispatch(aura::Window* target, ui::Event* event) {
+  ui::EventDispatchDetails details =
+      EmbeddedEventDispatcher().DispatchEvent(target, event);
+  (void)details;
+}
