+class Surface;
+
+// Event property set on pointer events the browser routes into an embedded
+// window, and additionally on the synthetic exit sent when the pointer leaves.
+inline constexpr char kEmbeddedEventKey[] = "exo-embedded";
+inline constexpr char kEmbeddedLeaveEventKey[] = "exo-embedded-leave";
+
+// EXO-EMBED: shows Exo toplevels as elements in web pages.
+//
+// Every toplevel gets a stable window id. While at least one page element is
+// attached to a window, the window is "parked": its Ash window keeps drawing
+// but is invisible, can't be activated and takes no real input. The page
+// presents the window's surface, and the browser routes input to it through
+// this class: pointer events arrive already hit-tested into surface
+// coordinates, and keyboard focus is given to the window while the page that
+// embeds it keeps aura focus (see Seat::SetEmbeddedFocus()).
+class EmbeddedWindows : public aura::WindowObserver {
+ public:
+  struct Info {
+    Info();
+    Info(const Info&);
+    Info& operator=(const Info&);
+    ~Info();
+    bool operator==(const Info&) const;
+
+    // The window's latest surface (its whole surface tree).
+    viz::SurfaceId surface_id;
+    // The window geometry (what the user sees as the window, without client
+    // side shadows) in surface coordinates, DIPs.
+    gfx::Rect geometry;
+    float device_scale_factor = 1.f;
+    std::string app_id;
+    std::u16string title;
+    // Whether the window has embedded keyboard focus.
+    bool focused = false;
+    // EXO-BROKER: whether at least one page element is attached (the window
+    // is parked).
+    bool attached = false;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // Title, app id, geometry, surface, focus or attachment changed. The
+    // first call for a window with a valid GetInfo() is when it becomes
+    // embeddable (it has a surface).
+    virtual void OnEmbeddedWindowChanged(int32_t window_id) {}
+    virtual void OnEmbeddedWindowDestroyed(int32_t window_id) {}
+  };
+
+  // Receives the app's cursor while the pointer is over its embedded surface.
+  using CursorCallback =
+      base::RepeatingCallback<void(const viz::FrameSinkId& frame_sink_id,
+                                   const ui::Cursor& cursor)>;
+
+  static EmbeddedWindows* Get();
+
+  EmbeddedWindows(const EmbeddedWindows&) = delete;
+  EmbeddedWindows& operator=(const EmbeddedWindows&) = delete;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Windows.
+  std::vector<int32_t> GetWindowIds() const;
+  std::optional<Info> GetInfo(int32_t window_id) const;
+  viz::FrameSinkId GetFrameSinkId(int32_t window_id) const;
+  // Returns 0 if |frame_sink_id| isn't an embeddable window.
+  int32_t GetWindowIdForFrameSink(const viz::FrameSinkId& frame_sink_id) const;
+
+  // Embedding. Attach() and Detach() are counted; the window is parked while
+  // the count is non-zero.
+  void Attach(int32_t window_id);
+  void Detach(int32_t window_id);
+  // Asks the app to resize its window geometry to |size| (DIPs).
+  void SetSize(int32_t window_id, const gfx::Size& size);
+
+  // Whether at least one page element is attached to |window_id|. Keyboard
+  // focus and pointer input are only given to attached windows.
+  bool IsAttached(int32_t window_id) const;
+
+  // Keyboard focus. |owner| is the aura window that has aura focus on behalf
+  // of the embedded window (the page's view); the app keeps keyboard focus
+  // while |owner| is focused.
+  void Focus(int32_t window_id, aura::Window* owner);
+  void Blur(int32_t window_id);
+  void ClearFocus();
+  int32_t focused_window_id() const { return focused_window_id_; }
+
+  // Pointer input from the browser. |location| is in the window's surface
+  // coordinates (DIPs), |screen_location| is where that point is on screen.
+  // A press gives the window keyboard focus.
+  void DispatchMouseEvent(const viz::FrameSinkId& frame_sink_id,
+                          const gfx::PointF& location,
+                          const gfx::PointF& screen_location,
+                          std::unique_ptr<ui::MouseEvent> event);
+  // The pointer left the embedded surface of |frame_sink_id|.
+  void PointerLeave(const viz::FrameSinkId& frame_sink_id);
+  void SetCursorCallback(CursorCallback callback);
+
+  // Exo-internal hooks.
+  void OnToplevelCreated(ShellSurfaceBase* shell_surface);
+  void OnToplevelChanged(ShellSurfaceBase* shell_surface);
+  void OnToplevelDestroying(ShellSurfaceBase* shell_surface);
+  void AddSeat(Seat* seat);
+  void RemoveSeat(Seat* seat);
+  // Called by Pointer when the app sets a cursor while |surface| has embedded
+  // pointer focus.
+  void OnEmbeddedCursorChanged(Surface* surface, const ui::Cursor& cursor);
+
+  // aura::WindowObserver:
+  void OnWindowDestroying(aura::Window* window) override;
+
+ private:
+  friend class base::NoDestructor<EmbeddedWindows>;
+
+  struct Entry {
+    raw_ptr<ShellSurfaceBase> shell_surface;
+    int attach_count = 0;
+    std::optional<Info> last_info;
+  };
+
+  EmbeddedWindows();
+  ~EmbeddedWindows() override;
+
+  int32_t FindWindowId(const ShellSurfaceBase* shell_surface) const;
+  ShellSurfaceBase* FindShellSurface(int32_t window_id) const;
+  std::optional<Info> ComputeInfo(int32_t window_id) const;
+  void NotifyIfChanged(int32_t window_id);
+  void SetSeatsFocus(Surface* surface, aura::Window* owner);
+  void DoDispatchMouseEvent(int32_t window_id,
+                            const gfx::PointF& location,
+                            const gfx::PointF& screen_location,
+                            std::unique_ptr<ui::MouseEvent> event);
+
+  std::map<int32_t, Entry> windows_;
+  int32_t next_window_id_ = 1;
+  std::vector<raw_ptr<Seat>> seats_;
+
+  int32_t focused_window_id_ = 0;
+  raw_ptr<aura::Window> focus_owner_ = nullptr;
+
+  CursorCallback cursor_callback_;
+  base::ObserverList<Observer> observers_;
+};
+
