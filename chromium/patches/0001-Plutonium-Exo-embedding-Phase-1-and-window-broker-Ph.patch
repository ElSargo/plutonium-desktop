+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HTML_NATIVE_WINDOW_BROKER_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HTML_NATIVE_WINDOW_BROKER_H_
+
+#include "third_party/blink/public/mojom/native_window/window_broker.mojom-blink.h"
+#include "third_party/blink/renderer/bindings/core/v8/idl_types.h"
+#include "third_party/blink/renderer/bindings/core/v8/script_promise.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/core/dom/events/event_target.h"
+#include "third_party/blink/renderer/core/event_target_names.h"
+#include "third_party/blink/renderer/core/event_type_names.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context_lifecycle_observer.h"
+#include "third_party/blink/renderer/core/frame/navigator.h"
+#include "third_party/blink/renderer/platform/bindings/script_wrappable.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_hash_set.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/mojo/heap_mojo_associated_receiver.h"
+#include "third_party/blink/renderer/platform/mojo/heap_mojo_remote.h"
+#include "third_party/blink/renderer/platform/supplementable.h"
+
+namespace blink {
+
+class NativeWindowEntry;
+class ScriptPromiseResolverBase;
+
+// EXO-BROKER: navigator.windowBroker, the shell's window broker API. Talks to
+// blink.mojom.WindowBroker, which the browser only binds for the shell
+// document; elsewhere the pipe closes and every call rejects.
+//
+// Push events: adding the first "windowadded" / "windowchanged" /
+// "windowremoved" listener subscribes (WindowBroker.AddObserver). The
+// snapshot that subscribing returns is dispatched as one "windowadded" per
+// existing window, then every later change follows, so a page that listens
+// before anything else builds its whole window list from events. The
+// observer is associated with the broker pipe, so the snapshot can't race
+// the events. Subscribing is one-shot per document (removing listeners
+// doesn't unsubscribe).
+class CORE_EXPORT NativeWindowBroker final
+    : public EventTarget,
+      public ExecutionContextClient,
+      public mojom::blink::WindowBrokerObserver {
+  DEFINE_WRAPPERTYPEINFO();
+
+ public:
+  explicit NativeWindowBroker(ExecutionContext*);
+
+  ScriptPromise<IDLSequence<NativeWindowEntry>> getWindows(ScriptState*);
+  ScriptPromise<IDLString> requestGrant(ScriptState*, int32_t window_id);
+  void revokeGrant(const String& grant);
+
+  DEFINE_ATTRIBUTE_EVENT_LISTENER(windowadded, kWindowadded)
+  DEFINE_ATTRIBUTE_EVENT_LISTENER(windowchanged, kWindowchanged)
+  DEFINE_ATTRIBUTE_EVENT_LISTENER(windowremoved, kWindowremoved)
+
+  // EventTarget:
+  const AtomicString& InterfaceName() const override {
+    return event_target_names::kNativeWindowBroker;
+  }
+  ExecutionContext* GetExecutionContext() const override {
+    return ExecutionContextClient::GetExecutionContext();
+  }
+
+  // mojom::blink::WindowBrokerObserver:
+  void OnWindowAdded(mojom::blink::NativeWindowEntryPtr window) override;
+  void OnWindowChanged(mojom::blink::NativeWindowEntryPtr window) override;
+  void OnWindowRemoved(int32_t window_id) override;
+
+  void Trace(Visitor*) const override;
+
+ protected:
+  // EventTarget:
+  void AddedEventListener(const AtomicString& event_type,
+                          RegisteredEventListener&) override;
+
+ private:
+  // False (and |resolver| rejected) if the broker can't be reached.
+  bool EnsureBound(ScriptPromiseResolverBase* resolver);
+  // Binds |remote_| if needed; false if the broker can't be reached.
+  bool BindRemote();
+  void Subscribe();
+  void OnSnapshot(Vector<mojom::blink::NativeWindowEntryPtr> windows);
+  void OnDisconnected();
+
+  HeapMojoRemote<mojom::blink::WindowBroker> remote_;
+  HeapMojoAssociatedReceiver<mojom::blink::WindowBrokerObserver,
+                             NativeWindowBroker>
+      observer_receiver_;
+  bool disconnected_ = false;
+  // Calls in flight, rejected if the pipe closes.
+  HeapHashSet<Member<ScriptPromiseResolverBase>> pending_;
+};
+
+class CORE_EXPORT NavigatorNativeWindowBroker final
+    : public GarbageCollected<NavigatorNativeWindowBroker>,
+      public Supplement<Navigator> {
+ public:
+  static const char kSupplementName[];
+
+  static NativeWindowBroker* windowBroker(Navigator& navigator);
+
+  explicit NavigatorNativeWindowBroker(Navigator&);
+
+  void Trace(Visitor*) const override;
+
+ private:
+  Member<NativeWindowBroker> broker_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HTML_NATIVE_WINDOW_BROKER_H_
