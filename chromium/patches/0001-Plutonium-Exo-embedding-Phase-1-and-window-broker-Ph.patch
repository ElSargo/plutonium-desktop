+      foreign_hover_root_view_->GetCursorManager()) {
+    foreign_hover_root_view_->GetCursorManager()->SetForeignCursor(
+        std::nullopt);
+  }
+  foreign_hover_sink_ = viz::FrameSinkId();
+  foreign_hover_root_view_ = nullptr;
+  if (ForeignDelegate()) {
+    ForeignDelegate()->PointerLeft(sink);
+  }
+}
