@@ -0,0 +1,61 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module blink.mojom;
+
+import "mojo/public/mojom/base/unguessable_token.mojom";
+import "services/viz/public/mojom/compositing/surface_id.mojom";
+import "ui/gfx/geometry/mojom/geometry.mojom";
+
+// EXO-EMBED: lets a <native-window> element show a native (Wayland) window
+// from the browser's window list and route input to it.
+//
+// EXO-BROKER: embedding needs a grant, an opaque token the browser's window
+// broker (ExoWindowBroker) issued to this document for one window. Without
+// a valid grant nothing is attached, no frame sinks are linked and no input
+// reaches the window. Grants come from the shell-only WindowBroker
+// (window_broker.mojom), and attaching is also refused outside the shell
+// document.
+
+struct NativeWindowInfo {
+  // The broker's id for the window (not a capability).
+  int32 window_id;
+  // The window's latest surface. The element embeds this surface and any
+  // later one from the same frame sink.
+  viz.mojom.SurfaceId surface_id;
+  // The window geometry in surface coordinates (DIPs). The element shows
+  // this part of the surface, without client-side shadows.
+  gfx.mojom.Rect geometry;
+  // Scale of the window's surface (pixels per DIP).
+  float device_scale_factor;
+  string title;
+  string app_id;
+  // Whether the window has keyboard focus.
+  bool focused;
+};
+
+interface NativeWindowClient {
+  // Sent on attach and whenever the info changes.
+  OnInfoChanged(NativeWindowInfo info);
+  // The window was closed; no more messages follow.
+  OnClosed();
+};
+
+// One per element. Bound through the frame's BrowserInterfaceBroker.
+interface NativeWindowHost {
+  // Embeds the window that |grant| is for in this frame. |grant| must have
+  // been issued to this frame's current document. If |window_id| isn't 0 the
+  // grant must also be for that window. Replies false, and attaches nothing,
+  // otherwise. If the grant is revoked later (window closed, grant revoked
+  // by the broker) the window is detached and the client gets OnClosed().
+  Attach(mojo_base.mojom.UnguessableToken grant,
+         int32 window_id,
+         pending_remote<NativeWindowClient> client) => (bool success);
+  Detach();
+  // Asks the app to resize its window to |size| pixels.
+  SetSize(gfx.mojom.Size size_in_pixels);
+  // Gives the window keyboard focus, or takes it back.
+  Focus();
+  Blur();
+};
diff --git a/third_party/blink/public/mojom/native_window/window_broker.mojom b/third_party/blink/public/mojom/native_window/window_broker.mojom
new file mode 100644
index 0000000000..18d1f39824
--- /dev/null
+++ b/third_party/blink/public/mojom/native_window/window_broker.mojom
@@ -0,0 +1,58 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module blink.mojom;
+
+import "mojo/public/mojom/base/unguessable_token.mojom";
+
+// EXO-BROKER: the privileged shell's window broker API.
+//
+// Bound only for the shell document: the primary main frame of a top-level
+// WebContents whose committed URL and origin are the origin given by
+// --plutonium-shell-origin (see chrome/browser/plutonium_shell.h). Any other
+// frame's receiver is dropped. The JS API (navigator.windowBroker) is only
+// exposed to that document too, but the browser-side check is the security
+// boundary.
+
+// A native window as the broker lists it.
+struct NativeWindowEntry {
+  // The broker's window id. Stable and never reused; not a capability.
+  int32 id;
+  string app_id;
+  string title;
+  // Window geometry size in DIPs.
+  int32 width;
+  int32 height;
+  float device_scale_factor;
+  // Whether an element shows the window, and whether it has embedded
+  // keyboard focus.
+  bool embedded;
+  bool focused;
+};
+
+// Window lifecycle events, surfaced to script as navigator.windowBroker's
+// "windowadded", "windowchanged" and "windowremoved" events.
+interface WindowBrokerObserver {
+  OnWindowAdded(NativeWindowEntry window);
+  OnWindowChanged(NativeWindowEntry window);
+  OnWindowRemoved(int32 window_id);
+};
+
+interface WindowBroker {
+  // The current windows.
+  GetWindows() => (array<NativeWindowEntry> windows);
+  // The current windows, then every later change through |observer|.
+  // |observer| is associated with this pipe, so the reply (the snapshot) is
+  // ordered before any event that follows it: nothing is missed or seen
+  // twice between the snapshot and the first event.
+  AddObserver(pending_associated_remote<WindowBrokerObserver> observer)
+      => (array<NativeWindowEntry> windows);
+  // Issues a grant for |window_id| to this (the shell's) document: a
+  // <native-window grant=…> in this document may then show the window. Null
+  // if there is no such window.
+  RequestGrant(int32 window_id) => (mojo_base.mojom.UnguessableToken? grant);
+  // Revokes a grant this document holds (elements using it detach and fire
+  // "windowclose"). Grants issued to other documents are left alone.
+  RevokeGrant(mojo_base.mojom.UnguessableToken grant);
+};
