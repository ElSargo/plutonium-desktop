+// EXO-EMBED: <native-window grant="TOKEN" [window="ID"]> shows the native
+// (Wayland) window that grant TOKEN is for as a replaced element. EXO-BROKER:
+// the grant must have been issued by the browser's window broker to this
+// document (and be for window ID, if given); otherwise nothing is attached
+// and "windowerror" fires. The window draws as
+// a composited layer in the page and receives the pointer input that lands on
+// the element; clicking it gives the window keyboard focus.
+//
+// Sizing: without a CSS size the element takes the window's size. With a CSS
+// size the window is asked to resize to the element.
+class CORE_EXPORT HTMLNativeWindowElement final
+    : public HTMLElement,
+      public mojom::blink::NativeWindowClient {
+  DEFINE_WRAPPERTYPEINFO();
+
+ public:
+  explicit HTMLNativeWindowElement(Document&);
+  ~HTMLNativeWindowElement() override;
+
+  ElementType GetElementType() const final {
+    return ElementType::kHTMLNativeWindowElement;
+  }
+
+  // IDL.
+  String windowState() const;
+  String windowTitle() const;
+  String appId() const;
+  unsigned windowWidth() const;
+  unsigned windowHeight() const;
+  bool windowFocused() const;
+  int32_t windowId() const;
+  void focusWindow();
+  void blurWindow();
+
+  // For LayoutNativeWindow.
+  cc::Layer* ContentsCcLayer() const;
+  // The window's size in pixels; empty until the window is known.
+  gfx::Size WindowSizeInPixels() const;
+  // Where the window geometry starts inside the surface, in pixels.
+  gfx::Vector2d GeometryOffsetInPixels() const;
+  // Called on paint with the element's content box size in pixels.
+  void ContentSizeChanged(const gfx::Size& size_in_pixels);
+
+  // For hit testing (WebFrameWidgetImpl): the embedded window's frame sink.
+  viz::FrameSinkId EmbeddedFrameSinkId() const;
+
+  void Trace(Visitor*) const override;
+
+ private:
+  // HTMLElement:
+  void ParseAttribute(const AttributeModificationParams&) override;
+  LayoutObject* CreateLayoutObject(const ComputedStyle&) override;
+  InsertionNotificationRequest InsertedInto(ContainerNode&) override;
+  void RemovedFrom(ContainerNode&) override;
+
+  // mojom::blink::NativeWindowClient:
+  void OnInfoChanged(mojom::blink::NativeWindowInfoPtr info) override;
+  void OnClosed() override;
+
+  // Attaches with the "grant" (and "window") attributes while connected.
+  void UpdateAttachment();
+  void DetachWindow();
+  void BindHost();
+  void OnAttached(uint64_t attach_id, bool success);
+  void UpdateSurfaceLayer();
+  void DispatchSimpleEvent(const char* type);
+
+  HeapMojoRemote<mojom::blink::NativeWindowHost> host_;
+  HeapMojoReceiver<mojom::blink::NativeWindowClient, HTMLNativeWindowElement>
+      client_receiver_;
+  // Whether the element has a "grant" and is connected, and what it asked
+  // for. |grant_| is empty if the attribute isn't a valid token.
+  bool attach_requested_ = false;
+  std::optional<base::UnguessableToken> grant_;
+  int32_t window_id_ = 0;
+  // Identifies the current attach request, for OnAttached().
+  uint64_t attach_id_ = 0;
+  bool closed_ = false;
+  mojom::blink::NativeWindowInfoPtr info_;
+  scoped_refptr<cc::SurfaceLayer> surface_layer_;
+  gfx::Size last_sent_size_;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HTML_HTML_NATIVE_WINDOW_ELEMENT_H_
