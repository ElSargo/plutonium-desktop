+void PlutoniumTabs::SendDevToolsCommand(int32_t tab_id,
+                                        const std::string& method,
+                                        const std::string& params_json,
+                                        DevToolsCallback callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Tab* tab = FindTab(tab_id);
+  if (!tab) {
+    std::move(callback).Run(false, "No such tab");
+    return;
+  }
+  tab->devtools()->Send(method, params_json, std::move(callback));
+}
