From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sarol263@student.otago.ac.nz>
Date: Tue, 20 Oct 2026 12:11:03 +1300
Subject: [PATCH 26/52] Plutonium: a tab's context menu item runs with the tab
 focused

While the shell draws a tab's menu, the shell page has the keyboard
(ClearFocusOnInnerWebContents). Items that act on the focused frame,
such as spelling suggestions, paste, cut, undo, delete and select all,
then ran against nothing: picking a spelling suggestion did nothing. The
shell focusing the tab's <embed> again arrives later, over another pipe.

The tab now gets its focus back, with the frame and element it had
(SurfaceEmbedConnector::FocusInnerWebContents), before the item runs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/plutonium_context_menu.cc             | 12 ++++++++++++
 .../surface_embed/surface_embed_connector_impl.cc    | 10 ++++++++++
 .../surface_embed/surface_embed_connector_impl.h     |  1 +
 content/public/browser/surface_embed_connector.h     |  4 ++++
 4 files changed, 27 insertions(+)

diff --git a/chrome/browser/plutonium_context_menu.cc b/chrome/browser/plutonium_context_menu.cc
index d3a98b7273..c9870650d9 100644
--- a/chrome/browser/plutonium_context_menu.cc
+++ b/chrome/browser/plutonium_context_menu.cc
@@ -300,6 +300,18 @@ class Pending {
               ContextMenuItemType::kSubmenu) {
         VLOG(1) << "EXO-CHROME menu #" << self->id_ << ": running "
                 << target.model->GetCommandIdAt(target.index);
+        // A tab's menu: the tab gets back the focus it gave the shell first.
+        // Spelling suggestions, paste, cut, undo, select all and the like
+        // act on the focused frame; without it they did nothing. (The shell
+        // focusing its <embed> again comes later, over another pipe.)
+        if (self->shown_ && self->source_ != self->shell_) {
+          if (content::SurfaceEmbedConnector* connector =
+                  self->source_->GetSurfaceEmbedConnector()) {
+            connector->FocusInnerWebContents();
+          } else {
+            self->source_->Focus();
+          }
+        }
         target.model->ActivatedAt(target.index, /*event_flags=*/0);
       }
     }
diff --git a/content/browser/surface_embed/surface_embed_connector_impl.cc b/content/browser/surface_embed/surface_embed_connector_impl.cc
index 25a35f343a..6cd8bb8e7d 100644
--- a/content/browser/surface_embed/surface_embed_connector_impl.cc
+++ b/content/browser/surface_embed/surface_embed_connector_impl.cc
@@ -366,6 +366,16 @@ void SurfaceEmbedConnectorImpl::ClearFocusOnInnerWebContents() {
       ->SetAsFocusedWebContentsIfNecessary();
 }
 
+void SurfaceEmbedConnectorImpl::FocusInnerWebContents() {
+  if (!parent_web_contents_) {
+    CHECK_IS_TEST();
+    return;
+  }
+  // The child's frame tree keeps its focused frame while it doesn't have
+  // focus, so this is where focus was.
+  child_web_contents()->SetAsFocusedWebContentsIfNecessary();
+}
+
 WebContentsImpl* SurfaceEmbedConnectorImpl::parent_web_contents() const {
   return static_cast<WebContentsImpl*>(parent_web_contents_.get());
 }
diff --git a/content/browser/surface_embed/surface_embed_connector_impl.h b/content/browser/surface_embed/surface_embed_connector_impl.h
index 9875858118..36dfd1a513 100644
--- a/content/browser/surface_embed/surface_embed_connector_impl.h
+++ b/content/browser/surface_embed/surface_embed_connector_impl.h
@@ -166,6 +166,7 @@ class CONTENT_EXPORT SurfaceEmbedConnectorImpl
   FrameTree* GetFocusFrameTreeIfContainsFocus();
   void SetFocusedFrameTree(FrameTree* frame_tree_to_focus);
   void ClearFocusOnInnerWebContents() override;
+  void FocusInnerWebContents() override;
 
   // Returns true if any WebContents in the parent chain has a pointer lock
   // widget.
diff --git a/content/public/browser/surface_embed_connector.h b/content/public/browser/surface_embed_connector.h
index dcff47efce..6cb3284900 100644
--- a/content/public/browser/surface_embed_connector.h
+++ b/content/public/browser/surface_embed_connector.h
@@ -105,6 +105,10 @@ class CONTENT_EXPORT SurfaceEmbedConnector {
   // the root WebContents (the embedder's page keeps its focused element).
   virtual void ClearFocusOnInnerWebContents() = 0;
 
+  // PLUTONIUM (EXO-CHROME): gives the child WebContents focus again, with
+  // the frame and element it had (the embedding element gets focus too).
+  virtual void FocusInnerWebContents() = 0;
+
   // Called when the visibility of the parent frame changes.
   virtual void OnVisibilityChanged(
       blink::mojom::FrameVisibility visibility) = 0;
