+END_METADATA
+
+// The indicator's contents: a line per capture, with a Stop button.
+std::unique_ptr<views::View> BuildIndicator(
+    const std::vector<base::DictValue>& captures) {
+  auto view = std::make_unique<views::View>();
+  view->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(8, 12), 6));
+  view->SetBackground(views::CreateRoundedRectBackground(kPanel, 10));
+  for (const base::DictValue& capture : captures) {
+    auto* row = AddBox(view.get(), views::BoxLayout::Orientation::kHorizontal,
+                       10);
+    auto* dot = row->AddChildView(std::make_unique<views::View>());
+    dot->SetPreferredSize(gfx::Size(10, 10));
+    dot->SetBackground(views::CreateRoundedRectBackground(kRecording, 5));
+    const base::DictValue* consumer = capture.FindDict("consumer");
+    const std::string* name =
+        consumer ? consumer->FindString("name") : nullptr;
+    const std::string* label = capture.FindString("label");
+    AddLabel(row,
+             base::UTF8ToUTF16((name && !name->empty() ? *name : "An app") +
+                               " is capturing " +
+                               (label ? *label : std::string("the screen"))),
+             kTitle);
+    const int id = capture.FindInt("id").value_or(0);
+    AddButton(row, u"Stop", base::BindRepeating([](int id) {
+                PlutoniumCapture::Get()->Stop(id);
+              }, id),
+              kButton, kTitle);
+  }
+  return view;
+}
+
+}  // namespace
+
+PlutoniumCaptureUi::PlutoniumCaptureUi() {
+  PlutoniumCapture::Get()->SetUi(this);
+}
+
+PlutoniumCaptureUi::~PlutoniumCaptureUi() {
+  PlutoniumCapture::Get()->SetUi(nullptr);
+}
+
+void PlutoniumCaptureUi::Pick(
+    const base::DictValue& request,
+    base::OnceCallback<void(std::optional<base::Value>)> done) {
+  // One at a time: the one open is refused.
+  if (done_) {
+    std::move(done_).Run(std::nullopt);
+  }
+  ClosePicker();
+  aura::Window* root = ash::Shell::HasInstance()
+                           ? ash::Shell::GetRootWindowForNewWindows()
+                           : nullptr;
+  if (!root) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  picking_ = request.FindInt("requestId").value_or(0);
+  done_ = std::move(done);
+
+  auto view = std::make_unique<PickerView>(
+      request, base::BindRepeating(&PlutoniumCaptureUi::OnPicked,
+                                   weak_factory_.GetWeakPtr(), picking_));
+  const gfx::Rect work_area =
+      display::Screen::Get()->GetDisplayNearestWindow(root).work_area();
+  const int width = std::min(kPickerWidth, work_area.width() * 9 / 10);
+  const int height =
+      std::min(view->GetHeightForWidth(width), work_area.height() * 9 / 10);
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.name = "PlutoniumCapturePicker";
+  params.parent =
+      ash::Shell::GetContainer(root, ash::kShellWindowId_OverlayContainer);
+  params.bounds = gfx::Rect(work_area.x() + (work_area.width() - width) / 2,
+                            work_area.y() + (work_area.height() - height) / 2,
+                            width, height);
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  picker_ = std::make_unique<views::Widget>(std::move(params));
+  picker_->SetContentsView(std::move(view));
+  picker_->Show();
+  picker_->Activate();
+  VLOG(1) << "EXO-CAPTURE Ash's picker asks (request #" << picking_ << ")";
+}
+
+void PlutoniumCaptureUi::CancelPick(int32_t request_id) {
+  if (picking_ != request_id) {
+    return;
+  }
+  done_.Reset();
+  ClosePicker();
+}
+
+void PlutoniumCaptureUi::OnPicked(int32_t request_id,
+                                  std::optional<base::Value> answer) {
+  if (picking_ != request_id || !done_) {
+    return;
+  }
+  ClosePicker();
+  std::move(done_).Run(std::move(answer));
+}
+
+void PlutoniumCaptureUi::ClosePicker() {
+  picking_ = 0;
+  if (!picker_) {
+    return;
+  }
+  // Not from inside one of the widget's own calls (a key or a click).
+  base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(picker_));
+  FocusShell();
+}
+
+void PlutoniumCaptureUi::ShowIndicator(
+    const std::vector<base::DictValue>& captures) {
+  if (captures.empty()) {
+    if (indicator_) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+          FROM_HERE, std::move(indicator_));
+    }
+    return;
+  }
+  aura::Window* root = ash::Shell::HasInstance()
+                           ? ash::Shell::GetPrimaryRootWindow()
+                           : nullptr;
+  if (!root) {
+    return;
+  }
+  if (!indicator_) {
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.name = "PlutoniumCaptureIndicator";
+    params.parent =
+        ash::Shell::GetContainer(root, ash::kShellWindowId_OverlayContainer);
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.activatable = views::Widget::InitParams::Activatable::kNo;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    indicator_ = std::make_unique<views::Widget>(std::move(params));
+  }
+  views::View* view = indicator_->SetContentsView(BuildIndicator(captures));
+  const gfx::Size size = view->GetPreferredSize();
+  const gfx::Rect work_area =
+      display::Screen::Get()->GetDisplayNearestWindow(root).work_area();
+  indicator_->SetBounds(gfx::Rect(work_area.right() - size.width() - 16,
+                                  work_area.y() + 16, size.width(),
+                                  size.height()));
+  indicator_->ShowInactive();
+}
