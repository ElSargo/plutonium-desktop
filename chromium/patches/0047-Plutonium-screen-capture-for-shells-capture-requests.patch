+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// EXO-CAPTURE: navigator.windowBroker's capture events
+// (docs/features/CAPTURE.md): "capturerequest" (cancelable: preventDefault()
+// takes the request, and the page answers it with the "answer" capture
+// command; else Ash's own picker asks), "capturerequestend" (one this page
+// took is over), "capturestart", "capturechange", "capturestop" and
+// "capturesettingschange".
+[
+    Exposed=Window,
+    RuntimeEnabled=PlutoniumShell,
+    SecureContext
+] interface ShellCaptureEvent : Event {
+    // The capture's id, or the request's (0 for "capturesettingschange").
+    readonly attribute long id;
+    // A fresh object on every read: the request's detail ({requestId, kind,
+    // consumer, types, multiple, cursorModes}), the capture ({id, kind,
+    // source, label, consumer, size?, cursor, nodeId?, startTime,
+    // acknowledged}), or the settings ({recording, screenshots}); null for
+    // "capturerequestend".
+    [CallWith=ScriptState] readonly attribute any detail;
+};
