+    uint32_t node_id = 0;
+    // Stops it for real (the stream's own stop).
+    base::RepeatingClosure stop;
+    // A captured window keeps drawing at full rate, also parked.
+    base::ScopedClosureRunner keep_drawing;
+    // The shell documents that say they show it.
+    std::set<content::GlobalRenderFrameHostId> acknowledged_by;
+    // "stream": the id its getUserMedia() uses, until it does.
+    std::string stream_id;
+  };
+
+  struct PendingRequest {
+    PendingRequest();
+    ~PendingRequest();
+    int32_t id = 0;
+    base::DictValue detail;
+    AnswerCallback done;
+    // The broker connection that took it, or 0.
+    int32_t taker = 0;
+    // Ash's picker asks.
+    bool picking = false;
+  };
+
+  PlutoniumCapture();
+  ~PlutoniumCapture() override;
+
+  base::DictValue ToValue(const Capture& capture) const;
+  bool IsAcknowledged(const Capture& capture) const;
+  void Notify(const Capture& capture, bool started, bool stopped);
+
+  base::expected<base::Value, std::string> RunShellCommand(
+      const std::string& command,
+      const base::DictValue& args,
+      content::RenderFrameHost* frame,
+      int32_t taker);
+  base::expected<base::DictValue, std::string> RegisterStream(
+      const base::DictValue& args,
+      content::RenderFrameHost* frame);
+  base::expected<base::Value, std::string> SetSettings(
+      const base::DictValue& args);
+  base::expected<base::Value, std::string> SetSize(int32_t id,
+                                                   const base::DictValue& args);
+  void Acknowledge(int32_t id, content::RenderFrameHost* frame);
+
+  // Requests.
+  void OnTaken(int32_t request_id, int32_t taker);
+  void Pick(int32_t request_id);
+  void OnPicked(int32_t request_id, std::optional<base::Value> answer);
+  // A valid answer to request |request_id|, normalized, or why not.
+  base::expected<base::Value, std::string> CheckAnswer(
+      const PendingRequest& request,
+      const base::Value& answer) const;
+  bool Answer(int32_t request_id, int32_t taker, const base::Value& answer);
+  void Finish(int32_t request_id, std::optional<base::Value> answer);
+
+  // Captures.
+  Capture* Find(int32_t id);
+  int32_t Add(std::unique_ptr<Capture> capture);
+  void OnStreamStarted(int32_t id, base::RepeatingClosure stop);
+  void Remove(int32_t id);
+  // A window's capture size: the newest capture's that holds one.
+  void UpdateCaptureSize(int64_t window_id);
+  void UpdateIndicator();
+  void DropUnusedStream(int32_t id);
+
+  void NotifySettings();
+
+  int32_t next_id_ = 1;
