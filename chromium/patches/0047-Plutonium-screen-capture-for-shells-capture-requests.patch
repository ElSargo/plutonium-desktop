+
+void PlutoniumHandler::CaptureCommand(
+    const std::string& command,
+    std::optional<std::string> args_json,
+    std::unique_ptr<CaptureCommandCallback> callback) {
+  PlutoniumCapture::Get()->RunCommand(
+      command, args_json.value_or(std::string()), /*frame=*/nullptr,
+      /*taker=*/0,
+      base::BindOnce(
+          [](std::unique_ptr<CaptureCommandCallback> callback, bool ok,
+             const std::string& result) {
+            if (!ok) {
+              callback->sendFailure(Response::InvalidParams(result));
+              return;
+            }
+            callback->sendSuccess(result);
+          },
+          std::move(callback)));
+}
+
+void PlutoniumHandler::Screenshot(const std::string& source_json,
+                                  std::unique_ptr<ScreenshotCallback> callback) {
+  std::optional<base::Value> parsed = base::JSONReader::Read(
+      source_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  std::optional<PlutoniumCapture::Source> source =
+      parsed ? PlutoniumCapture::Source::FromValue(*parsed) : std::nullopt;
+  if (!source) {
+    callback->sendFailure(Response::InvalidParams("Which source?"));
+    return;
+  }
+  PlutoniumCapture::Get()->Screenshot(
+      *source,
+      base::BindOnce(
+          [](std::unique_ptr<ScreenshotCallback> callback,
+             const SkBitmap& bitmap, const std::string& error) {
+            if (bitmap.drawsNothing()) {
+              callback->sendFailure(Response::ServerError(error));
+              return;
+            }
+            std::optional<std::vector<uint8_t>> data =
+                Encode(bitmap, /*jpeg=*/false, 0);
+            if (!data) {
+              callback->sendFailure(
+                  Response::ServerError("Couldn't encode the image"));
+              return;
+            }
+            callback->sendSuccess(
+                protocol::Binary::fromVector(std::move(*data)), bitmap.width(),
+                bitmap.height());
+          },
+          std::move(callback)));
+}
+
+void PlutoniumHandler::OnCaptureStarted(int32_t id,
+                                        const base::DictValue& capture) {
+  std::string json;
+  base::JSONWriter::Write(capture, &json);
+  frontend_->CaptureEvent("start", json);
+}
+
+void PlutoniumHandler::OnCaptureChanged(int32_t id,
+                                        const base::DictValue& capture) {
+  std::string json;
+  base::JSONWriter::Write(capture, &json);
+  frontend_->CaptureEvent("change", json);
+}
+
+void PlutoniumHandler::OnCaptureStopped(int32_t id,
+                                        const base::DictValue& capture) {
+  std::string json;
+  base::JSONWriter::Write(capture, &json);
+  frontend_->CaptureEvent("stop", json);
+}
+
+void PlutoniumHandler::OnCaptureSettingsChanged(
+    const base::DictValue& settings) {
+  std::string json;
+  base::JSONWriter::Write(settings, &json);
+  frontend_->CaptureEvent("settings", json);
+}
