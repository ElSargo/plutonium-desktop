+views::Label* AddLabel(views::View* parent,
+                       std::u16string_view text,
+                       SkColor color,
+                       int size_delta = 0,
+                       bool bold = false) {
+  auto* label = parent->AddChildView(std::make_unique<views::Label>(text));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetAutoColorReadabilityEnabled(false);
+  label->SetEnabledColor(color);
+  gfx::FontList font = gfx::FontList().DeriveWithSizeDelta(size_delta);
+  if (bold) {
+    font = font.DeriveWithWeight(gfx::Font::Weight::BOLD);
+  }
+  label->SetFontList(font);
+  label->SetElideBehavior(gfx::ELIDE_TAIL);
+  return label;
+}
+
+views::LabelButton* AddButton(views::View* parent,
+                              std::u16string_view text,
+                              base::RepeatingClosure action,
+                              SkColor background,
+                              SkColor color) {
+  auto* button = parent->AddChildView(std::make_unique<views::LabelButton>(
+      base::BindRepeating(
+          [](base::RepeatingClosure action, const ui::Event&) {
+            action.Run();
+          },
+          Deferred(std::move(action))),
+      text));
+  button->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(7, 14)));
+  button->SetEnabledTextColors(color);
+  button->SetTextColor(views::Button::STATE_DISABLED, kDim);
+  button->SetBackground(views::CreateRoundedRectBackground(background, 6));
+  return button;
+}
+
+views::View* AddBox(views::View* parent,
+                    views::BoxLayout::Orientation orientation,
+                    int spacing,
+                    const gfx::Insets& insets = gfx::Insets()) {
+  auto* box = parent->AddChildView(std::make_unique<views::View>());
+  auto* layout = box->SetLayoutManager(
+      std::make_unique<views::BoxLayout>(orientation, insets, spacing));
+  if (orientation == views::BoxLayout::Orientation::kHorizontal) {
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+  }
+  return box;
+}
