+
+void NativeWindowBroker::OnCaptureSnapshot(int subscription,
+                                           const Vector<String>& captures,
+                                           const String& settings) {
+  if (subscription != capture_subscription_ ||
+      !capture_observer_receiver_.is_bound() || !GetExecutionContext()) {
+    return;
+  }
+  OnCaptureSettingsChanged(settings);
+  for (const String& capture : captures) {
+    if (subscription != capture_subscription_ ||
+        !capture_observer_receiver_.is_bound()) {
+      return;
+    }
+    // The id is the capture's own; the browser reads it from the JSON too.
+    DispatchEvent(*MakeGarbageCollected<ShellCaptureEvent>(
+        event_type_names::kCapturestart, 0, capture));
+  }
+}
+
+void NativeWindowBroker::OnCaptureRequest(int32_t id,
+                                          const String& detail_json,
+                                          OnCaptureRequestCallback callback) {
+  if (!GetExecutionContext()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  auto* event = MakeGarbageCollected<ShellCaptureEvent>(
+      event_type_names::kCapturerequest, id, detail_json);
+  DispatchEvent(*event);
+  const bool taken = event->defaultPrevented();
+  if (taken) {
+    taken_capture_requests_.insert(id);
+  }
+  std::move(callback).Run(taken);
+}
+
+void NativeWindowBroker::OnCaptureRequestEnded(int32_t id) {
+  if (!taken_capture_requests_.Contains(id)) {
+    return;
+  }
+  taken_capture_requests_.erase(id);
+  DispatchEvent(*MakeGarbageCollected<ShellCaptureEvent>(
+      event_type_names::kCapturerequestend, id, String()));
+}
