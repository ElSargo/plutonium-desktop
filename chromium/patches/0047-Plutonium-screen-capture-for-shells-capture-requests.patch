+void EmbeddedWindows::SetCaptureSize(int32_t window_id,
+                                     const gfx::Size& size) {
+  auto it = windows_.find(window_id);
+  if (it == windows_.end() || it->second.capture_size == size) {
+    return;
+  }
+  it->second.capture_size = size;
+  VLOG(1) << "EXO-CAPTURE window #" << window_id << " held at "
+          << (size.IsEmpty() ? std::string("its element's size")
+                             : size.ToString());
+  if (window_id != presented_window_id_) {
+    it->second.shell_surface->SetEmbedSize(SizeFor(it->second));
+  }
+}
+
+gfx::Size EmbeddedWindows::GetCaptureSize(int32_t window_id) const {
+  auto it = windows_.find(window_id);
+  return it == windows_.end() ? gfx::Size() : it->second.capture_size;
+}
+
+aura::Window* EmbeddedWindows::GetCaptureWindow(int32_t window_id) const {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  views::Widget* widget = shell_surface ? shell_surface->GetWidget() : nullptr;
+  return widget ? widget->GetNativeWindow() : nullptr;
+}
