+base::DictValue PlutoniumCapture::GetSources() const {
+  base::ListValue outputs;
+  const std::vector<display::Display>& displays =
+      display::Screen::Get()->GetAllDisplays();
+  const int64_t primary = display::Screen::Get()->GetPrimaryDisplay().id();
+  for (size_t i = 0; i < displays.size(); ++i) {
+    const display::Display& display = displays[i];
+    outputs.Append(
+        base::DictValue()
+            .Set("id", base::NumberToString(display.id()))
+            .Set("name", DisplayName(display, i))
+            .Set("width", display.GetSizeInPixel().width())
+            .Set("height", display.GetSizeInPixel().height())
+            .Set("scaleFactor", display.device_scale_factor())
+            .Set("primary", display.id() == primary));
+  }
+  base::ListValue windows;
+  if (ExoWindowBroker* broker = ExoWindowBroker::Get()) {
+    for (const ExoWindowBroker::WindowInfo& window : broker->GetWindows()) {
+      base::ListValue tags;
+      for (const std::string& tag : window.tags) {
+        tags.Append(tag);
+      }
+      windows.Append(base::DictValue()
+                         .Set("id", window.id)
+                         .Set("title", base::UTF16ToUTF8(window.title))
+                         .Set("appId", window.app_id)
+                         .Set("width", window.size.width())
+                         .Set("height", window.size.height())
+                         .Set("tags", std::move(tags)));
+    }
+  }
+  base::ListValue tabs;
+  for (const PlutoniumTabs::TabInfo& tab : PlutoniumTabs::Get()->GetTabs()) {
+    base::ListValue tags;
+    for (const std::string& tag : tab.tags) {
+      tags.Append(tag);
+    }
+    tabs.Append(base::DictValue()
+                    .Set("id", tab.id)
+                    .Set("title", base::UTF16ToUTF8(tab.title))
+                    .Set("url", tab.url.spec())
+                    .Set("tags", std::move(tags)));
+  }
+  return base::DictValue()
+      .Set("outputs", std::move(outputs))
+      .Set("windows", std::move(windows))
+      .Set("tabs", std::move(tabs));
+}
+
+std::string PlutoniumCapture::LabelOf(const Source& source) const {
+  switch (source.type) {
+    case Source::Type::kOutput: {
+      const std::vector<display::Display>& displays =
+          display::Screen::Get()->GetAllDisplays();
+      for (size_t i = 0; i < displays.size(); ++i) {
+        if (displays[i].id() == source.id) {
+          return DisplayName(displays[i], i);
+        }
+      }
+      return "Display";
+    }
+    case Source::Type::kWindow: {
+      ExoWindowBroker* broker = ExoWindowBroker::Get();
+      std::optional<ExoWindowBroker::WindowInfo> window =
+          broker ? broker->GetWindow(static_cast<int32_t>(source.id))
+                 : std::nullopt;
+      if (!window) {
+        return "Window";
+      }
+      return window->title.empty() ? window->app_id
+                                   : base::UTF16ToUTF8(window->title);
+    }
+    case Source::Type::kTab: {
+      std::optional<PlutoniumTabs::TabInfo> tab =
+          PlutoniumTabs::Get()->GetTab(static_cast<int32_t>(source.id));
+      if (!tab) {
+        return "Tab";
+      }
+      return tab->title.empty() ? tab->url.spec()
+                                : base::UTF16ToUTF8(tab->title);
+    }
+  }
+  NOTREACHED();
+}
+
+content::DesktopMediaID PlutoniumCapture::ToMediaId(
+    const Source& source) const {
+  switch (source.type) {
+    case Source::Type::kOutput: {
+      aura::Window* root = ash::Shell::HasInstance()
+                               ? ash::Shell::GetRootWindowForDisplayId(
+                                     source.id)
+                               : nullptr;
+      if (!root) {
+        return content::DesktopMediaID();
+      }
+      return content::DesktopMediaID::RegisterNativeWindow(
+          content::DesktopMediaID::TYPE_SCREEN, root);
+    }
+    case Source::Type::kWindow: {
+      aura::Window* window = exo::EmbeddedWindows::Get()->GetCaptureWindow(
+          static_cast<int32_t>(source.id));
+      if (!window) {
+        return content::DesktopMediaID();
+      }
+      return content::DesktopMediaID::RegisterNativeWindow(
+          content::DesktopMediaID::TYPE_WINDOW, window);
+    }
+    case Source::Type::kTab: {
+      content::WebContents* contents =
+          PlutoniumTabs::Get()->GetContents(static_cast<int32_t>(source.id));
+      content::RenderFrameHost* frame =
+          contents ? contents->GetPrimaryMainFrame() : nullptr;
+      if (!frame) {
+        return content::DesktopMediaID();
+      }
+      return content::DesktopMediaID(
+          content::DesktopMediaID::TYPE_WEB_CONTENTS,
+          content::DesktopMediaID::kNullId,
+          content::WebContentsMediaCaptureId(
+              frame->GetProcess()->GetDeprecatedID(), frame->GetRoutingID()));
+    }
+  }
+  NOTREACHED();
+}
+
+void PlutoniumCapture::Screenshot(const Source& source,
+                                  ScreenshotCallback callback) {
+  if (!screenshots_allowed()) {
+    std::move(callback).Run(SkBitmap(), kScreenshotsOff);
+    return;
+  }
+  if (source.type == Source::Type::kOutput) {
+    std::optional<display::Display> display = FindDisplay(source.id);
+    aura::Window* root = display && ash::Shell::HasInstance()
+                             ? ash::Shell::GetRootWindowForDisplayId(source.id)
+                             : nullptr;
+    if (!root) {
+      std::move(callback).Run(SkBitmap(), kNoSource);
+      return;
+    }
+    // The region is in pixels; the copy is asked for in DIPs, and comes in
+    // pixels, cropped.
+    gfx::Rect area(root->bounds().size());
+    if (!source.region.IsEmpty()) {
+      area = gfx::ToEnclosingRect(gfx::ScaleRect(
+          gfx::RectF(source.region), 1.f / display->device_scale_factor()));
+      area.Intersect(gfx::Rect(root->bounds().size()));
+    }
+    ui::GrabWindowSnapshot(
+        root, area,
+        base::BindOnce(
+            [](ScreenshotCallback callback, gfx::Image image) {
+              SkBitmap bitmap =
+                  image.IsEmpty() ? SkBitmap() : image.AsBitmap();
+              std::move(callback).Run(
+                  bitmap, bitmap.drawsNothing() ? "The copy failed" : "");
+            },
+            std::move(callback)));
+    return;
+  }
+  auto crop = base::BindOnce(
+      [](const gfx::Rect& region, ScreenshotCallback callback,
+         const SkBitmap& bitmap) {
+        SkBitmap cropped = Crop(bitmap, region);
+        std::move(callback).Run(
+            cropped, cropped.drawsNothing() ? "The copy failed" : "");
+      },
+      source.region, std::move(callback));
+  const int32_t id = static_cast<int32_t>(source.id);
+  if (source.type == Source::Type::kWindow) {
+    ExoWindowBroker* broker = ExoWindowBroker::Get();
+    if (!broker || !broker->GetWindow(id)) {
+      std::move(crop).Run(SkBitmap());
+      return;
+    }
+    exo::EmbeddedWindows::Get()->Snapshot(id, std::move(crop));
+    return;
+  }
+  if (!PlutoniumTabs::Get()->GetTab(id)) {
+    std::move(crop).Run(SkBitmap());
+    return;
+  }
+  PlutoniumTabs::Get()->Snapshot(id, std::move(crop));
+}
+
+std::vector<base::DictValue> PlutoniumCapture::GetCaptures() const {
+  std::vector<base::DictValue> result;
+  for (const auto& [id, capture] : captures_) {
+    if (capture->started) {
+      result.push_back(ToValue(*capture));
+    }
+  }
+  return result;
+}
+
+base::DictValue PlutoniumCapture::ToValue(const Capture& capture) const {
+  base::DictValue value;
+  value.Set("id", capture.id);
+  value.Set("kind", capture.kind);
+  value.Set("source", capture.source.ToValue());
+  value.Set("label", LabelOf(capture.source));
+  value.Set("consumer", capture.consumer.Clone());
+  value.Set("cursor", capture.cursor);
+  value.Set("startTime", capture.start_time.InMillisecondsFSinceUnixEpochIgnoringNull());
+  value.Set("acknowledged", IsAcknowledged(capture));
+  if (!capture.size.IsEmpty()) {
+    value.Set("size", base::DictValue()
+                          .Set("width", capture.size.width())
+                          .Set("height", capture.size.height()));
+  }
+  if (capture.node_id) {
+    value.Set("nodeId", static_cast<int>(capture.node_id));
+  }
+  return value;
+}
+
+bool PlutoniumCapture::IsAcknowledged(const Capture& capture) const {
+  content::WebContents* shell = FocusedShell();
+  return shell && capture.acknowledged_by.contains(
+                      shell->GetPrimaryMainFrame()->GetGlobalId());
+}
+
+void PlutoniumCapture::Notify(const Capture& capture,
+                              bool started,
+                              bool stopped) {
+  const base::DictValue value = ToValue(capture);
+  for (Observer& observer : observers_) {
+    if (started) {
+      observer.OnCaptureStarted(capture.id, value);
+    } else if (stopped) {
+      observer.OnCaptureStopped(capture.id, value);
+    } else {
+      observer.OnCaptureChanged(capture.id, value);
+    }
+  }
+}
+
+void PlutoniumCapture::RunCommand(const std::string& command,
+                                  const std::string& args_json,
+                                  content::RenderFrameHost* frame,
+                                  int32_t taker,
+                                  CommandCallback callback) {
+  base::DictValue args;
+  if (!args_json.empty()) {
+    std::optional<base::Value> parsed = base::JSONReader::Read(
+        args_json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+    if (!parsed || !parsed->is_dict()) {
+      std::move(callback).Run(false, "The arguments must be a JSON object");
+      return;
+    }
+    args = std::move(parsed->GetDict());
+  }
+  // The helper's (the portal's): a capture request, answered later.
+  if (command == "request") {
+    if (frame) {
+      std::move(callback).Run(false, "Only for the helper");
+      return;
+    }
+    const std::string* kind = args.FindString("kind");
+    const bool screenshot = kind && *kind == "screenshot";
+    if (screenshot ? !screenshots_allowed() : !recording_allowed()) {
+      std::move(callback).Run(false,
+                              screenshot ? kScreenshotsOff : kRecordingOff);
+      return;
+    }
+    if (!kind) {
+      args.Set("kind", "screencast");
+    }
+    Request(std::move(args),
+            base::BindOnce(
+                [](CommandCallback callback, std::optional<base::Value> answer) {
+                  std::move(callback).Run(
+                      true, answer ? ToJson(*answer) : std::string("null"));
+                },
+                std::move(callback)));
+    return;
+  }
+  base::expected<base::Value, std::string> result =
+      RunShellCommand(command, args, frame, taker);
+  if (!result.has_value()) {
+    std::move(callback).Run(false, result.error());
+    return;
+  }
+  std::move(callback).Run(true, ToJson(result.value()));
+}
+
+base::expected<base::Value, std::string> PlutoniumCapture::RunShellCommand(
+    const std::string& command,
+    const base::DictValue& args,
+    content::RenderFrameHost* frame,
+    int32_t taker) {
+  if (command == "sources") {
+    return base::Value(GetSources());
+  }
+  if (command == "settings") {
+    return base::Value(GetSettings());
+  }
+  if (command == "list") {
+    base::ListValue list;
+    for (base::DictValue& capture : GetCaptures()) {
+      list.Append(std::move(capture));
+    }
+    return base::Value(std::move(list));
+  }
+  if (command == "stop") {
+    std::optional<int> id = args.FindInt("id");
+    if (!id || !Stop(*id)) {
+      return base::unexpected("No such capture");
+    }
+    return base::Value();
+  }
+  if (command == "setSize") {
+    std::optional<int> id = args.FindInt("id");
+    if (!id) {
+      return base::unexpected("Which capture?");
+    }
+    return SetSize(*id, args);
+  }
+  if (command == "cancelRequest") {
+    const std::string* handle = args.FindString("handle");
+    if (frame || !handle) {
+      return base::unexpected("Which request?");
+    }
+    std::vector<int32_t> ids;
+    for (const auto& [id, request] : requests_) {
+      const std::string* request_handle = request->detail.FindString("handle");
+      if (request_handle && *request_handle == *handle) {
+        ids.push_back(id);
+      }
+    }
+    for (int32_t id : ids) {
+      Finish(id, std::nullopt);
+    }
+    return base::Value(!ids.empty());
+  }
+  // The rest are a shell document's.
+  if (!frame) {
+    return base::unexpected("Only for shells");
+  }
+  if (command == "setSettings") {
+    return SetSettings(args);
+  }
+  if (command == "stream") {
+    base::expected<base::DictValue, std::string> stream =
+        RegisterStream(args, frame);
+    if (!stream.has_value()) {
+      return base::unexpected(stream.error());
+    }
+    return base::Value(std::move(stream.value()));
+  }
+  if (command == "acknowledge") {
+    std::optional<int> id = args.FindInt("id");
+    if (!id || !Find(*id)) {
+      return base::unexpected("No such capture");
+    }
+    Acknowledge(*id, frame);
+    return base::Value();
+  }
+  if (command == "answer") {
+    std::optional<int> request_id = args.FindInt("requestId");
+    const base::Value* answer = args.Find("answer");
+    if (!request_id) {
+      return base::unexpected("Which request?");
+    }
+    const base::Value null_answer;
+    return base::Value(
+        Answer(*request_id, taker, answer ? *answer : null_answer));
+  }
+  return base::unexpected("No such command: " + command);
+}
+
+base::expected<base::DictValue, std::string> PlutoniumCapture::RegisterStream(
+    const base::DictValue& args,
+    content::RenderFrameHost* frame) {
+  if (!recording_allowed()) {
+    return base::unexpected(kRecordingOff);
+  }
+  const base::Value* source_value = args.Find("source");
+  std::optional<Source> source =
+      source_value ? Source::FromValue(*source_value) : std::nullopt;
+  if (!source) {
+    return base::unexpected("Which source?");
+  }
+  const content::DesktopMediaID media_id = ToMediaId(*source);
+  if (media_id.is_null()) {
+    return base::unexpected(kNoSource);
+  }
+  auto capture = std::make_unique<Capture>();
+  capture->kind = "stream";
+  capture->source = *source;
+  base::DictValue consumer;
+  consumer.Set("kind", "shell");
+  std::string name = "Shell";
+  content::WebContents* contents =
+      content::WebContents::FromRenderFrameHost(frame);
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    if (std::optional<PlutoniumShells::Shell> shell =
+            shells->GetShellFor(contents)) {
+      consumer.Set("shellId", shell->id);
+      name = shell->name;
+    }
+  }
+  consumer.Set("name", name);
+  capture->consumer = std::move(consumer);
+  if (const base::DictValue* size = args.FindDict("size")) {
+    capture->size = gfx::Size(size->FindInt("width").value_or(0),
+                              size->FindInt("height").value_or(0));
+    if (capture->size.IsEmpty() || source->type != Source::Type::kWindow) {
+      capture->size = gfx::Size();
+    }
+  }
+  if (const std::string* cursor = args.FindString("cursor")) {
+    capture->cursor = *cursor;
+  }
+  capture->stream_id =
+      content::DesktopStreamsRegistry::GetInstance()->RegisterStream(
+          frame->GetProcess()->GetDeprecatedID(), frame->GetRoutingID(),
+          frame->GetLastCommittedOrigin(), media_id,
+          content::kRegistryStreamTypeDesktop);
+  const std::string stream_id = capture->stream_id;
+  const int32_t id = Add(std::move(capture));
+  // Forgotten unless getUserMedia() uses it soon.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PlutoniumCapture::DropUnusedStream,
+                     base::Unretained(this), id),
+      kStreamIdLifetime);
+  VLOG(1) << "EXO-CAPTURE stream #" << id << " of "
+          << ToJson(base::Value(source->ToValue())) << " for a shell";
+  return base::DictValue().Set("streamId", stream_id).Set("captureId", id);
+}
+
+void PlutoniumCapture::DropUnusedStream(int32_t id) {
+  auto it = captures_.find(id);
+  if (it != captures_.end() && !it->second->started) {
+    captures_.erase(it);
+  }
+}
+
+int32_t PlutoniumCapture::TakeStream(
+    const content::MediaStreamRequest& request) {
+  if (request.requested_video_device_ids.empty()) {
+    return 0;
+  }
+  const std::string& stream_id = request.requested_video_device_ids.front();
+  if (stream_id.empty()) {
+    return 0;
+  }
+  for (auto& [id, capture] : captures_) {
+    if (capture->stream_id == stream_id) {
+      capture->stream_id.clear();
+      return id;
+    }
+  }
+  return 0;
+}
