+
+ScriptPromise<Blob> NativeWindowBroker::screenshot(ScriptState* script_state,
+                                                   const String& source_json) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<Blob>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->Screenshot(
+      source_json,
+      BindOnce(
+          [](NativeWindowBroker* self, ScriptPromiseResolver<Blob>* resolver,
+             std::optional<mojo_base::BigBuffer> png, const String& error) {
+            self->pending_.erase(resolver);
+            if (!png) {
+              resolver->RejectWithDOMException(
+                  error.contains("switched off")
+                      ? DOMExceptionCode::kNotAllowedError
+                      : DOMExceptionCode::kNotFoundError,
+                  error.empty() ? String("The copy failed.") : error);
+              return;
+            }
+            resolver->Resolve(Blob::Create(base::span(*png), "image/png"));
+          },
+          WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+ScriptPromise<IDLString> NativeWindowBroker::captureCommand(
+    ScriptState* script_state,
+    const String& command,
+    const String& args_json) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLString>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->RunCaptureCommand(
+      command, args_json,
+      BindOnce(
+          [](NativeWindowBroker* self, ScriptPromiseResolver<IDLString>* resolver,
+             bool ok, const String& result) {
+            self->pending_.erase(resolver);
+            if (!ok) {
+              resolver->RejectWithDOMException(
+                  DOMExceptionCode::kOperationError, result);
+              return;
+            }
+            resolver->Resolve(result);
+          },
+          WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
