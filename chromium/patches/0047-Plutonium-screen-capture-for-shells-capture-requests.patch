+  int32_t TakeStream(const content::MediaStreamRequest& request);
+  // Wraps capture |id|'s stream UI so that it starts and stops with the
+  // stream (and Stop() stops it).
+  std::unique_ptr<content::MediaStreamUI> WrapStreamUI(
+      int32_t id,
+      std::unique_ptr<content::MediaStreamUI> ui);
+
+  // What |source| is as a DesktopMediaID (registered for capture), or
+  // TYPE_NONE if it's gone.
+  content::DesktopMediaID ToMediaId(const Source& source) const;
+
+  // PlutoniumShells::Observer:
+  void OnVisibleShellChanged(content::WebContents* previous,
+                             content::WebContents* visible) override;
+  void OnShellsDestroying() override;
+
+ private:
+  friend class base::NoDestructor<PlutoniumCapture>;
+  class StreamUI;
+
+  struct Capture {
+    Capture();
+    ~Capture();
+    int32_t id = 0;
+    std::string kind;
+    Source source;
+    base::DictValue consumer;
+    gfx::Size size;
+    std::string cursor = "embedded";
+    bool started = false;
+    base::Time start_time;
