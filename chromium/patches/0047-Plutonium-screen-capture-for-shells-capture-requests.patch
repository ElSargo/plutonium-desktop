+    const base::DictValue* consumer = request.FindDict("consumer");
+    const std::string* name =
+        consumer ? consumer->FindString("name") : nullptr;
+    const std::string* kind = request.FindString("kind");
+    const bool screenshot = kind && *kind == "screenshot";
+    const std::u16string who =
+        name && !name->empty() ? base::UTF8ToUTF16(*name) : u"An app";
+    AddLabel(this,
+             who + (screenshot ? u" wants a screenshot"
+                               : u" wants to share your screen"),
+             kTitle, 4, /*bold=*/true);
+    AddLabel(this,
+             multiple_ ? u"Choose what to share (one or more)."
+                       : u"Choose what to share.",
+             kDim);
+
+    auto* scroll = AddChildView(std::make_unique<views::ScrollView>());
+    scroll->SetBackgroundColor(kPanel);
+    scroll->ClipHeightTo(0, kListHeight);
+    auto* list = scroll->SetContents(std::make_unique<views::View>());
+    list->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 4));
+    const base::DictValue sources = PlutoniumCapture::Get()->GetSources();
+    if (wants("output")) {
+      AddSection(list, u"Screens", sources.FindList("outputs"), "output",
