+              kButton, kTitle);
+    share_ = AddButton(buttons, screenshot ? u"Take" : u"Share",
+                       base::BindRepeating(&PickerView::Share,
+                                           weak_factory_.GetWeakPtr()),
+                       kAccent, kOnAccent);
+    share_->SetEnabled(false);
+
+    AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+    AddAccelerator(ui::Accelerator(ui::VKEY_RETURN, ui::EF_NONE));
+  }
+
+  // views::View:
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override {
+    if (accelerator.key_code() == ui::VKEY_ESCAPE) {
+      Cancel();
+    } else if (share_->GetEnabled()) {
+      Share();
+    }
+    return true;
+  }
+
+ private:
+  struct Item {
+    base::DictValue source;
+    raw_ptr<views::LabelButton> button = nullptr;
+    bool selected = false;
+  };
+
+  void AddSection(views::View* parent,
+                  std::u16string_view heading,
+                  const base::ListValue* entries,
+                  const char* type,
+                  const char* label_key) {
+    if (!entries || entries->empty()) {
+      return;
+    }
+    AddLabel(parent, heading, kDim, -1, /*bold=*/true);
+    for (const base::Value& entry : *entries) {
+      if (!entry.is_dict()) {
+        continue;
+      }
+      const base::DictValue& dict = entry.GetDict();
+      const base::Value* id = dict.Find("id");
+      if (!id) {
+        continue;
+      }
+      const std::string* label = dict.FindString(label_key);
+      Item item;
+      item.source = base::DictValue().Set("type", type).Set("id", id->Clone());
+      item.button = AddButton(
+          parent,
+          label && !label->empty() ? base::UTF8ToUTF16(*label)
+                                   : std::u16string(u"(untitled)"),
+          base::BindRepeating(&PickerView::Toggle, weak_factory_.GetWeakPtr(),
+                              items_.size()),
+          kButton, kTitle);
+      item.button->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      items_.push_back(std::move(item));
+    }
+  }
+
+  void Toggle(size_t index) {
+    for (size_t i = 0; i < items_.size(); ++i) {
+      if (i == index) {
+        items_[i].selected = !multiple_ || !items_[i].selected;
+      } else if (!multiple_) {
+        items_[i].selected = false;
+      }
+      items_[i].button->SetBackground(views::CreateRoundedRectBackground(
+          items_[i].selected ? kSelected : kButton, 6));
+    }
+    share_->SetEnabled(std::ranges::any_of(
+        items_, [](const Item& item) { return item.selected; }));
+  }
+
+  void Share() {
+    base::ListValue chosen;
+    for (const Item& item : items_) {
+      if (item.selected) {
+        chosen.Append(item.source.Clone());
+      }
+    }
+    done_.Run(base::Value(base::DictValue().Set("sources", std::move(chosen))));
+  }
+
+  void Cancel() { done_.Run(std::nullopt); }
+
+  bool multiple_ = false;
+  std::vector<Item> items_;
+  raw_ptr<views::LabelButton> share_ = nullptr;
+  Done done_;
+  base::WeakPtrFactory<PickerView> weak_factory_{this};
+};
