+std::unique_ptr<content::MediaStreamUI> PlutoniumCapture::WrapStreamUI(
+    int32_t id,
+    std::unique_ptr<content::MediaStreamUI> ui) {
+  if (!Find(id)) {
+    return ui;
+  }
+  return std::make_unique<StreamUI>(id, std::move(ui));
+}
