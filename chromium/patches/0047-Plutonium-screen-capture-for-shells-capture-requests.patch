+    }
+    if (wants("window")) {
+      AddSection(list, u"Windows", sources.FindList("windows"), "window",
+                 "title");
+    }
+    if (wants("tab")) {
+      AddSection(list, u"Tabs", sources.FindList("tabs"), "tab", "title");
+    }
+    if (items_.empty()) {
+      AddLabel(list, u"There's nothing to share.", kDim);
+    }
+
+    auto* buttons =
