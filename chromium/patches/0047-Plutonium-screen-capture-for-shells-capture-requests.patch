+  void ClosePicker();
+
+  std::unique_ptr<views::Widget> picker_;
+  int32_t picking_ = 0;
+  base::OnceCallback<void(std::optional<base::Value>)> done_;
+  std::unique_ptr<views::Widget> indicator_;
+  base::WeakPtrFactory<PlutoniumCaptureUi> weak_factory_{this};
+};
