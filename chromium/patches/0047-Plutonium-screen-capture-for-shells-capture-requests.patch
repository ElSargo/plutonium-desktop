+
+namespace blink {
+
+ShellCaptureEvent::ShellCaptureEvent(const AtomicString& type,
+                                     int32_t id,
+                                     const String& detail_json)
+    : Event(type,
+            Bubbles::kNo,
+            type == event_type_names::kCapturerequest ? Cancelable::kYes
+                                                      : Cancelable::kNo),
+      id_(id),
+      detail_json_(detail_json) {}
+
+ScriptValue ShellCaptureEvent::detail(ScriptState* script_state) const {
+  v8::Isolate* isolate = script_state->GetIsolate();
+  if (detail_json_.empty()) {
+    return ScriptValue(isolate, v8::Null(isolate));
+  }
+  v8::Local<v8::Value> value = FromJSONString(script_state, detail_json_);
+  if (value.IsEmpty()) {
+    return ScriptValue(isolate, v8::Null(isolate));
+  }
+  return ScriptValue(isolate, value);
+}
+
+const AtomicString& ShellCaptureEvent::InterfaceName() const {
+  return event_interface_names::kShellCaptureEvent;
+}
+
+}  // namespace blink
