-  // POST /v1/shells/<name>/<action>: agent and terminal open a tab of the
-  // backup terminal in the shell's folder.
+  // The helper's prompt for the user's own agent (read the skill, then
+  // change this shell), on the clipboard.
+  void CopyPrompt(const std::string& prompt) {
+    if (prompt.empty()) {
+      SetStatus(u"The helper gave no prompt for this shell.");
+      return;
+    }
+    ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+        .WriteText(base::UTF8ToUTF16(prompt));
+    SetStatus(u"Copied. Paste it into your agent (Claude Code, Codex, T3 "
+              u"Code, …).",
+              /*error=*/false);
+  }
+
+  // POST /v1/shells/<name>/<action>: terminal opens a tab of the backup
+  // terminal in the shell's folder.
   void PackageAction(const std::string& name, const std::string& action) {
-    SetStatus(action == "agent"      ? u"Starting an agent…"
-              : action == "terminal" ? u"Opening a terminal…"
-                                     : u"Asking the helper…",
+    SetStatus(action == "terminal" ? u"Opening a terminal…"
+                                   : u"Asking the helper…",
               /*error=*/false);
