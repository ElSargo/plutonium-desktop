@@ -27,6 +44,11 @@ void SystemGestureEventFilter::OnMouseEvent(ui::MouseEvent* event) {
 }
 
 void SystemGestureEventFilter::OnScrollEvent(ui::ScrollEvent* event) {
+  if (SwipeHandlerInstance() && event->finger_count() >= 3) {
+    SwipeHandlerInstance().Run(*event);
+    event->StopPropagation();
+    return;
+  }
   if (wm_gesture_handler_ && wm_gesture_handler_->ProcessScrollEvent(*event))
     event->StopPropagation();
 }
