+// PLUTONIUM: touchpad swipes with three fingers or more go to the focused
+// display's visible shell page (navigator.windowBroker's "touchpadswipe").
+void SendSwipeToShell(const ui::ScrollEvent& event) {
+  PlutoniumShells* shells = PlutoniumShells::Get();
+  if (!shells) {
+    return;
+  }
+  const char* phase = event.type() == ui::EventType::kScrollFlingCancel
+                          ? "begin"
+                      : event.type() == ui::EventType::kScrollFlingStart
+                          ? "end"
+                          : "update";
+  std::optional<std::string> json = base::WriteJson(
+      base::DictValue()
+          .Set("phase", phase)
+          .Set("fingers", event.finger_count())
+          .Set("dx", event.x_offset())
+          .Set("dy", event.y_offset())
+          .Set("x", event.root_location_f().x())
+          .Set("y", event.root_location_f().y()));
+  if (json) {
+    shells->NotifyTouchpadSwipe(*json);
+  }
+}
 }  // namespace
 
