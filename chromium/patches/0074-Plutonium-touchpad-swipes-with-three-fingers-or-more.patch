+void LibInputEventConverter::HandleSwipe(const LibInputEvent& evt) {
+  libinput_event_gesture* event = evt.GestureEvent();
+  const int fingers = libinput_event_gesture_get_finger_count(event);
+  // Where the fingers moved (not the content: natural scrolling doesn't apply).
+  gfx::Vector2dF delta;
+  EventType type = EventType::kScroll;
+  switch (evt.Type()) {
+    case LIBINPUT_EVENT_GESTURE_SWIPE_BEGIN:
+      // A scroll's start in ChromeOS's gesture library.
+      type = EventType::kScrollFlingCancel;
+      break;
+    case LIBINPUT_EVENT_GESTURE_SWIPE_END:
+      type = EventType::kScrollFlingStart;
+      break;
+    default:
+      delta = gfx::Vector2dF(libinput_event_gesture_get_dx(event),
+                             libinput_event_gesture_get_dy(event));
+      break;
+  }
+
+  DVLOG(3) << "Swipe fingers=" << fingers << " type=" << static_cast<int>(type)
+           << " delta=" << delta.ToString();
+
+  dispatcher_->DispatchScrollEvent(
+      {input_device_.id, type, cursor_->GetLocation(), delta, delta, fingers,
+       base::TimeTicks() +
+           base::Microseconds(libinput_event_gesture_get_time_usec(event))});
+}
