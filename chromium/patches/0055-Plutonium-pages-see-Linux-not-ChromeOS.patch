From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <datzeesix@gmail.com>
Date: Sun, 25 Oct 2026 19:45:26 +1300
Subject: [PATCH 55/82] Plutonium: pages see Linux, not ChromeOS

ChromeOS is an implementation detail: the user agent's platform is
"X11; Linux x86_64" (not "X11; CrOS x86_64 14541.0.0"), UA client hints
say platform "Linux" with an empty platform version (not "Chromium OS"),
and the OS/CPU string is "Linux <cpu>", as Linux Chromium's. The unit
test's ChromeOS expectations follow.
---
 .../chrome_content_renderer_client.cc         | 13 ++++++++--
 .../embedder_support/user_agent_utils.cc      | 25 ++++++++-----------
 .../user_agent_utils_unittest.cc              | 25 +++++++------------
 3 files changed, 30 insertions(+), 33 deletions(-)

diff --git a/chrome/renderer/chrome_content_renderer_client.cc b/chrome/renderer/chrome_content_renderer_client.cc
index 4bbd129c5e..4c67fe9963 100644
--- a/chrome/renderer/chrome_content_renderer_client.cc
+++ b/chrome/renderer/chrome_content_renderer_client.cc
@@ -1554,10 +1554,19 @@ void ChromeContentRendererClient::
 
 // Web Share is conditionally enabled here in chrome/, to avoid it
 // being made available in WebView or Linux.
-#if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_WIN) || \
-    BUILDFLAG(IS_MAC)
+// PLUTONIUM: pages see Linux Chromium, which has none of these (only
+// ChromeOS has them on by default). Turned off here rather than with
+// --disable-blink-features, which shows the "unsupported command-line flag"
+// infobar.
+#if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
   blink::WebRuntimeFeatures::EnableWebShare(true);
 #endif
+#if BUILDFLAG(IS_CHROMEOS)
+  for (const char* feature : {"HandwritingRecognition", "BarcodeDetector",
+                              "WebBluetooth"}) {
+    blink::WebRuntimeFeatures::EnableFeatureFromString(feature, false);
+  }
+#endif
 
   if (base::FeatureList::IsEnabled(
           autofill::features::kAutofillPolicyControlledFeatureAutofill)) {
diff --git a/components/embedder_support/user_agent_utils.cc b/components/embedder_support/user_agent_utils.cc
index bf4a8960a0..eeb207b121 100644
--- a/components/embedder_support/user_agent_utils.cc
+++ b/components/embedder_support/user_agent_utils.cc
@@ -276,7 +276,8 @@ std::string GetUserAgentPlatform() {
 }
 
 std::string GetUnifiedPlatform() {
-#if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_CHROMEOS)
+// PLUTONIUM: ChromeOS is an implementation detail; pages see Linux.
+#if BUILDFLAG(IS_ANDROID)
   // This constant is only used on Android (desktop) and Linux.
   constexpr char kUnifiedPlatformChromeOSX64[] = "X11; CrOS x86_64 14541.0.0";
 
@@ -293,7 +294,7 @@ std::string GetUnifiedPlatform() {
   }
   return "Linux; Android 10; K";
 #elif BUILDFLAG(IS_CHROMEOS)
-  return kUnifiedPlatformChromeOSX64;
+  return "X11; Linux x86_64";
 #elif BUILDFLAG(IS_MAC)
   return "Macintosh; Intel Mac OS X 10_15_7";
 #elif BUILDFLAG(IS_WIN)
@@ -590,7 +591,8 @@ std::string GetPlatformVersion() {
 
 #if BUILDFLAG(IS_WIN)
   return GetWindowsPlatformVersion();
-#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_FUCHSIA)
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_FUCHSIA) || BUILDFLAG(IS_CHROMEOS)
+  // PLUTONIUM: ChromeOS reports Linux's (empty) platform version.
   return std::string();
 #else
 
@@ -619,14 +621,8 @@ std::string GetPlatformForUAMetadata() {
   // "macOS" by default
   return "macOS";
 #elif BUILDFLAG(IS_CHROMEOS)
-  // TODO(crbug.com/40846294): The branding change to remove the space caused a
-  // regression that's solved here. Ideally, we would just use the new OS name
-  // without the space here too, but that needs a launch plan.
-#if BUILDFLAG(GOOGLE_CHROME_BRANDING)
-  return "Chrome OS";
-#else
-  return "Chromium OS";
-#endif
+  // PLUTONIUM: ChromeOS is an implementation detail; pages see Linux.
+  return "Linux";
 #else
   return std::string(version_info::GetOSType());
 #endif
@@ -790,10 +786,9 @@ std::string BuildOSCpuInfoFromOSVersionAndCpuType(const std::string& os_version,
 #if BUILDFLAG(IS_MAC)
                       "%s Mac OS X %s", cpu_type.c_str(), os_version.c_str()
 #elif BUILDFLAG(IS_CHROMEOS)
-                      "CrOS "
-                      "%s %s",
-                      cpu_type.c_str(),  // e.g. i686
-                      os_version.c_str()
+                      // PLUTONIUM: as on Linux.
+                      "Linux %s",
+                      cpu_type.c_str()  // e.g. x86_64
 #elif BUILDFLAG(IS_ANDROID)
                       "Android %s", os_version.c_str()
 #elif BUILDFLAG(IS_FUCHSIA)
diff --git a/components/embedder_support/user_agent_utils_unittest.cc b/components/embedder_support/user_agent_utils_unittest.cc
index 23fa11bc9e..c912ba070d 100644
--- a/components/embedder_support/user_agent_utils_unittest.cc
+++ b/components/embedder_support/user_agent_utils_unittest.cc
@@ -152,7 +152,8 @@ class UserAgentUtilsTest : public testing::Test {
     // This matches GetUnifiedPlatform().
     static const char* const kExpectedPlatform =
 #if BUILDFLAG(IS_CHROMEOS)
-        "X11; CrOS x86_64 14541.0.0";
+        // PLUTONIUM: ChromeOS reports Linux.
+        "X11; Linux x86_64";
 #elif BUILDFLAG(IS_FUCHSIA)
         "Fuchsia";
 #elif BUILDFLAG(IS_LINUX)
@@ -334,7 +335,8 @@ TEST_F(UserAgentUtilsTest, UserAgentMetadata) {
 
 #if BUILDFLAG(IS_WIN)
   VerifyWinPlatformVersion(metadata.platform_version);
-#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_FUCHSIA)
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_FUCHSIA) || BUILDFLAG(IS_CHROMEOS)
+  // PLUTONIUM: ChromeOS too, as Linux.
   EXPECT_EQ(metadata.platform_version, "");
 #else
   int32_t major, minor, bugfix = 0;
@@ -354,11 +356,8 @@ TEST_F(UserAgentUtilsTest, UserAgentMetadata) {
 #elif BUILDFLAG(IS_MAC)
   EXPECT_EQ(metadata.platform, "macOS");
 #elif BUILDFLAG(IS_CHROMEOS)
-#if BUILDFLAG(GOOGLE_CHROME_BRANDING)
-  EXPECT_EQ(metadata.platform, "Chrome OS");
-#else
-  EXPECT_EQ(metadata.platform, "Chromium OS");
-#endif
+  // PLUTONIUM: ChromeOS reports Linux.
+  EXPECT_EQ(metadata.platform, "Linux");
 #elif BUILDFLAG(IS_ANDROID)
   EXPECT_EQ(metadata.platform, "Android");
 #elif BUILDFLAG(IS_LINUX)
@@ -771,22 +770,16 @@ TEST_F(UserAgentUtilsTest, BuildOSCpuInfoFromOSVersionAndCpuType) {
         /*expected_os_cpu_info=*/"CPU TYPE Mac OS X VERSION",
     },
 #elif BUILDFLAG(IS_CHROMEOS)
+    // PLUTONIUM: as on Linux; the version isn't part of it.
     {
         /*os_version=*/"4537.56.0",
         /*cpu_type=*/"armv7l",
-        /*expected_os_cpu_info=*/"CrOS armv7l 4537.56.0",
-    },
-    // These cases should never happen in real life, but may be useful to detect
-    // changes when things are refactored.
-    {
-        /*os_version=*/"",
-        /*cpu_type=*/"",
-        /*expected_os_cpu_info=*/"CrOS  ",
+        /*expected_os_cpu_info=*/"Linux armv7l",
     },
     {
         /*os_version=*/"VERSION",
         /*cpu_type=*/"CPU TYPE",
-        /*expected_os_cpu_info=*/"CrOS CPU TYPE VERSION",
+        /*expected_os_cpu_info=*/"Linux CPU TYPE",
     },
 #elif BUILDFLAG(IS_ANDROID)
     {
