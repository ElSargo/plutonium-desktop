+int32_t PlutoniumCapture::RequestOutputCapture(
+    int32_t pid,
+    int64_t display_id,
+    base::OnceCallback<void(bool)> done) {
+  if (!recording_allowed() || !screenshots_allowed()) {
+    std::move(done).Run(false);
+    return 0;
+  }
+  const int32_t token = next_wayland_token_++;
+  wayland_requests_[token] = 0;
+  // Who asks: its process's name and thread, from /proc (off this thread).
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](int32_t pid) {
+            std::string name;
+            base::ReadFileToString(
+                base::FilePath("/proc/" + base::NumberToString(pid) + "/comm"),
+                &name);
+            base::TrimWhitespaceASCII(name, base::TRIM_ALL, &name);
+            base::DictValue consumer;
+            consumer.Set("kind", "app");
+            consumer.Set("name", name.empty() ? std::string("A Wayland app")
+                                              : name);
+            consumer.Set("pid", pid);
+            if (std::optional<std::string> thread =
+                    plutonium_tags::ReadThreadTag(pid)) {
+              consumer.Set("thread", *thread);
+            }
+            return consumer;
+          },
+          pid),
+      base::BindOnce(
+          [](PlutoniumCapture* self, int32_t token, int64_t display_id,
+             base::OnceCallback<void(bool)> done, base::DictValue consumer) {
+            auto pending = self->wayland_requests_.find(token);
+            if (pending == self->wayland_requests_.end()) {
+              return;  // The client went away.
+            }
+            // For OnCaptureStarted().
+            self->wayland_consumers_[consumer.FindInt("pid").value_or(0)] =
+                consumer.Clone();
+            base::ListValue types;
+            types.Append("output");
+            pending->second = self->Request(
+                base::DictValue()
+                    .Set("kind", "screencast")
+                    .Set("consumer", std::move(consumer))
+                    .Set("types", std::move(types))
+                    .Set("multiple", false),
+                base::BindOnce(
+                    [](PlutoniumCapture* self, int32_t token,
+                       base::OnceCallback<void(bool)> done,
+                       std::optional<base::Value> answer) {
+                      self->wayland_requests_.erase(token);
+                      std::move(done).Run(answer.has_value());
+                    },
+                    base::Unretained(self), token, std::move(done)));
+          },
+          base::Unretained(this), token, display_id, std::move(done)));
+  return token;
+}
+
+void PlutoniumCapture::CancelOutputCapture(int32_t token) {
+  auto pending = wayland_requests_.find(token);
+  if (pending == wayland_requests_.end()) {
+    return;
+  }
+  const int32_t request_id = pending->second;
+  wayland_requests_.erase(pending);
+  if (request_id) {
+    CancelRequest(request_id);
+  }
+}
+
+int32_t PlutoniumCapture::OnCaptureStarted(int32_t pid,
+                                           int64_t display_id,
+                                           base::RepeatingClosure stop) {
+  auto capture = std::make_unique<Capture>();
+  capture->kind = "wayland";
+  capture->source.type = Source::Type::kOutput;
+  capture->source.id = display_id;
+  auto known = wayland_consumers_.find(pid);
+  if (known != wayland_consumers_.end()) {
+    capture->consumer = std::move(known->second);
+    wayland_consumers_.erase(known);
+  } else {
+    capture->consumer.Set("kind", "app");
+    capture->consumer.Set("pid", pid);
+    capture->consumer.Set("name", "A Wayland app");
+  }
+  capture->cursor = "hidden";
+  const int32_t id = Add(std::move(capture));
+  OnStreamStarted(id, std::move(stop));
+  return id;
+}
+
+void PlutoniumCapture::OnCaptureStopped(int32_t id) {
+  Remove(id);
+}
