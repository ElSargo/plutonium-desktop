+void OnVisibleShellChanged(content::WebContents* previous,
+                           content::WebContents* visible) {
+  // Fullscreen and keyboard focus belong to what the previous shell showed.
+  if (ExoEmbedder* embedder = ExoEmbedder::Get()) {
+    embedder->ExitFullscreen();
+  }
+  PlutoniumTabs::Get()->ExitFullscreen();
+  if (exo::EmbeddedWindows::Get()->focused_window_id()) {
+    exo::EmbeddedWindows::Get()->ClearFocus();
+  }
+  PlutoniumTabs::Get()->SetShell(visible);
+  if (!visible) {
+    return;
+  }
+  // The visible shell's elements size what they show again, and its
+  // <embed>s take back the tabs another shell showed meanwhile.
+  if (ExoEmbedder* embedder = ExoEmbedder::Get()) {
+    embedder->OnVisibleShellChanged();
+  }
+  surface_embed::SurfaceEmbedHost::ReattachHosts(base::BindRepeating(
+      [](content::WebContents* visible, content::RenderFrameHost* rfh) {
+        return content::WebContents::FromRenderFrameHost(rfh)
+                   ->GetOutermostWebContents() == visible;
+      },
+      visible));
