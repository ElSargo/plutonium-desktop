+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/ash/main_extra_parts/plutonium_shells_impl.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/lifetime/browser_shutdown.h"
+#include "chrome/browser/plutonium_shell.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/extensions/application_launch.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/base_window.h"
+
+namespace {
+
+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+constexpr char kUrlKey[] = "url";
+constexpr char kEnabledKey[] = "enabled";
+
+std::string NewId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString().substr(0, 8);
+}
+
+}  // namespace
+
+PlutoniumShellsImpl::PlutoniumShellsImpl() {
+  Load();
+  browsers_observation_.Observe(GlobalBrowserCollection::GetInstance());
+}
+
+PlutoniumShellsImpl::~PlutoniumShellsImpl() = default;
+
+void PlutoniumShellsImpl::Load() {
+  PrefService* local_state = g_browser_process->local_state();
+  for (const base::Value& value : local_state->GetList(kShellsPref)) {
+    const base::DictValue* dict = value.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const std::string* id = dict->FindString(kIdKey);
+    const std::string* name = dict->FindString(kNameKey);
+    const std::string* url = dict->FindString(kUrlKey);
+    if (!id || id->empty() || !url || Find(*id)) {
+      continue;
+    }
+    Entry entry;
+    entry.shell.id = *id;
+    entry.shell.name = name ? *name : std::string();
+    entry.shell.url = GURL(*url);
+    if (!plutonium_shell::IsAcceptableShellUrl(entry.shell.url)) {
+      LOG(ERROR) << "EXO-SHELLS: ignoring shell " << *id << " (" << *url
+                 << ")";
+      continue;
+    }
+    entry.shell.origin = url::Origin::Create(entry.shell.url);
+    entry.shell.enabled = dict->FindBool(kEnabledKey).value_or(true);
+    entries_.push_back(std::move(entry));
+  }
+
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  GURL startup(
+      command_line->GetSwitchValueASCII(plutonium_shell::kShellUrlSwitch));
+  if (plutonium_shell::IsAcceptableShellUrl(startup)) {
+    AddFromCommandLine(std::string(), startup, /*startup=*/true);
+  }
+  // <name>=<url>|<name>=<url>...
+  for (const std::string& item : base::SplitString(
+           command_line->GetSwitchValueASCII(kShellsSwitch), "|",
+           base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    size_t equals = item.find('=');
+    std::string name =
+        equals == std::string::npos ? std::string() : item.substr(0, equals);
+    GURL url(equals == std::string::npos ? item : item.substr(equals + 1));
+    if (!plutonium_shell::IsAcceptableShellUrl(url)) {
+      LOG(ERROR) << "EXO-SHELLS: ignoring --" << kShellsSwitch << " entry \""
+                 << item << "\"";
+      continue;
+    }
+    AddFromCommandLine(name, url, /*startup=*/false);
+  }
+  Save();
+  for (const Entry& entry : entries_) {
+    LOG(WARNING) << "EXO-SHELLS shell " << entry.shell.id << " \""
+                 << entry.shell.name << "\" " << entry.shell.url.spec()
+                 << (entry.shell.enabled ? "" : " (off)")
+                 << (entry.shell.id == startup_id_ ? " (startup)" : "");
+  }
+}
+
+void PlutoniumShellsImpl::AddFromCommandLine(const std::string& name,
+                                             const GURL& url,
+                                             bool startup) {
+  // The same shell as before if it has the same URL but for the fragment (a
+  // launcher may put a one-time token there), or the same name on the same
+  // origin. It then takes the new URL.
+  const url::Origin url_origin = url::Origin::Create(url);
+  auto it = std::ranges::find_if(entries_, [&](const Entry& entry) {
+    return entry.shell.url.GetWithoutRef() == url.GetWithoutRef() ||
+           (!name.empty() && entry.shell.name == name &&
+            entry.shell.origin.IsSameOriginWith(url_origin));
+  });
+  if (it != entries_.end()) {
+    it->shell.url = url;
+  }
+  if (it == entries_.end()) {
+    Entry entry;
+    entry.shell.id = NewId();
+    entry.shell.name = name.empty() ? url.host() : name;
+    entry.shell.url = url;
+    entry.shell.origin = url::Origin::Create(url);
+    entries_.push_back(std::move(entry));
+    it = std::prev(entries_.end());
+  } else if (!name.empty()) {
+    it->shell.name = name;
+  }
+  if (startup) {
+    // The startup browser opens it whatever the list says.
+    it->shell.enabled = true;
+    startup_id_ = it->shell.id;
+    // --plutonium-shell-origin may name another origin for it.
+    if (const std::optional<url::Origin>& origin =
+            plutonium_shell::GetShellOrigin()) {
+      it->shell.origin = *origin;
+    }
+  }
+}
+
+void PlutoniumShellsImpl::Save() {
+  base::ListValue list;
+  for (const Entry& entry : entries_) {
+    list.Append(base::DictValue()
+                    .Set(kIdKey, entry.shell.id)
+                    .Set(kNameKey, entry.shell.name)
+                    .Set(kUrlKey, entry.shell.url.spec())
+                    .Set(kEnabledKey, entry.shell.enabled));
+  }
+  g_browser_process->local_state()->SetList(kShellsPref, std::move(list));
+}
+
+std::vector<PlutoniumShells::Shell> PlutoniumShellsImpl::GetShells() const {
+  std::vector<Shell> shells;
+  for (const Entry& entry : entries_) {
+    shells.push_back(StateOf(entry));
+  }
+  return shells;
+}
+
+std::optional<PlutoniumShells::Shell> PlutoniumShellsImpl::GetShellFor(
+    const content::WebContents* contents) const {
+  if (!contents) {
+    return std::nullopt;
+  }
+  for (const Entry& entry : entries_) {
+    if (entry.browser && ContentsOf(entry) == contents) {
+      return StateOf(entry);
+    }
+  }
+  return std::nullopt;
+}
+
+content::WebContents* PlutoniumShellsImpl::GetVisibleContents() const {
+  for (const Entry& entry : entries_) {
+    if (entry.shell.id == visible_id_) {
+      return ContentsOf(entry);
+    }
+  }
+  return nullptr;
+}
+
+bool PlutoniumShellsImpl::Show(const std::string& id) {
+  Entry* entry = Find(id);
+  if (!entry || !entry->shell.enabled || !entry->browser) {
+    return false;
+  }
+  if (id == visible_id_) {
+    return true;
+  }
+  Entry* previous = Find(visible_id_);
+  content::WebContents* previous_contents =
+      previous ? ContentsOf(*previous) : nullptr;
+  visible_id_ = id;
+  LOG(WARNING) << "EXO-SHELLS showing " << id << " \"" << entry->shell.name
+               << "\"";
+  // Before its window is activated: activation restores the page's focus,
+  // which may be in a tab whose view must be in that window by then.
+  NotifyVisibleShellChanged(previous_contents, ContentsOf(*entry));
+  entry->browser->GetWindow()->Show();
+  entry->browser->GetWindow()->Activate();
+  if (previous && previous->browser) {
+    previous->browser->GetWindow()->Hide();
+  }
+  NotifyShellsChanged();
+  return true;
+}
+
+void PlutoniumShellsImpl::ShowNext(int step) {
+  std::vector<std::string> running;
+  for (const Entry& entry : entries_) {
+    if (entry.shell.enabled && entry.browser) {
+      running.push_back(entry.shell.id);
+    }
+  }
+  if (running.empty()) {
+    return;
+  }
+  auto it = std::ranges::find(running, visible_id_);
+  const int count = static_cast<int>(running.size());
+  const int current =
+      it == running.end() ? -step : static_cast<int>(it - running.begin());
+  Show(running[((current + step) % count + count) % count]);
+}
+
+void PlutoniumShellsImpl::OnBrowserCreated(BrowserWindowInterface* browser) {
+  if (browser->GetType() != BrowserWindowInterface::TYPE_APP) {
+    return;
+  }
+  if (!opening_id_.empty()) {
+    if (Entry* entry = Find(opening_id_)) {
+      entry->browser = browser;
+    }
+    return;
+  }
+  Entry* startup = Find(startup_id_);
+  if (!startup || startup->browser) {
+    return;
+  }
+  // The startup browser: the --app window for --plutonium-shell-url.
+  startup->browser = browser;
+  visible_id_ = startup_id_;
+  // Once it has its page and is shown; the other shells' windows come next.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PlutoniumShellsImpl::OpenWindows,
+                                weak_ptr_factory_.GetWeakPtr(),
+                                browser->GetProfile()));
+}
+
+void PlutoniumShellsImpl::OnBrowserClosed(BrowserWindowInterface* browser) {
+  for (Entry& entry : entries_) {
+    if (entry.browser != browser) {
+      continue;
+    }
+    entry.browser = nullptr;
+    LOG(WARNING) << "EXO-SHELLS shell " << entry.shell.id
+                 << "'s window closed";
+    if (entry.shell.id == visible_id_) {
+      visible_id_.clear();
+      if (!browser_shutdown::HasShutdownStarted()) {
+        NotifyVisibleShellChanged(nullptr, nullptr);
+        ShowNext(1);
+      }
+    }
+    NotifyShellsChanged();
+    return;
+  }
+}
+
+void PlutoniumShellsImpl::OpenWindows(Profile* profile) {
+  if (browser_shutdown::HasShutdownStarted()) {
+    return;
+  }
+  Entry* visible = Find(visible_id_);
+  if (visible) {
+    // The startup shell's page exists now: tell the rest of the browser.
+    NotifyVisibleShellChanged(nullptr, ContentsOf(*visible));
+  }
+  for (const Entry& entry : std::vector<Entry>(entries_)) {
+    if (!entry.shell.enabled || entry.browser) {
+      continue;
+    }
+    opening_id_ = entry.shell.id;
+    OpenAppShortcutWindow(profile, entry.shell.url);
+    opening_id_.clear();
+    Entry* opened = Find(entry.shell.id);
+    if (!opened || !opened->browser) {
+      LOG(ERROR) << "EXO-SHELLS could not open shell " << entry.shell.id;
+      continue;
+    }
+    LOG(WARNING) << "EXO-SHELLS opened shell " << entry.shell.id << " \""
+                 << entry.shell.name << "\"";
+    chrome::ToggleFullscreenMode(opened->browser, /*user_initiated=*/false);
+    if (visible && visible->browser) {
+      opened->browser->GetWindow()->Hide();
+    } else {
+      // Nothing was visible (the startup shell's window is gone).
+      visible_id_ = opened->shell.id;
+      visible = opened;
+      NotifyVisibleShellChanged(nullptr, ContentsOf(*opened));
+    }
+  }
+  if (visible && visible->browser) {
+    visible->browser->GetWindow()->Activate();
+  }
+  NotifyShellsChanged();
+}
+
+// static
+content::WebContents* PlutoniumShellsImpl::ContentsOf(const Entry& entry) {
+  if (!entry.browser) {
+    return nullptr;
+  }
+  tabs::TabInterface* tab = entry.browser->GetActiveTabInterface();
+  return tab ? tab->GetContents() : nullptr;
+}
+
+PlutoniumShellsImpl::Entry* PlutoniumShellsImpl::Find(const std::string& id) {
+  if (id.empty()) {
+    return nullptr;
+  }
+  auto it = std::ranges::find_if(
+      entries_, [&](const Entry& entry) { return entry.shell.id == id; });
+  return it == entries_.end() ? nullptr : &*it;
+}
+
+PlutoniumShells::Shell PlutoniumShellsImpl::StateOf(const Entry& entry) const {
+  Shell shell = entry.shell;
+  shell.running = !!entry.browser;
+  shell.visible = entry.shell.id == visible_id_;
+  return shell;
+}
