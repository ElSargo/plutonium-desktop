+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ShellShortcutsData);
+
+// Outside shell mode: the page that set shortcuts last.
+base::WeakPtr<content::WebContents>& LastShell() {
+  static base::NoDestructor<base::WeakPtr<content::WebContents>> shell;
+  return *shell;
+}
+
+// The shell page that gets the shell's shortcuts: the visible shell's.
+content::WebContents* KeyShell() {
+  if (PlutoniumShells* shells = PlutoniumShells::Get()) {
+    return shells->GetVisibleContents();
+  }
+  return LastShell().get();
+}
+
+const std::set<Shortcut>* ShellShortcuts() {
+  content::WebContents* shell = KeyShell();
