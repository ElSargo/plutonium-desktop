+void PlutoniumTabs::SetShell(content::WebContents* shell) {
+  if (!shell) {
+    return;
+  }
+  aura::Window* window = shell->GetTopLevelNativeWindow();
+  aura::Window* old_parking = parking();
+  if (window && window != old_parking) {
+    parking_.RemoveAll();
+    parking_.Add(window);
+    // Hidden tabs keep painting (for snapshots) only in a shown window.
+    // An attached tab's native view is its embedder's (and it gets a fresh
+    // view, parked by Refresh(), when it's detached): leave those alone.
+    for (const auto& [id, tab] : tabs_) {
+      if (tab->contents()->GetSurfaceEmbedConnector()) {
+        continue;
+      }
+      aura::Window* view = tab->contents()->GetNativeView();
+      if (view && old_parking && view->parent() == old_parking) {
+        old_parking->RemoveChild(view);
+        window->AddChild(view);
+        window->StackChildAtBottom(view);
+      }
+    }
+  }
+  if (!shell_observer_ || shell_observer_->web_contents() != shell) {
+    shell_observer_ = std::make_unique<ShellObserver>(this, shell);
+  }
