From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Wed, 28 Oct 2026 09:00:51 +1300
Subject: [PATCH 86/97] Plutonium: no Ash toasts, nudges or clipboard history,
 no Chrome toasts or clipboard bubble over the shell

EXO-CHROME (docs/features/CHROME_UI.md, "Popups"). In shell mode a web
page is the desktop, and Chrome's and Ash's own popups showed over it:

- ToastManagerImpl::Show() and AnchoredNudgeManagerImpl::Show() show
  nothing ("Copied to clipboard", capture mode's toasts, the education
  nudges of features shell mode has no UI for). The toast's text is
  logged at VLOG(1).
- ClipboardHistoryControllerImpl::ShowMenu() refuses: Search+V already
  reaches the page, and this covers the menu's other ways in.
- ToastController::CanShowToast() is false for a shell's window: no
  "Link copied", "Image copied" or "Link to highlight copied" from the
  shell's context menu.
- A shell document has the clipboard permissions (read-write and
  sanitized write) without Chrome's bubble: the shell already reaches
  every window and tab through the broker.
---
 ash/clipboard/clipboard_history_controller_impl.cc |  9 +++++++++
 ash/system/toast/anchored_nudge_manager_impl.cc    | 11 +++++++++++
 ash/system/toast/toast_manager_impl.cc             | 14 ++++++++++++++
 ...chrome_clipboard_permission_context_delegate.cc |  8 ++++++++
 chrome/browser/ui/toasts/toast_controller.cc       |  7 +++++++
 5 files changed, 49 insertions(+)

diff --git a/ash/clipboard/clipboard_history_controller_impl.cc b/ash/clipboard/clipboard_history_controller_impl.cc
index b30656aa4e..b783c9aaa0 100644
--- a/ash/clipboard/clipboard_history_controller_impl.cc
+++ b/ash/clipboard/clipboard_history_controller_impl.cc
@@ -34,6 +34,7 @@
 #include "base/check.h"
 #include "base/check_is_test.h"
 #include "base/check_op.h"
+#include "base/command_line.h"
 #include "base/functional/bind.h"
 #include "base/json/values_util.h"
 #include "base/memory/raw_ptr.h"
@@ -522,6 +523,14 @@ bool ClipboardHistoryControllerImpl::ShowMenu(
     ui::mojom::MenuSourceType source_type,
     chromeos::clipboard_history::ShowSource show_source,
     OnMenuClosingCallback callback) {
+  // PLUTONIUM (EXO-CHROME): in shell mode (--plutonium-shell-url) a web page
+  // is the desktop, and Ash's clipboard history menu isn't its UI (Search+V
+  // already reaches the page; this is for the menu's other ways in).
+  static const bool shell_mode =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("plutonium-shell-url");
+  if (shell_mode) {
+    return false;
+  }
   if (IsMenuShowing() || !HasAvailableHistoryItems()) {
     return false;
   }
