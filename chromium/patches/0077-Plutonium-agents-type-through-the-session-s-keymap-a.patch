+#if BUILDFLAG(USE_XKBCOMMON)
+std::vector<XkbTracker::TypedChar> XkbTracker::GetTypedChars() const {
+  std::vector<TypedChar> chars;
+  xkb_keymap* keymap = xkb_keymap_.get();
+  if (!keymap) {
+    return chars;
+  }
+  const xkb_keycode_t max = xkb_keymap_max_keycode(keymap);
+  for (xkb_keycode_t key = xkb_keymap_min_keycode(keymap); key <= max; ++key) {
+    const xkb_level_index_t levels =
+        xkb_keymap_num_levels_for_key(keymap, key, 0);
+    for (xkb_level_index_t level = 0; level < levels; ++level) {
+      const xkb_keysym_t* syms = nullptr;
+      if (xkb_keymap_key_get_syms_by_level(keymap, key, 0, level, &syms) != 1) {
+        continue;
+      }
+      const uint32_t character = xkb_keysym_to_utf32(syms[0]);
+      if (!character) {
+        continue;
+      }
+      // The first way to reach the level with only shift and AltGr.
+      std::array<xkb_mod_mask_t, 8> masks;
+      const size_t count = xkb_keymap_key_get_mods_for_level(
+          keymap, key, 0, level, masks.data(), masks.size());
+      for (xkb_mod_mask_t mask :
+           base::span(masks).first(std::min(count, masks.size()))) {
+        const int flags = xkb_modifier_converter_.UiFlagsFromMask(mask) &
+                          (ui::EF_SHIFT_DOWN | ui::EF_ALTGR_DOWN);
+        if (xkb_modifier_converter_.MaskFromUiFlags(flags) == mask) {
+          chars.push_back({key, flags, character});
+          break;
+        }
+      }
+    }
+  }
+  return chars;
+}
+
+std::string XkbTracker::GetKeymapText() const {
+  std::unique_ptr<char, base::FreeDeleter> keymap = GetKeymap();
+  return keymap ? std::string(keymap.get()) : std::string();
+}
+#else
+std::vector<XkbTracker::TypedChar> XkbTracker::GetTypedChars() const {
+  return {};
+}
+
+std::string XkbTracker::GetKeymapText() const {
+  return std::string();
+}
+#endif
