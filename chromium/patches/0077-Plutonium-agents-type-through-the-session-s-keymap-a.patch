+std::vector<EmbeddedWindows::TypedChar> EmbeddedWindows::GetTypedChars()
+    const {
+  std::vector<TypedChar> chars;
+  if (seats_.empty()) {
+    return chars;
+  }
+  for (const XkbTracker::TypedChar& typed :
+       seats_.front()->xkb_tracker()->GetTypedChars()) {
+    const ui::DomCode code = ui::KeycodeConverter::NativeKeycodeToDomCode(
+        static_cast<int>(typed.xkb_keycode));
+    if (code == ui::DomCode::NONE) {
+      continue;
+    }
+    chars.push_back({typed.character,
+                     ui::KeycodeConverter::DomCodeToCodeString(code),
+                     typed.flags});
+  }
+  return chars;
+}
+
+std::string EmbeddedWindows::GetKeymap() const {
+  return seats_.empty() ? std::string()
+                        : seats_.front()->xkb_tracker()->GetKeymapText();
+}
+
+bool EmbeddedWindows::SetAgentKeymap(
+    int32_t window_id,
+    const std::optional<std::string>& keymap) {
+  ShellSurfaceBase* shell_surface = FindShellSurface(window_id);
+  Surface* surface = shell_surface ? shell_surface->root_surface() : nullptr;
+  if (!surface) {
+    return false;
+  }
+  for (Seat* seat : seats_) {
+    seat->SetAgentKeymap(surface, keymap ? &*keymap : nullptr);
+  }
+  return true;
+}
