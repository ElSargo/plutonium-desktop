+void Keyboard::OnAgentKeymap(Surface* surface, const std::string* keymap) {
+  if (!delegate_->CanAcceptKeyboardEventsForSurface(surface)) {
+    return;
+  }
+  if (keymap) {
+    delegate_->OnKeyboardLayoutUpdated(*keymap);
+  } else {
+    delegate_->OnKeyboardLayoutUpdated(
+        seat_->xkb_tracker()->GetKeymap().get());
+  }
+}
