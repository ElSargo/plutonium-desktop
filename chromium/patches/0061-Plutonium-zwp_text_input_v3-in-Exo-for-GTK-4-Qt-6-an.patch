+// found in the LICENSE file.
+
+#include <text-input-unstable-v3-client-protocol.h>
+#include <wayland-client-core.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "ash/shell.h"
+#include "components/exo/surface.h"
+#include "components/exo/wayland/test/server_util.h"
+#include "components/exo/wayland/test/shell_client_data.h"
+#include "components/exo/wayland/test/test_client.h"
+#include "components/exo/wayland/test/wayland_server_test.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/aura/client/focus_client.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/base/ime/composition_text.h"
+#include "ui/base/ime/input_method.h"
+#include "ui/base/ime/text_input_client.h"
+
+namespace exo::wayland {
+namespace {
+
+using TextInputV3Test = test::WaylandServerTest;
+
+// What a zwp_text_input_v3 client was sent, as one string per event.
+struct TextInputV3Client {
+  zwp_text_input_manager_v3* manager = nullptr;
+  zwp_text_input_v3* text_input = nullptr;
+  wl_surface* entered = nullptr;
+  std::vector<std::string> events;
+};
+
+void OnGlobal(void* data,
+              wl_registry* registry,
+              uint32_t name,
+              const char* interface,
+              uint32_t version) {
+  auto* client = static_cast<TextInputV3Client*>(data);
+  if (std::string_view(interface) == zwp_text_input_manager_v3_interface.name) {
+    client->manager = static_cast<zwp_text_input_manager_v3*>(wl_registry_bind(
+        registry, name, &zwp_text_input_manager_v3_interface, 1));
+  }
+}
+
+void OnGlobalRemove(void* data, wl_registry* registry, uint32_t name) {}
+
+constexpr wl_registry_listener kRegistryListener = {OnGlobal, OnGlobalRemove};
+
+void OnEnter(void* data, zwp_text_input_v3* text_input, wl_surface* surface) {
+  auto* client = static_cast<TextInputV3Client*>(data);
+  client->entered = surface;
+  client->events.push_back("enter");
+}
+
+void OnLeave(void* data, zwp_text_input_v3* text_input, wl_surface* surface) {
+  auto* client = static_cast<TextInputV3Client*>(data);
+  client->entered = nullptr;
+  client->events.push_back("leave");
+}
+
+void OnPreeditString(void* data,
+                     zwp_text_input_v3* text_input,
+                     const char* text,
+                     int32_t cursor_begin,
+                     int32_t cursor_end) {
+  static_cast<TextInputV3Client*>(data)->events.push_back(
+      "preedit " + std::string(text ? text : "") + " " +
+      std::to_string(cursor_begin) + " " + std::to_string(cursor_end));
+}
+
+void OnCommitString(void* data,
+                    zwp_text_input_v3* text_input,
+                    const char* text) {
+  static_cast<TextInputV3Client*>(data)->events.push_back(
+      "commit " + std::string(text ? text : ""));
+}
+
+void OnDeleteSurroundingText(void* data,
+                             zwp_text_input_v3* text_input,
+                             uint32_t before_length,
+                             uint32_t after_length) {
+  static_cast<TextInputV3Client*>(data)->events.push_back(
+      "delete " + std::to_string(before_length) + " " +
+      std::to_string(after_length));
+}
+
+void OnDone(void* data, zwp_text_input_v3* text_input, uint32_t serial) {
+  static_cast<TextInputV3Client*>(data)->events.push_back(
+      "done " + std::to_string(serial));
+}
+
+zwp_text_input_v3_listener MakeTextInputListener() {
+  zwp_text_input_v3_listener listener = {};
+  listener.enter = OnEnter;
+  listener.leave = OnLeave;
+  listener.preedit_string = OnPreeditString;
+  listener.commit_string = OnCommitString;
+  listener.delete_surrounding_text = OnDeleteSurroundingText;
+  listener.done = OnDone;
+  return listener;
+}
+
+const zwp_text_input_v3_listener kTextInputListener = MakeTextInputListener();
+
+TEST_F(TextInputV3Test, EnterEnableComposeCommitLeave) {
+  test::ResourceKey surface_key;
+  TextInputV3Client v3;
+
+  PostToClientAndWait([&](test::TestClient* client) {
+    ASSERT_TRUE(client->InitShmBufferFactory(256 * 256 * 4));
+    auto* data_ptr =
+        client->set_data(std::make_unique<test::ShellClientData>(client));
+    data_ptr->CreateXdgToplevel();
+    data_ptr->CreateAndAttachBuffer({256, 256});
+    data_ptr->Commit();
+    surface_key = data_ptr->GetSurfaceResourceKey();
+
+    wl_registry* registry = wl_display_get_registry(client->display());
+    wl_registry_add_listener(registry, &kRegistryListener, &v3);
+    client->Roundtrip();
+    wl_registry_destroy(registry);
+    ASSERT_TRUE(v3.manager);
+    v3.text_input =
+        zwp_text_input_manager_v3_get_text_input(v3.manager, client->seat());
+    zwp_text_input_v3_add_listener(v3.text_input, &kTextInputListener, &v3);
+    client->Roundtrip();
+  });
+
+  Surface* surface = test::server_util::GetUserDataForResource<Surface>(
+      server_.get(), surface_key);
+  ASSERT_TRUE(surface);
+  aura::client::FocusClient* focus_client =
+      aura::client::GetFocusClient(ash::Shell::GetPrimaryRootWindow());
+  focus_client->FocusWindow(nullptr);
+  focus_client->FocusWindow(surface->window());
+
+  // Keyboard focus sends enter; the client enables text input there.
+  PostToClientAndWait([&](test::TestClient* client) {
+    client->Roundtrip();
+    auto* data_ptr = client->GetDataAs<test::ShellClientData>();
+    EXPECT_EQ(v3.entered, data_ptr->GetWlSurface());
+    ASSERT_FALSE(v3.events.empty());
+    EXPECT_EQ(v3.events.back(), "enter");
+    v3.events.clear();
+
+    zwp_text_input_v3_enable(v3.text_input);
+    zwp_text_input_v3_set_content_type(v3.text_input,
+                                       ZWP_TEXT_INPUT_V3_CONTENT_HINT_NONE,
+                                       ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_EMAIL);
+    zwp_text_input_v3_set_surrounding_text(v3.text_input, "hello", 5, 5);
+    zwp_text_input_v3_set_cursor_rectangle(v3.text_input, 10, 20, 1, 16);
+    zwp_text_input_v3_commit(v3.text_input);
+    client->Roundtrip();
+  });
+
+  // The input method now sees the client's text input.
+  ui::InputMethod* input_method =
+      surface->window()->GetHost()->GetInputMethod();
+  ui::TextInputClient* text_input_client = input_method->GetTextInputClient();
+  ASSERT_TRUE(text_input_client);
+  EXPECT_EQ(text_input_client->GetTextInputType(), ui::TEXT_INPUT_TYPE_EMAIL);
+  gfx::Range selection;
+  ASSERT_TRUE(text_input_client->GetEditableSelectionRange(&selection));
+  EXPECT_EQ(selection, gfx::Range(5));
+
+  // What an IME does: delete before the cursor, compose, commit.
+  text_input_client->ExtendSelectionAndDelete(1, 0);
+  ui::CompositionText composition;
+  composition.text = u"にほ";  // にほ
+  composition.selection = gfx::Range(2);
+  text_input_client->SetCompositionText(composition);
+  text_input_client->InsertText(
+      u"日本",  // 日本
+      ui::TextInputClient::InsertTextCursorBehavior::kMoveCursorAfterText);
+
+  PostToClientAndWait([&](test::TestClient* client) {
+    client->Roundtrip();
+    EXPECT_EQ(v3.events, (std::vector<std::string>{"delete 1 0", "done 1",
+                                                   "preedit にほ 6 6", "done 1",
+                                                   "commit 日本", "done 1"}));
+    v3.events.clear();
+
+    // Serials count the client's commits.
+    zwp_text_input_v3_set_surrounding_text(v3.text_input, "hell日本", 10, 10);
+    zwp_text_input_v3_commit(v3.text_input);
+    client->Roundtrip();
+  });
+
+  composition.text = u"a";
+  composition.selection = gfx::Range(1);
+  text_input_client->SetCompositionText(composition);
+  text_input_client->ClearCompositionText();
+
+  PostToClientAndWait([&](test::TestClient* client) {
+    client->Roundtrip();
+    EXPECT_EQ(v3.events,
+              (std::vector<std::string>{"preedit a 1 1", "done 2",
+                                        "preedit  -1 -1", "done 2"}));
+    v3.events.clear();
+  });
+
+  // Losing keyboard focus sends leave and detaches the input method.
+  focus_client->FocusWindow(nullptr);
+  EXPECT_NE(input_method->GetTextInputClient(), text_input_client);
+
+  PostToClientAndWait([&](test::TestClient* client) {
+    client->Roundtrip();
+    EXPECT_EQ(v3.events, std::vector<std::string>{"leave"});
+    zwp_text_input_v3_destroy(v3.text_input);
+    zwp_text_input_manager_v3_destroy(v3.manager);
+    client->Roundtrip();
+  });
+}
+
+}  // namespace
+}  // namespace exo::wayland
