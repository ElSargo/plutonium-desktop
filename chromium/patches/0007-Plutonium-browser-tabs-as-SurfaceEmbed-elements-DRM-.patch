+ScriptPromise<IDLUndefined> NativeWindowBroker::navigateTab(
+    ScriptState* script_state,
+    int32_t tab_id,
+    const String& url) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLUndefined>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->NavigateTab(
+      tab_id, url,
+      BindOnce(
+          [](NativeWindowBroker* self,
+             ScriptPromiseResolver<IDLUndefined>* resolver, bool ok) {
+            self->pending_.erase(resolver);
+            if (!ok) {
+              resolver->RejectWithDOMException(
+                  DOMExceptionCode::kNotFoundError,
+                  "No such tab, or can't open that URL.");
+              return;
+            }
+            resolver->Resolve();
+          },
+          WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+void NativeWindowBroker::tabCommand(int32_t tab_id,
+                                    const V8BrowserTabCommand& command) {
+  if (!BindRemote()) {
+    return;
+  }
+  mojom::blink::BrowserTabCommand c = mojom::blink::BrowserTabCommand::kStop;
+  switch (command.AsEnum()) {
+    case V8BrowserTabCommand::Enum::kBack:
+      c = mojom::blink::BrowserTabCommand::kBack;
+      break;
+    case V8BrowserTabCommand::Enum::kForward:
+      c = mojom::blink::BrowserTabCommand::kForward;
+      break;
+    case V8BrowserTabCommand::Enum::kReload:
+      c = mojom::blink::BrowserTabCommand::kReload;
+      break;
+    case V8BrowserTabCommand::Enum::kStop:
+      c = mojom::blink::BrowserTabCommand::kStop;
+      break;
+    case V8BrowserTabCommand::Enum::kClose:
+      c = mojom::blink::BrowserTabCommand::kClose;
+      break;
+  }
+  remote_->TabCommand(tab_id, c);
+}
+
+void NativeWindowBroker::answerTabDialog(int32_t tab_id,
+                                         bool accept,
+                                         const String& prompt_text) {
+  if (!BindRemote()) {
+    return;
+  }
+  remote_->AnswerTabDialog(tab_id, accept, prompt_text);
+}
+
+ScriptPromise<Blob> NativeWindowBroker::snapshotTab(ScriptState* script_state,
+                                                    int32_t tab_id) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<Blob>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->SnapshotTab(
+      tab_id,
+      BindOnce(
+          [](NativeWindowBroker* self, ScriptPromiseResolver<Blob>* resolver,
+             std::optional<mojo_base::BigBuffer> png) {
+            self->pending_.erase(resolver);
+            if (!png) {
+              resolver->RejectWithDOMException(
+                  DOMExceptionCode::kNotFoundError,
+                  "No such tab, or it could not be copied.");
+              return;
+            }
+            resolver->Resolve(Blob::Create(base::span(*png), "image/png"));
+          },
+          WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
