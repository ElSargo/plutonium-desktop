+// The size a tab lays out at before an <embed> first shows it.
+constexpr gfx::Size kDefaultTabSize(1280, 800);
+
+// How long a hidden tab gets to produce a frame for a snapshot.
+constexpr base::TimeDelta kHiddenSnapshotTimeout = base::Seconds(3);
+
+// Takes one frame of a hidden tab. A hidden tab's view isn't in any
+// compositor tree, so CopyFromSurface() has nothing to copy; a frame sink
+// video capturer reads the renderer's own frames instead (as tab hover-card
+// thumbnails do), while a capturer count keeps the hidden page painting.
+// Deletes itself after the first frame or the timeout.
+class HiddenTabFrameGrabber : public viz::mojom::FrameSinkVideoConsumer {
+ public:
+  ~HiddenTabFrameGrabber() override = default;
+
+  static void Start(content::WebContents* contents,
+                    base::OnceCallback<void(const SkBitmap&)> callback) {
+    content::RenderWidgetHostView* view = contents->GetRenderWidgetHostView();
+    if (!view) {
+      std::move(callback).Run(SkBitmap());
+      return;
+    }
+    gfx::Size size = gfx::ScaleToCeiledSize(view->GetViewBounds().size(),
+                                            view->GetDeviceScaleFactor());
+    if (size.IsEmpty()) {
+      std::move(callback).Run(SkBitmap());
+      return;
+    }
+    auto* grabber = new HiddenTabFrameGrabber(std::move(callback));
+    grabber->capture_ = contents->IncrementCapturerCount(
+        gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/true,
+        /*is_activity=*/false);
+    grabber->capturer_ = view->CreateVideoCapturer();
+    grabber->capturer_->SetIsSecure(true);
+    grabber->capturer_->SetResolutionConstraints(size, size, false);
+    grabber->capturer_->SetAutoThrottlingEnabled(false);
+    grabber->capturer_->SetMinSizeChangePeriod(base::TimeDelta());
+    grabber->capturer_->SetFormat(media::PIXEL_FORMAT_ARGB);
+    grabber->capturer_->Start(grabber,
+                              viz::mojom::BufferFormatPreference::kDefault);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&HiddenTabFrameGrabber::Finish,
+                       grabber->weak_factory_.GetWeakPtr(), SkBitmap()),
+        kHiddenSnapshotTimeout);
+  }
+
+  // viz::mojom::FrameSinkVideoConsumer:
+  void OnFrameCaptured(
+      media::mojom::VideoBufferHandlePtr data,
+      media::mojom::VideoFrameInfoPtr info,
+      const gfx::Rect& content_rect,
+      mojo::PendingRemote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>
+          callbacks) override {
+    mojo::Remote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks> done(
+        std::move(callbacks));
+    if (!data->is_read_only_shmem_region()) {
+      return;
+    }
+    base::ReadOnlySharedMemoryMapping mapping =
+        data->get_read_only_shmem_region().Map();
+    if (!mapping.IsValid() ||
+        mapping.size() < media::VideoFrame::AllocationSize(
+                             info->pixel_format, info->coded_size)) {
+      return;
+    }
+    const SkImageInfo image_info = SkImageInfo::MakeN32(
+        content_rect.right(), content_rect.bottom(), kPremul_SkAlphaType,
+        info->color_space.ToSkColorSpace());
+    const size_t row_bytes = media::VideoFrame::RowBytes(
+        media::VideoFrame::Plane::kARGB, info->pixel_format,
+        info->coded_size.width());
+    if (mapping.size() < image_info.computeByteSize(row_bytes)) {
+      return;
+    }
+    SkBitmap frame;
+    frame.installPixels(image_info,
+                        const_cast<uint8_t*>(mapping.data()), row_bytes);
+    SkBitmap subset;
+    SkBitmap copy;
+    if (!frame.extractSubset(&subset, gfx::RectToSkIRect(content_rect)) ||
+        !copy.tryAllocPixels(subset.info().makeAlphaType(kPremul_SkAlphaType)) ||
+        !subset.readPixels(copy.pixmap())) {
+      return;
+    }
+    Finish(std::move(copy));
+  }
+  void OnNewCaptureVersion(const media::CaptureVersion&) override {}
+  void OnFrameWithEmptyRegionCapture() override {}
+  void OnStopped() override {}
+  void OnLog(const std::string&) override {}
+
+ private:
+  explicit HiddenTabFrameGrabber(
+      base::OnceCallback<void(const SkBitmap&)> callback)
+      : callback_(std::move(callback)) {}
+
+  void Finish(SkBitmap bitmap) {
+    if (!callback_) {
+      return;
+    }
+    capturer_->Stop();
+    std::move(callback_).Run(bitmap);
+    // Not from inside the capturer's own call.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                              this);
+  }
+
+  base::OnceCallback<void(const SkBitmap&)> callback_;
+  base::ScopedClosureRunner capture_;
+  std::unique_ptr<viz::ClientFrameSinkVideoCapturer> capturer_;
+  base::WeakPtrFactory<HiddenTabFrameGrabber> weak_factory_{this};
+};
+
+}  // namespace
+
+// One tab: owns its WebContents and is its delegate.
+class PlutoniumTabs::Tab : public content::WebContentsDelegate,
+                           public content::WebContentsObserver,
+                           public content::JavaScriptDialogManager {
+ public:
+  Tab(PlutoniumTabs* tabs,
+      int32_t id,
+      std::unique_ptr<content::WebContents> contents,
+      std::string tag,
+      int32_t opener_id,
+      const char* opened_by)
+      : content::WebContentsObserver(contents.get()),
+        tabs_(tabs),
+        contents_(std::move(contents)) {
+    info_.id = id;
+    info_.tag = std::move(tag);
+    info_.opener_id = opener_id;
+    info_.opened_by = opened_by;
+    contents_->SetDelegate(this);
+    info_.content_id =
+        surface_embed::SurfaceEmbedHandle::CreateForWebContents(contents_.get())
+            ->id();
+    Refresh();
+  }
+
+  ~Tab() override {
+    CancelDialog();
+    Observe(nullptr);
+    contents_->SetDelegate(nullptr);
+  }
+
+  content::WebContents* contents() const { return contents_.get(); }
+  void Changed() { tabs_->TabChanged(this); }
+  const TabInfo& info() const { return info_; }
+
+  // Re-reads the tab's state; true if it changed.
+  bool Refresh() {
+    const bool embedded = !!contents_->GetSurfaceEmbedConnector();
+    content::RenderWidgetHostView* view = contents_->GetRenderWidgetHostView();
+    if (embedded && view && !view->GetViewBounds().IsEmpty()) {
+      size_ = view->GetViewBounds().size();
+    } else if (!embedded && info_.embedded) {
+      // Detaching gives the tab a fresh, unsized view: keep the page laid
+      // out at the size it was shown at (and snapshots of it meaningful).
+      contents_->Resize(gfx::Rect(size_));
+    }
+    if (!embedded) {
+      Park();
+    }
+    TabInfo info = info_;
+    info.url = contents_->GetVisibleURL();
+    info.title = contents_->GetTitle();
+    info.loading = contents_->IsLoading();
+    info.can_go_back = contents_->GetController().CanGoBack();
+    info.can_go_forward = contents_->GetController().CanGoForward();
+    info.embedded = embedded;
+    info.focused = embedded && view && view->HasFocus() &&
+                   contents_->ContainsOrIsFocusedWebContents();
+    info.dialog_type = dialog_type_;
+    info.dialog_message = dialog_message_;
+    info.dialog_default_prompt = dialog_default_prompt_;
+    if (info == info_) {
+      return false;
+    }
+    info_ = std::move(info);
+    return true;
+  }
+
+  // content::WebContentsDelegate:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override {
+    content::WebContents* target = nullptr;
+    switch (params.disposition) {
+      case WindowOpenDisposition::CURRENT_TAB:
+        target = source;
+        break;
+      case WindowOpenDisposition::NEW_FOREGROUND_TAB:
+      case WindowOpenDisposition::NEW_BACKGROUND_TAB:
+      case WindowOpenDisposition::NEW_POPUP:
+      case WindowOpenDisposition::NEW_WINDOW:
+      case WindowOpenDisposition::SINGLETON_TAB:
+      case WindowOpenDisposition::SWITCH_TO_TAB: {
+        content::WebContents::CreateParams create_params(
+            source->GetBrowserContext());
+        create_params.initially_hidden = true;
+        std::unique_ptr<content::WebContents> contents =
+            content::WebContents::Create(create_params);
+        contents->Resize(gfx::Rect(size_));
+        target = tabs_->AddTab(std::move(contents), info_.tag, info_.id,
+                               "page")
+                     ->contents();
+        break;
+      }
+      default:
+        // Downloads, "save link as" and the like aren't tabs.
+        return nullptr;
+    }
+    base::WeakPtr<content::NavigationHandle> handle =
+        target->GetController().LoadURLWithParams(
+            content::NavigationController::LoadURLParams(params));
+    if (handle && navigation_handle_callback) {
+      std::move(navigation_handle_callback).Run(*handle);
+    }
+    return target;
+  }
+
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override {
+    // window.open() and the like. Every new window is a tab; the shell
+    // decides whether and where to show it. Without a user gesture it's a
+    // popup Chrome would block (its popup blocker lives in tab helpers these
+    // tabs don't have): drop it.
+    if (!user_gesture) {
+      VLOG(1) << "EXO-TABS tab #" << info_.id << ": blocked a popup to "
+              << target_url.spec() << " (no user gesture)";
+      if (was_blocked) {
+        *was_blocked = true;
+      }
+      return nullptr;
+    }
+    if (new_contents->GetContainerBounds().IsEmpty()) {
+      new_contents->Resize(gfx::Rect(size_));
+    }
+    return tabs_->AddTab(std::move(new_contents), info_.tag, info_.id, "page")
+        ->contents();
+  }
+
+  void CloseContents(content::WebContents* source) override {
+    tabs_->RemoveTab(info_.id);
+  }
+
+  void NavigationStateChanged(content::WebContents* source,
+                              content::InvalidateTypes changed_flags) override {
+    tabs_->TabChanged(this);
+  }
+
+  void LoadingStateChanged(content::WebContents* source,
+                           bool should_show_loading_ui) override {
+    tabs_->TabChanged(this);
+  }
+
+  bool ShouldFocusPageAfterCrash(content::WebContents* source) override {
+    return false;
+  }
+
+  content::JavaScriptDialogManager* GetJavaScriptDialogManager(
+      content::WebContents* source) override {
+    return this;
+  }
+
+  // content::JavaScriptDialogManager: the shell shows the dialog (it sees
+  // it in the tab's state) and answers through AnswerDialog().
+  void RunJavaScriptDialog(content::WebContents* web_contents,
+                           content::RenderFrameHost* render_frame_host,
+                           content::JavaScriptDialogType dialog_type,
+                           const std::u16string& message_text,
+                           const std::u16string& default_prompt_text,
+                           DialogClosedCallback callback,
+                           bool* did_suppress_message) override {
+    if (dialog_callback_) {
+      *did_suppress_message = true;
+      return;
+    }
+    switch (dialog_type) {
+      case content::JAVASCRIPT_DIALOG_TYPE_ALERT:
+        dialog_type_ = "alert";
+        break;
+      case content::JAVASCRIPT_DIALOG_TYPE_CONFIRM:
+        dialog_type_ = "confirm";
+        break;
+      case content::JAVASCRIPT_DIALOG_TYPE_PROMPT:
+        dialog_type_ = "prompt";
+        break;
+    }
+    ShowDialog(message_text, default_prompt_text, std::move(callback));
+  }
+
+  void RunBeforeUnloadDialog(content::WebContents* web_contents,
+                             content::RenderFrameHost* render_frame_host,
+                             bool is_reload,
+                             DialogClosedCallback callback) override {
+    if (dialog_callback_) {
+      // Stay on the page.
+      std::move(callback).Run(false, std::u16string());
+      return;
+    }
+    dialog_type_ = "beforeunload";
+    ShowDialog(is_reload ? u"Reload this page? Changes you made may not be "
+                           u"saved."
+                         : u"Leave this page? Changes you made may not be "
+                           u"saved.",
+               std::u16string(), std::move(callback));
+  }
+
+  bool HandleJavaScriptDialog(content::WebContents* web_contents,
+                              bool accept,
+                              const std::u16string* prompt_override) override {
+    if (!dialog_callback_) {
+      return false;
+    }
+    Answer(accept, prompt_override ? *prompt_override : dialog_default_prompt_);
+    return true;
+  }
+
+  void CancelDialogs(content::WebContents* web_contents,
+                     bool reset_state) override {
+    CancelDialog();
+  }
+
+  void Answer(bool accept, const std::u16string& prompt_text) {
+    if (!dialog_callback_) {
+      return;
+    }
+    DialogClosedCallback callback = std::move(dialog_callback_);
+    dialog_type_.clear();
+    dialog_message_.clear();
+    dialog_default_prompt_.clear();
+    std::move(callback).Run(accept, prompt_text);
+    tabs_->TabChanged(this);
+  }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    tabs_->TabChanged(this);
+  }
+
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    // An <embed> attaching or detaching the tab changes its visibility. On
+    // detach that happens before the connector goes: look once it's done.
+    tabs_->TabChanged(this);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&Tab::Changed, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnFocusChangedInPage(const content::FocusedNodeDetails& details) override {
+    tabs_->TabChanged(this);
+  }
+
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override {
+    LOG(WARNING) << "EXO-TABS tab #" << info_.id << " renderer gone ("
+                 << status << ")";
+    tabs_->TabChanged(this);
+  }
+
+ private:
+  // Keeps the tab's own (hidden) view in the shell's window tree while no
+  // <embed> shows it.
+  void Park() {
+    aura::Window* window = contents_->GetNativeView();
+    aura::Window* parking = tabs_->parking();
+    if (!window || !parking || window->parent()) {
+      return;
+    }
+    window->Hide();
+    parking->AddChild(window);
+    parking->StackChildAtBottom(window);
+  }
+
+  void ShowDialog(const std::u16string& message,
+                  const std::u16string& default_prompt,
+                  DialogClosedCallback callback) {
+    dialog_message_ = message;
+    dialog_default_prompt_ = default_prompt;
+    dialog_callback_ = std::move(callback);
+    tabs_->TabChanged(this);
+  }
+
+  void CancelDialog() {
+    if (dialog_callback_) {
+      Answer(false, std::u16string());
+    }
+  }
+
+  const raw_ptr<PlutoniumTabs> tabs_;
+  std::unique_ptr<content::WebContents> contents_;
+  TabInfo info_;
+  // The size the page is laid out at while no <embed> shows it.
+  gfx::Size size_ = kDefaultTabSize;
+  std::string dialog_type_;
+  std::u16string dialog_message_;
+  std::u16string dialog_default_prompt_;
+  DialogClosedCallback dialog_callback_;
+  base::WeakPtrFactory<Tab> weak_factory_{this};
+};
+
+// Watches the shell page: focus moving within it (e.g. to its own controls)
+// is how an embedded tab loses keyboard focus.
+class PlutoniumTabs::ShellObserver : public content::WebContentsObserver {
+ public:
+  ShellObserver(PlutoniumTabs* tabs, content::WebContents* shell)
+      : content::WebContentsObserver(shell), tabs_(tabs) {}
+
+  void OnFocusChangedInPage(const content::FocusedNodeDetails&) override {
+    tabs_->RefreshAll();
+  }
+  void OnWebContentsFocused(content::RenderWidgetHost*) override {
+    tabs_->RefreshAll();
+  }
+  void OnWebContentsLostFocus(content::RenderWidgetHost*) override {
+    tabs_->RefreshAll();
+  }
+
+ private:
+  const raw_ptr<PlutoniumTabs> tabs_;
+};
+
+PlutoniumTabs::TabInfo::TabInfo() = default;
+PlutoniumTabs::TabInfo::TabInfo(const TabInfo&) = default;
+PlutoniumTabs::TabInfo& PlutoniumTabs::TabInfo::operator=(const TabInfo&) =
+    default;
+PlutoniumTabs::TabInfo::~TabInfo() = default;
+bool PlutoniumTabs::TabInfo::operator==(const TabInfo&) const = default;
+
+PlutoniumTabs::PlutoniumTabs() = default;
+PlutoniumTabs::~PlutoniumTabs() = default;
+
+// static
+PlutoniumTabs* PlutoniumTabs::Get() {
+  static base::NoDestructor<PlutoniumTabs> instance;
+  return instance.get();
+}
+
+void PlutoniumTabs::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void PlutoniumTabs::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+std::vector<PlutoniumTabs::TabInfo> PlutoniumTabs::GetTabs() const {
+  std::vector<TabInfo> tabs;
+  for (const auto& [id, tab] : tabs_) {
+    tabs.push_back(tab->info());
+  }
+  return tabs;
+}
+
+bool PlutoniumTabs::IsTab(const content::WebContents* contents) const {
+  for (const auto& [id, tab] : tabs_) {
+    if (tab->contents() == contents) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::optional<PlutoniumTabs::TabInfo> PlutoniumTabs::GetTab(
+    int32_t tab_id) const {
+  if (Tab* tab = FindTab(tab_id)) {
+    return tab->info();
+  }
+  return std::nullopt;
+}
+
+// static
+GURL PlutoniumTabs::ToLoadableUrl(const std::string& text) {
+  GURL url = url_formatter::FixupURL(text);
+  if (!url.is_valid() || url.SchemeIs(url::kJavaScriptScheme)) {
+    return GURL();
+  }
+  return url;
+}
+
+void PlutoniumTabs::RefreshAll() {
+  std::vector<Tab*> tabs;
+  for (const auto& [id, tab] : tabs_) {
+    tabs.push_back(tab.get());
+  }
+  for (Tab* tab : tabs) {
+    TabChanged(tab);
+  }
+}
+
+std::optional<PlutoniumTabs::TabInfo> PlutoniumTabs::CreateTab(
+    content::WebContents* shell,
+    const std::string& url_text,
+    const std::string& tag) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  content::BrowserContext* browser_context = shell->GetBrowserContext();
+  if (aura::Window* window = shell->GetTopLevelNativeWindow()) {
+    parking_.RemoveAll();
+    parking_.Add(window);
+  }
+  if (!shell_observer_ || shell_observer_->web_contents() != shell) {
+    shell_observer_ = std::make_unique<ShellObserver>(this, shell);
+  }
+  GURL url = ToLoadableUrl(url_text);
+  if (!url.is_valid()) {
+    VLOG(1) << "EXO-TABS refusing to open \"" << url_text << "\"";
+    return std::nullopt;
+  }
+  content::WebContents::CreateParams params(browser_context);
+  params.initially_hidden = true;
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(params);
+  contents->Resize(gfx::Rect(kDefaultTabSize));
+  Tab* tab = AddTab(std::move(contents), tag, 0, "shell");
+  content::NavigationController::LoadURLParams load(url);
+  load.transition_type = ui::PageTransitionFromInt(
+      ui::PAGE_TRANSITION_TYPED | ui::PAGE_TRANSITION_FROM_ADDRESS_BAR);
+  tab->contents()->GetController().LoadURLWithParams(load);
+  tab->Refresh();
+  return tab->info();
+}
+
+bool PlutoniumTabs::Navigate(int32_t tab_id, const std::string& url_text) {
+  Tab* tab = FindTab(tab_id);
+  GURL url = ToLoadableUrl(url_text);
+  if (!tab || !url.is_valid()) {
+    return false;
+  }
+  content::NavigationController::LoadURLParams load(url);
+  load.transition_type = ui::PageTransitionFromInt(
+      ui::PAGE_TRANSITION_TYPED | ui::PAGE_TRANSITION_FROM_ADDRESS_BAR);
+  tab->contents()->GetController().LoadURLWithParams(load);
+  return true;
+}
+
+void PlutoniumTabs::RunCommand(int32_t tab_id, Command command) {
+  Tab* tab = FindTab(tab_id);
+  if (!tab) {
+    return;
+  }
+  content::NavigationController& controller = tab->contents()->GetController();
+  switch (command) {
+    case Command::kBack:
+      if (controller.CanGoBack()) {
+        controller.GoBack();
+      }
+      break;
+    case Command::kForward:
+      if (controller.CanGoForward()) {
+        controller.GoForward();
+      }
+      break;
+    case Command::kReload:
+      controller.Reload(content::ReloadType::NORMAL, /*check_for_repost=*/false);
+      break;
+    case Command::kStop:
+      tab->contents()->Stop();
+      break;
+    case Command::kClose:
+      RemoveTab(tab_id);
+      break;
+  }
+}
+
+void PlutoniumTabs::AnswerDialog(int32_t tab_id,
+                                 bool accept,
+                                 const std::u16string& prompt_text) {
+  if (Tab* tab = FindTab(tab_id)) {
+    tab->Answer(accept, prompt_text);
+  }
+}
+
+void PlutoniumTabs::Snapshot(
+    int32_t tab_id,
+    base::OnceCallback<void(const SkBitmap&)> callback) {
+  Tab* tab = FindTab(tab_id);
+  content::RenderWidgetHostView* view =
+      tab ? tab->contents()->GetRenderWidgetHostView() : nullptr;
+  if (!view) {
+    std::move(callback).Run(SkBitmap());
+    return;
+  }
+  if (tab->contents()->GetVisibility() != content::Visibility::VISIBLE) {
+    HiddenTabFrameGrabber::Start(tab->contents(), std::move(callback));
+    return;
+  }
+  view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), base::Seconds(2),
+      base::BindOnce(
+          [](base::OnceCallback<void(const SkBitmap&)> callback,
+             const content::CopyFromSurfaceResult& result) {
+            std::move(callback).Run(result.has_value() ? result->bitmap
+                                                       : SkBitmap());
+          },
+          std::move(callback)));
+}
+
+void PlutoniumTabs::OnProfileWillBeDestroyed(Profile* profile) {
+  // A WebContents must not outlive its profile.
+  std::vector<int32_t> doomed;
+  for (const auto& [id, tab] : tabs_) {
+    if (tab->contents()->GetBrowserContext() == profile) {
+      doomed.push_back(id);
+    }
+  }
+  for (int32_t id : doomed) {
+    auto it = tabs_.find(id);
+    std::unique_ptr<Tab> tab = std::move(it->second);
+    tabs_.erase(it);
+    for (Observer& observer : observers_) {
+      observer.OnTabRemoved(id);
+    }
+  }
+  profile_observations_.RemoveObservation(profile);
+}
+
+PlutoniumTabs::Tab* PlutoniumTabs::AddTab(
+    std::unique_ptr<content::WebContents> contents,
+    const std::string& tag,
+    int32_t opener_id,
+    const char* opened_by) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (!profile_observations_.IsObservingSource(profile)) {
+    profile_observations_.AddObservation(profile);
+  }
+  int32_t id = next_id_++;
+  auto owned = std::make_unique<Tab>(this, id, std::move(contents), tag,
+                                     opener_id, opened_by);
+  Tab* tab = owned.get();
+  tabs_[id] = std::move(owned);
+  VLOG(1) << "EXO-TABS tab #" << id << " added (opened by " << opened_by
+          << (opener_id ? " #" + base::NumberToString(opener_id) : "")
+          << ", tag \"" << tag << "\")";
+  for (Observer& observer : observers_) {
+    observer.OnTabAdded(tab->info());
+  }
+  return tab;
+}
+
+void PlutoniumTabs::RemoveTab(int32_t tab_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = tabs_.find(tab_id);
+  if (it == tabs_.end()) {
+    return;
+  }
+  std::unique_ptr<Tab> tab = std::move(it->second);
+  tabs_.erase(it);
+  VLOG(1) << "EXO-TABS tab #" << tab_id << " removed";
+  for (Observer& observer : observers_) {
+    observer.OnTabRemoved(tab_id);
+  }
+  // This may run inside one of the tab's own WebContents calls
+  // (CloseContents): destroy it once that has returned.
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                            std::move(tab));
+}
+
+void PlutoniumTabs::TabChanged(Tab* tab) {
+  // Not registered yet (called from Tab's constructor) or already removed.
+  if (FindTab(tab->info().id) != tab || !tab->Refresh()) {
+    return;
+  }
+  for (Observer& observer : observers_) {
+    observer.OnTabChanged(tab->info());
+  }
+}
+
+aura::Window* PlutoniumTabs::parking() const {
+  return parking_.windows().empty() ? nullptr : parking_.windows().front();
+}
+
+PlutoniumTabs::Tab* PlutoniumTabs::FindTab(int32_t tab_id) const {
+  auto it = tabs_.find(tab_id);
+  return it == tabs_.end() ? nullptr : it->second.get();
+}
