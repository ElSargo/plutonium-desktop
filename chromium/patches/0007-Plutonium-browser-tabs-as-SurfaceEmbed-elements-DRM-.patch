+    const String& tag) {
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<BrowserTabEntry>>(
+          script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->CreateTab(
+      url, tag,
+      BindOnce(
+          [](NativeWindowBroker* self,
