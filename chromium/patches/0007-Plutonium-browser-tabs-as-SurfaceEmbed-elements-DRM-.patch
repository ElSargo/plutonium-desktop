+
+#include "third_party/blink/renderer/core/html/browser_tab_event.h"
+
+#include "third_party/blink/renderer/bindings/core/v8/to_v8_traits.h"
+#include "third_party/blink/renderer/bindings/core/v8/v8_browser_tab_entry.h"
+#include "third_party/blink/renderer/core/event_interface_names.h"
+#include "third_party/blink/renderer/platform/bindings/script_state.h"
+
+namespace blink {
+
+BrowserTabEvent::BrowserTabEvent(const AtomicString& type,
+                                 int32_t tab_id,
+                                 BrowserTabEntry* entry)
+    : Event(type, Bubbles::kNo, Cancelable::kNo),
+      tab_id_(tab_id),
+      entry_(entry) {}
+
+ScriptValue BrowserTabEvent::entry(ScriptState* script_state) const {
+  v8::Isolate* isolate = script_state->GetIsolate();
+  if (!entry_) {
+    return ScriptValue::CreateNull(isolate);
+  }
+  return ScriptValue(isolate,
+                     ToV8Traits<BrowserTabEntry>::ToV8(script_state, entry_.Get()));
+}
+
+const AtomicString& BrowserTabEvent::InterfaceName() const {
+  return event_interface_names::kBrowserTabEvent;
+}
+
+void BrowserTabEvent::Trace(Visitor* visitor) const {
+  visitor->Trace(entry_);
+  Event::Trace(visitor);
+}
+
+}  // namespace blink
