+blink::mojom::BrowserTabEntryPtr ToMojo(const PlutoniumTabs::TabInfo& tab) {
+  return blink::mojom::BrowserTabEntry::New(
+      tab.id, tab.content_id, tab.url.spec(), base::UTF16ToUTF8(tab.title),
+      tab.loading, tab.can_go_back, tab.can_go_forward, tab.embedded,
+      tab.focused, tab.tag, tab.opener_id, tab.opened_by, tab.dialog_type,
+      base::UTF16ToUTF8(tab.dialog_message),
+      base::UTF16ToUTF8(tab.dialog_default_prompt));
+}
+
+std::vector<blink::mojom::BrowserTabEntryPtr> CurrentTabs() {
+  std::vector<blink::mojom::BrowserTabEntryPtr> result;
+  for (const PlutoniumTabs::TabInfo& tab : PlutoniumTabs::Get()->GetTabs()) {
+    result.push_back(ToMojo(tab));
+  }
+  return result;
+}
