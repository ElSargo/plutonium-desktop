+
+namespace {
+PlutoniumLock* g_lock = nullptr;
+}  // namespace
+
+// static
+PlutoniumLock* PlutoniumLock::Get() {
+  return g_lock;
+}
+
+PlutoniumLock::PlutoniumLock() {
+  CHECK(!g_lock);
+  g_lock = this;
+}
+
+PlutoniumLock::~PlutoniumLock() {
+  g_lock = nullptr;
+}
+
+void PlutoniumLock::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void PlutoniumLock::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void PlutoniumLock::NotifyLockChanged(bool locked) {
+  for (Observer& observer : observers_) {
+    observer.OnLockChanged(locked);
+  }
+}
