index 2954f49beb..eda419da8b 100644
--- a/chromeos/dbus/power/power_policy_controller.h
+++ b/chromeos/dbus/power/power_policy_controller.h
@@ -202,6 +202,11 @@ class COMPONENT_EXPORT(DBUS_POWER) PowerPolicyController
   // and sends an updated policy.
   void RemoveWakeLock(int id);
 
+  // PLUTONIUM (EXO-LOCK): the descriptions of the wake locks that keep the
+  // screen on (screen and dim ones), for Plutonium's own idle handling: there
+  // is no powerd to send the policy to.
+  std::vector<std::string> GetScreenWakeLockDescriptions() const;
+
   // Adjusts policy while Chrome is exiting. The lid-closed action
   // is overridden to ensure that the system doesn't suspend or shut
   // down.
