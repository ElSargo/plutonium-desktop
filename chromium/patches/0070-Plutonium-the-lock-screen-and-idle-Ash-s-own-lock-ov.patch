+
+Response PlutoniumHandler::Lock(std::optional<std::string> user,
+                                std::optional<std::string> message) {
+  PlutoniumLock* lock = PlutoniumLock::Get();
+  if (!lock) {
+    return Response::ServerError("There's a lock only in shell mode.");
+  }
+  lock->Lock(base::UTF8ToUTF16(user.value_or("")),
+             base::UTF8ToUTF16(message.value_or("")));
+  return Response::Success();
+}
+
+Response PlutoniumHandler::GetIdle(
+    bool* locked,
+    double* idle_seconds,
+    bool* displays_off,
+    std::unique_ptr<protocol::Array<std::string>>* wake_locks) {
+  PlutoniumLock* lock = PlutoniumLock::Get();
+  if (!lock) {
+    return Response::ServerError("There's a lock only in shell mode.");
+  }
+  *locked = lock->IsLocked();
+  *idle_seconds = lock->GetIdleTime().InSecondsF();
+  *displays_off = lock->AreDisplaysOff();
+  *wake_locks =
+      std::make_unique<protocol::Array<std::string>>(lock->GetWakeLocks());
+  return Response::Success();
+}
+
+Response PlutoniumHandler::SetDisplaysOff(bool off, bool* applied) {
+  PlutoniumLock* lock = PlutoniumLock::Get();
+  if (!lock) {
+    return Response::ServerError("There's a lock only in shell mode.");
+  }
+  *applied = lock->SetDisplaysOff(off);
+  return Response::Success();
+}
+
+void PlutoniumHandler::OnLockChanged(bool locked) {
+  frontend_->LockChanged(locked);
+}
