+    password_->SetFontList(gfx::FontList().DeriveWithSizeDelta(4));
+    password_->SetBackgroundColor(kField);
+    password_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(10, 14)));
+    password_->SetBackground(views::CreateRoundedRectBackground(kField, 10));
+    password_->SetPreferredSize(gfx::Size(340, 48));
+    message_ = AddLabel(this, u"", kDim, 2);
+    message_->SetMultiLine(true);
+    message_->SetMaximumWidth(520);
+    message_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  }
+  PlutoniumLockView(const PlutoniumLockView&) = delete;
+  PlutoniumLockView& operator=(const PlutoniumLockView&) = delete;
+  ~PlutoniumLockView() override = default;
+
+  void SetTime(base::Time now) {
+    const std::u16string time = base::TimeFormatTimeOfDay(now);
+    if (time != clock_->GetText()) {
+      clock_->SetText(time);
+      date_->SetText(base::TimeFormatFriendlyDate(now));
+    }
+  }
+
+  void SetUser(const std::u16string& user) {
+    if (user_) {
+      user_->SetText(user);
+      user_->SetVisible(!user.empty());
+    }
+  }
+
+  void SetMessage(const std::u16string& message, bool error) {
+    if (message_ && message != message_->GetText()) {
+      message_->SetText(message);
+      message_->SetEnabledColor(error ? kError : kDim);
+    }
+  }
+
+  void ClearPassword() {
+    if (password_) {
+      password_->SetText(u"");
+    }
+  }
+
+  void FocusPassword() {
+    if (password_) {
+      password_->RequestFocus();
+    }
+  }
+
+  // views::TextfieldController:
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override {
+    if (event.type() != ui::EventType::kKeyPressed) {
+      return false;
+    }
+    if ((event.flags() & kModifiers) == 0 &&
+        event.key_code() == ui::VKEY_RETURN) {
+      // (Submit() ignores it while one is checked, or the helper asks to
+      // wait. The field stays editable: making a focused textfield read-only
+      // trips its cursor blink timer.)
+      if (!sender->GetText().empty()) {
+        lock_->Submit(std::u16string(sender->GetText()));
+      }
+      return true;
+    }
+    if ((event.flags() & kModifiers) == 0 &&
+        event.key_code() == ui::VKEY_ESCAPE) {
+      sender->SetText(u"");
+      return true;
+    }
+    return false;
+  }
+
+ private:
+  raw_ptr<PlutoniumLockImpl> lock_;
+  raw_ptr<views::Label> clock_ = nullptr;
+  raw_ptr<views::Label> date_ = nullptr;
+  raw_ptr<views::Label> user_ = nullptr;
+  raw_ptr<views::Textfield> password_ = nullptr;
+  raw_ptr<views::Label> message_ = nullptr;
+};
+
+BEGIN_METADATA(PlutoniumLockView)
+END_METADATA
+
+PlutoniumLockImpl::PlutoniumLockImpl() {
+  ash::Shell::Get()->AddPreTargetHandler(this,
+                                         ui::EventTarget::Priority::kSystem);
+  ash::Shell::Get()->activation_client()->AddObserver(this);
+  display::Screen::Get()->AddObserver(this);
+  if (ui::UserActivityDetector* detector = ui::UserActivityDetector::Get()) {
+    detector->AddObserver(this);
+  }
+}
+
+PlutoniumLockImpl::~PlutoniumLockImpl() {
+  if (ui::UserActivityDetector* detector = ui::UserActivityDetector::Get()) {
+    detector->RemoveObserver(this);
+  }
+  display::Screen::Get()->RemoveObserver(this);
+  if (ash::Shell::HasInstance()) {
+    ash::Shell::Get()->activation_client()->RemoveObserver(this);
+    ash::Shell::Get()->RemovePreTargetHandler(this);
+  }
+  view_ = nullptr;
+  widgets_.clear();
+}
+
+bool PlutoniumLockImpl::IsLocked() const {
+  return locked_;
+}
+
+void PlutoniumLockImpl::Lock(const std::u16string& user,
+                             const std::u16string& message) {
+  if (!user.empty()) {
+    user_ = user;
+  }
+  message_ = message;
+  message_error_ = false;
+  if (locked_) {
+    if (view_) {
+      view_->SetUser(user_);
+      view_->SetMessage(message_, false);
+    }
+    return;
+  }
+  locked_ = true;
+  LOG(WARNING) << "EXO-LOCK locked";
+  previously_active_.RemoveAll();
+  if (aura::Window* active = ash::window_util::GetActiveWindow()) {
+    previously_active_.Add(active);
+  }
+  // Nothing keeps the pointer: a drag, a grab, an app's pointer lock.
+  if (aura::Window* capture = ash::window_util::GetCaptureWindow()) {
+    capture->ReleaseCapture();
+  }
+  exo::Pointer::UnconstrainAllByUserAction();
+  BuildWidgets();
+  clock_.Start(FROM_HERE, base::Seconds(1),
+               base::BindRepeating(&PlutoniumLockImpl::Tick,
+                                   base::Unretained(this)));
+  NotifyLockChanged(true);
+}
+
+base::TimeDelta PlutoniumLockImpl::GetIdleTime() const {
+  ui::UserActivityDetector* detector = ui::UserActivityDetector::Get();
+  base::TimeTicks last = detector ? detector->last_activity_time()
+                                  : base::TimeTicks();
+  return base::TimeTicks::Now() - std::max(last, started_);
+}
+
+bool PlutoniumLockImpl::SetDisplaysOff(bool off) {
+  // On X11 the displays are the host's.
+  if (!IsDrm()) {
+    return false;
+  }
+  if (off != displays_off_) {
+    displays_off_ = off;
+    LOG(WARNING) << "EXO-LOCK displays " << (off ? "off" : "on");
+    // The pointer events of the reconfiguration aren't the user's.
+    ui::UserActivityDetector::Get()->OnDisplayPowerChanging();
+    ash::Shell::Get()->display_configurator()->SetDisplayPower(
+        off ? chromeos::DISPLAY_POWER_ALL_OFF : chromeos::DISPLAY_POWER_ALL_ON,
+        display::DisplayConfigurator::kSetDisplayPowerNoFlags,
+        base::DoNothing());
+  }
+  return true;
+}
+
+bool PlutoniumLockImpl::AreDisplaysOff() const {
+  return displays_off_;
+}
+
+std::vector<std::string> PlutoniumLockImpl::GetWakeLocks() const {
+  if (!chromeos::PowerPolicyController::IsInitialized()) {
+    return {};
+  }
+  return chromeos::PowerPolicyController::Get()
+      ->GetScreenWakeLockDescriptions();
+}
+
+void PlutoniumLockImpl::Submit(const std::u16string& password) {
+  if (checking_ || base::TimeTicks::Now() < retry_at_) {
+    return;
+  }
+  if (!plutonium_helper::IsAvailable()) {
+    view_->SetMessage(u"There's no helper to check the password.", true);
+    return;
+  }
+  checking_ = true;
+  view_->SetMessage(u"Checking…", false);
+  plutonium_helper::Post(
+      "/v1/session/unlock",
+      base::DictValue().Set("password", base::UTF16ToUTF8(password)),
+      base::BindOnce(&PlutoniumLockImpl::OnUnlockAnswer,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PlutoniumLockImpl::OnUnlockAnswer(std::optional<base::Value> value,
+                                       const std::string& error) {
+  checking_ = false;
+  if (!locked_ || !view_) {
+    return;
+  }
+  const base::DictValue* answer = value ? value->GetIfDict() : nullptr;
+  if (answer && answer->FindBool("ok").value_or(false)) {
+    Unlock();
+    return;
+  }
+  view_->ClearPassword();
+  view_->FocusPassword();
+  if (!answer) {
+    view_->SetMessage(
+        base::StrCat({u"Couldn't check the password: ",
+                      base::UTF8ToUTF16(error)}),
+        true);
+    return;
+  }
+  const std::string* reason = answer->FindString("error");
+  message_ = base::UTF8ToUTF16(reason ? *reason : "That's not the password.");
+  message_error_ = true;
+  const int wait = answer->FindInt("retryAfter").value_or(0);
+  retry_at_ = base::TimeTicks::Now() + base::Seconds(wait);
+  Tick();
+}
+
+void PlutoniumLockImpl::Unlock() {
+  locked_ = false;
+  LOG(WARNING) << "EXO-LOCK unlocked";
+  clock_.Stop();
+  retry_at_ = base::TimeTicks();
+  message_.clear();
+  CloseWidgets();
+  if (aura::Window* window = previously_active_.Pop()) {
+    wm::ActivateWindow(window);
+  }
+  NotifyLockChanged(false);
+}
+
+void PlutoniumLockImpl::Tick() {
+  if (!locked_) {
+    return;
+  }
+  const base::Time now = base::Time::Now();
+  for (const auto& widget : widgets_) {
+    static_cast<PlutoniumLockView*>(widget->GetContentsView())->SetTime(now);
+  }
+  if (!view_ || checking_) {
+    return;
+  }
+  const base::TimeDelta wait = retry_at_ - base::TimeTicks::Now();
+  if (wait.is_positive()) {
+    view_->SetMessage(
+        base::StrCat({message_, u" Try again in ",
+                      base::NumberToString16((wait.InMilliseconds() + 999) / 1000), u" s."}),
+        true);
+  } else {
+    view_->SetMessage(message_, message_error_);
+  }
+}
+
+void PlutoniumLockImpl::BuildWidgets() {
+  CloseWidgets();
+  aura::Window* primary = ash::Shell::GetPrimaryRootWindow();
+  for (aura::Window* root : ash::Shell::GetAllRootWindows()) {
+    const bool is_primary = root == primary;
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.name = "PlutoniumLock";
+    params.parent =
+        ash::Shell::GetContainer(root, ash::kShellWindowId_OverlayContainer);
+    params.bounds =
+        display::Screen::Get()->GetDisplayNearestWindow(root).bounds();
+    params.opacity = views::Widget::InitParams::WindowOpacity::kOpaque;
+    params.activatable = is_primary
+                             ? views::Widget::InitParams::Activatable::kYes
+                             : views::Widget::InitParams::Activatable::kNo;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    auto widget = std::make_unique<views::Widget>(std::move(params));
+    widget->SetColorModeOverride(ui::ColorProviderKey::ColorMode::kDark);
+    auto* view = widget->SetContentsView(
+        std::make_unique<PlutoniumLockView>(this, is_primary));
+    view->SetTime(base::Time::Now());
+    widget->Show();
+    widget->StackAtTop();
+    if (is_primary) {
+      view_ = view;
+      view_->SetUser(user_);
+      view_->SetMessage(message_, message_error_);
+      widget->Activate();
+      view_->FocusPassword();
+    }
+    widgets_.push_back(std::move(widget));
+  }
+}
+
+void PlutoniumLockImpl::CloseWidgets() {
+  view_ = nullptr;
+  for (auto& widget : widgets_) {
+    widget->Hide();
+    // Not from inside one of the widget's own calls (the Enter key).
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(widget));
+  }
+  widgets_.clear();
+}
+
+void PlutoniumLockImpl::RebuildSoon() {
+  if (!locked_) {
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<PlutoniumLockImpl> lock) {
+                       if (lock && lock->locked_ && !lock->checking_) {
+                         lock->BuildWidgets();
+                       }
+                     },
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+bool PlutoniumLockImpl::IsLockWindow(const aura::Window* window) const {
+  for (const auto& widget : widgets_) {
+    if (widget->GetNativeWindow()->Contains(window)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool PlutoniumLockImpl::HandleLockKey(const ui::KeyEvent& event) {
+  if (event.key_code() != ui::VKEY_L) {
+    return false;
+  }
+  if (event.type() != ui::EventType::kKeyPressed) {
+    const bool was_down = lock_key_down_;
+    lock_key_down_ = false;
+    return was_down;
+  }
+  if ((event.flags() & kModifiers) != ui::EF_COMMAND_DOWN) {
+    return false;
+  }
+  lock_key_down_ = true;
+  if (!locked_ && !event.is_repeat() && plutonium_helper::IsAvailable()) {
+    // The helper locks, through the DevTools domain, if it can check a
+    // password.
+    plutonium_helper::Post(
+        "/v1/session/lock", base::DictValue(),
+        base::BindOnce([](std::optional<base::Value> value,
+                          const std::string& error) {
+          if (!value) {
+            LOG(ERROR) << "EXO-LOCK Super+L: " << error;
+          }
+        }));
+  }
+  return true;
+}
+
+void PlutoniumLockImpl::OnEvent(ui::Event* event) {
+  if (event->IsKeyEvent() && HandleLockKey(*event->AsKeyEvent())) {
+    event->StopPropagation();
+    return;
+  }
+  if (!locked_ || !event->cancelable()) {
+    return;
+  }
+  const auto* target = static_cast<const aura::Window*>(event->target());
+  if (target && IsLockWindow(target)) {
+    return;
+  }
+  event->StopPropagation();
+}
+
+void PlutoniumLockImpl::OnWindowActivated(ActivationReason reason,
+                                          aura::Window* gained_active,
+                                          aura::Window* lost_active) {
+  if (!locked_ || (gained_active && IsLockWindow(gained_active))) {
+    return;
+  }
+  // Something else came up (a window opening, a shell shown): the lock
+  // stays in front, with the keyboard.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<PlutoniumLockImpl> lock) {
+                       if (!lock || !lock->locked_) {
+                         return;
+                       }
+                       for (const auto& widget : lock->widgets_) {
+                         widget->StackAtTop();
+                       }
+                       if (lock->view_) {
+                         lock->view_->GetWidget()->Activate();
+                         lock->view_->FocusPassword();
+                       }
+                     },
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void PlutoniumLockImpl::OnDisplayAdded(const display::Display& new_display) {
+  RebuildSoon();
+}
+
+void PlutoniumLockImpl::OnDisplaysRemoved(
+    const display::Displays& removed_displays) {
+  RebuildSoon();
+}
+
+void PlutoniumLockImpl::OnDisplayMetricsChanged(const display::Display& display,
+                                                uint32_t changed_metrics) {
+  if (!locked_) {
+    return;
+  }
+  for (const auto& widget : widgets_) {
+    aura::Window* root = widget->GetNativeWindow()->GetRootWindow();
+    if (display::Screen::Get()->GetDisplayNearestWindow(root).id() ==
+        display.id()) {
+      widget->SetBounds(display.bounds());
+    }
+  }
+}
+
+void PlutoniumLockImpl::OnUserActivity(const ui::Event* event) {
+  if (displays_off_) {
+    SetDisplaysOff(false);
+  }
+}
