+ScriptPromise<IDLSequence<NativeDisplayEntry>> NativeWindowBroker::getDisplays(
+    ScriptState* script_state) {
+  auto* resolver = MakeGarbageCollected<
+      ScriptPromiseResolver<IDLSequence<NativeDisplayEntry>>>(script_state);
+  auto promise = resolver->Promise();
+  if (!EnsureBound(resolver)) {
+    return promise;
+  }
+  remote_->GetDisplays(BindOnce(
+      [](NativeWindowBroker* self,
+         ScriptPromiseResolver<IDLSequence<NativeDisplayEntry>>* resolver,
+         Vector<mojom::blink::NativeDisplayEntryPtr> displays) {
+        self->pending_.erase(resolver);
+        HeapVector<Member<NativeDisplayEntry>> result;
+        for (const auto& display : displays) {
+          result.push_back(ToEntry(*display));
+        }
+        resolver->Resolve(result);
+      },
+      WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+base::OnceCallback<void(bool)> NativeWindowBroker::ResolveBoolean(
+    ScriptPromiseResolver<IDLBoolean>* resolver) {
+  return BindOnce(
+      [](NativeWindowBroker* self, ScriptPromiseResolver<IDLBoolean>* resolver,
+         bool ok) {
+        self->pending_.erase(resolver);
+        resolver->Resolve(ok);
+      },
+      WrapPersistent(this), WrapPersistent(resolver));
+}
