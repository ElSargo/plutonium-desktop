+bool PlutoniumShellsImpl::OpenWindow(Profile* profile,
+                                     const Entry& entry,
+                                     int64_t display_id) {
+  opening_id_ = entry.shell.id;
+  opening_display_ = display_id;
+  {
+    // EXO-DISPLAYS: on that display; the pages there know which it is,
+    // except on the startup display (as before there were several).
+    display::ScopedDisplayForNewWindows scoped_display(display_id);
+    OpenAppShortcutWindow(profile, display_id == startup_display_
+                                       ? entry.shell.url
+                                       : WithDisplay(entry.shell.url,
+                                                     display_id));
+  }
+  opening_id_.clear();
+  opening_display_ = display::kInvalidDisplayId;
+  Entry* opened = Find(entry.shell.id);
+  if (!opened || !opened->browsers.contains(display_id)) {
+    LOG(ERROR) << "EXO-SHELLS could not open shell " << entry.shell.id
+               << " on display " << display_id;
+    return false;
+  }
+  BrowserWindowInterface* browser = opened->browsers[display_id];
+  LOG(WARNING) << "EXO-SHELLS opened shell " << entry.shell.id << " \""
+               << entry.shell.name << "\" on display " << display_id;
+  // An app window opens where it last was (its saved bounds), whatever the
+  // display for new windows: put it on its display before it goes
+  // fullscreen there.
+  display::Display display;
+  aura::Window* window = browser->GetWindow()->GetNativeWindow();
+  if (window &&
+      display::Screen::Get()->GetDisplayWithDisplayId(display_id, &display) &&
+      display::Screen::Get()->GetDisplayNearestWindow(window).id() !=
+          display_id) {
+    window->SetBoundsInScreen(display.work_area(), display);
+  }
+  chrome::ToggleFullscreenMode(browser, /*user_initiated=*/false);
+  if (GetVisibleContentsOn(display_id)) {
+    browser->GetWindow()->Hide();
+  } else {
+    // Nothing was visible there (a new display, or the startup shell's
+    // window is gone).
+    visible_[display_id] = opened->shell.id;
+    NotifyVisibleShellChanged(nullptr, ContentsOf(browser));
+  }
+  return true;
+}
