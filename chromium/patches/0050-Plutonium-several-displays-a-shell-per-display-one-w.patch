+
+std::vector<PlutoniumShells::Display> PlutoniumShellsImpl::GetDisplays()
+    const {
+  std::vector<Display> result;
+  if (!display::Screen::Get()) {
+    return result;
+  }
+  const int64_t primary = display::Screen::Get()->GetPrimaryDisplay().id();
+  const int64_t focused = GetFocusedDisplayId();
+  display::DisplayManager* manager =
+      ash::Shell::HasInstance() ? ash::Shell::Get()->display_manager()
+                                : nullptr;
+  for (const display::Display& display : SortedDisplays()) {
+    Display entry;
+    entry.id = display.id();
+    entry.index = static_cast<int>(result.size()) + 1;
+    entry.label = !display.label().empty() ? display.label()
+                  : manager ? manager->GetDisplayNameForId(display.id())
+                            : std::string();
+    entry.bounds = display.bounds();
+    entry.work_area = display.work_area();
+    entry.scale_factor = display.device_scale_factor();
+    entry.rotation = display.RotationAsDegree();
+    entry.primary = display.id() == primary;
+    entry.internal = display.IsInternal();
+    entry.focused = display.id() == focused;
+    result.push_back(std::move(entry));
+  }
+  return result;
+}
