# Prebuilt Plutonium: the release build of Plutonium's Chromium (Ash + Exo) and
# what it needs to run, without the checkout or build tools. The CLI uses it
# in place of the build image when PREBUILT=1 (plutonium image pull).
#
# Built by `plutonium image build` from a staged copy of out/Release
# (build context: the staging dir, with this file copied in).
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      # Linked by chrome (ldd of the build)
      libasound2t64 libbsd0 libcap2 libdbus-1-3 libdrm2 libevdev2 libexpat1 libffi8 \
      libgbm1 libgcrypt20 libglib2.0-0t64 libgudev-1.0-0 libinput10 liblz4-1 \
      libmtdev1t64 libnspr4 libnss3 libsystemd0 libudev1 libwacom9 libx11-6 libxcb1 \
      libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
      libxrender1 libxtst6 libzstd1 \
      # Loaded at run time: GL/Vulkan (Mesa), VA-API, PCI ids, audio, printing
      libegl1 libgles2 libgl1-mesa-dri mesa-vulkan-drivers mesa-va-drivers libva2 \
      libva-drm2 libpci3 libpulse0 libcups2t64 \
      # speechSynthesis through the host's speech-dispatcher (dlopen()ed)
      libspeechd2 \
      # Screen capture: Ash's PipeWire video nodes (docs/features/CAPTURE.md)
      libpipewire-0.3-0t64 libpipewire-0.3-modules libspa-0.2-modules \
      # Keyboard layouts (evdev input on DRM), fonts, certificates, locale
      xkb-data fontconfig fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji \
      ca-certificates locales tzdata \
      # X11 sessions, the CLI (pkill/pgrep) and tools/cdp.py
      xvfb xauth x11-utils imagemagick procps python3 python3-websockets \
 && rm -rf /var/lib/apt/lists/*

COPY chrome/ /opt/plutonium/chrome/
CMD ["sleep", "infinity"]
