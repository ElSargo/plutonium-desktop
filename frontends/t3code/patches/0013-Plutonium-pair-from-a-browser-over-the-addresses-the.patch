diff --git a/apps/web/src/plutonium/directEndpoints.ts b/apps/web/src/plutonium/directEndpoints.ts
new file mode 100644
index 0000000000..ae69c8fc68
--- /dev/null
+++ b/apps/web/src/plutonium/directEndpoints.ts
@@ -0,0 +1,56 @@
+/**
+ * Pairing endpoints for a browser client, from the addresses the server
+ * reports (ServerConfig.directEndpoints).
+ *
+ * T3's pairing QR only lists the desktop app's own endpoints, so a browser on
+ * loopback (the Plutonium shell) had nothing to put in it. The server lists
+ * its LAN and tailnet addresses, and its Tailscale Serve name once that answers,
+ * which is what another device can dial.
+ */
+import type { AdvertisedEndpoint, ServerDirectEndpoint } from "@t3tools/contracts";
+import { createAdvertisedEndpoint } from "@t3tools/shared/advertisedEndpoint";
+
+const SERVER_ENDPOINT_PROVIDER = {
+  id: "server",
+  label: "Server",
+  kind: "private-network",
+  isAddon: false,
+} as const;
+
+const TAILSCALE_ENDPOINT_PROVIDER = {
+  id: "tailscale",
+  label: "Tailscale",
+  kind: "private-network",
+  isAddon: true,
+} as const;
+
+export function serverDirectAdvertisedEndpoints(
+  directEndpoints: ReadonlyArray<ServerDirectEndpoint> | undefined,
+): ReadonlyArray<AdvertisedEndpoint> {
+  return (directEndpoints ?? []).map((endpoint) => {
+    const https = endpoint.httpBaseUrl.startsWith("https:");
+    if (endpoint.kind === "tailnet" && https) {
+      // The id prefix is the one T3 gives the desktop app's Tailscale Serve
+      // endpoint, so the page shows it as it does there.
+      return createAdvertisedEndpoint({
+        provider: TAILSCALE_ENDPOINT_PROVIDER,
+        source: "server",
+        id: `tailscale-magicdns:${endpoint.httpBaseUrl}`,
+        label: "Tailscale HTTPS",
+        httpBaseUrl: endpoint.httpBaseUrl,
+        reachability: "private-network",
+        hostedHttpsCompatibility: "compatible",
+        description: "HTTPS endpoint served by Tailscale Serve.",
+      });
+    }
+    return createAdvertisedEndpoint({
+      provider:
+        endpoint.kind === "tailnet" ? TAILSCALE_ENDPOINT_PROVIDER : SERVER_ENDPOINT_PROVIDER,
+      source: "server",
+      id: `server-${endpoint.kind}:${endpoint.httpBaseUrl}`,
+      label: endpoint.kind === "tailnet" ? "Tailscale IP" : "Local network",
+      httpBaseUrl: endpoint.httpBaseUrl,
+      reachability: endpoint.kind === "tailnet" ? "private-network" : "lan",
+    });
+  });
+}
