+// Plutonium: the launcher offers the shell a one-time pairing token as
+// #plutoniumPair=<token> on every start. It becomes T3's own #token= only when
+// this browser isn't paired yet, or its session lacks some of the scopes the
+// token brings (each pairing is another session in Settings, Connections). The
+// shell's token has the desktop app's scopes, including pairing other devices.
+import { AuthAdministrativeScopes } from "@t3tools/contracts";
+
+export async function offerPlutoniumPairing(): Promise<void> {
+  const url = new URL(window.location.href);
+  const params = new URLSearchParams(url.hash.slice(1));
+  const token = params.get("plutoniumPair");
+  if (!token) return;
+  params.delete("plutoniumPair");
+  let paired = false;
+  try {
+    const response = await fetch("/api/auth/session", { credentials: "include" });
+    const session = response.ok
+      ? ((await response.json()) as {
+          authenticated?: boolean;
+          scopes?: readonly string[];
+          permissions?: readonly string[];
+        })
+      : null;
+    // `permissions` is the whole grant; `scopes` only what older clients know.
+    const granted = session?.permissions ?? session?.scopes ?? [];
+    paired =
+      session?.authenticated === true &&
+      AuthAdministrativeScopes.every((scope) => granted.includes(scope));
+  } catch {
+    // Unknown: pair, as T3 would with the token.
+  }
+  if (!paired) params.set("token", token);
+  url.hash = params.toString();
+  window.history.replaceState(window.history.state, "", url);
+}
