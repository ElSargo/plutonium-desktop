diff --git a/apps/server/src/preview/recordingDuration.test.ts b/apps/server/src/preview/recordingDuration.test.ts
new file mode 100644
index 0000000000..4de985f82b
--- /dev/null
+++ b/apps/server/src/preview/recordingDuration.test.ts
@@ -0,0 +1,100 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { withRecordingDuration } from "./recordingDuration.ts";
+
+const element = (id: number[], body: Buffer, unknownSize = false) =>
+  Buffer.concat([
+    Buffer.from(id),
+    unknownSize
+      ? Buffer.from([0x01, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff])
+      : Buffer.from([0x80 | body.length]),
+    body,
+  ]);
+
+/** What MediaRecorder writes: a live Segment, an Info without a Duration, then clusters. */
+const webm = () =>
+  Buffer.concat([
+    element([0x1a, 0x45, 0xdf, 0xa3], element([0x42, 0x82], Buffer.from("webm"))),
+    element(
+      [0x18, 0x53, 0x80, 0x67],
+      Buffer.concat([
+        element(
+          [0x15, 0x49, 0xa9, 0x66],
+          Buffer.concat([
+            element([0x2a, 0xd7, 0xb1], Buffer.from([0x0f, 0x42, 0x40])),
+            element([0x4d, 0x80], Buffer.from("Chrome")),
+          ]),
+        ),
+        element([0x1f, 0x43, 0xb6, 0x75], Buffer.from([0xe7, 0x81, 0x00])),
+      ]),
+      true,
+    ),
+  ]);
+
+const box = (type: string, body: Buffer) => {
+  const header = Buffer.alloc(8);
+  header.writeUInt32BE(8 + body.length, 0);
+  header.write(type, 4, "latin1");
+  return Buffer.concat([header, body]);
+};
+
+/** A fragmented MP4's moov: every duration 0. */
+const mp4 = () => {
+  const mvhd = Buffer.alloc(100);
+  mvhd.writeUInt32BE(1000, 12);
+  const tkhd = Buffer.alloc(84);
+  const mdhd = Buffer.alloc(24);
+  mdhd.writeUInt32BE(90000, 12);
+  return Buffer.concat([
+    box("ftyp", Buffer.from("isom")),
+    box(
+      "moov",
+      Buffer.concat([
+        box("mvhd", mvhd),
+        box("trak", Buffer.concat([box("tkhd", tkhd), box("mdia", box("mdhd", mdhd))])),
+        box("mvex", box("mehd", Buffer.alloc(8))),
+      ]),
+    ),
+    box("moof", Buffer.alloc(8)),
+  ]);
+};
+
+describe("withRecordingDuration", () => {
+  it("adds a Duration to a WebM's Info", () => {
+    const original = webm();
+    const result = withRecordingDuration(original, "video/webm;codecs=vp9", 2500);
+    expect(result.length).toBe(original.length + 11);
+    const at = result.indexOf(Buffer.from([0x44, 0x89, 0x88]));
+    expect(at).toBeGreaterThan(0);
+    // In ticks of the timecode scale (1 ms here).
+    expect(result.readDoubleBE(at + 3)).toBe(2500);
+    // The Info's size grew by the element; the cluster follows it.
+    const info = result.indexOf(Buffer.from([0x15, 0x49, 0xa9, 0x66]));
+    expect(result[info + 4]! & 0x7f).toBe(original[info + 4]! - 0x80 + 11);
+    expect(result.indexOf(Buffer.from([0x1f, 0x43, 0xb6, 0x75]))).toBe(
+      info + 5 + (result[info + 4]! & 0x7f),
+    );
+  });
+
+  it("leaves a WebM that has a Duration, or isn't one, as it is", () => {
+    const once = withRecordingDuration(webm(), "video/webm", 2500);
+    expect(withRecordingDuration(once, "video/webm", 4000)).toEqual(once);
+    const junk = Buffer.from("not a video");
+    expect(withRecordingDuration(junk, "video/webm", 1000)).toEqual(junk);
+  });
+
+  it("sets an MP4's movie, track, media and fragment durations", () => {
+    const original = mp4();
+    const result = withRecordingDuration(original, "video/mp4;codecs=avc1.640033", 2500);
+    expect(result.length).toBe(original.length);
+    const mvhd = result.indexOf("mvhd", 0, "latin1") + 4;
+    expect(result.readUInt32BE(mvhd + 16)).toBe(2500);
+    const tkhd = result.indexOf("tkhd", 0, "latin1") + 4;
+    expect(result.readUInt32BE(tkhd + 20)).toBe(2500);
+    const mdhd = result.indexOf("mdhd", 0, "latin1") + 4;
+    expect(result.readUInt32BE(mdhd + 16)).toBe(225000);
+    const mehd = result.indexOf("mehd", 0, "latin1") + 4;
+    expect(result.readUInt32BE(mehd + 4)).toBe(2500);
+    expect(original.readUInt32BE(mvhd + 16)).toBe(0);
+  });
+});
diff --git a/apps/server/src/preview/recordingDuration.ts b/apps/server/src/preview/recordingDuration.ts
new file mode 100644
index 0000000000..b59dd7c2a5
--- /dev/null
+++ b/apps/server/src/preview/recordingDuration.ts
@@ -0,0 +1,209 @@
+/**
+ * Plutonium: a recording's length, written into its header. MediaRecorder
+ * streams its file as it goes, so it never knows the length: a WebM has no
+ * Duration in its Info, an MP4 a duration of 0, and players can't show or
+ * seek well. Without ffmpeg (NixOS has none on the server's PATH), the
+ * length is written in place.
+ */
+
+// EBML element ids (Matroska).
+const SEGMENT = 0x18538067;
+const INFO = 0x1549a966;
+const TIMECODE_SCALE = 0x2ad7b1;
+const DURATION = 0x4489;
+const CLUSTER = 0x1f43b675;
+
+interface Element {
+  readonly id: number;
+  /** Where the element starts, its size field starts, and its data starts. */
+  readonly start: number;
+  readonly sizeAt: number;
+  readonly dataAt: number;
+  /** The size field's length in bytes. */
+  readonly sizeLength: number;
+  /** The data's size, or null for "unknown" (a live stream's Segment). */
+  readonly size: number | null;
+}
+
+const readElement = (data: Buffer, at: number): Element | null => {
+  if (at >= data.length) return null;
+  const first = data[at]!;
+  const idLength = Math.clz32(first) - 23;
+  if (idLength < 1 || idLength > 4 || at + idLength >= data.length) return null;
+  const id = data.readUIntBE(at, idLength);
+  const sizeAt = at + idLength;
+  const sizeFirst = data[sizeAt]!;
+  const sizeLength = Math.clz32(sizeFirst) - 23;
+  if (sizeLength < 1 || sizeLength > 8 || sizeAt + sizeLength > data.length) return null;
+  let size = sizeFirst & (0xff >> sizeLength);
+  let unknown = size === 0xff >> sizeLength;
+  for (let index = 1; index < sizeLength; index += 1) {
+    const byte = data[sizeAt + index]!;
+    if (byte !== 0xff) unknown = false;
+    size = size * 256 + byte;
+  }
+  return {
+    id,
+    start: at,
+    sizeAt,
+    dataAt: sizeAt + sizeLength,
+    sizeLength,
+    size: unknown ? null : size,
+  };
+};
+
+/** `size` as a size field `length` bytes long, or null if it doesn't fit. */
+const encodeSize = (size: number, length: number): Buffer | null => {
+  if (size >= 2 ** (7 * length) - 1) return null;
+  const field = Buffer.alloc(length);
+  let rest = size;
+  for (let index = length - 1; index >= 0; index -= 1) {
+    field[index] = rest % 256;
+    rest = Math.floor(rest / 256);
+  }
+  field[0]! |= 0x80 >> (length - 1);
+  return field;
+};
+
+const withWebmDuration = (data: Buffer, durationMs: number): Buffer => {
+  const segment = findTopLevel(data, SEGMENT);
+  if (!segment) return data;
+  const segmentEnd = segment.size === null ? data.length : segment.dataAt + segment.size;
+  let info: Element | null = null;
+  for (let at = segment.dataAt; at < segmentEnd;) {
+    const element = readElement(data, at);
+    if (!element || element.size === null) return data;
+    if (element.id === INFO) {
+      info = element;
+      break;
+    }
+    if (element.id === CLUSTER) return data;
+    at = element.dataAt + element.size;
+  }
+  if (!info || info.size === null) return data;
+  // Durations count in the timecode scale (ns per tick, 1 ms by default).
+  let scale = 1_000_000;
+  const infoEnd = info.dataAt + info.size;
+  for (let at = info.dataAt; at < infoEnd;) {
+    const element = readElement(data, at);
+    if (!element || element.size === null) return data;
+    if (element.id === DURATION) return data;
+    if (element.id === TIMECODE_SCALE && element.size <= 6) {
+      scale = data.readUIntBE(element.dataAt, element.size) || scale;
+    }
+    at = element.dataAt + element.size;
+  }
+  const duration = Buffer.alloc(11);
+  duration.writeUInt16BE(DURATION, 0);
+  duration[2] = 0x88;
+  duration.writeDoubleBE((durationMs * 1_000_000) / scale, 3);
+  const infoSize = encodeSize(info.size + duration.length, info.sizeLength);
+  if (!infoSize) return data;
+  let segmentSize: Buffer | null = null;
+  if (segment.size !== null) {
+    segmentSize = encodeSize(segment.size + duration.length, segment.sizeLength);
+    if (!segmentSize) return data;
+  }
+  const result = Buffer.concat([data.subarray(0, infoEnd), duration, data.subarray(infoEnd)]);
+  infoSize.copy(result, info.sizeAt);
+  segmentSize?.copy(result, segment.sizeAt);
+  return result;
+};
+
+const findTopLevel = (data: Buffer, id: number): Element | null => {
+  for (let at = 0; at < data.length;) {
+    const element = readElement(data, at);
+    if (!element) return null;
+    if (element.id === id) return element;
+    if (element.size === null) return null;
+    at = element.dataAt + element.size;
+  }
+  return null;
+};
+
+/** MP4 boxes in [start, end): type, where it starts, its header's end, its end. */
+const boxes = (data: Buffer, start: number, end: number) => {
+  const found: Array<{ type: string; start: number; body: number; end: number }> = [];
+  for (let at = start; at + 8 <= end;) {
+    let size = data.readUInt32BE(at);
+    let body = at + 8;
+    if (size === 1) {
+      if (at + 16 > end) break;
+      size = Number(data.readBigUInt64BE(at + 8));
+      body = at + 16;
+    } else if (size === 0) {
+      size = end - at;
+    }
+    if (size < body - at || at + size > end) break;
+    found.push({ type: data.toString("latin1", at + 4, at + 8), start: at, body, end: at + size });
+    at += size;
+  }
+  return found;
+};
+
+/**
+ * Sets a full box's duration (mvhd, tkhd, mdhd) where it is 0, in its own
+ * timescale or, for tkhd, the movie's. Returns the box's timescale, if it has one.
+ */
+const setBoxDuration = (
+  data: Buffer,
+  box: { type: string; body: number; end: number },
+  durationMs: number,
+  movieTimescale: number,
+): number | undefined => {
+  const version = data[box.body]!;
+  // After version and flags: creation and modification times, then (except
+  // tkhd) the timescale, then (tkhd) the track id and a reserved field.
+  const times = version === 1 ? 16 : 8;
+  const timescaleAt = box.body + 4 + times;
+  const timescale = box.type === "tkhd" ? movieTimescale : data.readUInt32BE(timescaleAt);
+  const durationAt = box.type === "tkhd" ? timescaleAt + 8 : timescaleAt + 4;
+  if (durationAt + (version === 1 ? 8 : 4) > box.end || !timescale) return undefined;
+  const duration = Math.round((durationMs * timescale) / 1000);
+  if (version === 1) {
+    if (data.readBigUInt64BE(durationAt) === 0n)
+      data.writeBigUInt64BE(BigInt(duration), durationAt);
+  } else if (data.readUInt32BE(durationAt) === 0 && duration < 2 ** 32) {
+    data.writeUInt32BE(duration, durationAt);
+  }
+  return box.type === "tkhd" ? undefined : timescale;
+};
+
+const withMp4Duration = (data: Buffer, durationMs: number): Buffer => {
+  const moov = boxes(data, 0, data.length).find((box) => box.type === "moov");
+  if (!moov) return data;
+  const result = Buffer.from(data);
+  const children = boxes(result, moov.body, moov.end);
+  const mvhd = children.find((box) => box.type === "mvhd");
+  if (!mvhd) return data;
+  const movieTimescale = setBoxDuration(result, mvhd, durationMs, 0) ?? 0;
+  for (const trak of children.filter((box) => box.type === "trak")) {
+    for (const box of boxes(result, trak.body, trak.end)) {
+      if (box.type === "tkhd") setBoxDuration(result, box, durationMs, movieTimescale);
+      if (box.type === "mdia") {
+        const mdhd = boxes(result, box.body, box.end).find((child) => child.type === "mdhd");
+        if (mdhd) setBoxDuration(result, mdhd, durationMs, movieTimescale);
+      }
+    }
+  }
+  const mvex = children.find((box) => box.type === "mvex");
+  const mehd = mvex && boxes(result, mvex.body, mvex.end).find((box) => box.type === "mehd");
+  if (mehd && movieTimescale) {
+    const duration = Math.round((durationMs * movieTimescale) / 1000);
+    if (result[mehd.body] === 1) result.writeBigUInt64BE(BigInt(duration), mehd.body + 4);
+    else if (duration < 2 ** 32) result.writeUInt32BE(duration, mehd.body + 4);
+  }
+  return result;
+};
+
+/** The recording with its length in its header; as it was if it can't tell where. */
+export const withRecordingDuration = (data: Buffer, mimeType: string, durationMs: number) => {
+  if (!(durationMs > 0)) return data;
+  try {
+    return mimeType.startsWith("video/mp4")
+      ? withMp4Duration(data, durationMs)
+      : withWebmDuration(data, durationMs);
+  } catch {
+    return data;
+  }
+};
