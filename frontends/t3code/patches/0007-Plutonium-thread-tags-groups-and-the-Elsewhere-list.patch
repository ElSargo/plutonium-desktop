@@ -0,0 +1,16 @@
+// Plutonium tags for T3 threads. A thread's tag is what its processes carry
+// as PLUTONIUM_THREAD_ID (the server sets it, apps/server/src/plutonium.ts)
+// and what the windows and tabs it opens are tagged with. Namespaced, so
+// other shells' threads can't collide with it.
+
+const THREAD_TAG_PREFIX = "t3:thread/";
+
+/** A T3 thread's Plutonium tag. */
+export function threadTag(threadId: string): string {
+  return `${THREAD_TAG_PREFIX}${threadId}`;
+}
+
+/** The T3 thread a tag names, or null. */
+export function threadIdOfTag(tag: string | null | undefined): string | null {
+  return tag?.startsWith(THREAD_TAG_PREFIX) ? tag.slice(THREAD_TAG_PREFIX.length) : null;
+}
