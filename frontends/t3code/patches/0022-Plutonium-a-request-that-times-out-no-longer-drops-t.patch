From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sarol263@student.otago.ac.nz>
Date: Sat, 24 Oct 2026 14:30:14 +1300
Subject: [PATCH 22/44] Plutonium: a request that times out no longer drops the
 server's own browser host; recording starts get the install allowance

The server's host is in-process and can't become unreachable, so one slow
request (a first recording start downloading chrome-headless-shell) fails alone
instead of failing the agent's parallel calls with "No preview automation host".
A recording start may install the shell like open, so it gets open's allowance.
preview_open says visible covers the floating preview too.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/mcp/PreviewAutomationBroker.test.ts   | 53 +++++++++++++++++++
 .../server/src/mcp/PreviewAutomationBroker.ts | 14 +++--
 apps/server/src/mcp/toolkits/preview/tools.ts |  2 +-
 3 files changed, 64 insertions(+), 5 deletions(-)

diff --git a/apps/server/src/mcp/PreviewAutomationBroker.test.ts b/apps/server/src/mcp/PreviewAutomationBroker.test.ts
index 72d5d4b044..22a4c1153c 100644
--- a/apps/server/src/mcp/PreviewAutomationBroker.test.ts
+++ b/apps/server/src/mcp/PreviewAutomationBroker.test.ts
@@ -364,6 +364,59 @@ it.effect(
     ),
 );
 
+it.effect("gives a server-host recording start the install allowance too", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const broker = yield* makeBroker;
+      const requests = requestsFrom(
+        yield* broker.connect(makeHost({ supportedOperations: ["status", "recordingStart"] }), {
+          preferred: true,
+        }),
+      );
+      yield* Stream.runForEach(requests, (request) =>
+        broker.respond({
+          clientId: "client-1",
+          connectionId: request.connectionId,
+          requestId: request.requestId,
+          ok: true,
+          result: request.timeoutMs,
+        }),
+      ).pipe(Effect.forkScoped);
+      // Let the host connect.
+      yield* Effect.yieldNow;
+      expect(yield* broker.invoke({ scope, operation: "recordingStart", input: {} })).toBe(660_000);
+    }),
+  ),
+);
+
+it.effect("keeps the server host serving others when one of its requests times out", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const broker = yield* makeBroker;
+      const requests = requestsFrom(yield* broker.connect(makeHost(), { preferred: true }));
+      const stalled = yield* Deferred.make<void>();
+      yield* Stream.runForEach(requests, (request) =>
+        request.operation === "evaluate"
+          ? Deferred.succeed(stalled, undefined)
+          : broker.respond({
+              clientId: "client-1",
+              connectionId: request.connectionId,
+              requestId: request.requestId,
+              ok: true,
+              result: request.operation,
+            }),
+      ).pipe(Effect.forkScoped);
+      const slow = yield* broker
+        .invoke({ scope, operation: "evaluate", input: {}, timeoutMs: 1_000 })
+        .pipe(Effect.flip, Effect.forkScoped);
+      yield* Deferred.await(stalled);
+      yield* TestClock.adjust(5_000);
+      expect(yield* Fiber.join(slow)).toMatchObject({ _tag: "PreviewAutomationTimeoutError" });
+      expect(yield* broker.invoke({ scope, operation: "snapshot", input: {} })).toBe("snapshot");
+    }),
+  ),
+);
+
 it.effect("preserves bounded request and remote selector diagnostics", () => {
   const locator = "role=button[name='request-secret']";
   const remoteMessage = "Unexpected token near remote-secret.";
diff --git a/apps/server/src/mcp/PreviewAutomationBroker.ts b/apps/server/src/mcp/PreviewAutomationBroker.ts
index c3d17ffad2..93af6533ef 100644
--- a/apps/server/src/mcp/PreviewAutomationBroker.ts
+++ b/apps/server/src/mcp/PreviewAutomationBroker.ts
@@ -561,10 +561,14 @@ export const make = Effect.gen(function* PreviewAutomationBrokerMake() {
         if (!hasLiveAssignment) assignments.delete(assignmentKey);
         return [undefined, { ...current, assignments }] as const;
       }
-      // The environment host may install Chromium on its first open (up to
-      // ten minutes). Keep that request alive without replaying its effects.
+      // The environment host may install Chromium on its first open or recording
+      // start (up to ten minutes). Keep that request alive without replaying its effects.
       const timeoutMs =
-        input.timeoutMs ?? (input.operation === "open" && connection.preferred ? 660_000 : 15_000);
+        input.timeoutMs ??
+        ((input.operation === "open" || input.operation === "recordingStart") &&
+        connection.preferred
+          ? 660_000
+          : 15_000);
       const canReuseAssignedTab =
         assigned !== undefined &&
         assigned.connectionId === connection.connectionId &&
@@ -665,7 +669,9 @@ export const make = Effect.gen(function* PreviewAutomationBrokerMake() {
             // actions: the client may have applied them before becoming unreachable.
             // A background metadata read has a short budget and changes nothing,
             // so a slow one must not cut the host off from the agent's next call.
-            if (input.updateCurrentTab !== false) {
+            // The server's own host is in-process and cannot become unreachable:
+            // one slow request fails alone, and the host keeps serving the others.
+            if (input.updateCurrentTab !== false && !connection.preferred) {
               yield* disconnect(connection.clientId, connection.queue, true);
             }
             return yield* new PreviewAutomationTimeoutError(requestContext);
