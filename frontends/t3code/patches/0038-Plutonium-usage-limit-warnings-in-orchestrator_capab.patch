@@ -0,0 +1,70 @@
+import { describe, expect, it } from "@effect/vitest";
+import type { ServerProviderUsageLimits } from "@t3tools/contracts";
+
+import { providerUsageWarning } from "./providerUsageWarning.ts";
+
+const now = Date.parse("2026-10-27T12:00:00.000Z");
+const limits = (
+  windows: ReadonlyArray<{ label: string; usedPercent: number; resetsAt?: string }>,
+): ServerProviderUsageLimits =>
+  ({
+    checkedAt: "2026-10-27T12:00:00.000Z",
+    windows: windows.map((window, index) => ({ id: `w${index}`, kind: "other", ...window })),
+  }) as unknown as ServerProviderUsageLimits;
+
+describe("providerUsageWarning", () => {
+  it("says nothing below the threshold, or without usage", () => {
+    expect(providerUsageWarning(undefined, now)).toBeUndefined();
+    expect(
+      providerUsageWarning(limits([{ label: "Session", usedPercent: 79 }]), now),
+    ).toBeUndefined();
+    expect(
+      providerUsageWarning(
+        {
+          ...limits([{ label: "Session", usedPercent: 100 }]),
+          unavailable: { reason: "probeFailed" },
+        },
+        now,
+      ),
+    ).toBeUndefined();
+  });
+
+  it("warns near a limit with the most used window and its reset", () => {
+    expect(
+      providerUsageWarning(
+        limits([
+          { label: "Session", usedPercent: 81, resetsAt: "2026-10-27T14:00:00.000Z" },
+          { label: "Weekly", usedPercent: 92.4, resetsAt: "2026-10-30T00:00:00.000Z" },
+        ]),
+        now,
+      ),
+    ).toEqual({
+      level: "near_limit",
+      window: "Weekly",
+      usedPercent: 92,
+      resetsAt: "2026-10-30T00:00:00.000Z",
+      message: "Weekly limit 92% used; it resets at 2026-10-30T00:00:00.000Z.",
+    });
+  });
+
+  it("at a limit, names the window that frees last; a window past its reset has reset", () => {
+    const warning = providerUsageWarning(
+      limits([
+        { label: "Session", usedPercent: 100, resetsAt: "2026-10-27T14:00:00.000Z" },
+        { label: "Weekly", usedPercent: 100, resetsAt: "2026-10-30T00:00:00.000Z" },
+        { label: "Weekly · Opus", usedPercent: 100, resetsAt: "2026-10-27T11:00:00.000Z" },
+      ]),
+      now,
+    );
+    expect(warning).toMatchObject({ level: "at_limit", window: "Weekly", usedPercent: 100 });
+    expect(warning?.message).toBe(
+      "Weekly limit reached: this instance can't run turns until 2026-10-30T00:00:00.000Z.",
+    );
+    expect(
+      providerUsageWarning(
+        limits([{ label: "Session", usedPercent: 100, resetsAt: "2026-10-27T11:00:00.000Z" }]),
+        now,
+      ),
+    ).toBeUndefined();
+  });
+});
diff --git a/apps/server/src/mcp/providerUsageWarning.ts b/apps/server/src/mcp/providerUsageWarning.ts
new file mode 100644
index 0000000000..cdc1394589
--- /dev/null
+++ b/apps/server/src/mcp/providerUsageWarning.ts
@@ -0,0 +1,52 @@
+/**
+ * Plutonium: the usage warning `orchestrator_capabilities` gives each provider
+ * instance, so an agent choosing one for a new thread or child task can avoid
+ * one at or near its subscription limits. Only the window that matters, not
+ * the usage data the UI draws (claudeUsageLimits.ts for Claude).
+ */
+import type { OrchestratorMcpUsageWarning, ServerProviderUsageLimits } from "@t3tools/contracts";
+
+/** From this much of a window used, the instance is near its limit. */
+export const NEAR_LIMIT_PERCENT = 80;
+/** Rounding: a window the provider reports at 99.6% is used up. */
+const AT_LIMIT_PERCENT = 99.5;
+
+/**
+ * The window closest to its limit, when one is near or at it; undefined when
+ * none is, or the instance reports no windows. A window whose reset time has
+ * passed has reset already, whatever it said.
+ */
+export function providerUsageWarning(
+  limits: ServerProviderUsageLimits | undefined,
+  nowMs: number,
+): OrchestratorMcpUsageWarning | undefined {
+  if (limits === undefined || limits.unavailable !== undefined) return undefined;
+  const current = limits.windows.filter(
+    (window) =>
+      window.usedPercent >= NEAR_LIMIT_PERCENT &&
+      (window.resetsAt === undefined || Date.parse(window.resetsAt) > nowMs),
+  );
+  // The most used; of those at the limit, the one that frees last.
+  const worst = current.toSorted((left, right) => {
+    const leftAt = left.usedPercent >= AT_LIMIT_PERCENT;
+    const rightAt = right.usedPercent >= AT_LIMIT_PERCENT;
+    if (leftAt && rightAt) {
+      return Date.parse(right.resetsAt ?? "") - Date.parse(left.resetsAt ?? "") || 0;
+    }
+    return right.usedPercent - left.usedPercent;
+  })[0];
+  if (worst === undefined) return undefined;
+  const level = worst.usedPercent >= AT_LIMIT_PERCENT ? "at_limit" : "near_limit";
+  const used = Math.round(worst.usedPercent);
+  const resets = worst.resetsAt === undefined ? "" : ` until ${worst.resetsAt}`;
+  return {
+    level,
+    window: worst.label,
+    usedPercent: used,
+    ...(worst.resetsAt === undefined ? {} : { resetsAt: worst.resetsAt }),
+    message:
+      level === "at_limit"
+        ? `${worst.label} limit reached: this instance can't run turns${resets}.`
+        : `${worst.label} limit ${used}% used${worst.resetsAt === undefined ? "" : `; it resets at ${worst.resetsAt}`}.`,
+  };
+}
