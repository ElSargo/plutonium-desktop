   );
 }
 
+/** Bubbles from a panel app whose own maximize button was pressed; detail: { maximized }. */
+export const PANEL_MAXIMIZE_REQUEST_EVENT = "plutonium:panel-maximize-request";
+
 function NativeWindowView({ windowId }: { windowId: number }) {
   const ref = useRef<HTMLElement | null>(null);
   const [error, setError] = useState<string | null>(null);
@@ -259,10 +262,23 @@ function NativeWindowView({ windowId }: { windowId: number }) {
     );
     const element = ref.current;
     const onError = () => setError("The browser refused to embed this window.");
+    // The app's own maximize button maximizes the panel (ChatView listens).
+    const onRequest = (event: Event) => {
+      const request = (event as Event & { request?: string }).request;
+      if (request !== "maximize" && request !== "unmaximize") return;
+      element?.dispatchEvent(
+        new CustomEvent(PANEL_MAXIMIZE_REQUEST_EVENT, {
+          bubbles: true,
+          detail: { maximized: request === "maximize" },
+        }),
+      );
+    };
     element?.addEventListener("windowerror", onError);
+    element?.addEventListener("windowrequest", onRequest);
     return () => {
       cancelled = true;
       element?.removeEventListener("windowerror", onError);
+      element?.removeEventListener("windowrequest", onRequest);
     };
   }, [windowId]);
 
@@ -271,6 +287,10 @@ function NativeWindowView({ windowId }: { windowId: number }) {
       {createElement("native-window", {
         ref,
         key: windowId,
+        // When the panel is maximized or restored, the app fills it at once
+        // and its old frame fades into its new one (drags stay live; a newly
+        // shown app doesn't fade).
+        crossfade: "200",
         style: { display: "block", width: "100%", height: "100%" },
       })}
