diff --git a/apps/web/src/plutonium/networkAccess.ts b/apps/web/src/plutonium/networkAccess.ts
new file mode 100644
index 0000000000..ecd2fd6847
--- /dev/null
+++ b/apps/web/src/plutonium/networkAccess.ts
@@ -0,0 +1,68 @@
+/**
+ * Network access for the server this page is served by, in a Plutonium
+ * session (the server's plutonium/networkAccess.ts): the Settings switch the
+ * desktop app has, for the shell, which is a browser page. Switching restarts
+ * the server on the other host, as in the desktop app.
+ */
+import type { DesktopServerExposureMode } from "@t3tools/contracts";
+import { useCallback, useEffect, useState } from "react";
+
+const ROUTE = "/api/plutonium/network-access";
+
+export interface PlutoniumNetworkAccess {
+  readonly mode: DesktopServerExposureMode;
+  /** False when T3_HOST pins the host, or the server isn't supervised. */
+  readonly switchable: boolean;
+  readonly pinned: boolean;
+}
+
+async function request(
+  init?: RequestInit,
+): Promise<PlutoniumNetworkAccess & { restarting?: boolean }> {
+  // Never from the cache, and never for long: a request that reaches the
+  // server while it restarts may get no answer at all, and Chrome would hold
+  // every later one for the same URL behind it.
+  const response = await fetch(ROUTE, {
+    credentials: "same-origin",
+    cache: "no-store",
+    signal: AbortSignal.timeout(init?.method === "POST" ? 10_000 : 3_000),
+    ...init,
+  });
+  if (!response.ok) throw new Error((await response.text()) || response.statusText);
+  return response.json();
+}
+
+/** The server's state, or null where it isn't a Plutonium server (or not yet known). */
+export function usePlutoniumNetworkAccess(enabled: boolean) {
+  const [state, setState] = useState<PlutoniumNetworkAccess | null>(null);
+  const refresh = useCallback(() => {
+    if (!enabled) return;
+    request()
+      .then(setState)
+      .catch(() => setState(null));
+  }, [enabled]);
+  useEffect(refresh, [refresh]);
+  return { state, refresh };
+}
+
+/** Saves |mode| and restarts the server; resolves once it answers again. */
+export async function setPlutoniumNetworkAccess(mode: DesktopServerExposureMode): Promise<void> {
+  const result = await request({
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ mode }),
+  });
+  if (!result.restarting) return;
+  // It stops within a moment, and starts again in a few seconds.
+  await new Promise((resolve) => setTimeout(resolve, 1000));
+  const deadline = Date.now() + 60_000;
+  while (Date.now() < deadline) {
+    try {
+      if ((await request()).mode === mode) return;
+    } catch {
+      // Not up yet.
+    }
+    await new Promise((resolve) => setTimeout(resolve, 500));
+  }
+  throw new Error("The server didn't come back within a minute.");
+}
