+/** Real mouse input along viewport points: down at the first, up at the last. */
+const dragPath = async (
+  page: Page,
+  path: ReadonlyArray<{ readonly x: number; readonly y: number }>,
+  input: Pick<PreviewAutomationDragInput, "button" | "modifiers">,
+  pointer: PointerReporter,
+) => {
+  const button = input.button ?? "left";
+  const modifiers = input.modifiers ?? [];
+  const [first, ...rest] = path;
+  await pointer(first!, "move");
+  await page.mouse.move(first!.x, first!.y);
+  const held: string[] = [];
+  let down = false;
+  try {
+    for (const key of modifiers) {
+      await page.keyboard.down(key);
+      held.push(key);
+    }
+    await page.mouse.down({ button });
+    down = true;
+    let from = first!;
+    for (const to of rest) {
+      const steps = Math.max(1, Math.ceil(Math.hypot(to.x - from.x, to.y - from.y) / DRAG_STEP_PX));
+      await page.mouse.move(to.x, to.y, { steps });
+      void pointer(to, "track");
+      from = to;
+    }
+    await page.mouse.up({ button });
+    down = false;
+  } finally {
+    // A failed drag must not leave the button or a modifier held in the tab.
+    if (down) await page.mouse.up({ button }).catch(constVoid);
+    for (const key of held.toReversed()) await page.keyboard.up(key).catch(constVoid);
+  }
+};
