+/** Width and height from a PNG's header, or null when it isn't one. */
+const pngSize = (base64: string) => {
+  const header = Buffer.from(base64.slice(0, 32), "base64");
+  if (header.length < 24 || header.toString("ascii", 12, 16) !== "IHDR") return null;
+  return { width: header.readUInt32BE(16), height: header.readUInt32BE(20) };
+};
+
+/**
+ * The page's viewport in CSS pixels, the space click coordinates are in, and
+ * the device pixels each one is drawn with. Read from the page, since a tab
+ * the desktop renders draws at the screen's scale, not the server's.
+ */
+const viewportMetrics = async (page: Page, cdp: CDPSession) => {
+  const [{ cssVisualViewport }, devicePixelRatio] = await Promise.all([
+    cdp.send("Page.getLayoutMetrics"),
+    page.evaluate("devicePixelRatio") as Promise<number>,
+  ]);
+  return {
+    width: Math.round(cssVisualViewport.clientWidth),
+    height: Math.round(cssVisualViewport.clientHeight),
+    devicePixelRatio: devicePixelRatio > 0 ? devicePixelRatio : 1,
+  };
+};
+
+/**
+ * Image pixels per CSS pixel at capture scale 1, learned per page. Chromium
+ * multiplies a capture's scale by the device pixel ratio on screen, but not
+ * always under device emulation, so the first capture checks.
+ */
+const capturePixelRatio = new WeakMap<
+  Page,
+  { readonly devicePixelRatio: number; readonly ratio: number }
+>();
+
+/** A PNG of the viewport `width` pixels wide. */
+const captureAtWidth = async (
+  page: Page,
+  cdp: CDPSession,
+  viewport: { readonly width: number; readonly devicePixelRatio: number },
+  width: number,
+) => {
+  const capture = (ratio: number) =>
+    captureViewport(page, cdp, { format: "png", scale: width / viewport.width / ratio });
+  const { devicePixelRatio } = viewport;
+  const learned = capturePixelRatio.get(page);
+  const ratio = learned?.devicePixelRatio === devicePixelRatio ? learned.ratio : devicePixelRatio;
+  const data = await capture(ratio);
+  const captured = pngSize(data)?.width;
+  if (captured === undefined || Math.abs(captured - width) <= 1) {
+    capturePixelRatio.set(page, { devicePixelRatio, ratio });
+    return data;
+  }
+  // Captured pixels are rounded, so snap to whichever of the two it is.
+  const measured = (ratio * captured) / width;
+  const actual =
+    Math.abs(measured - 1) < Math.abs(measured - devicePixelRatio) ? 1 : devicePixelRatio;
+  capturePixelRatio.set(page, { devicePixelRatio, ratio: actual });
+  return capture(actual);
+};
