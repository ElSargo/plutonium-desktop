--- /dev/null
+++ b/packages/shared/src/plutonium.ts
@@ -0,0 +1,37 @@
+// Plutonium: run T3 Code as the web shell of a Chromium/Exo desktop, where
+// native Wayland apps that agents start show up as page elements.
+//
+// Only active when the server is started with PLUTONIUM_WAYLAND_DISPLAY (the
+// Exo socket, e.g. "wayland-cros"). Agents then get that display plus their
+// thread id in their environment, and every process they start inherits both.
+
+export const PLUTONIUM_THREAD_ID_VARIABLE = "PLUTONIUM_THREAD_ID";
+
+export function plutoniumWaylandDisplay(): string | undefined {
+  return process.env.PLUTONIUM_WAYLAND_DISPLAY || undefined;
+}
+
+/** Variables that send an agent's GUI apps to Exo and tag them with the thread. */
+export function plutoniumAgentEnvironment(
+  threadId: string | undefined,
+): Readonly<Record<string, string>> {
+  const display = plutoniumWaylandDisplay();
+  if (!display || !threadId) return {};
+  return {
+    [PLUTONIUM_THREAD_ID_VARIABLE]: threadId,
+    WAYLAND_DISPLAY: display,
+    GDK_BACKEND: "wayland",
+    QT_QPA_PLATFORM: "wayland",
+    MOZ_ENABLE_WAYLAND: "1",
+  };
+}
+
+/** `env` with the Plutonium variables for `threadId` (`env` itself when off). */
+export function withPlutoniumAgentEnvironment(
+  env: NodeJS.ProcessEnv | undefined,
+  threadId: string | undefined,
+): NodeJS.ProcessEnv | undefined {
+  const plutonium = plutoniumAgentEnvironment(threadId);
+  if (Object.keys(plutonium).length === 0) return env;
+  return { ...(env ?? process.env), ...plutonium };
+}
