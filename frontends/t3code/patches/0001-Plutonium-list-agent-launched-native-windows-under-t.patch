+// Plutonium: a thread's native windows in the sidebar, and the pane that
+// shows one of them live as a <native-window> element.
+import { AppWindowIcon, XIcon } from "lucide-react";
+import { createElement, useEffect, useRef, useState } from "react";
+
+import { cn } from "~/lib/utils";
+
+import {
+  grantFor,
+  startPlutoniumWindows,
+  usePlutoniumWindowStore,
+  useThreadWindows,
+} from "./windowStore";
+
+/** The windows a thread's agent started, listed under its sidebar row. */
+export function PlutoniumThreadWindows({ threadId }: { threadId: string }) {
+  const windows = useThreadWindows(threadId);
+  const openWindowId = usePlutoniumWindowStore((state) => state.openWindowId);
+  const openWindow = usePlutoniumWindowStore((state) => state.openWindow);
+  if (windows.length === 0) return null;
+  return (
+    <ul className="mb-1 ml-6 flex flex-col gap-0.5" data-plutonium-thread-windows={threadId}>
+      {windows.map((entry) => (
+        <li key={entry.id}>
+          <button
+            type="button"
+            className={cn(
+              "flex w-full items-center gap-1.5 rounded-md px-2 py-1 text-left text-xs text-muted-foreground hover:bg-accent hover:text-foreground",
+              openWindowId === entry.id && "bg-accent text-foreground",
+            )}
+            title={`${entry.appId || "app"} (window ${entry.id})`}
+            onClick={() => openWindow(openWindowId === entry.id ? null : entry.id)}
+          >
+            <AppWindowIcon className="size-3.5 shrink-0" />
+            <span className="truncate">{entry.title || entry.appId || `Window ${entry.id}`}</span>
+          </button>
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+function NativeWindowView({ windowId }: { windowId: number }) {
+  const ref = useRef<HTMLElement | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+    setError(null);
+    grantFor(windowId).then(
+      (grant) => {
+        if (cancelled || !ref.current) return;
+        ref.current.setAttribute("window", String(windowId));
+        ref.current.setAttribute("grant", grant);
+      },
+      () => !cancelled && setError("No grant for this window."),
+    );
+    const element = ref.current;
+    const onError = () => setError("The browser refused to embed this window.");
+    element?.addEventListener("windowerror", onError);
+    return () => {
+      cancelled = true;
+      element?.removeEventListener("windowerror", onError);
+    };
+  }, [windowId]);
+
+  return (
+    <div className="relative min-h-0 flex-1">
+      {createElement("native-window", {
+        ref,
+        key: windowId,
+        style: { display: "block", width: "100%", height: "100%" },
+      })}
+      {error && (
+        <p className="absolute inset-0 flex items-center justify-center text-sm text-muted-foreground">
+          {error}
+        </p>
+      )}
+    </div>
+  );
+}
+
+/** The open window, over the right part of the app. Renders nothing outside the shell. */
+export function PlutoniumAppPane() {
+  useEffect(startPlutoniumWindows, []);
+  const openWindowId = usePlutoniumWindowStore((state) => state.openWindowId);
+  const entry = usePlutoniumWindowStore((state) =>
+    openWindowId === null ? undefined : state.windows[openWindowId],
+  );
+  const openWindow = usePlutoniumWindowStore((state) => state.openWindow);
+  if (openWindowId === null || !entry) return null;
+  return (
+    <div
+      className="fixed top-14 bottom-3 right-3 z-40 flex w-[min(56vw,960px)] flex-col overflow-hidden rounded-xl border bg-background shadow-2xl"
+      data-plutonium-app-pane={openWindowId}
+    >
+      <div className="flex h-9 shrink-0 items-center gap-2 border-b px-3 text-sm">
+        <AppWindowIcon className="size-4 text-muted-foreground" />
+        <span className="truncate font-medium">{entry.title || entry.appId}</span>
+        <span className="truncate text-xs text-muted-foreground">{entry.appId}</span>
+        <button
+          type="button"
+          className="ml-auto rounded p-1 text-muted-foreground hover:bg-accent hover:text-foreground"
+          aria-label="Close app pane"
+          onClick={() => openWindow(null)}
+        >
+          <XIcon className="size-4" />
+        </button>
+      </div>
+      <NativeWindowView windowId={openWindowId} />
+    </div>
+  );
+}
diff --git a/apps/web/src/plutonium/windowStore.ts b/apps/web/src/plutonium/windowStore.ts
new file mode 100644
index 0000000000..7ebeca7f69
--- /dev/null
+++ b/apps/web/src/plutonium/windowStore.ts
@@ -0,0 +1,138 @@
+// Plutonium: native windows from the browser's window broker, grouped by the
+// thread whose agent started them.
+//
+// Only active when this page is the Plutonium shell (Chromium exposes
+// `navigator.windowBroker` to the shell origin only). Window → thread comes
+// from the server: it reads PLUTONIUM_THREAD_ID from the client process (see
+// apps/server/src/plutonium.ts).
+import { create } from "zustand";
+
+export interface NativeWindowEntry {
+  readonly id: number;
+  readonly appId: string;
+  readonly title: string;
+  readonly width: number;
+  readonly height: number;
+  readonly deviceScaleFactor: number;
+  readonly embedded: boolean;
+  readonly focused: boolean;
+  readonly pid: number;
+}
+
+interface NativeWindowEvent extends Event {
+  readonly windowId: number;
+  readonly entry: NativeWindowEntry | null;
+}
+
+interface NativeWindowBroker extends EventTarget {
+  requestGrant(windowId: number): Promise<string>;
+  revokeGrant(grant: string): void;
+}
+
+const WINDOW_THREADS_PATH = "/api/plutonium/window-threads";
+
+interface PlutoniumWindowState {
+  readonly available: boolean;
+  readonly windows: Readonly<Record<number, NativeWindowEntry>>;
+  /** Client pid → thread id, as resolved by the server. */
+  readonly threadByPid: Readonly<Record<number, string>>;
+  /** The window shown in the app pane, if any. */
+  readonly openWindowId: number | null;
+  readonly openWindow: (windowId: number | null) => void;
+}
+
+export const usePlutoniumWindowStore = create<PlutoniumWindowState>((set) => ({
+  available: false,
+  windows: {},
+  threadByPid: {},
+  openWindowId: null,
+  openWindow: (windowId) => set({ openWindowId: windowId }),
+}));
+
+function broker(): NativeWindowBroker | null {
+  return (navigator as Navigator & { windowBroker?: NativeWindowBroker }).windowBroker ?? null;
+}
+
+const grants = new Map<number, Promise<string>>();
+
+/** A grant to embed `windowId` in this document (one per window, reused). */
+export function grantFor(windowId: number): Promise<string> {
+  const windowBroker = broker();
+  if (!windowBroker) return Promise.reject(new Error("not the Plutonium shell"));
+  let grant = grants.get(windowId);
+  if (!grant) {
+    grant = windowBroker.requestGrant(windowId);
+    grant.catch(() => grants.delete(windowId));
+    grants.set(windowId, grant);
+  }
+  return grant;
+}
+
+const pendingPids = new Set<number>();
+let resolveTimer: ReturnType<typeof setTimeout> | null = null;
+
+// A client's environment is fixed at exec, so a pid resolves once. Unresolved
+// pids are retried on the window's next change.
+function resolvePid(pid: number): void {
+  if (pid <= 0 || pid in usePlutoniumWindowStore.getState().threadByPid) return;
+  pendingPids.add(pid);
+  resolveTimer ??= setTimeout(() => {
+    resolveTimer = null;
+    const pids = [...pendingPids];
+    pendingPids.clear();
+    void fetch(`${WINDOW_THREADS_PATH}?pids=${pids.join(",")}`, { credentials: "include" })
+      .then((response) => (response.ok ? response.json() : {}))
+      .then((resolved: Record<string, string>) => {
+        const entries = Object.entries(resolved).map(([pid, threadId]) => [Number(pid), threadId]);
+        if (entries.length === 0) return;
+        usePlutoniumWindowStore.setState((state) => ({
+          threadByPid: { ...state.threadByPid, ...Object.fromEntries(entries) },
+        }));
+      })
+      .catch(() => undefined);
+  }, 50);
+}
+
+function onWindow(event: Event): void {
+  const { windowId, entry } = event as NativeWindowEvent;
+  if (!entry) return;
+  usePlutoniumWindowStore.setState((state) => ({
+    windows: { ...state.windows, [windowId]: entry },
+  }));
+  resolvePid(entry.pid);
+}
+
+function onWindowRemoved(event: Event): void {
+  const { windowId } = event as NativeWindowEvent;
+  grants.delete(windowId);
+  usePlutoniumWindowStore.setState((state) => {
+    const { [windowId]: _removed, ...windows } = state.windows;
+    return {
+      windows,
+      openWindowId: state.openWindowId === windowId ? null : state.openWindowId,
+    };
+  });
+}
+
+let started = false;
+
+/** Subscribe to the broker once per document. A no-op outside the shell. */
+export function startPlutoniumWindows(): void {
+  if (started) return;
+  started = true;
+  const windowBroker = broker();
+  if (!windowBroker) return;
+  usePlutoniumWindowStore.setState({ available: true });
+  windowBroker.addEventListener("windowadded", onWindow);
+  windowBroker.addEventListener("windowchanged", onWindow);
+  windowBroker.addEventListener("windowremoved", onWindowRemoved);
+}
+
+/** Windows started by `threadId`'s agent, oldest first. */
+export function useThreadWindows(threadId: string): readonly NativeWindowEntry[] {
+  const windows = usePlutoniumWindowStore((state) => state.windows);
+  const threadByPid = usePlutoniumWindowStore((state) => state.threadByPid);
+  return Object.values(windows)
+    .filter((entry) => threadByPid[entry.pid] === threadId)
+    .toSorted((a, b) => a.id - b.id);
+}
