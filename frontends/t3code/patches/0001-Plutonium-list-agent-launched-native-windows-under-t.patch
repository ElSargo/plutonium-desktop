diff --git a/apps/server/src/plutonium.ts b/apps/server/src/plutonium.ts
new file mode 100644
index 0000000000..604a4f87ad
--- /dev/null
+++ b/apps/server/src/plutonium.ts
@@ -0,0 +1,69 @@
+// Plutonium: run T3 Code as the web shell of a Chromium/Exo desktop, where
+// native Wayland apps that agents start show up as page elements.
+//
+// Only active when the server is started with PLUTONIUM_WAYLAND_DISPLAY (the
+// Exo socket, e.g. "wayland-cros"). Agents then get that display plus their
+// thread id in their environment (@t3tools/shared/plutonium), and every
+// process they start inherits both. The shell page learns each window's client
+// pid from the browser's window broker and asks this server which thread the
+// pid belongs to.
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+
+import { PLUTONIUM_THREAD_ID_VARIABLE as THREAD_ID_VARIABLE } from "@t3tools/shared/plutonium";
+
+// Enough to get from a GUI app through shells and wrappers to the agent.
+const MAX_PARENT_DEPTH = 16;
+
+export const PLUTONIUM_WINDOW_THREADS_PATH = "/api/plutonium/window-threads";
+
+const readThreadId = (fileSystem: FileSystem.FileSystem, pid: number) =>
+  fileSystem.readFileString(`/proc/${pid}/environ`).pipe(
+    Effect.map((environ) => {
+      const prefix = `${THREAD_ID_VARIABLE}=`;
+      const entry = environ.split("\0").find((line) => line.startsWith(prefix));
+      return entry?.slice(prefix.length) || undefined;
+    }),
+    // Gone, or not ours.
+    Effect.orElseSucceed(() => undefined),
+  );
+
+const readParentPid = (fileSystem: FileSystem.FileSystem, pid: number) =>
+  fileSystem.readFileString(`/proc/${pid}/stat`).pipe(
+    Effect.map((stat) => {
+      // The command name is in parentheses and may contain spaces.
+      const parent = Number(stat.slice(stat.lastIndexOf(")") + 2).split(" ")[1]);
+      return parent > 1 ? parent : undefined;
+    }),
+    Effect.orElseSucceed(() => undefined),
+  );
+
+/**
+ * The thread whose agent started `pid`: the process's own tag, or the nearest
+ * tagged ancestor (for apps that clear their environment).
+ */
+const resolveThreadForPid = (fileSystem: FileSystem.FileSystem, pid: number) =>
+  Effect.gen(function* () {
+    let current: number | undefined = pid;
+    for (let depth = 0; current !== undefined && depth < MAX_PARENT_DEPTH; depth++) {
+      const threadId = yield* readThreadId(fileSystem, current);
+      if (threadId) return threadId;
+      current = yield* readParentPid(fileSystem, current);
+    }
+    return undefined;
+  });
+
+/** pids → thread ids, for the `?pids=1,2,3` query. Unknown pids are left out. */
+export const resolveWindowThreads = (pidsQuery: string | null) =>
+  Effect.gen(function* () {
+    const fileSystem = yield* FileSystem.FileSystem;
+    const result: Record<string, string> = {};
+    if (process.platform !== "linux" || !pidsQuery) return result;
+    for (const part of pidsQuery.split(",").slice(0, 256)) {
+      const pid = Number(part);
+      if (!Number.isInteger(pid) || pid <= 1) continue;
+      const threadId = yield* resolveThreadForPid(fileSystem, pid);
+      if (threadId) result[String(pid)] = threadId;
+    }
+    return result;
+  });
