+// Plutonium: the desktop services Hydra draws in its status cluster
+// (PlutoniumStatus.tsx): the helper's audio, power, network, Bluetooth, media
+// and session services, through the shell library (`shell.system.<name>`,
+// docs/features/DESKTOP_SERVICES.md in the plutonium repo). Each one's state
+// is the helper's JSON, typed here as far as the status cluster reads it.
+import { useCallback, useEffect, useState } from "react";
+
+import { type SystemServiceHandle, isPlutoniumShell, plutoniumShell } from "./windowStore";
+
+export interface AudioDevice {
+  readonly id: number;
+  readonly name: string;
+  readonly default: boolean;
+  readonly volume: number;
+  readonly muted: boolean;
+}
+
+export interface AudioState {
+  readonly available: boolean;
+  readonly volume: number;
+  readonly muted: boolean;
+  readonly outputs: readonly AudioDevice[];
+}
+
+export interface BatteryState {
+  readonly percent: number;
+  readonly charging: boolean;
+  readonly state: string;
+  /** Seconds to empty or to full, or null. */
+  readonly timeLeft: number | null;
+}
+
+type Can = "yes" | "challenge" | "no" | "na";
+
+export interface PowerState {
+  readonly battery: BatteryState | null;
+  readonly ac: boolean;
+  readonly brightness: { readonly available: boolean; readonly value: number };
+  readonly can: {
+    readonly suspend: Can;
+    readonly reboot: Can;
+    readonly powerOff: Can;
+    readonly logOut: Can;
+  };
+}
+
+export interface AccessPoint {
+  readonly ssid: string;
+  readonly strength: number;
+  readonly secured: boolean;
+  readonly security: string;
+  readonly known: boolean;
+  readonly id: string | null;
+  readonly active: boolean;
+}
+
+export interface NetworkConnection {
+  readonly id: string;
+  readonly name: string;
+  readonly type: string;
+  readonly active: boolean;
+}
+
+export interface NetworkState {
+  readonly available: boolean;
+  readonly state: "connected" | "connecting" | "disconnecting" | "offline" | "unknown";
+  readonly connectivity: string;
+  readonly primary: {
+    readonly id: string;
+    readonly name: string;
+    readonly type: string;
+    readonly strength?: number;
+  } | null;
+  readonly wifi: {
+    readonly available: boolean;
+    readonly enabled: boolean;
+    readonly hardwareEnabled: boolean;
+    readonly scanning: boolean;
+  };
+  readonly accessPoints: readonly AccessPoint[];
+  readonly connections: readonly NetworkConnection[];
+}
+
+export interface BluetoothDevice {
+  readonly id: string;
+  readonly name: string;
+  readonly icon: string | null;
+  readonly paired: boolean;
+  readonly connected: boolean;
+  readonly battery: number | null;
+}
+
+export interface BluetoothState {
+  readonly available: boolean;
+  readonly adapter: { readonly powered: boolean } | null;
+  readonly devices: readonly BluetoothDevice[];
+}
+
+export interface MediaPlayer {
+  readonly id: string;
+  readonly name: string;
+  readonly status: "playing" | "paused" | "stopped";
+  readonly title: string;
+  readonly artist: string;
+  readonly canPlay: boolean;
+  readonly canPause: boolean;
+  readonly canGoNext: boolean;
+  readonly canGoPrevious: boolean;
+}
+
+export interface MediaState {
+  readonly available: boolean;
+  readonly players: readonly MediaPlayer[];
+  readonly active: string | null;
+}
+
+export interface SessionState {
+  readonly canLock: boolean;
+  readonly problem: string | null;
+}
+
+interface ServiceStates {
+  audio: AudioState;
+  power: PowerState;
+  network: NetworkState;
+  bluetooth: BluetoothState;
+  media: MediaState;
+  session: SessionState;
+}
+
+export type SystemServiceName = keyof ServiceStates;
+
+/**
+ * A desktop service's state (null until it answers, outside the Plutonium
+ * shell, or when this shell may not use it) and a way to run its actions.
+ */
+export function useSystemService<Name extends SystemServiceName>(
+  name: Name,
+): {
+  readonly state: ServiceStates[Name] | null;
+  readonly call: (action: string, args?: Record<string, unknown>) => Promise<unknown>;
+} {
+  const [service, setService] = useState<SystemServiceHandle | null>(null);
+  const [state, setState] = useState<ServiceStates[Name] | null>(null);
+
+  useEffect(() => {
+    if (!isPlutoniumShell()) return;
+    let current: SystemServiceHandle | null = null;
+    const onChange = () => setState((current?.state as ServiceStates[Name] | null) ?? null);
+    let cancelled = false;
+    void plutoniumShell().then((shell) => {
+      const handle = shell?.system?.get(name);
+      if (cancelled || !handle) return;
+      current = handle;
+      setService(handle);
+      handle.addEventListener("change", onChange);
+      onChange();
+      // Not in "uses", or not on this computer: no state, nothing drawn.
+      handle.ready.catch(() => {});
+    });
+    return () => {
+      cancelled = true;
+      current?.removeEventListener("change", onChange);
+    };
+  }, [name]);
+
+  const call = useCallback(
+    (action: string, args?: Record<string, unknown>) =>
+      service
+        ? service.call(action, args)
+        : Promise.reject(new Error(`The ${name} service isn't available.`)),
+    [name, service],
+  );
+
+  return { state, call };
+}
