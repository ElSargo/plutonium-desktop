+const STATUS_WIDTH_PROPERTY = "--plutonium-status-width";
+/** The space between the cluster and the controls left of it. */
+const STATUS_GAP_PX = 4;
+
+const timeFormat = new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" });
+const dateFormat = new Intl.DateTimeFormat(undefined, {
+  weekday: "long",
+  day: "numeric",
+  month: "long",
+  year: "numeric",
+});
+
+/** Now, again at each minute's turn. */
+function useMinute(): Date {
+  const [now, setNow] = useState(() => new Date());
+  useEffect(() => {
+    let timer: ReturnType<typeof setTimeout>;
+    const schedule = () => {
+      const next = new Date();
+      timer = setTimeout(
+        () => {
+          setNow(new Date());
+          schedule();
+        },
+        60_000 - (next.getSeconds() * 1000 + next.getMilliseconds()) + 50,
+      );
+    };
+    schedule();
+    // After a suspend the timer is late: catch up when the page shows again.
+    const onVisible = () => setNow(new Date());
+    document.addEventListener("visibilitychange", onVisible);
+    return () => {
+      clearTimeout(timer);
+      document.removeEventListener("visibilitychange", onVisible);
+    };
+  }, []);
+  return now;
+}
+
+function duration(seconds: number): string {
+  const minutes = Math.round(seconds / 60);
+  if (minutes < 60) return `${minutes} min`;
+  const hours = Math.floor(minutes / 60);
+  const rest = minutes % 60;
+  return rest ? `${hours} h ${rest} min` : `${hours} h`;
+}
+
+function batteryLow(battery: BatteryState): boolean {
+  return battery.percent <= 15 && !battery.charging;
+}
+
+function BatteryGlyph({ battery, className }: { battery: BatteryState; className?: string }) {
+  const Icon = battery.charging
+    ? BatteryChargingIcon
+    : batteryLow(battery)
+      ? BatteryWarningIcon
+      : battery.percent >= 85
+        ? BatteryFullIcon
+        : battery.percent >= 50
+          ? BatteryMediumIcon
+          : battery.percent >= 20
+            ? BatteryLowIcon
+            : BatteryIcon;
+  return <Icon className={cn(batteryLow(battery) && "text-destructive", className)} />;
+}
+
+function batteryText(power: PowerState, battery: BatteryState): string {
+  const what =
+    battery.state === "full"
+      ? "Full"
+      : battery.charging
+        ? "Charging"
+        : power.ac
+          ? "Plugged in, not charging"
+          : "On battery";
+  const left = battery.timeLeft
+    ? `, ${duration(battery.timeLeft)} ${battery.charging ? "to full" : "left"}`
+    : "";
+  return `${battery.percent}%: ${what}${left}`;
+}
+
+function WifiGlyph({ strength }: { strength: number | undefined }) {
+  if (strength === undefined || strength >= 70) return <WifiIcon />;
+  if (strength >= 45) return <WifiHighIcon />;
+  return strength >= 20 ? <WifiLowIcon /> : <WifiZeroIcon />;
+}
+
+/** The connection in use: Wi-Fi's signal, wired, or none. */
+function NetworkGlyph({ network }: { network: NetworkState }) {
+  if (!network.primary) return network.wifi.available ? <WifiOffIcon /> : <EthernetPortIcon />;
+  if (network.primary.type === "ethernet") return <EthernetPortIcon />;
+  return <WifiGlyph strength={network.primary.strength} />;
+}
+
+/** What the network row says: the connection in use, else why there's none. */
+function networkSummary(network: NetworkState): string {
+  if (network.state === "connecting") return "Connecting…";
+  if (!network.primary) return network.wifi.available && !network.wifi.enabled ? "Off" : "Offline";
+  const limited =
+    network.connectivity === "portal"
+      ? " (sign-in needed)"
+      : network.connectivity === "limited" || network.connectivity === "none"
+        ? " (no internet)"
+        : "";
+  return `${network.primary.name}${limited}`;
+}
+
+/**
+ * A setter that sends one value at a time, the last one moved to winning:
+ * a slider's drag doesn't queue a call per pixel.
+ */
+function useLatestSender(send: (value: number) => Promise<unknown>): (value: number) => void {
+  const sendRef = useRef(send);
+  useEffect(() => {
+    sendRef.current = send;
+  }, [send]);
+  const queue = useRef<{ busy: boolean; next: number | null }>({ busy: false, next: null });
+  return useCallback((value: number) => {
+    const state = queue.current;
+    const go = (target: number) => {
+      state.busy = true;
+      void sendRef
+        .current(target)
+        .catch((error: unknown) => console.warn(error))
+        .finally(() => {
+          state.busy = false;
+          const again = state.next;
+          state.next = null;
+          if (again !== null) go(again);
+        });
+    };
+    if (state.busy) state.next = value;
+    else go(value);
+  }, []);
+}
+
+function LevelRow({
+  icon,
+  label,
+  value,
+  onChange,
+  onIconClick,
+  iconLabel,
+}: {
+  icon: ReactNode;
+  label: string;
+  value: number;
+  onChange: (value: number) => void;
+  onIconClick?: () => void;
+  iconLabel?: string;
+}) {
+  // The slider follows the hand while it moves; the service's state after.
+  const [dragging, setDragging] = useState<number | null>(null);
+  const shown = dragging ?? value;
+  return (
+    <div className="flex items-center gap-2">
+      {onIconClick ? (
+        <button
+          type="button"
+          aria-label={iconLabel}
+          onClick={onIconClick}
+          className="flex size-7 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground [&_svg]:size-4"
+        >
+          {icon}
+        </button>
+      ) : (
+        <span className="flex size-7 shrink-0 items-center justify-center text-muted-foreground [&_svg]:size-4">
+          {icon}
+        </span>
+      )}
+      <input
+        type="range"
+        aria-label={label}
+        min={0}
+        max={1}
+        step={0.01}
+        value={Math.min(1, shown)}
+        onChange={(event) => {
+          const next = Number(event.currentTarget.value);
+          setDragging(next);
+          onChange(next);
+        }}
+        onPointerUp={() => setDragging(null)}
+        onKeyUp={() => setDragging(null)}
+        className="h-1.5 min-w-0 flex-1 cursor-pointer accent-primary"
+      />
+      <span className="w-9 shrink-0 text-right text-xs tabular-nums text-muted-foreground">
+        {Math.round(shown * 100)}%
+      </span>
+    </div>
+  );
+}
+
+function ToggleRow({
+  icon,
+  title,
+  detail,
+  checked,
+  disabled,
+  onCheckedChange,
+  expanded,
+  onExpandedChange,
+}: {
+  icon: ReactNode;
+  title: string;
+  detail: string;
+  checked?: boolean;
+  disabled?: boolean;
+  onCheckedChange?: (checked: boolean) => void;
+  expanded: boolean;
+  onExpandedChange: (expanded: boolean) => void;
+}) {
+  const Chevron = expanded ? ChevronDownIcon : ChevronRightIcon;
+  return (
+    <div className="flex items-center gap-2">
+      <button
+        type="button"
+        onClick={() => onExpandedChange(!expanded)}
+        aria-expanded={expanded}
+        className="flex min-w-0 flex-1 items-center gap-2 rounded-md py-1 pr-1 text-left hover:bg-accent"
+      >
+        <span className="flex size-7 shrink-0 items-center justify-center text-muted-foreground [&_svg]:size-4">
+          {icon}
+        </span>
+        <span className="min-w-0 flex-1">
+          <span className="block text-sm">{title}</span>
+          <span className="block truncate text-xs text-muted-foreground">{detail}</span>
+        </span>
+        <Chevron className="size-4 shrink-0 text-muted-foreground" />
+      </button>
+      {onCheckedChange ? (
+        <Switch
+          size="sm"
+          aria-label={`${title} ${checked ? "on" : "off"}`}
+          checked={checked ?? false}
+          disabled={disabled ?? false}
+          onCheckedChange={onCheckedChange}
+        />
+      ) : null}
+    </div>
+  );
+}
+
+function ListButton({
+  children,
+  current,
+  onClick,
+}: {
+  children: ReactNode;
+  current?: boolean;
+  onClick: () => void;
+}) {
+  return (
+    <button
+      type="button"
+      onClick={onClick}
+      className={cn(
+        "flex w-full items-center gap-2 rounded-md px-2 py-1 text-left text-sm hover:bg-accent [&_svg]:size-3.5 [&_svg]:shrink-0",
+        current && "font-medium",
+      )}
+    >
+      {children}
+    </button>
+  );
+}
+
+function SmallAction({ children, onClick }: { children: ReactNode; onClick: () => void }) {
+  return (
+    <button
+      type="button"
+      onClick={onClick}
+      className="rounded-md px-2 py-0.5 text-xs text-muted-foreground hover:bg-accent hover:text-foreground"
+    >
+      {children}
+    </button>
+  );
+}
+
+function WifiList({
+  network,
+  call,
+}: {
+  network: NetworkState;
+  call: (action: string, args?: Record<string, unknown>) => Promise<unknown>;
+}) {
+  const [asking, setAsking] = useState<string | null>(null);
+  const [password, setPassword] = useState("");
+  const [open, setOpen] = useState<string | null>(null);
+  const [error, setError] = useState("");
+
+  useEffect(() => {
+    void call("scan").catch(() => {});
+  }, [call]);
+
+  const act = (action: string, args: Record<string, unknown>) => {
+    setError("");
+    call(action, args).catch((cause: unknown) =>
+      setError(String((cause as Error)?.message ?? cause)),
+    );
+  };
+
+  const choose = (ap: AccessPoint) => {
+    if (ap.known) {
+      setOpen(open === ap.ssid ? null : ap.ssid);
+      return;
+    }
+    if (ap.secured && ap.security !== "enterprise") {
+      setAsking(ap.ssid);
+      setPassword("");
+      return;
+    }
+    act("connect", { ssid: ap.ssid });
+  };
+
+  const wired = network.connections.filter((connection) => connection.type !== "wifi");
+  return (
+    <div className="ml-9 grid gap-0.5">
+      {network.wifi.enabled ? (
+        <div className="grid max-h-56 gap-0.5 overflow-y-auto">
+          {network.accessPoints.map((ap) => {
+            return (
+              <div key={ap.ssid}>
+                <ListButton current={ap.active} onClick={() => choose(ap)}>
+                  <WifiGlyph strength={ap.strength} />
+                  <span className="min-w-0 flex-1 truncate">{ap.ssid}</span>
+                  {ap.secured ? <LockKeyholeIcon className="text-muted-foreground" /> : null}
+                </ListButton>
+                {open === ap.ssid ? (
+                  <div className="flex justify-end gap-1 pb-1">
+                    {ap.active ? (
+                      <SmallAction onClick={() => act("disconnect", { id: ap.id })}>
+                        Disconnect
+                      </SmallAction>
+                    ) : (
+                      <SmallAction onClick={() => act("connect", { ssid: ap.ssid })}>
+                        Connect
+                      </SmallAction>
+                    )}
+                    <SmallAction onClick={() => act("forget", { ssid: ap.ssid })}>
+                      Forget
+                    </SmallAction>
+                  </div>
+                ) : null}
+                {asking === ap.ssid ? (
+                  <form
+                    className="flex gap-1 px-2 pb-1"
+                    onSubmit={(event) => {
+                      event.preventDefault();
+                      setAsking(null);
+                      act("connect", { ssid: ap.ssid, password });
+                    }}
+                  >
+                    <Input
+                      size="sm"
+                      type="password"
+                      autoFocus
+                      placeholder="Password"
+                      value={password}
+                      onChange={(event) => setPassword(event.currentTarget.value)}
+                    />
+                    <SmallAction onClick={() => setAsking(null)}>Cancel</SmallAction>
+                  </form>
+                ) : null}
+              </div>
+            );
+          })}
+          {network.accessPoints.length === 0 ? (
+            <div className="px-2 py-1 text-xs text-muted-foreground">
+              {network.wifi.scanning ? "Looking for networks…" : "No networks found."}
+            </div>
+          ) : null}
+        </div>
+      ) : null}
+      {wired.map((connection) => (
+        <ListButton
+          key={connection.id}
+          current={connection.active}
+          onClick={() => act(connection.active ? "disconnect" : "connect", { id: connection.id })}
+        >
+          {connection.type === "vpn" ? <LockIcon /> : <EthernetPortIcon />}
+          <span className="min-w-0 flex-1 truncate">{connection.name}</span>
+        </ListButton>
+      ))}
+      {error ? <div className="px-2 text-xs text-destructive">{error}</div> : null}
+    </div>
+  );
+}
