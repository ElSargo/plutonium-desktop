+            aria-label={label}
+            disabled={disabled}
+            onClick={onClick}
+            className="flex size-8 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground disabled:pointer-events-none disabled:opacity-40 [&_svg]:size-4"
+          />
+        }
+      >
+        {children}
+      </TooltipTrigger>
+      <TooltipPopup side="top">{label}</TooltipPopup>
+    </Tooltip>
+  );
+}
+
+function confirm(question: string, variant: "default" | "destructive"): Promise<boolean> {
+  return requestConfirmDialog(question, { variant }) ?? Promise.resolve(window.confirm(question));
+}
+
+function QuickSettings({ now, close }: { now: Date; close: () => void }) {
+  const audio = useSystemService("audio");
+  const power = useSystemService("power");
+  const network = useSystemService("network");
+  const bluetooth = useSystemService("bluetooth");
+  const media = useSystemService("media");
+  const session = useSystemService("session");
+  const [expanded, setExpanded] = useState<"calendar" | "wifi" | "bluetooth" | null>(null);
+  const [error, setError] = useState("");
+  const setVolume = useLatestSender((volume) => audio.call("set-volume", { volume }));
+  const setBrightness = useLatestSender((brightness) =>
+    power.call("set-brightness", { brightness }),
+  );
+  const toggle = (what: "calendar" | "wifi" | "bluetooth") => (open: boolean) =>
+    setExpanded(open ? what : null);
+  const run = (label: string, promise: Promise<unknown>) =>
+    promise.catch((cause: unknown) =>
+      setError(`${label}: ${String((cause as Error)?.message ?? cause)}`),
+    );
+
+  const audioState = audio.state?.available ? audio.state : null;
+  const VolumeGlyph = !audioState
+    ? Volume2Icon
+    : audioState.muted || audioState.volume === 0
+      ? VolumeXIcon
+      : audioState.volume < 0.5
+        ? Volume1Icon
+        : Volume2Icon;
+  const networkState = network.state?.available ? network.state : null;
+  const bluetoothState =
+    bluetooth.state?.available && bluetooth.state.adapter ? bluetooth.state : null;
+  const connectedDevices = bluetoothState?.devices.filter((device) => device.connected) ?? [];
+  const player = media.state?.players.find((entry) => entry.id === media.state?.active) ?? null;
+  const battery = power.state?.battery ?? null;
+
+  return (
+    <div className="grid gap-3">
+      <button
+        type="button"
+        onClick={() => setExpanded(expanded === "calendar" ? null : "calendar")}
+        aria-expanded={expanded === "calendar"}
+        className="-mx-1 rounded-md px-1 text-left hover:bg-accent"
+      >
+        <div className="text-2xl font-medium tabular-nums">{timeFormat.format(now)}</div>
+        <div className="text-sm text-muted-foreground">{dateFormat.format(now)}</div>
+      </button>
+      {expanded === "calendar" ? (
+        <Calendar
+          mode="single"
+          selected={now}
+          defaultMonth={now}
+          className="-mx-1 [--cell-size:--spacing(8)]"
+        />
+      ) : null}
+
+      {audioState || power.state?.brightness.available ? (
+        <div className="grid gap-1">
+          {audioState ? (
+            <LevelRow
+              icon={<VolumeGlyph />}
+              iconLabel={audioState.muted ? "Unmute" : "Mute"}
+              onIconClick={() => void run("Mute", audio.call("set-mute", {}))}
+              label="Volume"
+              value={audioState.muted ? 0 : audioState.volume}
+              onChange={setVolume}
+            />
+          ) : null}
+          {audioState && audioState.outputs.length > 1 ? (
+            <select
+              aria-label="Output"
+              className="ml-9 h-7 min-w-0 rounded-md border border-input bg-background px-1.5 text-xs"
+              value={audioState.outputs.find((device) => device.default)?.id ?? ""}
+              onChange={(event) =>
+                void run(
+                  "Output",
+                  audio.call("set-default", { device: Number(event.currentTarget.value) }),
+                )
+              }
+            >
+              {audioState.outputs.map((device) => (
+                <option key={device.id} value={device.id}>
+                  {device.name}
+                </option>
+              ))}
+            </select>
+          ) : null}
+          {power.state?.brightness.available ? (
+            <LevelRow
+              icon={<SunIcon />}
+              label="Brightness"
+              value={power.state.brightness.value}
+              onChange={setBrightness}
+            />
+          ) : null}
+        </div>
+      ) : null}
+
+      {networkState || bluetoothState ? (
+        <div className="grid gap-1">
+          {networkState ? (
+            <>
+              <ToggleRow
+                icon={<NetworkGlyph network={networkState} />}
+                title={networkState.wifi.available ? "Wi-Fi" : "Network"}
+                detail={networkSummary(networkState)}
+                {...(networkState.wifi.available
+                  ? {
+                      checked: networkState.wifi.enabled,
+                      disabled: !networkState.wifi.hardwareEnabled,
+                      onCheckedChange: (enabled: boolean) =>
+                        void run("Wi-Fi", network.call("set-wifi", { enabled })),
+                    }
+                  : {})}
+                expanded={expanded === "wifi"}
+                onExpandedChange={toggle("wifi")}
+              />
+              {expanded === "wifi" ? <WifiList network={networkState} call={network.call} /> : null}
+            </>
+          ) : null}
+          {bluetoothState ? (
+            <>
+              <ToggleRow
+                icon={<BluetoothIcon />}
+                title="Bluetooth"
+                detail={
+                  !bluetoothState.adapter?.powered
+                    ? "Off"
+                    : connectedDevices.length
+                      ? connectedDevices.map((device) => device.name).join(", ")
+                      : "On"
+                }
+                checked={bluetoothState.adapter?.powered ?? false}
+                onCheckedChange={(powered) =>
+                  void run("Bluetooth", bluetooth.call("set-powered", { powered }))
+                }
+                expanded={expanded === "bluetooth"}
+                onExpandedChange={toggle("bluetooth")}
+              />
+              {expanded === "bluetooth" ? (
+                <div className="ml-9 grid gap-0.5">
+                  {bluetoothState.devices
+                    .filter((device) => device.paired)
+                    .map((device) => (
+                      <ListButton
+                        key={device.id}
+                        current={device.connected}
+                        onClick={() =>
+                          void run(
+                            device.name,
+                            bluetooth.call(device.connected ? "disconnect" : "connect", {
+                              device: device.id,
+                            }),
+                          )
+                        }
+                      >
+                        <span className="min-w-0 flex-1 truncate">{device.name}</span>
+                        {device.battery !== null ? (
+                          <span className="text-xs text-muted-foreground tabular-nums">
+                            {device.battery}%
+                          </span>
+                        ) : null}
+                      </ListButton>
+                    ))}
+                  {!bluetoothState.devices.some((device) => device.paired) ? (
+                    <div className="px-2 py-1 text-xs text-muted-foreground">
+                      No paired devices.
+                    </div>
+                  ) : null}
+                </div>
+              ) : null}
+            </>
+          ) : null}
+        </div>
+      ) : null}
+
+      {player ? (
+        <div className="flex items-center gap-2 rounded-md bg-muted/50 px-2 py-1.5">
+          <div className="min-w-0 flex-1">
+            <div className="truncate text-sm">{player.title || player.name}</div>
+            <div className="truncate text-xs text-muted-foreground">
+              {player.artist || player.name}
+            </div>
+          </div>
+          <IconAction
+            label="Previous"
+            disabled={!player.canGoPrevious}
+            onClick={() => void run("Previous", media.call("previous", { player: player.id }))}
+          >
+            <SkipBackIcon />
+          </IconAction>
+          <IconAction
+            label={player.status === "playing" ? "Pause" : "Play"}
+            onClick={() => void run("Play", media.call("play-pause", { player: player.id }))}
+          >
+            {player.status === "playing" ? <PauseIcon /> : <PlayIcon />}
+          </IconAction>
+          <IconAction
+            label="Next"
+            disabled={!player.canGoNext}
+            onClick={() => void run("Next", media.call("next", { player: player.id }))}
+          >
+            <SkipForwardIcon />
+          </IconAction>
+        </div>
+      ) : null}
+
+      {error ? <div className="text-xs text-destructive">{error}</div> : null}
+
+      <div className="flex items-center gap-1 border-t pt-2">
+        <div className="flex min-w-0 flex-1 items-center gap-1.5 text-xs text-muted-foreground">
+          {battery && power.state ? (
+            <>
+              <BatteryGlyph battery={battery} className="size-4 shrink-0" />
+              <span className="truncate">{batteryText(power.state, battery)}</span>
+            </>
+          ) : null}
+        </div>
+        {session.state ? (
+          <IconAction
+            label={session.state.problem ? `Lock: ${session.state.problem}` : "Lock"}
+            disabled={!session.state.canLock}
+            onClick={() => {
+              close();
+              void run("Lock", session.call("lock"));
+            }}
+          >
+            <LockIcon />
+          </IconAction>
+        ) : null}
+        {POWER_ACTIONS.map((entry) => {
+          const can = power.state?.can[entry.can] ?? "na";
+          if (can === "na") return null;
+          const Glyph = entry.icon;
+          return (
+            <IconAction
+              key={entry.action}
+              label={entry.label}
+              // "challenge" would ask for a password, which needs a polkit agent.
+              disabled={can === "no"}
+              onClick={() => {
+                close();
+                void confirm(
+                  entry.question,
+                  entry.action === "suspend" ? "default" : "destructive",
+                ).then((yes) => {
+                  if (yes) void run(entry.label, power.call(entry.action));
+                });
+              }}
+            >
+              <Glyph />
+            </IconAction>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
+
+const StatusCluster = memo(function StatusCluster() {
+  const now = useMinute();
+  const audio = useSystemService("audio");
+  const power = useSystemService("power");
+  const network = useSystemService("network");
+  const [open, setOpen] = useState(false);
+  const clusterRef = useRef<HTMLDivElement | null>(null);
+
+  useLayoutEffect(() => {
+    const element = clusterRef.current;
+    if (!element) return;
+    const root = document.documentElement;
+    const measure = () =>
+      root.style.setProperty(
+        STATUS_WIDTH_PROPERTY,
+        `${Math.ceil(element.getBoundingClientRect().width) + STATUS_GAP_PX}px`,
+      );
+    measure();
+    const stopObserving = observeResize(element, measure);
+    return () => {
+      stopObserving();
+      root.style.removeProperty(STATUS_WIDTH_PROPERTY);
+    };
+  }, []);
+
+  const battery = power.state?.battery ?? null;
+  // On AC the battery is of no interest, unless it's low and not charging (a weak charger).
+  const showBattery = battery !== null && (!power.state?.ac || batteryLow(battery));
+  const offline =
+    network.state?.available === true &&
+    (network.state.state === "offline" || network.state.state === "unknown");
+  const muted = audio.state?.available === true && audio.state.muted;
+
+  return (
+    <div
+      ref={clusterRef}
+      className="pointer-events-auto fixed top-[var(--workspace-controls-top)] right-[calc(env(safe-area-inset-right)+0.5rem)] z-50 flex h-[var(--workspace-topbar-height)] items-center [-webkit-app-region:no-drag]"
+      data-plutonium-status=""
+    >
+      <span aria-hidden className="mr-1 h-4 w-px bg-border" />
+      <Popover open={open} onOpenChange={setOpen}>
+        <PopoverTrigger
+          render={
+            <button
+              type="button"
+              aria-label={`${timeFormat.format(now)}, ${dateFormat.format(now)}. Quick settings`}
+              // A click doesn't take the keyboard from the app or tab that has it.
+              onMouseDown={(event) => event.preventDefault()}
+              className={cn(
+                "flex h-7 items-center gap-2 rounded-md px-2 text-sm font-medium text-foreground outline-hidden hover:bg-accent focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring [&_svg]:size-4 [&_svg]:shrink-0",
+                open && "bg-accent",
+              )}
+            />
+          }
+        >
+          {offline ? <WifiOffIcon className="text-muted-foreground" aria-label="Offline" /> : null}
+          {muted ? <VolumeXIcon className="text-muted-foreground" aria-label="Muted" /> : null}
+          {showBattery && battery ? (
+            <span className="flex items-center gap-1">
+              <BatteryGlyph battery={battery} />
+              <span
+                className={cn(
+                  "tabular-nums",
+                  batteryLow(battery) ? "text-destructive" : "text-muted-foreground",
+                )}
+              >
+                {battery.percent}%
+              </span>
+            </span>
+          ) : null}
+          <span className="tabular-nums">{timeFormat.format(now)}</span>
+        </PopoverTrigger>
+        <PopoverPopup side="bottom" align="end" width="md" finalFocus={false}>
+          <QuickSettings now={now} close={() => setOpen(false)} />
+        </PopoverPopup>
+      </Popover>
+    </div>
+  );
+});
+
+/** The status cluster; nothing outside the Plutonium shell. */
+export function PlutoniumStatus() {
+  if (!isPlutoniumShell()) return null;
+  return <StatusCluster />;
+}
