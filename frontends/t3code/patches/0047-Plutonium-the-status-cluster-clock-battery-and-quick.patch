+  EthernetPortIcon,
+  LockIcon,
+  LockKeyholeIcon,
+  LogOutIcon,
+  MoonIcon,
+  PauseIcon,
+  PlayIcon,
+  PowerIcon,
+  RotateCcwIcon,
+  SkipBackIcon,
+  SkipForwardIcon,
+  SunIcon,
+  Volume1Icon,
+  Volume2Icon,
+  VolumeXIcon,
+  WifiHighIcon,
+  WifiIcon,
+  WifiLowIcon,
+  WifiOffIcon,
+  WifiZeroIcon,
+} from "lucide-react";
