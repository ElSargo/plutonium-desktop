+        ? (response.result?.value ?? null)
+        : (response.result?.description ?? null);
+    });
+  }
+
+  waitFor(runtimeTabId: string, input: PreviewAutomationWaitForInput): Promise<void> {
+    const what =
+      input.locator ??
+      input.selector ??
+      (input.text ? `text ${JSON.stringify(input.text)}` : null) ??
+      (input.urlIncludes ? `URL containing ${JSON.stringify(input.urlIncludes)}` : "the page");
+    return this.track(runtimeTabId, `wait for ${what}`, async () => {
+      await this.until(input.timeoutMs ?? DEFAULT_TIMEOUT_MS, what, async () => {
+        if (input.urlIncludes) {
+          const url = this.target.tab(runtimeTabId)?.url ?? "";
+          if (!url.includes(input.urlIncludes)) return false;
+        }
+        if (input.locator || input.selector) {
+          const found = await this.isolated<boolean>(
+            runtimeTabId,
+            `__pa.found(...${JSON.stringify([input.selector, input.locator])})`,
+          );
+          if (!found) return false;
+        }
+        if (input.text) {
+          const found = await this.isolated<boolean>(
+            runtimeTabId,
+            `__pa.hasText(${JSON.stringify(input.text)})`,
+          );
+          if (!found) return false;
+        }
+        return true;
+      });
+    });
+  }
+}
diff --git a/apps/web/src/plutonium/previewBridge.ts b/apps/web/src/plutonium/previewBridge.ts
new file mode 100644
index 0000000000..9e519d9fd4
--- /dev/null
+++ b/apps/web/src/plutonium/previewBridge.ts
@@ -0,0 +1,356 @@
+// Plutonium: T3's browser on Plutonium's browser tabs.
+//
+// In the Electron build, `window.desktopBridge.preview` drives tabs owned by
+// the main process and shown with <webview>. In the Plutonium shell the
+// browser owns them instead: `navigator.windowBroker` creates and drives real
+// tabs (a WebContents each), and the page shows one with
+//   <embed type="application/x-chromium-surface-embed" data-content-id="…">
+// (PlutoniumBrowserHost). This file implements the DesktopPreviewBridge
+// contract on top of the broker, so the rest of the preview UI is unchanged.
+//
+// Tabs are tagged with their thread id, which is how Plutonium's helper lets
+// that thread's agent reach them. A tab's page can't open windows of its own:
+// like the Electron build, what it opens loads in the same tab.
+import type {
+  DesktopPreviewBridge,
+  DesktopPreviewNavStatus,
+  DesktopPreviewTabState,
+} from "@t3tools/contracts";
+
+import { PlutoniumAutomation } from "./previewAutomation";
+
+/** A tab as `navigator.windowBroker` reports it (BrowserTabEntry). */
+export interface BrokerTab {
+  readonly id: number;
+  readonly contentId: string;
+  readonly url: string;
+  readonly title: string;
+  readonly loading: boolean;
+  readonly canGoBack: boolean;
+  readonly canGoForward: boolean;
+  readonly embedded: boolean;
+  readonly focused: boolean;
+  readonly tag: string;
+  readonly openerId: number;
+  readonly openedBy: "shell" | "page";
+  readonly dialogType: "" | "alert" | "confirm" | "prompt" | "beforeunload";
+  readonly dialogMessage: string;
+  readonly dialogDefaultPrompt: string;
+}
+
+interface BrowserTabEvent extends Event {
+  readonly tabId: number;
+  readonly entry: BrokerTab | null;
+}
+
+interface TabBroker extends EventTarget {
+  getTabs(): Promise<BrokerTab[]>;
+  createTab(url: string, tag: string): Promise<BrokerTab>;
+  navigateTab(tabId: number, url: string): Promise<void>;
+  tabCommand(tabId: number, command: "back" | "forward" | "reload" | "stop" | "close"): void;
+  answerTabDialog(tabId: number, accept: boolean, text?: string): void;
+  snapshotTab(tabId: number): Promise<Blob>;
+  sendTabDevToolsCommand?(tabId: number, method: string, paramsJson?: string): Promise<string>;
+}
+
+function tabBroker(): TabBroker | null {
+  if (typeof navigator === "undefined") return null;
+  const broker = (navigator as Navigator & { windowBroker?: Partial<TabBroker> }).windowBroker;
+  return broker && typeof broker.createTab === "function" ? (broker as TabBroker) : null;
+}
+
+/** The thread id inside a previewRuntimeTabId ([environmentId, threadId, epoch, tabId]). */
+function threadOf(runtimeTabId: string): string {
+  try {
+    const parsed: unknown = JSON.parse(runtimeTabId);
+    if (Array.isArray(parsed) && typeof parsed[1] === "string") return parsed[1];
+  } catch {
+    // Not a runtime tab id; untagged.
+  }
+  return "";
+}
+
+export const isBlank = (url: string) => url === "" || url === "about:blank";
+
+// Which broker tab backs which preview tab. Tabs outlive a reload of the
+// shell page, so the reloaded page adopts them instead of opening new ones.
+const STORAGE_KEY = "t3code:plutonium-preview-tabs";
+
+function loadStoredIds(): Record<string, number> {
+  try {
+    const parsed: unknown = JSON.parse(sessionStorage.getItem(STORAGE_KEY) ?? "{}");
+    return parsed && typeof parsed === "object" ? (parsed as Record<string, number>) : {};
+  } catch {
+    return {};
+  }
+}
+
+class PlutoniumPreview {
+  readonly broker: TabBroker;
+  /** runtime tab id → broker tab id, and back. */
+  private readonly ids = new Map<string, number>();
+  private readonly runtimeIds = new Map<number, string>();
+  private readonly tabs = new Map<number, BrokerTab>();
+  /** Tabs a page opened that haven't got a URL yet: their opener's broker id. */
+  private readonly pendingPopups = new Map<number, number>();
+  private readonly stateListeners = new Set<
+    (tabId: string, state: DesktopPreviewTabState) => void
+  >();
+  private readonly tabListeners = new Set<() => void>();
+
+  constructor(broker: TabBroker) {
+    this.broker = broker;
+    const onTab = (event: Event) => {
+      const { entry } = event as BrowserTabEvent;
+      if (entry) this.update(entry);
+    };
+    broker.addEventListener("tabadded", onTab);
+    broker.addEventListener("tabchanged", onTab);
+    broker.addEventListener("tabremoved", (event) => {
+      const { tabId } = event as BrowserTabEvent;
+      this.tabs.delete(tabId);
+      this.pendingPopups.delete(tabId);
+      const runtimeTabId = this.runtimeIds.get(tabId);
+      if (runtimeTabId !== undefined) {
+        // The page closed itself (window.close()). The preview tab stays, idle.
+        this.runtimeIds.delete(tabId);
+        this.ids.delete(runtimeTabId);
+        this.storeIds();
+        this.emit(runtimeTabId, null);
+      }
+      this.notifyTabs();
+    });
+  }
+
+  private update(entry: BrokerTab): void {
+    this.tabs.set(entry.id, entry);
+    // What a preview's page opens loads in the preview itself.
+    const opener =
+      entry.openedBy === "page"
+        ? (this.pendingPopups.get(entry.id) ??
+          (this.runtimeIds.has(entry.openerId) ? entry.openerId : undefined))
+        : undefined;
+    if (opener !== undefined && !this.runtimeIds.has(entry.id)) {
+      if (isBlank(entry.url)) {
+        this.pendingPopups.set(entry.id, opener);
+      } else {
+        this.pendingPopups.delete(entry.id);
+        this.broker.tabCommand(entry.id, "close");
+        if (this.runtimeIds.has(opener)) void this.broker.navigateTab(opener, entry.url);
+      }
+      return;
+    }
+    const runtimeTabId = this.runtimeIds.get(entry.id);
+    if (runtimeTabId !== undefined) this.emit(runtimeTabId, entry);
+    this.notifyTabs();
+  }
+
+  private emit(runtimeTabId: string, entry: BrokerTab | null): void {
+    const state = toState(runtimeTabId, entry);
+    for (const listener of this.stateListeners) listener(runtimeTabId, state);
+  }
+
+  private notifyTabs(): void {
+    for (const listener of this.tabListeners) listener();
+  }
+
+  /** The broker tab behind a preview tab, once it exists. */
+  tab(runtimeTabId: string): BrokerTab | null {
+    const id = this.ids.get(runtimeTabId);
+    return id === undefined ? null : (this.tabs.get(id) ?? null);
+  }
+
+  /** Called whenever any preview tab's broker tab changes. */
+  onTabs(listener: () => void): () => void {
+    this.tabListeners.add(listener);
+    return () => this.tabListeners.delete(listener);
+  }
+
+  answerDialog(runtimeTabId: string, accept: boolean, text?: string): void {
+    const id = this.ids.get(runtimeTabId);
+    if (id !== undefined) this.broker.answerTabDialog(id, accept, text);
+  }
+
+  private require(runtimeTabId: string): number {
+    const id = this.ids.get(runtimeTabId);
+    if (id === undefined) throw new Error(`No browser tab for ${runtimeTabId}`);
+    return id;
+  }
+
+  private storeIds(): void {
+    try {
+      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(Object.fromEntries(this.ids)));
+    } catch {
+      // Not remembered: a reload opens a new tab.
+    }
+  }
+
+  async createTab(runtimeTabId: string): Promise<void> {
+    if (this.ids.has(runtimeTabId)) return;
+    const tag = threadOf(runtimeTabId);
+    const storedId = loadStoredIds()[runtimeTabId];
+    const adopted =
+      storedId === undefined
+        ? undefined
+        : (await this.broker.getTabs()).find((tab) => tab.id === storedId && tab.tag === tag);
+    if (this.ids.has(runtimeTabId)) return;
+    const entry = adopted ?? (await this.broker.createTab("about:blank", tag));
+    this.ids.set(runtimeTabId, entry.id);
+    this.runtimeIds.set(entry.id, runtimeTabId);
+    this.storeIds();
+    this.update(entry);
+  }
+
+  closeTab(runtimeTabId: string): void {
+    const id = this.ids.get(runtimeTabId);
+    if (id === undefined) return;
+    this.ids.delete(runtimeTabId);
+    this.runtimeIds.delete(id);
+    this.storeIds();
+    this.broker.tabCommand(id, "close");
+    this.notifyTabs();
+  }
+
+  async navigate(runtimeTabId: string, url: string): Promise<void> {
+    if (!this.ids.has(runtimeTabId)) await this.createTab(runtimeTabId);
+    await this.broker.navigateTab(this.require(runtimeTabId), url);
+  }
+
+  command(runtimeTabId: string, command: "back" | "forward" | "reload" | "stop"): void {
+    const id = this.ids.get(runtimeTabId);
+    if (id !== undefined) this.broker.tabCommand(id, command);
+  }
+
+  snapshot(runtimeTabId: string): Promise<Blob> {
+    return this.broker.snapshotTab(this.require(runtimeTabId));
+  }
+
+  /** Whether this Chromium lets the shell automate its tabs. */
+  get automatable(): boolean {
+    return typeof this.broker.sendTabDevToolsCommand === "function";
+  }
+
+  /** Sends a DevTools protocol command to the preview's tab. */
+  async devtools(runtimeTabId: string, method: string, params?: object): Promise<unknown> {
+    const send = this.broker.sendTabDevToolsCommand;
+    if (!send) throw new Error("This Chromium can't automate tabs");
+    const result = await send.call(
+      this.broker,
+      this.require(runtimeTabId),
+      method,
+      params ? JSON.stringify(params) : "",
+    );
+    return JSON.parse(result);
+  }
+
+  onStateChange(listener: (tabId: string, state: DesktopPreviewTabState) => void): () => void {
+    this.stateListeners.add(listener);
+    // Like the Electron bridge, a new listener learns the current state.
+    for (const [runtimeTabId, id] of this.ids) {
+      listener(runtimeTabId, toState(runtimeTabId, this.tabs.get(id) ?? null));
+    }
+    return () => this.stateListeners.delete(listener);
+  }
+}
+
+function toState(runtimeTabId: string, entry: BrokerTab | null): DesktopPreviewTabState {
+  const navStatus: DesktopPreviewNavStatus =
+    !entry || isBlank(entry.url)
+      ? { kind: "Idle" }
+      : { kind: entry.loading ? "Loading" : "Success", url: entry.url, title: entry.title };
+  return {
+    tabId: runtimeTabId,
+    webContentsId: entry ? entry.id : null,
+    navStatus,
+    canGoBack: entry?.canGoBack ?? false,
+    canGoForward: entry?.canGoForward ?? false,
+    zoomFactor: 1,
+    pictureInPicture: false,
+    colorScheme: "system",
+    audioMuted: false,
+    audible: false,
+    controller: "none",
+    updatedAt: new Date().toISOString(),
+  };
+}
+
+const unsupported = (what: string) => () =>
+  Promise.reject(new Error(`${what} is not available in the Plutonium browser yet`));
+const ignored = () => Promise.resolve();
+
+let preview: PlutoniumPreview | null | undefined;
+
+/** The Plutonium preview, or null outside the Plutonium shell. */
+export function plutoniumPreview(): PlutoniumPreview | null {
+  if (preview === undefined) {
+    const broker = tabBroker();
+    preview = broker ? new PlutoniumPreview(broker) : null;
+  }
+  return preview;
+}
+
+/** DesktopPreviewBridge on Plutonium's browser tabs, or null outside the shell. */
+export function createPlutoniumPreviewBridge(): DesktopPreviewBridge | null {
+  const p = plutoniumPreview();
+  if (!p) return null;
+  const auto = new PlutoniumAutomation(p);
+  const automation: DesktopPreviewBridge["automation"] = p.automatable
+    ? {
+        status: (tabId) => auto.status(tabId),
+        snapshot: (tabId) => auto.snapshot(tabId),
+        click: (tabId, input) => auto.click(tabId, input),
+        type: (tabId, input) => auto.type(tabId, input),
+        press: (tabId, input) => auto.press(tabId, input),
+        scroll: (tabId, input) => auto.scroll(tabId, input),
+        evaluate: (tabId, input) => auto.evaluate(tabId, input),
+        waitFor: (tabId, input) => auto.waitFor(tabId, input),
+      }
+    : {
+        status: unsupported("Browser automation"),
+        snapshot: unsupported("Browser automation"),
+        click: unsupported("Browser automation"),
+        type: unsupported("Browser automation"),
+        press: unsupported("Browser automation"),
+        scroll: unsupported("Browser automation"),
+        evaluate: unsupported("Browser automation"),
+        waitFor: unsupported("Browser automation"),
+      };
+  return {
+    createTab: (tabId) => p.createTab(tabId),
+    closeTab: async (tabId) => p.closeTab(tabId),
+    registerWebview: ignored,
+    navigate: (tabId, url) => p.navigate(tabId, url),
+    goBack: async (tabId) => p.command(tabId, "back"),
+    goForward: async (tabId) => p.command(tabId, "forward"),
+    refresh: async (tabId) => p.command(tabId, "reload"),
+    hardReload: async (tabId) => p.command(tabId, "reload"),
+    zoomIn: ignored,
+    zoomOut: ignored,
+    resetZoom: ignored,
+    setColorScheme: ignored,
+    setAudioMuted: ignored,
+    openDevTools: ignored,
+    clearCookies: ignored,
+    clearCache: ignored,
+    getPreviewConfig: async () => ({ partition: "", webPreferences: "", preloadUrl: null }),
+    listBrowserImportSources: async () => [],
+    importBrowserCookies: unsupported("Importing cookies"),
+    setAnnotationTheme: ignored,
+    pickElement: unsupported("Picking elements"),
+    cancelPickElement: ignored,
+    captureScreenshot: unsupported("Saving screenshots"),
+    revealArtifact: ignored,
+    copyArtifactToClipboard: ignored,
+    pictureInPicture: { open: ignored, close: ignored },
+    recording: {
+      onInput: () => () => undefined,
+      startScreencast: unsupported("Recording"),
+      stopScreencast: ignored,
+      save: unsupported("Recording"),
+      onFrame: () => () => undefined,
+    },
+    automation,
+    onStateChange: (listener) => p.onStateChange(listener),
+    onPointerEvent: () => () => undefined,
+  };
+}
