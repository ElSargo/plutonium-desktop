@@ -0,0 +1,817 @@
+// Plutonium: agent automation of T3's browser (DesktopPreviewBridge.automation)
+// on Plutonium's browser tabs.
+//
+// The Electron build drives its webviews with the DevTools protocol and
+// Playwright's injected script in the main process. Here the shell page sends
+// DevTools commands to its tabs itself (navigator.windowBroker
+// .sendTabDevToolsCommand: page domains only, shell document only). Element
+// lookup, snapshots and editability checks run in an isolated world, so the
+// page can't see or tamper with them; input is synthesized by the browser
+// (Input.dispatch*), as for a real user.
+//
+// Locators: CSS (also css=…), text=… (quoted: exact), role=…[name=…],
+// xpath=… or //…, id=…, data-testid=…, chained with >>, plus nth=<n> and the
+// :has-text("…") pseudo-class. That covers what snapshots hand out (CSS
+// paths) and the role/text forms agents write; it is not all of Playwright.
+import type {
+  DesktopPreviewAutomationStatus,
+  PreviewAutomationActionEvent,
+  PreviewAutomationClickInput,
+  PreviewAutomationEvaluateInput,
+  PreviewAutomationPressInput,
+  PreviewAutomationScrollInput,
+  PreviewAutomationSnapshot,
+  PreviewAutomationTypeInput,
+  PreviewAutomationWaitForInput,
+} from "@t3tools/contracts";
+
+/** What automation needs from the preview: the broker tab and DevTools. */
+export interface AutomationTarget {
+  tab(runtimeTabId: string): {
+    readonly url: string;
+    readonly title: string;
+    readonly loading: boolean;
+    readonly embedded: boolean;
+  } | null;
+  devtools(runtimeTabId: string, method: string, params?: object): Promise<unknown>;
+}
+
+const DEFAULT_TIMEOUT_MS = 15_000;
+const POLL_MS = 100;
+const MAX_ELEMENTS = 250;
+const MAX_TEXT = 20_000;
+const ISOLATED_WORLD = "plutonium-automation";
+
+// Runs in the page's isolated world: defines globalThis.__pa. Must not
+// reference anything outside itself.
+function pageHelpers() {
+  if ((globalThis as { __pa?: unknown }).__pa) return;
+  const visible = (el: Element) => {
+    const rect = el.getBoundingClientRect();
+    if (rect.width <= 0 || rect.height <= 0) return false;
+    const style = getComputedStyle(el);
+    return style.visibility !== "hidden" && style.display !== "none" && style.opacity !== "0";
+  };
+  const text = (el: Element) =>
+    ((el as HTMLElement).innerText ?? el.textContent ?? "").replace(/\s+/g, " ").trim();
+  const implicitRole = (el: Element): string | null => {
+    const tag = el.tagName.toLowerCase();
+    const type = (el.getAttribute("type") ?? "").toLowerCase();
+    switch (tag) {
+      case "a":
+      case "area":
+        return el.hasAttribute("href") ? "link" : null;
+      case "button":
+        return "button";
+      case "summary":
+        return "button";
+      case "select":
+        return (el as HTMLSelectElement).multiple ? "listbox" : "combobox";
+      case "textarea":
+        return "textbox";
+      case "option":
+        return "option";
+      case "img":
+        return el.getAttribute("alt") === "" ? "presentation" : "img";
+      case "nav":
+        return "navigation";
+      case "main":
+        return "main";
+      case "header":
+        return "banner";
+      case "footer":
+        return "contentinfo";
+      case "aside":
+        return "complementary";
+      case "form":
+        return "form";
+      case "dialog":
+        return "dialog";
+      case "ul":
+      case "ol":
+        return "list";
+      case "li":
+        return "listitem";
+      case "table":
+        return "table";
+      case "tr":
+        return "row";
+      case "td":
+        return "cell";
+      case "th":
+        return "columnheader";
+      case "progress":
+        return "progressbar";
+      case "h1":
+      case "h2":
+      case "h3":
+      case "h4":
+      case "h5":
+      case "h6":
+        return "heading";
+      case "input":
+        if (["button", "submit", "reset", "image"].includes(type)) return "button";
+        if (type === "checkbox") return "checkbox";
+        if (type === "radio") return "radio";
+        if (type === "range") return "slider";
+        if (type === "number") return "spinbutton";
+        if (type === "search") return "searchbox";
+        if (type === "hidden") return null;
+        return "textbox";
+    }
+    return null;
+  };
+  const role = (el: Element) => el.getAttribute("role")?.split(/\s+/)[0] || implicitRole(el);
+  const labelText = (el: Element): string => {
+    const labelledBy = el.getAttribute("aria-labelledby");
+    if (labelledBy) {
+      const parts = labelledBy
+        .split(/\s+/)
+        .map((id) => document.getElementById(id))
+        .filter((node): node is HTMLElement => node !== null)
+        .map(text);
+      if (parts.length) return parts.join(" ");
+    }
+    const aria = el.getAttribute("aria-label");
+    if (aria) return aria.trim();
+    if (
+      el instanceof HTMLInputElement ||
+      el instanceof HTMLTextAreaElement ||
+      el instanceof HTMLSelectElement
+    ) {
+      const labels = el.labels ? Array.from(el.labels).map(text).filter(Boolean) : [];
+      if (labels.length) return labels.join(" ");
+      if (el instanceof HTMLInputElement && ["button", "submit", "reset"].includes(el.type))
+        return el.value;
+      return el.getAttribute("placeholder") ?? el.getAttribute("title") ?? "";
+    }
+    if (el instanceof HTMLImageElement) return el.alt || el.title || "";
+    return text(el) || el.getAttribute("title") || "";
+  };
+  const cssEscape = (value: string) => CSS.escape(value);
+  const cssPath = (el: Element): string => {
+    if (el.id && document.querySelectorAll(`#${cssEscape(el.id)}`).length === 1)
+      return `#${cssEscape(el.id)}`;
+    const parts: string[] = [];
+    let node: Element | null = el;
+    while (node && node !== document.documentElement) {
+      const current: Element = node;
+      if (current.id && document.querySelectorAll(`#${cssEscape(current.id)}`).length === 1) {
+        parts.unshift(`#${cssEscape(current.id)}`);
+        break;
+      }
+      const tag = current.tagName.toLowerCase();
+      const parent: Element | null = current.parentElement;
+      const same = parent
+        ? Array.from(parent.children).filter((c) => c.tagName === current.tagName)
+        : [];
+      parts.unshift(same.length > 1 ? `${tag}:nth-of-type(${same.indexOf(current) + 1})` : tag);
+      node = parent;
+    }
+    return parts.join(" > ");
+  };
+  const unquote = (value: string): { text: string; exact: boolean } => {
+    const v = value.trim();
+    if ((v.startsWith('"') && v.endsWith('"')) || (v.startsWith("'") && v.endsWith("'"))) {
+      return { text: v.slice(1, -1), exact: true };
+    }
+    return { text: v, exact: false };
+  };
+  const matchesText = (actual: string, wanted: { text: string; exact: boolean }) =>
+    wanted.exact
+      ? actual === wanted.text
+      : actual.toLowerCase().includes(wanted.text.toLowerCase());
+  const all = (scope: ParentNode) => Array.from(scope.querySelectorAll("*"));
+  const byText = (scope: ParentNode, wanted: { text: string; exact: boolean }) => {
+    // The innermost elements whose text matches.
+    const hits = all(scope).filter((el) => matchesText(text(el), wanted));
+    return hits.filter((el) => !hits.some((other) => other !== el && el.contains(other)));
+  };
+  const byRole = (scope: ParentNode, spec: string) => {
+    const match = /^([a-z]+)\s*(.*)$/i.exec(spec.trim());
+    if (!match) throw new Error(`Bad role selector: ${spec}`);
+    const wantedRole = match[1]!.toLowerCase();
+    const attrs = match[2] ?? "";
+    let name: { text: string; exact: boolean } | null = null;
+    let nameRegex: RegExp | null = null;
+    const nameAttr = /\[\s*name\s*=\s*("([^"]*)"|'([^']*)'|\/(.*)\/([a-z]*))\s*([is])?\s*\]/.exec(
+      attrs,
+    );
+    if (nameAttr) {
+      if (nameAttr[4] !== undefined) nameRegex = new RegExp(nameAttr[4], nameAttr[5]);
+      else name = { text: nameAttr[2] ?? nameAttr[3] ?? "", exact: nameAttr[6] !== "i" };
+    }
+    const levelAttr = /\[\s*level\s*=\s*(\d+)\s*\]/.exec(attrs);
+    return all(scope).filter((el) => {
+      if (role(el) !== wantedRole) return false;
+      if (levelAttr && el.tagName.toLowerCase() !== `h${levelAttr[1]}`) return false;
+      const accessibleName = labelText(el).replace(/\s+/g, " ").trim();
+      if (nameRegex) return nameRegex.test(accessibleName);
+      if (name)
+        return name.exact ? accessibleName === name.text : matchesText(accessibleName, name);
+      return true;
+    });
+  };
+  const byCss = (scope: ParentNode, selector: string) => {
+    // :has-text("…") isn't CSS: filter on it afterwards.
+    const hasText: { text: string; exact: boolean }[] = [];
+    const css = selector.replace(/:has-text\(\s*("[^"]*"|'[^']*')\s*\)/g, (_m, quoted: string) => {
+      hasText.push({ text: quoted.slice(1, -1), exact: false });
+      return "";
+    });
+    let found = Array.from(scope.querySelectorAll(css || "*"));
+    for (const wanted of hasText) found = found.filter((el) => matchesText(text(el), wanted));
+    return found;
+  };
+  const byXpath = (scope: Node, path: string) => {
+    const result = document.evaluate(
+      path,
+      scope,
+      null,
+      XPathResult.ORDERED_NODE_SNAPSHOT_TYPE,
+      null,
+    );
+    const out: Element[] = [];
+    for (let i = 0; i < result.snapshotLength; i++) {
+      const node = result.snapshotItem(i);
+      if (node instanceof Element) out.push(node);
+    }
+    return out;
+  };
+  const step = (scopes: Element[] | null, part: string): Element[] => {
+    const roots: ParentNode[] = scopes ?? [document];
+    const nth = /^nth\s*=\s*(-?\d+)$/.exec(part);
+    if (nth) {
+      const list = scopes ?? [];
+      const i = Number(nth[1]);
+      const el = i < 0 ? list[list.length + i] : list[i];
+      return el ? [el] : [];
+    }
+    const eq = /^([a-z-]+)\s*=\s*([\s\S]*)$/i.exec(part);
+    const engine = eq && !part.startsWith("[") ? eq[1]!.toLowerCase() : null;
+    const body = engine ? eq![2]! : part;
+    const out: Element[] = [];
+    for (const root of roots) {
+      if (engine === "text") out.push(...byText(root, unquote(body)));
+      else if (engine === "role") out.push(...byRole(root, body));
+      else if (engine === "xpath") out.push(...byXpath(root as Node, body));
+      else if (engine === "id")
