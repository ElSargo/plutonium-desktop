+    });
+  }
+
+  type(runtimeTabId: string, input: PreviewAutomationTypeInput): Promise<void> {
+    const label = input.locator ?? input.selector ?? "the focused element";
+    return this.track(runtimeTabId, `type into ${label}`, async () => {
+      const args = JSON.stringify([input.selector, input.locator, input.clear ?? false]);
+      const focus = await this.until(input.timeoutMs ?? DEFAULT_TIMEOUT_MS, label, async () => {
