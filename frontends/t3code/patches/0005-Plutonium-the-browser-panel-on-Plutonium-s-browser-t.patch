+"use client";
+
+// Plutonium: ElectronBrowserHost's counterpart in the Plutonium shell. Each
+// open preview session gets a browser tab (previewBridge.ts) shown where the
+// right panel's browser surface is, with an <embed> instead of a <webview>.
+// The tab belongs to the browser: removing the <embed> only hides it, and the
+// next one shows it again.
+
+import { parseScopedThreadKey } from "@t3tools/client-runtime/environment";
+import {
+  FILL_PREVIEW_VIEWPORT,
+  type PreviewViewportSetting,
+  type ScopedThreadRef,
+} from "@t3tools/contracts";
+import {
+  createElement,
+  useCallback,
+  useEffect,
+  useMemo,
+  useState,
+  useSyncExternalStore,
+} from "react";
+import { useShallow } from "zustand/react/shallow";
+
+import {
+  resolveBrowserSurfacePanelRect,
+  useBrowserSurfaceStore,
+} from "~/browser/browserSurfaceStore";
+import { acquireDesktopTab } from "~/browser/desktopTabLifetime";
+import {
+  browserViewportSettingKey,
+  resolveBrowserViewportLayout,
+} from "~/browser/browserViewportLayout";
+import { previewRuntimeTabId } from "~/browser/previewRuntimeTabId";
+import { usePreviewBridge } from "~/components/preview/usePreviewBridge";
+import { useClientSettingsHydrated } from "~/hooks/useSettings";
+import { useActivePreviewSessions } from "~/previewStateStore";
+
+import { isBlank, plutoniumPreview, type BrokerTab } from "./previewBridge";
+
+export function PlutoniumBrowserHost() {
+  const previewByThreadKey = useActivePreviewSessions();
+  const sessions = useMemo(
+    () =>
+      Object.entries(previewByThreadKey).flatMap(([threadKey, previewState]) => {
+        const threadRef = parseScopedThreadKey(threadKey);
+        return threadRef
+          ? Object.values(previewState.sessions).map((snapshot) => ({
+              threadRef,
+              tabId: snapshot.tabId,
+              runtimeTabId: previewRuntimeTabId(
+                threadRef,
+                previewState.serverEpoch,
+                snapshot.tabId,
+              ),
+              url: snapshot.navStatus._tag === "Idle" ? null : snapshot.navStatus.url,
+              viewport: snapshot.viewport ?? FILL_PREVIEW_VIEWPORT,
+            }))
+          : [];
+      }),
+    [previewByThreadKey],
+  );
+  if (!plutoniumPreview()) return null;
+  return (
+    <div className="contents" data-plutonium-browser-host>
+      {sessions.map((session) => (
+        <PlutoniumBrowserTab key={session.runtimeTabId} {...session} />
+      ))}
+    </div>
+  );
+}
+
+/** The broker tab behind `runtimeTabId`, kept current. */
+function useBrokerTab(runtimeTabId: string): BrokerTab | null {
+  const preview = plutoniumPreview();
+  return useSyncExternalStore(
+    (onChange) => preview?.onTabs(onChange) ?? (() => undefined),
+    () => preview?.tab(runtimeTabId) ?? null,
+  );
+}
+
+function PlutoniumBrowserTab(props: {
+  readonly threadRef: ScopedThreadRef;
+  readonly tabId: string;
+  readonly runtimeTabId: string;
+  readonly url: string | null;
+  readonly viewport: PreviewViewportSetting;
+}) {
+  const { threadRef, tabId, runtimeTabId, url, viewport } = props;
+  const clientSettingsHydrated = useClientSettingsHydrated();
+  const [initialUrl] = useState(url);
+  const presentation = useBrowserSurfaceStore(
+    useShallow((state) => ({
+      rect: resolveBrowserSurfacePanelRect(state.byTabId, runtimeTabId),
+      visible: state.byTabId[runtimeTabId]?.visible ?? false,
+      zIndex: state.byTabId[runtimeTabId]?.zIndex ?? 30,
+      cornerRadius: state.byTabId[runtimeTabId]?.cornerRadius ?? 0,
+    })),
+  );
+  // Automation of a tab nobody is looking at (e.g. an agent's background tab)
+  // still needs it attached and painting.
+  const backgroundActivity = useBrowserSurfaceStore(
+    (state) => (state.activityByTabId[runtimeTabId] ?? 0) > 0,
+  );
+  const tab = useBrokerTab(runtimeTabId);
+  usePreviewBridge({ threadRef, tabId, runtimeTabId });
+
+  // The tab lives while the session does; the first URL is the session's.
+  useEffect(() => {
+    if (!clientSettingsHydrated) return;
+    const lease = acquireDesktopTab(runtimeTabId);
+    let disposed = false;
+    void lease.ready.then(() => {
+      // An adopted tab (after a reload of this page) already shows its page.
+      const current = plutoniumPreview()?.tab(runtimeTabId)?.url ?? "";
+      if (!disposed && initialUrl && isBlank(current)) {
+        void plutoniumPreview()?.navigate(runtimeTabId, initialUrl);
+      }
+    });
+    return () => {
+      disposed = true;
+      lease.release();
+    };
+  }, [clientSettingsHydrated, initialUrl, runtimeTabId]);
+
+  // Stands in for the Electron <webview>'s executeJavaScript, which the
+  // preview automation host uses to measure the page's viewport.
+  const embedRef = useCallback(
+    (node: HTMLElement | null) => {
+      if (!node) return;
+      Object.assign(node, {
+        executeJavaScript: async (code: string) => {
+          const response = (await plutoniumPreview()?.devtools(runtimeTabId, "Runtime.evaluate", {
+            expression: code,
+            returnByValue: true,
+            awaitPromise: true,
+          })) as { result?: { value?: unknown } } | undefined;
+          return response?.result?.value;
+        },
+      });
+    },
+    [runtimeTabId],
+  );
+
+  const active = presentation.visible && presentation.rect !== null;
+  if (!tab || (!active && !backgroundActivity)) return null;
+  // In the background: invisible, at the size it would be shown at.
+  const rect = active
+    ? presentation.rect!
+    : {
+        x: 0,
+        y: 0,
+        width: viewport._tag === "fill" ? 1280 : viewport.width,
+        height: viewport._tag === "fill" ? 800 : viewport.height,
+      };
+  // A fixed viewport (e.g. the 1280×800 agents open with) is laid out at its
+  // own size and scaled down to fit, as in the Electron build.
+  const layout = resolveBrowserViewportLayout(rect, viewport);
+  const cssWidth = Math.max(1, Math.round(layout.viewportWidth / layout.viewportScale));
+  const cssHeight = Math.max(1, Math.round(layout.viewportHeight / layout.viewportScale));
+  return (
+    <div
+      className={
+        layout.fillsPanel ? "fixed overflow-hidden bg-white" : "fixed overflow-hidden bg-muted/35"
+      }
+      style={{
+        left: rect.x,
+        top: rect.y,
+        width: rect.width,
+        height: rect.height,
+        zIndex: active ? presentation.zIndex : -1,
+        borderRadius: presentation.cornerRadius,
+        ...(active ? {} : { opacity: 0, pointerEvents: "none" as const }),
+      }}
+      aria-hidden={active ? undefined : true}
+      data-preview-viewport={runtimeTabId}
+      data-preview-rendering="active"
+    >
+      {createElement("embed", {
+        ref: embedRef,
+        type: "application/x-chromium-surface-embed",
+        "data-content-id": tab.contentId,
+        "data-preview-tab": runtimeTabId,
+        "data-preview-server-tab": tabId,
+        "data-preview-viewport-mode": viewport._tag,
+        "data-preview-viewport-key": browserViewportSettingKey(viewport),
+        "data-preview-css-width": cssWidth,
+        "data-preview-css-height": cssHeight,
+        className: "absolute block border-0 bg-white",
+        style: {
+          left: layout.viewportX,
+          top: layout.viewportY,
+          width: cssWidth,
+          height: cssHeight,
+          transform: layout.viewportScale < 1 ? `scale(${layout.viewportScale})` : undefined,
+          transformOrigin: "top left",
+        },
+      })}
+      {tab.dialogType ? <PageDialog runtimeTabId={runtimeTabId} tab={tab} /> : null}
+    </div>
+  );
+}
+
+/** The page's alert/confirm/prompt, drawn over it (the browser shows none). */
+function PageDialog({ runtimeTabId, tab }: { runtimeTabId: string; tab: BrokerTab }) {
+  const [text, setText] = useState(tab.dialogDefaultPrompt);
+  const answer = (accept: boolean) =>
+    plutoniumPreview()?.answerDialog(runtimeTabId, accept, tab.dialogType === "prompt" ? text : "");
+  let origin = "";
+  try {
+    origin = new URL(tab.url).host;
+  } catch {
+    // No origin to show.
+  }
+  return (
+    <div className="absolute inset-0 flex items-start justify-center bg-black/20 p-4 pt-6">
+      <form
+        className="grid w-full max-w-md gap-3 rounded-lg border bg-popover p-4 text-popover-foreground shadow-lg"
+        onSubmit={(event) => {
+          event.preventDefault();
+          answer(true);
+        }}
+      >
+        <div className="text-xs text-muted-foreground">
+          {tab.dialogType === "beforeunload"
+            ? "Leave this page? Changes you made may not be saved."
+            : `${origin || "This page"} says`}
+        </div>
+        {tab.dialogType === "beforeunload" ? null : (
+          <div className="whitespace-pre-wrap text-sm">{tab.dialogMessage}</div>
+        )}
+        {tab.dialogType === "prompt" ? (
+          <input
+            className="rounded-md border bg-background px-2 py-1 text-sm"
+            value={text}
+            onChange={(event) => setText(event.target.value)}
+            autoFocus
+          />
+        ) : null}
+        <div className="flex justify-end gap-2">
+          {tab.dialogType === "alert" ? null : (
+            <button
+              type="button"
+              className="rounded-md border px-3 py-1 text-sm"
+              onClick={() => answer(false)}
+            >
+              Cancel
+            </button>
+          )}
+          <button
+            type="submit"
+            className="rounded-md bg-primary px-3 py-1 text-sm text-primary-foreground"
+            autoFocus={tab.dialogType !== "prompt"}
+          >
+            {tab.dialogType === "beforeunload" ? "Leave" : "OK"}
+          </button>
+        </div>
+      </form>
+    </div>
+  );
+}
