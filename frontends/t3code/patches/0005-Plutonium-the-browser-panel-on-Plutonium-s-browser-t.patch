+      target.scrollIntoView({ block: "center", behavior: "instant" as ScrollBehavior });
+      target.focus();
+      if (clear) {
+        if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)
+          target.select();
+        else {
+          const range = document.createRange();
+          range.selectNodeContents(target);
+          const selection = getSelection();
+          selection?.removeAllRanges();
+          selection?.addRange(range);
+        }
+      } else if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) {
+        const end = target.value.length;
+        try {
+          target.setSelectionRange(end, end);
+        } catch {
+          // Some input types have no selection.
+        }
+      }
+      return {
+        ok: true,
+        clearing: clear && ((target as HTMLInputElement).value ?? target.textContent ?? "") !== "",
+      };
+    },
+    scrollElement(
+      selector: string | undefined,
+      locator: string | undefined,
+      dx: number,
+      dy: number,
+    ) {
+      const el = resolve(selector, locator);
+      if (!el) return false;
+      el.scrollBy({ left: dx, top: dy, behavior: "instant" as ScrollBehavior });
+      return true;
+    },
+    hasText(wanted: string) {
+      return (document.body?.innerText ?? "").includes(wanted);
+    },
+    snapshot() {
+      const elements = Array.from(document.querySelectorAll(INTERACTIVE))
+        .filter(visible)
+        .slice(0, 250)
+        .map((el) => {
+          const rect = el.getBoundingClientRect();
+          return {
+            tag: el.tagName.toLowerCase(),
+            role: role(el),
+            name: labelText(el).replace(/\s+/g, " ").trim().slice(0, 120),
+            selector: cssPath(el),
+            x: Math.round(rect.left),
+            y: Math.round(rect.top),
+            width: Math.round(rect.width),
+            height: Math.round(rect.height),
+          };
+        });
+      // A compact outline: landmarks, headings and controls in document order.
+      const outline: string[] = [];
+      for (const el of Array.from(document.querySelectorAll(`${STRUCTURE},${INTERACTIVE}`))) {
+        if (!visible(el) || outline.length >= 400) continue;
+        const r = role(el);
+        if (!r || r === "presentation" || r === "none") continue;
+        const name = labelText(el).replace(/\s+/g, " ").trim().slice(0, 80);
+        const level = /^h([1-6])$/i.exec(el.tagName)?.[1];
+        let state = "";
+        if (el instanceof HTMLInputElement && (el.type === "checkbox" || el.type === "radio"))
+          state = el.checked ? " [checked]" : "";
+        if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement)
+          state += el.value ? ` value=${JSON.stringify(el.value.slice(0, 60))}` : "";
+        if (el === document.activeElement) state += " [focused]";
+        outline.push(
+          `- ${r}${name ? ` ${JSON.stringify(name)}` : ""}${level ? ` [level=${level}]` : ""}${state}`,
+        );
+      }
+      return {
+        url: location.href,
+        title: document.title,
+        visibleText: (document.body?.innerText ?? "").slice(0, 20000),
+        interactiveElements: elements,
+        outline: outline.join("\n"),
+        width: innerWidth,
+        height: innerHeight,
+      };
+    },
+  };
+}
+
+const KEYS: Record<string, { code: string; keyCode: number; text?: string }> = {
+  Enter: { code: "Enter", keyCode: 13, text: "\r" },
+  Tab: { code: "Tab", keyCode: 9 },
+  Escape: { code: "Escape", keyCode: 27 },
+  Backspace: { code: "Backspace", keyCode: 8 },
+  Delete: { code: "Delete", keyCode: 46 },
+  ArrowUp: { code: "ArrowUp", keyCode: 38 },
+  ArrowDown: { code: "ArrowDown", keyCode: 40 },
+  ArrowLeft: { code: "ArrowLeft", keyCode: 37 },
+  ArrowRight: { code: "ArrowRight", keyCode: 39 },
+  Home: { code: "Home", keyCode: 36 },
+  End: { code: "End", keyCode: 35 },
+  PageUp: { code: "PageUp", keyCode: 33 },
+  PageDown: { code: "PageDown", keyCode: 34 },
+  Space: { code: "Space", keyCode: 32, text: " " },
+  " ": { code: "Space", keyCode: 32, text: " " },
+  Insert: { code: "Insert", keyCode: 45 },
+};
+for (let i = 1; i <= 12; i++) KEYS[`F${i}`] = { code: `F${i}`, keyCode: 111 + i };
+const MODIFIER_BITS = { Alt: 1, Control: 2, Meta: 4, Shift: 8 } as const;
+
+function keyInfo(key: string): { key: string; code: string; keyCode: number; text?: string } {
+  const known = KEYS[key];
+  if (known) return { key: key === "Space" ? " " : key, ...known };
+  if (key.length === 1) {
+    const upper = key.toUpperCase();
+    const isLetter = upper >= "A" && upper <= "Z";
+    const isDigit = key >= "0" && key <= "9";
+    return {
+      key,
+      code: isLetter ? `Key${upper}` : isDigit ? `Digit${key}` : "",
+      keyCode: isLetter || isDigit ? upper.charCodeAt(0) : 0,
+      text: key,
+    };
+  }
+  throw new Error(`Unknown key: ${key}`);
+}
+
+/** A failure that waiting longer won't fix. */
+class AutomationFailure extends Error {}
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+interface RuntimeEvaluateResult {
+  result?: { value?: unknown; description?: string; type?: string };
+  exceptionDetails?: { text?: string; exception?: { description?: string } };
+}
+
+export class PlutoniumAutomation {
+  private readonly timelines = new Map<string, PreviewAutomationActionEvent[]>();
+  private nextActionId = 1;
+
+  constructor(private readonly target: AutomationTarget) {}
+
+  private cdp<T>(runtimeTabId: string, method: string, params?: object): Promise<T> {
+    return this.target.devtools(runtimeTabId, method, params) as Promise<T>;
+  }
+
+  /** Evaluates |expression| in an isolated world of the main frame, helpers loaded. */
+  private async isolated<T>(runtimeTabId: string, expression: string): Promise<T> {
+    const tree = await this.cdp<{ frameTree: { frame: { id: string } } }>(
+      runtimeTabId,
+      "Page.getFrameTree",
+    );
+    const world = await this.cdp<{ executionContextId: number }>(
+      runtimeTabId,
+      "Page.createIsolatedWorld",
+      {
+        frameId: tree.frameTree.frame.id,
+        worldName: ISOLATED_WORLD,
+      },
+    );
+    const response = await this.cdp<RuntimeEvaluateResult>(runtimeTabId, "Runtime.evaluate", {
+      expression: `(${pageHelpers.toString()})(); ${expression}`,
+      contextId: world.executionContextId,
+      returnByValue: true,
+      awaitPromise: true,
+    });
+    if (response.exceptionDetails) {
+      throw new Error(
+        response.exceptionDetails.exception?.description ??
+          response.exceptionDetails.text ??
+          "Script failed",
+      );
+    }
+    return response.result?.value as T;
+  }
+
+  private async track<T>(runtimeTabId: string, action: string, run: () => Promise<T>): Promise<T> {
+    const timeline = this.timelines.get(runtimeTabId) ?? [];
+    this.timelines.set(runtimeTabId, timeline);
+    const event: PreviewAutomationActionEvent = {
+      id: `plutonium-${this.nextActionId++}`,
+      action,
+      status: "running",
+      startedAt: new Date().toISOString(),
+    };
+    timeline.push(event);
+    if (timeline.length > 50) timeline.shift();
+    const finish = (status: "succeeded" | "failed", error?: string) => {
+      const index = timeline.indexOf(event);
+      const done: PreviewAutomationActionEvent = {
+        ...event,
+        status,
+        completedAt: new Date().toISOString(),
+        ...(error ? { error } : {}),
+      };
+      if (index >= 0) timeline[index] = done;
+    };
+    try {
+      const result = await run();
+      finish("succeeded");
+      return result;
+    } catch (error) {
+      finish("failed", error instanceof Error ? error.message : String(error));
+      throw error;
+    }
+  }
+
+  /** Polls |check| until it returns a value or |timeoutMs| passes. */
+  private async until<T>(
+    timeoutMs: number,
+    what: string,
+    check: () => Promise<T | null | false>,
+  ): Promise<T> {
+    const deadline = Date.now() + timeoutMs;
+    let lastError: unknown = null;
+    for (;;) {
+      try {
+        const value = await check();
+        if (value) return value;
+      } catch (error) {
+        if (error instanceof AutomationFailure) throw error;
+        // Navigations destroy contexts mid-poll; retry until the deadline.
+        lastError = error;
+      }
+      if (Date.now() >= deadline) {
+        const detail = lastError instanceof Error ? ` (${lastError.message})` : "";
+        throw new Error(`Timed out after ${timeoutMs}ms waiting for ${what}${detail}`);
+      }
+      await sleep(POLL_MS);
+    }
+  }
+
+  async status(runtimeTabId: string): Promise<DesktopPreviewAutomationStatus> {
+    const tab = this.target.tab(runtimeTabId);
+    const blank = !tab || tab.url === "" || tab.url === "about:blank";
+    let viewport: { width: number; height: number } | undefined;
+    if (tab) {
+      try {
+        const size = await this.cdp<RuntimeEvaluateResult>(runtimeTabId, "Runtime.evaluate", {
+          expression: "({ width: innerWidth, height: innerHeight })",
+          returnByValue: true,
+        });
+        const value = size.result?.value as { width: number; height: number } | undefined;
+        if (value && value.width > 0 && value.height > 0) viewport = value;
+      } catch {
+        // No viewport yet.
+      }
+    }
+    return {
+      available: !!tab,
+      visible: tab?.embedded ?? false,
+      tabId: tab ? runtimeTabId : null,
+      url: blank ? null : tab!.url,
+      title: blank ? null : tab!.title,
+      loading: tab?.loading ?? false,
+      ...(viewport ? { viewport } : {}),
+    };
+  }
+
+  snapshot(runtimeTabId: string): Promise<PreviewAutomationSnapshot> {
+    return this.track(runtimeTabId, "snapshot", async () => {
+      const page = await this.isolated<{
+        url: string;
+        title: string;
+        visibleText: string;
+        interactiveElements: PreviewAutomationSnapshot["interactiveElements"];
+        outline: string;
+        width: number;
+        height: number;
+      }>(runtimeTabId, "__pa.snapshot()");
+      const shot = await this.cdp<{ data: string }>(runtimeTabId, "Page.captureScreenshot", {
+        format: "png",
+      });
