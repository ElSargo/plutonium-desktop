+    if (selector) return Array.from(document.querySelectorAll(selector));
+    if (!locator) return [];
+    let scopes: Element[] | null = null;
+    for (const part of locator.split(/\s*>>\s*/)) scopes = step(scopes, part.trim());
+    return scopes ?? [];
+  };
+  const resolve = (selector?: string, locator?: string) => {
+    const found = resolveAll(selector, locator);
+    return found.find(visible) ?? found[0] ?? null;
+  };
+  const editable = (el: Element | null) =>
+    !!el &&
+    ((el instanceof HTMLInputElement &&
+      ![
+        "button",
+        "submit",
+        "reset",
+        "checkbox",
+        "radio",
+        "range",
+        "color",
+        "file",
+        "image",
+        "hidden",
+      ].includes(el.type) &&
+      !el.disabled &&
+      !el.readOnly) ||
+      (el instanceof HTMLTextAreaElement && !el.disabled && !el.readOnly) ||
+      (el as HTMLElement).isContentEditable);
+  const INTERACTIVE =
+    'a[href],button,input:not([type="hidden"]),select,textarea,summary,[role],[onclick],[contenteditable=""],[contenteditable="true"],[tabindex]:not([tabindex="-1"])';
