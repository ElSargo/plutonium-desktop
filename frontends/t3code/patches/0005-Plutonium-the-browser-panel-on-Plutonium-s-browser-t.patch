+        expression: "devicePixelRatio",
+        returnByValue: true,
+      });
+      const scale = Number(dpr.result?.value) || 1;
+      return {
+        url: page.url,
+        title: page.title,
+        loading: this.target.tab(runtimeTabId)?.loading ?? false,
+        visibleText: page.visibleText.slice(0, MAX_TEXT),
+        interactiveElements: page.interactiveElements.slice(0, MAX_ELEMENTS),
+        accessibilityTree: page.outline,
+        consoleEntries: [],
+        networkEntries: [],
+        actionTimeline: [...(this.timelines.get(runtimeTabId) ?? [])],
+        screenshot: {
+          mimeType: "image/png",
+          data: shot.data,
+          width: Math.round(page.width * scale),
+          height: Math.round(page.height * scale),
+        },
+      };
+    });
+  }
+
+  private async mouseClick(runtimeTabId: string, x: number, y: number): Promise<void> {
+    const base = { x, y, button: "left", pointerType: "mouse" };
+    await this.cdp(runtimeTabId, "Input.dispatchMouseEvent", {
+      ...base,
+      type: "mouseMoved",
+      button: "none",
+    });
+    await this.cdp(runtimeTabId, "Input.dispatchMouseEvent", {
+      ...base,
+      type: "mousePressed",
+      buttons: 1,
+      clickCount: 1,
+    });
+    await this.cdp(runtimeTabId, "Input.dispatchMouseEvent", {
+      ...base,
+      type: "mouseReleased",
+      buttons: 0,
+      clickCount: 1,
+    });
+  }
+
+  click(runtimeTabId: string, input: PreviewAutomationClickInput): Promise<void> {
+    const label = input.locator ?? input.selector ?? `${input.x},${input.y}`;
+    return this.track(runtimeTabId, `click ${label}`, async () => {
+      if (input.x !== undefined && input.y !== undefined && !input.locator && !input.selector) {
+        await this.mouseClick(runtimeTabId, input.x, input.y);
+        return;
+      }
+      const args = JSON.stringify([input.selector, input.locator]);
+      const point = await this.until(input.timeoutMs ?? DEFAULT_TIMEOUT_MS, label, async () => {
+        const found = await this.isolated<{
+          x: number;
+          y: number;
+          visible: boolean;
+          covered: string | null;
+        } | null>(runtimeTabId, `__pa.point(...${args})`);
