+import { describe, expect, it } from "vite-plus/test";
+
+import { decodePng, encodePng, shrink, shrinkPng } from "./pngScale.ts";
+
+const image = (width: number, height: number, pixel: (x: number, y: number) => number[]) => {
+  const pixels = new Uint8Array(width * height * 4);
+  for (let y = 0; y < height; y++)
+    for (let x = 0; x < width; x++) pixels.set(pixel(x, y), (y * width + x) * 4);
+  return { width, height, pixels };
+};
+
+describe("pngScale", () => {
+  it("reads back what it writes", () => {
+    const source = image(7, 5, (x, y) => [x * 30, y * 50, (x * y) % 256, 255 - x]);
+    const decoded = decodePng(encodePng(source));
+    expect(decoded?.width).toBe(7);
+    expect(decoded?.height).toBe(5);
+    expect([...decoded!.pixels]).toEqual([...source.pixels]);
+  });
+
+  it("averages the area each pixel covers", () => {
+    // Black and white columns shrink to grey; whole rows keep their colour.
+    const source = image(4, 2, (x, y) =>
+      y === 0 ? [x % 2 ? 255 : 0, 0, 0, 255] : [0, 0, 200, 255],
+    );
+    const out = shrink(source, 2, 2);
+    expect([...out.pixels]).toEqual([
+      128, 0, 0, 255, 128, 0, 0, 255, 0, 0, 200, 255, 0, 0, 200, 255,
+    ]);
+  });
+
+  it("shrinks by a ratio that isn't whole, as a 1.78 screen needs", () => {
+    const source = image(178, 89, () => [10, 20, 30, 255]);
+    const png = shrinkPng(encodePng(source).toString("base64"), 100, 50);
+    const out = decodePng(Buffer.from(png!, "base64"))!;
+    expect([out.width, out.height]).toEqual([100, 50]);
+    expect([...out.pixels.slice(0, 4)]).toEqual([10, 20, 30, 255]);
+    expect([...out.pixels.slice(-4)]).toEqual([10, 20, 30, 255]);
+  });
+
+  it("leaves what it can't read", () => {
+    expect(shrinkPng(Buffer.from("not a png").toString("base64"), 1, 1)).toBeNull();
+  });
+});
