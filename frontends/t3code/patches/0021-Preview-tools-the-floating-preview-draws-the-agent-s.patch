--- /dev/null
+++ b/apps/server/src/preview/pngScale.ts
@@ -0,0 +1,176 @@
+import { deflateSync, inflateSync } from "node:zlib";
+
+// Shrinks a PNG on the server. Asking Chromium for a scaled capture makes it
+// emulate other device metrics for a moment, which a page on screen shows.
+
+const SIGNATURE = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]);
+
+interface Rgba {
+  readonly width: number;
+  readonly height: number;
+  readonly pixels: Uint8Array;
+}
+
+const CRC_TABLE = (() => {
+  const table = new Uint32Array(256);
+  for (let n = 0; n < 256; n++) {
+    let c = n;
+    for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
+    table[n] = c >>> 0;
+  }
+  return table;
+})();
+
+const crc32 = (bytes: Uint8Array) => {
+  let crc = 0xffffffff;
+  for (const byte of bytes) crc = CRC_TABLE[(crc ^ byte) & 0xff]! ^ (crc >>> 8);
+  return (crc ^ 0xffffffff) >>> 0;
+};
+
+/** 8-bit RGB or RGBA, not interlaced, as Chromium writes them; else null. */
+export const decodePng = (png: Buffer): Rgba | null => {
+  if (png.length < 33 || !png.subarray(0, 8).equals(SIGNATURE)) return null;
+  let width = 0;
+  let height = 0;
+  let channels = 0;
+  const data: Buffer[] = [];
+  for (let offset = 8; offset + 12 <= png.length;) {
+    const length = png.readUInt32BE(offset);
+    const type = png.toString("ascii", offset + 4, offset + 8);
+    const body = png.subarray(offset + 8, offset + 8 + length);
+    if (type === "IHDR") {
+      width = body.readUInt32BE(0);
+      height = body.readUInt32BE(4);
+      const [depth, colorType, , , interlace] = body.subarray(8, 13);
+      if (depth !== 8 || interlace !== 0) return null;
+      channels = colorType === 6 ? 4 : colorType === 2 ? 3 : 0;
+      if (channels === 0) return null;
+    } else if (type === "IDAT") {
+      data.push(body);
+    } else if (type === "IEND") {
+      break;
+    }
+    offset += 12 + length;
+  }
+  if (width === 0 || height === 0) return null;
+  const raw = inflateSync(Buffer.concat(data));
+  const stride = width * channels;
+  if (raw.length < (stride + 1) * height) return null;
+  const rows = new Uint8Array(stride * height);
+  for (let y = 0; y < height; y++) {
+    const filter = raw[y * (stride + 1)]!;
+    const source = y * (stride + 1) + 1;
+    const row = y * stride;
+    for (let i = 0; i < stride; i++) {
+      const left = i >= channels ? rows[row + i - channels]! : 0;
+      const up = y > 0 ? rows[row - stride + i]! : 0;
+      const upLeft = y > 0 && i >= channels ? rows[row - stride + i - channels]! : 0;
+      let predicted = 0;
+      if (filter === 1) predicted = left;
+      else if (filter === 2) predicted = up;
+      else if (filter === 3) predicted = (left + up) >> 1;
+      else if (filter === 4) {
+        const p = left + up - upLeft;
+        const pa = Math.abs(p - left);
+        const pb = Math.abs(p - up);
+        const pc = Math.abs(p - upLeft);
+        predicted = pa <= pb && pa <= pc ? left : pb <= pc ? up : upLeft;
+      }
+      rows[row + i] = (raw[source + i]! + predicted) & 0xff;
+    }
+  }
+  if (channels === 4) return { width, height, pixels: rows };
+  const pixels = new Uint8Array(width * height * 4);
+  for (let p = 0, q = 0; p < rows.length; p += 3, q += 4) {
+    pixels[q] = rows[p]!;
+    pixels[q + 1] = rows[p + 1]!;
+    pixels[q + 2] = rows[p + 2]!;
+    pixels[q + 3] = 255;
+  }
+  return { width, height, pixels };
+};
+
+const chunk = (type: string, body: Uint8Array) => {
+  const out = Buffer.alloc(12 + body.length);
+  out.writeUInt32BE(body.length, 0);
+  out.write(type, 4, "ascii");
+  out.set(body, 8);
+  out.writeUInt32BE(crc32(out.subarray(4, 8 + body.length)), 8 + body.length);
+  return out;
+};
+
+export const encodePng = (image: Rgba): Buffer => {
+  const stride = image.width * 4;
+  // Each row filtered against the one above, which suits screenshots.
+  const raw = Buffer.alloc((stride + 1) * image.height);
+  for (let y = 0; y < image.height; y++) {
+    const row = y * stride;
+    const out = y * (stride + 1);
+    raw[out] = 2;
+    for (let i = 0; i < stride; i++) {
+      raw[out + 1 + i] = image.pixels[row + i]! - (y > 0 ? image.pixels[row - stride + i]! : 0);
+    }
+  }
+  const header = Buffer.alloc(13);
+  header.writeUInt32BE(image.width, 0);
+  header.writeUInt32BE(image.height, 4);
+  header.set([8, 6, 0, 0, 0], 8);
+  return Buffer.concat([
+    SIGNATURE,
+    chunk("IHDR", header),
+    chunk("IDAT", deflateSync(raw, { level: 6 })),
+    chunk("IEND", new Uint8Array()),
+  ]);
+};
+
+/** Which source pixels make up each output pixel along one axis, and how much. */
+const contributions = (from: number, to: number) => {
+  const ratio = from / to;
+  return Array.from({ length: to }, (_, index) => {
+    const start = index * ratio;
+    const end = Math.min(from, start + ratio);
+    const taps: Array<{ readonly at: number; readonly weight: number }> = [];
+    for (let at = Math.floor(start); at < end; at++) {
+      const weight = Math.min(end, at + 1) - Math.max(start, at);
+      if (weight > 0) taps.push({ at, weight: weight / (end - start) });
+    }
+    return taps;
+  });
+};
+
+/** Each output pixel is the average of the area it covers. Only shrinks. */
+export const shrink = (image: Rgba, width: number, height: number): Rgba => {
+  const columns = contributions(image.width, width);
+  const rowsOf = contributions(image.height, height);
+  // Across first, into floats, then down.
+  const across = new Float32Array(width * image.height * 4);
+  for (let y = 0; y < image.height; y++) {
+    for (let x = 0; x < width; x++) {
+      const out = (y * width + x) * 4;
+      for (const { at, weight } of columns[x]!) {
+        const source = (y * image.width + at) * 4;
+        for (let c = 0; c < 4; c++) across[out + c]! += image.pixels[source + c]! * weight;
+      }
+    }
+  }
+  const down = new Float32Array(width * height * 4);
+  for (let y = 0; y < height; y++) {
+    const out = y * width * 4;
+    for (const { at, weight } of rowsOf[y]!) {
+      const source = at * width * 4;
+      for (let i = 0; i < width * 4; i++) down[out + i]! += across[source + i]! * weight;
+    }
+  }
+  const pixels = new Uint8Array(width * height * 4);
+  for (let i = 0; i < down.length; i++) pixels[i] = Math.round(down[i]!);
+  return { width, height, pixels };
+};
+
+/** The PNG at `width`×`height`, or null when it can't be read. */
+export const shrinkPng = (base64: string, width: number, height: number): string | null => {
+  const image = decodePng(Buffer.from(base64, "base64"));
+  if (!image) return null;
+  if (image.width === width && image.height === height) return base64;
+  if (width > image.width || height > image.height) return null;
+  return encodePng(shrink(image, width, height)).toString("base64");
+};
