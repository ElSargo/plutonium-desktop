From: Oliver Sargison <sargo@sargo.cc>
Date: Sat, 24 Oct 2026 17:00:28 +1300
Subject: [PATCH 23/31] Plutonium: read_window on big tables and apps that
 don't answer; launch_app waits for windows to settle

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/server/src/plutonium/windowTools.ts | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/apps/server/src/plutonium/windowTools.ts b/apps/server/src/plutonium/windowTools.ts
index 47022c24c1..c08862a295 100644
--- a/apps/server/src/plutonium/windowTools.ts
+++ b/apps/server/src/plutonium/windowTools.ts
@@ -110,7 +110,7 @@ const FindAppsTool = Tool.make("find_apps", {
 
 const LaunchAppTool = windowTool(
   "launch_app",
-  "Start a native desktop (GUI) app, such as LibreOffice, GIMP, Inkscape, a terminal or a file manager, as part of this thread, and wait for its window. find_apps gives an installed app's argv. Drive it with snapshot_window, click_window, type_window and press_window, even while the user is doing something else. The app runs detached from your shell. Its windows wait in the thread for the user unless focus is true. They keep the size you give (width and height) or the one the app picks: the user sees them scaled to fit, and that you're working in them, until they take control. Returns the new windows (empty if none appeared in time).",
+  "Start a native desktop (GUI) app, such as LibreOffice, GIMP, Inkscape, a terminal or a file manager, as part of this thread, and wait for its window. find_apps gives an installed app's argv. Drive it with snapshot_window, click_window, type_window and press_window, even while the user is doing something else. The app runs detached from your shell. Its windows wait in the thread for the user unless focus is true. They keep the size you give (width and height) or the one the app picks: the user sees them scaled to fit, and that you're working in them, until they take control. Returns the new windows open once they've stopped changing (a splash screen or a dialog that closes doesn't end the wait; empty if none was open when the wait ran out).",
   {
     argv: Schema.Array(Schema.String).annotate({
       description:
@@ -121,7 +121,8 @@ const LaunchAppTool = windowTool(
     ),
     wait_seconds: Schema.optional(
       Schema.Number.annotate({
-        description: "How long to wait for a window (default 10, 0 to not wait).",
+        description:
+          "How long to wait at most for the app's windows to appear and settle (default 10, 0 to not wait).",
       }),
     ),
     width: Schema.optional(
@@ -236,7 +237,7 @@ const ResizeWindowTool = windowTool(
 
 const ReadWindowTool = Tool.make("read_window", {
   description:
-    "Read one of this thread's app windows as an accessibility tree, when the app has one (GTK, Qt, LibreOffice and most desktop apps; not terminals or games): each element's role, name, states, text, its center in snapshot_window's pixels (@x,y) and a ref for act_window. Better than a snapshot for reading text and finding controls. Hidden elements are left out unless all is true; ref reads one element and what's in it.",
+    "Read one of this thread's app windows as an accessibility tree, when the app has one (GTK, Qt, LibreOffice and most desktop apps; not terminals or games): each element's role, name, states, text, its center in snapshot_window's pixels (@x,y) and a ref for act_window. Better than a snapshot for reading text and finding controls. Hidden elements are left out unless all is true; ref reads one element and what's in it. A big table (a spreadsheet's sheet) gives its size and its visible cells that have text or focus: scroll the window to read others. When the app doesn't answer, it says so and whether the app is still running.",
