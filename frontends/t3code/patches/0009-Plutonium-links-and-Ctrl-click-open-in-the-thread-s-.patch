 apps/web/src/plutonium/PlutoniumWindows.tsx | 43 ++++++++++++++++++++-
 apps/web/src/plutonium/previewBridge.ts     |  5 +++
 apps/web/src/plutonium/windowStore.ts       | 22 +++++++++++
 3 files changed, 68 insertions(+), 2 deletions(-)

diff --git a/apps/web/src/plutonium/PlutoniumWindows.tsx b/apps/web/src/plutonium/PlutoniumWindows.tsx
index 1779f2ef1e..89fa54c2a8 100644
--- a/apps/web/src/plutonium/PlutoniumWindows.tsx
+++ b/apps/web/src/plutonium/PlutoniumWindows.tsx
@@ -4,7 +4,7 @@
 // "Elsewhere" lists windows and browser tabs in no T3 thread (another shell's,
 // or nobody's); opening one adds it to the thread.
 import { ThreadId } from "@t3tools/contracts";
-import { useRouter } from "@tanstack/react-router";
+import { useParams, useRouter } from "@tanstack/react-router";
 import { AppWindowIcon, GlobeIcon, SquareArrowOutUpRightIcon } from "lucide-react";
 import { createElement, useEffect, useRef, useState, useSyncExternalStore } from "react";
 
@@ -13,7 +13,11 @@ import { Tooltip, TooltipPopup, TooltipTrigger } from "~/components/ui/tooltip";
 import { useRightPanelStore } from "~/rightPanelStore";
 import { useThreadShells } from "~/state/entities";
 import { usePrimaryEnvironmentId } from "~/state/environments";
-import { buildThreadRouteParams } from "~/threadRoutes";
+import { previewEnvironment } from "~/state/preview";
+import { useAtomCommand } from "~/state/use-atom-command";
+import { buildThreadRouteParams, resolveThreadRouteTarget } from "~/threadRoutes";
+
+import { importBrowserTab } from "./importTab";
 
 import { plutoniumPreview, tabTags, type BrokerTab } from "./previewBridge";
 import {
@@ -22,6 +26,7 @@ import {
   grantFor,
   labelOfTag,
   setPlutoniumFocusHandler,
+  setPlutoniumTabHandlers,
   showOnDesktop,
   startPlutoniumWindows,
   threadIdOfTag,
@@ -68,6 +73,40 @@ export function PlutoniumWindowsStarter() {
     });
     return () => setPlutoniumFocusHandler(null);
   }, [environmentId, router]);
+  // Browser tabs: a link this page opened goes into the open thread, as a
+  // browser panel tab; a thread's tab someone asks to show (an agent, the
+  // overlay, xdg-open in the thread's terminal) opens in its thread.
+  const routeTarget = useParams({
+    strict: false,
+    select: (params) => resolveThreadRouteTarget(params),
+  });
+  const activeThreadRef = routeTarget?.kind === "server" ? routeTarget.threadRef : null;
+  const openPreview = useAtomCommand(previewEnvironment.open, { reportFailure: false });
+  useEffect(() => {
+    setPlutoniumTabHandlers({
+      onOpen: (tab) => {
+        if (activeThreadRef)
+          void importBrowserTab({ threadRef: activeThreadRef, tab, openPreview });
+      },
+      onFocus: (tab) => {
+        if (environmentId === null) return false;
+        const threadId = tabTags(tab)
+          .map(threadIdOfTag)
+          .find((id) => id !== null);
+        if (!threadId) return false;
+        const ref = { environmentId, threadId: ThreadId.make(threadId) };
+        const shown = plutoniumPreview()?.runtimeTabIdOf(tab.id) ?? null;
+        if (shown) useRightPanelStore.getState().openBrowser(ref, shown);
+        else void importBrowserTab({ threadRef: ref, tab, openPreview });
+        void router.navigate({
+          to: "/$environmentId/$threadId",
+          params: buildThreadRouteParams(ref),
+        });
+        return true;
+      },
+    });
+    return () => setPlutoniumTabHandlers(null);
+  }, [activeThreadRef, environmentId, openPreview, router]);
   return null;
 }
 
diff --git a/apps/web/src/plutonium/previewBridge.ts b/apps/web/src/plutonium/previewBridge.ts
index 302a030d7c..159c33ba99 100644
--- a/apps/web/src/plutonium/previewBridge.ts
+++ b/apps/web/src/plutonium/previewBridge.ts
@@ -207,6 +207,11 @@ class PlutoniumPreview {
     return id === undefined ? null : (this.tabs.get(id) ?? null);
   }
 
+  /** The preview tab showing broker tab `tabId`, if one does. */
+  runtimeTabIdOf(tabId: number): string | null {
+    return this.runtimeIds.get(tabId) ?? null;
+  }
+
   /** Tabs from elsewhere (another shell's, or nobody's) no preview shows, oldest first. */
   elsewhere(): readonly BrokerTab[] {
     return this.elsewhereTabs;
diff --git a/apps/web/src/plutonium/windowStore.ts b/apps/web/src/plutonium/windowStore.ts
index c13812488e..6f64dd1ffd 100644
--- a/apps/web/src/plutonium/windowStore.ts
+++ b/apps/web/src/plutonium/windowStore.ts
@@ -17,6 +17,7 @@ import { create } from "zustand";
 import { useRightPanelStore } from "~/rightPanelStore";
 
 import { plutoniumHelperOrigin } from "./helperOrigin";
+import type { BrokerTab } from "./previewBridge";
 import { threadIdOfTag, threadTag } from "./threadTag";
 
 export { threadIdOfTag, threadTag };
@@ -107,6 +108,21 @@ export function setPlutoniumFocusHandler(
   focusHandler = handler;
 }
 
+let tabHandlers: {
+  readonly onOpen: (tab: BrokerTab) => void;
+  readonly onFocus: (tab: BrokerTab) => boolean;
+} | null = null;
+
+/**
+ * Browser tabs that reach the UI: `onOpen` for a link this page opened in a
+ * new tab or window (window.open, target=_blank: what "open in the system
+ * browser" does here), which arrives untagged; `onFocus` for an agent's or
+ * the overlay's "show this tab".
+ */
+export function setPlutoniumTabHandlers(handlers: typeof tabHandlers): void {
+  tabHandlers = handlers;
+}
+
 /** A grant to embed `windowId` in this document (one per window, reused). */
 export function grantFor(windowId: number): Promise<string> {
   return shell ? shell.grantFor(windowId) : Promise.reject(new Error("not the Plutonium shell"));
@@ -196,6 +212,12 @@ export function startPlutoniumWindows(): void {
     (library: { connect(options: object): PlutoniumShell }) => {
       shell = library.connect({
         onFocus: (window: NativeWindowEntry) => focusHandler?.(window) ?? false,
+        // The handler tags the tab itself (importBrowserTab).
+        onOpenTab: (tab: BrokerTab) => {
+          tabHandlers?.onOpen(tab);
+          return undefined;
+        },
+        onFocusTab: (tab: BrokerTab) => tabHandlers?.onFocus(tab) ?? false,
       });
       usePlutoniumWindowStore.setState({ available: shell.available });
       void shell.ready.then(flushGroups);
