@@ -0,0 +1,176 @@
+import { EnvironmentId, ThreadId } from "@t3tools/contracts";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vite-plus/test";
+
+type FakeShell = EventTarget & { tabs: Map<number, unknown> };
+const newShell = () => Object.assign(new EventTarget(), { tabs: new Map() }) as FakeShell;
+
+const fake = vi.hoisted(() => {
+  return {
+    shell: null as unknown as FakeShell,
+    windows: {} as Record<number, unknown>,
+    shownTabs: new Set<number>(),
+    toast: { add: vi.fn(() => "toast-1"), update: vi.fn(), close: vi.fn() },
+    openApp: vi.fn(),
+    openAndFocusApp: vi.fn(),
+  };
+});
+
+vi.mock("~/components/ui/toast", () => ({
+  toastManager: fake.toast,
+  stackedThreadToast: (options: object) => options,
+}));
+vi.mock("~/rightPanelStore", () => ({
+  useRightPanelStore: { getState: () => ({ openApp: fake.openApp }) },
+}));
+vi.mock("./panelKeys", () => ({ openAndFocusApp: fake.openAndFocusApp }));
+vi.mock("./previewBridge", () => ({
+  isBlank: (url: string) => url === "" || url === "about:blank",
+  plutoniumPreview: () => ({
+    runtimeTabIdOf: (id: number) => (fake.shownTabs.has(id) ? `runtime-${id}` : null),
+  }),
+  tabTags: (tab: { tags: string[] }) => tab.tags,
+}));
+vi.mock("./windowStore", () => ({
+  plutoniumShell: () => Promise.resolve(fake.shell),
+  usePlutoniumWindowStore: {
+    getState: () => ({
+      windows: fake.windows,
+      groups: { "t3:thread/other": { tag: "t3:thread/other", label: "Other thread" } },
+    }),
+  },
+  windowTags: (entry: { tags: string[] }) => entry.tags,
+  labelOfTag: (groups: Record<string, { label: string }>, tag: string) => groups[tag]?.label ?? tag,
+}));
+
+const environmentId = EnvironmentId.make("env");
+const here = { environmentId, threadId: ThreadId.make("here") };
+const other = { environmentId, threadId: ThreadId.make("other") };
+
+function window(id: number, thread: string, title = `Window ${id}`) {
+  const entry = {
+    id,
+    appId: "app",
+    title,
+    embedded: false,
+    pid: 100 + id,
+    threadId: `t3:thread/${thread}`,
+    tags: [`t3:thread/${thread}`],
+  };
+  fake.windows[id] = entry;
+  return entry;
+}
+
+function openWindow(entry: ReturnType<typeof window>, show: boolean) {
+  fake.shell.dispatchEvent(new CustomEvent("windowopened", { detail: { window: entry, show } }));
+}
+
+function closeWindow(id: number) {
+  delete fake.windows[id];
+  fake.shell.dispatchEvent(new Event("change"));
+}
+
+type ToastOptions = {
+  title: string;
+  description?: string;
+  data: { threadRef?: unknown };
+  actionProps: { onClick: () => void };
+};
+const lastToast = (): ToastOptions => {
+  const calls = [...fake.toast.add.mock.calls, ...fake.toast.update.mock.calls] as unknown[][];
+  return calls.at(-1)?.at(-1) as ToastOptions;
+};
+
+type Context = import("./openedItems").OpenedItemContext;
+let showWindow: ReturnType<typeof vi.fn<Context["showWindow"]>>;
+let showTab: ReturnType<typeof vi.fn<Context["showTab"]>>;
+
+beforeEach(async () => {
+  vi.useFakeTimers();
+  vi.resetModules();
+  vi.clearAllMocks();
+  for (const id of Object.keys(fake.windows)) delete fake.windows[Number(id)];
+  // Earlier tests' copies of the module still listen on their shells.
+  fake.shell = newShell();
+  fake.shownTabs.clear();
+  const items = await import("./openedItems");
+  showWindow = vi.fn<Context["showWindow"]>();
+  showTab = vi.fn<Context["showTab"]>();
+  items.setOpenedItemContext({ environmentId, activeThreadRef: here, showWindow, showTab });
+  items.startOpenedItems();
+  await Promise.resolve();
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe("opened windows", () => {
+  it("brings a window the user started in the open thread to the front", () => {
+    openWindow(window(1, "here"), true);
+    expect(fake.openAndFocusApp).toHaveBeenCalledWith(here, { windowId: 1, appId: "app" });
+    vi.advanceTimersByTime(2000);
+    expect(fake.toast.add).not.toHaveBeenCalled();
+  });
+
+  it("keeps a window the user started in another thread there, and offers it", () => {
+    openWindow(window(1, "other"), true);
+    expect(fake.openAndFocusApp).not.toHaveBeenCalled();
+    expect(fake.openApp).toHaveBeenCalledWith(other, { windowId: 1, appId: "app" });
+    vi.advanceTimersByTime(1000);
+    expect(lastToast()).toMatchObject({ title: "Window 1 opened", description: "In Other thread" });
+    expect(lastToast().data.threadRef).toBeUndefined();
+    lastToast().actionProps.onClick();
+    expect(showWindow).toHaveBeenCalledWith(other, fake.windows[1]);
+  });
+
+  it("mentions an agent's window in the open thread after a moment, without showing it", () => {
+    openWindow(window(1, "here"), false);
+    expect(fake.openAndFocusApp).not.toHaveBeenCalled();
+    vi.advanceTimersByTime(999);
+    expect(fake.toast.add).not.toHaveBeenCalled();
+    vi.advanceTimersByTime(1);
+    expect(lastToast().data.threadRef).toEqual(here);
+  });
+
+  it("says nothing about an agent's window in another thread", () => {
+    openWindow(window(1, "other"), false);
+    vi.advanceTimersByTime(2000);
+    expect(fake.toast.add).not.toHaveBeenCalled();
+    expect(fake.openApp).not.toHaveBeenCalled();
+  });
+
+  it("says nothing about a window that closes at once", () => {
+    openWindow(window(1, "here"), false);
+    closeWindow(1);
+    vi.advanceTimersByTime(2000);
+    expect(fake.toast.add).not.toHaveBeenCalled();
+  });
+
+  it("collects a thread's windows in one toast, and lets them go as they close", () => {
+    openWindow(window(1, "here"), false);
+    openWindow(window(2, "here", "Second"), false);
+    vi.advanceTimersByTime(1000);
+    expect(fake.toast.add).toHaveBeenCalledTimes(1);
+    expect(lastToast()).toMatchObject({ title: "2 windows opened", description: "Newest: Second" });
+    lastToast().actionProps.onClick();
+    expect(showWindow).toHaveBeenCalledWith(here, fake.windows[2]);
+    expect(lastToast()).toMatchObject({ title: "Window 1 opened" });
+    closeWindow(1);
+    expect(fake.toast.close).toHaveBeenCalledWith("toast-1");
+  });
+});
+
+describe("opened tabs", () => {
+  it("mentions an agent's tab in the open thread until it is shown", () => {
+    const tab = { id: 7, url: "https://example.com/", title: "Example", embedded: false };
+    fake.shell.tabs.set(7, { ...tab, tags: ["t3:thread/here"] });
+    fake.shell.dispatchEvent(
+      new CustomEvent("tabopened", { detail: { tab: { ...tab, tags: ["t3:thread/here"] } } }),
+    );
+    vi.advanceTimersByTime(1000);
+    expect(lastToast()).toMatchObject({ title: "Example opened" });
+    fake.shownTabs.add(7);
+    fake.shell.dispatchEvent(new Event("change"));
+    expect(fake.toast.close).toHaveBeenCalledWith("toast-1");
+  });
+});
diff --git a/apps/web/src/plutonium/openedItems.ts b/apps/web/src/plutonium/openedItems.ts
new file mode 100644
index 0000000000..720579de8a
--- /dev/null
+++ b/apps/web/src/plutonium/openedItems.ts
@@ -0,0 +1,255 @@
+// Plutonium: what happens when a window or browser tab opens.
+//
+// A window the user started (from a terminal, the app launcher: the shell
+// library's `show`) opens in its thread's panel with the keyboard when that
+// thread is open. In another thread, it waits in that thread's panel, and a
+// toast offers to show it. What an agent opens waits in its thread, and a
+// toast says so while that thread is open (in other threads, nothing).
+//
+// Toasts wait a moment, so windows and tabs that close at once (a test run, a
+// splash) never get one. One toast per thread collects what opened there, and
+// drops what closes or the user opens some other way.
+import type { EnvironmentId, ScopedThreadRef } from "@t3tools/contracts";
+import { ThreadId } from "@t3tools/contracts";
+import { scopedThreadKey } from "@t3tools/client-runtime/environment";
+
+import { stackedThreadToast, toastManager } from "~/components/ui/toast";
+import { useRightPanelStore } from "~/rightPanelStore";
+
+import { openAndFocusApp } from "./panelKeys";
+import { isBlank, plutoniumPreview, tabTags, type BrokerTab } from "./previewBridge";
+import { threadIdOfTag, threadTag } from "./threadTag";
+import {
+  labelOfTag,
+  plutoniumShell,
+  type NativeWindowEntry,
+  usePlutoniumWindowStore,
+  windowTags,
+} from "./windowStore";
+
+/** How long a new item has to stay (and stay unseen) before a toast mentions it. */
+const NOTICE_DELAY_MS = 1000;
+const NOTICE_TIMEOUT_MS = 8000;
+
+/** What the app is showing, and how to show an item there. Set by PlutoniumWindowsStarter. */
+export interface OpenedItemContext {
+  readonly environmentId: EnvironmentId;
+  readonly activeThreadRef: ScopedThreadRef | null;
+  /** Goes to `ref`'s thread and shows the window there, with the keyboard. */
+  readonly showWindow: (ref: ScopedThreadRef, window: NativeWindowEntry) => void;
+  /** Goes to `ref`'s thread and shows the tab in its browser panel. */
+  readonly showTab: (ref: ScopedThreadRef, tab: BrokerTab) => void;
+}
+
+type Item =
+  | { readonly kind: "window"; readonly id: number }
+  | { readonly kind: "tab"; readonly id: number };
+
+interface Notice {
+  readonly ref: ScopedThreadRef;
+  /** In the open thread when it started: the toast is shown only there. */
+  readonly scoped: boolean;
+  readonly items: Item[];
+  toastId: string | null;
+  rendered: string;
+}
+
+let context: OpenedItemContext | null = null;
+const notices = new Map<string, Notice>();
+
+export function setOpenedItemContext(next: OpenedItemContext | null): void {
+  context = next;
+}
+
+function threadOf(tags: readonly string[]): ThreadId | null {
+  const threadId = tags.map(threadIdOfTag).find((id) => id !== null);
+  return threadId ? ThreadId.make(threadId) : null;
+}
+
+function isActive(ref: ScopedThreadRef): boolean {
+  const active = context?.activeThreadRef;
+  return !!active && active.environmentId === ref.environmentId && active.threadId === ref.threadId;
+}
+
+function windowOf(id: number): NativeWindowEntry | undefined {
+  return usePlutoniumWindowStore.getState().windows[id];
+}
+
+let shellTabs: ReadonlyMap<number, BrokerTab> | null = null;
+
+function tabOf(id: number): BrokerTab | undefined {
+  return shellTabs?.get(id);
+}
+
+/** Still there, and not in front of the user (nor in a panel, for tabs). */
+function isWaiting(item: Item): boolean {
+  if (item.kind === "window") {
+    const window = windowOf(item.id);
+    return window !== undefined && !window.embedded;
+  }
+  const tab = tabOf(item.id);
+  return (
+    tab !== undefined &&
+    !tab.embedded &&
+    !isBlank(tab.url) &&
+    (plutoniumPreview()?.runtimeTabIdOf(tab.id) ?? null) === null
+  );
+}
+
+function labelOf(item: Item): string {
+  if (item.kind === "window") {
+    const window = windowOf(item.id);
+    return window?.title || window?.appId || "A window";
+  }
+  const tab = tabOf(item.id);
+  return tab?.title || tab?.url || "A tab";
+}
+
+function show(notice: Notice, item: Item): void {
+  if (!context) return;
+  if (item.kind === "window") {
+    const window = windowOf(item.id);
+    if (window) context.showWindow(notice.ref, window);
+  } else {
+    const tab = tabOf(item.id);
+    if (tab) context.showTab(notice.ref, tab);
+  }
+}
+
+function noticeKey(ref: ScopedThreadRef, scoped: boolean): string {
+  return `${scopedThreadKey(ref)}\u0000${scoped ? "here" : "elsewhere"}`;
+}
+
+function closeNotice(key: string): void {
+  const notice = notices.get(key);
+  notices.delete(key);
+  if (notice?.toastId) toastManager.close(notice.toastId);
+}
+
+/** Adds, updates or closes `key`'s toast to match what is still waiting. */
+function render(key: string): void {
+  const notice = notices.get(key);
+  if (!notice) return;
+  const waiting = notice.items.filter(isWaiting);
+  notice.items.splice(0, notice.items.length, ...waiting);
+  const newest = waiting.at(-1);
+  if (!newest) {
+    closeNotice(key);
+    return;
+  }
+  const kinds = new Set(waiting.map((item) => item.kind));
+  const noun = kinds.size > 1 ? "windows and tabs" : newest.kind === "window" ? "windows" : "tabs";
+  const title =
+    waiting.length === 1 ? `${labelOf(newest)} opened` : `${waiting.length} ${noun} opened`;
+  const thread = labelOfTag(
+    usePlutoniumWindowStore.getState().groups,
+    threadTag(notice.ref.threadId),
+  );
+  const description = notice.scoped
+    ? waiting.length === 1
+      ? "Opened in the background."
+      : `Newest: ${labelOf(newest)}`
+    : `In ${thread}`;
+  const rendered = JSON.stringify([title, description]);
+  if (notice.toastId && rendered === notice.rendered) return;
+  notice.rendered = rendered;
+  const options = {
+    ...stackedThreadToast({
+      type: "info",
+      title,
+      description,
+      timeout: notice.scoped ? 0 : NOTICE_TIMEOUT_MS,
+      actionProps: {
+        children: "Show",
+        onClick: () => {
+          const current = notices.get(key);
+          const item = current?.items.at(-1);
+          if (!current || !item) return;
+          current.items.pop();
+          show(current, item);
+          render(key);
+        },
+      },
+      data: {
+        hideCopyButton: true,
+        // Only counts while the thread is open, as the toast is only shown then.
+        ...(notice.scoped
+          ? { threadRef: notice.ref, dismissAfterVisibleMs: NOTICE_TIMEOUT_MS }
+          : {}),
+      },
+    }),
+    onClose: () => {
+      if (notices.get(key) === notice) notices.delete(key);
+    },
+  };
+  if (notice.toastId) toastManager.update(notice.toastId, options);
+  else notice.toastId = toastManager.add(options);
+}
+
+/** Tells the user about `item` in `ref`'s thread, unless it closes or they see it first. */
+function notify(ref: ScopedThreadRef, scoped: boolean, item: Item): void {
+  setTimeout(() => {
+    if (!isWaiting(item)) return;
+    const key = noticeKey(ref, scoped);
+    let notice = notices.get(key);
+    if (!notice) {
+      notice = { ref, scoped, items: [], toastId: null, rendered: "" };
+      notices.set(key, notice);
+    }
+    if (!notice.items.some((entry) => entry.kind === item.kind && entry.id === item.id)) {
+      notice.items.push(item);
+    }
+    render(key);
+  }, NOTICE_DELAY_MS);
+}
+
+function onWindowOpened(window: NativeWindowEntry, shown: boolean): void {
+  const threadId = threadOf(windowTags(window));
+  if (!context || !threadId) return;
+  const ref = { environmentId: context.environmentId, threadId };
+  const active = isActive(ref);
+  if (shown && active) {
+    openAndFocusApp(ref, { windowId: window.id, appId: window.appId });
+  } else if (shown) {
+    // It waits as a tab of its own thread; the toast goes there.
+    useRightPanelStore.getState().openApp(ref, { windowId: window.id, appId: window.appId });
+    notify(ref, false, { kind: "window", id: window.id });
+  } else if (active) {
+    notify(ref, true, { kind: "window", id: window.id });
+  }
+}
+
+function onTabOpened(tab: BrokerTab): void {
+  // Tabs the user asks for (links, xdg-open from a terminal) are shown as
+  // they open; this is for the rest, such as an agent's.
+  const threadId = threadOf(tabTags(tab));
+  if (!context || !threadId) return;
+  const ref = { environmentId: context.environmentId, threadId };
+  if (isActive(ref)) notify(ref, true, { kind: "tab", id: tab.id });
+}
+
+let started = false;
+
+/** Listens for new windows and tabs, once per document. */
+export function startOpenedItems(): void {
+  if (started) return;
+  started = true;
+  void plutoniumShell().then((shell) => {
+    if (!shell) return;
+    shellTabs = shell.tabs ?? null;
+    shell.addEventListener("windowopened", (event) => {
+      const { window, show: shown } = (
+        event as CustomEvent<{ window: NativeWindowEntry; show: boolean }>
+      ).detail;
+      onWindowOpened(window, shown);
+    });
+    shell.addEventListener("tabopened", (event) => {
+      onTabOpened((event as CustomEvent<{ tab: BrokerTab }>).detail.tab);
+    });
+    // What closed, or was opened some other way, leaves its toast.
+    const refresh = () => {
+      for (const key of notices.keys()) render(key);
+    };
+    shell.addEventListener("change", refresh);
+  });
+}
