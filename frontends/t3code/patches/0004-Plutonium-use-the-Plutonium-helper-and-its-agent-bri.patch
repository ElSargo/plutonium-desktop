+/**
+ * Connects to the Plutonium helper for the whole app, and opens a window's tab
+ * in its thread when the thread's agent asks to show it. Renders nothing.
+ */
 export function PlutoniumWindowsStarter() {
+  const router = useRouter();
+  const environmentId = usePrimaryEnvironmentId();
   useEffect(startPlutoniumWindows, []);
+  useEffect(() => {
+    if (environmentId === null) return;
+    // Plutonium threads run on this machine: the primary environment.
+    setPlutoniumFocusHandler((window) => {
+      if (!window.threadId) return false;
+      const ref = { environmentId, threadId: ThreadId.make(window.threadId) };
+      useRightPanelStore.getState().openApp(ref, { windowId: window.id, appId: window.appId });
+      void router.navigate({
+        to: "/$environmentId/$threadId",
+        params: buildThreadRouteParams(ref),
+      });
+      return true;
+    });
+    return () => setPlutoniumFocusHandler(null);
+  }, [environmentId, router]);
   return null;
 }
 
