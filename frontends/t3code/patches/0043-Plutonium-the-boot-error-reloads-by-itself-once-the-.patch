From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sargo@sargo.cc>
Date: Thu, 29 Oct 2026 09:01:30 +1300
Subject: [PATCH 43/43] Plutonium: the boot error reloads by itself once the
 server answers

The shell can open T3's page while its server is still starting or
restarting; a chunk the boot asked for then failed and the page sat on
"T3 Code could not load." until reloaded by hand. It now polls the server
and reloads when it answers, up to five times per failure streak (a boot
that renders clears the count), so a real startup bug still stops there.
---
 apps/web/src/bootstrap.test.ts | 32 +++++++++++++++++++++++++
 apps/web/src/lib/bootError.ts  | 43 ++++++++++++++++++++++++++++++++++
 apps/web/src/main.tsx          |  2 ++
 3 files changed, 77 insertions(+)

diff --git a/apps/web/src/bootstrap.test.ts b/apps/web/src/bootstrap.test.ts
index c5c0d89597..1707c48a09 100644
--- a/apps/web/src/bootstrap.test.ts
+++ b/apps/web/src/bootstrap.test.ts
@@ -90,4 +90,36 @@ describe("app startup failures", () => {
 
     expect(createElement).not.toHaveBeenCalled();
   });
+
+  it("reloads by itself once the server answers, a few times per streak", async () => {
+    vi.useFakeTimers();
+    const storage = new Map<string, string>();
+    const reload = vi.fn();
+    vi.stubGlobal("window", {
+      location: { reload },
+      setTimeout,
+      sessionStorage: {
+        getItem: (key: string) => storage.get(key) ?? null,
+        setItem: (key: string, value: string) => storage.set(key, value),
+      },
+    });
+    const fetch = vi
+      .fn()
+      .mockRejectedValueOnce(new TypeError("Failed to fetch"))
+      .mockResolvedValue({ ok: true });
+    vi.stubGlobal("fetch", fetch);
+
+    showBootError(new TypeError("Failed to fetch dynamically imported module"));
+    await vi.advanceTimersByTimeAsync(1000);
+    expect(reload).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(1000);
+    expect(reload).toHaveBeenCalledOnce();
+
+    storage.set("t3code:boot-retries", "5");
+    reload.mockClear();
+    showBootError(new Error("still broken"));
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(reload).not.toHaveBeenCalled();
+    vi.useRealTimers();
+  });
 });
diff --git a/apps/web/src/lib/bootError.ts b/apps/web/src/lib/bootError.ts
index 697c8e9d8d..f2ed07bb51 100644
--- a/apps/web/src/lib/bootError.ts
+++ b/apps/web/src/lib/bootError.ts
@@ -24,4 +24,47 @@ export function showBootError(error: unknown) {
   reload.addEventListener("click", () => window.location.reload());
   content.append(reload);
   bootShell.replaceChildren(content);
+  retryBootWhenServerAnswers();
+}
+
+// Plutonium: the shell can open the page while T3's server is still starting
+// or restarting, and a chunk it asks for then fails, which left the page on
+// this error until reloaded by hand. Reload by itself once the server answers
+// again, a few times per failure streak (a successful boot clears it), so a
+// real startup bug still stops here.
+const BOOT_RETRY_KEY = "t3code:boot-retries";
+const BOOT_RETRY_LIMIT = 5;
+
+function retryBootWhenServerAnswers() {
+  let retries: number;
+  try {
+    retries = Number(window.sessionStorage.getItem(BOOT_RETRY_KEY) ?? 0);
+    if (retries >= BOOT_RETRY_LIMIT) return;
+    window.sessionStorage.setItem(BOOT_RETRY_KEY, String(retries + 1));
+  } catch {
+    // Without storage a persistent failure would reload forever.
+    return;
+  }
+  const poll = async () => {
+    try {
+      const response = await fetch("/", { cache: "no-store" });
+      if (response.ok) {
+        window.location.reload();
+        return;
+      }
+    } catch {
+      // Not listening yet.
+    }
+    window.setTimeout(poll, 1000);
+  };
+  window.setTimeout(poll, 1000 * (retries + 1));
+}
+
+/** After a boot that rendered: the next failure gets its own retries. */
+export function clearBootRetries() {
+  try {
+    window.sessionStorage.removeItem(BOOT_RETRY_KEY);
+  } catch {
+    // Blocked storage never held the count.
+  }
 }
