+/**
+ * The browser's id for the caller's tab `tabId` (default: the one preview
+ * tools act on without a tabId, as PreviewAutomationBroker names the caller).
+ */
+const browserTab = (
+  browser: Option.Option<ServerBrowser.ServerBrowser["Service"]>,
+  tabId: string | undefined,
+) =>
+  Effect.gen(function* () {
+    if (Option.isNone(browser)) {
+      return yield* failure("This T3 Code server has no browser for preview tabs.");
+    }
+    const scope = yield* McpInvocationContext.McpInvocationContext;
+    const { thread } = yield* McpInvocationContext.requireThreadScope(scope, "This tool");
+    const id = yield* browser.value.plutoniumTabId({
+      threadId: thread.threadId,
+      tabId,
+      agentSessionId: `${scope.environmentId}\u0000${thread.providerSessionId}`,
+    });
+    if (id !== null) return id;
+    return yield* failure(
+      tabId === undefined
+        ? "No preview tab is open for this thread in Plutonium's browser. Call preview_open first."
+        : `No preview tab ${tabId} is open for this thread in Plutonium's browser.`,
+    );
+  });
+
+/** Runs the helper's tool `name` on the browser's tab for `tabId`. */
+const forwardTab =
+  (browser: Option.Option<ServerBrowser.ServerBrowser["Service"]>, name: string) =>
+  ({ tabId, ...args }: { readonly tabId?: string | undefined }) =>
+    browserTab(browser, tabId).pipe(Effect.flatMap((id) => forward(name)({ ...args, tab_id: id })));
+
+export const layerTabs = McpToolAccess.toLayer(
+  TabToolkit,
+  Effect.gen(function* () {
+    // Optional, so the toolkit builds without one (tests of other toolkits).
+    const browser = yield* Effect.serviceOption(ServerBrowser.ServerBrowser);
+    return {
+      tab_requests: McpToolAccess.readsAsCaller(
+        ({ tabId }: { readonly tabId?: string | undefined }) =>
+          browserTab(browser, tabId).pipe(
+            Effect.flatMap((id) =>
+              forward("list_tabs")({}).pipe(
+                Effect.map(({ result }) => {
+                  const tab = Array.isArray(result)
+                    ? (result as ReadonlyArray<{ readonly id?: unknown }>).find(
+                        (entry) => entry.id === id,
+                      )
+                    : undefined;
+                  const { pending, state } = (tab ?? {}) as {
+                    readonly pending?: unknown;
+                    readonly state?: unknown;
+                  };
+                  return { result: { pending: pending ?? {}, ...(state ? { state } : {}) } };
+                }),
+              ),
+            ),
+          ),
+      ),
+      find_in_tab: McpToolAccess.actsAsCaller(forwardTab(browser, "find_in_tab")),
+      answer_permission: McpToolAccess.actsAsCaller(forwardTab(browser, "answer_permission")),
+      request_permission: McpToolAccess.actsAsCaller(forwardTab(browser, "request_permission")),
+      choose_files: McpToolAccess.actsAsCaller(forwardTab(browser, "choose_files")),
+      print_tab: McpToolAccess.actsAsCaller(forwardTab(browser, "print_tab")),
+      cancel_print: McpToolAccess.actsAsCaller(forwardTab(browser, "cancel_print")),
+      list_printers: McpToolAccess.readsAsCaller(forward("list_printers")),
+      list_downloads: McpToolAccess.readsAsCaller(forward("list_downloads")),
+      download_action: McpToolAccess.actsAsCaller(forward("download_action")),
+    };
+  }),
+);
+
