From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oliver Sargison <sarol263@student.otago.ac.nz>
Date: Sat, 24 Oct 2026 11:42:14 +1300
Subject: [PATCH 19/28] Plutonium: auth session issue --runtime-mode-ceiling,
 for MCP clients that launch threads

An mcp-client session issued from the CLI was capped at approval-required, so a headless orchestrator (Plutonium's agent tool tests) could not launch full-access threads on a test session's server.
---
 apps/server/src/auth/EnvironmentAuth.ts |  4 ++++
 apps/server/src/cli/auth.ts             | 12 ++++++++++++
 2 files changed, 16 insertions(+)

diff --git a/apps/server/src/auth/EnvironmentAuth.ts b/apps/server/src/auth/EnvironmentAuth.ts
index 8a59f22fca..32b26276fc 100644
--- a/apps/server/src/auth/EnvironmentAuth.ts
+++ b/apps/server/src/auth/EnvironmentAuth.ts
@@ -24,6 +24,7 @@ import {
   type AuthWebSocketTicketResult,
   DpopFailureReason,
   type DpopFailureReason as DpopFailureReasonType,
+  type RuntimeMode,
 } from "@t3tools/contracts";
 import { encodeOAuthScope } from "@t3tools/shared/oauthScope";
 import * as Context from "effect/Context";
@@ -525,6 +526,8 @@ export class EnvironmentAuth extends Context.Service<
       readonly subject?: string;
       readonly scopes?: ReadonlyArray<AuthEnvironmentScope>;
       readonly label?: string;
+      /** For an `mcp-client` session: the highest runtime mode its threads may use. */
+      readonly runtimeModeCeiling?: RuntimeMode;
     }) => Effect.Effect<IssuedBearerSession, ServerAuthInternalError>;
     readonly listSessions: () => Effect.Effect<
       ReadonlyArray<AuthClientSession>,
@@ -1115,6 +1118,7 @@ export const make = Effect.gen(function* () {
           deviceType: "bot",
         },
         ...(input?.ttl ? { ttl: input.ttl } : {}),
+        ...(input?.runtimeModeCeiling ? { runtimeModeCeiling: input.runtimeModeCeiling } : {}),
       })
       .pipe(
         Effect.map(
diff --git a/apps/server/src/cli/auth.ts b/apps/server/src/cli/auth.ts
index 32934a97ca..7bb92b4247 100644
--- a/apps/server/src/cli/auth.ts
+++ b/apps/server/src/cli/auth.ts
@@ -2,6 +2,7 @@ import {
   AuthAdministrativeScopes,
   AuthSessionId,
   AuthStandardClientScopes,
+  RuntimeMode,
 } from "@t3tools/contracts";
 import * as Console from "effect/Console";
 import * as Effect from "effect/Effect";
@@ -72,6 +73,13 @@ const subjectFlag = Flag.String("subject").pipe(
   Flag.optional,
 );
 
+const runtimeModeCeilingFlag = Flag.Literals("runtime-mode-ceiling", RuntimeMode.literals).pipe(
+  Flag.withDescription(
+    "With `--subject mcp-client`: the highest runtime mode its threads may use (default approval-required).",
+  ),
+  Flag.optional,
+);
+
 const baseUrlFlag = Flag.String("base-url").pipe(
   Flag.withDescription("Optional public base URL used to print a ready `/pair#token=...` link."),
   Flag.optional,
@@ -167,6 +175,7 @@ const sessionIssueCommand = Command.make("issue", {
   ttl: ttlFlag,
   label: labelFlag,
   subject: subjectFlag,
+  runtimeModeCeiling: runtimeModeCeilingFlag,
   tokenOnly: tokenOnlyFlag,
   json: jsonFlag,
 }).pipe(
@@ -181,6 +190,9 @@ const sessionIssueCommand = Command.make("issue", {
             ...(Option.isSome(flags.ttl) ? { ttl: flags.ttl.value } : {}),
             ...(Option.isSome(flags.label) ? { label: flags.label.value } : {}),
             ...(Option.isSome(flags.subject) ? { subject: flags.subject.value } : {}),
+            ...(Option.isSome(flags.runtimeModeCeiling)
+              ? { runtimeModeCeiling: flags.runtimeModeCeiling.value }
+              : {}),
           });
           yield* Console.log(
             formatIssuedSession(issued, {
