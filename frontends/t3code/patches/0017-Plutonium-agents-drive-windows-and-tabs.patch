diff --git a/apps/server/src/plutonium/windowTools.test.ts b/apps/server/src/plutonium/windowTools.test.ts
new file mode 100644
index 0000000000..e02574b109
--- /dev/null
+++ b/apps/server/src/plutonium/windowTools.test.ts
@@ -0,0 +1,173 @@
+// @effect-diagnostics nodeBuiltinImport:off - a fake Plutonium helper on a Unix socket
+import { expect, it } from "@effect/vitest";
+import { EnvironmentId, ProviderInstanceId, ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import { McpSchema, McpServer } from "effect/ai";
+import * as NodeFS from "node:fs";
+import * as NodeHttp from "node:http";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+import * as McpHttpServer from "../mcp/McpHttpServer.ts";
+import * as McpInvocationContext from "../mcp/McpInvocationContext.ts";
+import * as McpToolAccessTestkit from "../mcp/McpToolAccess.testkit.ts";
+
+const threadId = ThreadId.make("thread-windows-test");
+const invocation = (thread: boolean) => ({
+  environmentId: EnvironmentId.make("environment-windows-test"),
+  requestNamespace: "provider-session-windows-test",
+  thread: thread
+    ? {
+        threadId,
+        providerSessionId: "provider-session-windows-test",
+        providerInstanceId: ProviderInstanceId.make("codex"),
+      }
+    : undefined,
+  client: thread
+    ? undefined
+    : { sessionId: "client", label: "client", access: "read-only" as const },
+  capabilities: new Set<McpInvocationContext.McpCapability>(),
+  issuedAt: 1,
+});
+const client = McpSchema.McpServerClient.of({
+  clientId: 1,
+  clientCapabilities: {},
+  clientInfo: { name: "mcp-test", version: "1.0.0" },
+  protocolVersion: "2025-06-18",
+  initializePayload: {
+    protocolVersion: "2025-06-18",
+    capabilities: {},
+    clientInfo: { name: "mcp-test", version: "1.0.0" },
+  },
+  getClient: Effect.die("unused"),
+});
+
+/** A 2x3 PNG's first bytes: enough for its size. */
+const PNG = Buffer.concat([
+  Buffer.from("89504e470d0a1a0a0000000d49484452", "hex"),
+  Buffer.from([0, 0, 0, 2, 0, 0, 0, 3]),
+]).toString("base64");
+
+/** A helper that answers each call with what a real one would, and records it. */
+const fakeHelper = Effect.acquireRelease(
+  Effect.promise(async () => {
+    const dir = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "t3-plutonium-windows-"));
+    const socketPath = NodePath.join(dir, "helper.sock");
+    const calls: Array<{ readonly path: string; readonly body: unknown }> = [];
+    const server = NodeHttp.createServer((request, response) => {
+      let body = "";
+      request.on("data", (chunk: Buffer) => (body += chunk.toString("utf8")));
+      request.on("end", () => {
+        calls.push({ path: request.url ?? "", body: JSON.parse(body) });
+        const { name } = JSON.parse(body) as { name: string };
+        response.setHeader("Content-Type", "application/json");
+        response.end(
+          JSON.stringify(
+            name === "snapshot_window"
+              ? { content: [{ type: "image", data: PNG, mimeType: "image/png" }] }
+              : name === "type_window"
+                ? { content: [{ type: "text", text: "Can't type 'é'." }], isError: true }
+                : { content: [{ type: "text", text: '[{"id":3}]' }] },
+          ),
+        );
+      });
+    });
+    await new Promise<void>((resolve) => server.listen(socketPath, resolve));
+    return { dir, server, socketPath, calls };
+  }),
+  ({ dir, server }) =>
+    Effect.promise(
+      () =>
+        new Promise<void>((resolve) =>
+          server.close(() => {
+            NodeFS.rmSync(dir, { recursive: true, force: true });
+            resolve();
+          }),
+        ),
+    ),
+);
+
+const withEnv = (name: string, value: string | undefined) =>
+  Effect.acquireRelease(
+    Effect.sync(() => {
+      const previous = process.env[name];
+      if (value === undefined) delete process.env[name];
+      else process.env[name] = value;
+      return previous;
+    }),
+    (previous) =>
+      Effect.sync(() => {
+        if (previous === undefined) delete process.env[name];
+        else process.env[name] = previous;
+      }),
+  );
+
+const buildServer = Effect.provide(
+  McpServer.McpServer,
+  McpHttpServer.layerPlutoniumWindowToolkit.pipe(
+    Layer.provideMerge(McpServer.McpServer.layer),
+    Layer.provide(McpToolAccessTestkit.liveThreadsLayer),
+  ),
+);
+
+it.effect("offers the window tools and runs them on the helper for the calling thread", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const helper = yield* fakeHelper;
+      yield* withEnv("PLUTONIUM_HELPER", helper.socketPath);
+      const server = yield* buildServer;
+      const names = server.tools.map(({ tool }) => tool.name);
+      expect(names).toContain("list_windows");
+      expect(names).toContain("snapshot_window");
+      expect(names).toContain("click_window");
+      for (const { tool } of server.tools) {
+        expect(tool.inputSchema.type, `inputSchema.type of ${tool.name}`).toBe("object");
+      }
+
+      const call = (name: string, args: Record<string, unknown>, thread = true) =>
+        server
+          .callTool({ name, arguments: args })
+          .pipe(
+            Effect.provideService(McpInvocationContext.McpInvocationContext, invocation(thread)),
+            Effect.provideService(McpSchema.McpServerClient, client),
+          );
+
+      const listed = yield* call("list_windows", {});
+      expect(listed.isError).toBe(false);
+      expect(listed.structuredContent).toEqual({ result: [{ id: 3 }] });
+
+      const shot = yield* call("snapshot_window", { window_id: 3 });
+      expect(shot.isError).toBe(false);
+      expect(shot.content.map((entry) => entry.type)).toEqual(["text", "image"]);
+      expect(shot.structuredContent).toMatchObject({ screenshot: { width: 2, height: 3 } });
+
+      const typed = yield* call("type_window", { window_id: 3, text: "é" });
+      expect(typed.isError).toBe(true);
+      expect(JSON.stringify(typed.content)).toContain("Can't type");
+
+      expect(helper.calls.map((entry) => entry.path)).toEqual(
+        Array(3).fill(`/v1/threads/${encodeURIComponent(`t3:thread/${threadId}`)}/mcp/call`),
+      );
+      expect(helper.calls[1]!.body).toEqual({
+        name: "snapshot_window",
+        arguments: { window_id: 3 },
+      });
+
+      const refused = yield* call("list_windows", {}, false);
+      expect(refused.isError).toBe(true);
+      expect(helper.calls).toHaveLength(3);
+    }),
+  ),
+);
+
+it.effect("offers nothing outside a Plutonium session", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      yield* withEnv("PLUTONIUM_HELPER", undefined);
+      yield* withEnv("PLUTONIUM_WAYLAND_DISPLAY", undefined);
+      const server = yield* buildServer;
+      expect(server.tools).toEqual([]);
+    }),
+  ),
+);
diff --git a/apps/server/src/plutonium/windowTools.ts b/apps/server/src/plutonium/windowTools.ts
new file mode 100644
index 0000000000..5a10b2e54c
--- /dev/null
+++ b/apps/server/src/plutonium/windowTools.ts
@@ -0,0 +1,362 @@
+// @effect-diagnostics nodeBuiltinImport:off - requests go to the Plutonium helper's Unix socket
+/**
+ * Plutonium: the native window tools (launch_app, snapshot_window,
+ * click_window, type_window, ...) on T3 Code's own MCP server, so every
+ * provider's agents can use the apps of their thread. Tabs are T3's preview
+ * tools' already.
+ *
+ * T3 declares the tools and who may call them, as for its other toolkits:
+ * each acts as the calling thread (`McpToolAccess`). The helper runs them for
+ * that thread (POST /v1/threads/:tag/mcp/call), as its own MCP server does.
+ * McpHttpServer registers them only in a Plutonium session.
+ */
+import { OrchestratorMcpFailure } from "@t3tools/contracts";
+import { plutoniumHelperSocket, plutoniumThreadTag } from "@t3tools/shared/plutonium";
+import * as Effect from "effect/Effect";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import { Tool, Toolkit } from "effect/ai";
+import * as NodeHttp from "node:http";
+
+import * as McpInvocationContext from "../mcp/McpInvocationContext.ts";
+import * as McpToolAccess from "../mcp/McpToolAccess.ts";
+import * as ThreadManagementService from "../orchestration-v2/ThreadManagementService.ts";
+
+/** Whether this server runs in a Plutonium session, with a helper to run the tools. */
+export const available = () => plutoniumHelperSocket() !== undefined;
+
+export class PlutoniumWindowToolError extends Schema.TaggedError<PlutoniumWindowToolError>()(
+  "PlutoniumWindowToolError",
+  { message: Schema.String },
+) {}
+
+const dependencies = [
+  McpInvocationContext.McpInvocationContext,
+  ThreadManagementService.ThreadManagementService,
+];
+
+const WindowToolFailure = Schema.Union([PlutoniumWindowToolError, OrchestratorMcpFailure]);
+
+const WindowToolResult = Schema.Struct({
+  result: Schema.Unknown.annotate({ description: "What the Plutonium helper answered." }),
+});
+
+const windowId = Schema.Int.annotate({
+  description: "A window id from list_windows or launch_app.",
+});
+const coordinate = (axis: string) =>
+  Schema.Number.annotate({
+    description: `${axis} in the window's snapshot_window image, in pixels.`,
+  });
+const point = Schema.Tuple([Schema.Number, Schema.Number]).annotate({ description: "[x, y]" });
+const button = Schema.optional(
+  Schema.Literals(["left", "right", "middle"]).annotate({ description: "Default left." }),
+);
+
+const windowTool = <const Name extends string, P extends Schema.Struct.Fields>(
+  name: Name,
+  description: string,
+  parameters: P,
+  hints: { readonly title: string; readonly destructive?: boolean },
+) =>
+  Tool.make(name, {
+    description,
+    parameters: Schema.Struct(parameters),
+    success: WindowToolResult,
+    failure: WindowToolFailure,
+    dependencies,
+  })
+    .annotate(Tool.Title, hints.title)
+    .annotate(Tool.Readonly, false)
+    .annotate(Tool.Destructive, hints.destructive === true)
+    .annotate(Tool.Idempotent, false)
+    .annotate(Tool.OpenWorld, true);
+
+const ListWindowsTool = Tool.make("list_windows", {
+  description:
+    "List the native desktop app windows that belong to this thread (apps you launched with launch_app or started from this thread's terminals). Each has an id, title, app id, size, whether the user is looking at it, and whether it has keyboard focus.",
+  // No `parameters`: an empty Schema.Struct serializes to `anyOf: [object, array]`,
+  // which clients reject (see the worktree toolkit).
+  success: WindowToolResult,
+  failure: WindowToolFailure,
+  dependencies,
+})
+  .annotate(Tool.Title, "List app windows")
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false)
+  .annotate(Tool.Idempotent, true)
+  .annotate(Tool.OpenWorld, true);
+
+const LaunchAppTool = windowTool(
+  "launch_app",
+  "Start a native desktop (GUI) app, such as LibreOffice, GIMP, Inkscape, a terminal or a file manager, as part of this thread, and wait for its window. Drive it with snapshot_window, click_window, type_window and press_window, even while the user is doing something else. The app runs detached from your shell. Its windows wait in the thread for the user unless focus is true. Returns the new windows (empty if none appeared in time).",
+  {
+    argv: Schema.Array(Schema.String).annotate({
+      description: 'Program and arguments, e.g. ["libreoffice", "--writer"]. No shell is involved.',
+    }),
+    cwd: Schema.optional(
+      Schema.String.annotate({ description: "Working directory (default: your home directory)." }),
+    ),
+    wait_seconds: Schema.optional(
+      Schema.Number.annotate({
+        description: "How long to wait for a window (default 10, 0 to not wait).",
+      }),
+    ),
+    focus: Schema.optional(
+      Schema.Boolean.annotate({
+        description:
+          "Bring the app's windows to the front (default false). Only when the user asked to see the app, since it takes them away from what they're doing.",
+      }),
+    ),
+  },
+  { title: "Launch app" },
+);
+
+export const SnapshotWindowTool = Tool.make("snapshot_window", {
+  description:
+    "Take a screenshot of one of this thread's app windows, even if the user isn't looking at it: a PNG of the window's contents only. Points for click_window and the other window tools are in this image's pixels. Menus and other popups don't appear in it.",
+  parameters: Schema.Struct({ window_id: windowId }),
+  success: Schema.Struct({
+    window_id: Schema.Int,
+    screenshot: Schema.Struct({
+      mimeType: Schema.Literal("image/png"),
+      data: Schema.String,
+      width: Schema.Int,
+      height: Schema.Int,
+    }),
+  }),
+  failure: WindowToolFailure,
+  dependencies,
+})
+  .annotate(Tool.Title, "Screenshot app window")
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false)
+  .annotate(Tool.Idempotent, true)
+  .annotate(Tool.OpenWorld, true);
+
+const ClickWindowTool = windowTool(
+  "click_window",
+  "Click in one of this thread's app windows at a point of its snapshot_window image. The app gets the click even if the user isn't looking at it, and the user's own pointer and keyboard stay where they are. Take a new snapshot to see what happened.",
+  {
+    window_id: windowId,
+    x: coordinate("x"),
+    y: coordinate("y"),
+    button,
+    count: Schema.optional(
+      Schema.Literals([1, 2, 3]).annotate({ description: "2 for a double click (default 1)." }),
+    ),
+  },
+  { title: "Click in app window" },
+);
+
+const HoverWindowTool = windowTool(
+  "hover_window",
+  "Move the pointer to a point in one of this thread's app windows (for tooltips and hover menus).",
+  { window_id: windowId, x: coordinate("x"), y: coordinate("y") },
+  { title: "Hover in app window" },
+);
+
+const DragWindowTool = windowTool(
+  "drag_window",
+  "Press at one point of one of this thread's app windows, move to another and release there: to draw, select, or move things.",
+  { window_id: windowId, from: point, to: point, button },
+  { title: "Drag in app window" },
+);
+
+const ScrollWindowTool = windowTool(
+  "scroll_window",
+  "Turn the mouse wheel over a point in one of this thread's app windows.",
+  {
+    window_id: windowId,
+    x: coordinate("x"),
+    y: coordinate("y"),
+    dy: Schema.optional(
+      Schema.Number.annotate({ description: "Wheel notches down (negative: up)." }),
+    ),
+    dx: Schema.optional(
+      Schema.Number.annotate({ description: "Wheel notches right (negative: left)." }),
+    ),
+  },
+  { title: "Scroll in app window" },
+);
+
+const TypeWindowTool = windowTool(
+  "type_window",
+  "Type text into one of this thread's app windows, as from a keyboard, into whatever in the window has the keyboard (click a field first). The window gets the keys even if the user is typing elsewhere. Keys are a US keyboard's: other characters are refused. A newline presses Enter; after an Enter that should move the focus (a toolbar box, a dialog field), click where the next text goes.",
+  { window_id: windowId, text: Schema.String },
+  { title: "Type in app window" },
+);
+
+const PressWindowTool = windowTool(
+  "press_window",
+  'Press keys in one of this thread\'s app windows: "Enter", "Escape", "ctrl+s", "ctrl+shift+t", "alt+F4", "Down", "ctrl+]", or a list of them pressed in turn.',
+  {
+    window_id: windowId,
+    keys: Schema.Union([Schema.String, Schema.Array(Schema.String)]).annotate({
+      description: "A key combination, or a list of them.",
+    }),
+  },
+  { title: "Press keys in app window" },
+);
+
+const ResizeWindowTool = windowTool(
+  "resize_window",
+  "Ask the app to resize one of this thread's windows (in the sizes list_windows gives). Only while the user isn't looking at it: then the desktop decides its size.",
+  { window_id: windowId, width: Schema.Int, height: Schema.Int },
+  { title: "Resize app window" },
+);
+
+const FocusWindowTool = windowTool(
+  "focus_window",
+  "Show one of this thread's app windows to the user (the desktop opens or raises it). Only when they asked to see it.",
+  { window_id: windowId },
+  { title: "Show app window" },
+);
+
+const CloseWindowTool = windowTool(
+  "close_window",
+  "Ask one of this thread's app windows to close, as its close button would. The app may refuse or ask the user first; the result says whether the window went away.",
+  { window_id: windowId },
+  { title: "Close app window", destructive: true },
+);
+
+export const WindowStandardToolkit = Toolkit.make(
+  ListWindowsTool,
+  LaunchAppTool,
+  ClickWindowTool,
+  HoverWindowTool,
+  DragWindowTool,
+  ScrollWindowTool,
+  TypeWindowTool,
+  PressWindowTool,
+  ResizeWindowTool,
+  FocusWindowTool,
+  CloseWindowTool,
+);
+
+export const WindowSnapshotToolkit = Toolkit.make(SnapshotWindowTool);
+
+// The helper runs them.
+
+type HelperContent =
+  | { readonly type: "text"; readonly text: string }
+  | { readonly type: "image"; readonly data: string; readonly mimeType: string };
+
+const decodeAnswer = Schema.decodeUnknownEffect(
+  Schema.fromJsonString(
+    Schema.Struct({
+      content: Schema.optional(Schema.Array(Schema.Unknown)),
+      isError: Schema.optional(Schema.Boolean),
+      error: Schema.optional(Schema.String),
+    }),
+  ),
+);
+const decodeJson = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Unknown));
+
+const REQUEST_TIMEOUT_MS = 120_000;
+
+const failure = (message: string) => new PlutoniumWindowToolError({ message });
+
+const texts = (content: readonly HelperContent[]) =>
+  content.flatMap((part) => (part.type === "text" ? [part.text] : [])).join("\n");
+
+/** Runs one of the helper's tools for the calling thread: its content, or why it failed. */
+const callHelper = (name: string, args: unknown) =>
+  Effect.gen(function* () {
+    const socketPath = plutoniumHelperSocket();
+    if (socketPath === undefined) {
+      return yield* failure("This T3 Code server doesn't run in a Plutonium session.");
+    }
+    const scope = yield* McpInvocationContext.McpInvocationContext;
+    const { thread } = yield* McpInvocationContext.requireThreadScope(scope, "This tool");
+    const tag = encodeURIComponent(plutoniumThreadTag(thread.threadId));
+    const { status, text } = yield* Effect.tryPromise({
+      try: () =>
+        new Promise<{ readonly status: number; readonly text: string }>((resolve, reject) => {
+          const request = NodeHttp.request(
+            {
+              socketPath,
+              method: "POST",
+              path: `/v1/threads/${tag}/mcp/call`,
+              timeout: REQUEST_TIMEOUT_MS,
+              headers: { "Content-Type": "application/json" },
+            },
+            (response) => {
+              let body = "";
+              response.setEncoding("utf8");
+              response.on("data", (chunk: string) => (body += chunk));
+              response.on("end", () => resolve({ status: response.statusCode ?? 500, text: body }));
+            },
+          );
+          request.on("timeout", () => request.destroy());
+          request.on("error", reject);
+          request.end(JSON.stringify({ name, arguments: args ?? {} }));
+        }),
+      catch: () => failure("The Plutonium helper didn't answer."),
+    });
+    const answer = yield* decodeAnswer(text).pipe(
+      Effect.mapError(() => failure(`The Plutonium helper said ${status}.`)),
+    );
+    const content = (answer.content ?? []) as readonly HelperContent[];
+    if (status === 404 && content.length === 0) {
+      // A helper older than these tools has no route for them.
+      return yield* failure(
+        "The Plutonium helper running this session doesn't have the window tools (it predates them). Window control is unavailable until the session's helper is updated and restarted; tell the user.",
+      );
+    }
+    if (status >= 400 || answer.isError === true) {
+      return yield* failure(
+        texts(content) || answer.error || `The Plutonium helper said ${status}.`,
+      );
+    }
+    return content;
+  });
+
+/** The helper's text, as JSON when it is. */
+const forward = (name: string) => (args: unknown) =>
+  callHelper(name, args).pipe(
+    Effect.map((content) => {
+      const text = texts(content);
+      return { result: Option.getOrElse(decodeJson(text), () => text) };
+    }),
+  );
+
+/** A PNG's size, from its header. */
+const pngSize = (data: string) => {
+  const header = Buffer.from(data.slice(0, 32), "base64");
+  return { width: header.readUInt32BE(16), height: header.readUInt32BE(20) };
+};
+
+export const layerStandard = McpToolAccess.toLayer(WindowStandardToolkit, {
+  list_windows: McpToolAccess.readsAsCaller(forward("list_windows")),
+  launch_app: McpToolAccess.actsAsCaller(forward("launch_app")),
+  click_window: McpToolAccess.actsAsCaller(forward("click_window")),
+  hover_window: McpToolAccess.actsAsCaller(forward("hover_window")),
+  drag_window: McpToolAccess.actsAsCaller(forward("drag_window")),
+  scroll_window: McpToolAccess.actsAsCaller(forward("scroll_window")),
+  type_window: McpToolAccess.actsAsCaller(forward("type_window")),
+  press_window: McpToolAccess.actsAsCaller(forward("press_window")),
+  resize_window: McpToolAccess.actsAsCaller(forward("resize_window")),
+  focus_window: McpToolAccess.actsAsCaller(forward("focus_window")),
+  close_window: McpToolAccess.actsAsCaller(forward("close_window")),
+});
+
+export const layerSnapshot = McpToolAccess.toLayer(WindowSnapshotToolkit, {
+  snapshot_window: McpToolAccess.readsAsCaller((input) =>
+    callHelper("snapshot_window", input).pipe(
+      Effect.flatMap((content) => {
+        const image = content.find((part) => part.type === "image");
+        return image?.mimeType === "image/png"
+          ? Effect.succeed({
+              window_id: input.window_id,
+              screenshot: {
+                mimeType: "image/png" as const,
+                data: image.data,
+                ...pngSize(image.data),
+              },
+            })
+          : Effect.fail(failure(texts(content) || "The window gave no image."));
+      }),
+    ),
+  ),
+});
