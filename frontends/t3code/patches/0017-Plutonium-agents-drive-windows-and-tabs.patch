@@ -0,0 +1,167 @@
+// @effect-diagnostics nodeBuiltinImport:off - a fake Plutonium helper on a Unix socket
+import { expect, it } from "@effect/vitest";
+import { EnvironmentId, ProviderInstanceId, ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import { McpSchema, McpServer } from "effect/ai";
+import * as NodeFs from "node:fs";
+import * as NodeHttp from "node:http";
+import * as NodeOs from "node:os";
+import * as NodePath from "node:path";
+
+import * as McpInvocationContext from "../mcp/McpInvocationContext.ts";
+import * as PlutoniumWindowTools from "./windowTools.ts";
+
+const threadId = ThreadId.make("thread-windows-test");
+const invocation = (thread: boolean) => ({
+  environmentId: EnvironmentId.make("environment-windows-test"),
+  requestNamespace: "provider-session-windows-test",
+  thread: thread
+    ? {
+        threadId,
+        providerSessionId: "provider-session-windows-test",
+        providerInstanceId: ProviderInstanceId.make("codex"),
+      }
+    : undefined,
+  client: thread
+    ? undefined
+    : { sessionId: "client", label: "client", access: "read-only" as const },
+  capabilities: new Set<McpInvocationContext.McpCapability>(),
+  issuedAt: 1,
+});
+const client = McpSchema.McpServerClient.of({
+  clientId: 1,
+  clientCapabilities: {},
+  clientInfo: { name: "mcp-test", version: "1.0.0" },
+  protocolVersion: "2025-06-18",
+  initializePayload: {
+    protocolVersion: "2025-06-18",
+    capabilities: {},
+    clientInfo: { name: "mcp-test", version: "1.0.0" },
+  },
+  getClient: Effect.die("unused"),
+});
+
+/** A helper that lists two window tools and answers calls with what it was asked. */
+const fakeHelper = Effect.acquireRelease(
+  Effect.promise(async () => {
+    const dir = NodeFs.mkdtempSync(NodePath.join(NodeOs.tmpdir(), "t3-plutonium-windows-"));
+    const socketPath = NodePath.join(dir, "helper.sock");
+    const calls: Array<{ readonly path: string; readonly body: unknown }> = [];
+    const server = NodeHttp.createServer((request, response) => {
+      let body = "";
+      request.on("data", (chunk: Buffer) => (body += chunk.toString("utf8")));
+      request.on("end", () => {
+        response.setHeader("Content-Type", "application/json");
+        if (request.method === "GET" && request.url === "/v1/mcp/tools?set=windows") {
+          response.end(
+            JSON.stringify({
+              tools: [
+                {
+                  name: "list_windows",
+                  description: "List windows.",
+                  inputSchema: { type: "object", properties: {} },
+                },
+                {
+                  name: "snapshot_window",
+                  description: "Snapshot a window.",
+                  inputSchema: {
+                    type: "object",
+                    properties: { window_id: { type: "integer" } },
+                    required: ["window_id"],
+                  },
+                },
+              ],
+            }),
+          );
+          return;
+        }
+        calls.push({ path: request.url ?? "", body: JSON.parse(body) });
+        const { name } = JSON.parse(body) as { name: string };
+        response.end(
+          JSON.stringify(
+            name === "snapshot_window"
+              ? { content: [{ type: "image", data: "iVBORw0K", mimeType: "image/png" }] }
+              : { content: [{ type: "text", text: "[]" }] },
+          ),
+        );
+      });
+    });
+    await new Promise<void>((resolve) => server.listen(socketPath, resolve));
+    return { dir, server, socketPath, calls };
+  }),
+  ({ dir, server }) =>
+    Effect.promise(
+      () =>
+        new Promise<void>((resolve) =>
+          server.close(() => {
+            NodeFs.rmSync(dir, { recursive: true, force: true });
+            resolve();
+          }),
+        ),
+    ),
+);
+
+it.effect("offers the helper's window tools and runs them for the calling thread", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const helper = yield* fakeHelper;
+      const previous = process.env.PLUTONIUM_HELPER;
+      process.env.PLUTONIUM_HELPER = helper.socketPath;
+      yield* Effect.addFinalizer(() =>
+        Effect.sync(() => {
+          if (previous === undefined) delete process.env.PLUTONIUM_HELPER;
+          else process.env.PLUTONIUM_HELPER = previous;
+        }),
+      );
+      const server = yield* Effect.provide(
+        McpServer.McpServer,
+        PlutoniumWindowTools.layer.pipe(Layer.provideMerge(McpServer.McpServer.layer)),
+      );
+      expect(server.tools.map(({ tool }) => tool.name).toSorted()).toEqual([
+        "list_windows",
+        "snapshot_window",
+      ]);
+
+      const call = (name: string, args: Record<string, unknown>, thread = true) =>
+        server
+          .callTool({ name, arguments: args })
+          .pipe(
+            Effect.provideService(McpInvocationContext.McpInvocationContext, invocation(thread)),
+            Effect.provideService(McpSchema.McpServerClient, client),
+          );
+
+      const shot = yield* call("snapshot_window", { window_id: 3 });
+      expect(shot.isError).toBe(false);
+      expect(shot.content.map((entry) => entry.type)).toEqual(["image"]);
+      expect(helper.calls).toEqual([
+        {
+          path: `/v1/threads/${encodeURIComponent(`t3:thread/${threadId}`)}/mcp/call`,
+          body: { name: "snapshot_window", arguments: { window_id: 3 } },
+        },
+      ]);
+
+      const refused = yield* call("list_windows", {}, false);
+      expect(refused.isError).toBe(true);
+      expect(helper.calls).toHaveLength(1);
+    }),
+  ),
+);
+
+it.effect("offers nothing outside a Plutonium session", () =>
+  Effect.gen(function* () {
+    const previous = {
+      helper: process.env.PLUTONIUM_HELPER,
+      display: process.env.PLUTONIUM_WAYLAND_DISPLAY,
+    };
+    delete process.env.PLUTONIUM_HELPER;
+    delete process.env.PLUTONIUM_WAYLAND_DISPLAY;
+    const server = yield* Effect.provide(
+      McpServer.McpServer,
+      PlutoniumWindowTools.layer.pipe(Layer.provideMerge(McpServer.McpServer.layer)),
+    );
+    if (previous.helper !== undefined) process.env.PLUTONIUM_HELPER = previous.helper;
+    if (previous.display !== undefined) process.env.PLUTONIUM_WAYLAND_DISPLAY = previous.display;
+    expect(server.tools).toEqual([]);
+  }),
+);
diff --git a/apps/server/src/plutonium/windowTools.ts b/apps/server/src/plutonium/windowTools.ts
new file mode 100644
index 0000000000..4ca9930d0d
--- /dev/null
+++ b/apps/server/src/plutonium/windowTools.ts
@@ -0,0 +1,163 @@
+// @effect-diagnostics nodeBuiltinImport:off - requests go to the Plutonium helper's Unix socket
+/**
+ * Plutonium: the helper's native window tools (launch_app, snapshot_window,
+ * click_window, type_window, ...) on T3 Code's own MCP server, so every
+ * provider's agents can use the apps of their thread, not only those that
+ * take the helper's stdio MCP server. Tabs are T3's preview tools' already.
+ *
+ * The helper defines the tools (GET /v1/mcp/tools?set=windows) and runs them
+ * for a thread (POST /v1/threads/:tag/mcp/call); this file only registers
+ * them when the server runs in a Plutonium session, and forwards each call
+ * with the calling thread's tag. A client caller has no thread, and no
+ * windows.
+ */
+import * as Context from "effect/Context";
+import * as Data from "effect/Data";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import { McpSchema, McpServer } from "effect/ai";
+import * as NodeHttp from "node:http";
+
+import { plutoniumHelperSocket, plutoniumThreadTag } from "@t3tools/shared/plutonium";
+
+import * as McpInvocationContext from "../mcp/McpInvocationContext.ts";
+
+interface HelperTool {
+  readonly name: string;
+  readonly description: string;
+  readonly inputSchema: Record<string, unknown>;
+}
+
+type HelperContent =
+  | { readonly type: "text"; readonly text: string }
+  | { readonly type: "image"; readonly data: string; readonly mimeType: string };
+
+const READ_ONLY = new Set(["list_windows", "snapshot_window"]);
+const REQUEST_TIMEOUT_MS = 120_000;
+
+const decodeJson = Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Unknown));
+
+class PlutoniumHelperError extends Data.TaggedError("PlutoniumHelperError")<{
+  readonly message: string;
+}> {}
+
+const helperRequest = (socketPath: string, method: string, path: string, body?: unknown) =>
+  Effect.tryPromise({
+    try: () =>
+      new Promise<{ readonly status: number; readonly text: string }>((resolve, reject) => {
+        const payload = body === undefined ? undefined : JSON.stringify(body);
+        const request = NodeHttp.request(
+          {
+            socketPath,
+            method,
+            path,
+            timeout: REQUEST_TIMEOUT_MS,
+            headers: payload === undefined ? {} : { "Content-Type": "application/json" },
+          },
+          (response) => {
+            let text = "";
+            response.setEncoding("utf8");
+            response.on("data", (chunk: string) => (text += chunk));
+            response.on("end", () => resolve({ status: response.statusCode ?? 500, text }));
+          },
+        );
+        request.on("timeout", () => request.destroy());
+        request.on("error", reject);
+        request.end(payload);
+      }),
+    catch: () => new PlutoniumHelperError({ message: "The Plutonium helper didn't answer." }),
+  }).pipe(
+    Effect.flatMap(({ status, text }) =>
+      decodeJson(text).pipe(
+        Effect.mapError(
+          () => new PlutoniumHelperError({ message: `The Plutonium helper said ${status}.` }),
+        ),
+        Effect.filterOrFail(
+          () => status < 400,
+          (value) =>
+            new PlutoniumHelperError({
+              message:
+                (value as { readonly error?: string } | null)?.error ??
+                `The Plutonium helper said ${status}.`,
+            }),
+        ),
+      ),
+    ),
+  );
+
+const textResult = (text: string, isError: boolean) =>
+  new McpSchema.CallToolResult({ isError, content: [{ type: "text", text }] });
+
+const register = Effect.gen(function* () {
+  const socketPath = plutoniumHelperSocket();
+  if (socketPath === undefined) return;
+  const listed = yield* helperRequest(socketPath, "GET", "/v1/mcp/tools?set=windows").pipe(
+    Effect.timeout("5 seconds"),
+    Effect.catchCause((cause) =>
+      Effect.logWarning("Plutonium: no window tools (the helper didn't list them)", { cause }).pipe(
+        Effect.as(undefined),
+      ),
+    ),
+  );
+  const tools = (listed as { readonly tools?: readonly HelperTool[] } | undefined)?.tools ?? [];
+  const server = yield* McpServer.McpServer;
+  for (const tool of tools) {
+    yield* server.addTool({
+      tool: new McpSchema.Tool({
+        name: tool.name,
+        description: tool.description,
+        inputSchema: tool.inputSchema,
+        annotations: {
+          readOnlyHint: READ_ONLY.has(tool.name),
+          destructiveHint: tool.name === "close_window",
+          openWorldHint: true,
+        },
+      }),
+      annotations: Context.empty(),
+      handle: (payload) =>
+        Effect.withFiber((fiber) => {
+          const invocation = Context.getUnsafe(
+            fiber.context,
+            McpInvocationContext.McpInvocationContext,
+          );
+          if (invocation.thread === undefined) {
+            return Effect.succeed(
+              textResult(
+                "Native windows belong to threads: only a thread's agent can use them.",
+                true,
+              ),
+            );
+          }
+          const tag = encodeURIComponent(plutoniumThreadTag(invocation.thread.threadId));
+          return helperRequest(socketPath, "POST", `/v1/threads/${tag}/mcp/call`, {
+            name: tool.name,
+            arguments: payload ?? {},
+          }).pipe(
+            Effect.map((value) => {
+              const { content, isError } = value as {
+                readonly content: readonly HelperContent[];
+                readonly isError?: boolean;
+              };
+              return new McpSchema.CallToolResult({
+                isError: isError === true,
+                content: content.map((part) =>
+                  part.type === "image"
+                    ? {
+                        type: "image" as const,
+                        data: new Uint8Array(Buffer.from(part.data, "base64")),
+                        mimeType: part.mimeType,
+                      }
+                    : { type: "text" as const, text: part.text },
+                ),
+              });
+            }),
+            Effect.catch((error) => Effect.succeed(textResult(error.message, true))),
+          );
+        }),
+    });
+  }
+});
+
+/** Registers the helper's window tools on `/mcp` in a Plutonium session; nothing otherwise. */
+export const layer = Layer.effectDiscard(register);
