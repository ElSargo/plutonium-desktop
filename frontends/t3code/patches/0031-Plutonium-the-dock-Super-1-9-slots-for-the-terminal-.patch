+import { describe, expect, it, vi } from "vite-plus/test";
+
+vi.mock("~/components/ui/toast", () => ({ toastManager: { add: vi.fn() } }));
+
+import { sameApp, scopeOfWindow, siteMatchOf } from "./dock";
+import type { NativeWindowEntry } from "./windowStore";
+
+const window = (tags: string[]): NativeWindowEntry => ({
+  id: 1,
+  appId: "foot",
+  title: "foot",
+  width: 800,
+  height: 600,
+  deviceScaleFactor: 1,
+  embedded: false,
+  focused: false,
+  pid: 1,
+  threadId: tags[0] ?? null,
+  tags,
+});
+
+describe("the dock", () => {
+  it("matches a desktop entry to its windows' app id", () => {
+    expect(sameApp("foot.desktop", "foot")).toBe(true);
+    expect(sameApp("org.gnome.Nautilus", "org.gnome.Nautilus")).toBe(true);
+    expect(sameApp("nautilus", "org.gnome.Nautilus")).toBe(true);
+    expect(sameApp("firefox", "foot")).toBe(false);
+  });
+
+  it("puts a window in the last scope T3 added", () => {
+    expect(scopeOfWindow(window(["t3:thread/a"]))).toBe("thread");
+    expect(scopeOfWindow(window(["t3:thread/a", "t3:project/p"]))).toBe("project");
+    expect(scopeOfWindow(window(["t3:thread/a", "t3:project/p", "t3:global"]))).toBe("global");
+    expect(scopeOfWindow(window(["niri:desktop"]))).toBe("thread");
+  });
+
+  it("matches a site by its own prefix, else its origin", () => {
+    expect(siteMatchOf({ kind: "site", url: "https://github.com/a/b/pulls", name: "b" })).toBe(
+      "https://github.com",
+    );
+    expect(
+      siteMatchOf({
+        kind: "site",
+        url: "https://github.com/a/b",
+        match: "https://github.com/a/b",
+        name: "b",
+      }),
+    ).toBe("https://github.com/a/b");
+  });
+});
