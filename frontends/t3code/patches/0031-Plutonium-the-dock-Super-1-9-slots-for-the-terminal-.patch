+// Plutonium: the dock. Nine slots on Super+1…9, each T3's terminal drawer, an
+// app or a site, kept per thread, per project or everywhere. A slot's key
+// starts what it names, shows it, gives it the keyboard, and goes back to
+// where you were when pressed again (plutonium-desktop
+// docs/features/T3_DOCK.md).
+//
+// A scope is a Plutonium tag: an app started for a slot runs with its scope's
+// tag as PLUTONIUM_THREAD_ID, so its windows carry it, and a window put in a
+// slot from the panel gets the slot scope's tag added.
+import type { ScopedThreadRef } from "@t3tools/contracts";
+import { scopedThreadKey } from "@t3tools/client-runtime/environment";
+import { create } from "zustand";
+import { createJSONStorage, persist } from "zustand/middleware";
+
+import { toastManager } from "~/components/ui/toast";
+import { resolveStorage } from "~/lib/storage";
+import { readThreadPreviewState } from "~/previewStateStore";
+import { type RightPanelSurface, useRightPanelStore } from "~/rightPanelStore";
+
+import { focusRightPanelSurface } from "./panelKeys";
+import { GLOBAL_TAG, projectTag } from "./threadTag";
+import {
+  type NativeWindowEntry,
+  plutoniumShell,
+  threadTag,
+  usePlutoniumWindowStore,
+  windowTags,
+} from "./windowStore";
+
+export const DOCK_SLOT_NUMBERS = [1, 2, 3, 4, 5, 6, 7, 8, 9] as const;
+export type DockSlotNumber = (typeof DOCK_SLOT_NUMBERS)[number];
+
+export type DockScope = "thread" | "project" | "global";
+export type DockLayout = "split" | "fold";
+
+export type DockTarget =
+  /** T3's terminal drawer, below the chat. */
+  | { readonly kind: "terminal" }
+  | {
+      readonly kind: "app";
+      /** The desktop entry that starts it; null if none was found (it can't be started). */
+      readonly desktopId: string | null;
+      /** Its windows' app id, once seen. */
+      readonly windowAppId: string | null;
+      readonly name: string;
+    }
+  | {
+      readonly kind: "site";
+      readonly url: string;
+      /** Tabs whose address starts with this belong to the slot (default: the URL's origin). */
+      readonly match?: string;
+      readonly name: string;
+    };
+
+export interface DockSlot {
+  readonly target: DockTarget;
+  readonly scope: DockScope;
+  readonly layout: DockLayout;
+}
+
+const DEFAULT_SLOTS: Partial<Record<DockSlotNumber, DockSlot>> = {
+  1: { target: { kind: "terminal" }, scope: "thread", layout: "split" },
+};
+
+/** Where a slot's key came from, to go back to on the next press. */
+interface ReturnPoint {
+  readonly slot: DockSlotNumber;
+  readonly panelOpen: boolean;
+  readonly activeSurfaceId: string | null;
+  readonly maximized: boolean;
+  readonly terminalOpen: boolean;
+  readonly terminalFolded: boolean;
+}
+
+interface DockState {
+  readonly slots: Partial<Record<DockSlotNumber, DockSlot>>;
+  /** A thread's own layout for a slot (Super+Up), by thread key, then slot. */
+  readonly layouts: Readonly<Record<string, Partial<Record<DockSlotNumber, DockLayout>>>>;
+  /** Threads whose terminal drawer has the chat column to itself, by thread key. */
+  readonly terminalFolded: Readonly<Record<string, true>>;
+  /** The slot last raised in each thread and what was showing before, by thread key. */
+  readonly returnTo: Readonly<Record<string, ReturnPoint>>;
+  setSlot(slot: DockSlotNumber, value: DockSlot | null): void;
+  setThreadLayout(threadKey: string, slot: DockSlotNumber, layout: DockLayout): void;
+  setTerminalFolded(threadKey: string, folded: boolean): void;
+  setReturnTo(threadKey: string, point: ReturnPoint | null): void;
+}
+
+export const useDockStore = create<DockState>()(
+  persist(
+    (set) => ({
+      slots: DEFAULT_SLOTS,
+      layouts: {},
+      terminalFolded: {},
+      returnTo: {},
+      setSlot: (slot, value) =>
+        set((state) => {
+          const slots = { ...state.slots };
+          if (value) slots[slot] = value;
+          else delete slots[slot];
+          return { slots };
+        }),
+      setThreadLayout: (threadKey, slot, layout) =>
+        set((state) => ({
+          layouts: {
+            ...state.layouts,
+            [threadKey]: { ...state.layouts[threadKey], [slot]: layout },
+          },
+        })),
+      setTerminalFolded: (threadKey, folded) =>
+        set((state) => {
+          if (Boolean(state.terminalFolded[threadKey]) === folded) return state;
+          const terminalFolded = { ...state.terminalFolded };
+          if (folded) terminalFolded[threadKey] = true;
+          else delete terminalFolded[threadKey];
+          return { terminalFolded };
+        }),
+      setReturnTo: (threadKey, point) =>
+        set((state) => {
+          const returnTo = { ...state.returnTo };
+          if (point) returnTo[threadKey] = point;
+          else delete returnTo[threadKey];
+          return { returnTo };
+        }),
+    }),
+    {
+      name: "t3code:plutonium-dock:v1",
+      version: 1,
+      storage: createJSONStorage(() =>
+        resolveStorage(typeof window !== "undefined" ? window.localStorage : undefined),
+      ),
+      // Where to go back to only holds while the page lives.
+      partialize: (state) => ({
+        slots: state.slots,
+        layouts: state.layouts,
+        terminalFolded: state.terminalFolded,
+      }),
+    },
+  ),
+);
+
+/** Whether `threadRef`'s terminal drawer has the chat column to itself. */
+export function useTerminalFolded(threadRef: ScopedThreadRef | null): boolean {
+  const key = threadRef ? scopedThreadKey(threadRef) : null;
+  return useDockStore((state) => (key ? state.terminalFolded[key] === true : false));
+}
+
+/** What ChatView lends the dock: the active thread and its panel and terminal. */
+export interface DockContext {
+  readonly threadRef: ScopedThreadRef;
+  readonly projectId: string | null;
+  readonly surfaces: readonly RightPanelSurface[];
+  readonly activeSurfaceId: string | null;
+  readonly panelOpen: boolean;
+  readonly maximized: boolean;
+  readonly terminalOpen: boolean;
+  /** Opens the terminal drawer (starting a terminal if there is none) and focuses it. */
+  readonly openTerminal: () => void;
+  readonly closeTerminal: () => void;
+  readonly focusTerminal: () => void;
+  readonly focusComposer: () => void;
+  readonly activate: (surface: RightPanelSurface) => void;
+  /** Opens a browser tab at `url` in the thread's panel. */
+  readonly openSite: (url: string) => Promise<void>;
+}
+
+/** The tag a slot's things carry in `context`'s thread, or null (a project slot with no project). */
+export function scopeTagOf(
+  scope: DockScope,
+  context: Pick<DockContext, "threadRef" | "projectId">,
+): string | null {
+  if (scope === "global") return GLOBAL_TAG;
+  if (scope === "project") return context.projectId ? projectTag(context.projectId) : null;
+  return threadTag(context.threadRef.threadId);
+}
+
+/** The scope a window was put in: the last scope tag T3 added, else its origin's. */
+export function scopeOfWindow(entry: NativeWindowEntry): DockScope {
+  const tags = windowTags(entry);
+  for (let index = tags.length - 1; index >= 0; index -= 1) {
+    const tag = tags[index]!;
+    if (tag === GLOBAL_TAG) return "global";
+    if (tag.startsWith("t3:project/")) return "project";
+    if (tag.startsWith("t3:thread/")) return "thread";
+  }
+  return "thread";
+}
+
+const normalizeAppId = (id: string) => id.toLowerCase().replace(/\.desktop$/, "");
+
+/** Whether window app id `windowAppId` is desktop entry `desktopId`'s (org.gnome.Nautilus ~ nautilus). */
+export function sameApp(desktopId: string, windowAppId: string): boolean {
+  const a = normalizeAppId(desktopId);
+  const b = normalizeAppId(windowAppId);
+  return a === b || a.split(".").at(-1) === b.split(".").at(-1);
+}
+
+function windowMatches(target: Extract<DockTarget, { kind: "app" }>, entry: NativeWindowEntry) {
+  if (target.windowAppId) return entry.appId === target.windowAppId;
+  return target.desktopId !== null && sameApp(target.desktopId, entry.appId);
+}
+
+/** The slot's windows in `tag`, oldest first. */
+function slotWindows(
+  target: Extract<DockTarget, { kind: "app" }>,
+  tag: string,
+): NativeWindowEntry[] {
+  return Object.values(usePlutoniumWindowStore.getState().windows)
+    .filter((entry) => windowTags(entry).includes(tag) && windowMatches(target, entry))
+    .toSorted((a, b) => a.id - b.id);
+}
+
+/** What a site slot matches: its own prefix, else its URL's origin. */
+export function siteMatchOf(target: Extract<DockTarget, { kind: "site" }>): string {
+  if (target.match) return target.match;
+  try {
+    return new URL(target.url).origin;
+  } catch {
+    return target.url;
+  }
+}
+
+/** The thread's browser tabs (server tab ids) that belong to the site slot, oldest first. */
+function slotTabs(target: Extract<DockTarget, { kind: "site" }>, threadRef: ScopedThreadRef) {
+  const prefix = siteMatchOf(target);
+  return Object.values(readThreadPreviewState(threadRef).sessions)
+    .filter((session) => {
+      const status = session.navStatus as { url?: string };
+      return typeof status.url === "string" && status.url.startsWith(prefix);
+    })
+    .map((session) => session.tabId as string);
+}
+
+const appSurface = (entry: NativeWindowEntry): RightPanelSurface => ({
+  id: `app:${entry.id}`,
+  kind: "app",
+  windowId: entry.id,
+  appId: entry.appId,
+});
+
+const browserSurface = (tabId: string): RightPanelSurface => ({
+  id: `browser:${tabId}`,
+  kind: "preview",
+  resourceId: tabId,
+});
+
+function terminalHasKeyboard(): boolean {
+  return (
+    document.activeElement?.closest(
+      '[data-thread-terminal-drawer][data-terminal-owner="drawer"]',
+    ) != null
+  );
+}
+
+function surfaceHasKeyboard(surface: RightPanelSurface): boolean {
+  if (surface.kind === "app") {
+    return usePlutoniumWindowStore.getState().windows[surface.windowId]?.focused === true;
+  }
+  if (surface.kind === "preview" && surface.resourceId) {
+    const active = document.activeElement;
+    return active instanceof HTMLElement && active.dataset.previewServerTab === surface.resourceId;
+  }
+  return false;
+}
+
+/** Slot `slot`'s layout in `threadKey`: the thread's own choice, else the slot's. */
+function layoutOf(state: DockState, threadKey: string, slot: DockSlotNumber): DockLayout {
+  return state.layouts[threadKey]?.[slot] ?? state.slots[slot]?.layout ?? "split";
+}
+
+const otherLayout = (layout: DockLayout): DockLayout => (layout === "fold" ? "split" : "fold");
+
+/** Goes back to what showed before `point.slot`'s key was pressed. */
+function goBack(context: DockContext, point: ReturnPoint): void {
+  const key = scopedThreadKey(context.threadRef);
+  const dock = useDockStore.getState();
+  const panel = useRightPanelStore.getState();
+  dock.setReturnTo(key, null);
+  dock.setTerminalFolded(key, point.terminalFolded);
+  if (!point.terminalOpen && context.terminalOpen) context.closeTerminal();
+  panel.setMaximized(context.threadRef, point.maximized);
+  const before = point.activeSurfaceId
+    ? context.surfaces.find((surface) => surface.id === point.activeSurfaceId)
+    : undefined;
+  if (before) context.activate(before);
+  if (!point.panelOpen) panel.close(context.threadRef);
+  context.focusComposer();
+}
+
+/** Remembers what shows now, unless this slot already did (pressing it again cycles). */
+function rememberReturn(context: DockContext, slot: DockSlotNumber): void {
+  const key = scopedThreadKey(context.threadRef);
+  const dock = useDockStore.getState();
+  if (dock.returnTo[key]?.slot === slot) return;
+  dock.setReturnTo(key, {
+    slot,
+    panelOpen: context.panelOpen,
+    activeSurfaceId: context.activeSurfaceId,
+    maximized: context.maximized,
+    terminalOpen: context.terminalOpen,
+    terminalFolded: dock.terminalFolded[key] === true,
+  });
+}
+
+/** Shows `surface` in the panel, laid out as `layout`, with the keyboard. */
+function raiseSurface(context: DockContext, surface: RightPanelSurface, layout: DockLayout): void {
+  const panel = useRightPanelStore.getState();
+  if (context.surfaces.some((entry) => entry.id === surface.id)) {
+    context.activate(surface);
+  } else if (surface.kind === "app") {
+    panel.openApp(context.threadRef, { windowId: surface.windowId, appId: surface.appId });
+  } else if (surface.kind === "preview" && surface.resourceId) {
+    panel.openBrowser(context.threadRef, surface.resourceId);
+  }
+  panel.show(context.threadRef);
+  panel.setMaximized(context.threadRef, layout === "fold");
+  void focusRightPanelSurface(surface);
+}
+
+const WINDOW_WAIT_MS = 60_000;
+
+/** Starts the slot's app in `tag` and raises its first new window. */
+async function launchSlotApp(
+  context: DockContext,
+  slotNumber: DockSlotNumber,
+  target: Extract<DockTarget, { kind: "app" }>,
+  tag: string,
+  layout: DockLayout,
+): Promise<void> {
+  const shell = await plutoniumShell();
+  if (!shell) return;
+  if (!target.desktopId) {
+    toastManager.add({
+      type: "error",
+      title: `${target.name} isn't running`,
+      description:
+        "No installed app was found to start it. Start it yourself, then Super+Shift+" +
+        `${slotNumber} puts it in the slot again.`,
+    });
+    return;
+  }
+  const known = new Set(Object.keys(usePlutoniumWindowStore.getState().windows).map(Number));
+  let opened = false;
+  const open = () => {
+    const entry = Object.values(usePlutoniumWindowStore.getState().windows)
+      .filter((window) => window.threadId === tag && !known.has(window.id))
+      .toSorted((a, b) => a.id - b.id)[0];
+    if (!entry || opened) return;
+    opened = true;
+    stop();
+    // Its windows are found by their app id from now on.
+    const slot = useDockStore.getState().slots[slotNumber];
+    if (slot?.target.kind === "app" && !slot.target.windowAppId) {
+      useDockStore
+        .getState()
+        .setSlot(slotNumber, { ...slot, target: { ...slot.target, windowAppId: entry.appId } });
+    }
+    raiseSurface(context, appSurface(entry), layout);
+  };
+  const unsubscribe = usePlutoniumWindowStore.subscribe(open);
+  const timer = setTimeout(() => stop(), WINDOW_WAIT_MS);
+  function stop() {
+    unsubscribe();
+    clearTimeout(timer);
+  }
+  toastManager.add({ type: "info", title: `Starting ${target.name}…`, timeout: 2500 });
+  try {
+    await shell.launchApp(tag, target.desktopId);
+  } catch (error) {
+    stop();
+    toastManager.add({
+      type: "error",
+      title: `Could not start ${target.name}`,
+      description: error instanceof Error ? error.message : String(error),
+    });
+  }
+}
+
+/**
+ * Super+N: starts, shows, focuses or puts away slot `slotNumber`'s thing.
+ * `other` lays it out the other way this time (Super+Ctrl+N).
+ */
+export function runDockSlot(
+  context: DockContext,
+  slotNumber: DockSlotNumber,
+  options: { readonly other?: boolean } = {},
+): void {
+  const state = useDockStore.getState();
+  const slot = state.slots[slotNumber];
+  if (!slot) {
+    toastManager.add({
+      type: "info",
+      title: `Super+${slotNumber} is empty`,
+      description: `Super+Shift+${slotNumber} puts what has the keyboard there.`,
+      timeout: 3000,
+    });
+    return;
+  }
+  const key = scopedThreadKey(context.threadRef);
+  const own = layoutOf(state, key, slotNumber);
+  const layout = options.other ? otherLayout(own) : own;
+  const back = state.returnTo[key];
+  const target = slot.target;
+
+  if (target.kind === "terminal") {
+    if (context.terminalOpen && terminalHasKeyboard() && !options.other) {
+      if (back?.slot === slotNumber) goBack(context, back);
+      else context.focusComposer();
+      return;
+    }
+    rememberReturn(context, slotNumber);
+    state.setTerminalFolded(key, layout === "fold");
+    if (context.terminalOpen) context.focusTerminal();
+    else context.openTerminal();
+    return;
+  }
+
+  let candidates: RightPanelSurface[];
+  if (target.kind === "app") {
+    const tag = scopeTagOf(slot.scope, context);
+    if (!tag) {
+      toastManager.add({ type: "info", title: "This thread has no project", timeout: 3000 });
+      return;
+    }
+    candidates = slotWindows(target, tag).map(appSurface);
+    if (candidates.length === 0) {
+      rememberReturn(context, slotNumber);
+      void launchSlotApp(context, slotNumber, target, tag, layout);
+      return;
+    }
+  } else {
+    // Sites live in the thread's own browser tabs, whatever the slot's scope.
+    candidates = slotTabs(target, context.threadRef).map(browserSurface);
+    if (candidates.length === 0) {
+      rememberReturn(context, slotNumber);
+      void context.openSite(target.url).then(() => {
+        useRightPanelStore.getState().setMaximized(context.threadRef, layout === "fold");
+      });
+      return;
+    }
+  }
+
+  const showing = context.panelOpen
+    ? candidates.findIndex((surface) => surface.id === context.activeSurfaceId)
+    : -1;
+  const current = showing >= 0 ? candidates[showing]! : undefined;
+  if (current && surfaceHasKeyboard(current) && !options.other) {
+    // Shown and focused: the next copy, or back to where you were.
+    if (candidates.length > 1) {
+      raiseSurface(context, candidates[(showing + 1) % candidates.length]!, layout);
+    } else if (back?.slot === slotNumber) {
+      goBack(context, back);
+    } else {
+      context.focusComposer();
+    }
+    return;
+  }
+  rememberReturn(context, slotNumber);
+  // Shown: give it the keyboard. Not shown: the newest copy.
+  raiseSurface(context, current ?? candidates.at(-1)!, layout);
+}
+
+/**
+ * Super+Up: the slot showing in this thread goes split ↔ fold, and the
+ * thread keeps that for it. With no slot showing, the panel's maximize.
+ */
+export function toggleDockLayout(context: DockContext): void {
+  const key = scopedThreadKey(context.threadRef);
+  const state = useDockStore.getState();
+  const slotNumber = state.returnTo[key]?.slot;
+  const slot = slotNumber ? state.slots[slotNumber] : undefined;
+  if (slotNumber && slot?.target.kind === "terminal" && context.terminalOpen) {
+    const folded = state.terminalFolded[key] === true;
+    state.setTerminalFolded(key, !folded);
+    state.setThreadLayout(key, slotNumber, folded ? "split" : "fold");
+    context.focusTerminal();
+    return;
+  }
+  const panel = useRightPanelStore.getState();
+  if (!context.panelOpen) return;
+  panel.setMaximized(context.threadRef, !context.maximized);
+  if (slotNumber && slot && slot.target.kind !== "terminal") {
+    state.setThreadLayout(key, slotNumber, context.maximized ? "split" : "fold");
+  }
+}
+
+/** What `surface` would be as a slot's target, and the scope it's in now. */
+async function targetOf(
+  surface: RightPanelSurface,
+  threadRef: ScopedThreadRef,
+): Promise<{ target: DockTarget; scope: DockScope } | null> {
+  if (surface.kind === "app") {
+    const entry = usePlutoniumWindowStore.getState().windows[surface.windowId];
+    if (!entry) return null;
+    const shell = await plutoniumShell();
+    const apps = shell ? await shell.apps().catch(() => []) : [];
+    const app = apps.find((candidate) => sameApp(candidate.id, entry.appId));
+    return {
+      target: {
+        kind: "app",
+        desktopId: app?.id ?? null,
+        windowAppId: entry.appId,
+        name: app?.name ?? (entry.title || entry.appId),
+      },
+      scope: scopeOfWindow(entry),
+    };
+  }
+  if (surface.kind === "preview" && surface.resourceId) {
+    const session = readThreadPreviewState(threadRef).sessions[surface.resourceId];
+    const status = session?.navStatus as { url?: string; title?: string } | undefined;
+    if (!status?.url) return null;
+    let name = status.title || status.url;
+    try {
+      name = status.title || new URL(status.url).host;
+    } catch {
+      // Keep the address.
+    }
+    return { target: { kind: "site", url: status.url, name }, scope: "thread" };
+  }
+  return null;
+}
+
+/** A short name for slot `slot`'s target. */
+export function dockSlotLabel(slot: DockSlot | undefined): string {
+  if (!slot) return "empty";
+  return slot.target.kind === "terminal" ? "Terminal" : slot.target.name;
+}
+
+const SCOPE_LABEL: Record<DockScope, string> = {
+  thread: "this thread",
+  project: "this project",
+  global: "everywhere",
+};
+
+/** Puts `surface` (null: the terminal drawer) in slot `slotNumber`. */
+export async function assignDockSlot(
+  context: Pick<DockContext, "threadRef" | "projectId">,
+  slotNumber: DockSlotNumber,
+  surface: RightPanelSurface | null,
+): Promise<void> {
+  const state = useDockStore.getState();
+  const previous = state.slots[slotNumber];
+  let next: DockSlot;
+  if (surface === null) {
+    next = { target: { kind: "terminal" }, scope: "thread", layout: previous?.layout ?? "split" };
+  } else {
+    const found = await targetOf(surface, context.threadRef);
+    if (!found) {
+      toastManager.add({
+        type: "info",
+        title: "Only apps, browser tabs and the terminal go in the dock",
+        timeout: 3000,
+      });
+      return;
+    }
+    next = { target: found.target, scope: found.scope, layout: previous?.layout ?? "split" };
+  }
+  state.setSlot(slotNumber, next);
+  toastManager.add({
+    type: "success",
+    title: `Super+${slotNumber}: ${dockSlotLabel(next)}`,
+    description: `Kept ${SCOPE_LABEL[next.scope]}.`,
+    timeout: 3000,
+  });
+}
+
+/**
+ * Keeps slot `slotNumber` in `scope`. For an app, the windows showing in
+ * this thread get the scope's tag, so the slot finds them there.
+ */
+export async function setDockSlotScope(
+  context: Pick<DockContext, "threadRef" | "projectId">,
+  slotNumber: DockSlotNumber,
+  scope: DockScope,
+): Promise<void> {
+  const state = useDockStore.getState();
+  const slot = state.slots[slotNumber];
+  if (!slot) return;
+  const tag = scopeTagOf(scope, context);
+  if (!tag) {
+    toastManager.add({ type: "info", title: "This thread has no project", timeout: 3000 });
+    return;
+  }
+  state.setSlot(slotNumber, { ...slot, scope });
+  if (slot.target.kind !== "app") return;
+  const shell = await plutoniumShell();
+  const from = scopeTagOf(slot.scope, context);
+  if (!shell?.tagWindow || !from) return;
+  for (const entry of slotWindows(slot.target, from)) {
+    await shell.tagWindow(entry.id, [tag]).catch(() => undefined);
+  }
+}
+
+/** The slot `surface` is in, if any. */
+export function dockSlotOfSurface(
+  slots: Partial<Record<DockSlotNumber, DockSlot>>,
+  surface: RightPanelSurface,
+  threadRef: ScopedThreadRef,
+): DockSlotNumber | null {
+  for (const number of DOCK_SLOT_NUMBERS) {
+    const target = slots[number]?.target;
+    if (!target) continue;
+    if (target.kind === "app" && surface.kind === "app") {
+      const entry = usePlutoniumWindowStore.getState().windows[surface.windowId];
+      if (entry && windowMatches(target, entry)) return number;
+    }
+    if (target.kind === "site" && surface.kind === "preview" && surface.resourceId) {
+      if (slotTabs(target, threadRef).includes(surface.resourceId)) return number;
+    }
+  }
+  return null;
+}
