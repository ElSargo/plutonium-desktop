+  const closePreview = useAtomCommand(previewEnvironment.close, "preview close");
+  useEffect(() => {
+    const byRuntimeTabId = new Map(sessions.map((session) => [session.runtimeTabId, session]));
+    return plutoniumPreview()?.onPopupClosed(({ tabId, openerTabId }) => {
+      const popup = byRuntimeTabId.get(tabId);
+      if (!popup) return;
+      const { threadRef } = popup;
+      const opener = openerTabId === null ? undefined : byRuntimeTabId.get(openerTabId);
+      const panel = useRightPanelStore.getState();
+      const showing =
+        selectSelectedRightPanelSurface(panel.byThreadKey, threadRef)?.id ===
+        `browser:${popup.tabId}`;
+      panel.closeSurface(threadRef, `browser:${popup.tabId}`);
+      if (showing && opener) panel.openBrowser(threadRef, opener.tabId);
+      beginPreviewSessionClose(threadRef, popup.tabId);
+      void closePreview({
+        environmentId: threadRef.environmentId,
+        input: { threadId: threadRef.threadId, tabId: popup.tabId },
+      });
+    });
+  }, [closePreview, sessions]);
