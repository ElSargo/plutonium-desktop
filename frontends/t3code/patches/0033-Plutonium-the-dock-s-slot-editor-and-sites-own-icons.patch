+import { describe, expect, it } from "vite-plus/test";
+
+import { normalizeSiteUrl } from "./PlutoniumDock";
+
+describe("the dock editor's address", () => {
+  it("adds https to a bare address", () => {
+    expect(normalizeSiteUrl("github.com/org/repo")).toBe("https://github.com/org/repo");
+    expect(normalizeSiteUrl(" localhost:5173 ")).toBe("https://localhost:5173/");
+  });
+
+  it("keeps a web address as it is", () => {
+    expect(normalizeSiteUrl("http://127.0.0.1:3000/x")).toBe("http://127.0.0.1:3000/x");
+  });
+
+  it("refuses what isn't a web address", () => {
+    expect(normalizeSiteUrl("")).toBeNull();
+    expect(normalizeSiteUrl("file:///etc/passwd")).toBeNull();
+    expect(normalizeSiteUrl("not a url")).toBeNull();
+  });
+});
