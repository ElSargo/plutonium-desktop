+/** Several displays: sends the window to another display's shell. */
+function ToDisplayButtons({ windowId }: { windowId: number }) {
+  const displays = usePlutoniumWindowStore((state) => state.displays);
+  if (displays.length < 2) return null;
+  return (
+    <span className="flex shrink-0 items-center gap-1">
+      {displays
+        .filter((display) => !display.current)
+        .map((display) => (
+          <Button
+            key={display.id}
+            size="xs"
+            variant="ghost-muted"
+            title={display.label ? `Show on ${display.label}` : undefined}
+            onClick={() => void showOnDisplay(windowId, display.index)}
+          >
+            To display {display.index}
+          </Button>
+        ))}
+    </span>
+  );
+}
