#!/usr/bin/env bash
# plutonium: set up, build and run Plutonium. `plutonium help` lists commands.
set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

usage() {
  cat <<EOF
Usage: plutonium <command> [args]

Setup (INSTALL.md walks through these in order):
  doctor                     check the host and the build
  container build            build the image ($IMAGE)
  container create           create the container ($CONTAINER) and start it
  container start|stop       start or stop it
  container shell            a shell inside it
  chromium fetch             depot_tools and a Chromium checkout at chromium/BASE (~100 GB, hours)
  chromium patch             apply chromium/patches on a branch 'plutonium'
  chromium build [--release] gn gen with chromium/args.gn (or args.release.gn), then build chrome
                             from the checkout as it is (a dev build of this checkout's patches is kept)
  t3 fetch                   clone T3 Code at frontends/t3code/BASE and apply its patches
  t3 build                   install its dependencies and build its web app
  image pull                 PREBUILT=1: download the prebuilt Chromium instead of building it
  host build                 HOST=1: the release build (prebuilt image, or out/Release) for the
                             host, with nixpkgs libraries (nix/chrome.nix), and the tools a
                             session uses (nix/host-tools.nix): no container to run it
  killswitch find            show the key codes of buttons as you press them
  killswitch install         a user service that kills Ash on a button press (DRM safety)

Sessions:
  run [options] [shell...]   start a session; shells are niri, plain, t3, or <name>=<url>.
                             The first is the desktop, Super+Tab switches. Default: niri plain.
  stop [--drm|--x11]         stop a session's Ash (both if neither is given)
  t3 server [--x11]          (re)start the T3 Code server for a session ('run t3' starts it)
  t3 stop                    stop the T3 Code server
  t3 <command>               T3 Code's own CLI on the same data: t3 pair, t3 connect link, ...
  status                     what is running

Development:
  helper <args>              run helper/plutonium.ts (thread-setup, launch, mcp, open, ...)
  cdp <args>                 DevTools, where Ash runs: tools/cdp.py --help
  chromium export            rewrite chromium/patches from the checkout's commits since BASE
  chromium ensure            a dev build of this checkout's patches for its sessions: kept already,
                             or built in the Chromium checkout, which then goes back to what it had
  chromium wait [seconds]    wait for this checkout's --bg command: patch, build and ensure take
                             --bg to run as a user unit. They queue on one lock across checkouts
  t3 export                  rewrite frontends/t3code/patches the same way
  image build|push|login|tag the prebuilt image, from the release build (chromium build --release)
  worktree add <name> [ref]  a git worktree in .worktrees/<name> with its own slot (ports, sockets)
  worktree setup             give a worktree made elsewhere its slot and plutonium.env
  worktree info|list         this checkout's slot and ports / every worktree's slot

Settings: plutonium.env (see plutonium.env.example).
EOF
}

run_usage() {
  cat <<EOF
Usage: plutonium run [options] [shell...]

Shells: niri (scrollable tiling), plain (the minimal shell), t3 (T3 Code, on
the host's T3 Code data; started and paired as needed), or <name>=<url> for
any page. The first one is the desktop; the others run behind it (Super+Tab).

Where:
  --x11 [display]   Ash in a window on an X11 display (default: a private Xvfb, :99
                    in slot 0)
  --drm             Ash on KMS/DRM. Run it from a text VT (Ctrl+Alt+F2, log in)
                    while your desktop session is inactive. This is the default.
  --vt ttyN         DRM against ttyN from any other shell (needs passwordless sudo
                    and someone logged in on ttyN)
  --hold SECONDS    DRM: stop Ash after SECONDS (unattended tests); with --vt, first
                    wait up to 120 s for the graphical session to go inactive
  --no-killswitch   DRM without the kill switch (see INSTALL.md before using it)
  --flags "..."     more Chromium flags
EOF
}

# --- Container ---------------------------------------------------------------
container_cmd() {
  case "${1:-}" in
    build)
      pm build --build-arg "CHROMIUM_BASE=$(cat "$ROOT/chromium/BASE")" -t "$IMAGE" \
        -f "$ROOT/container/Containerfile" "$ROOT/container" ;;
    create)
      pm container exists "$CONTAINER" && die "a container '$CONTAINER' already exists"
      mkdir -p "$DATA_DIR" "$RUN_DIR"
      [[ -n ${PREBUILT:-} ]] || mkdir -p "$CHROMIUM_DIR" "$DEPOT_TOOLS"
      local mounts=() dir
      # Same path inside as outside, so paths need no translation.
      # The container's own home (depot_tools' settings and caches), under
      # the data dir; the directories above are mounted into it.
      mkdir -p "$DATA_DIR/container-home"
      mounts+=(-v "$DATA_DIR/container-home:$HOME")
      local dirs=("$ROOT" "$DATA_DIR" "$RUN_DIR")
      [[ -n ${PREBUILT:-} ]] || dirs+=("$CHROMIUM_DIR" "$DEPOT_TOOLS")
      for dir in "${dirs[@]}"; do
        mounts+=(-v "$dir:$dir")
      done
      [[ -d /tmp/.X11-unix ]] && mounts+=(-v /tmp/.X11-unix:/tmp/.X11-unix)
      # - host pid namespace: Exo reports real client pids, which the helper
      #   maps to threads;
      # - /dev/dri, /dev/input and udev: Ash on DRM with evdev input;
      # - keep-id: files in the checkout stay yours.
      pm create --name "$CONTAINER" --hostname "$CONTAINER" --pid=host --network=host --ipc=host \
        --userns=keep-id --group-add keep-groups --security-opt label=disable \
        --device /dev/dri -v /dev/input:/dev/input -v /run/udev:/run/udev:ro "${mounts[@]}" \
        -e HOME="$HOME" -e XDG_RUNTIME_DIR="$RUN_DIR" \
        -e PATH="$DEPOT_TOOLS:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
        -w "$([[ -n ${PREBUILT:-} ]] && echo "$ROOT" || echo "$CHROMIUM_DIR")" "$IMAGE" sleep infinity > /dev/null
      container_cmd start ;;
    start)
      # From a systemd user unit that stays, so the container's monitor
      # (conmon) outlives the shell, or podman wrapper, that started it.
      systemctl --user reset-failed "plutonium-container-$CONTAINER" 2>/dev/null || true
      systemctl --user stop "plutonium-container-$CONTAINER" 2>/dev/null || true
      systemd-run --user --quiet --unit="plutonium-container-$CONTAINER" -p Type=oneshot -p RemainAfterExit=yes \
        --setenv=PATH="$PATH" "$(command -v podman)" start "$CONTAINER" > /dev/null
      sleep 1
      container_running || die "$CONTAINER did not start (podman logs $CONTAINER)"
      echo "started $CONTAINER" ;;
    stop) pm stop -t 5 "$CONTAINER" > /dev/null; systemctl --user stop "plutonium-container-$CONTAINER" 2>/dev/null || true ;;
    shell) need_container; pm exec -it "$CONTAINER" bash ;;
    *) usage; exit 2 ;;
  esac
}

# --- Prebuilt image ----------------------------------------------------------
# Copy what a release build runs with from out dir $1 into $2/chrome.
stage_release() {
  local out=$1 stage=$2 f
  rm -rf "$stage/chrome"
  mkdir -p "$stage/chrome"
  # What Chrome's Linux installer ships (chrome/installer/linux), plus
  # every top-level resource file, since the ChromeOS build has more.
  for f in chrome chrome_crashpad_handler icudtl.dat vk_swiftshader_icd.json \
           libEGL.so libGLESv2.so libvk_swiftshader.so libvulkan.so.1 \
           "$out"/*.pak "$out"/*.bin "$out"/*.dat; do
    f=${f##*/}
    [[ -e $out/$f ]] && cp -a "$out/$f" "$stage/chrome/"
  done
  [[ -e $out/chrome_sandbox ]] && cp -a "$out/chrome_sandbox" "$stage/chrome/chrome-sandbox"
  for f in locales MEIPreload PrivacySandboxAttestationsPreloaded resources; do
    [[ -d $out/$f ]] && cp -a "$out/$f" "$stage/chrome/"
  done
  true
}

image_cmd() {
  local ref=$PREBUILT_REPO:$PREBUILT_TAG
  case "${1:-}" in
    build)
      need_container
      local out=$CHROMIUM_DIR/src/$CHROMIUM_RELEASE_OUT stage=$DATA_DIR/image-stage
      [[ -x $out/chrome ]] || die "no release build at $out (plutonium chromium build --release)"
      stage_release "$out" "$stage"
      in_container sh -c "strip --strip-unneeded '$stage/chrome/chrome' '$stage/chrome/chrome_crashpad_handler' '$stage'/chrome/*.so*"
      # Chromium's license notices, which redistributing it requires.
      in_container sh -c "cd src && python3 tools/licenses/licenses.py credits --gn-target //chrome:chrome --gn-out-dir $CHROMIUM_RELEASE_OUT '$stage/chrome/LICENSES.chromium.html'" ||
        echo "warning: could not generate LICENSES.chromium.html" >&2
      cp "$ROOT/container/Containerfile.runtime" "$stage/Containerfile"
      du -sh "$stage/chrome"
      pm build -t "$ref" -f "$stage/Containerfile" "$stage"
      pm tag "$ref" "$PREBUILT_REPO:latest"
      echo "built $ref" ;;
    push)
      pm push "$ref" && pm push "$PREBUILT_REPO:latest" ;;
    pull)
      pm pull "$ref" ;;
    login)
      # A token with write:packages (gh auth refresh -s write:packages).
      gh auth token | pm login ghcr.io -u "$(gh api user --jq .login)" --password-stdin ;;
    tag) echo "$ref" ;;
    *) usage; exit 2 ;;
  esac
}

# --- On the host --------------------------------------------------------------
host_cmd() {
  case "${1:-}" in
    build)
      command -v nix > /dev/null || die "host build needs Nix"
      local stage=$DATA_DIR/host-stage
      rm -rf "$stage"
      mkdir -p "$stage"
      if [[ -n ${PREBUILT:-} ]]; then
        pm image exists "$IMAGE" || die "no image $IMAGE (plutonium image pull)"
        local c
        c=$(pm create "$IMAGE" true)
        pm cp "$c:/opt/plutonium/chrome" "$stage/" || { pm rm "$c" > /dev/null; die "could not copy chrome out of $IMAGE"; }
        pm rm "$c" > /dev/null
      else
        local out=$CHROMIUM_DIR/src/$CHROMIUM_RELEASE_OUT
        [[ -x $out/chrome ]] || die "no release build at $out (plutonium chromium build --release)"
        stage_release "$out" "$stage"
      fi
      # Against the system's nixpkgs, so libgbm and libEGL match its Mesa.
      nix build --impure --out-link "$HOST_CHROME" --expr \
        "(import <nixpkgs> {}).callPackage $ROOT/nix/chrome.nix { src = /. + \"$stage/chrome\"; }"
      nix build --impure --out-link "$HOST_TOOLS" --expr \
        "(import <nixpkgs> {}).callPackage $ROOT/nix/host-tools.nix {}"
      rm -rf "$stage"
      echo "chrome for the host: $HOST_CHROME/bin/chrome. Set HOST=1 in plutonium.env to run sessions with it" ;;
    *) usage; exit 2 ;;
  esac
}

# --- Chromium ----------------------------------------------------------------
# One Chromium checkout serves every checkout of this repository (worktrees
# too), so whatever changes it or builds in it takes a lock, and waits for
# whoever holds it.
chromium_lock() {
  local lock=$RUN_DIR/plutonium/chromium.lock
  mkdir -p "$RUN_DIR/plutonium"
  exec 9>> "$lock"
  if ! flock -n 9; then
    echo "waiting for the Chromium checkout: $(cat "$lock.who" 2>/dev/null || echo "another command has it")" >&2
    flock 9
  fi
  echo "chromium $1 from $ROOT (since $(date +%T))" > "$lock.who"
}
src_clean() { [[ -z $(git -C "$CHROMIUM_DIR/src" status --porcelain --untracked-files=no) ]]; }

# This checkout's patch series as a commit on BASE, made without touching the
# checkout's files: each patch is applied to a scratch index (what git am
# does, with the same author, date and message), so `chromium export` gives
# the same patches back. Kept by BUILD_KEY.
patch_commit() (
  set -e
  src=$CHROMIUM_DIR/src cache=$BUILDS_DIR/.commits/$BUILD_KEY
  if commit=$(cat "$cache" 2>/dev/null) && git -C "$src" cat-file -e "$commit^{commit}" 2>/dev/null; then
    echo "$commit"; exit 0
  fi
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  export GIT_INDEX_FILE=$tmp/index
  commit=$(cat "$ROOT/chromium/BASE")
  git -C "$src" read-tree "$commit"
  for patch in "$ROOT"/chromium/patches/*.patch; do
    git -C "$src" mailinfo "$tmp/msg" "$tmp/diff" < "$patch" > "$tmp/info"
    git -C "$src" apply --cached --3way "$tmp/diff" 2> "$tmp/err" ||
      { cat "$tmp/err" >&2; echo "plutonium: ${patch##*/} does not apply" >&2; exit 1; }
    field() { sed -n "s/^$1: //p" "$tmp/info"; }
    { field Subject; [[ -s $tmp/msg ]] && { echo; cat "$tmp/msg"; }; } > "$tmp/message"
    commit=$(GIT_AUTHOR_NAME=$(field Author) GIT_AUTHOR_EMAIL=$(field Email) GIT_AUTHOR_DATE=$(field Date) \
      committer git -C "$src" commit-tree "$(git -C "$src" write-tree)" -p "$commit" -F "$tmp/message")
  done
  mkdir -p "${cache%/*}"
  echo "$commit" > "$cache"
  echo "$commit"
)

# The build's args.gn: chromium/args.gn (or args.release.gn), and with CCACHE=1
# the compiler through ccache. Chromium's clang modules can't be cached, so
# they're off then.
chromium_args() {
  cat "$1"
  [[ -n ${CCACHE:-} ]] && printf '%s\n' "" "# CCACHE=1 (plutonium.env)" 'cc_wrapper = "ccache"' "use_clang_modules = false"
  true
}
# Build chrome in the out dir (the release one with --release), from the
# Chromium checkout as it is. A dev build of this checkout's own series is kept.
chromium_build() {
  local release=${1:-} src=$CHROMIUM_DIR/src outdir=$CHROMIUM_OUT args=$ROOT/chromium/args.gn env=()
  container_running "$BUILD_CONTAINER" ||
    die "the build container '$BUILD_CONTAINER' is not running (plutonium container create, without PREBUILT=1; or set BUILD_CONTAINER)"
  [[ -n $release ]] && outdir=$CHROMIUM_RELEASE_OUT args=$ROOT/chromium/args.release.gn
  mkdir -p "$src/$outdir"
  cmp -s <(chromium_args "$args") "$src/$outdir/args.gn" || chromium_args "$args" > "$src/$outdir/args.gn"
  if [[ -n ${CCACHE:-} ]]; then
    in_build_container sh -c 'command -v ccache' > /dev/null ||
      die "CCACHE=1, but the build container has no ccache (plutonium container build, then create it again)"
    env=(-e "CCACHE_DIR=$CCACHE_DIR" -e "CCACHE_MAXSIZE=$CCACHE_SIZE" -e "CCACHE_BASEDIR=$src"
         -e CCACHE_SLOPPINESS=time_macros,include_file_mtime,include_file_ctime)
  fi
  in_build_container "${env[@]}" sh -c "cd src && gn gen $outdir && autoninja -C $outdir chrome"
  [[ -n $release ]] || record_build "$src/$outdir"
}
# Say in the out dir what it holds, and keep a build of this checkout's series
# where a session can run it while the out dir moves on.
record_build() {
  local out=$1 src=$CHROMIUM_DIR/src mine
  mine=$(patch_commit) || return 0
  if src_clean && [[ $(git -C "$src" rev-parse 'HEAD^{tree}') == $(git -C "$src" rev-parse "$mine^{tree}") ]]; then
    echo "key $BUILD_KEY" > "$out/.plutonium-build"
    keep_build "$out"
  elif git -C "$src" merge-base --is-ancestor "$mine" HEAD; then
    echo "custom $BUILD_KEY" > "$out/.plutonium-build"   # more work on top of this series
  else
    echo "other" > "$out/.plutonium-build"
  fi
}
# Copy what chrome runs with (reflinks, where the filesystem has them) to
# BUILDS_DIR/<key>, and drop the oldest kept builds that no session runs.
keep_build() {
  local out=$1 dest=$BUILDS_DIR/$BUILD_KEY tmp=$BUILDS_DIR/.$BUILD_KEY.$$ f dir n=0
  mkdir -p "$tmp"
  for f in "$out"/*; do
    case ${f##*/} in
      obj|gen|clang_*|local_rustc_sysroot|pyproto|jsproto|args.gn|siso*|*.TOC|*.runtime_deps|*.ninja|*.ninja.*|*_unittest_exes.txt) continue ;;
    esac
    cp -a --reflink=auto "$f" "$tmp/"
  done
  rm -rf "$dest"
  mv "$tmp" "$dest"
  echo "kept this build as $dest"
  for dir in $(ls -1dt "$BUILDS_DIR"/*/ 2> /dev/null); do
    dir=${dir%/}
    n=$((n + 1))
    (( n <= BUILDS_KEEP )) && continue
    pgrep -f "^$dir/chrome " > /dev/null && continue
    rm -rf "$dir"
  done
}

# --bg: run a chromium command as a systemd user unit, so it outlives the
# shell (and an agent's command timeout). One per checkout; the lock queues
# them across checkouts. `chromium wait` waits for it.
CHROMIUM_UNIT=plutonium-chromium-$(echo "$ROOT" | sha256sum | cut -c1-8)
chromium_bg() {
  local log=$LOGS/chromium.log status=$LOGS/chromium.status
  [[ $(systemctl --user is-active "$CHROMIUM_UNIT" 2> /dev/null) == @(active|activating) ]] &&
    die "this checkout's background command is still running (plutonium chromium wait)"
  systemctl --user reset-failed "$CHROMIUM_UNIT" 2> /dev/null || true
  rm -f "$status"
  : > "$log"
  systemd-run --user --quiet --collect --unit="$CHROMIUM_UNIT" --setenv=PATH="$PATH" \
    sh -c 'log=$1 status=$2; shift 2; "$@" >> "$log" 2>&1; echo $? > "$status"' \
    sh "$log" "$status" "$ROOT/bin/plutonium" chromium "$@"
  echo "chromium $* runs in the background (log logs/chromium.log); plutonium chromium wait"
}
chromium_wait() {
  local limit=${1:-} start=$SECONDS log=$LOGS/chromium.log status=$LOGS/chromium.status
  while [[ $(systemctl --user is-active "$CHROMIUM_UNIT" 2> /dev/null) == @(active|activating|deactivating) ]]; do
    if [[ -n $limit ]] && (( SECONDS - start >= limit )); then
      echo "still running: $(tail -n 1 "$log" | cut -c1-160)"
      return 124
    fi
    sleep 5
  done
  [[ -f $status ]] || die "this checkout has no background chromium command"
  tail -n 3 "$log"
  return "$(cat "$status")"
}

chromium_cmd() {
  local base src=$CHROMIUM_DIR/src arg args=() bg=
  base=$(cat "$ROOT/chromium/BASE")
  for arg in "$@"; do [[ $arg == --bg ]] && bg=1 || args+=("$arg"); done
  set -- "${args[@]}"
  if [[ -n $bg ]]; then
    [[ ${1:-} == @(patch|build|ensure) ]] || die "--bg is for chromium patch, build and ensure"
    chromium_bg "$@"
    return
  fi
  case "${1:-}" in
    fetch)
      container_running "$BUILD_CONTAINER" || die "the build container '$BUILD_CONTAINER' is not running"
      [[ -d $DEPOT_TOOLS/.git ]] ||
        git clone https://chromium.googlesource.com/chromium/tools/depot_tools.git "$DEPOT_TOOLS"
      # What `fetch chromium` writes, plus the ChromeOS target; then one sync
      # straight to BASE (fetch would first sync to the newest revision).
      [[ -f $CHROMIUM_DIR/.gclient ]] || cat > "$CHROMIUM_DIR/.gclient" <<'GCLIENT'
solutions = [
  {
    "name": "src",
    "url": "https://chromium.googlesource.com/chromium/src.git",
    "custom_deps": {},
    "custom_vars": {},
  },
]
target_os = ['chromeos']
GCLIENT
      # googlesource rate-limits gclient's default parallelism (HTTP 429).
      in_build_container gclient sync --revision "src@$base" --nohooks --no-history -D -j 4
      in_build_container gclient runhooks
      echo "Chromium is at $base. Next: plutonium chromium patch" ;;
    patch)
      # Branch plutonium, at this checkout's series. Only files that differ
      # from what the checkout has are written, so the next build redoes no more
      # than it must.
      [[ -d $src/.git ]] || die "no checkout at $src (plutonium chromium fetch)"
      chromium_lock patch
      src_clean || die "$src has uncommitted changes"
      local commit tip last
      commit=$(patch_commit) || exit 1
      last=$(cat "$CHROMIUM_DIR/.plutonium-branch" 2> /dev/null || true)
      if tip=$(git -C "$src" rev-parse -q --verify refs/heads/plutonium) &&
         [[ $tip != "$commit" && $tip != "$last" && ${2:-} != --force ]]; then
        die "branch 'plutonium' in $src has commits that aren't in chromium/patches (chromium export them); --force moves it anyway (the old tip stays in its reflog)"
      fi
      git -C "$src" checkout -q -B plutonium "$commit"
      echo "$commit" > "$CHROMIUM_DIR/.plutonium-branch"
      echo "$(git -C "$src" rev-list --count "$base"..HEAD) patches on branch plutonium" ;;
    build)
      chromium_lock build
      chromium_build "$([[ ${2:-} == --release ]] && echo 1)" ;;
    ensure)
      # A dev build of this checkout's series, for its sessions: the one kept
      # already, or the series built in the Chromium checkout, which then goes
      # back to what it had.
      [[ -d $src/.git ]] || die "no checkout at $src (plutonium chromium fetch)"
      chromium_lock ensure
      if [[ -x $BUILDS_DIR/$BUILD_KEY/chrome ]]; then
        echo "built already: $BUILDS_DIR/$BUILD_KEY"
      else
        src_clean || die "$src has uncommitted changes (someone is working in it); commit or stash them first"
        local commit prev
        commit=$(patch_commit) || exit 1
        prev=$(git -C "$src" symbolic-ref -q --short HEAD || git -C "$src" rev-parse HEAD)
        # shellcheck disable=SC2064 # $prev is local: expand it now
        trap "git -C '$src' checkout -q '$prev' && echo 'the Chromium checkout is back on $prev'" EXIT
        git -C "$src" checkout -q --detach "$commit"
        chromium_build
      fi
      [[ -n ${PREBUILT:-} ]] &&
        echo "note: this checkout's sessions run the prebuilt image (PREBUILT=1). To run this build, put PREBUILT= and CONTAINER=$BUILD_CONTAINER in plutonium.local.env"
      true ;;
    wait) chromium_wait "${2:-}" ;;
    export)
      [[ -d $src/.git ]] || die "no checkout at $src"
      chromium_lock export
      src_clean || die "commit your changes in $src first"
      rm -f "$ROOT"/chromium/patches/*.patch
      git -C "$src" format-patch -q --zero-commit --no-signature -o "$ROOT/chromium/patches" "$base"..HEAD
      ls "$ROOT/chromium/patches" | wc -l | xargs echo "patches written to chromium/patches:" ;;
    *) usage; exit 2 ;;
  esac
}

# git am needs a committer; use a neutral one if git has none configured.
committer() {
  if git config user.email > /dev/null; then "$@"
  else GIT_COMMITTER_NAME=Plutonium GIT_COMMITTER_EMAIL=plutonium@localhost "$@"; fi
}

# --- T3 Code -----------------------------------------------------------------
t3_pnpm() { if command -v pnpm > /dev/null; then pnpm "$@"; else corepack pnpm "$@"; fi; }
# T3 Code runs off the host's own data ($T3_HOME), so it never runs beside a
# T3 Code that Plutonium didn't start: the T3 Code desktop app, a "t3" CLI
# server, a boot service. Ours carry PLUTONIUM_T3=<this checkout>.
t3_ours() { tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null | grep -qxF "PLUTONIUM_T3=$ROOT"; }
# The processes using T3 Code's database, and the server it says is running.
t3_pids() {
  local state=$T3_HOME/userdata/server-runtime.json pid
  # state.sqlite (T3 before 0.1) or statev2.sqlite.
  find /proc/[0-9]*/fd -lname "$T3_HOME/userdata/state*.sqlite" 2>/dev/null | cut -d/ -f3
  pid=$(grep -o '"pid":[0-9]*' "$state" 2>/dev/null | cut -d: -f2)
  [[ -n $pid && -d /proc/$pid ]] && echo "$pid"
  true
}
t3_refuse_others() {
  local pid unit other others=()
  for pid in $(t3_pids | sort -u); do t3_ours "$pid" || others+=("$pid"); done
  [[ ${#others[@]} -eq 0 ]] && return
  {
    echo "plutonium: another T3 Code is using $T3_HOME:"
    for pid in "${others[@]}"; do
      echo "  $pid: $(tr '\0' ' ' < "/proc/$pid/cmdline" | cut -c1-120)"
      other=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^PLUTONIUM_T3=//p')
      [[ -n $other ]] && echo "     (started by the Plutonium checkout in $other)"
      unit=$(grep -o '[^/]*\.service$' "/proc/$pid/cgroup" 2>/dev/null || true)
      [[ -n $unit && $unit != app-* && $unit != run-* ]] && echo "     (run by $unit: systemctl --user stop $unit)"
    done
    echo "Stop it first (quit the T3 Code app, or stop that server): Plutonium runs its own T3 Code on the same data."
  } >&2
  exit 1
}
# The database this checkout's T3 Code opens: statev2.sqlite from 0.1 on, which
# T3 seeds from state.sqlite once and migrates (state.sqlite is left as it was).
t3_database() {
  local name
  name=$(grep -o 'join(stateDir, "[a-z0-9]*\.sqlite")' "$T3CODE_DIR/apps/server/src/config.ts" | head -1 | cut -d'"' -f2)
  echo "$T3_HOME/userdata/${name:-state.sqlite}"
}
# T3 Code's database is migrated by whichever version opens it. Refuse one newer
# than this checkout knows; before migrating an older one, keep a copy.
t3_check_db() {
  local db ours have backup
  db=$(t3_database)
  if [[ ! -f $db ]]; then
    [[ -f $T3_HOME/userdata/state.sqlite ]] &&
      echo "T3 Code starts ${db##*/} from a copy of state.sqlite; state.sqlite stays as it is"
    return 0
  fi
  ours=$(ls "$T3CODE_DIR/apps/server/src/persistence/Migrations" | grep -v '\.test\.ts$' | grep -o '^[0-9]*' | sort -n | tail -1)
  ours=$((10#$ours))
  have=$(node -e '
    const db = new (require("node:sqlite").DatabaseSync)(process.argv[1], { readOnly: true });
    console.log(db.prepare("select max(migration_id) as m from effect_sql_migrations").get().m ?? 0);
  ' "$db" 2> /dev/null) || die "can't read T3 Code's database $db"
  if (( have > ours )); then
    die "T3 Code's database ($db) is from a newer T3 Code (migration $have; this checkout has $ours). Update frontends/t3code to a newer T3 Code first."
  elif (( have < ours )); then
    backup=$db.before-migration-$ours
    if [[ -e $backup ]]; then
      echo "T3 Code's database is at migration $have and this checkout migrates it to $ours (a copy from before is in $backup)"
      return
    fi
    echo "T3 Code's database is at migration $have and this checkout migrates it to $ours; keeping a copy in $backup"
    node -e '
      const db = new (require("node:sqlite").DatabaseSync)(process.argv[1]);
      db.prepare("VACUUM INTO ?").run(process.argv[2]);
    ' "$db" "$backup" 2> /dev/null || die "couldn't back up $db"
  fi
}
# Start the server for a session's socket: "restart" restarts ours, otherwise
# ours is reused if it serves that socket.
t3_start() {
  local socket=$1 restart=${2:-} port=$T3_PORT satellite pid pidfile=$RUN_DIR/plutonium/t3-server$SLOT_SUFFIX.pid
  local tailscale=()
  [[ -n ${T3_TAILSCALE:-} ]] && tailscale=(--tailscale-serve --tailscale-serve-port "$T3_TAILSCALE_PORT")
  [[ -f $T3CODE_DIR/apps/web/dist/index.html ]] || die "T3 Code isn't built (plutonium t3 build)"
  t3_refuse_others
  pid=$(cat "$pidfile" 2>/dev/null || true)
  if [[ -n $pid ]] && t3_ours "$pid"; then
    if [[ -z $restart ]]; then
      tr '\0' '\n' < "/proc/$pid/environ" | grep -qxF "PLUTONIUM_WAYLAND_DISPLAY=$socket" && return
      local flag=; [[ $socket == *-x11* ]] && flag=" --x11"
      die "the T3 Code server is serving the other session; restart it for this one (plutonium t3 server$flag)"
    fi
    t3_stop
  fi
  curl -s -m 2 -o /dev/null "http://127.0.0.1:$port/" && die "port $port is taken by something else (T3_PORT picks another)"
  t3_check_db
  satellite=${PLUTONIUM_XWAYLAND_SATELLITE:-$(command -v xwayland-satellite || true)}
  mkdir -p "$T3_HOME" "$RUN_DIR/plutonium"
  (
    cd "$T3CODE_DIR"
    # T3 Connect (remote devices through T3's relay): its public settings.
    [[ -f .env ]] && { set -a; . ./.env; set +a; }
    setsid env PLUTONIUM_T3="$ROOT" PLUTONIUM_WAYLAND_DISPLAY="$socket" T3CODE_HOME="$T3_HOME" \
      ${satellite:+PLUTONIUM_XWAYLAND_SATELLITE="$satellite"} \
      node "$T3CODE_DIR/apps/server/src/bin.ts" --port "$port" --host "${T3_HOST:-127.0.0.1}" "${tailscale[@]}" --no-browser \
      > "$LOGS/t3-server.log" 2>&1 < /dev/null &
    echo $! > "$pidfile"
  )
  for _ in $(seq 1 30); do curl -s -m 2 -o /dev/null "http://127.0.0.1:$port/" && return; sleep 1; done
  die "the T3 Code server didn't start (logs/t3-server.log)"
}
# T3 Code's own CLI, on the same data and settings as the server.
t3_cli() {
  cd "$T3CODE_DIR" || die "no T3 Code checkout at $T3CODE_DIR (plutonium t3 fetch)"
  [[ -f .env ]] && { set -a; . ./.env; set +a; }
  T3CODE_HOME="$T3_HOME" exec node apps/server/src/bin.ts "$@"
}
# Stops ours (a server this checkout started), and waits for it to let go of
# the database.
t3_stop() {
  local pid
  pid=$(cat "$RUN_DIR/plutonium/t3-server$SLOT_SUFFIX.pid" 2>/dev/null) && t3_ours "$pid" || return 1
  kill "$pid"
  for _ in $(seq 1 50); do [[ -z $(t3_pids) ]] && break; sleep 0.2; done
  rm -f "$RUN_DIR/plutonium/t3-server$SLOT_SUFFIX.pid"
}
# A one-time pairing token for the shell's profile, good for 5 minutes, offered
# as #plutoniumPair: the page uses it only if the profile isn't paired yet, or
# its session lacks some of the token's scopes. The shell is the machine's own
# desktop app, so it gets what T3 Code's desktop app gets: every scope,
# including pairing other devices (access:write).
t3_pair_url() {
  local port=$T3_PORT token scopes
  scopes=$(cd "$T3CODE_DIR" && node --input-type=module -e '
    const { AuthAdministrativeScopes } = await import("./packages/contracts/src/auth.ts");
    console.log(AuthAdministrativeScopes.map((scope) => `--scope=${scope}`).join(" "));
  ' 2> /dev/null) || die "couldn't read T3 Code's scopes"
  # shellcheck disable=SC2086 # one --scope=… per word
  token=$(cd "$T3CODE_DIR" && T3CODE_HOME="$T3_HOME" node apps/server/src/bin.ts auth pairing create \
    $scopes --ttl 5m --label "Plutonium shell" --json 2> /dev/null | grep -o '"credential": *"[^"]*"' | cut -d'"' -f4)
  [[ -n $token ]] || die "couldn't create a T3 Code pairing token"
  echo "http://127.0.0.1:$port/#plutoniumPair=$token"
}
# T3's release builds stamp the release's version into these (the source keeps
# an older one); so does `t3 build`, for a BASE that is a release tag. The
# stamp stays out of git's way (skip-worktree), and `t3 fetch` takes it out.
T3_VERSION_FILES=(apps/server/package.json apps/desktop/package.json apps/web/package.json packages/contracts/package.json)
t3_stamp_version() {
  local tag
  tag=$(git -C "$T3CODE_DIR" describe --tags --exact-match "$1" 2> /dev/null) || return 0
  [[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
  (cd "$T3CODE_DIR" && node scripts/update-release-package-versions.ts "${tag#v}" > /dev/null) ||
    die "couldn't stamp T3 Code's version $tag"
  git -C "$T3CODE_DIR" update-index --skip-worktree "${T3_VERSION_FILES[@]}"
  echo "T3 Code version: ${tag#v}"
}
t3_unstamp_version() {
  local file
  for file in "${T3_VERSION_FILES[@]}"; do
    [[ -f $T3CODE_DIR/$file ]] || continue
    git -C "$T3CODE_DIR" update-index --no-skip-worktree "$file"
    # Only a stamp: every changed line is a "version".
    if ! git -C "$T3CODE_DIR" diff -U0 -- "$file" | grep '^[-+][^-+]' | grep -qv '"version":'; then
      git -C "$T3CODE_DIR" checkout -q -- "$file"
    fi
  done
}
t3_cmd() {
  local base
  base=$(cat "$ROOT/frontends/t3code/BASE")
  case "${1:-}" in
    fetch)
      [[ -d $T3CODE_DIR/.git ]] || git clone https://github.com/pingdotgg/t3code.git "$T3CODE_DIR"
      git -C "$T3CODE_DIR" rev-parse -q --verify "$base^{commit}" > /dev/null || git -C "$T3CODE_DIR" fetch --tags origin
      t3_unstamp_version
      [[ -z $(git -C "$T3CODE_DIR" status --porcelain --untracked-files=no) ]] || die "$T3CODE_DIR has uncommitted changes"
      git -C "$T3CODE_DIR" checkout -q -B plutonium "$base"
      committer git -C "$T3CODE_DIR" am -q --3way "$ROOT"/frontends/t3code/patches/*.patch
      # T3 Connect, as in T3's release builds (the same public settings).
      [[ -f $T3CODE_DIR/.env ]] || cp "$T3CODE_DIR/.env.example" "$T3CODE_DIR/.env"
      echo "T3 Code is on branch plutonium in $T3CODE_DIR. Next: plutonium t3 build" ;;
    build)
      [[ -d $T3CODE_DIR ]] || die "no T3 Code checkout at $T3CODE_DIR (plutonium t3 fetch)"
      [[ -f $T3CODE_DIR/.env ]] || cp "$T3CODE_DIR/.env.example" "$T3CODE_DIR/.env"
      (cd "$T3CODE_DIR" && t3_pnpm install) || die "pnpm install failed"
      t3_stamp_version "$base"
      (cd "$T3CODE_DIR/apps/web" && t3_pnpm exec vp build) ;;
    server)
      local mode=drm
      [[ ${2:-} == --x11 ]] && mode=x11
      session_vars "$mode"
      t3_start "$SOCKET" restart
      echo "T3 Code server on http://127.0.0.1:$T3_PORT for $SOCKET, data in $T3_HOME (log logs/t3-server.log)" ;;
    stop)
      t3_stop || echo "no T3 Code server from this checkout is running" ;;
    export)
      [[ -z $(git -C "$T3CODE_DIR" status --porcelain --untracked-files=no) ]] || die "commit your changes in $T3CODE_DIR first"
      rm -f "$ROOT"/frontends/t3code/patches/*.patch
      git -C "$T3CODE_DIR" format-patch -q --zero-commit --no-signature -o "$ROOT/frontends/t3code/patches" "$base"..HEAD
      ls "$ROOT/frontends/t3code/patches" | wc -l | xargs echo "patches written to frontends/t3code/patches:" ;;
    "") usage; exit 2 ;;
    *) t3_cli "$@" ;;
  esac
}

# --- Sessions ----------------------------------------------------------------
# Serve a shell directory on a local port, unless something already answers.
serve_shell() {
  local dir=$1 port=$2 pidfile=$RUN_DIR/plutonium/serve-$2.pid
  mkdir -p "$RUN_DIR/plutonium"
  if curl -s -m 2 -o /dev/null "http://127.0.0.1:$port/"; then
    # Ours (this checkout's directory), or something else on the port.
    [[ -f $pidfile ]] && grep -qF -- "$dir" "/proc/$(cat "$pidfile")/cmdline" 2>/dev/null && return
    die "port $port is taken by another server; stop it (e.g. an older checkout's shell server) and retry"
  fi
  setsid python3 -m http.server "$port" --bind 127.0.0.1 --directory "$dir" > /dev/null 2>&1 < /dev/null &
  echo $! > "$pidfile"
  for _ in $(seq 1 20); do curl -s -m 2 -o /dev/null "http://127.0.0.1:$port/" && return; sleep 0.2; done
}
# A shell name → "<label>=<url>", the page told where the helper is.
shell_entry() {
  local helper=http://127.0.0.1:$HELPER_PORT
  case "$1" in
    niri) serve_shell "$ROOT/shells/niri" "$(slot_port 8775)"; echo "niri=http://127.0.0.1:$(slot_port 8775)/?helper=$helper" ;;
    plain) serve_shell "$ROOT/shells/plain" "$(slot_port 8770)"; echo "Plain=http://127.0.0.1:$(slot_port 8770)/?helper=$helper" ;;
    t3|t3=*)
      local url=${1#t3}; url=${url#=}
      if [[ -z $url ]]; then t3_start "$SOCKET"; url=$(t3_pair_url)
      else curl -s -m 5 -o /dev/null "${url%%[?#]*}" || die "no T3 Code server at $url"; fi
      local base=${url%%#*} fragment=
      [[ $url == *#* ]] && fragment="#${url#*#}"
      [[ $base == *\?* ]] && base+="&" || base+="?"
      echo "T3=${base}plutoniumHelper=$helper$fragment" ;;
    *=*) echo "$1" ;;
    *) die "unknown shell '$1' (niri, plain, t3 or <name>=<url>)" ;;
  esac
}
origin_of() { sed -E 's#^(https?://[^/?\#]+).*#\1#' <<< "$1"; }

run_cmd() {
  local mode=drm shells=()
  export VT= HOLD_S= WAIT_S= NO_KILLSWITCH= XDISP= EXTRA_FLAGS=
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --x11) mode=x11; if [[ ${2:-} == :* ]]; then XDISP=$2; shift; fi ;;
      --drm) mode=drm ;;
      --vt) VT=$2; shift ;;
      --hold) HOLD_S=$2; shift ;;
      --no-killswitch) NO_KILLSWITCH=1 ;;
      --flags) EXTRA_FLAGS=$2; shift ;;
      -h|--help) run_usage; exit 0 ;;
      -*) run_usage; exit 2 ;;
      *) shells+=("$1") ;;
    esac
    shift
  done
  [[ ${#shells[@]} -gt 0 ]] || shells=(niri plain)
  [[ -n $VT && -n $HOLD_S ]] && WAIT_S=120
  # DRM and X11 sessions have their own socket and ports, so both can run.
  session_vars "$mode"
  [[ $mode == x11 ]] && XDISP=${XDISP:-$PRIVATE_XDISP}
  export MODE=$mode SOCKET CDP_PORT HELPER_PORT PROFILE XDISP PRIVATE_XDISP
  local entries=() entry origins=() rest=()
  for entry in "${shells[@]}"; do entries+=("$(shell_entry "$entry")"); done
  for entry in "${entries[@]}"; do origins+=("$(origin_of "${entry#*=}")"); done
  export SHELL_URL=${entries[0]#*=}
  export ORIGINS=$(IFS=,; echo "${origins[*]}")
  rest=("${entries[@]:1}")
  export SHELLS=$(IFS='|'; echo "${rest[*]}")
  exec "$ROOT/lib/session.sh"
}

stop_cmd() {
  local which=${1:---all} mode
  for mode in drm x11; do
    [[ $which == --all || $which == "--$mode" ]] || continue
    session_vars "$mode"
    on_ash pkill -TERM -f "^$ASH_BIN --enable-wayland-server .*--user-data-dir=$PROFILE( |\$)" 2>/dev/null &&
      echo "stopped the $mode session" || true
    local pidfile=$RUN_DIR/plutonium/helper-$SOCKET.pid
    [[ -f $pidfile ]] && kill "$(cat "$pidfile")" 2>/dev/null && rm -f "$pidfile" || true
  done
}

status_cmd() {
  if [[ -n ${HOST:-} ]]; then echo "Ash runs on the host (HOST=1)"
  elif container_running; then echo "container $CONTAINER: running"
  else echo "container $CONTAINER: not running"; fi
  local from=
  [[ -z ${HOST:-} && -n ${PREBUILT:-} ]] && from=" (prebuilt, $IMAGE)"
  chrome_built && echo "chrome: $CHROME_BIN$from" || echo "chrome: missing ($CHROME_BIN)"
  local mode
  for mode in drm x11; do
    session_vars "$mode"
    pgrep -f "^$ASH_BIN --enable-wayland-server .*--user-data-dir=$PROFILE( |\$)" > /dev/null &&
      echo "$mode session: running ($SOCKET, DevTools $CDP_PORT)" || echo "$mode session: not running"
  done
  local sock
  for sock in "$RUN_DIR"/plutonium/*.sock; do
    [[ -S $sock ]] && curl -s --max-time 2 --unix-socket "$sock" http://helper/v1/status > /dev/null &&
      echo "helper: $sock"
  done
  local lock=$RUN_DIR/plutonium/chromium.lock
  if [[ -f $lock ]] && ! flock -n "$lock" true; then echo "Chromium checkout: busy, $(cat "$lock.who" 2>/dev/null)"; fi
  [[ $(systemctl --user is-active "$CHROMIUM_UNIT" 2>/dev/null) == active ]] &&
    echo "background chromium command: running (plutonium chromium wait)"
  (( SLOT )) && echo "slot $SLOT (plutonium worktree info)"
  [[ $(systemctl --user is-active plutonium-killswitch 2>/dev/null) == active ]] &&
    echo "kill switch: active" || echo "kill switch: not installed or not running"
}

# --- Kill switch -------------------------------------------------------------
killswitch_cmd() {
  case "${1:-}" in
    find) python3 "$ROOT/killswitch/killswitch.py" --find "${2:-30}" ;;
    install)
      [[ -n ${KILLSWITCH_DEVICE:-} && -n ${KILLSWITCH_KEY:-} ]] ||
        die "set KILLSWITCH_DEVICE and KILLSWITCH_KEY in plutonium.env first (plutonium killswitch find)"
      mkdir -p "$HOME/.config/systemd/user"
      cat > "$HOME/.config/systemd/user/plutonium-killswitch.service" <<EOF
[Unit]
Description=Plutonium kill switch: a button press stops Ash on DRM

[Service]
ExecStart=$(command -v python3) $ROOT/killswitch/killswitch.py
Environment="KILLSWITCH_DEVICE=$KILLSWITCH_DEVICE" "KILLSWITCH_KEY=$KILLSWITCH_KEY"
Environment="PATH=$PATH"
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
EOF
      systemctl --user daemon-reload
      systemctl --user enable --now plutonium-killswitch
      sleep 2
      journalctl --user -u plutonium-killswitch -o cat --no-pager -n 3 ;;
    test) python3 "$ROOT/killswitch/killswitch.py" --fire --dry-run ;;
    *) usage; exit 2 ;;
  esac
}

# --- Worktrees ---------------------------------------------------------------
# Parallel checkouts: each worktree gets a free slot and the main checkout's
# plutonium.env, so its sessions run beside everyone else's.
worktree_slots() {
  local dir
  git -C "$MAIN_ROOT" worktree list --porcelain | sed -n 's/^worktree //p' | while read -r dir; do
    [[ $dir == "$1" ]] || cat "$dir/.plutonium-slot" 2> /dev/null || true
  done
}
worktree_setup() {
  local dir=$1 slot=1 used
  if [[ ! -f $dir/.plutonium-slot ]]; then
    used=$(worktree_slots "$dir")
    while grep -qx "$slot" <<< "$used"; do slot=$((slot + 1)); done
    echo "$slot" > "$dir/.plutonium-slot"
  fi
  [[ -e $dir/plutonium.env || ! -f $MAIN_ROOT/plutonium.env ]] || ln -s "$MAIN_ROOT/plutonium.env" "$dir/plutonium.env"
  (cd "$dir" && "$dir/bin/plutonium" worktree info)
}
worktree_cmd() {
  case "${1:-}" in
    add)
      local name=${2:-} start=${3:-HEAD} dir
      [[ -n $name ]] || die "usage: plutonium worktree add <name> [<start>]"
      dir=$MAIN_ROOT/.worktrees/$name
      if git -C "$MAIN_ROOT" rev-parse -q --verify "refs/heads/$name" > /dev/null; then
        git -C "$MAIN_ROOT" worktree add -q "$dir" "$name"
      else
        git -C "$MAIN_ROOT" worktree add -q -b "$name" "$dir" "$start"
      fi
      worktree_setup "$dir" ;;
    setup)
      [[ $ROOT != "$MAIN_ROOT" ]] || die "this is the main checkout (slot 0); run this in a worktree"
      worktree_setup "$ROOT" ;;
    info)
      session_vars x11
      echo "$ROOT: slot $SLOT"
      echo "  X11 sessions: $SOCKET, DevTools $CDP_PORT, helper $HELPER_PORT, Xvfb $PRIVATE_XDISP"
      session_vars drm
      echo "  DRM sessions: $SOCKET, DevTools $CDP_PORT, helper $HELPER_PORT"
      echo "  shells: niri $(slot_port 8775), plain $(slot_port 8770), T3 Code $T3_PORT"
      echo "  Chromium: $CHROME_BIN" ;;
    list)
      local dir
      git -C "$MAIN_ROOT" worktree list --porcelain | sed -n 's/^worktree //p' | while read -r dir; do
        echo "slot $(cat "$dir/.plutonium-slot" 2> /dev/null || echo "0 (unset)")  $dir"
      done ;;
    *) usage; exit 2 ;;
  esac
}

# --- Doctor ------------------------------------------------------------------
doctor() {
  local ok=1
  check() { if eval "$2" > /dev/null 2>&1; then echo "  ok   $1"; else echo "  MISSING  $1${3:+ — $3}"; ok=0; fi; }
  echo "Host:"
  check "podman" "command -v podman"
  check "podman works from this shell" "pm info" "set PODMAN=lib/pm.sh in plutonium.env"
  check "node 24+" "node -e 'process.exit(+process.versions.node.split(\".\")[0] >= 24 ? 0 : 1)'"
  check "python3" "command -v python3"
  check "git, curl" "command -v git && command -v curl"
  check "xwayland-satellite (X11 apps)" "command -v xwayland-satellite || [ -x \"\${PLUTONIUM_XWAYLAND_SATELLITE:-}\" ]" "optional"
  check "systemd-socket-activate (X11 apps)" "command -v systemd-socket-activate" "optional"
  check "foot (the shells' terminal)" "command -v foot" "optional"
  check "in the 'input' group (kill switch)" "id -nG | grep -qw input" "optional, for the kill switch"
  if [[ -n ${HOST:-} ]]; then
    echo "Ash on the host (HOST=1):"
    check "nix" "command -v nix" "for plutonium host build"
    check "chrome ($CHROME_BIN)" "chrome_built" "plutonium host build"
    check "Xvfb (--x11 without a display)" "on_ash sh -c 'command -v Xvfb'" "plutonium host build"
    check "python3 websockets (plutonium cdp)" "on_ash python3 -c 'import websockets'" "plutonium host build"
  else
    echo "Container:"
    [[ -n ${PREBUILT:-} ]] || check "image $IMAGE" "pm image exists $IMAGE" "plutonium container build"
    check "container $CONTAINER running" "container_running" "plutonium container create / start"
    echo "Chromium:"
    if [[ -n ${PREBUILT:-} ]]; then
      check "prebuilt image $IMAGE" "pm image exists $IMAGE" "plutonium image pull"
      check "chrome in the container" "chrome_built" "plutonium container create (with PREBUILT=1)"
    else
      check "checkout at $CHROMIUM_DIR/src" "[ -d $CHROMIUM_DIR/src/.git ]" "plutonium chromium fetch, or PREBUILT=1"
      check "patched (branch plutonium)" "git -C $CHROMIUM_DIR/src rev-parse -q --verify refs/heads/plutonium" "plutonium chromium patch"
      check "built ($CHROME_BIN)" "[ -x $CHROME_BIN ]" "plutonium chromium build"
    fi
  fi
  echo "T3 Code (optional):"
  check "checkout at $T3CODE_DIR" "[ -d $T3CODE_DIR/.git ]" "plutonium t3 fetch"
  check "web app built" "[ -f $T3CODE_DIR/apps/web/dist/index.html ]" "plutonium t3 build"
  echo "Kill switch (DRM):"
  check "plutonium-killswitch running" "[ \$(systemctl --user is-active plutonium-killswitch) = active ]" "plutonium killswitch install"
  [[ $ok == 1 ]] && echo "All set." || true
}

cmd=${1:-help}
shift || true
case "$cmd" in
  doctor) doctor ;;
  container) container_cmd "$@" ;;
  chromium) chromium_cmd "$@" ;;
  image) image_cmd "$@" ;;
  host) host_cmd "$@" ;;
  t3) t3_cmd "$@" ;;
  run) run_cmd "$@" ;;
  stop) stop_cmd "$@" ;;
  status) status_cmd ;;
  killswitch) killswitch_cmd "$@" ;;
  worktree) worktree_cmd "$@" ;;
  helper) session_vars drm; PLUTONIUM_WAYLAND_DISPLAY=${PLUTONIUM_WAYLAND_DISPLAY:-$SOCKET} exec node "$ROOT/helper/plutonium.ts" "$@" ;;
  # tools/cdp.py from the main checkout, which the container mounts.
  cdp) need_ash_runtime; session_vars drm; on_ash -e "CDP=${CDP:-localhost:$CDP_PORT}" python3 "$MAIN_ROOT/tools/cdp.py" "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
