#!/usr/bin/env bash
# plutonium: set up, build and run Plutonium. `plutonium help` lists commands.
set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"
# A checkout's commands: Chromium, the container, worktrees, the release bundle.
[[ -n $DEV ]] && . "$ROOT/dev/commands.sh"

usage() {
  cat <<EOF
Usage: plutonium <command> [args]

Setup (INSTALL.md walks through it):
  doctor                     check the host and the install
  session install [--dry-run] a login screen entry (/usr/share/wayland-sessions, with sudo)
                             that starts Plutonium: plutonium session start

Sessions:
  run [options] [shell...]   start a session with installed shells (hydra, niri, plain, ...) or
                             <name>=<url>. The first is the desktop, Super+Tab switches.
                             Default: the shells that are on in $PLUTO_HOME/shells.json
  shells <command>           the installed shells in $PLUTO_HOME/shells: plutonium shells help
  stop [--drm|--x11]         stop a session's Ash (both if neither is given)
  status                     what is running
  helper <args>              run helper/plutonium.ts (thread-setup, launch, mcp, open, ...)
  <shell> <args>             a shell's own command, if it has one: plutonium hydra help
EOF
  if [[ -n $DEV ]]; then dev_usage
  else echo; echo "Settings: $PLUTONIUM_ENV"; fi
}

run_usage() {
  cat <<EOF
Usage: plutonium run [options] [shell...]

Shells: the names of installed shells ($PLUTO_HOME/shells: hydra, niri, plain,
and any you added), or <name>=<url> for any page. The first one is the
desktop; the others run behind it (Super+Tab). With none, the shells that are
on in $PLUTO_HOME/shells.json run, in its order, and the switcher's changes
are saved there. The first run installs the shipped shells.

Where:
  --x11 [display]   Ash in a window on an X11 display (default: a private Xvfb, :99
                    in slot 0)
  --drm             Ash on KMS/DRM, in this text console's session (Ctrl+Alt+F2,
                    log in). Ctrl+Alt+F1…F12 switch VTs while it runs, and
                    Ctrl+Alt+Backspace ends it. This is the default.
  --vt ttyN         DRM in the session logged in on ttyN, from any other shell
                    (ssh, an agent); if ttyN isn't in front, Ash comes up when
                    it is
  --hold SECONDS    DRM: stop Ash after SECONDS (unattended tests)
  --flags "..."     more Chromium flags
  --safe            safe mode: only the shipped plain shell, from this checkout
EOF
}

# --- Sessions ----------------------------------------------------------------
# The installed shells (helper/src/shells.ts, docs/features/SHELL_PACKAGES.md).
shells_cli() { local command=$1; shift; "$NODE" "$ROOT/helper/plutonium.ts" shells "$command" --home "$PLUTO_HOME" "$@"; }
# The shipped shells, installed (the first time, and any shipped since) and
# merged into the user's copies: a session runs what this install ships, with
# the user's edits on top.
shells_sync() {
  shells_cli sync | sed 's/^/plutonium: /'
  [[ ${PIPESTATUS[0]} == 0 ]] || die "couldn't install the shells in $PLUTO_HOME"
}
# What a session opens, as SHELL_URL, SHELLS and ORIGINS: the installed shells
# named (default: shells.json's, in order), or --safe.
shells_entries() {
  shells_cli entries --slot "$SLOT" --shells-port "$SHELLS_PORT" --helper-url "http://127.0.0.1:$HELPER_PORT" \
    --helper-socket "$RUN_DIR/plutonium/$SOCKET.sock" --wayland-display "$SOCKET" "$@"
}

# Asks a session's helper to start, stop or restart an installed shell's
# server, or reload its pages.
shell_server() {   # <mode> <name> <start|stop|restart|reload>
  session_vars "$1"
  local sock=$RUN_DIR/plutonium/$SOCKET.sock reply
  if [[ ! -S $sock && $3 == stop ]]; then
    # A server outlives its session; without the session's helper, its pid
    # file, if the process there is still that server (the helper's marker).
    local pid
    pid=$(cat "$RUN_DIR/plutonium/shell-$2-$SOCKET.pid" 2> /dev/null) && [[ $pid =~ ^[0-9]+$ ]] &&
      tr '\0' '\n' < "/proc/$pid/environ" 2> /dev/null | grep -qxF "PLUTONIUM_SHELL_SERVER=$2@$SOCKET@$PLUTO_HOME" ||
      { echo "$2 isn't running"; return; }
    kill -TERM -- "-$pid" 2> /dev/null || kill -TERM "$pid"
    for _ in $(seq 100); do kill -0 "$pid" 2> /dev/null || break; sleep 0.1; done
    kill -0 "$pid" 2> /dev/null && { kill -KILL -- "-$pid" 2> /dev/null || kill -KILL "$pid"; }
    rm -f "$RUN_DIR/plutonium/shell-$2-$SOCKET.pid"
    echo "Stopped"
    return
  fi
  [[ -S $sock ]] || die "no $1 session is running (its helper's socket $sock)"
  reply=$(curl -s -m 120 --unix-socket "$sock" -X POST -H 'Content-Type: application/json' -d '{}' \
    "http://helper/v1/shells/$2/$3") || die "the helper didn't answer"
  grep -o '"detail":"[^"]*"\|"error":"[^"]*"\|"reloaded":[0-9]*' <<< "$reply" | sed 's/^"reloaded":/pages reloaded: /' | cut -d'"' -f4
}

run_cmd() {
  local mode=drm shells=() safe=
  export VT= HOLD_S= XDISP= EXTRA_FLAGS= PERSIST_SHELLS=
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --x11) mode=x11; if [[ ${2:-} == :* ]]; then XDISP=$2; shift; fi ;;
      --drm) mode=drm ;;
      --vt) VT=$2; shift ;;
      --hold) HOLD_S=$2; shift ;;
      --flags) EXTRA_FLAGS=$2; shift ;;
      --safe) safe=1 ;;
      -h|--help) run_usage; exit 0 ;;
      -*) run_usage; exit 2 ;;
      *) shells+=("$1") ;;
    esac
    shift
  done
  [[ -d $RUN_DIR ]] || die "no $RUN_DIR: this shell has no systemd user session; log in normally (a text console, ssh, a display manager), not through su or sudo"
  need_ash_runtime
  # DRM and X11 sessions have their own socket and ports, so both can run.
  session_vars "$mode"
  [[ $mode == x11 ]] && XDISP=${XDISP:-$PRIVATE_XDISP}
  export MODE=$mode SOCKET CDP_PORT HELPER_PORT PROFILE XDISP PRIVATE_XDISP
  shells_sync
  local key value vars
  # Two starts in a row with no shell coming up (the helper counts them).
  if [[ -z $safe && ${#shells[@]} -eq 0 && $(cat "$PLUTO_HOME/failed-starts" 2> /dev/null || echo 0) -ge 2 ]]; then
    echo "plutonium: no shell came up in the last two starts: safe mode, with the shipped plain shell." >&2
    echo "plutonium: fix yours from the switcher (Super+Tab: a shell's page, or the backup terminal); the next start runs them again." >&2
    echo 0 > "$PLUTO_HOME/failed-starts"
    safe=1
  fi
  if [[ -n $safe ]]; then
    vars=$(shells_entries --safe) || exit 1
  elif [[ ${#shells[@]} -eq 0 ]]; then
    # shells.json's list, which the switcher's changes go back to.
    vars=$(shells_entries) || exit 1
    PERSIST_SHELLS=1
  else
    # Installed shells by name, pages by <name>=<url>, in the order given.
    vars=$(shells_entries "${shells[@]}") || exit 1
  fi
  while IFS='=' read -r key value; do
    case $key in SHELL_URL|SHELLS|ORIGINS) export "$key=$value" ;; esac
  done <<< "$vars"
  export SAFE_MODE=$safe
  # Started from a thread of another session: none of its variables apply here.
  unset PLUTONIUM PLUTONIUM_HELPER PLUTONIUM_THREAD_ID PLUTONIUM_OPENERS PLUTONIUM_SHOW PLUTONIUM_WAYLAND_DISPLAY
  exec "$ROOT/lib/session.sh"
}

stop_cmd() {
  local which=${1:---all} mode
  for mode in drm x11; do
    [[ $which == --all || $which == "--$mode" ]] || continue
    session_vars "$mode"
    local ash="^$ASH_BIN --enable-wayland-server .*--user-data-dir=$PROFILE( |\$)"
    if on_ash pkill -TERM -f "$ash" 2>/dev/null; then
      # Gone when this returns, so an install straight after doesn't find it.
      for _ in $(seq 1 100); do on_ash pgrep -f "$ash" > /dev/null 2>&1 || break; sleep 0.1; done
      echo "stopped the $mode session"
    fi
    local pidfile=$RUN_DIR/plutonium/helper-$SOCKET.pid pid
    if [[ -f $pidfile ]]; then
      pid=$(cat "$pidfile")
      if kill "$pid" 2>/dev/null; then
        for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
      fi
      rm -f "$pidfile"
    fi
    # Its threads' X servers, which outlive a helper restart.
    "$NODE" "$ROOT/helper/plutonium.ts" stop-x-displays --wayland-display "$SOCKET" \
      --socket "$RUN_DIR/plutonium/$SOCKET.sock" 2>/dev/null || true
  done
}

# What a release was made from (its BUNDLE): "<version> (<commit>, Chromium <tag>)".
bundle_describe() {
  local version commit dirty chromium
  version=$(sed -n 's/^VERSION=//p' "$1") commit=$(sed -n 's/^COMMIT=//p' "$1")
  dirty=$(sed -n 's/^DIRTY=//p' "$1") chromium=$(sed -n 's/^CHROMIUM_BUILD="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$1")
  echo "$version (commit ${commit:0:12}$([[ $dirty == 1 ]] && echo ", with uncommitted changes"), Chromium ${chromium:-from an unlabelled build})"
}
status_cmd() {
  [[ -f $ROOT/BUNDLE ]] && echo "release install: $ROOT, $(bundle_describe "$ROOT/BUNDLE")"
  if [[ -n $DEV ]]; then dev_status
  else chrome_built && echo "chrome: $CHROME_BIN" || echo "chrome: missing ($CHROME_BIN)"; fi
  local mode
  for mode in drm x11; do
    session_vars "$mode"
    pgrep -f "^$ASH_BIN --enable-wayland-server .*--user-data-dir=$PROFILE( |\$)" > /dev/null &&
      echo "$mode session: running ($SOCKET, DevTools $CDP_WHERE)" || echo "$mode session: not running"
  done
  local sock
  for sock in "$RUN_DIR"/plutonium/*.sock; do
    [[ -S $sock ]] && curl -s --max-time 2 --unix-socket "$sock" http://helper/v1/status > /dev/null &&
      echo "helper: $sock"
  done
}

# --- Installed shells --------------------------------------------------------
shells_usage() {
  cat <<EOF2
Usage: plutonium shells <command>

The shells sessions run are installed in $PLUTO_HOME/shells/<name>, each a git
repository with a shell.json (docs/features/SHELL_PACKAGES.md). Static ones are
served at http://<name>.localhost:$SHELLS_PORT/ by the session's helper.

Every session start installs the shipped shells you don't have, and merges the
shipped version of the others into yours (sync).

  install [name...]     copy the shipped shells (shells/) that aren't installed
  update [name...] [--from <checkout>]
                        merge the shipped (or another checkout's) version of each shell into
                        yours; your edits are kept, and conflicts are reported, not merged
  sync                  install and update, every shipped shell
  export <name>...      a checkout's: your edits to a shell (your copy's commits since the
                        shipped version) into this checkout's shells/<name>, uncommitted
  list [--json]         the installed shells, in shells.json's order, on or off
  check                 the shells whose server can't run here, and why
  start|stop|restart|reload <name> [--x11]
                        a running session's shell: its server, or its pages
  new <name> [<shell>]  a new shell: a copy of an installed one (default plain), on, in the
                        switcher; needs a running session (its helper adds it)
  prompt                a prompt for any agent: read the Plutonium skill, then make a shell
EOF2
}
shells_cmd() {
  local cmd=${1:-} from=$ROOT args=()
  shift || true
  while [[ $# -gt 0 ]]; do
    case $1 in
      --from) from=$(realpath "${2:?--from needs a checkout}"); shift ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  case $cmd in
    install|update) shells_cli "$cmd" --shipped "$from/shells" "${args[@]}" ;;
    sync|list|check) shells_cli "$cmd" "${args[@]}" ;;
    start|stop|restart|reload)
      local mode=drm
      [[ ${args[1]:-} == --x11 ]] && mode=x11
      [[ -n ${args[0]:-} ]] || die "usage: plutonium shells $cmd <name> [--x11]"
      shell_server "$mode" "${args[0]}" "$cmd" ;;
    export)
      [[ -n $DEV ]] || die "export writes into a checkout of the source; this is a release install ($ROOT)"
      [[ ${#args[@]} -gt 0 ]] || die "usage: plutonium shells export <name>..."
      local name dir diff
      for name in "${args[@]}"; do
        dir=$PLUTO_HOME/shells/$name
        [[ -d $ROOT/shells/$name ]] || die "this checkout ships no shell $name"
        # Against the shipped version as it is now, so only the edits remain.
        shells_cli update --shipped "$ROOT/shells" "$name" > /dev/null ||
          die "$name: your copy conflicts with this checkout's; merge it first (cd $dir && git merge shipped)"
        diff=$(git -C "$dir" diff --binary shipped HEAD)
        if [[ -z $diff ]]; then echo "$name: no edits"; continue; fi
        # Into the files only: the index stays the user's to stage.
        git -C "$ROOT" apply --directory="shells/$name" <<< "$diff" ||
          die "$name: your edits don't apply to shells/$name"
        echo "$name: your edits are in shells/$name ($(git -C "$dir" diff --stat shipped HEAD | tail -1 | sed 's/^ *//'))"
      done ;;
    new|prompt)
      # Through the running session's helper, which installs it and tells the switcher.
      local sock
      for sock in "$RUN_DIR/plutonium/wayland-plutonium$SLOT_SUFFIX.sock" "$RUN_DIR/plutonium/wayland-plutonium-x11$SLOT_SUFFIX.sock"; do
        [[ -S $sock ]] && break
      done
      [[ -S $sock ]] || die "no session is running here (plutonium run), so no helper to ask"
      if [[ $cmd == prompt ]]; then
        curl -sf --unix-socket "$sock" http://helper/v1/shells/prompt |
          python3 -c 'import json, sys; print(json.load(sys.stdin)["new"])'
        return
      fi
      [[ ${args[0]:-} =~ ^[a-z][a-z0-9-]*$ ]] || die "usage: plutonium shells new <name> [<shell to copy>] (name: lowercase letters, digits, dashes)"
      local body answer
      body=$(printf '{"name":"%s","from":"%s"}' "${args[0]}" "${args[1]:-plain}")
      answer=$(curl -s --unix-socket "$sock" -H 'Content-Type: application/json' -d "$body" http://helper/v1/shells/new)
      python3 -c 'import json, sys
answer = json.loads(sys.argv[1])
if "error" in answer: sys.exit("plutonium: " + answer["error"])
print("made", answer["name"], "in", answer["dir"] + ": on, at", answer.get("url", ""))
print("Edit its files there: every save is committed and reloads it (rolled back if it stops connecting).")' "$answer" ;;
    *) shells_usage; [[ -z $cmd || $cmd == help || $cmd == -h || $cmd == --help ]] || exit 2 ;;
  esac
}

# --- Login screen ------------------------------------------------------------
# A Wayland session entry, so a display manager (GDM, SDDM, LightDM) starts
# Plutonium for whoever logs in. The display manager runs `plutonium session
# start` in a logind session on a VT of its own, which `plutonium run` (DRM)
# takes as it would a text console's. When it exits, for whatever reason, the
# display manager's login screen comes back.
SESSION_ENTRY=/usr/share/wayland-sessions/plutonium.desktop
session_entry() {
  cat <<EOF2
[Desktop Entry]
Name=Pluto
Comment=A web-based desktop (from $ROOT)
Exec=$ROOT/bin/plutonium session start
TryExec=$ROOT/bin/plutonium
Type=Application
DesktopNames=Plutonium
EOF2
}
# Messages a display manager's user sees nowhere else: the journal, tagged
# plutonium-session (journalctl -t plutonium-session), and the session log.
session_log() {   # <priority> <message>
  logger -t plutonium-session -p "user.$1" -- "$2" 2>/dev/null || true
  echo "$(date +%T) $2" >> "$LOGS/login-session.log"
  echo "$2" >&2
}
session_start() {
  local dry= shells=()
  while [[ $# -gt 0 ]]; do
    case $1 in --dry-run) dry=1 ;; *) shells+=("$1") ;; esac
    shift
  done
  # With none named, run starts the user's installed shells (shells.json).
  # shellcheck disable=SC2206
  [[ ${#shells[@]} -gt 0 ]] || shells=(${SESSION_SHELLS:-})
  local sid=${XDG_SESSION_ID:-}
  session_log info "starting for $(id -un) in logind session ${sid:-(none)}${sid:+ ($(loginctl show-session "$sid" -p TTY --value 2>/dev/null))}: plutonium run ${shells[*]:-(your shells)}"
  [[ -n $DEV ]] && dev_session_start
  if [[ -n $dry ]]; then
    session_log info "would run: plutonium run ${shells[*]:-(your shells)} (in session ${sid:-none}); back to the login screen when it exits"
    return
  fi
  local started=$SECONDS rc=0
  "$ROOT/bin/plutonium" run ${shells[@]+"${shells[@]}"} || rc=$?
  session_vars drm
  if (( rc != 0 && SECONDS - started < 30 )); then
    session_log err "Plutonium didn't start (exit $rc after $((SECONDS - started)) s); back to the login screen. Logs: $LOGS/session-$SOCKET.log, $LOGS/ash-$SOCKET.log"
    tail -n 15 "$LOGS/session-$SOCKET.log" 2>/dev/null | logger -t plutonium-session -p user.err 2>/dev/null || true
  elif (( rc != 0 )); then
    session_log err "Ash exited ($rc) after $((SECONDS - started)) s; back to the login screen. Log: $LOGS/ash-$SOCKET.log"
  else
    session_log info "the session ended; back to the login screen"
  fi
  exit "$rc"
}
session_cmd() {
  case "${1:-}" in
    start) shift; session_start "$@" ;;
    entry) session_entry ;;   # bundle/install.sh writes it
    install)
      if [[ ${2:-} == --dry-run ]]; then echo "would write $SESSION_ENTRY (with sudo):"; session_entry; return; fi
      local tmp
      tmp=$(mktemp)
      session_entry > "$tmp"
      echo "writing $SESSION_ENTRY (sudo)"
      sudo install -Dm644 "$tmp" "$SESSION_ENTRY"
      rm -f "$tmp"
      echo "Log out: the login screen lists Plutonium among the sessions." ;;
    uninstall) sudo rm -f "$SESSION_ENTRY" && echo "removed $SESSION_ENTRY" ;;
    *) usage; exit 2 ;;
  esac
}

# --- Doctor ------------------------------------------------------------------
# The first-run guide: every check that fails says what's wrong and the command
# that fixes it, for this distribution. It exits 1 while something required
# is missing.

# The distribution family, from /etc/os-release: fedora, debian, arch, suse,
# nixos, or empty.
distro_family() {
  local id= like=
  [[ -f /etc/os-release ]] && { id=$(. /etc/os-release; echo "${ID:-}"); like=$(. /etc/os-release; echo "${ID_LIKE:-}"); }
  case " $id $like " in
    *" nixos "*) echo nixos ;;
    *" fedora "*|*" rhel "*|*" centos "*) echo fedora ;;
    *" debian "*|*" ubuntu "*) echo debian ;;
    *" arch "*) echo arch ;;
    *" suse "*|*" opensuse "*) echo suse ;;
  esac
}
# The command that installs what a check needs: <what>... from podman,
# node, python, git, curl, procps, uidmap, foot, xwayland-satellite, socket-activate.
install_hint() {
  local family=$DISTRO pkgs=() p
  for p in "$@"; do
    case $family:$p in
      fedora:node) echo "sudo dnf install --allowerasing nodejs24-bin nodejs24-npm-bin (node is Node 22 on Fedora)"; return ;;
      debian:node) echo "Node 24 from NodeSource: curl -fsSL https://deb.nodesource.com/setup_24.x -o /tmp/nodesource.sh && sudo bash /tmp/nodesource.sh && sudo apt install nodejs"; return ;;
      arch:node) pkgs+=(nodejs npm) ;;
      suse:node) pkgs+=(nodejs24 npm24) ;;
      nixos:node) pkgs+=(nodejs_24) ;;
      fedora:python|debian:python|suse:python|nixos:python) pkgs+=(python3) ;;
      arch:python) pkgs+=(python) ;;
      fedora:procps|arch:procps) pkgs+=(procps-ng) ;;
      *:procps) pkgs+=(procps) ;;
      fedora:uidmap|arch:uidmap|suse:uidmap) pkgs+=(shadow) ;;
      debian:uidmap) pkgs+=(uidmap) ;;
      debian:xwayland-satellite) echo "not packaged: build it from https://github.com/Supreeeme/xwayland-satellite"; return ;;
      *:socket-activate) pkgs+=(systemd) ;;
      fedora:xvfb|suse:xvfb) pkgs+=(xorg-x11-server-Xvfb) ;;
      debian:xvfb) pkgs+=(xvfb) ;;
      arch:xvfb) pkgs+=(xorg-server-xvfb) ;;
      nixos:xvfb) pkgs+=(xvfb) ;;
      fedora:vulkan|debian:vulkan) pkgs+=(mesa-vulkan-drivers) ;;
      arch:vulkan) pkgs+=("vulkan-radeon or vulkan-intel") ;;
      suse:vulkan) pkgs+=("libvulkan_radeon or libvulkan_intel") ;;
      nixos:vulkan) echo "hardware.graphics.enable = true in configuration.nix"; return ;;
      *) pkgs+=("$p") ;;
    esac
  done
  case $family in
    fedora) echo "sudo dnf install ${pkgs[*]}" ;;
    debian) echo "sudo apt install ${pkgs[*]}" ;;
    arch) echo "sudo pacman -S ${pkgs[*]}" ;;
    suse) echo "sudo zypper install ${pkgs[*]}" ;;
    nixos) echo "add to environment.systemPackages in configuration.nix: ${pkgs[*]}" ;;
    *) echo "install ${pkgs[*]} with your package manager" ;;
  esac
}
doctor() {
  local missing=0 node
  DISTRO=$(distro_family)
  # ok <what>; missing <what> <fix>; optional <what> <fix>.
  ok() { echo "  ok       $1"; }
  missing() { echo "  MISSING  $1: $2"; missing=$((missing + 1)); }
  optional() { echo "  -        $1: optional; $2"; }
  # check <what> <test> <fix>, required; check_opt for optional ones.
  check() { if eval "$2" > /dev/null 2>&1; then ok "$1"; else missing "$1" "$3"; fi; }
  check_opt() { if eval "$2" > /dev/null 2>&1; then ok "$1"; else optional "$1" "$3"; fi; }
  echo "Host${DISTRO:+ ($DISTRO)}:"
  check "a systemd user session ($RUN_DIR)" "[ -d $RUN_DIR ] && systemctl --user show-environment" \
    "log in normally (a display manager, a text console or ssh), not through su or sudo"
  if [[ $NODE == "$ROOT"/* ]]; then
    check "node ($NODE)" "'$NODE' --version" "the release install's node doesn't start: install it again"
  else
    node=$(node --version 2>/dev/null || true)
    check "node 24+${node:+ (found $node)}" "node -e 'process.exit(+process.versions.node.split(\".\")[0] >= 24 ? 0 : 1)' && command -v npm" "$(install_hint node)"
  fi
  check "python3" "command -v python3" "$(install_hint python)"
  check "git, curl" "command -v git && command -v curl" "$(install_hint git curl)"
  check "pgrep, pkill" "command -v pgrep && command -v pkill" "$(install_hint procps)"
  check_opt "foot (the shells' terminal, Super+T)" "command -v foot" "$(install_hint foot)"
  check_opt "xwayland-satellite (X11 apps)" "command -v xwayland-satellite || [ -x \"\${PLUTONIUM_XWAYLAND_SATELLITE:-}\" ]" "$(install_hint xwayland-satellite)"
  check_opt "systemd-socket-activate (X11 apps)" "command -v systemd-socket-activate" "$(install_hint socket-activate)"
  # EXO-LOCK: the lock screen checks the password with PAM's unix_chkpwd; without it, it won't lock.
  check_opt "unix_chkpwd (the lock screen's password check)" \
    "test -x /run/wrappers/bin/unix_chkpwd || test -x /usr/sbin/unix_chkpwd || test -x /sbin/unix_chkpwd || test -x /usr/bin/unix_chkpwd || test -x /usr/libexec/unix_chkpwd" \
    "it comes with PAM (pam_unix): without it the screen can't be locked (Super+L, idle) and says so"
  check_opt "systemd-inhibit (the lock before suspend)" "command -v systemd-inhibit" "it comes with systemd"
  check_opt "the helper's dependencies (agents driving pages)" "[ -d $ROOT/helper/node_modules/playwright-core ]" \
    "plutonium run installs them, or: (cd helper && npm ci --omit=dev)"
  if [[ -z $DEV ]]; then
    echo "Release install ($ROOT):"
    check "chrome starts" "'$CHROME_BIN' --no-sandbox --version" \
      "a library it needs is missing: ldd $CHROME_BIN | grep 'not found' (the host's libraries are listed in INSTALL.md)"
    check "keyboard layouts (/usr/share/X11/xkb)" "[ -d /usr/share/X11/xkb ]" \
      "install xkeyboard-config, or link $ROOT/chrome/xkb there (on NixOS, the release's module does: $ROOT/lib/nixos.nix)"
    check_opt "input device quirks (/usr/share/libinput)" "[ -d /usr/share/libinput ]" \
      "touchpads lose their per-model fixes: install libinput, or link $ROOT/chrome/libinput there (on NixOS, the release's module does)"
    check "chrome-sandbox is setuid root" "[ \"\$(stat -c %u:%a '$ROOT/chrome/chrome-sandbox')\" = 0:4755 ]" \
      "sudo chown root:root $ROOT/chrome/chrome-sandbox && sudo chmod 4755 $ROOT/chrome/chrome-sandbox"
    check_opt "Xvfb (--x11 without a display)" "command -v Xvfb" "$(install_hint xvfb)"
    check_opt "a Vulkan driver (--x11 sessions draw with it)" \
      "sh -c 'ls /usr/share/vulkan/icd.d/*.json /etc/vulkan/icd.d/*.json /run/opengl-driver/share/vulkan/icd.d/*.json 2> /dev/null | grep -q .'" "$(install_hint vulkan)"
  else
    dev_doctor
  fi
  echo "Optional:"
  # The shells: installed into PLUTO_HOME by plutonium shells install, or by
  # the first run. Not a failure either way.
  local pluto=$PLUTO_HOME
  if [[ -f $pluto/shells.json ]]; then ok "shells installed ($pluto/shells)"
  else echo "  -        shells: not installed yet (plutonium shells install, or the first run does it)"; fi
  # A shell whose server can't run here (Hydra, before its T3 Code is built).
  local name why
  while IFS=: read -r name why; do
    [[ -n $name ]] && optional "the $name shell" "${why# }"
  done < <([[ -d $pluto/shells ]] && shells_cli check 2> /dev/null)
  if [[ $DISTRO == nixos && -z $DEV ]]; then
    check_opt "login screen entry (NixOS: the release's module)" "test -L /run/current-system/sw/bin/plutonium" \
      "copy $ROOT/lib/nixos.nix beside configuration.nix as plutonium.nix, add it to its imports, and rebuild"
  elif [[ $DISTRO == nixos ]]; then
    optional "login screen entry" "NixOS's display manager takes its sessions from configuration.nix: one that runs $ROOT/bin/plutonium session start"
  else
    check_opt "login screen entry" "[ -f /usr/share/wayland-sessions/plutonium.desktop ]" "plutonium session install"
  fi
  if (( missing )); then echo "$missing to fix."; return 1; fi
  echo "All set. Try it in a window (plutonium run --x11 :0 niri), or on a text console: plutonium run niri plain"
}

cmd=${1:-help}
shift || true
case "$cmd" in
  doctor) doctor ;;
  run) run_cmd "$@" ;;
  stop) stop_cmd "$@" ;;
  status) status_cmd ;;
  session) session_cmd "$@" ;;
  shells) shells_cmd "$@" ;;
  helper)
    session_vars drm
    # In a worktree's slot, a thread's variables (an agent in a Hydra thread of
    # the live session) name slot 0's helper: launching there would put
    # windows on the user's desktop. Keep them only if they are this slot's.
    if (( SLOT )); then
      [[ ${PLUTONIUM_HELPER:-} == *"$SLOT_SUFFIX.sock" ]] || unset PLUTONIUM_HELPER PLUTONIUM_THREAD_ID
      [[ ${PLUTONIUM_WAYLAND_DISPLAY:-} == *"$SLOT_SUFFIX" ]] || unset PLUTONIUM_WAYLAND_DISPLAY
    fi
    PLUTONIUM_WAYLAND_DISPLAY=${PLUTONIUM_WAYLAND_DISPLAY:-$SOCKET} exec "$NODE" "$ROOT/helper/plutonium.ts" "$@" ;;
  help|-h|--help) usage ;;
  *)
    if [[ -n $DEV ]] && dev_has "$cmd"; then dev_cmd "$cmd" "$@"; exit; fi
    # A shell's own command (its manifest's "cli"): a checkout's as shipped,
    # which is what's being worked on; else the user's installed copy.
    dir=$PLUTO_HOME/shells/$cmd
    [[ -n $DEV || ! -f $dir/shell.json ]] && dir=$ROOT/shells/$cmd
    if [[ $cmd =~ ^[a-z0-9-]+$ && -f $dir/shell.json ]] && cli=$(grep -o '"cli": *"[^"]*"' "$dir/shell.json" | cut -d'"' -f4) && [[ -n $cli ]]; then
      PLUTONIUM=$ROOT exec "$dir/$cli" "$@"
    fi
    if [[ -n $DEV ]]; then usage >&2
    else echo "plutonium: no command '$cmd' (plutonium help lists them; building and developing Plutonium is done from a checkout of its source)" >&2; fi
    exit 2 ;;
esac
